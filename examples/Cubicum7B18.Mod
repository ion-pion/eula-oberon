  END Programe24;

  PROCEDURE Programe25*;   (* v2.5: Tor7 unit - 7 grupe, Salamandra in procesor, CALL/RET, STEP/COORD, SIST *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "PROCESORUL TOR7 v2.5 · cod = grupa*7 + locul (2 cifre în baza 7)");
    L(c, "0 Date: (gol) SET DIG MOV LD ST NOTAC");
    L(c, "1 Aritmetică: ADD SUB MUL DIV MOD INC DEC");
    L(c, "2 Salturi: LT EQ JMP JZ JNZ CALL RET");
    L(c, "3 Spațiu: LDW STW STEP COORD CAMP ASTEAPTA BAZA");
    L(c, "4 Nephilim: NEF PUNENEF COLT EMITE ASCULTA CANTA NOTA");
    L(c, "5 Timp: OPAL SIST ASH DORMI SCRIE SCRIEC SCRIEN");
    L(c, "6 Procese: TRIMITE PRIMESTE VECIN PORN OPR STOP CEDEAZA");
    L(c, "CALL x / RET: proceduri (stiva are 49 de locuri)");
    L(c, "STEP Ra, Rb: adresa Ra, un pas pe dimensiunea Rb (Rb = -(d+1): înapoi)");
    L(c, "COORD Ra, Rb: cifra Rb a adresei Ra");
    L(c, "TURA PID DELA TIMP STARE CEAS NOP: se scriu ca înainte, trec prin SIST");
    L(c, "Celula goală (cod 0) nu se execută: e eroare.");
    L(c, "SALAMANDRA: o eroare intră în Ash, tura procesului arde, procesul");
    L(c, "repornește din Ou. ASH Ra = câte erori a făcut. La a 8-a se oprește.");
    k := CFS.Scrie("procesor.txt", c);
    c := ""; L(c, "# invata: prima dată greșește (MOD cu 0), Salamandra arde tura,");
    L(c, "# programul repornește și citește din Ash că a mai greșit"); L(c, "ASH R0"); L(c, "JNZ R0, prudent");
    L(c, "SET R1, 0"); L(c, "SET R2, 5"); L(c, "MOD R2, R1"); L(c, "prudent: SCRIE R0"); L(c, "STOP");
    k := CFS.Scrie("invata.z7", c);
    c := ""; L(c, "# dublu: o procedură chemată de 3 ori (CALL / RET) -> 2 4 8");
    L(c, "SET R0, 1"); L(c, "CALL dublu"); L(c, "SCRIE R0"); L(c, "CALL dublu"); L(c, "SCRIE R0"); L(c, "CALL dublu"); L(c, "SCRIE R0");
    L(c, "STOP"); L(c, "dublu: ADD R0, R0"); L(c, "RET");
    k := CFS.Scrie("dublu.z7", c);
    c := ""; L(c, "# pasi: mersul pe dimensiuni. (6,6,6) un pas pe z -> (6,6,0) = 48;");
    L(c, "# apoi pe x: 6 -> 0 (se înfășoară pe cifra ei, fără transport) = 42"); L(c, "SET R0, 342"); L(c, "SET R1, 2");
    L(c, "STEP R0, R1"); L(c, "SCRIE R0"); L(c, "SET R1, 0"); L(c, "STEP R0, R1"); L(c, "SCRIE R0");
    L(c, "SET R1, 1"); L(c, "MOV R2, R0"); L(c, "COORD R2, R1"); L(c, "SCRIE R2"); L(c, "STOP");
    k := CFS.Scrie("pasi.z7", c);
    Comenzi;
    c := "Cubicum OS v2.5 · nucleul Salamandra · Tor7 unit: 49 de instrucțiuni în 7 grupe, Salamandra în procesor · Opal · Roler · AMINTESTE";
    Strings.Append(" · Prolog în limbajul Z7 · Styx pe 127.0.0.1:7777 (styx asculta) · Eula ♪ · Cubicum FS pe 7⁷", c);
    k := CFS.Scrie("sistem.txt", c)
  END Programe25;

