     uneori o raza loveste o Eula, iar votul urmator arata care.
   Faci aplicatia cu:   apk CubicumC7.Mod "Cubicum C"   *)

(* Cubicum OS v2.7 (27 oct 2026): primul joc in cub. Cub Roller (modulul CubRoller) ruleaza inauntrul sistemului:
     din Process apesi cub-roller.app (sau in Shell scrii: joc), joci, iar X din dreapta sus te intoarce in cub.
   v2.7d: selectorul se poate trage cu degetul (swipe) stanga-dreapta; descrierea se vede intreaga.
   v2.7c: in Process, in loc de grila, un selector: ◀ casuta ▶. O atingere pe casuta alege, a doua porneste.
     Aplicatiile (.app) si jocul vin primele; nu mai ramane nimic pe dinafara.
   Faci aplicatia cu:   apk CubicumOS27d.Mod "Cubicum OS"
   Cubicum OS v2.6 pentru Eula Oberon v31+ (26 oct 2026): douasprezece module intr-un fisier: Cubicum FS (pe torul 7^7,
   cu harta telefonului), Tor7 (procesorul si memoria), Z7P (Prolog), Z7L (limbajul Z7), Salamandra (nucleul si
   procesorul: 49 de instructiuni in 7 grupe, Salamandra in procesor), motorul muzicii din Eula ♪ (E7Txt, E7Teorie,
   E7Comp, E7Sonor, E7Synth), Styx (9P2000: serverul cubului si, din v2.6, clientul pe fir) si sistemul.
   v2.6: un cub intreaba alt cub, numai prin Styx scris in Oberon:
     pe telefonul A:  styx asculta retea          (arata adresa, ex. 192.168.1.20:7777)
     pe telefonul B:  styx leaga 192.168.1.20     apoi  styx ls /  ·  styx cat /opal  ·  styx scrie /prolog ...
                      styx dezleaga               (inapoi la cubul tau)
   Cere Eula Oberon v31 (Ecran.Leaga / Spre / Dinspre / AscultaRetea); pe v30 nu se compileaza.
   Faci aplicatia cu:   apk /sdcard/Download/CubicumOS26.Mod "Cubicum OS"   *)

MODULE CubicumFS;  (* Cubicum FS: fisierele nu stau pe cai, ci pe torul Z7 in 7 dimensiuni (7^7 = 823543 de celule), la adresa
     data de ce sunt (v1.8, alegerea lui Pion):
       1 x = numele (suma codurilor literelor MOD 7)   2 y = tipul (dupa extensie)   3 z = ziua (zilele de la 1 ian 2010 MOD 7)
       4 dosarul (suma codurilor literelor din calea dosarului MOD 7)
       5 marimea: 0 sub 1 KB, 1 sub 10 KB, 2 sub 100 KB, 3 sub 1 MB, 4 sub 10 MB, 5 sub 100 MB, 6 mai mare
       6 luna / anul (an * 12 + luna - 1, ora Romaniei) MOD 7      7 ora (ora Romaniei) MOD 7
     Celula ocupata: mai departe pe tor, pasul k aduna cifrele lui k in baza 7 pe dimensiuni (x+1, apoi y+1, apoi z+1, ...).
     Cele 8 colturi ale cubului vazut (x, y, z) sunt cele 8 radacini.
     Doua feluri de fisiere:
       - ale cubului (scrise in Cubicum, sau aduse cu adu): continutul sta in cub, in cfs.z7; unul adus tine octetii lui in
         bucati de LC, prima pe celula lui, urmatoarele pe celulele libere de dupa ea pe tor;
       - harta telefonului: fiecare fisier de pe telefon are celula lui, continutul ramane pe telefon (harta.z7).
     Ziua, luna, ora: cand s-a nascut fisierul cubului / cand a fost schimbat cel de pe telefon. *)
  IMPORT Files, Strings, Os, Ecran;

  CONST Max* = 343; LN* = 32; LC* = 1600; NA* = 8; LA* = 96;
    Semn = 7345; Semn17 = 7344; Semn16 = 7343; SemnH = 7777;
    D7* = 823543;
    MaxH* = 300000; LP = 9000000;         (* harta: fisiere, semnele numelor *)
    MaxD = 60000; LPD = 3000000;          (* harta: dosare, semnele cailor *)

  TYPE Fis = RECORD nume: ARRAY LN OF CHAR; cont: ARRAY LC OF CHAR; d: ARRAY 7 OF INTEGER; zi, marime, timp: INTEGER END;
    Bucata = RECORD cap: ARRAY LN OF CHAR; parte, cel, n: INTEGER; b: ARRAY LC OF BYTE END;   (* octetii unui fisier adus *)

  VAR f: ARRAY Max OF Fis; n: INTEGER;
    p: ARRAY Max OF Bucata; np: INTEGER;      (* bucata 0 sta pe celula fisierului, celelalte pe celule ale lor *)
    loc: ARRAY D7 OF INTEGER;                 (* -1 libera; i >= 0 fisierul cubului i (sau o bucata a lui); -(j+2) harta j *)
    capC: ARRAY D7 OF BOOLEAN;                (* pe celula sta chiar un fisier al cubului (nu o bucata) *)
    urma: ARRAY D7 OF INTEGER;                (* de la celula ideala c, pasii 0 .. urma[c] - 1 sunt ocupati: cautarea
                                                 incepe de acolo (aceeasi celula ca de la 0, doar mai repede); se sterge
                                                 cand se elibereaza ceva *)
    P7: ARRAY 8 OF INTEGER;
    rb: ARRAY LC OF BYTE;
    ash: ARRAY NA OF ARRAY LA OF CHAR; na: INTEGER;
    cale, tmp, caleH, tmpH: ARRAY 160 OF CHAR;
    scris: BOOLEAN;
    (* harta *)
    hNum, hDos, hMar, hT, hCel: ARRAY MaxH OF INTEGER; nh*: INTEGER;
    pool: ARRAY LP OF CHAR; npool: INTEGER;
    dOff: ARRAY MaxD OF INTEGER; nd*: INTEGER; dpool: ARRAY LPD OF CHAR; ndp: INTEGER;
    col: ARRAY 343 OF INTEGER;                (* cate fisiere de pe harta are fiecare coloana (x, y, z) *)
    rad: ARRAY 256 OF CHAR;                   (* radacina telefonului *)
    dq*: INTEGER; scan*, plin*: BOOLEAN; ciocniri*, sarite*, tScan*: INTEGER;

  PROCEDURE Tip*(nume: ARRAY OF CHAR): INTEGER;   (* y: 0 text, 1 pachet, 2 acord, 3 ash, 4 program (.z7), 5 aplicatie (.app), 6 altceva *)
    VAR i, p0, t: INTEGER; e: ARRAY 8 OF CHAR;
  BEGIN
    p0 := -1; i := 0;
    WHILE (i < LEN(nume)) & (nume[i] # 0X) DO IF nume[i] = "." THEN p0 := i END; INC(i) END;
    e := "";
    IF (p0 >= 0) & (i - p0 - 1 < LEN(e)) THEN Strings.Extract(nume, p0 + 1, i - p0 - 1, e) END;
    IF e = "txt" THEN t := 0 ELSIF e = "pkg" THEN t := 1 ELSIF e = "crda" THEN t := 2 ELSIF e = "ash" THEN t := 3
    ELSIF (e = "z7") OR (e = "z7l") OR (e = "mod") OR (e = "Mod") THEN t := 4 ELSIF (e = "app") OR (e = "html") THEN t := 5 ELSE t := 6
    END;
    RETURN t
  END Tip;

  PROCEDURE NumeTip*(t: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN
    IF t = 0 THEN s := "text" ELSIF t = 1 THEN s := "pachet" ELSIF t = 2 THEN s := "acord" ELSIF t = 3 THEN s := "ash"
    ELSIF t = 4 THEN s := "program" ELSIF t = 5 THEN s := "aplicație" ELSE s := "altceva"
    END
  END NumeTip;

  PROCEDURE SumaNume*(nume: ARRAY OF CHAR): INTEGER;   (* x-ul ideal (si dosarul: aceeasi suma, pe cale) *)
    VAR i, s: INTEGER;
  BEGIN
    s := 0; i := 0;
    WHILE (i < LEN(nume)) & (nume[i] # 0X) DO s := s + ORD(nume[i]); INC(i) END;
    RETURN s MOD 7
  END SumaNume;

  PROCEDURE Azi*(): INTEGER;   (* zile de la 1 ianuarie 2010 *)
  BEGIN RETURN Os.CurrentTime() DIV 86400
  END Azi;

  (* ---------- timpul: ora Romaniei (EET / EEST, ca ceasul din bara de sus) ---------- *)
  PROCEDURE Bisect(a: INTEGER): BOOLEAN;
  BEGIN RETURN (a MOD 4 = 0) & ((a MOD 100 # 0) OR (a MOD 400 = 0))
  END Bisect;

  PROCEDURE ZileLuna(a, l: INTEGER): INTEGER;
    VAR r: INTEGER;
  BEGIN
    IF l = 2 THEN IF Bisect(a) THEN r := 29 ELSE r := 28 END
    ELSIF (l = 4) OR (l = 6) OR (l = 9) OR (l = 11) THEN r := 30
    ELSE r := 31
    END;
    RETURN r
  END ZileLuna;

  PROCEDURE ZileAn(a: INTEGER): INTEGER;
    VAR r: INTEGER;
  BEGIN IF Bisect(a) THEN r := 366 ELSE r := 365 END; RETURN r
  END ZileAn;

  PROCEDURE Data*(zile: INTEGER; VAR a, l, z: INTEGER);   (* zilele de la 1 ian 2010 -> an, luna, zi (si inainte de 2010) *)
  BEGIN
    a := 2010;
    WHILE zile < 0 DO DEC(a); zile := zile + ZileAn(a) END;
    WHILE zile >= ZileAn(a) DO zile := zile - ZileAn(a); INC(a) END;
    l := 1; WHILE zile >= ZileLuna(a, l) DO zile := zile - ZileLuna(a, l); INC(l) END;
    z := zile + 1
  END Data;

  PROCEDURE ZileDin(a, l, z: INTEGER): INTEGER;   (* inapoi: zilele de la 1 ian 2010 *)
    VAR r, i: INTEGER;
  BEGIN
    r := 0;
    IF a >= 2010 THEN FOR i := 2010 TO a - 1 DO r := r + ZileAn(i) END ELSE FOR i := a TO 2009 DO r := r - ZileAn(i) END END;
    FOR i := 1 TO l - 1 DO r := r + ZileLuna(a, i) END;
    RETURN r + z - 1
  END ZileDin;

  PROCEDURE UltimaDuminica(a, l: INTEGER): INTEGER;   (* 1 ian 2010 a fost vineri *)
    VAR d: INTEGER;
  BEGIN d := ZileDin(a, l, 31); RETURN d - (d + 5) MOD 7
  END UltimaDuminica;

  PROCEDURE Local*(t: INTEGER): INTEGER;   (* secunde UTC de la 2010 -> ora Romaniei *)
    VAR a, l, z: INTEGER;
  BEGIN
    Data(t DIV 86400, a, l, z);
    IF (t >= UltimaDuminica(a, 3) * 86400 + 3600) & (t < UltimaDuminica(a, 10) * 86400 + 3600) THEN t := t + 3 * 3600
    ELSE t := t + 2 * 3600
    END;
    RETURN t
  END Local;

  PROCEDURE Treapta*(m: INTEGER): INTEGER;   (* dimensiunea 5 *)
    VAR r: INTEGER;
  BEGIN
    IF m < 1024 THEN r := 0 ELSIF m < 10240 THEN r := 1 ELSIF m < 102400 THEN r := 2 ELSIF m < 1048576 THEN r := 3
    ELSIF m < 10485760 THEN r := 4 ELSIF m < 104857600 THEN r := 5 ELSE r := 6
    END;
    RETURN r
  END Treapta;

  PROCEDURE Coord*(nume, dosar: ARRAY OF CHAR; m, t: INTEGER; VAR d: ARRAY OF INTEGER);   (* adresa ideala, cele 7 reguli *)
    VAR lt, a, l, z: INTEGER;
  BEGIN
    d[0] := SumaNume(nume); d[1] := Tip(nume); d[2] := (t DIV 86400) MOD 7;
    d[3] := SumaNume(dosar); d[4] := Treapta(m);
    lt := Local(t); Data(lt DIV 86400, a, l, z);
    d[5] := (a * 12 + l - 1) MOD 7; d[6] := (lt MOD 86400 DIV 3600) MOD 7
  END Coord;

  PROCEDURE Cel7(VAR d: ARRAY OF INTEGER): INTEGER;
    VAR i, c: INTEGER;
  BEGIN c := 0; FOR i := 0 TO 6 DO c := c + (d[i] MOD 7) * P7[i] END; RETURN c
  END Cel7;

  PROCEDURE Pas(VAR d: ARRAY OF INTEGER; k: INTEGER): INTEGER;   (* celula pasului k de la d: cifrele lui k adunate pe dimensiuni *)
    VAR i, c: INTEGER;
  BEGIN c := 0; FOR i := 0 TO 6 DO c := c + ((d[i] + k DIV P7[i]) MOD 7) * P7[i] END; RETURN c
  END Pas;

  PROCEDURE Liber(VAR d: ARRAY OF INTEGER; VAR k: INTEGER): INTEGER;   (* prima celula libera de la d pe tor (k = pasii) *)
    VAR c, c0: INTEGER;
  BEGIN
    c0 := Pas(d, 0); k := urma[c0]; c := Pas(d, k);
    WHILE (loc[c] # -1) & (k < D7) DO INC(k); c := Pas(d, k) END;
    IF k < D7 THEN urma[c0] := k END;
    RETURN c
  END Liber;

  PROCEDURE StergeUrma;   (* s-a eliberat o celula: cautarile pornesc iar de la pasul 0 *)
    VAR i: INTEGER;
  BEGIN FOR i := 0 TO D7 - 1 DO urma[i] := 0 END
  END StergeUrma;

  PROCEDURE Cifre*(c: INTEGER; VAR d: ARRAY OF INTEGER);
    VAR i: INTEGER;
  BEGIN FOR i := 0 TO 6 DO d[i] := c DIV P7[i] MOD 7 END
  END Cifre;

  PROCEDURE CelText*(c: INTEGER; VAR s: ARRAY OF CHAR);   (* "x.y.z.a.b.c.d" *)
    VAR i: INTEGER; d: ARRAY 7 OF INTEGER;
  BEGIN
    Cifre(c, d); s := "";
    FOR i := 0 TO 6 DO IF i > 0 THEN Strings.Append(".", s) END; Strings.AppendInt(d[i] + 1, 0, s) END   (* 7·B: 1..7 *)
  END CelText;

  PROCEDURE DinText*(s: ARRAY OF CHAR): INTEGER;   (* "x.y.z.a.b.c.d" -> celula; -1 = nu e o adresa *)
    VAR i, k, v, c: INTEGER; ok: BOOLEAN;
  BEGIN
    i := 0; k := 0; c := 0; ok := TRUE;
    WHILE (i < LEN(s)) & (s[i] = " ") DO INC(i) END;
    WHILE ok & (k < 7) DO
      IF (i < LEN(s)) & (s[i] >= "1") & (s[i] <= "7") THEN v := ORD(s[i]) - ORD("1"); c := c + v * P7[k]; INC(i); INC(k);   (* 7·B *)
        IF (k < 7) & ((i >= LEN(s)) OR (s[i] # ".")) THEN ok := FALSE ELSIF k < 7 THEN INC(i) END
      ELSE ok := FALSE
      END
    END;
    IF ~ok THEN c := -1 END;
    RETURN c
  END DinText;

  (* ---------- fisierele cubului ---------- *)
  PROCEDURE Al(nume: ARRAY OF CHAR): INTEGER;
    VAR i, r: INTEGER;
  BEGIN
    r := -1; i := 0;
    WHILE (r < 0) & (i < n) DO IF f[i].nume = nume THEN r := i END; INC(i) END;
    RETURN r
  END Al;

  PROCEDURE Pune(i: INTEGER);   (* fisierul cubului i pe celula lui (sau mai departe) *)
    VAR c, k: INTEGER;
  BEGIN c := Liber(f[i].d, k); Cifre(c, f[i].d); loc[c] := i; capC[c] := TRUE
  END Pune;

  PROCEDURE Refa;   (* celulele fisierelor cubului si ale bucatilor, din nou (harta ramane) *)
    VAR i, c: INTEGER;
  BEGIN
    FOR i := 0 TO D7 - 1 DO IF loc[i] >= 0 THEN loc[i] := -1; capC[i] := FALSE END END;
    StergeUrma;
    FOR i := 0 TO n - 1 DO c := Cel7(f[i].d); loc[c] := i; capC[c] := TRUE END;
    FOR i := 0 TO np - 1 DO
      c := Al(p[i].cap);
      IF c >= 0 THEN IF p[i].parte > 0 THEN loc[p[i].cel] := c ELSE p[i].cel := Cel7(f[c].d) END END
    END
  END Refa;

  PROCEDURE PuneAsh*(s: ARRAY OF CHAR);   (* o eroare pastrata: Ash tine ultimele NA *)
    VAR i: INTEGER;
  BEGIN
    IF na = NA THEN FOR i := 0 TO NA - 2 DO ash[i] := ash[i + 1] END; DEC(na) END;
    Strings.Copy(s, ash[na]); INC(na)
  END PuneAsh;

  PROCEDURE Celule*(i: INTEGER): INTEGER;   (* cate celule tine fisierul i: 1, sau cate bucati are cel adus *)
    VAR j, k: INTEGER;
  BEGIN
    k := 1;
    IF (i >= 0) & (i < n) & (f[i].marime >= 0) THEN
      k := 0; FOR j := 0 TO np - 1 DO IF p[j].cap = f[i].nume THEN INC(k) END END; IF k = 0 THEN k := 1 END
    END;
    RETURN k
  END Celule;

  PROCEDURE Marime*(i: INTEGER): INTEGER;   (* octetii fisierului adus de pe telefon; -1 = scris in cub *)
    VAR m: INTEGER;
  BEGIN m := -1; IF (i >= 0) & (i < n) THEN m := f[i].marime END; RETURN m
  END Marime;

  PROCEDURE Octeti*(i, de: INTEGER; VAR b: ARRAY OF BYTE): INTEGER;   (* octetii fisierului adus, de la de; cati au intrat *)
    VAR j, k, a, c: INTEGER;
  BEGIN
    c := 0;
    IF (i >= 0) & (i < n) & (f[i].marime >= 0) THEN
      FOR j := 0 TO np - 1 DO
        IF p[j].cap = f[i].nume THEN
          a := p[j].parte * LC;
          FOR k := 0 TO p[j].n - 1 DO
            IF (a + k >= de) & (a + k - de < LEN(b)) THEN b[a + k - de] := p[j].b[k]; INC(c) END
          END
        END
      END
    END;
    RETURN c
  END Octeti;

  PROCEDURE NrBucati*(): INTEGER;
  BEGIN RETURN np
  END NrBucati;

  PROCEDURE InfoBucata*(j: INTEGER; VAR cel, fis, parte: INTEGER);   (* bucata j: celula ei, fisierul, a cata parte e *)
  BEGIN
    IF (j >= 0) & (j < np) THEN cel := p[j].cel; fis := Al(p[j].cap); parte := p[j].parte ELSE cel := -1; fis := -1; parte := -1 END
  END InfoBucata;

  PROCEDURE LaCelula7*(c: INTEGER): INTEGER;   (* -1 libera; i >= 0 fisierul cubului i; -(j+2) fisierul j de pe harta *)
    VAR r: INTEGER;
  BEGIN r := -1; IF (c >= 0) & (c < D7) THEN r := loc[c] END; RETURN r
  END LaCelula7;

  PROCEDURE EsteCap7*(c: INTEGER): BOOLEAN;   (* pe celula sta chiar un fisier al cubului (nu o bucata a lui) *)
  BEGIN RETURN (c >= 0) & (c < D7) & capC[c]
  END EsteCap7;

  PROCEDURE Ocupate*(): INTEGER;   (* cate celule tin fisierele cubului (cu bucatile lor) *)
    VAR i, k: INTEGER;
  BEGIN k := n; FOR i := 0 TO np - 1 DO IF p[i].parte > 0 THEN INC(k) END END; RETURN k
  END Ocupate;

  PROCEDURE Pune3(x, y, z: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN
    Strings.AppendInt(x + 1, 0, s); Strings.Append(".", s); Strings.AppendInt(y + 1, 0, s); Strings.Append(".", s);
    Strings.AppendInt(z + 1, 0, s)   (* 7·B: 1..7 *)
  END Pune3;

  PROCEDURE Salveaza(): BOOLEAN;
    VAR g: Files.File; i, k, r: INTEGER; ok: BOOLEAN;
  BEGIN
    g := Files.Create(tmp); ok := g # NIL;
    IF ok THEN
      Files.WriteInt(g, Semn); Files.WriteInt(g, n);
      FOR i := 0 TO n - 1 DO
        Files.WriteStr(g, f[i].nume); Files.WriteStr(g, f[i].cont);
        FOR k := 0 TO 6 DO Files.WriteInt(g, f[i].d[k]) END;
        Files.WriteInt(g, f[i].zi); Files.WriteInt(g, f[i].marime); Files.WriteInt(g, f[i].timp)
      END;
      Files.WriteInt(g, np);
      FOR i := 0 TO np - 1 DO
        Files.WriteStr(g, p[i].cap); Files.WriteInt(g, p[i].parte); Files.WriteInt(g, p[i].cel); Files.WriteInt(g, p[i].n);
        IF p[i].n > 0 THEN Files.WriteNBytes(g, p[i].b, p[i].n) END
      END;
      Files.WriteInt(g, na);
      FOR i := 0 TO na - 1 DO Files.WriteStr(g, ash[i]) END;
      ok := Files.Status(g) = Files.OK; Files.Close(g);
      IF ok THEN
        IF Files.Exists(cale) THEN r := Files.Delete(cale) END;
        ok := Files.Rename(tmp, cale) = Files.OK
      END
    END;
    scris := ok;
    RETURN ok
  END Salveaza;

  PROCEDURE Incarca(): BOOLEAN;   (* v1.8 si cuburile vechi (v1.0-v1.7: 3 dimensiuni; le dau si dimensiunile 4-7) *)
    VAR g: Files.File; i, j, k, m, semn, x, y, z, c, kk: INTEGER; ok: BOOLEAN;
      d: ARRAY 7 OF INTEGER;
  BEGIN
    ok := FALSE; n := 0; na := 0; np := 0;
    g := Files.Open(cale);
    IF g # NIL THEN
      semn := Files.ReadInt(g);
      IF (semn = Semn) OR (semn = Semn17) OR (semn = Semn16) THEN
        m := Files.ReadInt(g);
        IF (m < 0) OR (m > Max) THEN m := 0 END;
        FOR i := 0 TO m - 1 DO
          k := Files.ReadStr(g, f[n].nume); k := Files.ReadStr(g, f[n].cont);
          IF semn = Semn THEN
            FOR k := 0 TO 6 DO f[n].d[k] := Files.ReadInt(g) MOD 7 END;
            f[n].zi := Files.ReadInt(g); f[n].marime := Files.ReadInt(g); f[n].timp := Files.ReadInt(g)
          ELSE
            x := Files.ReadInt(g) MOD 7; y := Files.ReadInt(g) MOD 7; z := Files.ReadInt(g) MOD 7;
            f[n].zi := Files.ReadInt(g);
            IF semn = Semn17 THEN f[n].marime := Files.ReadInt(g) ELSE f[n].marime := -1 END;
            f[n].timp := f[n].zi * 86400;
            IF f[n].marime >= 0 THEN Coord(f[n].nume, "", f[n].marime, f[n].timp, d) ELSE Coord(f[n].nume, "", Strings.Length(f[n].cont), f[n].timp, d) END;
            d[0] := x; d[1] := y; d[2] := z; FOR k := 0 TO 6 DO f[n].d[k] := d[k] END
          END;
          INC(n)
        END;
        IF semn # Semn16 THEN
          m := Files.ReadInt(g);
          IF (m < 0) OR (m > Max) THEN m := 0 END;
          FOR i := 0 TO m - 1 DO
            k := Files.ReadStr(g, p[np].cap); p[np].parte := Files.ReadInt(g);
            IF semn = Semn THEN p[np].cel := Files.ReadInt(g) MOD D7
            ELSE k := Files.ReadInt(g); k := Files.ReadInt(g); k := Files.ReadInt(g); p[np].cel := -1
            END;
            p[np].n := Files.ReadInt(g); IF (p[np].n < 0) OR (p[np].n > LC) THEN p[np].n := 0 END;
            FOR j := 0 TO p[np].n - 1 DO p[np].b[j] := Files.Read(g) END;
            INC(np)
          END
        END;
        m := Files.ReadInt(g);
        IF (m < 0) OR (m > NA) THEN m := 0 END;
        FOR i := 0 TO m - 1 DO k := Files.ReadStr(g, ash[na]); INC(na) END;
        ok := Files.Status(g) = Files.OK;
        IF ok & (semn # Semn) THEN   (* cub vechi: fisierele pe torul 7^7, bucatile mai departe de ele, pe rand *)
          FOR i := 0 TO D7 - 1 DO IF loc[i] >= 0 THEN loc[i] := -1; capC[i] := FALSE END END;
          StergeUrma;
          FOR i := 0 TO n - 1 DO Pune(i) END;
          FOR i := 0 TO np - 1 DO
            k := Al(p[i].cap);
            IF k < 0 THEN p[i].cel := -1
            ELSIF p[i].parte = 0 THEN p[i].cel := Cel7(f[k].d)
            ELSE c := Liber(f[k].d, kk); p[i].cel := c; loc[c] := k
            END
          END
        END
      END;
      Files.Close(g)
    END;
    Refa;
    RETURN ok
  END Incarca;

  PROCEDURE Scriibil(d: ARRAY OF CHAR): BOOLEAN;   (* se poate scrie un fisier in dosarul d? *)
    VAR c: ARRAY 160 OF CHAR; g: Files.File; ok: BOOLEAN; r: INTEGER;
  BEGIN
    Strings.Copy(d, c); Strings.Append("/cfs.proba", c);
    g := Files.Create(c); ok := g # NIL;
    IF ok THEN Files.WriteInt(g, 7); ok := Files.Status(g) = Files.OK; Files.Close(g); r := Files.Delete(c) END;
    RETURN ok
  END Scriibil;

  (* ---------- harta telefonului ---------- *)
  PROCEDURE PuneSir(VAR pl: ARRAY OF CHAR; VAR np0: INTEGER; s: ARRAY OF CHAR): INTEGER;   (* s in pool; -1 = plin *)
    VAR i, o: INTEGER;
  BEGIN
    o := np0; i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) DO INC(i) END;
    IF np0 + i + 1 > LEN(pl) THEN o := -1
    ELSE i := 0; WHILE (i < LEN(s)) & (s[i] # 0X) DO pl[np0] := s[i]; INC(np0); INC(i) END; pl[np0] := 0X; INC(np0)
    END;
    RETURN o
  END PuneSir;

  PROCEDURE IaSir(VAR pl: ARRAY OF CHAR; o: INTEGER; VAR s: ARRAY OF CHAR);
    VAR i: INTEGER;
  BEGIN
    i := 0; IF o >= 0 THEN WHILE (pl[o + i] # 0X) & (i < LEN(s) - 1) DO s[i] := pl[o + i]; INC(i) END END;
    s[i] := 0X
  END IaSir;

  PROCEDURE GolesteHarta;
    VAR i: INTEGER;
  BEGIN
    FOR i := 0 TO nh - 1 DO IF loc[hCel[i]] = -(i + 2) THEN loc[hCel[i]] := -1 END END;
    FOR i := 0 TO 342 DO col[i] := 0 END;
    StergeUrma;
    nh := 0; npool := 0; nd := 0; ndp := 0; dq := 0; scan := FALSE; plin := FALSE; ciocniri := 0; sarite := 0
  END GolesteHarta;

  PROCEDURE PuneHarta(j: INTEGER; c: INTEGER);
  BEGIN hCel[j] := c; loc[c] := -(j + 2); INC(col[c MOD 343])
  END PuneHarta;

  PROCEDURE SalveazaHarta(): BOOLEAN;
    VAR g: Files.File; i, r: INTEGER; ok: BOOLEAN; s: ARRAY 1024 OF CHAR;
  BEGIN
    g := Files.Create(tmpH); ok := g # NIL;
    IF ok THEN
      Files.WriteInt(g, SemnH); Files.WriteStr(g, rad); Files.WriteInt(g, nd);
      FOR i := 0 TO nd - 1 DO IaSir(dpool, dOff[i], s); IF s = "" THEN Files.Write(g, 0) ELSE Files.WriteStr(g, s) END END;
      Files.WriteInt(g, nh);
      FOR i := 0 TO nh - 1 DO
        IaSir(pool, hNum[i], s); Files.WriteStr(g, s);
        Files.WriteInt(g, hDos[i]); Files.WriteInt(g, hMar[i]); Files.WriteInt(g, hT[i]); Files.WriteInt(g, hCel[i])
      END;
      Files.WriteInt(g, ciocniri); Files.WriteInt(g, sarite);
      ok := Files.Status(g) = Files.OK; Files.Close(g);
      IF ok THEN
        IF Files.Exists(caleH) THEN r := Files.Delete(caleH) END;
        ok := Files.Rename(tmpH, caleH) = Files.OK
      END
    END;
    RETURN ok
  END SalveazaHarta;

  PROCEDURE IncarcaHarta;
    VAR g: Files.File; i, k, m, c: INTEGER; s: ARRAY 1024 OF CHAR;
  BEGIN
    GolesteHarta;
    g := Files.Open(caleH);
    IF g # NIL THEN
      IF Files.ReadInt(g) = SemnH THEN
        k := Files.ReadStr(g, rad); m := Files.ReadInt(g);
        IF (m < 0) OR (m > MaxD) THEN m := 0 END;
        FOR i := 0 TO m - 1 DO k := Files.ReadStr(g, s); dOff[nd] := PuneSir(dpool, ndp, s); INC(nd) END;
        m := Files.ReadInt(g);
        IF (m < 0) OR (m > MaxH) THEN m := 0 END;
        FOR i := 0 TO m - 1 DO
          k := Files.ReadStr(g, s); hNum[nh] := PuneSir(pool, npool, s);
          hDos[nh] := Files.ReadInt(g); hMar[nh] := Files.ReadInt(g); hT[nh] := Files.ReadInt(g); c := Files.ReadInt(g) MOD D7;
          IF loc[c] = -1 THEN PuneHarta(nh, c); INC(nh) END   (* o celula luata intre timp de un fisier al cubului: il sar *)
        END;
        ciocniri := Files.ReadInt(g); sarite := Files.ReadInt(g);
        IF Files.Status(g) # Files.OK THEN ciocniri := 0; sarite := 0 END;
        dq := nd
      END;
      Files.Close(g)
    END
  END IncarcaHarta;

  PROCEDURE Porneste*(): BOOLEAN;   (* deschide cubul si harta; TRUE = cub nou, gol (prima pornire) *)
    VAR d: ARRAY 128 OF CHAR; t2: ARRAY 160 OF CHAR; nou: BOOLEAN; r: INTEGER;
  BEGIN
    Os.GetEnv(d, "CFS_DOSAR");
    IF d = "" THEN   (* Files.Exists nu vede dosarele, deci incerc sa scriu acolo *)
      d := "/data/data/ro.jahbalon.oberon.cubicum7b";
      IF ~Scriibil(d) THEN d := "/data/user/0/ro.jahbalon.oberon.cubicum7b" END;
      IF ~Scriibil(d) THEN d := "." END
    END;
    Strings.Copy(d, cale); Strings.Append("/cfs.z7", cale);
    Strings.Copy(d, tmp); Strings.Append("/cfs.tmp", tmp);
    Strings.Copy(d, caleH); Strings.Append("/harta.z7", caleH);
    Strings.Copy(d, tmpH); Strings.Append("/harta.tmp", tmpH);
    n := 0; na := 0; np := 0; scris := TRUE;
    IF Files.Exists(cale) THEN
      nou := ~Incarca();
      IF nou THEN   (* v1.9: un cub pe care nu-l inteleg (de la o versiune mai noua) nu se pierde: il pun deoparte *)
        Strings.Copy(d, t2); Strings.Append("/cfs-pastrat.z7", t2);
        IF Files.Exists(t2) THEN r := Files.Delete(t2) END;
        IF Files.Rename(cale, t2) = Files.OK THEN PuneAsh("cub necunoscut (versiune mai nouă?): pus deoparte în cfs-pastrat.z7") END
      END
    ELSE Refa; nou := TRUE
    END;
    IncarcaHarta;
    RETURN nou
  END Porneste;

  PROCEDURE HartaPorneste*(radacina: ARRAY OF CHAR);   (* harta din nou: tot telefonul de la radacina in jos *)
  BEGIN
    GolesteHarta; Strings.Copy(radacina, rad);
    dOff[0] := PuneSir(dpool, ndp, ""); nd := 1; dq := 0; scan := TRUE; tScan := 0
  END HartaPorneste;

  PROCEDURE Adauga(rel, nume: ARRAY OF CHAR; dos, m, t: INTEGER);   (* un fisier de pe telefon pe harta *)
    VAR d: ARRAY 7 OF INTEGER; c, k, o: INTEGER;
  BEGIN
    IF nh >= MaxH THEN plin := TRUE
    ELSE
      o := PuneSir(pool, npool, nume);
      IF o < 0 THEN plin := TRUE
      ELSE
        Coord(nume, rel, m, t, d); c := Liber(d, k);
        IF k >= D7 THEN plin := TRUE
        ELSE
          IF k > 0 THEN INC(ciocniri) END;
          hNum[nh] := o; hDos[nh] := dos; hMar[nh] := m; hT[nh] := t; PuneHarta(nh, c); INC(nh)
        END
      END
    END
  END Adauga;

  PROCEDURE HartaPas*(buget: INTEGER): BOOLEAN;   (* lucreaza la harta cel mult buget intrari; FALSE = gata *)
    VAR rel, cale0, sub: ARRAY 1024 OF CHAR; nm: ARRAY 256 OF CHAR; k, i, m, lucru, t: INTEGER; s: ARRAY LA OF CHAR;
  BEGIN
    lucru := 0;
    WHILE scan & ~plin & (dq < nd) & (lucru < buget) DO
      IaSir(dpool, dOff[dq], rel); Strings.Copy(rad, cale0);
      IF rel # "" THEN Strings.Append("/", cale0); Strings.Append(rel, cale0) END;
      k := Ecran.Intrari(cale0);
      i := 0;
      WHILE (i < k) & ~plin DO
        m := Ecran.Intrare(i, nm);
        IF m < 0 THEN
          IF rel = "" THEN Strings.Copy(nm, sub) ELSE Strings.Copy(rel, sub); Strings.Append("/", sub); Strings.Append(nm, sub) END;
          IF (nd < MaxD) & (Strings.Length(sub) < 1000) THEN dOff[nd] := PuneSir(dpool, ndp, sub); IF dOff[nd] >= 0 THEN INC(nd) ELSE INC(sarite) END
          ELSE INC(sarite)
          END
        ELSE t := Ecran.Schimbat(i); Adauga(rel, nm, dq, m, t)
        END;
        INC(i); INC(lucru)
      END;
      INC(dq); INC(lucru)
    END;
    IF scan & (plin OR (dq >= nd)) THEN
      scan := FALSE;
      IF plin THEN s := "harta s-a oprit: telefonul are mai mult de "; Strings.AppendInt(nh, 0, s); Strings.Append(" fișiere", s); PuneAsh(s) END;
      IF ~SalveazaHarta() THEN PuneAsh("nu pot scrie harta pe disc") END
    END;
    RETURN scan
  END HartaPas;

  PROCEDURE HNume*(j: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF (j >= 0) & (j < nh) THEN IaSir(pool, hNum[j], s) ELSE s := "" END
  END HNume;

  PROCEDURE HDosar*(j: INTEGER; VAR s: ARRAY OF CHAR);   (* calea dosarului, de la radacina ("" = radacina) *)
  BEGIN IF (j >= 0) & (j < nh) THEN IaSir(dpool, dOff[hDos[j]], s) ELSE s := "" END
  END HDosar;

  PROCEDURE HCale*(j: INTEGER; VAR s: ARRAY OF CHAR);   (* calea intreaga pe telefon *)
    VAR r: ARRAY 1024 OF CHAR; nm: ARRAY 256 OF CHAR;
  BEGIN
    Strings.Copy(rad, s); HDosar(j, r); IF r # "" THEN Strings.Append("/", s); Strings.Append(r, s) END;
    HNume(j, nm); Strings.Append("/", s); Strings.Append(nm, s)
  END HCale;

  PROCEDURE HMarime*(j: INTEGER): INTEGER;
    VAR r: INTEGER;
  BEGIN r := -1; IF (j >= 0) & (j < nh) THEN r := hMar[j] END; RETURN r
  END HMarime;

  PROCEDURE HTimp*(j: INTEGER): INTEGER;
    VAR r: INTEGER;
  BEGIN r := 0; IF (j >= 0) & (j < nh) THEN r := hT[j] END; RETURN r
  END HTimp;

  PROCEDURE HCel*(j: INTEGER): INTEGER;
    VAR r: INTEGER;
  BEGIN r := -1; IF (j >= 0) & (j < nh) THEN r := hCel[j] END; RETURN r
  END HCel;

  PROCEDURE Coloana*(x, y, z: INTEGER): INTEGER;   (* cate fisiere de pe harta au (x, y, z) in primele 3 dimensiuni *)
  BEGIN RETURN col[(x MOD 7) + 7 * (y MOD 7) + 49 * (z MOD 7)]
  END Coloana;

  PROCEDURE Mic(c: CHAR): CHAR;
  BEGIN IF (c >= "A") & (c <= "Z") THEN c := CHR(ORD(c) + 32) END; RETURN c
  END Mic;

  PROCEDURE Cauta*(text: ARRAY OF CHAR; VAR rez: ARRAY OF INTEGER; VAR cate: INTEGER): INTEGER;
    (* fisierele de pe harta cu text in nume (litere mari = mici); pune primele LEN(rez) in rez; intoarce cate sunt in tot *)
    VAR j, i, k, o, l, tot: INTEGER; da: BOOLEAN;
  BEGIN
    l := 0; WHILE (l < LEN(text)) & (text[l] # 0X) DO INC(l) END;
    tot := 0; cate := 0;
    FOR j := 0 TO nh - 1 DO
      o := hNum[j]; da := l = 0; i := 0;
      WHILE ~da & (pool[o + i] # 0X) DO
        k := 0; WHILE (k < l) & (pool[o + i + k] # 0X) & (Mic(pool[o + i + k]) = Mic(text[k])) DO INC(k) END;
        IF k = l THEN da := TRUE END;
        INC(i)
      END;
      IF da THEN IF cate < LEN(rez) THEN rez[cate] := j; INC(cate) END; INC(tot) END
    END;
    RETURN tot
  END Cauta;

  PROCEDURE Radacina0*(VAR s: ARRAY OF CHAR);   (* radacina telefonului folosita de harta *)
  BEGIN Strings.Copy(rad, s)
  END Radacina0;

  (* ---------- fisierele cubului: ce se vedea si inainte ---------- *)
  PROCEDURE Cenusa*(s: ARRAY OF CHAR);   (* o eroare in Ash, scrisa si pe disc *)
  BEGIN PuneAsh(s); IF ~Salveaza() THEN END
  END Cenusa;

  PROCEDURE Dosar*(VAR s: ARRAY OF CHAR);   (* dosarul in care sta cubul *)
    VAR k: INTEGER;
  BEGIN Strings.Copy(cale, s); k := Strings.Pos("/cfs.z7", s, 0); IF k >= 0 THEN s[k] := 0X END
  END Dosar;

  PROCEDURE N*(): INTEGER;
  BEGIN RETURN n
  END N;

  PROCEDURE Gaseste*(nume: ARRAY OF CHAR): INTEGER;   (* indicele, -1 = nu e *)
  BEGIN RETURN Al(nume)
  END Gaseste;

  PROCEDURE ScoateBucati(nume: ARRAY OF CHAR);   (* bucatile fisierului dispar (Refa le elibereaza celulele) *)
    VAR i, k: INTEGER;
  BEGIN
    k := 0;
    FOR i := 0 TO np - 1 DO IF p[i].cap # nume THEN IF k # i THEN p[k] := p[i] END; INC(k) END END;
    np := k
  END ScoateBucati;

  PROCEDURE Nou(nume, cont: ARRAY OF CHAR; m: INTEGER): INTEGER;   (* fisier nou al cubului pe celula lui (sau mai departe) *)
    VAR i, c, k: INTEGER; s: ARRAY LA OF CHAR; d: ARRAY 7 OF INTEGER;
  BEGIN
    i := n; INC(n);
    Strings.Copy(nume, f[i].nume); Strings.Copy(cont, f[i].cont);
    f[i].zi := Azi(); f[i].timp := Os.CurrentTime(); f[i].marime := -1;
    Coord(nume, "", m, f[i].timp, d); c := Liber(d, k);
    Cifre(c, f[i].d); loc[c] := i; capC[c] := TRUE;
    IF k > 0 THEN
      s := "coliziune: "; Strings.Append(nume, s); Strings.Append(" ", s); Pune3(d[0], d[1], d[2], s);
      Strings.Append(" → ", s); Pune3(f[i].d[0], f[i].d[1], f[i].d[2], s); PuneAsh(s)
    END;
    RETURN i
  END Nou;

  PROCEDURE Scrie*(nume, cont: ARRAY OF CHAR): INTEGER;   (* creeaza sau rescrie; intoarce indicele, -1 = n-a mers *)
    VAR i: INTEGER; s: ARRAY LA OF CHAR;
  BEGIN
    i := Gaseste(nume);
    IF i >= 0 THEN
      Strings.Copy(cont, f[i].cont);
      IF f[i].marime >= 0 THEN f[i].marime := -1; ScoateBucati(nume); Refa END   (* rescris in cub: nu mai e cel adus *)
    ELSIF n >= Max THEN
      s := "CFS plin (343 de fișiere ale cubului): "; Strings.Append(nume, s); PuneAsh(s)
    ELSE i := Nou(nume, cont, Strings.Length(cont))
    END;
    IF (i >= 0) & ~Salveaza() THEN PuneAsh("nu pot scrie cubul pe disc") END;
    RETURN i
  END Scrie;

  PROCEDURE Arde*(i: INTEGER);   (* sterge fisierul i al cubului (cu tot cu bucatile lui) *)
    VAR k: INTEGER;
  BEGIN
    IF (i >= 0) & (i < n) THEN
      ScoateBucati(f[i].nume);
      FOR k := i TO n - 2 DO f[k] := f[k + 1] END;
      DEC(n); Refa;
      IF ~Salveaza() THEN PuneAsh("nu pot scrie cubul pe disc") END
    END
  END Arde;

  PROCEDURE NumeScurt*(nume: ARRAY OF CHAR; VAR s: ARRAY OF CHAR);   (* un nume de pe telefon, scurtat ca sa incapa (LN - 1),
                                                                  cu extensia pastrata: inceputul~.ext *)
    VAR i, p0, l, le, k: INTEGER;
  BEGIN
    l := 0; p0 := -1;
    WHILE (l < LEN(nume)) & (nume[l] # 0X) DO IF nume[l] = "." THEN p0 := l END; INC(l) END;
    IF l < LN THEN Strings.Copy(nume, s)
    ELSE
      IF (p0 > 0) & (l - p0 <= 10) THEN le := l - p0 ELSE le := 0 END;
      k := LN - 2 - le; i := 0;
      WHILE i < k DO s[i] := nume[i]; INC(i) END;
      s[i] := "~"; INC(i);
      WHILE le > 0 DO s[i] := nume[l - le]; INC(i); DEC(le) END;
      s[i] := 0X
    END
  END NumeScurt;

  PROCEDURE TextUtf8*(VAR b: ARRAY OF BYTE; nb: INTEGER; VAR cont: ARRAY OF CHAR): BOOLEAN;
    (* nb octeti UTF-8 fara 0? daca da, cont = inceputul lor ca text (un caracter taiat la capat nu strica) *)
    VAR j, bb, c, r, x, nc: INTEGER; ok: BOOLEAN;
  BEGIN
    ok := TRUE; r := 0; x := 0; nc := 0; j := 0;
    WHILE ok & (j < nb) DO
      bb := b[j] MOD 256;
      IF r > 0 THEN
        IF bb DIV 64 = 2 THEN x := x * 64 + bb MOD 64; DEC(r) ELSE ok := FALSE END
      ELSIF bb = 0 THEN ok := FALSE
      ELSIF bb < 80H THEN x := bb
      ELSIF bb DIV 32 = 6 THEN x := bb MOD 32; r := 1
      ELSIF bb DIV 16 = 14 THEN x := bb MOD 16; r := 2
      ELSIF bb DIV 8 = 30 THEN x := bb MOD 8; r := 3
      ELSE ok := FALSE
      END;
      IF ok & (r = 0) & (nc < LEN(cont) - 3) THEN
        IF x >= 10000H THEN c := x - 10000H; cont[nc] := CHR(0D800H + c DIV 400H); INC(nc); x := 0DC00H + c MOD 400H END;
        IF x # 0FEFFH THEN cont[nc] := CHR(x); INC(nc) END
      END;
      INC(j)
    END;
    IF ok THEN cont[nc] := 0X ELSE cont[0] := 0X END;
    RETURN ok
  END TextUtf8;

  PROCEDURE Text(m: INTEGER; VAR cont: ARRAY OF CHAR): BOOLEAN;   (* octetii adusi (p[np - m .. np - 1]) sunt text? *)
    VAR i, j, k, bb, c, r, x, nc: INTEGER; ok: BOOLEAN;
  BEGIN
    ok := TRUE; r := 0; x := 0; nc := 0; cont[0] := 0X;
    FOR i := np - m TO np - 1 DO
      FOR j := 0 TO p[i].n - 1 DO
        bb := p[i].b[j] MOD 256;
        IF ~ok THEN
        ELSIF r > 0 THEN
          IF bb DIV 64 = 2 THEN x := x * 64 + bb MOD 64; DEC(r) ELSE ok := FALSE END
        ELSIF bb = 0 THEN ok := FALSE
        ELSIF bb < 80H THEN x := bb
        ELSIF bb DIV 32 = 6 THEN x := bb MOD 32; r := 1
        ELSIF bb DIV 16 = 14 THEN x := bb MOD 16; r := 2
        ELSIF bb DIV 8 = 30 THEN x := bb MOD 8; r := 3
        ELSE ok := FALSE
        END;
        IF ok & (r = 0) & (nc < LEN(cont) - 3) THEN
          IF x >= 10000H THEN c := x - 10000H; cont[nc] := CHR(0D800H + c DIV 400H); INC(nc); x := 0DC00H + c MOD 400H END;
          IF x # 0FEFFH THEN cont[nc] := CHR(x); INC(nc) END
        END
      END
    END;
    IF r > 0 THEN ok := FALSE END;
    IF ok THEN cont[nc] := 0X ELSE cont[0] := 0X END;
    k := 0;
    RETURN ok
  END Text;

  PROCEDURE Aduce*(numeTel, cale0: ARRAY OF CHAR): INTEGER;   (* un fisier de pe telefon copiat in cub; indicele, -1 = n-a mers *)
    VAR g: Files.File; i, m, cel, libere, k, j, kk, citit, nr, c: INTEGER; nume: ARRAY LN OF CHAR; s: ARRAY LA OF CHAR;
      cont: ARRAY LC OF CHAR;
  BEGIN
    NumeScurt(numeTel, nume); i := -1;
    g := Files.Open(cale0);
    IF g = NIL THEN s := "nu pot citi: "; Strings.Append(numeTel, s); PuneAsh(s)
    ELSE
      m := Files.Size(g); cel := (m + LC - 1) DIV LC; IF cel = 0 THEN cel := 1 END;
      k := Gaseste(nume);
      libere := Max - np; IF k >= 0 THEN libere := libere + Celule(k) END;   (* bucatile copiate: cel mult Max in tot *)
      IF (cel > libere) OR (k < 0) & (n >= Max) THEN
        s := "nu încape: "; Strings.Append(nume, s); Strings.Append(" are nevoie de ", s); Strings.AppendInt(cel, 0, s);
        Strings.Append(" celule, libere ", s); Strings.AppendInt(libere, 0, s); PuneAsh(s)
      ELSE
        IF k >= 0 THEN ScoateBucati(nume); FOR j := k TO n - 2 DO f[j] := f[j + 1] END; DEC(n); Refa END;
        i := Nou(nume, "", m);
        f[i].marime := m;
        citit := 0;
        FOR j := 0 TO cel - 1 DO
          Strings.Copy(nume, p[np].cap); p[np].parte := j;
          IF j = 0 THEN p[np].cel := Cel7(f[i].d)
          ELSE c := Liber(f[i].d, kk); p[np].cel := c; loc[c] := i
          END;
          nr := 0;
          IF m - citit > 0 THEN Files.ReadBytes(g, rb, nr) END;
          IF nr < 0 THEN nr := 0 END;
          IF nr > m - citit THEN nr := m - citit END;
          p[np].n := nr; FOR kk := 0 TO nr - 1 DO p[np].b[kk] := rb[kk] END;
          citit := citit + nr;
          INC(np)
        END;
        IF Text(cel, cont) THEN Strings.Copy(cont, f[i].cont) END;
        IF citit # m THEN s := "citit doar "; Strings.AppendInt(citit, 0, s); Strings.Append(" octeți din ", s); Strings.Append(nume, s); PuneAsh(s) END;
        IF ~Salveaza() THEN PuneAsh("nu pot scrie cubul pe disc") END
      END;
      Files.Close(g)
    END;
    RETURN i
  END Aduce;

  PROCEDURE Nume*(i: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF (i >= 0) & (i < n) THEN Strings.Copy(f[i].nume, s) ELSE s := "" END
  END Nume;

  PROCEDURE Continut*(i: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF (i >= 0) & (i < n) THEN Strings.Copy(f[i].cont, s) ELSE s := "" END
  END Continut;

  PROCEDURE Adresa*(i: INTEGER; VAR x, y, z: INTEGER);   (* primele 3 dimensiuni: cubul vazut *)
  BEGIN IF (i >= 0) & (i < n) THEN x := f[i].d[0]; y := f[i].d[1]; z := f[i].d[2] ELSE x := 0; y := 0; z := 0 END
  END Adresa;

  PROCEDURE Zi*(i: INTEGER): INTEGER;   (* ziua in care s-a nascut fisierul i al cubului (de la 1 ian 2010) *)
    VAR r: INTEGER;
  BEGIN r := -1; IF (i >= 0) & (i < n) THEN r := f[i].zi END; RETURN r
  END Zi;

  PROCEDURE Celula*(i: INTEGER): INTEGER;   (* celula fisierului i al cubului pe torul 7^7 *)
    VAR r: INTEGER;
  BEGIN r := -1; IF (i >= 0) & (i < n) THEN r := Cel7(f[i].d) END; RETURN r
  END Celula;

  PROCEDURE AdresaText*(i: INTEGER; VAR s: ARRAY OF CHAR);   (* "x.y.z.a.b.c.d" *)
  BEGIN IF (i >= 0) & (i < n) THEN CelText(Cel7(f[i].d), s) ELSE s := "" END
  END AdresaText;

  PROCEDURE Radacina*(i: INTEGER): INTEGER;   (* coltul (0..7) de care tine fisierul: bitii x>3, y>3, z>3 *)
    VAR x, y, z, r: INTEGER;
  BEGIN
    Adresa(i, x, y, z); r := 0;
    IF x > 3 THEN r := r + 1 END; IF y > 3 THEN r := r + 2 END; IF z > 3 THEN r := r + 4 END;
    RETURN r
  END Radacina;

  PROCEDURE NumeRadacina*(r: INTEGER; VAR s: ARRAY OF CHAR);   (* coltul ca adresa: 1.1.1 ... 7.7.7 (7·B) *)
  BEGIN s := ""; Pune3(r MOD 2 * 6, r DIV 2 MOD 2 * 6, r DIV 4 * 6, s)
  END NumeRadacina;

  PROCEDURE NrAsh*(): INTEGER;
  BEGIN RETURN na
  END NrAsh;

  PROCEDURE Ash*(k: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF (k >= 0) & (k < na) THEN Strings.Copy(ash[k], s) ELSE s := "" END
  END Ash;

  PROCEDURE Scris*(): BOOLEAN;
  BEGIN RETURN scris
  END Scris;

  PROCEDURE Init;
    VAR i: INTEGER;
  BEGIN
    P7[0] := 1; FOR i := 1 TO 7 DO P7[i] := P7[i - 1] * 7 END;
    FOR i := 0 TO D7 - 1 DO loc[i] := -1; capC[i] := FALSE; urma[i] := 0 END;
    FOR i := 0 TO 342 DO col[i] := 0 END;
    n := 0; na := 0; np := 0; nh := 0; npool := 0; nd := 0; ndp := 0; dq := 0; scan := FALSE; plin := FALSE;
    ciocniri := 0; sarite := 0; rad := ""; scris := TRUE
  END Init;

BEGIN
  Init
END CubicumFS.


MODULE Tor7;  (* procesorul si memoria lui Cubicum OS: torul Z7 in 7 dimensiuni, 7^7 = 823543 celule.
     7·B (29 oct 2026): cifrele celulelor sunt 1..7, nu 0..6 (Pion: „0 e sunet nul”). Pe tor 7 si 0 sunt acelasi loc,
     deci campul, spirala si codurile instructiunilor (citite MOD 7) raman la fel; o celula noua tine 7 si suna.
     Cuvintele (numerele din 12 celule) se scriu bijectiv: semnul (7 = zero, 1 = plus, 2 = minus), apoi cifrele 1..7, o celula stinsa = gata.
     Celula i are coordonatele d0..d6 = cifrele lui i in baza 7. A 7-a dimensiune e spirala: mersul pe spirala e i+1,
     d0 se invarte cel mai repede, iar d6 numara turele spiralei (7 ture de 7^6 = 117649 celule).
     Codul si datele stau in aceleasi celule. Totul e pe tor: adresa N e iar 0.
     Campul: suma tuturor cifrelor MOD 7, plus numarul de scrieri. O scriere oriunde il schimba pe loc,
     deci toata structura o simte deodata (cine asteapta campul se trezeste in aceeasi runda).

     v1.4 — fiecare celula tine, intr-un octet, cifra 0..6 si starea Nephilim:
       Inactiv 0, Corpuscul 1, Unda 2, CorpusculUnda 3; starile se combina prin XOR (grupul Klein).
       Torul gol e tot Corpuscul (activ). Cine scrie intr-o celula Inactiv o aprinde (devine Corpuscul).
     Opal, ceasul: acele 1, 3, 5, 7, 11. O bataie = o instructiune executata (Bate). La bataia t acul p arata locul
       fizic p*t; la fiecare p batai acul p emite: citeste celula de acolo (cifra, sau -1 daca e Inactiv).
     Ora = 1155 de batai (toate acele aliniate). La fiecare ora torul aluneca un pas: continutul adresei logice a sta
       pe locul fizic (a + w) MOD N, w = ciclul. Celulele aluneca impreuna cu continutul lor, deci programele (care
       adreseaza logic) nu simt nimic; se schimba doar ce depinde de loc: nota si ce citesc acele lui Opal.
       Nimic nu se copiaza: c[] e tinut pe adrese logice, iar locul fizic se socoteste.
     Nota: dintr-un colt Do (unul din cele 128 de colturi), fiecare pas pe o muchie urca o treapta din gama.
       treapta = cifra + distanta locului fizic de coltul Do; nota = treapta MOD 7 (Do..Si), octava = treapta DIV 7.
     v1.5 — Roler sta in coltul Do. Emite o treapta t: rezoneaza celulele cu treapta exact t (aceeasi nota in alta
       octava = coma); cu Emite(t, s) ele primesc starea XOR s (s = 1: Corpuscul <-> Inactiv).
     v2.5 — ArdeTura(t): Salamandra arde doar tura procesului care a gresit (vezi Salamandra, Cade).
     v1.9 — ceasul nu arde (Pion: „oricate reseturi i-ai da, tine minte prima pornire”): Burn goleste celulele, dar
       ciclul w, bataia din ora si acele lui Opal merg mai departe; torul tine minte prima pornire si cate Burn-uri a avut.
       Aminteste(t): Roler asculta treapta t si da adresa primei celule active care rezoneaza (memoria care raspunde
       la nota), in ordinea in care trece Roler. *)

  IMPORT Files;

  CONST N* = 823543; Tura* = 117649; Semn = 77343; Semn14 = 77344; Max* = 1977326742;   (* Max = 7^11 - 1, cel mai mare cuvant *)
    Inactiv* = 0; Corpuscul* = 1; Unda* = 2; CorpUnda* = 3;
    Ora* = 1155; NA* = 5;   (* acele lui Opal: 1, 3, 5, 7, 11 *)

  VAR c: ARRAY N OF BYTE; camp, scrieri, ultima: INTEGER;
    w, bo, colt: INTEGER;   (* ciclul (alunecarea), bataia in ora, coltul Do (si al lui Roler) *)
    stinse, coma: INTEGER;   (* ce a auzit Roler ultima data *)
    nascut, arderi: INTEGER;   (* prima pornire (secunde de la 1 ian 2010; -1 = nu stiu) si cate Burn-uri *)
    ac, poz, emis, citit: ARRAY NA OF INTEGER;
    semit: ARRAY 7 OF INTEGER;

  PROCEDURE Fizic*(a: INTEGER): INTEGER;   (* locul fizic al adresei logice a *)
  BEGIN RETURN (a MOD N + w MOD N) MOD N
  END Fizic;

  PROCEDURE Logic(f: INTEGER): INTEGER;   (* ce adresa logica sta acum pe locul fizic f *)
  BEGIN RETURN (f MOD N - w MOD N + N) MOD N
  END Logic;

  PROCEDURE Citeste*(i: INTEGER): INTEGER;
  BEGIN RETURN c[i MOD N] MOD 8
  END Citeste;

  PROCEDURE Xor*(a, b: INTEGER): INTEGER;   (* combinarea a doua stari Nephilim (grupul Klein) *)
    VAR r, k, m: INTEGER;
  BEGIN
    r := 0; m := 1;
    FOR k := 0 TO 1 DO IF ODD(a DIV m) # ODD(b DIV m) THEN r := r + m END; m := m * 2 END;
    RETURN r
  END Xor;

  PROCEDURE Stare*(i: INTEGER): INTEGER;   (* starea Nephilim a celulei logice i (stocata ca stare XOR 1) *)
  BEGIN RETURN Xor((c[i MOD N] DIV 8) MOD 4, 1)
  END Stare;

  PROCEDURE PuneStare*(i, s: INTEGER);
    VAR f: INTEGER;
  BEGIN f := i MOD N; c[f] := c[f] MOD 8 + 8 * Xor(s MOD 4, 1)
  END PuneStare;

  PROCEDURE Combina*(i, s: INTEGER);   (* starea celulei := starea XOR s *)
  BEGIN PuneStare(i, Xor(Stare(i), s MOD 4))
  END Combina;

  PROCEDURE Scrie*(i, v: INTEGER);
    VAR k, f: INTEGER;
  BEGIN
    f := i MOD N; v := (v - 1) MOD 7 + 1;   (* 7·B: 1..7; 0 si 7 sunt acelasi loc pe tor *)
    IF Stare(i) = Inactiv THEN PuneStare(i, Corpuscul) END;   (* cine scrie intr-o celula stinsa aprinde lumina *)
    k := c[f] MOD 8;
    camp := (camp + v - k + 7) MOD 7;
    c[f] := c[f] - k + v; INC(scrieri); ultima := i MOD N
  END Scrie;

  PROCEDURE Camp*(): INTEGER;   (* 7·B: 1..7 *)
    VAR r: INTEGER;
  BEGIN r := camp MOD 7; IF r = 0 THEN r := 7 END; RETURN r
  END Camp;

  PROCEDURE Scrieri*(): INTEGER;
  BEGIN RETURN scrieri
  END Scrieri;

  PROCEDURE Ultima*(): INTEGER;   (* ultima celula scrisa (adresa logica), -1 = niciuna *)
  BEGIN RETURN ultima
  END Ultima;

  PROCEDURE Coord*(i: INTEGER; VAR d: ARRAY OF INTEGER);   (* cele 7 coordonate ale celulei i *)
    VAR k: INTEGER;
  BEGIN
    i := i MOD N;
    FOR k := 0 TO 6 DO d[k] := i MOD 7; i := i DIV 7 END
  END Coord;

  PROCEDURE Index*(d: ARRAY OF INTEGER): INTEGER;   (* inversul lui Coord *)
    VAR k, i: INTEGER;
  BEGIN
    i := 0;
    FOR k := 6 TO 0 BY -1 DO i := i * 7 + d[k] MOD 7 END;
    RETURN i
  END Index;

  PROCEDURE Cuvant*(i: INTEGER): INTEGER;   (* 7·B: un numar in 12 celule, scris bijectiv: celula semnului (7 = zero, 1 = plus, 2 = minus),
      apoi cifrele 1..7, de la cea mai mica; o celula stinsa (Inactiv) inseamna ca numarul s-a terminat *)
    VAR k, n, v, sg: INTEGER; d: ARRAY 11 OF INTEGER;
  BEGIN
    v := 0; sg := Citeste(i);
    IF (sg = 1) OR (sg = 2) THEN
      n := 0; WHILE (n < 11) & (Stare(i + 1 + n) # Inactiv) DO d[n] := Citeste(i + 1 + n); INC(n) END;
      FOR k := n - 1 TO 0 BY -1 DO IF v <= 306783377 THEN v := v * 7 + d[k] END   (* (2^31 - 1 - 7) DIV 7: nu trece de INTEGER *) END;
      IF sg = 2 THEN v := -v END
    END;
    RETURN v
  END Cuvant;

  PROCEDURE PuneCuvant*(i, v: INTEGER);   (* peste 7^11 - 1 se pastreaza doar restul: si numerele sunt pe tor *)
    VAR k, d: INTEGER;
  BEGIN
    IF v = 0 THEN Scrie(i, 7) ELSIF v < 0 THEN Scrie(i, 2); v := -v ELSE Scrie(i, 1) END;
    IF v > Max THEN v := v MOD (Max + 1) END;
    k := 1;
    WHILE (v > 0) & (k <= 11) DO d := (v - 1) MOD 7 + 1; Scrie(i + k, d); v := (v - d) DIV 7; INC(k) END;
    IF k <= 11 THEN Scrie(i + k, 7); PuneStare(i + k, Inactiv) END
  END PuneCuvant;

  (* ---------- Opal: ceasul pe niveluri ---------- *)

  PROCEDURE Bate*;   (* o bataie: acele avanseaza, cele care si-au facut pasul emit; la ora torul aluneca *)
    VAR k, f: INTEGER;
  BEGIN
    INC(bo);
    FOR k := 0 TO NA - 1 DO
      poz[k] := (poz[k] + ac[k]) MOD N;
      IF bo MOD ac[k] = 0 THEN
        f := Logic(poz[k]);
        IF (c[f] DIV 8) MOD 4 = 1 THEN citit[k] := -1 ELSE citit[k] := c[f] MOD 8 END;   (* stocat 1 = Inactiv *)
        INC(emis[k])
      END
    END;
    IF bo = Ora THEN bo := 0; INC(w) END
  END Bate;

  PROCEDURE Acul(p: INTEGER): INTEGER;   (* 1, 3, 5, 7, 11 -> 0..4; altfel -1 *)
    VAR k, r: INTEGER;
  BEGIN r := -1; FOR k := 0 TO NA - 1 DO IF ac[k] = p THEN r := k END END; RETURN r
  END Acul;

  PROCEDURE Opal*(p: INTEGER): INTEGER;   (* ultima citire a acului p; -1 = nimic / Inactiv *)
    VAR k, r: INTEGER;
  BEGIN k := Acul(p); IF (k >= 0) & (emis[k] > 0) THEN r := citit[k] ELSE r := -1 END; RETURN r
  END Opal;

  PROCEDURE Emisii*(p: INTEGER): INTEGER;
    VAR k, r: INTEGER;
  BEGIN k := Acul(p); IF k >= 0 THEN r := emis[k] ELSE r := 0 END; RETURN r
  END Emisii;

  PROCEDURE Pozitie*(p: INTEGER): INTEGER;   (* locul fizic unde arata acul p acum *)
    VAR k, r: INTEGER;
  BEGIN k := Acul(p); IF k >= 0 THEN r := poz[k] ELSE r := 0 END; RETURN r
  END Pozitie;

  PROCEDURE Ciclu*(): INTEGER;   (* w: de cate ori a alunecat torul *)
  BEGIN RETURN w
  END Ciclu;

  PROCEDURE BataieOra*(): INTEGER;
  BEGIN RETURN bo
  END BataieOra;

  PROCEDURE Batai*(): INTEGER;
  BEGIN RETURN w * Ora + bo
  END Batai;

  (* ---------- notele ---------- *)

  PROCEDURE Colt*(): INTEGER;
  BEGIN RETURN colt
  END Colt;

  PROCEDURE PuneColt*(k: INTEGER);   (* coltul Do: bitul j = 1 inseamna ca pe dj se numara de la 6 *)
  BEGIN colt := k MOD 128
  END PuneColt;

  PROCEDURE Distanta*(f: INTEGER): INTEGER;   (* pasi pe muchii de la coltul Do pana la locul fizic f *)
    VAR k, s, m: INTEGER; d: ARRAY 7 OF INTEGER;
  BEGIN
    Coord(f, d); s := 0; m := colt;
    FOR k := 0 TO 6 DO IF ODD(m) THEN s := s + 6 - d[k] ELSE s := s + d[k] END; m := m DIV 2 END;
    RETURN s
  END Distanta;

  PROCEDURE Treapta*(a: INTEGER): INTEGER;   (* treapta celulei logice a: cifra + distanta locului ei de coltul Do *)
  BEGIN RETURN Citeste(a) + Distanta(Fizic(a))
  END Treapta;

  PROCEDURE Hz*(treapta: INTEGER): INTEGER;   (* gama Do major de la Do2 = 65.41 Hz *)
    VAR k: INTEGER; f: REAL;
  BEGIN
    f := 65.41; FOR k := 1 TO treapta DIV 7 DO f := f * 2.0 END;
    FOR k := 1 TO semit[treapta MOD 7] DO f := f * 1.0594631 END;
    RETURN FLOOR(f + 0.5)
  END Hz;

  PROCEDURE Nuanta*(treapta: INTEGER): INTEGER;   (* culoarea notei pe roata culorilor, 0..359 grade *)
  BEGIN RETURN (treapta MOD 7) * 360 DIV 7
  END Nuanta;

  (* ---------- Roler: emite si asculta din coltul Do ---------- *)

  PROCEDURE Roler(t, s: INTEGER; emite: BOOLEAN): INTEGER;
    (* trece prin tot torul, loc fizic cu loc fizic, tinand pasii de la colt din mers (fara impartiri);
       rezoneaza celulele cu treapta exact t; cu emite, primesc starea XOR s. Intoarce cate active rezoneaza. *)
    VAR f, a, k, dist, tr, v, st, act: INTEGER; d, sg: ARRAY 7 OF INTEGER; m: INTEGER;
  BEGIN
    m := colt; dist := 0;
    FOR k := 0 TO 6 DO
      d[k] := 0; IF ODD(m) THEN sg[k] := -1; dist := dist + 6 ELSE sg[k] := 1 END; m := m DIV 2
    END;
    act := 0; stinse := 0; coma := 0; s := s MOD 4;
    a := (N - w MOD N) MOD N;   (* adresa logica de pe locul fizic 0 *)
    FOR f := 0 TO N - 1 DO
      v := c[a];
      tr := v MOD 8 + dist;
      IF tr = t THEN
        IF emite & (s # 0) THEN st := Xor((v DIV 8) MOD 4, 1); c[a] := v MOD 8 + 8 * Xor(Xor(st, s), 1); v := c[a] END;
        IF (v DIV 8) MOD 4 = 1 THEN INC(stinse) ELSE INC(act) END
      ELSIF tr MOD 7 = t MOD 7 THEN INC(coma)
      END;
      (* urmatorul loc fizic: d0 + 1, cu transport *)
      INC(a); IF a = N THEN a := 0 END;
      k := 0;
      WHILE (k < 7) & (d[k] = 6) DO d[k] := 0; dist := dist - 6 * sg[k]; INC(k) END;
      IF k < 7 THEN INC(d[k]); dist := dist + sg[k] END
    END;
    RETURN act
  END Roler;

  PROCEDURE Asculta*(t: INTEGER): INTEGER;   (* cate celule active rezoneaza cu treapta t; vezi si Stinse, Coma *)
  BEGIN RETURN Roler(t, 0, FALSE)
  END Asculta;

  PROCEDURE Emite*(t, s: INTEGER): INTEGER;   (* celulele cu treapta t primesc starea XOR s; intoarce cate au rezonat *)
    VAR r: INTEGER;
  BEGIN r := Roler(t, s, TRUE); RETURN r + stinse
  END Emite;

  PROCEDURE Aminteste*(t: INTEGER): INTEGER;   (* adresa logica a primei celule active cu treapta t; -1 = niciuna *)
    VAR f, a, k, dist, v, r: INTEGER; d, sg: ARRAY 7 OF INTEGER; m: INTEGER;
  BEGIN
    m := colt; dist := 0;
    FOR k := 0 TO 6 DO
      d[k] := 0; IF ODD(m) THEN sg[k] := -1; dist := dist + 6 ELSE sg[k] := 1 END; m := m DIV 2
    END;
    r := -1; f := 0;
    a := (N - w MOD N) MOD N;   (* adresa logica de pe locul fizic 0 *)
    WHILE (r < 0) & (f < N) DO
      v := c[a];
      IF (v MOD 8 + dist = t) & ((v DIV 8) MOD 4 # 1) THEN r := a END;
      INC(a); IF a = N THEN a := 0 END;
      k := 0;
      WHILE (k < 7) & (d[k] = 6) DO d[k] := 0; dist := dist - 6 * sg[k]; INC(k) END;
      IF k < 7 THEN INC(d[k]); dist := dist + sg[k] END;
      INC(f)
    END;
    RETURN r
  END Aminteste;

  PROCEDURE Stinse*(): INTEGER;   (* la ultima ascultare / emisie: cate celule Inactiv au rezonat *)
  BEGIN RETURN stinse
  END Stinse;

  PROCEDURE Coma*(): INTEGER;   (* la ultima ascultare: cate celule au aceeasi nota in alta octava *)
  BEGIN RETURN coma
  END Coma;

  (* ---------- sesiunea ---------- *)

  PROCEDURE Salveaza*(cale: ARRAY OF CHAR): BOOLEAN;   (* tot torul intr-un fisier (sesiunea Salamandrei) *)
    VAR f: Files.File; ok: BOOLEAN; k: INTEGER;
  BEGIN
    f := Files.Create(cale); ok := f # NIL;
    IF ok THEN
      Files.WriteInt(f, Semn14); Files.WriteInt(f, camp); Files.WriteInt(f, scrieri); Files.WriteInt(f, ultima);
      Files.WriteInt(f, w); Files.WriteInt(f, bo); Files.WriteInt(f, colt);
      FOR k := 0 TO NA - 1 DO Files.WriteInt(f, poz[k]); Files.WriteInt(f, emis[k]); Files.WriteInt(f, citit[k]) END;
      Files.WriteBytes(f, c);
      ok := Files.Status(f) = Files.OK; Files.Close(f)
    END;
    RETURN ok
  END Salveaza;

  PROCEDURE Incarca*(cale: ARRAY OF CHAR): BOOLEAN;   (* citeste si torurile vechi (v1.3): toate Corpuscul, w = 0 *)
    VAR f: Files.File; ok: BOOLEAN; n, k, cp, sc, ul, s: INTEGER;
  BEGIN
    ok := FALSE; f := Files.Open(cale);
    IF f # NIL THEN
      s := Files.ReadInt(f);
      IF (s = Semn) OR (s = Semn14) THEN
        cp := Files.ReadInt(f); sc := Files.ReadInt(f); ul := Files.ReadInt(f);
        w := 0; bo := 0; colt := 0;
        FOR k := 0 TO NA - 1 DO poz[k] := 0; emis[k] := 0; citit[k] := -1 END;
        IF s = Semn14 THEN
          w := Files.ReadInt(f); bo := Files.ReadInt(f); colt := Files.ReadInt(f);
          FOR k := 0 TO NA - 1 DO poz[k] := Files.ReadInt(f); emis[k] := Files.ReadInt(f); citit[k] := Files.ReadInt(f) END
        END;
        n := 0; Files.ReadBytes(f, c, n);
        ok := (Files.Status(f) = Files.OK) & (n = N);
        IF ok THEN
          camp := 0; FOR k := 0 TO N - 1 DO camp := camp + c[k] MOD 8 END;
          ok := camp MOD 7 = cp;   (* campul recalculat trebuie sa fie cel salvat *)
          FOR k := 0 TO N - 1 DO IF c[k] MOD 8 = 0 THEN c[k] := c[k] + 7 END END;   (* 7·B: un tor vechi: 0 devine 7 *)
          camp := cp; scrieri := sc; ultima := ul
        END
      END;
      Files.Close(f)
    END;
    RETURN ok
  END Incarca;

  PROCEDURE Goleste;   (* celulele: tot Corpuscul, cifra 7 (7·B); Roler in coltul 0 *)
    VAR i: INTEGER;
  BEGIN
    FOR i := 0 TO N - 1 DO c[i] := 7 END;
    camp := 0; scrieri := 0; ultima := -1; colt := 0;
    FOR i := 0 TO NA - 1 DO citit[i] := -1 END
  END Goleste;

  PROCEDURE Arde*;   (* Burn: torul se goleste; ceasul (ciclul, bataia, acele) merge mai departe, prima pornire ramane *)
  BEGIN Goleste; INC(arderi)
  END Arde;

  PROCEDURE ArdeTura*(t: INTEGER);   (* v2.5: arde doar tura t a spiralei (celulele t*7^6 .. (t+1)*7^6 - 1):
                                        cifra 0, Corpuscul; campul pierde cifrele arse; ceasul merge mai departe *)
    VAR i, a, b, s: INTEGER;
  BEGIN
    a := (t MOD 7) * Tura; b := a + Tura - 1; s := 0;
    FOR i := a TO b DO s := s + c[i] MOD 8; c[i] := 7 END;   (* 7·B: cifra 7, campul nu se schimba de la ea *)
    camp := (camp - s MOD 7 + 7) MOD 7
  END ArdeTura;

  PROCEDURE Arderi*(): INTEGER;
  BEGIN RETURN arderi
  END Arderi;

  PROCEDURE Nascut*(): INTEGER;   (* prima pornire: secunde de la 1 ian 2010; -1 = nu stiu *)
  BEGIN RETURN nascut
  END Nascut;

  PROCEDURE PuneNascut*(t: INTEGER);   (* doar daca nu se stie inca *)
  BEGIN IF nascut < 0 THEN nascut := t END
  END PuneNascut;

  PROCEDURE ScrieCeas*(f: Files.File);   (* ceasul si prima pornire, in sesiune (care nu arde) *)
    VAR k: INTEGER;
  BEGIN
    Files.WriteInt(f, w); Files.WriteInt(f, bo); Files.WriteInt(f, nascut); Files.WriteInt(f, arderi);
    FOR k := 0 TO NA - 1 DO Files.WriteInt(f, poz[k]); Files.WriteInt(f, emis[k]) END
  END ScrieCeas;

  PROCEDURE CitesteCeas*(f: Files.File);
    VAR k: INTEGER;
  BEGIN
    w := Files.ReadInt(f); bo := Files.ReadInt(f); nascut := Files.ReadInt(f); arderi := Files.ReadInt(f);
    FOR k := 0 TO NA - 1 DO poz[k] := Files.ReadInt(f); emis[k] := Files.ReadInt(f) END
  END CitesteCeas;

BEGIN
  ac[0] := 1; ac[1] := 3; ac[2] := 5; ac[3] := 7; ac[4] := 11;
  semit[0] := 0; semit[1] := 2; semit[2] := 4; semit[3] := 5; semit[4] := 7; semit[5] := 9; semit[6] := 11;
  w := 0; bo := 0; nascut := -1; arderi := 0;
  FOR stinse := 0 TO NA - 1 DO poz[stinse] := 0; emis[stinse] := 0 END;
  stinse := 0; coma := 0;
  Goleste
END Tor7.


MODULE Z7P;  (* Prolog in limbajul Z7 (v2.0, Pion: „semnele Prolog raman, face parte din program”).
     Intr-un program .z7l pot sta, printre instructiuni, clauze si intrebari:
       tata(ion, maria).     bunic(X, Z) :- parinte(X, Y), parinte(Y, Z).     ?- bunic(ion, Cine).
     Compilatorul Z7L le da aici; ele se scriu in tor, pe tura programului, dupa cod, in cuvinte de 12 celule:
       W0 = 7777, W1 = clauze, W2 = intrebari, W3 = atomi, apoi locurile clauzelor si ale intrebarilor, locul numelor,
       clauzele, intrebarile, numele atomilor (literele, apoi 0). Cuvantul de la tura + 117637 arata unde e totul (0 = nimic).
     Un termen e scris in prefix, cate un cuvant: valoare * 4 + fel (0 atom, 1 variabila, 2 numar, 3 structura:
       valoarea = atom * 16 + aritate, urmata de argumente). Clauza: [variabile][cap][scopuri][scop...];
       intrebarea: [variabile][numele lor, ca atomi][scopuri][scop...].
     Motorul: potrivirea (unificarea) si intoarcerea (backtracking), ca in Prolog: clauzele in ordinea lor, adancime intai.
     Stie: ! \+ = \= is (+ - * // mod) < > =< >= =:= =\= true fail, liste [a, b | T]. Nu stie inca: ; -> assert.
     Cel mult 200.000 de pasi pe intrebare.
     v2.1 — legarea de programul Z7:  ?- bunic(ion, N) DO SCRIEA(N) END  (corpul o data pentru fiecare raspuns, N e
       variabila Z7 cu acelasi nume); o variabila Prolog cu numele unei variabile Z7 deja date intra cu valoarea ei.
       Intrebarea are acum: [variabile][numele][legaturile][scopuri][scop...]; legatura = 0 nimic, +(loc+1) iese in
       variabila Z7 de la tura + loc, -(loc+1) intra de acolo. Un nume in Z7 = 1.000.000.000 + numarul lui. *)
  IMPORT Strings, Tor7;

  CONST Semn = 7777; Pointer* = 117637;   (* cuvantul din tura care arata zona Prolog *)
    fAtom = 0; fVar = 1; fInt = 2; fStr = 3;
    MW = 30000; MA = 800; MVc = 64; MQ = 64; MCl = 2000; MN = 4000;   (* compilarea *)
    MG = 4000; MH = 1000000; MTr = 600000; MGn = 600000; MCp = 100000; MCD = 300000; MCL = 8000;   (* motorul *)
    PASI* = 200000; MSol = 40; BazaAtom* = 1000000000; MSl = 16; MB = 200; MVb = 16;
    hRef = 0; hAtom = 1; hInt = 2; hStr = 3; hFun = 4;
    tAtom = 1; tVar = 2; tInt = 3; tPd = 4; tPi = 5; tCd = 6; tCi = 7; tBara = 8; tVirg = 9; tGata = 10; tRau = 11;

  VAR
    (* ---- compilarea (o clauza sau o intrebare pe rand, din textul programului) ---- *)
    w: ARRAY MW OF INTEGER; nw: INTEGER;
    an: ARRAY MA OF ARRAY 40 OF CHAR; na: INTEGER;
    cOff: ARRAY MCl OF INTEGER; nc: INTEGER;
    qOff: ARRAY MQ OF INTEGER; nq: INTEGER;
    src: ARRAY 1800 OF CHAR; p, rnd: INTEGER;
    tok: INTEGER; tnume: ARRAY 40 OF CHAR; tval: INTEGER;
    vn: ARRAY MVc OF ARRAY 24 OF CHAR; nvn: INTEGER;
    nT, nV, nAr, nKid, nNext: ARRAY MN OF INTEGER; nn: INTEGER;   (* arborele termenului citit *)
    eroare: BOOLEAN; mesaj*: ARRAY 160 OF CHAR;
    cuDO*: BOOLEAN;                                       (* intrebarea de acum se termina cu DO, nu cu . *)
    t700: PROCEDURE (): INTEGER;   (* T700, chemat inainte sa fie scris *)
    (* ---- motorul ---- *)
    gn: ARRAY MG OF ARRAY 40 OF CHAR; ng: INTEGER;   (* atomii, pentru tot sistemul *)
    aNil, aPunct, aTrue, aFail, aEg, aNeg, aIs, aMic, aMare, aMicEg, aMareEg, aEgA, aDifA, aPlus, aMinus, aOri, aDiv,
    aMod, aNu, aTaie, aVirg, aDifU: INTEGER;
    hT, hV, hA: ARRAY MH OF INTEGER; h: INTEGER;
    tr: ARRAY MTr OF INTEGER; ntr: INTEGER;
    gT, gN, gC: ARRAY MGn OF INTEGER; ngd: INTEGER;
    cpG, cpK, cpH, cpTr, cpGd: ARRAY MCp OF INTEGER; ncp: INTEGER;
    cd: ARRAY MCD OF INTEGER; ncd: INTEGER;               (* clauzele incarcate, cu atomii globali *)
    clS, clF, clAr, clNv: ARRAY MCL OF INTEGER; ncl: INTEGER;
    vmap: ARRAY 4096 OF INTEGER; qv: ARRAY MVc OF INTEGER;   (* variabilele clauzei de acum; ale intrebarii *)
    loc: ARRAY MA OF INTEGER;                             (* atom local -> global, la incarcare *)
    dinTor: BOOLEAN; zona: INTEGER;                       (* de unde citesc cuvintele: din tor sau din w *)
    pasi*: INTEGER; oprit*, plin: BOOLEAN; nsol*: INTEGER;
    rez*: ARRAY MSol OF ARRAY 200 OF CHAR; nrez*: INTEGER;
    inV: ARRAY MVc OF INTEGER; inA: ARRAY MVc OF BOOLEAN; outO: ARRAY MVc OF INTEGER;   (* legaturile intrebarii de acum *)
    slT, slQ, slN, slI, slNv, slVarsta: ARRAY MSl OF INTEGER; slOff: ARRAY MSl OF ARRAY MVb OF INTEGER;
    slVal: ARRAY MSl OF ARRAY MB OF ARRAY MVb OF INTEGER; slot, varsta: INTEGER;   (* raspunsurile buclelor *)

  (* ======================= compilarea ======================= *)

  PROCEDURE Gol*;   (* inceputul unui program: nimic Prolog in el *)
  BEGIN nw := 0; na := 0; nc := 0; nq := 0
  END Gol;

  PROCEDURE Are*(): BOOLEAN;
  BEGIN RETURN (nc > 0) OR (nq > 0)
  END Are;

  PROCEDURE Rau(m: ARRAY OF CHAR);
  BEGIN
    IF ~eroare THEN eroare := TRUE; mesaj := "rândul "; Strings.AppendInt(rnd, 0, mesaj); Strings.Append(": ", mesaj); Strings.Append(m, mesaj) END
  END Rau;

  PROCEDURE AtomL(s: ARRAY OF CHAR): INTEGER;   (* atom local (al programului) *)
    VAR i, r: INTEGER;
  BEGIN
    r := -1; i := 0; WHILE (r < 0) & (i < na) DO IF an[i] = s THEN r := i END; INC(i) END;
    IF r < 0 THEN IF na < MA THEN Strings.Copy(s, an[na]); r := na; INC(na) ELSE Rau("prea multe nume în program"); r := 0 END END;
    RETURN r
  END AtomL;

  PROCEDURE Litera(c: CHAR): BOOLEAN;
  BEGIN RETURN (c >= "a") & (c <= "z") OR (c >= "A") & (c <= "Z") OR (c = "_") OR (c >= "0") & (c <= "9") OR (c >= 80X)
  END Litera;

  PROCEDURE Simbol(c: CHAR): BOOLEAN;
  BEGIN RETURN (c = "+") OR (c = "-") OR (c = "*") OR (c = "/") OR (c = "\") OR (c = "^") OR (c = "<") OR (c = ">")
    OR (c = "=") OR (c = "~") OR (c = ":") OR (c = ".") OR (c = "?") OR (c = "@") OR (c = "#") OR (c = "&") OR (c = "$")
  END Simbol;

  PROCEDURE Urm;   (* urmatorul semn al clauzei *)
    VAR c: CHAR; k: INTEGER; gata: BOOLEAN;
  BEGIN
    gata := FALSE;
    REPEAT
      c := src[p];
      IF c = 0AX THEN INC(rnd); INC(p)
      ELSIF (c = " ") OR (c = 9X) OR (c = 0DX) THEN INC(p)
      ELSIF c = "%" THEN WHILE (src[p] # 0X) & (src[p] # 0AX) DO INC(p) END
      ELSE gata := TRUE
      END
    UNTIL gata;
    c := src[p]; k := 0; tnume := "";
    IF c = 0X THEN tok := tGata
    ELSIF (c >= "0") & (c <= "9") THEN
      tval := 0; WHILE (src[p] >= "0") & (src[p] <= "9") DO IF tval < 100000000 THEN tval := tval * 10 + ORD(src[p]) - ORD("0") END; INC(p) END;
      tok := tInt
    ELSIF Litera(c) THEN
      WHILE Litera(src[p]) DO IF k < LEN(tnume) - 1 THEN tnume[k] := src[p]; INC(k) END; INC(p) END;
      tnume[k] := 0X;
      IF (c >= "A") & (c <= "Z") OR (c = "_") THEN tok := tVar ELSE tok := tAtom END
    ELSIF c = "'" THEN
      INC(p); WHILE (src[p] # "'") & (src[p] # 0X) & (src[p] # 0AX) DO IF k < LEN(tnume) - 1 THEN tnume[k] := src[p]; INC(k) END; INC(p) END;
      tnume[k] := 0X; IF src[p] = "'" THEN INC(p); tok := tAtom ELSE Rau("numele între ' nu se închide"); tok := tRau END
    ELSIF c = "(" THEN INC(p); tok := tPd
    ELSIF c = ")" THEN INC(p); tok := tPi
    ELSIF c = "[" THEN INC(p); IF src[p] = "]" THEN INC(p); tnume := "[]"; tok := tAtom ELSE tok := tCd END
    ELSIF c = "]" THEN INC(p); tok := tCi
    ELSIF c = "|" THEN INC(p); tok := tBara
    ELSIF c = "," THEN INC(p); tok := tVirg
    ELSIF c = "!" THEN INC(p); tnume := "!"; tok := tAtom
    ELSIF c = ";" THEN INC(p); tnume := ";"; tok := tAtom
    ELSIF (c = ".") & ((src[p + 1] = 0X) OR (src[p + 1] = " ") OR (src[p + 1] = 0AX) OR (src[p + 1] = 0DX) OR (src[p + 1] = 9X) OR (src[p + 1] = "%")) THEN
      INC(p); tok := tGata
    ELSIF Simbol(c) THEN
      WHILE Simbol(src[p]) & ~((src[p] = ".") & ((src[p + 1] = 0X) OR (src[p + 1] = " ") OR (src[p + 1] = 0AX))) DO
        IF k < LEN(tnume) - 1 THEN tnume[k] := src[p]; INC(k) END; INC(p)
      END;
      tnume[k] := 0X; tok := tAtom
    ELSE INC(p); Rau("semn necunoscut în clauză"); tok := tRau
    END
  END Urm;

  PROCEDURE Nod(t, v, ar: INTEGER): INTEGER;
  BEGIN
    IF nn < MN THEN nT[nn] := t; nV[nn] := v; nAr[nn] := ar; nKid[nn] := -1; nNext[nn] := -1; INC(nn) ELSE Rau("clauză prea lungă") END;
    RETURN nn - 1
  END Nod;

  PROCEDURE Frate(k1, k2: INTEGER);   (* nodul k2 e argumentul de dupa k1 *)
  BEGIN IF (k1 >= 0) & (k1 < MN) THEN nNext[k1] := k2 END
  END Frate;

  PROCEDURE Str(f: ARRAY OF CHAR; a, b: INTEGER): INTEGER;   (* f(a, b) sau f(a) daca b < 0 *)
    VAR k: INTEGER;
  BEGIN
    IF b < 0 THEN k := Nod(fStr, AtomL(f), 1) ELSE k := Nod(fStr, AtomL(f), 2) END;
    IF k < MN THEN nKid[k] := a; IF b >= 0 THEN Frate(a, b) END END;
    RETURN k
  END Str;

  PROCEDURE Var(nume: ARRAY OF CHAR): INTEGER;
    VAR i, r: INTEGER;
  BEGIN
    r := -1;
    IF nume # "_" THEN i := 0; WHILE (r < 0) & (i < nvn) DO IF vn[i] = nume THEN r := i END; INC(i) END END;
    IF r < 0 THEN IF nvn < MVc THEN Strings.Copy(nume, vn[nvn]); r := nvn; INC(nvn) ELSE Rau("prea multe variabile în clauză"); r := 0 END END;
    RETURN Nod(fVar, r, 0)
  END Var;

  PROCEDURE Lista(): INTEGER;   (* dupa [ : a, b | T ] *)
    VAR el, rest: INTEGER;
  BEGIN
    el := t700();
    IF tok = tVirg THEN Urm; rest := Lista()
    ELSIF tok = tBara THEN Urm; rest := t700(); IF tok = tCi THEN Urm ELSE Rau("aștept ]") END
    ELSIF tok = tCi THEN Urm; rest := Nod(fAtom, AtomL("[]"), 0)
    ELSE Rau("aștept , | sau ] în listă"); rest := Nod(fAtom, AtomL("[]"), 0)
    END;
    RETURN Str(".", el, rest)
  END Lista;

  PROCEDURE Primar(): INTEGER;
    VAR k, a, ultim, ar: INTEGER; f: ARRAY 40 OF CHAR;
  BEGIN
    k := -1;
    IF eroare THEN k := Nod(fAtom, 0, 0)
    ELSIF tok = tInt THEN k := Nod(fInt, tval, 0); Urm
    ELSIF tok = tVar THEN k := Var(tnume); Urm
    ELSIF tok = tPd THEN Urm; k := t700(); IF tok = tPi THEN Urm ELSE Rau("aștept )") END
    ELSIF tok = tCd THEN Urm; k := Lista()
    ELSIF (tok = tAtom) & (tnume = "-") THEN Urm;
      IF tok = tInt THEN k := Nod(fInt, -tval, 0); Urm ELSE k := Str("-", Primar(), -1) END
    ELSIF (tok = tAtom) & (tnume = "\+") THEN Urm; k := Str("\+", Primar(), -1)
    ELSIF tok = tAtom THEN
      Strings.Copy(tnume, f); Urm;
      IF tok = tPd THEN
        Urm; ar := 0; a := t700(); ultim := a; INC(ar);
        k := Nod(fStr, AtomL(f), 0); IF k < MN THEN nKid[k] := a END;
        WHILE ~eroare & (tok = tVirg) DO Urm; a := t700(); Frate(ultim, a); ultim := a; INC(ar) END;
        IF tok = tPi THEN Urm ELSE Rau("aștept ) după argumente") END;
        IF ar > 15 THEN Rau("cel mult 15 argumente") END;
        IF k < MN THEN nAr[k] := ar END
      ELSE k := Nod(fAtom, AtomL(f), 0)
      END
    ELSE Rau("aștept un nume, un număr sau o variabilă"); Urm; k := Nod(fAtom, 0, 0)
    END;
    RETURN k
  END Primar;

  PROCEDURE T400(): INTEGER;
    VAR k: INTEGER; o: ARRAY 8 OF CHAR;
  BEGIN
    k := Primar();
    WHILE ~eroare & (tok = tAtom) & ((tnume = "*") OR (tnume = "//") OR (tnume = "mod")) DO
      Strings.Copy(tnume, o); Urm; k := Str(o, k, Primar())
    END;
    RETURN k
  END T400;

  PROCEDURE T500(): INTEGER;
    VAR k: INTEGER; o: ARRAY 8 OF CHAR;
  BEGIN
    k := T400();
    WHILE ~eroare & (tok = tAtom) & ((tnume = "+") OR (tnume = "-")) DO Strings.Copy(tnume, o); Urm; k := Str(o, k, T400()) END;
    RETURN k
  END T500;

  PROCEDURE T700(): INTEGER;
    VAR k: INTEGER; o: ARRAY 8 OF CHAR;
  BEGIN
    k := T500();
    IF ~eroare & (tok = tAtom) & ((tnume = "=") OR (tnume = "\=") OR (tnume = "is") OR (tnume = "<") OR (tnume = ">")
      OR (tnume = "=<") OR (tnume = ">=") OR (tnume = "=:=") OR (tnume = "=\=")) THEN
      Strings.Copy(tnume, o); Urm; k := Str(o, k, T500())
    END;
    RETURN k
  END T700;

  PROCEDURE Pune(v: INTEGER);
  BEGIN IF nw < MW THEN w[nw] := v; INC(nw) ELSE Rau("prea multe clauze în program") END
  END Pune;

  PROCEDURE Emite(k: INTEGER);   (* termenul k, in prefix *)
    VAR a, v: INTEGER;
  BEGIN
    IF (k >= 0) & (k < nn) & ~eroare THEN
      IF nT[k] = fInt THEN v := nV[k]; IF v >= 0 THEN v := 2 * v ELSE v := -2 * v - 1 END; Pune(v * 4 + fInt)
      ELSIF nT[k] = fStr THEN
        Pune((nV[k] * 16 + nAr[k]) * 4 + fStr);
        a := nKid[k]; WHILE a >= 0 DO Emite(a); a := nNext[a] END
      ELSE Pune(nV[k] * 4 + nT[k])
      END
    END
  END Emite;

  PROCEDURE Clauza*(VAR text: ARRAY OF CHAR; VAR poz, rand: INTEGER; intrebare: BOOLEAN; VAR err: ARRAY OF CHAR): INTEGER;
    (* citeste o clauza (sau, cu intrebare, ce e dupa ?-) pana la . ; poz si rand merg mai departe.
       Intoarce numarul intrebarii (0 pentru o clauza), -1 = greseala (err) *)
    VAR i, cap, nrg, k, start: INTEGER; scop: ARRAY 64 OF INTEGER;
  BEGIN
    i := 0; WHILE (i < LEN(text)) & (i < LEN(src) - 2) & (text[i] # 0X) DO src[i] := text[i]; INC(i) END;
    src[i] := 0X; src[i + 1] := 0X;
    p := poz; rnd := rand; eroare := FALSE; mesaj := ""; nn := 0; nvn := 0; nrg := 0; cap := -1;
    Urm;
    IF ~intrebare THEN
      cap := T700();
      IF ~eroare & (tok = tAtom) & (tnume = ":-") THEN
        Urm; REPEAT IF tok = tVirg THEN Urm END; IF nrg < 64 THEN scop[nrg] := T700(); INC(nrg) ELSE Rau("prea multe scopuri") END UNTIL eroare OR (tok # tVirg)
      END
    ELSE
      REPEAT IF tok = tVirg THEN Urm END; IF nrg < 64 THEN scop[nrg] := T700(); INC(nrg) ELSE Rau("prea multe scopuri") END UNTIL eroare OR (tok # tVirg)
    END;
    cuDO := intrebare & ~eroare & (tok = tVar) & (tnume = "DO");
    IF ~eroare & (tok # tGata) & ~cuDO THEN Rau("clauza se termină cu un punct (sau, la ?- într-un program, cu DO … END)") END;
    IF ~eroare & ~intrebare & (nT[cap] # fAtom) & (nT[cap] # fStr) THEN Rau("capul clauzei trebuie să fie un nume") END;
    k := 0;
    IF ~eroare THEN
      start := nw;
      IF intrebare THEN
        IF nq >= MQ THEN Rau("prea multe întrebări") ELSE qOff[nq] := start; k := nq; INC(nq) END;
        Pune(nvn); FOR i := 0 TO nvn - 1 DO Pune(AtomL(vn[i])) END; FOR i := 0 TO nvn - 1 DO Pune(0) END   (* legaturile *)
      ELSE
        IF nc >= MCl THEN Rau("prea multe clauze") ELSE cOff[nc] := start; INC(nc) END;
        Pune(nvn); Emite(cap)
      END;
      Pune(nrg); FOR i := 0 TO nrg - 1 DO Emite(scop[i]) END
    END;
    poz := p; rand := rnd;
    IF eroare THEN Strings.Copy(mesaj, err); k := -1 ELSE err := "" END;
    RETURN k
  END Clauza;

  PROCEDURE NrVar*(): INTEGER;   (* variabilele intrebarii citite acum *)
  BEGIN RETURN nvn
  END NrVar;

  PROCEDURE NumeVar*(i: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF (i >= 0) & (i < nvn) THEN Strings.Copy(vn[i], s) ELSE s := "" END
  END NumeVar;

  PROCEDURE LeagaVar*(q, i, lw: INTEGER);   (* legatura variabilei i a intrebarii q (vezi sus) *)
  BEGIN IF (q >= 0) & (q < nq) THEN w[qOff[q] + 1 + w[qOff[q]] + i] := lw END
  END LeagaVar;

  PROCEDURE Lungime*(): INTEGER;   (* cate cuvinte ar ocupa zona in tor *)
    VAR i, s: INTEGER;
  BEGIN
    s := 4 + nc + nq + 1 + nw;
    FOR i := 0 TO na - 1 DO s := s + Strings.Length(an[i]) + 1 END;
    RETURN s
  END Lungime;

  PROCEDURE ScrieZona*(adr: INTEGER);   (* clauzele, intrebarile si numele, in tor, de la adr *)
    VAR i, k, b, x: INTEGER;
  BEGIN
    b := 4 + nc + nq + 1;   (* de aici incep clauzele *)
    Tor7.PuneCuvant(adr, Semn); Tor7.PuneCuvant(adr + 12, nc); Tor7.PuneCuvant(adr + 24, nq); Tor7.PuneCuvant(adr + 36, na);
    FOR i := 0 TO nc - 1 DO Tor7.PuneCuvant(adr + 12 * (4 + i), b + cOff[i]) END;
    FOR i := 0 TO nq - 1 DO Tor7.PuneCuvant(adr + 12 * (4 + nc + i), b + qOff[i]) END;
    Tor7.PuneCuvant(adr + 12 * (4 + nc + nq), b + nw);
    FOR i := 0 TO nw - 1 DO Tor7.PuneCuvant(adr + 12 * (b + i), w[i]) END;
    x := b + nw;
    FOR i := 0 TO na - 1 DO
      k := 0; WHILE an[i][k] # 0X DO Tor7.PuneCuvant(adr + 12 * x, ORD(an[i][k])); INC(x); INC(k) END;
      Tor7.PuneCuvant(adr + 12 * x, 0); INC(x)
    END
  END ScrieZona;

  (* ======================= motorul ======================= *)

  PROCEDURE AtomG*(s: ARRAY OF CHAR): INTEGER;   (* atomul global cu numele s *)
    VAR i, r: INTEGER;
  BEGIN
    r := -1; i := 0; WHILE (r < 0) & (i < ng) DO IF gn[i] = s THEN r := i END; INC(i) END;
    IF r < 0 THEN IF ng < MG THEN Strings.Copy(s, gn[ng]); r := ng; INC(ng) ELSE plin := TRUE; r := 0 END END;
    RETURN r
  END AtomG;

  PROCEDURE Cit(i: INTEGER): INTEGER;   (* cuvantul i al zonei: din tor sau din compilarea de acum *)
    VAR r: INTEGER;
  BEGIN IF dinTor THEN r := Tor7.Cuvant(zona + 12 * i) ELSE r := w[i] END; RETURN r
  END Cit;

  PROCEDURE Traduce(cw: INTEGER): INTEGER;   (* un cuvant de termen, cu atomul local facut global *)
    VAR f, v, r: INTEGER;
  BEGIN
    f := cw MOD 4; v := cw DIV 4; r := cw;
    IF (f = fAtom) & (v >= 0) & (v < MA) THEN r := loc[v] * 4 + fAtom
    ELSIF (f = fStr) & (v DIV 16 < MA) THEN r := (loc[v DIV 16] * 16 + v MOD 16) * 4 + fStr
    END;
    RETURN r
  END Traduce;

  PROCEDURE CopiazaTermen(VAR i: INTEGER);   (* un termen din zona in cd *)
    VAR cw, k, ar: INTEGER;
  BEGIN
    cw := Cit(i); INC(i);
    IF ncd < MCD THEN cd[ncd] := Traduce(cw); INC(ncd) ELSE plin := TRUE END;
    IF cw MOD 4 = fStr THEN ar := cw DIV 4 MOD 16; FOR k := 1 TO ar DO CopiazaTermen(i) END END
  END CopiazaTermen;

  PROCEDURE Atomii(baza: INTEGER);   (* numele atomilor zonei -> loc[] *)
    VAR nA, x, k, c: INTEGER; s: ARRAY 40 OF CHAR;
  BEGIN
    nA := Cit(3); x := Cit(4 + Cit(1) + Cit(2));
    FOR k := 0 TO nA - 1 DO
      c := 0; s := "";
      REPEAT
        IF dinTor THEN c := Tor7.Cuvant(baza + 12 * x) ELSE c := 0 END; INC(x);
        IF (c > 0) & (Strings.Length(s) < 39) THEN Strings.AppendChar(CHR(c), s) END
      UNTIL c <= 0;
      IF k < MA THEN loc[k] := AtomG(s) END
    END
  END Atomii;

  PROCEDURE IncarcaZona(baza: INTEGER);   (* clauzele unei zone din tor *)
    VAR k, i, n0, nv, cw: INTEGER;
  BEGIN
    dinTor := TRUE; zona := baza; Atomii(baza);
    n0 := Cit(1);
    FOR k := 0 TO n0 - 1 DO
      IF ncl < MCL THEN
        i := Cit(4 + k); nv := Cit(i); INC(i);
        cw := Traduce(Cit(i));
        clS[ncl] := ncd; clNv[ncl] := nv;
        IF cw MOD 4 = fStr THEN clF[ncl] := cw DIV 4 DIV 16; clAr[ncl] := cw DIV 4 MOD 16 ELSE clF[ncl] := cw DIV 4; clAr[ncl] := 0 END;
        CopiazaTermen(i);                                   (* capul *)
        cw := Cit(i); INC(i); IF ncd < MCD THEN cd[ncd] := cw; INC(ncd) END;   (* cate scopuri *)
        WHILE cw > 0 DO CopiazaTermen(i); DEC(cw) END;
        INC(ncl)
      ELSE plin := TRUE
      END
    END
  END IncarcaZona;

  PROCEDURE ZonaTurei*(t: INTEGER): INTEGER;   (* adresa zonei Prolog a turei t, -1 = nu are *)
    VAR a, r: INTEGER;
  BEGIN
    r := -1; a := Tor7.Cuvant(t * Tor7.Tura + Pointer);
    IF (a > t * Tor7.Tura) & (a < (t + 1) * Tor7.Tura - 48) THEN IF Tor7.Cuvant(a) = Semn THEN r := a END END;
    RETURN r
  END ZonaTurei;

  PROCEDURE IncarcaTot;   (* tot ce e acum in tor: turele pe rand *)
    VAR t, a: INTEGER;
  BEGIN
    ncd := 0; ncl := 0; plin := FALSE;
    FOR t := 0 TO 6 DO a := ZonaTurei(t); IF a >= 0 THEN IncarcaZona(a) END END
  END IncarcaTot;

  (* ---- heap-ul ---- *)
  PROCEDURE Celula(t, v: INTEGER): INTEGER;
  BEGIN
    IF h < MH THEN hT[h] := t; hV[h] := v; hA[h] := 0; INC(h) ELSE plin := TRUE END;
    RETURN h - 1
  END Celula;

  PROCEDURE NouaVar(): INTEGER;
  BEGIN RETURN Celula(hRef, h)
  END NouaVar;

  PROCEDURE Deref(c: INTEGER): INTEGER;
  BEGIN WHILE (c >= 0) & (hT[c] = hRef) & (hV[c] # c) DO c := hV[c] END; RETURN c
  END Deref;

  PROCEDURE Construieste(VAR i: INTEGER; vb: INTEGER): INTEGER;   (* termenul din cd[i..], cu variabilele de la vmap[vb] *)
    VAR cw, f, v, ar, fc, k, c, r: INTEGER;
  BEGIN
    cw := cd[i]; INC(i); f := cw MOD 4; v := cw DIV 4; r := -1;
    IF f = fAtom THEN r := Celula(hAtom, v)
    ELSIF f = fInt THEN IF ODD(v) THEN r := Celula(hInt, -(v + 1) DIV 2) ELSE r := Celula(hInt, v DIV 2) END
    ELSIF f = fVar THEN
      IF vb + v < LEN(vmap) THEN
        IF vmap[vb + v] < 0 THEN vmap[vb + v] := NouaVar() END; r := vmap[vb + v]
      ELSE plin := TRUE; r := NouaVar()
      END
    ELSE
      ar := v MOD 16; fc := Celula(hFun, v DIV 16);
      IF fc >= 0 THEN hA[fc] := ar END;
      FOR k := 1 TO ar DO r := Celula(hRef, 0) END;   (* locurile argumentelor *)
      FOR k := 1 TO ar DO
        c := Construieste(i, vb);
        IF (fc + k < MH) & (c >= 0) THEN
          IF hT[c] = hRef THEN hT[fc + k] := hRef; hV[fc + k] := Deref(c) ELSE hT[fc + k] := hT[c]; hV[fc + k] := hV[c] END
        END
      END;
      r := Celula(hStr, fc)
    END;
    RETURN r
  END Construieste;

  PROCEDURE Leaga(a, b: INTEGER);   (* variabila a primeste valoarea b *)
  BEGIN hV[a] := b; IF ntr < MTr THEN tr[ntr] := a; INC(ntr) ELSE plin := TRUE END
  END Leaga;

  PROCEDURE Desface(m: INTEGER);   (* inapoi pana la urma m *)
  BEGIN WHILE ntr > m DO DEC(ntr); hV[tr[ntr]] := tr[ntr] END
  END Desface;

  PROCEDURE Potriveste(a, b: INTEGER): BOOLEAN;   (* unificarea *)
    VAR st: ARRAY 2000 OF INTEGER; ns, k, fa, fb, ar: INTEGER; ok: BOOLEAN;
  BEGIN
    ok := TRUE; ns := 0; st[0] := a; st[1] := b; ns := 2;
    WHILE ok & (ns > 0) DO
      DEC(ns, 2); a := Deref(st[ns]); b := Deref(st[ns + 1]);
      IF a = b THEN
      ELSIF hT[a] = hRef THEN IF hT[b] = hRef THEN IF a > b THEN Leaga(a, b) ELSE Leaga(b, a) END ELSE Leaga(a, b) END
      ELSIF hT[b] = hRef THEN Leaga(b, a)
      ELSIF hT[a] # hT[b] THEN ok := FALSE
      ELSIF (hT[a] = hAtom) OR (hT[a] = hInt) THEN ok := hV[a] = hV[b]
      ELSE
        fa := hV[a]; fb := hV[b];
        IF (hV[fa] # hV[fb]) OR (hA[fa] # hA[fb]) THEN ok := FALSE
        ELSE
          ar := hA[fa];
          IF ns + 2 * ar > LEN(st) THEN ok := FALSE; plin := TRUE
          ELSE FOR k := 1 TO ar DO st[ns] := fa + k; st[ns + 1] := fb + k; INC(ns, 2) END
          END
        END
      END
    END;
    RETURN ok
  END Potriveste;

  PROCEDURE Arg(c, k: INTEGER): INTEGER;   (* argumentul k (1..) al structurii c *)
  BEGIN c := Deref(c); RETURN hV[c] + k
  END Arg;

  PROCEDURE Valoare(c: INTEGER; VAR ok: BOOLEAN): INTEGER;   (* aritmetica pentru is si comparatii *)
    VAR f, a, b, r: INTEGER;
  BEGIN
    r := 0; c := Deref(c);
    IF ~ok THEN
    ELSIF hT[c] = hInt THEN r := hV[c]
    ELSIF hT[c] = hStr THEN
      f := hV[hV[c]];
      IF hA[hV[c]] = 2 THEN
        a := Valoare(Arg(c, 1), ok); b := Valoare(Arg(c, 2), ok);
        IF f = aPlus THEN r := a + b ELSIF f = aMinus THEN r := a - b ELSIF f = aOri THEN r := a * b
        ELSIF (f = aDiv) & (b # 0) THEN r := a DIV b ELSIF (f = aMod) & (b # 0) THEN r := a MOD b
        ELSE ok := FALSE
        END
      ELSIF (hA[hV[c]] = 1) & (f = aMinus) THEN r := -Valoare(Arg(c, 1), ok)
      ELSE ok := FALSE
      END
    ELSE ok := FALSE
    END;
    RETURN r
  END Valoare;

  (* ---- scopurile si alegerile ---- *)
  PROCEDURE Scop(t, urm, taie: INTEGER): INTEGER;
  BEGIN
    IF ngd < MGn THEN gT[ngd] := t; gN[ngd] := urm; gC[ngd] := taie; INC(ngd) ELSE plin := TRUE END;
    RETURN ngd - 1
  END Scop;

  PROCEDURE Alegere(g, k: INTEGER);   (* k = urmatoarea clauza; -1 = scopurile g, asa cum sunt *)
  BEGIN
    IF ncp < MCp THEN cpG[ncp] := g; cpK[ncp] := k; cpH[ncp] := h; cpTr[ncp] := ntr; cpGd[ncp] := ngd; INC(ncp) ELSE plin := TRUE END
  END Alegere;

  PROCEDURE Functor(c: INTEGER; VAR f, ar: INTEGER): BOOLEAN;
    VAR ok: BOOLEAN;
  BEGIN
    c := Deref(c); ok := TRUE;
    IF hT[c] = hAtom THEN f := hV[c]; ar := 0
    ELSIF hT[c] = hStr THEN f := hV[hV[c]]; ar := hA[hV[c]]
    ELSE ok := FALSE
    END;
    RETURN ok
  END Functor;

  PROCEDURE Urmatoarea(k, f, ar: INTEGER): INTEGER;   (* prima clauza de la k cu f/ar; -1 = niciuna *)
  BEGIN
    WHILE (k < ncl) & ((clF[k] # f) OR (clAr[k] # ar)) DO INC(k) END;
    IF k >= ncl THEN k := -1 END;
    RETURN k
  END Urmatoarea;

  PROCEDURE Incearca(g, k: INTEGER; VAR goals: INTEGER): BOOLEAN;
    (* scopul g cu clauzele de la k; TRUE = una s-a potrivit (goals = corpul ei, apoi restul) *)
    VAR f, ar, mh, mtr, mgd, i, vb, cap, n, j, b, k2: INTEGER; ok: BOOLEAN; sc: ARRAY 64 OF INTEGER;
  BEGIN
    ok := FALSE;
    IF Functor(gT[g], f, ar) THEN
      k := Urmatoarea(k, f, ar);
      WHILE ~ok & (k >= 0) & ~plin DO
        mh := h; mtr := ntr; mgd := ngd;
        vb := 0; FOR i := 0 TO clNv[k] - 1 DO IF i < LEN(vmap) THEN vmap[i] := -1 END END;
        i := clS[k]; cap := Construieste(i, vb);
        IF Potriveste(gT[g], cap) THEN
          ok := TRUE; b := ncp;
          k2 := Urmatoarea(k + 1, f, ar);
          n := cd[i]; INC(i);
          FOR j := 0 TO n - 1 DO IF j < 64 THEN sc[j] := Construieste(i, vb) END END;
          IF k2 >= 0 THEN   (* alternativa: aceeasi stare ca inainte de cap *)
            IF ncp < MCp THEN cpG[ncp] := g; cpK[ncp] := k2; cpH[ncp] := mh; cpTr[ncp] := mtr; cpGd[ncp] := mgd; INC(ncp) ELSE plin := TRUE END
          END;
          goals := gN[g];
          FOR j := n - 1 TO 0 BY -1 DO IF j < 64 THEN goals := Scop(sc[j], goals, b) END END
        ELSE Desface(mtr); h := mh; ngd := mgd; k := Urmatoarea(k + 1, f, ar)
        END
      END
    END;
    RETURN ok
  END Incearca;

  PROCEDURE Inapoi(VAR goals: INTEGER): BOOLEAN;   (* ultima alegere; FALSE = nu mai sunt *)
    VAR gata, ok: BOOLEAN; c: INTEGER;
  BEGIN
    gata := FALSE; ok := FALSE;
    WHILE ~gata DO
      IF ncp = 0 THEN gata := TRUE
      ELSE
        DEC(ncp); c := ncp;
        Desface(cpTr[c]); h := cpH[c]; ngd := cpGd[c];
        IF cpK[c] < 0 THEN goals := cpG[c]; ok := TRUE; gata := TRUE
        ELSIF Incearca(cpG[c], cpK[c], goals) THEN ok := TRUE; gata := TRUE
        END
      END
    END;
    RETURN ok
  END Inapoi;

  (* ---- scrierea termenilor ---- *)
  PROCEDURE ScrieT(c: INTEGER; VAR s: ARRAY OF CHAR);
    VAR f, k, ar, x: INTEGER;
  BEGIN
    c := Deref(c);
    IF Strings.Length(s) > LEN(s) - 20 THEN
    ELSIF hT[c] = hRef THEN Strings.Append("_G", s); Strings.AppendInt(c, 0, s)
    ELSIF hT[c] = hAtom THEN Strings.Append(gn[hV[c]], s)
    ELSIF hT[c] = hInt THEN Strings.AppendInt(hV[c], 0, s)
    ELSE
      f := hV[hV[c]]; ar := hA[hV[c]];
      IF (f = aPunct) & (ar = 2) THEN
        Strings.Append("[", s); ScrieT(Arg(c, 1), s); x := Deref(Arg(c, 2));
        WHILE (hT[x] = hStr) & (hV[hV[x]] = aPunct) & (hA[hV[x]] = 2) & (Strings.Length(s) < LEN(s) - 20) DO
          Strings.Append(", ", s); ScrieT(Arg(x, 1), s); x := Deref(Arg(x, 2))
        END;
        IF ~((hT[x] = hAtom) & (hV[x] = aNil)) THEN Strings.Append(" | ", s); ScrieT(x, s) END;
        Strings.Append("]", s)
      ELSE
        Strings.Append(gn[f], s); Strings.Append("(", s);
        FOR k := 1 TO ar DO IF k > 1 THEN Strings.Append(", ", s) END; ScrieT(Arg(c, k), s) END;
        Strings.Append(")", s)
      END
    END
  END ScrieT;

  PROCEDURE Val(c: INTEGER): INTEGER;   (* un termen ca numar Z7: numarul, sau BazaAtom + numele (textul, la liste) *)
    VAR r: INTEGER; s: ARRAY 200 OF CHAR;
  BEGIN
    c := Deref(c);
    IF hT[c] = hInt THEN r := hV[c]
    ELSIF hT[c] = hAtom THEN r := BazaAtom + hV[c]
    ELSE s := ""; ScrieT(c, s); r := BazaAtom + AtomG(s)
    END;
    RETURN r
  END Val;

  PROCEDURE DinVal(v: INTEGER): INTEGER;   (* inapoi: un numar Z7 ca termen *)
    VAR r: INTEGER;
  BEGIN
    IF (v >= BazaAtom) & (v - BazaAtom < ng) THEN r := Celula(hAtom, v - BazaAtom) ELSE r := Celula(hInt, v) END;
    RETURN r
  END DinVal;

  PROCEDURE Solutie(nv: INTEGER; VAR nume: ARRAY OF ARRAY OF CHAR);
    VAR s: ARRAY 200 OF CHAR; i: INTEGER; prim: BOOLEAN;
  BEGIN
    s := ""; prim := TRUE;
    FOR i := 0 TO nv - 1 DO
      IF (nume[i][0] # "_") & (qv[i] >= 0) & ~((i < MVc) & inA[i]) THEN   (* cele date de program nu se mai scriu *)
        IF ~prim THEN Strings.Append(", ", s) END; prim := FALSE;
        Strings.Append(nume[i], s); Strings.Append(" = ", s); ScrieT(qv[i], s)
      END
    END;
    IF prim THEN s := "da" END;
    IF slot >= 0 THEN   (* bucla: valorile, pentru variabilele Z7 *)
      IF slN[slot] < MB THEN FOR i := 0 TO nv - 1 DO IF (i < MVb) & (qv[i] >= 0) THEN slVal[slot][slN[slot]][i] := Val(qv[i]) END END; INC(slN[slot]) END
    ELSIF nrez < MSol THEN Strings.Copy(s, rez[nrez]); INC(nrez)
    END;
    INC(nsol)
  END Solutie;

  PROCEDURE Rezolva(qi, nv, maxs: INTEGER; VAR nume: ARRAY OF ARRAY OF CHAR);   (* intrebarea din cd[qi..] *)
    VAR goals, n, j, i, g, f, ar, a, b, bar: INTEGER; sc: ARRAY 64 OF INTEGER; gata, ok: BOOLEAN;
  BEGIN
    h := 0; ntr := 0; ngd := 0; ncp := 0; pasi := 0; oprit := FALSE; nsol := 0; nrez := 0;
    FOR j := 0 TO nv - 1 DO vmap[j] := -1; IF (j < MVc) & inA[j] THEN vmap[j] := DinVal(inV[j]) END END;
    i := qi; n := cd[i]; INC(i);
    FOR j := 0 TO n - 1 DO IF j < 64 THEN sc[j] := Construieste(i, 0) END END;
    goals := -1; FOR j := n - 1 TO 0 BY -1 DO IF j < 64 THEN goals := Scop(sc[j], goals, 0) END END;
    FOR j := 0 TO nv - 1 DO IF j < MVc THEN qv[j] := vmap[j] END END;
    gata := FALSE;
    WHILE ~gata DO
      IF plin THEN gata := TRUE
      ELSIF pasi >= PASI THEN oprit := TRUE; gata := TRUE
      ELSIF goals < 0 THEN
        Solutie(nv, nume);
        IF nsol >= maxs THEN gata := TRUE ELSIF ~Inapoi(goals) THEN gata := TRUE END
      ELSE
        INC(pasi); g := goals;
        IF gT[g] < 0 THEN ncp := gC[g]; goals := gN[g]   (* taietura lui \+ *)
        ELSIF ~Functor(gT[g], f, ar) THEN IF ~Inapoi(goals) THEN gata := TRUE END
        ELSE
          ok := TRUE;
          IF (f = aTrue) & (ar = 0) THEN goals := gN[g]
          ELSIF (f = aFail) & (ar = 0) THEN ok := FALSE
          ELSIF (f = aTaie) & (ar = 0) THEN ncp := gC[g]; goals := gN[g]
          ELSIF (f = aVirg) & (ar = 2) THEN goals := Scop(Arg(gT[g], 1), Scop(Arg(gT[g], 2), gN[g], gC[g]), gC[g])
          ELSIF (f = aEg) & (ar = 2) THEN ok := Potriveste(Arg(gT[g], 1), Arg(gT[g], 2)); IF ok THEN goals := gN[g] END
          ELSIF (f = aDifU) & (ar = 2) THEN
            a := ntr; ok := ~Potriveste(Arg(gT[g], 1), Arg(gT[g], 2)); Desface(a); IF ok THEN goals := gN[g] END
          ELSIF (f = aIs) & (ar = 2) THEN
            ok := TRUE; a := Valoare(Arg(gT[g], 2), ok);
            IF ok THEN ok := Potriveste(Arg(gT[g], 1), Celula(hInt, a)) END; IF ok THEN goals := gN[g] END
          ELSIF ((f = aMic) OR (f = aMare) OR (f = aMicEg) OR (f = aMareEg) OR (f = aEgA) OR (f = aDifA)) & (ar = 2) THEN
            ok := TRUE; a := Valoare(Arg(gT[g], 1), ok); b := Valoare(Arg(gT[g], 2), ok);
            IF ok THEN
              IF f = aMic THEN ok := a < b ELSIF f = aMare THEN ok := a > b ELSIF f = aMicEg THEN ok := a <= b
              ELSIF f = aMareEg THEN ok := a >= b ELSIF f = aEgA THEN ok := a = b ELSE ok := a # b END
            END;
            IF ok THEN goals := gN[g] END
          ELSIF (f = aNu) & (ar = 1) THEN   (* \+ G : alternativa = restul; G, taie, fail *)
            bar := ncp; Alegere(gN[g], -1);
            goals := Scop(Arg(gT[g], 1), Scop(-1, Scop(Celula(hAtom, aFail), -1, 0), bar), ncp)
          ELSE ok := Incearca(g, 0, goals)
          END;
          IF ~ok THEN IF ~Inapoi(goals) THEN gata := TRUE END END
        END
      END
    END
  END Rezolva;

  PROCEDURE Final;   (* ce spune la sfarsitul intrebarii *)
    VAR s: ARRAY 200 OF CHAR;
  BEGIN
    IF nsol = 0 THEN
      IF oprit THEN s := "m-am oprit după "; Strings.AppendInt(PASI, 0, s); Strings.Append(" de pași (o buclă fără sfârșit?)", s)
      ELSIF plin THEN s := "nu mai am loc (întrebarea e prea mare)"
      ELSE s := "nu"
      END;
      IF nrez < MSol THEN Strings.Copy(s, rez[nrez]); INC(nrez) END
    ELSIF oprit OR plin THEN
      s := "… (m-am oprit aici: "; IF oprit THEN Strings.AppendInt(PASI, 0, s); Strings.Append(" de pași)", s) ELSE Strings.Append("nu mai am loc)", s) END;
      IF nrez < MSol THEN Strings.Copy(s, rez[nrez]); INC(nrez) END
    END
  END Final;

  PROCEDURE Intreaba(qi, maxs, baza: INTEGER);   (* intrebarea qi din zona citita acum (din tor sau din w); baza = tura *)
    VAR nv, i, k, qc: INTEGER; nume: ARRAY MVc OF ARRAY 24 OF CHAR; cw: INTEGER;
  BEGIN
    nv := Cit(qi); k := qi + 1;
    FOR i := 0 TO nv - 1 DO IF i < MVc THEN cw := Cit(k); IF (cw >= 0) & (cw < MA) THEN Strings.Copy(gn[loc[cw]], nume[i]) END END; INC(k) END;
    FOR i := 0 TO nv - 1 DO   (* legaturile cu variabilele Z7 *)
      cw := Cit(k); INC(k);
      IF i < MVc THEN
        inA[i] := (cw < 0) & (baza >= 0); outO[i] := -1;
        IF inA[i] THEN inV[i] := Tor7.Cuvant(baza - cw - 1) ELSIF cw > 0 THEN outO[i] := cw - 1 END
      END
    END;
    qc := ncd; cw := Cit(k); INC(k);
    IF ncd < MCD THEN cd[ncd] := cw; INC(ncd) END;
    WHILE cw > 0 DO CopiazaTermen(k); DEC(cw) END;
    Rezolva(qc, nv, maxs, nume); IF slot < 0 THEN Final END
  END Intreaba;

  PROCEDURE IntrebareaTurei*(t, q: INTEGER): INTEGER;   (* ?- din programul de pe tura t; raspunsurile in rez *)
    VAR a: INTEGER;
  BEGIN
    IncarcaTot; nrez := 0; nsol := 0;
    a := ZonaTurei(t);
    IF a < 0 THEN rez[0] := "nu găsesc clauzele programului"; nrez := 1
    ELSE slot := -1; dinTor := TRUE; zona := a; Atomii(a); IF (q >= 0) & (q < Cit(2)) THEN Intreaba(Cit(4 + Cit(1) + q), MSol, t * Tor7.Tura) END
    END;
    RETURN nsol
  END IntrebareaTurei;

  PROCEDURE Locul(t, q: INTEGER; nou: BOOLEAN): INTEGER;   (* locul raspunsurilor buclei q de pe tura t *)
    VAR i, r: INTEGER;
  BEGIN
    r := -1; FOR i := 0 TO MSl - 1 DO IF (slT[i] = t) & (slQ[i] = q) THEN r := i END END;
    IF (r < 0) & nou THEN   (* unul liber, sau cel mai vechi *)
      r := 0; FOR i := 1 TO MSl - 1 DO IF slVarsta[i] < slVarsta[r] THEN r := i END END
    END;
    IF r >= 0 THEN INC(varsta); slVarsta[r] := varsta END;
    RETURN r
  END Locul;

  PROCEDURE IncepeBucla*(t, q: INTEGER): INTEGER;   (* ?- ... DO: toate raspunsurile (cel mult 200); rez = ce e de spus *)
    VAR a, i, n, qi: INTEGER;
  BEGIN
    IncarcaTot; nrez := 0; nsol := 0; n := 0;
    a := ZonaTurei(t);
    IF a < 0 THEN rez[0] := "nu găsesc clauzele programului"; nrez := 1
    ELSE
      dinTor := TRUE; zona := a; Atomii(a);
      IF (q >= 0) & (q < Cit(2)) THEN
        slot := Locul(t, q, TRUE); slT[slot] := t; slQ[slot] := q; slN[slot] := 0; slI[slot] := 0;
        qi := Cit(4 + Cit(1) + q);
        Intreaba(qi, MB, t * Tor7.Tura);
        slNv[slot] := Cit(qi); FOR i := 0 TO MVb - 1 DO IF i < Cit(qi) THEN slOff[slot][i] := outO[i] ELSE slOff[slot][i] := -1 END END;
        n := slN[slot]; slot := -1;
        IF oprit THEN rez[0] := "bucla: m-am oprit după "; Strings.AppendInt(PASI, 0, rez[0]); Strings.Append(" de pași", rez[0]); nrez := 1
        ELSIF plin THEN rez[0] := "bucla: nu mai am loc"; nrez := 1
        ELSIF n = MB THEN rez[0] := "bucla: iau doar primele 200 de răspunsuri"; nrez := 1
        END
      END
    END;
    RETURN n
  END IncepeBucla;

  PROCEDURE Urmatorul*(t, q: INTEGER): INTEGER;   (* urmatorul raspuns al buclei, in variabilele Z7; 1 = mai e, 0 = gata *)
    VAR r, i, k: INTEGER;
  BEGIN
    r := 0; k := Locul(t, q, FALSE);
    IF (k >= 0) & (slI[k] < slN[k]) THEN
      FOR i := 0 TO slNv[k] - 1 DO
        IF (i < MVb) & (slOff[k][i] >= 0) THEN Tor7.PuneCuvant(t * Tor7.Tura + slOff[k][i], slVal[k][slI[k]][i]) END
      END;
      INC(slI[k]); r := 1
    ELSIF k >= 0 THEN slT[k] := -1   (* bucla s-a terminat: locul se elibereaza *)
    END;
    RETURN r
  END Urmatorul;

  PROCEDURE NumeVal*(v: INTEGER; VAR s: ARRAY OF CHAR);   (* SCRIEA: numele, sau numarul *)
  BEGIN
    IF (v >= BazaAtom) & (v - BazaAtom < ng) THEN Strings.Copy(gn[v - BazaAtom], s) ELSE s := ""; Strings.AppendInt(v, 0, s) END
  END NumeVal;

  PROCEDURE AtomDin*(adr: INTEGER): INTEGER;   (* ATOM("ana"): literele din tor (un cuvant pe litera, apoi 0) *)
    VAR s: ARRAY 40 OF CHAR; c, k: INTEGER;
  BEGIN
    s := ""; k := 0;
    REPEAT c := Tor7.Cuvant(adr + 12 * k); INC(k); IF (c > 0) & (c < 65536) & (k < 40) THEN Strings.AppendChar(CHR(c), s) END UNTIL (c <= 0) OR (k >= 40);
    RETURN BazaAtom + AtomG(s)
  END AtomDin;

  PROCEDURE IntrebareText*(VAR l: ARRAY OF CHAR): INTEGER;   (* ?- ... scris in Shell; raspunsurile in rez *)
    VAR k, poz, rand, i: INTEGER; err: ARRAY 160 OF CHAR;
  BEGIN
    nrez := 0; nsol := 0;
    poz := Strings.Pos("?-", l, 0) + 2; rand := 1; Gol;
    k := Clauza(l, poz, rand, TRUE, err);
    IF k < 0 THEN Strings.Copy(err, rez[0]); nrez := 1
    ELSE
      IncarcaTot;
      dinTor := FALSE;
      FOR i := 0 TO na - 1 DO loc[i] := AtomG(an[i]) END;
      slot := -1; FOR i := 0 TO MVc - 1 DO inA[i] := FALSE END;
      Intreaba(qOff[0], MSol, -1)
    END;
    Gol;
    RETURN nsol
  END IntrebareText;

  PROCEDURE Clauze*(): INTEGER;   (* cate clauze sunt acum in tor (dupa ultima intrebare) *)
  BEGIN RETURN ncl
  END Clauze;

BEGIN
  ng := 0; nw := 0; na := 0; nc := 0; nq := 0; plin := FALSE; dinTor := FALSE;
  aNil := AtomG("[]"); aPunct := AtomG("."); aTrue := AtomG("true"); aFail := AtomG("fail"); aEg := AtomG("=");
  aDifU := AtomG("\="); aIs := AtomG("is"); aMic := AtomG("<"); aMare := AtomG(">"); aMicEg := AtomG("=<");
  aMareEg := AtomG(">="); aEgA := AtomG("=:="); aDifA := AtomG("=\="); aPlus := AtomG("+"); aMinus := AtomG("-");
  aOri := AtomG("*"); aDiv := AtomG("//"); aMod := AtomG("mod"); aNu := AtomG("\+"); aTaie := AtomG("!");
  aVirg := AtomG(","); aNeg := aMinus; t700 := T700;
  slot := -1; varsta := 0; FOR nn := 0 TO MSl - 1 DO slT[nn] := -1; slVarsta[nn] := 0 END; nn := 0
END Z7P.


MODULE Z7L;  (* v2.5: codurile instructiunilor in 7 grupe; TURA PID DELA TIMP STARE CEAS trec prin SIST (scrii la fel).
     limbajul Z7: compilatorul care scrie programele direct in tor, ca instructiuni Tor7 (4 celule fiecare).
     Variabilele si tablourile stau tot in tor, pe tura procesului, cate un cuvant de 12 celule (vezi Tor7.Cuvant).
       x := 3 * (y + 1)        a[i] := x        VAR a[7], b
       IF c THEN ... ELSIF c THEN ... ELSE ... END      WHILE c DO ... END      REPEAT ... UNTIL c
       + - * DIV MOD   = # < <= > >=   & OR ~   'a' (codul literei)   comentarii (* ... *)
       SCRIE(x) SCRIEC(cod) SCRIEN(x) SCRIET("text") NOTA(n, oct) DORMI(ms) ASTEAPTA TRIMITE(v, tura) PUNE(adr, cifra)
       STOP OPRESTE(tura) CEDEAZA PORNESTE("prog.z7l") sau PORNESTE(a[i]) (numele scris in tablou)
       CAMP CITESTE(adr) PRIMESTE DELA VECIN BAZA TURA STARE(t) PID(t) TIMP PORNESTE(..) ca functie = tura noua sau -1
       v1.4: OPAL(p) CEAS(k) NOTAC(adr) NEF(adr) ca functii, CANTA(adr) PUNENEF(stare, adr) ca proceduri
       v1.5 Roler: ASCULTA(treapta) ca functie, COLT(c) EMITE(treapta, stare) ca proceduri
       v1.9: AMINTESTE(treapta) = adresa primei celule active care rezoneaza (-1 = niciuna); in tor: ASCULTA cu -(t+1)
       v2.0 Prolog (modulul Z7P): printre instructiuni, clauze  tata(ion, maria).  bunic(X, Z) :- parinte(X, Y), parinte(Y, Z).
         si intrebari  ?- bunic(ion, N).  (programul scrie raspunsurile); in tor: ASCULTA cu treapta -100 (chemarea sistemului 0)
       v2.1: ?- scopuri DO ... END = corpul pentru fiecare raspuns, cu variabilele Prolog in variabilele Z7 cu acelasi nume
         (cele care au deja valoare intra in intrebare); SCRIEA(x) scrie un nume; ATOM("ana") = numele ca numar
         (chemarile sistemului 101 incepe bucla, 102 urmatorul raspuns, 103 SCRIEA, 104 ATOM)
     v7 (7·B): CULOARE(r,g,b) DREPT(x,y,l,h) CERC(x,y,r) LINIE(x1,y1,x2,y2) TEXT(x,y,"..") TEXTN(x,y,n) MARIME(m) STERGE ARATA;
        ATINSX ATINSY APASAT LATIME INALTIME ORA MINUT SECUNDA ALEATOR(n): panza are 343 de unitati pe latime.
     Registrele: R0..R5 pentru expresii, R6 pentru salturi si adrese. *)
  IMPORT Strings, Tor7, Z7P;

  CONST Date* = 100000; Siruri* = 110000;
    MC = 6000; ML = 400; MF = 900; MV = 64; MS = 600;
    (* v2.5: codurile in 7 grupe (prima cifra = grupa), ca in Salamandra *)
    oSET = 1; oDIG = 2; oMOV = 3; oLD = 4; oST = 5; oNOTAC = 6;
    oADD = 7; oSUB = 8; oMUL = 9; oDIV = 10; oMOD = 11;
    oLT = 14; oEQ = 15; oJMP = 16; oJZ = 17;
    oLDW = 21; oSTW = 22; oCAMP = 25; oAST = 26; oBAZA = 27;
    oNEF = 28; oPNEF = 29; oCOLT = 30; oEMITE = 31; oASC = 32; oCANTA = 33; oNOTA = 34;
    oOPAL = 35; oSIST = 36; oDORMI = 38; oSCRIE = 39; oSCRIEC = 40; oSCRIEN = 41;
    oTRIM = 42; oPRIM = 43; oVECIN = 44; oPORN = 45; oOPR = 46; oSTOP = 47; oCED = 48;
    kTURA = 0; kPID = 1; kDELA = 2; kTIMP = 3; kSTARE = 4; kCEAS = 5;   (* SIST Ra, k *)
    sId = 1; sNr = 2; sSir = 3; sAtrib = 4; sPlus = 5; sMinus = 6; sOri = 7; sEg = 8; sDif = 9; sMic = 10; sMicEg = 11;
    sMare = 12; sMareEg = 13; sPd = 14; sPi = 15; sVirg = 16; sCd = 17; sCi = 18; sPv = 19; sSi = 20; sNu = 21; sGata = 22;
    sRau = 23; sIntreb = 24;

  VAR src: ARRAY 1700 OF CHAR; poz, rand, tpoz: INTEGER;
    sym, val: INTEGER; id: ARRAY 24 OF CHAR; sir: ARRAY 80 OF CHAR;
    cop, ca, cb: ARRAY MC OF INTEGER; pc: INTEGER;
    lab: ARRAY ML OF INTEGER; nl: INTEGER;
    fixPc, fixLab: ARRAY MF OF INTEGER; nf: INTEGER;
    vNume: ARRAY MV OF ARRAY 24 OF CHAR; vOff, vLung: ARRAY MV OF INTEGER; vDat: ARRAY MV OF BOOLEAN; nv, cuv: INTEGER;
    sCuv: ARRAY MS OF INTEGER; ns: INTEGER;
    eroare: BOOLEAN; mesaj: ARRAY 120 OF CHAR;
    expr: PROCEDURE (d: INTEGER);
    secv: PROCEDURE;

  PROCEDURE Rau(m: ARRAY OF CHAR);
  BEGIN
    IF ~eroare THEN
      eroare := TRUE; mesaj := "rândul "; Strings.AppendInt(rand, 0, mesaj); Strings.Append(": ", mesaj); Strings.Append(m, mesaj)
    END
  END Rau;

  PROCEDURE Rau2(m, x: ARRAY OF CHAR);
    VAR s: ARRAY 100 OF CHAR;
  BEGIN Strings.Copy(m, s); Strings.Append(x, s); Rau(s)
  END Rau2;

  (* ---------- cuvintele textului ---------- *)

  PROCEDURE Litera(c: CHAR): BOOLEAN;
  BEGIN RETURN (c >= "a") & (c <= "z") OR (c >= "A") & (c <= "Z") OR (c = "_") OR (c >= 80X)
  END Litera;

  PROCEDURE Cifra(c: CHAR): BOOLEAN;
  BEGIN RETURN (c >= "0") & (c <= "9")
  END Cifra;

  PROCEDURE Urm;
    VAR c: CHAR; k, adanc: INTEGER; gata: BOOLEAN;
  BEGIN
    gata := FALSE;
    REPEAT   (* spatii si comentarii *)
      c := src[poz];
      IF c = 0AX THEN INC(rand); INC(poz)
      ELSIF (c = " ") OR (c = 9X) OR (c = 0DX) THEN INC(poz)
      ELSIF (c = "(") & (src[poz + 1] = "*") THEN
        adanc := 1; poz := poz + 2;
        WHILE (adanc > 0) & (src[poz] # 0X) DO
          IF (src[poz] = "(") & (src[poz + 1] = "*") THEN INC(adanc); poz := poz + 2
          ELSIF (src[poz] = "*") & (src[poz + 1] = ")") THEN DEC(adanc); poz := poz + 2
          ELSE IF src[poz] = 0AX THEN INC(rand) END; INC(poz)
          END
        END
      ELSE gata := TRUE
      END
    UNTIL gata;
    c := src[poz]; tpoz := poz;
    IF c = 0X THEN sym := sGata
    ELSIF (c = "?") & (src[poz + 1] = "-") THEN poz := poz + 2; sym := sIntreb
    ELSIF Litera(c) THEN
      k := 0;
      WHILE Litera(src[poz]) OR Cifra(src[poz]) DO IF k < LEN(id) - 1 THEN id[k] := src[poz]; INC(k) END; INC(poz) END;
      id[k] := 0X; sym := sId
    ELSIF Cifra(c) THEN
      val := 0;
      WHILE Cifra(src[poz]) DO
        IF val < 200000000 THEN val := val * 10 + ORD(src[poz]) - ORD("0") END; INC(poz)
      END;
      sym := sNr
    ELSIF c = 22X THEN
      k := 0; INC(poz);
      WHILE (src[poz] # 22X) & (src[poz] # 0X) & (src[poz] # 0AX) DO IF k < LEN(sir) - 1 THEN sir[k] := src[poz]; INC(k) END; INC(poz) END;
      sir[k] := 0X;
      IF src[poz] = 22X THEN INC(poz); sym := sSir ELSE Rau("șirul nu se închide cu ghilimele"); sym := sRau END
    ELSIF c = "'" THEN
      IF (src[poz + 1] # 0X) & (src[poz + 2] = "'") THEN val := ORD(src[poz + 1]); poz := poz + 3; sym := sNr
      ELSE Rau("litera se scrie așa: 'a'"); INC(poz); sym := sRau
      END
    ELSE
      INC(poz);
      IF c = ":" THEN IF src[poz] = "=" THEN INC(poz); sym := sAtrib ELSE Rau("aștept := "); sym := sRau END
      ELSIF c = "<" THEN IF src[poz] = "=" THEN INC(poz); sym := sMicEg ELSE sym := sMic END
      ELSIF c = ">" THEN IF src[poz] = "=" THEN INC(poz); sym := sMareEg ELSE sym := sMare END
      ELSIF c = "+" THEN sym := sPlus ELSIF c = "-" THEN sym := sMinus ELSIF c = "*" THEN sym := sOri
      ELSIF c = "=" THEN sym := sEg ELSIF c = "#" THEN sym := sDif ELSIF c = "(" THEN sym := sPd ELSIF c = ")" THEN sym := sPi
      ELSIF c = "," THEN sym := sVirg ELSIF c = "[" THEN sym := sCd ELSIF c = "]" THEN sym := sCi ELSIF c = ";" THEN sym := sPv
      ELSIF c = "&" THEN sym := sSi ELSIF c = "~" THEN sym := sNu
      ELSE Rau("semn necunoscut"); sym := sRau
      END
    END
  END Urm;

  PROCEDURE Cuv(s: ARRAY OF CHAR): BOOLEAN;   (* simbolul curent e cuvantul s? *)
  BEGIN RETURN (sym = sId) & (id = s)
  END Cuv;

  PROCEDURE Astept(s: INTEGER; cum: ARRAY OF CHAR);
  BEGIN IF sym = s THEN Urm ELSE Rau2("aștept ", cum) END
  END Astept;

  PROCEDURE AsteptCuv(s: ARRAY OF CHAR);
  BEGIN IF Cuv(s) THEN Urm ELSE Rau2("lipsește ", s) END
  END AsteptCuv;

  (* ---------- codul ---------- *)

  PROCEDURE E(op, a, b: INTEGER);
  BEGIN
    IF pc < MC THEN cop[pc] := op; ca[pc] := a; cb[pc] := b; INC(pc) ELSE Rau("program prea lung") END
  END E;

  PROCEDURE Nr(r, n: INTEGER);   (* Rr := n (n >= 0) *)
    VAR d: ARRAY 12 OF INTEGER; k, j: INTEGER;
  BEGIN
    k := 0; REPEAT d[k] := n MOD 7; n := n DIV 7; INC(k) UNTIL n = 0;
    E(oSET, r, d[k - 1]);
    FOR j := k - 2 TO 0 BY -1 DO E(oDIG, r, d[j]) END
  END Nr;

  PROCEDURE NouaEt(): INTEGER;
  BEGIN IF nl < ML THEN lab[nl] := -1; INC(nl) ELSE Rau("prea multe salturi") END; RETURN nl - 1
  END NouaEt;

  PROCEDURE Aici(l: INTEGER);
  BEGIN IF (l >= 0) & (l < ML) THEN lab[l] := pc END
  END Aici;

  PROCEDURE Salt(op, r, l: INTEGER);   (* JMP / JZ catre eticheta l, prin R6 (5 cifre de adresa) *)
    VAR k: INTEGER;
  BEGIN
    IF nf < MF THEN fixPc[nf] := pc; fixLab[nf] := l; INC(nf) ELSE Rau("prea multe salturi") END;
    E(oSET, 6, 0); FOR k := 1 TO 4 DO E(oDIG, 6, 0) END;
    IF op = oJMP THEN E(oJMP, 6, 0) ELSE E(op, r, 6) END
  END Salt;

  PROCEDURE Nu(d: INTEGER);   (* Rd := (Rd = 0) *)
  BEGIN Nr(6, 0); E(oEQ, d, 6)
  END Nu;

  PROCEDURE Bool(d: INTEGER);   (* Rd := (Rd # 0) *)
  BEGIN Nu(d); Nu(d)
  END Bool;

  (* ---------- variabilele ---------- *)

  PROCEDURE Gaseste(n: ARRAY OF CHAR): INTEGER;
    VAR i, r: INTEGER;
  BEGIN r := -1; i := 0; WHILE (r < 0) & (i < nv) DO IF vNume[i] = n THEN r := i END; INC(i) END; RETURN r
  END Gaseste;

  PROCEDURE NouaVar(n: ARRAY OF CHAR; lung: INTEGER): INTEGER;
  BEGIN
    IF nv = MV THEN Rau("prea multe variabile (64)")
    ELSIF Date + 12 * (cuv + lung) > Siruri THEN Rau("variabilele nu mai încap în tură")
    ELSE Strings.Copy(n, vNume[nv]); vOff[nv] := cuv; vLung[nv] := lung; vDat[nv] := FALSE; cuv := cuv + lung; INC(nv)
    END;
    RETURN nv - 1
  END NouaVar;

  PROCEDURE Adresa(i, d: INTEGER);   (* Rd := adresa variabilei i *)
  BEGIN E(oBAZA, d, 0); Nr(6, Date + 12 * vOff[i]); E(oADD, d, 6)
  END Adresa;

  PROCEDURE Element(i, d: INTEGER);   (* Rd tine indicele; Rd := adresa elementului *)
  BEGIN
    IF d >= 5 THEN Rau("expresie prea adâncă")
    ELSE Nr(6, 12); E(oMUL, d, 6); E(oBAZA, d + 1, 0); E(oADD, d, d + 1); Nr(6, Date + 12 * vOff[i]); E(oADD, d, 6)
    END
  END Element;

  PROCEDURE Rezervat(n: ARRAY OF CHAR): BOOLEAN;
  BEGIN
    RETURN (n = "IF") OR (n = "THEN") OR (n = "ELSIF") OR (n = "ELSE") OR (n = "END") OR (n = "WHILE") OR (n = "DO")
      OR (n = "REPEAT") OR (n = "UNTIL") OR (n = "VAR") OR (n = "DIV") OR (n = "MOD") OR (n = "OR")
  END Rezervat;

  PROCEDURE ArgAdresa(d: INTEGER);   (* ( "sir" ) sau ( tablou[i] ): Rd := adresa numelui *)
    VAR k, i: INTEGER; n: ARRAY 24 OF CHAR;
  BEGIN
    Astept(sPd, "(");
    IF sym = sSir THEN
      IF ns + Strings.Length(sir) + 1 > MS THEN Rau("prea multe șiruri")
      ELSE
        E(oBAZA, d, 0); Nr(6, Siruri + 12 * ns); E(oADD, d, 6);
        FOR k := 0 TO Strings.Length(sir) - 1 DO sCuv[ns] := ORD(sir[k]); INC(ns) END;
        sCuv[ns] := 0; INC(ns)
      END;
      Urm
    ELSIF sym = sId THEN
      Strings.Copy(id, n); Urm; i := Gaseste(n);
      IF (i < 0) OR (vLung[i] < 2) THEN Rau2("aștept un șir sau un tablou, nu ", n)
      ELSE Astept(sCd, "["); expr(d); Astept(sCi, "]"); Element(i, d)
      END
    ELSE Rau("aștept un șir între ghilimele")
    END;
    Astept(sPi, ")")
  END ArgAdresa;

  PROCEDURE Sys(n, d: INTEGER);   (* chemarea sistemului n cu Rd (intra si iese in Rd): ASCULTA Rd, -(100+n) *)
  BEGIN
    IF d > 4 THEN Rau("expresie prea adâncă") ELSE Nr(6, 100 + n); Nr(d + 1, 0); E(oSUB, d + 1, 6); E(oASC, d, d + 1) END
  END Sys;

  PROCEDURE Unul(d: INTEGER);   (* ( expr ) intr-un registru *)
  BEGIN Astept(sPd, "("); expr(d); Astept(sPi, ")")
  END Unul;

  PROCEDURE App(c: INTEGER);   (* 7·B v7: chemarea aplicatiei c (argumentele deja in R0..R4) *)
  BEGIN Nr(6, 3000 + c); Nr(5, 0); E(oSUB, 5, 6); E(oASC, 5, 5)
  END App;

  PROCEDURE AppF(d, c: INTEGER);   (* functia c a aplicatiei, rezultatul in Rd; argumentul (daca are) e in Rd: codul spune unde *)
  BEGIN
    IF d > 4 THEN Rau("expresie prea adâncă") ELSE Nr(6, 3000 + c + 100 * d); Nr(d + 1, 0); E(oSUB, d + 1, 6); E(oASC, d, d + 1) END
  END AppF;

  PROCEDURE Args(n: INTEGER);   (* ( e0, e1, ... ) -> R0, R1, ... *)
    VAR i: INTEGER;
  BEGIN
    Astept(sPd, "(");
    FOR i := 0 TO n - 1 DO IF i > 0 THEN Astept(sVirg, ",") END; expr(i) END;
    Astept(sPi, ")")
  END Args;

  PROCEDURE Factor(d: INTEGER);
    VAR n: ARRAY 24 OF CHAR; i: INTEGER;
  BEGIN
    IF d > 5 THEN Rau("expresie prea adâncă")
    ELSIF sym = sNr THEN Nr(d, val); Urm
    ELSIF sym = sPd THEN Urm; expr(d); Astept(sPi, ")")
    ELSIF sym = sNu THEN Urm; Factor(d); Nu(d)
    ELSIF sym = sId THEN
      Strings.Copy(id, n); Urm;
      IF n = "CAMP" THEN E(oCAMP, d, 0)
      ELSIF n = "DELA" THEN E(oSIST, d, kDELA)
      ELSIF n = "VECIN" THEN E(oVECIN, d, 0)
      ELSIF n = "BAZA" THEN E(oBAZA, d, 0)
      ELSIF n = "TURA" THEN E(oSIST, d, kTURA)
      ELSIF n = "TIMP" THEN E(oSIST, d, kTIMP)
      ELSIF n = "PRIMESTE" THEN E(oPRIM, d, 6)
      ELSIF n = "CITESTE" THEN Unul(d); E(oLD, d, d)
      ELSIF n = "OPAL" THEN Unul(d); E(oOPAL, d, d)
      ELSIF n = "CEAS" THEN Unul(d); E(oSIST, d, kCEAS)
      ELSIF n = "NOTAC" THEN Unul(d); E(oNOTAC, d, d)
      ELSIF n = "NEF" THEN Unul(d); E(oNEF, d, d)
      ELSIF n = "ASCULTA" THEN Unul(d); E(oASC, d, d)
      ELSIF n = "AMINTESTE" THEN   (* AMINTESTE: ASCULTA cu treapta -(t+1) *)
        Unul(d); Nr(6, 1); E(oADD, d, 6); Nr(6, 0); E(oSUB, 6, d); E(oMOV, d, 6); E(oASC, d, d)
      ELSIF n = "EMITE" THEN
        IF d > 4 THEN Rau("expresie prea adâncă")
        ELSE Astept(sPd, "("); expr(d); Astept(sVirg, ","); expr(d + 1); Astept(sPi, ")"); E(oEMITE, d, d + 1)
        END
      ELSIF n = "STARE" THEN Unul(d); E(oSIST, d, kSTARE)
      ELSIF n = "PID" THEN Unul(d); E(oSIST, d, kPID)
      ELSIF n = "PORNESTE" THEN ArgAdresa(d); E(oPORN, d, d)
      ELSIF n = "ATOM" THEN ArgAdresa(d); Sys(4, d)
      ELSIF n = "ATINSX" THEN AppF(d, 20) ELSIF n = "ATINSY" THEN AppF(d, 21) ELSIF n = "APASAT" THEN AppF(d, 22)   (* 7·B v7 *)
      ELSIF n = "LATIME" THEN AppF(d, 23) ELSIF n = "INALTIME" THEN AppF(d, 24)
      ELSIF n = "ORA" THEN AppF(d, 25) ELSIF n = "MINUT" THEN AppF(d, 26) ELSIF n = "SECUNDA" THEN AppF(d, 27)
      ELSIF n = "ALEATOR" THEN Unul(d); AppF(d, 28)
      ELSIF Rezervat(n) THEN Rau2("nu aștept aici ", n)
      ELSE
        i := Gaseste(n);
        IF i < 0 THEN
          IF sym = sPd THEN Rau2("nu știu funcția ", n) ELSE Rau2(n, " e folosit înainte să primească o valoare") END
        ELSIF ~vDat[i] THEN Rau2(n, " e folosit înainte să primească o valoare")
        ELSIF vLung[i] > 1 THEN Astept(sCd, "["); expr(d); Astept(sCi, "]"); Element(i, d); E(oLDW, d, d)
        ELSE Adresa(i, d); E(oLDW, d, d)
        END
      END
    ELSE Rau("aștept un număr, un nume sau (")
    END
  END Factor;

  PROCEDURE Termen(d: INTEGER);
    VAR op: INTEGER;
  BEGIN
    Factor(d);
    WHILE ~eroare & ((sym = sOri) OR (sym = sSi) OR Cuv("DIV") OR Cuv("MOD")) DO
      IF sym = sOri THEN op := 1 ELSIF sym = sSi THEN op := 2 ELSIF Cuv("DIV") THEN op := 3 ELSE op := 4 END;
      Urm;
      IF d >= 5 THEN Rau("expresie prea adâncă") ELSE Factor(d + 1) END;
      IF op = 1 THEN E(oMUL, d, d + 1)
      ELSIF op = 2 THEN Bool(d); Bool(d + 1); E(oMUL, d, d + 1)
      ELSIF op = 3 THEN E(oDIV, d, d + 1)
      ELSE E(oMOD, d, d + 1)
      END
    END
  END Termen;

  PROCEDURE Simplu(d: INTEGER);
    VAR op: INTEGER; minus: BOOLEAN;
  BEGIN
    minus := sym = sMinus; IF minus OR (sym = sPlus) THEN Urm END;
    Termen(d);
    IF minus THEN Nr(6, 0); E(oSUB, 6, d); E(oMOV, d, 6) END;
    WHILE ~eroare & ((sym = sPlus) OR (sym = sMinus) OR Cuv("OR")) DO
      IF sym = sPlus THEN op := 1 ELSIF sym = sMinus THEN op := 2 ELSE op := 3 END;
      Urm;
      IF d >= 5 THEN Rau("expresie prea adâncă") ELSE Termen(d + 1) END;
      IF op = 1 THEN E(oADD, d, d + 1) ELSIF op = 2 THEN E(oSUB, d, d + 1) ELSE E(oADD, d, d + 1); Bool(d) END
    END
  END Simplu;

  PROCEDURE Expr(d: INTEGER);
    VAR op: INTEGER;
  BEGIN
    Simplu(d);
    IF ~eroare & (sym >= sEg) & (sym <= sMareEg) THEN
      op := sym; Urm;
      IF d >= 5 THEN Rau("expresie prea adâncă") ELSE Simplu(d + 1) END;
      IF op = sEg THEN E(oEQ, d, d + 1)
      ELSIF op = sDif THEN E(oEQ, d, d + 1); Nu(d)
      ELSIF op = sMic THEN E(oLT, d, d + 1)
      ELSIF op = sMare THEN E(oLT, d + 1, d); E(oMOV, d, d + 1)
      ELSIF op = sMicEg THEN E(oLT, d + 1, d); E(oMOV, d, d + 1); Nu(d)
      ELSE E(oLT, d, d + 1); Nu(d)
      END
    END
  END Expr;

  (* ---------- instructiunile ---------- *)

  PROCEDURE Doi(op: INTEGER);   (* ( e1, e2 ) -> op R0, R1 *)
  BEGIN Astept(sPd, "("); expr(0); Astept(sVirg, ","); expr(1); Astept(sPi, ")"); E(op, 0, 1)
  END Doi;

  PROCEDURE Instr;
    VAR n: ARRAY 24 OF CHAR; i, k, l1, l2, l3, lung: INTEGER;
  BEGIN
    IF sym # sId THEN Rau("aștept o instrucțiune"); Urm
    ELSE
      Strings.Copy(id, n); Urm;
      IF n = "IF" THEN
        expr(0); AsteptCuv("THEN"); l1 := NouaEt(); l3 := NouaEt(); Salt(oJZ, 0, l1); secv;
        WHILE ~eroare & Cuv("ELSIF") DO
          Salt(oJMP, 0, l3); Aici(l1); l1 := NouaEt(); Urm; expr(0); AsteptCuv("THEN"); Salt(oJZ, 0, l1); secv
        END;
        IF Cuv("ELSE") THEN Salt(oJMP, 0, l3); Aici(l1); Urm; secv ELSE Aici(l1) END;
        AsteptCuv("END"); Aici(l3)
      ELSIF n = "WHILE" THEN
        l1 := NouaEt(); l2 := NouaEt(); Aici(l1); expr(0); AsteptCuv("DO"); Salt(oJZ, 0, l2); secv; Salt(oJMP, 0, l1);
        AsteptCuv("END"); Aici(l2)
      ELSIF n = "REPEAT" THEN
        l1 := NouaEt(); Aici(l1); secv; AsteptCuv("UNTIL"); expr(0); Salt(oJZ, 0, l1)
      ELSIF n = "VAR" THEN
        REPEAT
          IF sym = sVirg THEN Urm END;
          IF sym # sId THEN Rau("aștept un nume după VAR")
          ELSE
            Strings.Copy(id, n); Urm; lung := 1;
            IF sym = sCd THEN Urm; IF sym = sNr THEN lung := val; Urm ELSE Rau("aștept mărimea tabloului") END; Astept(sCi, "]") END;
            IF lung < 1 THEN lung := 1 END;
            IF Gaseste(n) >= 0 THEN Rau2("e deja declarat: ", n) ELSE i := NouaVar(n, lung); IF i >= 0 THEN vDat[i] := TRUE END END
          END
        UNTIL eroare OR (sym # sVirg)
      ELSIF n = "SCRIE" THEN Unul(0); E(oSCRIE, 0, 0)
      ELSIF n = "SCRIEC" THEN Unul(0); E(oSCRIEC, 0, 0)
      ELSIF n = "SCRIEN" THEN Unul(0); E(oSCRIEN, 0, 0)
      ELSIF n = "SCRIEA" THEN Unul(0); Sys(3, 0)
      ELSIF n = "SCRIET" THEN
        Astept(sPd, "(");
        IF sym = sSir THEN FOR k := 0 TO Strings.Length(sir) - 1 DO Nr(0, ORD(sir[k])); E(oSCRIEC, 0, 0) END; Urm
        ELSE Rau("SCRIET vrea un text între ghilimele")
        END;
        Astept(sPi, ")"); Nr(0, 10); E(oSCRIEC, 0, 0)
      ELSIF n = "NOTA" THEN Doi(oNOTA)
      ELSIF n = "TRIMITE" THEN Doi(oTRIM)
      ELSIF n = "PUNE" THEN Astept(sPd, "("); expr(0); Astept(sVirg, ","); expr(1); Astept(sPi, ")"); E(oST, 1, 0)
      ELSIF n = "DORMI" THEN Unul(0); E(oDORMI, 0, 0)
      ELSIF n = "CANTA" THEN Unul(0); E(oCANTA, 0, 0)
      ELSIF n = "COLT" THEN Unul(0); E(oCOLT, 0, 0)
      ELSIF n = "EMITE" THEN Astept(sPd, "("); expr(0); Astept(sVirg, ","); expr(1); Astept(sPi, ")"); E(oEMITE, 0, 1)
      ELSIF n = "PUNENEF" THEN Astept(sPd, "("); expr(0); Astept(sVirg, ","); expr(1); Astept(sPi, ")"); E(oPNEF, 0, 1)
      ELSIF n = "OPRESTE" THEN Unul(0); E(oOPR, 0, 0)
      ELSIF n = "PORNESTE" THEN ArgAdresa(0); E(oPORN, 0, 0)
      ELSIF n = "ASTEAPTA" THEN E(oAST, 0, 0)
      ELSIF n = "CEDEAZA" THEN E(oCED, 0, 0)
      ELSIF n = "STOP" THEN E(oSTOP, 0, 0)
      ELSIF n = "CULOARE" THEN Args(3); App(1)   (* 7·B v7: desenul *)
      ELSIF n = "DREPT" THEN Args(4); App(2)
      ELSIF n = "CERC" THEN Args(3); App(3)
      ELSIF n = "LINIE" THEN Args(4); App(4)
      ELSIF n = "TEXTN" THEN Args(3); App(5)
      ELSIF n = "TEXT" THEN
        Astept(sPd, "("); expr(0); Astept(sVirg, ","); expr(1); Astept(sVirg, ","); App(6);
        IF sym = sSir THEN FOR k := 0 TO Strings.Length(sir) - 1 DO Nr(0, ORD(sir[k])); App(7) END; Urm
        ELSE Rau("TEXT vrea un text între ghilimele")
        END;
        Astept(sPi, ")")
      ELSIF n = "ARATA" THEN App(8)
      ELSIF n = "STERGE" THEN App(9)
      ELSIF n = "MARIME" THEN Args(1); App(10)
      ELSIF Rezervat(n) THEN Rau2("nu aștept aici ", n)
      ELSE   (* atribuire *)
        i := Gaseste(n);
        IF (i < 0) & (sym = sPd) THEN Rau2("nu știu procedura ", n)
        ELSIF (i >= 0) & (vLung[i] > 1) THEN
          Astept(sCd, "["); expr(0); Astept(sCi, "]"); Element(i, 0);
          Astept(sAtrib, ":="); expr(1); E(oSTW, 1, 0)
        ELSE
          IF i < 0 THEN i := NouaVar(n, 1) END;
          Astept(sAtrib, ":="); expr(0);
          IF i >= 0 THEN vDat[i] := TRUE; Adresa(i, 1); E(oSTW, 0, 1) END
        END
      END
    END
  END Instr;

  PROCEDURE Prolog(m: ARRAY OF CHAR);   (* o greseala in clauza: mesajul vine cu randul lui *)
  BEGIN IF ~eroare THEN eroare := TRUE; Strings.Copy(m, mesaj) END
  END Prolog;

  PROCEDURE EClauza(): BOOLEAN;   (* numele de acum incepe o clauza Prolog? (litera mica, apoi ( sau . sau :-) *)
    VAR k: INTEGER;
  BEGIN
    k := poz; WHILE (src[k] = " ") OR (src[k] = 9X) DO INC(k) END;
    RETURN (sym = sId) & (id[0] >= "a") & (id[0] <= "z") & ((src[k] = "(") OR (src[k] = ".") OR (src[k] = ":") & (src[k + 1] = "-"))
  END EClauza;

  PROCEDURE Secventa;
    VAR k, p0, j, i, l1, l2: INTEGER; err: ARRAY 160 OF CHAR; nm: ARRAY 24 OF CHAR; doo: BOOLEAN;
  BEGIN
    WHILE ~eroare & (sym # sGata) & ~Cuv("END") & ~Cuv("ELSIF") & ~Cuv("ELSE") & ~Cuv("UNTIL") DO
      IF sym = sIntreb THEN   (* ?- scopuri.  -> raspunsurile, cand ajunge programul aici *)
        p0 := poz; k := Z7P.Clauza(src, p0, rand, TRUE, err);
        IF k < 0 THEN Prolog(err)
        ELSE
          doo := Z7P.cuDO;
          FOR j := 0 TO Z7P.NrVar() - 1 DO   (* legaturile cu variabilele Z7 *)
            Z7P.NumeVar(j, nm);
            IF nm[0] # "_" THEN
              i := Gaseste(nm);
              IF (i >= 0) & vDat[i] & (vLung[i] = 1) THEN Z7P.LeagaVar(k, j, -(Date + 12 * vOff[i]) - 1)   (* intra *)
              ELSIF doo & (i < 0) THEN i := NouaVar(nm, 1); IF i >= 0 THEN vDat[i] := TRUE; Z7P.LeagaVar(k, j, Date + 12 * vOff[i] + 1) END
              END
            END
          END;
          poz := p0; Urm;
          IF ~doo THEN Nr(0, k); Sys(0, 0)
          ELSE   (* bucla: corpul pentru fiecare raspuns *)
            Nr(0, k); Sys(1, 0); l1 := NouaEt(); l2 := NouaEt(); Aici(l1);
            Nr(0, k); Sys(2, 0); Salt(oJZ, 0, l2); secv; Salt(oJMP, 0, l1); AsteptCuv("END"); Aici(l2)
          END
        END
      ELSIF EClauza() THEN   (* o clauza: nu se executa, sta in tor *)
        p0 := tpoz; k := Z7P.Clauza(src, p0, rand, FALSE, err);
        IF k < 0 THEN Prolog(err) ELSE poz := p0; Urm END
      ELSE Instr
      END;
      WHILE sym = sPv DO Urm END
    END
  END Secventa;

  PROCEDURE Compileaza*(VAR t: ARRAY OF CHAR; baza: INTEGER; VAR n: INTEGER; VAR err: ARRAY OF CHAR): BOOLEAN;
    VAR i, k, v, j: INTEGER; d: ARRAY 5 OF INTEGER;
  BEGIN
    i := 0; WHILE (i < LEN(t)) & (i < LEN(src) - 2) & (t[i] # 0X) DO src[i] := t[i]; INC(i) END;
    src[i] := 0X; src[i + 1] := 0X;
    poz := 0; rand := 1; pc := 0; nl := 0; nf := 0; nv := 0; cuv := 0; ns := 0; eroare := FALSE; mesaj := ""; Z7P.Gol;
    Urm; Secventa;
    IF ~eroare & (sym # sGata) THEN Rau2("nu aștept aici ", id) END;
    E(oSTOP, 0, 0);
    IF ~eroare THEN
      FOR i := 0 TO nf - 1 DO   (* adresele salturilor *)
        v := lab[fixLab[i]];
        IF v < 0 THEN Rau("salt fără țintă") ELSE FOR k := 0 TO 4 DO d[k] := v MOD 7; v := v DIV 7 END;
          FOR k := 0 TO 4 DO cb[fixPc[i] + k] := d[4 - k] END
        END
      END
    END;
    IF ~eroare & (pc * 4 > Date) THEN Rau("codul nu încape în tură") END;
    IF ~eroare & Z7P.Are() & (pc * 4 + 12 * Z7P.Lungime() > Date) THEN Rau("clauzele Prolog nu încap în tură") END;
    IF eroare THEN Strings.Copy(mesaj, err); n := -1
    ELSE
      FOR i := 0 TO pc - 1 DO
        k := baza + i * 4;
        Tor7.Scrie(k, cop[i] DIV 7); Tor7.Scrie(k + 1, cop[i] MOD 7); Tor7.Scrie(k + 2, ca[i]); Tor7.Scrie(k + 3, cb[i])
      END;
      FOR j := 0 TO cuv - 1 DO Tor7.PuneCuvant(baza + Date + 12 * j, 0) END;   (* variabilele pornesc de la 0 *)
      FOR j := 0 TO ns - 1 DO Tor7.PuneCuvant(baza + Siruri + 12 * j, sCuv[j]) END;
      IF Z7P.Are() THEN Z7P.ScrieZona(baza + pc * 4); Tor7.PuneCuvant(baza + Z7P.Pointer, baza + pc * 4)
      ELSE Tor7.PuneCuvant(baza + Z7P.Pointer, 0)
      END;
      n := pc; err := ""
    END;
    RETURN ~eroare
  END Compileaza;

BEGIN
  expr := Expr; secv := Secventa
END Z7L.


MODULE Salamandra;  (* nucleul lui Cubicum OS: Oul care nu se misca. Tine 7 procese reale, cate unul pe fiecare tura a spiralei
     din Tor7 (slotul s are celulele s*7^6 .. (s+1)*7^6 - 1), le asambleaza codul din Cubicum FS direct in tor si le ruleaza
     pe rand. Burn goleste torul si procesele; raman doar Ash si Cubicum FS.
     O instructiune = 4 celule: op DIV 7, op MOD 7, a, b (toate cifre 0..6). Registrele R0..R6 tin numere intregi.
     Programele (.z7) sunt text: o instructiune pe rand sau despartite cu ; , comentariu cu #, eticheta cu nume:
       SET Ra, n    MOV ADD SUB MUL MOD LT EQ Ra, Rb    INC DEC Ra    LD Ra, Rb (Ra := celula Rb)   ST Ra, Rb (celula Rb := Ra)
       JMP x   JZ JNZ Ra, x  (x = eticheta sau registru; cu eticheta se foloseste R6)
       CAMP Ra (campul)   ASTEAPTA (doarme pana se schimba ceva oriunde in tor)   BAZA Ra (inceputul turei tale)
       TRIMITE Ra, Rb (Ra catre slotul Rb)   PRIMESTE Ra, Rb (valoarea, de la cine)   VECIN Ra (urmatorul proces cu acelasi program, in inel)
       NOTA Ra, Rb (nota Ra din Z7, octava Rb)   SCRIE Ra (in shell)   DORMI Ra (ms)   CEDEAZA   STOP   NOP
       v1.4: OPAL Ra, Rb (ultima citire a acului Rb: 1 3 5 7 11)   CEAS Ra, Rb (0 ciclul, 1 bataia in ora, 2 batai)
       NOTAC Ra, Rb (treapta celulei Rb)   CANTA Ra (canta celula Ra)   NEF Ra, Rb (starea Nephilim a celulei Rb)
       PUNENEF Ra, Rb (starea celulei Rb := starea XOR Ra)
       v1.5 Roler: COLT Ra (coltul lui Roler = coltul Do)   EMITE Ra, Rb (treapta Ra, starea Rb XOR; Ra := cate celule)
       ASCULTA Ra, Rb (Ra := cate celule active rezoneaza cu treapta Rb)
       v1.9: ASCULTA Ra, Rb cu Rb = -(t+1): Ra := adresa primei celule active cu treapta t (-1 = niciuna) = AMINTESTE;
       CEAS 3 = Burn-uri, 4 = prima pornire
     v2.5 (Tor7 unit): codul instructiunii = 2 cifre in baza 7, prima cifra = grupa (7 grupe x 7):
       0 Date      gol SET DIG MOV LD ST NOTAC        (codul 0 = celula goala: nu se executa, e eroare)
       1 Aritm.    ADD SUB MUL DIV MOD INC DEC
       2 Salturi   LT EQ JMP JZ JNZ CALL RET           (CALL x ca JMP x, adresa de intoarcere pe stiva procesului)
       3 Spatiu    LDW STW STEP COORD CAMP ASTEAPTA BAZA
                   STEP Ra, Rb: adresa Ra face un pas pe dimensiunea Rb (0..6), cu infasurare doar pe cifra ei;
                   Rb = -(d+1): un pas inapoi.   COORD Ra, Rb: Ra := cifra Rb a adresei Ra
       4 Nephilim  NEF PUNENEF COLT EMITE ASCULTA CANTA NOTA
       5 Timp      OPAL SIST ASH DORMI SCRIE SCRIEC SCRIEN
                   SIST Ra, k: 0 TURA, 1 PID (al turei Ra), 2 DELA, 3 TIMP, 4 STARE (a turei Ra), 5 CEAS (k = Ra), 6 nimic
                   (in asamblare se scriu ca inainte: TURA Ra, PID Ra, Rb, ..., NOP)   ASH Ra: cate erori ai facut
       6 Procese   TRIMITE PRIMESTE VECIN PORN OPR STOP CEDEAZA
     Salamandra in procesor: o eroare la rulare intra in Ash, tura procesului arde (Tor7.ArdeTura) si procesul
       reporneste din Ou (programul luat iar din Cubicum FS); dupa 7 reporniri, la a 8-a eroare se opreste. *)
  IMPORT Strings, Files, Sunet, Tor7, Z7L, Z7P, CFS := CubicumFS;

  CONST NP* = 7; NQ = 96; NI = 40; NS = 260; NE = 40; NO = 49; NK* = 16; SemnS = 7345; SemnS18 = 7344; SemnS25 = 7346;
    NR = 49; MaxCad* = 7;   (* v2.5: adancimea stivei CALL; de cate ori reporneste un proces dupa erori *)
    oSIST = 36; oMOV = 3;
    Liber* = 0; Activ* = 1; Simte* = 2; Primeste* = 3; Doarme* = 4;
    Felie = 64;   (* cate instructiuni ruleaza un proces pana ii vine randul urmatorului *)

  TYPE Proc = RECORD
      nume: ARRAY 24 OF CHAR;
      pid, stare, pc, lung, vazut, trezire, ultimNota, pasi, pasiSec, cpu: INTEGER;
      r: ARRAY 7 OF INTEGER;
      qv, qs: ARRAY NQ OF INTEGER; nq: INTEGER;
      dela: INTEGER; linie: ARRAY 72 OF CHAR;   (* de la cine a venit ultimul mesaj; randul scris litera cu litera *)
      rs: ARRAY NR OF INTEGER; nrs, caderi: INTEGER; fisier: ARRAY 32 OF CHAR;   (* v2.5: stiva CALL, erori, programul *)
      drept: INTEGER   (* 7·B v13: drepturile programului; -1 = de aflat *)
    END;
    ExpertP* = PROCEDURE (t, cod: INTEGER): INTEGER;   (* Cubicum 7: ASCULTA(-(1000 + cod)) din program, raspunde Cub7Eule *)
    DreptP* = PROCEDURE (prog: ARRAY OF CHAR): INTEGER;   (* 7·B v13: Cub7Drepturi *)

  VAR p: ARRAY NP OF Proc; urmPid, sesiune, rr, secDe, totalSec, trimise: INTEGER;
    ies: ARRAY NI OF ARRAY 220 OF CHAR; nies: INTEGER;
    pkF, pkT: ARRAY NK OF INTEGER;
    mn: ARRAY NO OF ARRAY 10 OF CHAR; fel: ARRAY NO OF INTEGER;
    z7: ARRAY 7 OF REAL;
    (* asamblorul *)
    sOp, sA, sB, sImm, sMar, sAdr, sPre: ARRAY NS OF INTEGER; sLab: ARRAY NS OF ARRAY 16 OF CHAR; ns: INTEGER;
    eNume: ARRAY NE OF ARRAY 16 OF CHAR; eSt: ARRAY NE OF INTEGER; ne: INTEGER;
    porneste: PROCEDURE (nume: ARRAY OF CHAR): INTEGER;   (* Porneste, chemat si din instructiunea PORN *)
    expert: ExpertP; areExpert: BOOLEAN;
    loc: ExpertP; areLoc: BOOLEAN;
    drepturi: DreptP; areDrept: BOOLEAN;   (* 7·B v13 *)   (* 7·B v9: cine elibereaza o tura cand toate sunt ocupate *)
    app: ExpertP; areApp: BOOLEAN;   (* 7·B v7: ASCULTA(-(3000 + cod)) = desenul aplicatiei; argumentele in R0..R4 *)
    dosar: ARRAY 160 OF CHAR; motiv: ARRAY 240 OF CHAR;

  (* ---------- iesirile pentru shell ---------- *)

  PROCEDURE Spune(s: ARRAY OF CHAR);
    VAR i: INTEGER;
  BEGIN
    IF nies = NI THEN FOR i := 0 TO NI - 2 DO ies[i] := ies[i + 1] END; DEC(nies) END;
    Strings.Copy(s, ies[nies]); INC(nies)
  END Spune;

  PROCEDURE NrIesiri*(): INTEGER;
  BEGIN RETURN nies
  END NrIesiri;

  PROCEDURE Iesire*(k: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF (k >= 0) & (k < nies) THEN Strings.Copy(ies[k], s) ELSE s := "" END
  END Iesire;

  PROCEDURE Goleste*;
  BEGIN nies := 0
  END Goleste;

  (* ---------- asamblorul ---------- *)

  PROCEDURE Registru(w: ARRAY OF CHAR): INTEGER;   (* R0..R6 -> 0..6, altfel -1 *)
    VAR r: INTEGER;
  BEGIN
    r := -1;
    IF ((w[0] = "R") OR (w[0] = "r")) & (w[1] >= "0") & (w[1] <= "6") & (w[2] = 0X) THEN r := ORD(w[1]) - ORD("0") END;
    RETURN r
  END Registru;

  PROCEDURE Numar(w: ARRAY OF CHAR): INTEGER;   (* numar zecimal >= 0, altfel -1 *)
    VAR i, n: INTEGER;
  BEGIN
    n := 0; i := 0;
    IF w[0] = 0X THEN n := -1 END;
    WHILE (n >= 0) & (i < LEN(w)) & (w[i] # 0X) DO
      IF (w[i] >= "0") & (w[i] <= "9") & (n < 100000000) THEN n := n * 10 + ORD(w[i]) - ORD("0") ELSE n := -1 END;
      INC(i)
    END;
    RETURN n
  END Numar;

  PROCEDURE Cifre(n: INTEGER): INTEGER;   (* cate cifre in baza 7 *)
    VAR c: INTEGER;
  BEGIN c := 1; WHILE n >= 7 DO n := n DIV 7; INC(c) END; RETURN c
  END Cifre;

  PROCEDURE Pune(baza, k, op, a, b: INTEGER);
  BEGIN
    k := baza + k * 4;
    Tor7.Scrie(k, op DIV 7); Tor7.Scrie(k + 1, op MOD 7); Tor7.Scrie(k + 2, a); Tor7.Scrie(k + 3, b)
  END Pune;

  PROCEDURE PuneNr(baza: INTEGER; VAR k: INTEGER; r, n, c: INTEGER);   (* Ra := n, in c instructiuni: SET + DIG-uri *)
    VAR d: ARRAY 12 OF INTEGER; j: INTEGER;
  BEGIN
    FOR j := 0 TO c - 1 DO d[j] := n MOD 7; n := n DIV 7 END;
    Pune(baza, k, 1, r, d[c - 1]); INC(k);
    FOR j := c - 2 TO 0 BY -1 DO Pune(baza, k, 2, r, d[j]); INC(k) END
  END PuneNr;

  PROCEDURE Greseala(nume: ARRAY OF CHAR; st: INTEGER; ce, cu: ARRAY OF CHAR);
    VAR m: ARRAY 96 OF CHAR;
  BEGIN
    Strings.Copy(nume, m); Strings.Append(" instr. ", m); Strings.AppendInt(st + 1, 0, m); Strings.Append(": ", m);
    Strings.Append(ce, m); Strings.Append(" ", m); Strings.Append(cu, m);
    CFS.Cenusa(m);
    Spune(m)
  END Greseala;

  PROCEDURE Instr(nume: ARRAY OF CHAR; VAR tk: ARRAY OF ARRAY OF CHAR; nt: INTEGER): BOOLEAN;   (* o instructiune in sOp.. *)
    VAR op, f, a, b, k: INTEGER; ok: BOOLEAN; w: ARRAY 24 OF CHAR;
  BEGIN
    ok := TRUE; Strings.Copy(tk[0], w); Strings.Cap(w);
    op := -1; k := 0;
    WHILE (op < 0) & (k < NO) DO IF (k > 0) & (mn[k] = w) THEN op := k END; INC(k) END;
    sPre[ns] := -1;
    f := -1;   (* v2.5: TURA PID DELA TIMP STARE CEAS NOP se scriu ca inainte, dar trec prin SIST *)
    IF w = "NOP" THEN f := 6 ELSIF w = "TURA" THEN f := 0 ELSIF w = "DELA" THEN f := 2 ELSIF w = "TIMP" THEN f := 3
    ELSIF w = "PID" THEN f := 11 ELSIF w = "STARE" THEN f := 14 ELSIF w = "CEAS" THEN f := 15
    END;
    IF f >= 0 THEN
      sLab[ns] := ""; sImm[ns] := -1; sMar[ns] := 1; a := 0; b := f MOD 10;
      IF (f = 6) & (nt # 1) OR (f < 6) & (nt # 2) OR (f > 10) & (nt # 3) THEN
        Greseala(nume, ns, "număr greșit de operanzi la", tk[0]); ok := FALSE
      ELSIF f # 6 THEN
        a := Registru(tk[1]);
        IF a < 0 THEN Greseala(nume, ns, "aștept un registru R0..R6, nu", tk[1]); ok := FALSE
        ELSIF f > 10 THEN
          k := Registru(tk[2]);
          IF k < 0 THEN Greseala(nume, ns, "aștept un registru R0..R6, nu", tk[2]); ok := FALSE
          ELSIF k # a THEN sPre[ns] := k; sMar[ns] := 2   (* MOV Ra, Rb, apoi SIST Ra, k *)
          END
        END
      END;
      IF ok THEN sOp[ns] := oSIST; sA[ns] := a; sB[ns] := b; INC(ns) END
    ELSIF op < 0 THEN Greseala(nume, ns, "instrucțiune necunoscută", tk[0]); ok := FALSE
    ELSE
      f := fel[op]; a := 0; b := 0; sLab[ns] := ""; sImm[ns] := -1; sMar[ns] := 1;
      IF (f = 0) & (nt # 1) OR (f = 1) & (nt # 2) OR (f = 5) & (nt # 2) OR (f IN {2, 3, 4, 6}) & (nt # 3) THEN
        Greseala(nume, ns, "număr greșit de operanzi la", tk[0]); ok := FALSE
      ELSIF f = 0 THEN
      ELSIF f = 5 THEN   (* JMP x *)
        a := Registru(tk[1]);
        IF a < 0 THEN Strings.Copy(tk[1], sLab[ns]); a := 6; sMar[ns] := 6 END
      ELSE
        a := Registru(tk[1]);
        IF a < 0 THEN Greseala(nume, ns, "aștept un registru R0..R6, nu", tk[1]); ok := FALSE
        ELSIF f = 2 THEN b := Registru(tk[2]); IF b < 0 THEN Greseala(nume, ns, "aștept un registru R0..R6, nu", tk[2]); ok := FALSE END
        ELSIF f = 3 THEN b := Numar(tk[2]); IF (b < 0) OR (b > 6) THEN Greseala(nume, ns, "DIG vrea o cifră 0..6, nu", tk[2]); ok := FALSE END
        ELSIF f = 4 THEN   (* SET Ra, n sau SET Ra, eticheta *)
          b := Numar(tk[2]);
          IF b >= 0 THEN sImm[ns] := b; sMar[ns] := Cifre(b) ELSE Strings.Copy(tk[2], sLab[ns]); sMar[ns] := 5 END
        ELSIF f = 6 THEN   (* JZ / JNZ Ra, x *)
          b := Registru(tk[2]);
          IF b < 0 THEN Strings.Copy(tk[2], sLab[ns]); b := 6; sMar[ns] := 6 END
        END
      END;
      IF ok THEN sOp[ns] := op; sA[ns] := a; sB[ns] := b; INC(ns) END
    END;
    RETURN ok
  END Instr;

  PROCEDURE Asambleaza(VAR t: ARRAY OF CHAR; nume: ARRAY OF CHAR; baza: INTEGER): INTEGER;   (* nr. de instructiuni, -1 = greseala *)
    VAR i, j, k, nt, n, adr, e: INTEGER; ok, com: BOOLEAN; st: ARRAY 160 OF CHAR; tk: ARRAY 5 OF ARRAY 24 OF CHAR;
      w: ARRAY 24 OF CHAR; ch: CHAR;
  BEGIN
    ns := 0; ne := 0; ok := TRUE; i := 0;
    (* 1. bucata cu bucata: etichete si instructiuni *)
    WHILE ok & (i < LEN(t)) & (t[i] # 0X) DO
      j := 0; com := FALSE;
      WHILE (i < LEN(t)) & (t[i] # 0X) & (t[i] # ";") & (t[i] # 0AX) & (t[i] # 0DX) DO
        IF t[i] = "#" THEN com := TRUE END;
        IF ~com & (j < LEN(st) - 1) THEN st[j] := t[i]; INC(j) END;
        INC(i)
      END;
      st[j] := 0X;
      IF (i < LEN(t)) & (t[i] # 0X) THEN INC(i) END;
      nt := 0; j := 0;
      WHILE ok & (st[j] # 0X) DO
        ch := st[j];
        IF (ch = " ") OR (ch = ",") OR (ch = 9X) OR (ch = ":") THEN INC(j)
        ELSE
          k := 0;
          WHILE (st[j] # 0X) & (st[j] # " ") & (st[j] # ",") & (st[j] # 9X) & (st[j] # ":") DO
            IF k < LEN(w) - 1 THEN w[k] := st[j]; INC(k) END; INC(j)
          END;
          w[k] := 0X;
          IF st[j] = ":" THEN
            IF ne < NE THEN Strings.Copy(w, eNume[ne]); eSt[ne] := ns; INC(ne) END
          ELSIF nt < 4 THEN Strings.Copy(w, tk[nt]); INC(nt)
          ELSE Greseala(nume, ns, "prea mulți operanzi după", tk[0]); ok := FALSE
          END
        END
      END;
      IF ok & (nt > 0) THEN
        IF ns >= NS THEN Greseala(nume, ns, "program prea lung", ""); ok := FALSE ELSE ok := Instr(nume, tk, nt) END
      END
    END;
    (* 2. adresele *)
    adr := 0;
    FOR k := 0 TO ns - 1 DO sAdr[k] := adr; adr := adr + sMar[k] END;
    n := adr;
    IF n * 4 > Tor7.Tura THEN Greseala(nume, ns, "nu încape într-o tură a spiralei", ""); ok := FALSE END;
    (* 3. scrierea in tor *)
    k := 0; i := 0;
    WHILE ok & (i < ns) DO
      IF sLab[i] # "" THEN
        e := -1; j := 0;
        WHILE (e < 0) & (j < ne) DO IF eNume[j] = sLab[i] THEN e := j END; INC(j) END;
        IF e < 0 THEN Greseala(nume, i, "nu există eticheta", sLab[i]); ok := FALSE
        ELSE
          IF eSt[e] < ns THEN adr := sAdr[eSt[e]] ELSE adr := n END;
          IF fel[sOp[i]] = 4 THEN PuneNr(baza, k, sA[i], adr, 5)
          ELSE PuneNr(baza, k, 6, adr, 5); Pune(baza, k, sOp[i], sA[i], sB[i]); INC(k)
          END
        END
      ELSIF sImm[i] >= 0 THEN PuneNr(baza, k, sA[i], sImm[i], sMar[i])
      ELSE
        IF sPre[i] >= 0 THEN Pune(baza, k, oMOV, sA[i], sPre[i]); INC(k) END;
        Pune(baza, k, sOp[i], sA[i], sB[i]); INC(k)
      END;
      INC(i)
    END;
    IF ~ok THEN n := -1 END;
    RETURN n
  END Asambleaza;

  (* ---------- procesele ---------- *)

  PROCEDURE Vecin(s: INTEGER): INTEGER;   (* urmatorul proces viu din inel, cu acelasi program; el insusi daca e singur *)
    VAR k, r, t: INTEGER;
  BEGIN
    r := s; k := 1;
    WHILE (r = s) & (k < NP) DO
      t := (s + k) MOD NP;
      IF (p[t].stare # Liber) & (p[t].nume = p[s].nume) THEN r := t END;
      INC(k)
    END;
    RETURN r
  END Vecin;

  PROCEDURE Trimite(s, t, v: INTEGER);
  BEGIN
    pkF[trimise MOD NK] := s; pkT[trimise MOD NK] := t; INC(trimise);
    IF (p[t].stare # Liber) & (p[t].nq < NQ) THEN p[t].qv[p[t].nq] := v; p[t].qs[p[t].nq] := s; INC(p[t].nq) END
  END Trimite;

  PROCEDURE Posta*(t, v: INTEGER);   (* un mesaj din afara (de la interfata) catre tura t *)
  BEGIN IF (t >= 0) & (t < NP) & (p[t].stare # Liber) & (p[t].nq < NQ) THEN p[t].qv[p[t].nq] := v; p[t].qs[p[t].nq] := t; INC(p[t].nq) END
  END Posta;

  PROCEDURE Hz(a, b: INTEGER): INTEGER;
    VAR k, m: INTEGER;
  BEGIN
    m := 1; FOR k := 1 TO b MOD 3 DO m := m * 2 END;
    RETURN FLOOR(z7[a MOD 7] * FLT(m) + 0.5)
  END Hz;

  PROCEDURE Compileaza(s: INTEGER; nume: ARRAY OF CHAR): INTEGER;   (* programul nume (cu extensia) din Cubicum FS,
                                                                          scris pe tura s; nr. de instructiuni, -1 = nu *)
    VAR i, n, k: INTEGER; t: ARRAY CFS.LC OF CHAR; m: ARRAY 72 OF CHAR; err: ARRAY 120 OF CHAR; e: ARRAY 8 OF CHAR;
  BEGIN
    i := CFS.Gaseste(nume);
    IF i < 0 THEN m := "nucleul: nu găsesc "; Strings.Append(nume, m); Spune(m); n := -1
    ELSE
      CFS.Continut(i, t);
      k := Strings.Pos(".", nume, 0); e := "";
      IF k >= 0 THEN Strings.Extract(nume, k, 5, e) END;
      IF e = ".z7l" THEN   (* limbajul Z7: compilat direct in tor *)
        IF ~Z7L.Compileaza(t, s * Tor7.Tura, n, err) THEN
          Strings.Copy(nume, m); Strings.Append(" ", m); Strings.Append(err, m); CFS.Cenusa(m); Spune(m); n := -1
        END
      ELSE n := Asambleaza(t, nume, s * Tor7.Tura)
      END
    END;
    RETURN n
  END Compileaza;

  PROCEDURE Curat(s: INTEGER);   (* procesul s o ia de la capat: pc 0, registrele, stiva, mesajele *)
    VAR k: INTEGER;
  BEGIN
    p[s].pc := 0; p[s].nq := 0; p[s].nrs := 0; p[s].pasi := 0; p[s].pasiSec := 0; p[s].cpu := 0;
    p[s].ultimNota := -1000; p[s].trezire := 0; p[s].vazut := Tor7.Scrieri();
    FOR k := 0 TO 6 DO p[s].r[k] := 0 END;
    p[s].dela := -1; p[s].linie := ""; p[s].drept := -1
  END Curat;

  PROCEDURE Cade(s: INTEGER; ce: ARRAY OF CHAR);   (* eroare la rulare: Ash, tura arde, procesul reporneste din Ou *)
    VAR m: ARRAY 96 OF CHAR; n: INTEGER;
  BEGIN
    Strings.Copy(p[s].nume, m); Strings.Append(": ", m); Strings.Append(ce, m); CFS.Cenusa(m);
    m := "["; Strings.Append(p[s].nume, m); Strings.Append("] căzut: ", m); Strings.Append(ce, m); Spune(m);
    INC(p[s].caderi);
    IF p[s].caderi > MaxCad THEN
      m := "["; Strings.Append(p[s].nume, m); Strings.Append("] a căzut de ", m); Strings.AppendInt(p[s].caderi, 0, m);
      Strings.Append(" ori: Salamandra îl oprește", m); Spune(m);
      p[s].stare := Liber
    ELSE
      Tor7.ArdeTura(s);
      n := Compileaza(s, p[s].fisier);
      IF n < 0 THEN p[s].stare := Liber
      ELSE
        p[s].lung := n; Curat(s); p[s].stare := Activ;
        m := "["; Strings.Append(p[s].nume, m); Strings.Append("] arde tura ", m); Strings.AppendInt(s + 1, 0, m);
        Strings.Append(" · repornește din Ou (", m); Strings.AppendInt(p[s].caderi, 0, m); Strings.Append(")", m); Spune(m)
      END
    END
  END Cade;

  PROCEDURE Fara(s, bit: INTEGER);   (* 7·B v13: programul a cerut ceva pentru care n-are drept: Salamandra il opreste *)
    VAR m: ARRAY 160 OF CHAR; d: ARRAY 12 OF CHAR;
  BEGIN
    IF bit = 1 THEN d := "tor" ELSIF bit = 2 THEN d := "opri" ELSIF bit = 4 THEN d := "porni" ELSIF bit = 8 THEN d := "sunet"
    ELSIF bit = 16 THEN d := "fereastra" ELSE d := "experti" END;
    m := "["; Strings.Append(p[s].nume, m); Strings.Append("] n-are dreptul „", m); Strings.Append(d, m);
    Strings.Append("” · Salamandra îl oprește · drept ", m); Strings.Append(p[s].nume, m); Strings.Append(" +", m); Strings.Append(d, m); Spune(m);
    Strings.Copy(p[s].nume, m); Strings.Append(": fără dreptul ", m); Strings.Append(d, m); CFS.Cenusa(m);
    p[s].stare := Liber
  END Fara;

  PROCEDURE Are(s, bit: INTEGER): BOOLEAN;   (* 7·B v13 *)
  BEGIN
    IF p[s].drept < 0 THEN IF areDrept THEN p[s].drept := drepturi(p[s].nume) ELSE p[s].drept := 63 END END;
    RETURN p[s].drept DIV bit MOD 2 = 1
  END Are;

  PROCEDURE Al(s, adr: INTEGER): BOOLEAN;   (* adresa e in tura lui s? (variabilele lui) *)
    VAR a: INTEGER;
  BEGIN a := adr MOD Tor7.N; RETURN a DIV Tor7.Tura = s
  END Al;

  PROCEDURE Pas(s, acum: INTEGER): BOOLEAN;   (* o instructiune; FALSE = felia procesului s se termina aici *)
    VAR op, a, b, k, va, vb: INTEGER; cont: BOOLEAN; m: ARRAY 220 OF CHAR; nm: ARRAY 200 OF CHAR; d: ARRAY 7 OF INTEGER;
  BEGIN
    cont := TRUE;
    IF (p[s].pc < 0) OR (p[s].pc >= p[s].lung) THEN Cade(s, "a ieșit din program"); cont := FALSE
    ELSE
      k := s * Tor7.Tura + p[s].pc * 4;
      op := Tor7.Citeste(k) MOD 7 * 7 + Tor7.Citeste(k + 1) MOD 7; a := Tor7.Citeste(k + 2) MOD 7; b := Tor7.Citeste(k + 3) MOD 7;   (* 7·B: 7 = cercul intreg = 0 *)
      INC(p[s].pc); INC(p[s].pasi); INC(p[s].pasiSec); INC(totalSec); Tor7.Bate;   (* fiecare instructiune e o bataie a lui Opal *)
      va := p[s].r[a]; vb := p[s].r[b];
      CASE op DIV 7 OF
      0: (* ---- Date ---- *)
        IF op = 0 THEN DEC(p[s].pc); Cade(s, "celula goală nu se execută"); cont := FALSE
        ELSIF op = 1 THEN p[s].r[a] := b
        ELSIF op = 2 THEN p[s].r[a] := va * 7 + b
        ELSIF op = 3 THEN p[s].r[a] := vb
        ELSIF op = 4 THEN p[s].r[a] := Tor7.Citeste(vb)
        ELSIF op = 5 THEN IF ~Al(s, vb) & ~Are(s, 1) THEN Fara(s, 1) ELSE Tor7.Scrie(vb, va) END; cont := FALSE   (* dupa o scriere randul trece mai departe: structura o simte acum *)
        ELSE p[s].r[a] := Tor7.Treapta(vb)   (* NOTAC *)
        END
      | 1: (* ---- Aritmetica ---- *)
        IF op = 7 THEN p[s].r[a] := va + vb
        ELSIF op = 8 THEN p[s].r[a] := va - vb
        ELSIF op = 9 THEN p[s].r[a] := va * vb
        ELSIF op = 10 THEN IF vb = 0 THEN Cade(s, "DIV cu 0"); cont := FALSE ELSE p[s].r[a] := va DIV vb END
        ELSIF op = 11 THEN IF vb = 0 THEN Cade(s, "MOD cu 0"); cont := FALSE ELSE p[s].r[a] := va MOD vb END
        ELSIF op = 12 THEN p[s].r[a] := va + 1
        ELSE p[s].r[a] := va - 1
        END
      | 2: (* ---- Salturi ---- *)
        IF op = 14 THEN IF va < vb THEN p[s].r[a] := 1 ELSE p[s].r[a] := 0 END
        ELSIF op = 15 THEN IF va = vb THEN p[s].r[a] := 1 ELSE p[s].r[a] := 0 END
        ELSIF op = 16 THEN p[s].pc := va
        ELSIF op = 17 THEN IF va = 0 THEN p[s].pc := vb END
        ELSIF op = 18 THEN IF va # 0 THEN p[s].pc := vb END
        ELSIF op = 19 THEN   (* CALL *)
          IF p[s].nrs >= NR THEN Cade(s, "CALL prea adânc (stiva are 49 de locuri)"); cont := FALSE
          ELSE p[s].rs[p[s].nrs] := p[s].pc; INC(p[s].nrs); p[s].pc := va
          END
        ELSE   (* RET *)
          IF p[s].nrs = 0 THEN Cade(s, "RET fără CALL"); cont := FALSE
          ELSE DEC(p[s].nrs); p[s].pc := p[s].rs[p[s].nrs]
          END
        END
      | 3: (* ---- Spatiu ---- *)
        IF op = 21 THEN p[s].r[a] := Tor7.Cuvant(vb)
        ELSIF op = 22 THEN IF ~(Al(s, vb) & Al(s, vb + 11)) & ~Are(s, 1) THEN Fara(s, 1) ELSE Tor7.PuneCuvant(vb, va) END; cont := FALSE
        ELSIF op = 23 THEN   (* STEP *)
          Tor7.Coord(va, d);
          IF vb >= 0 THEN k := vb MOD 7; d[k] := (d[k] + 1) MOD 7 ELSE k := (-vb - 1) MOD 7; d[k] := (d[k] + 6) MOD 7 END;
          p[s].r[a] := Tor7.Index(d)
        ELSIF op = 24 THEN Tor7.Coord(va, d); p[s].r[a] := d[vb MOD 7] + 1   (* COORD: 1..7 (7·B) *)
        ELSIF op = 25 THEN p[s].r[a] := Tor7.Camp(); p[s].vazut := Tor7.Scrieri()
        ELSIF op = 26 THEN
          IF Tor7.Scrieri() > p[s].vazut THEN p[s].vazut := Tor7.Scrieri()
          ELSE DEC(p[s].pc); p[s].stare := Simte; cont := FALSE
          END
        ELSE p[s].r[a] := s * Tor7.Tura   (* BAZA *)
        END
      | 4: (* ---- Nephilim, Roler, sunet ---- *)
        IF op = 28 THEN p[s].r[a] := Tor7.Stare(vb)
        ELSIF op = 29 THEN IF ~Al(s, vb) & ~Are(s, 1) THEN Fara(s, 1); cont := FALSE ELSE Tor7.Combina(vb, va) END
        ELSIF op = 30 THEN IF ~Are(s, 1) THEN Fara(s, 1); cont := FALSE ELSE Tor7.PuneColt(va) END
        ELSIF op = 31 THEN IF ~Are(s, 1) THEN Fara(s, 1) ELSE p[s].r[a] := Tor7.Emite(va, vb) END; cont := FALSE   (* o emisie trece prin tot torul: randul trece mai departe *)
        ELSIF op = 32 THEN   (* ASCULTA; Roler trece prin tor: randul trece mai departe *)
          IF (vb <= -1000) & ((vb <= -3000) & ~Are(s, 16) OR (vb > -3000) & ~Are(s, 32)) THEN   (* 7·B v13 *)
            IF vb <= -3000 THEN Fara(s, 16) ELSE Fara(s, 32) END; cont := FALSE
          ELSIF (vb <= -3000) & areApp THEN p[s].r[a] := app(s, -vb - 3000); cont := (-vb - 3000) MOD 100 # 8   (* 7·B v7: desenul; ARATA cedeaza randul *)
          ELSIF (vb <= -1000) & areExpert THEN p[s].r[a] := expert(s, -vb - 1000); cont := FALSE   (* Cubicum 7: expertii *)
          ELSIF vb <= -100 THEN   (* chemarea sistemului -vb-100; 0 = intrebarea Prolog va a programului *)
            IF (vb = -100) OR (vb = -101) THEN   (* intrebarea q = va: scrie raspunsurile / incepe bucla *)
              IF vb = -100 THEN p[s].r[a] := Z7P.IntrebareaTurei(s, va) ELSE p[s].r[a] := Z7P.IncepeBucla(s, va) END;
              FOR k := 0 TO Z7P.nrez - 1 DO m := "["; Strings.Append(p[s].nume, m); Strings.Append("] ", m); Strings.Append(Z7P.rez[k], m); Spune(m) END;
              cont := FALSE
            ELSIF vb = -102 THEN p[s].r[a] := Z7P.Urmatorul(s, va); cont := TRUE
            ELSIF vb = -103 THEN   (* SCRIEA *)
              m := "["; Strings.Append(p[s].nume, m); Strings.Append("] ", m); Z7P.NumeVal(va, nm); Strings.Append(nm, m); Spune(m); cont := TRUE
            ELSIF vb = -104 THEN p[s].r[a] := Z7P.AtomDin(va); cont := TRUE
            ELSE p[s].r[a] := -1; cont := FALSE
            END
          ELSIF vb < 0 THEN p[s].r[a] := Tor7.Aminteste(-vb - 1); cont := FALSE ELSE p[s].r[a] := Tor7.Asculta(vb); cont := FALSE END
        ELSIF (op >= 33) & ~Are(s, 8) THEN Fara(s, 8); cont := FALSE   (* 7·B v13: CANTA, NOTA *)
        ELSIF op = 33 THEN   (* CANTA: nota celulei va, din locul ei si cifra ei *)
          IF acum >= p[s].ultimNota + 120 THEN Sunet.Nota(Tor7.Hz(Tor7.Treapta(va)), 400, 30); p[s].ultimNota := acum
          ELSE DEC(p[s].pc); p[s].stare := Doarme; p[s].trezire := p[s].ultimNota + 120; cont := FALSE
          END
        ELSE   (* NOTA *)
          IF acum >= p[s].ultimNota + 120 THEN Sunet.Nota(Hz(va, vb), 400, 30); p[s].ultimNota := acum
          ELSE DEC(p[s].pc); p[s].stare := Doarme; p[s].trezire := p[s].ultimNota + 120; cont := FALSE
          END
        END
      | 5: (* ---- Opal, timp, Salamandra, iesire ---- *)
        IF op = 35 THEN p[s].r[a] := Tor7.Opal(vb)
        ELSIF op = 36 THEN   (* SIST Ra, b: b e cifra din instructiune *)
          IF b = 0 THEN p[s].r[a] := s
          ELSIF b = 1 THEN IF (va >= 0) & (va < NP) & (p[va].stare # Liber) THEN p[s].r[a] := p[va].pid ELSE p[s].r[a] := 0 END
          ELSIF b = 2 THEN p[s].r[a] := p[s].dela
          ELSIF b = 3 THEN p[s].r[a] := acum
          ELSIF b = 4 THEN IF (va >= 0) & (va < NP) THEN p[s].r[a] := p[va].stare ELSE p[s].r[a] := 0 END
          ELSIF b = 5 THEN
            IF va = 0 THEN p[s].r[a] := Tor7.Ciclu() ELSIF va = 1 THEN p[s].r[a] := Tor7.BataieOra()
            ELSIF va = 3 THEN p[s].r[a] := Tor7.Arderi() ELSIF va = 4 THEN p[s].r[a] := Tor7.Nascut() ELSE p[s].r[a] := Tor7.Batai() END
          END   (* b = 6: nimic (NOP) *)
        ELSIF op = 37 THEN p[s].r[a] := p[s].caderi   (* ASH *)
        ELSIF op = 38 THEN IF va > 0 THEN p[s].trezire := acum + va; p[s].stare := Doarme; cont := FALSE END
        ELSIF op = 39 THEN m := "["; Strings.Append(p[s].nume, m); Strings.Append("] ", m); Strings.AppendInt(va, 0, m); Spune(m)
        ELSIF op = 40 THEN   (* SCRIEC: o litera; 10 = randul pleaca in shell *)
          IF (va = 10) OR (Strings.Length(p[s].linie) >= LEN(p[s].linie) - 2) THEN Spune(p[s].linie); p[s].linie := "" END;
          IF (va # 10) & (va > 0) & (va < 65536) THEN Strings.AppendChar(CHR(va), p[s].linie) END
        ELSE Strings.AppendInt(va, 0, p[s].linie)   (* SCRIEN: numarul in randul de litere *)
        END
      | 6: (* ---- Procese ---- *)
        IF op = 42 THEN Trimite(s, vb MOD NP, va)
        ELSIF op = 43 THEN
          IF p[s].nq > 0 THEN
            p[s].r[a] := p[s].qv[0]; p[s].r[b] := p[s].qs[0]; p[s].dela := p[s].qs[0];
            FOR k := 0 TO p[s].nq - 2 DO p[s].qv[k] := p[s].qv[k + 1]; p[s].qs[k] := p[s].qs[k + 1] END;
            DEC(p[s].nq)
          ELSE DEC(p[s].pc); p[s].stare := Primeste; cont := FALSE
          END
        ELSIF op = 44 THEN p[s].r[a] := Vecin(s)
        ELSIF (op = 45) & ~Are(s, 4) THEN Fara(s, 4); cont := FALSE   (* 7·B v13 *)
        ELSIF (op = 46) & (va MOD NP # s) & ~Are(s, 2) THEN Fara(s, 2); cont := FALSE
        ELSIF op = 45 THEN   (* PORN: numele programului sta in tor, cuvant cu cuvant, de la adresa Ra *)
          k := 0;
          WHILE (k < 31) & (Tor7.Cuvant(va + 12 * k) > 0) & (Tor7.Cuvant(va + 12 * k) < 65536) DO m[k] := CHR(Tor7.Cuvant(va + 12 * k)); INC(k) END;
          m[k] := 0X;
          p[s].r[b] := porneste(m); cont := FALSE
        ELSIF op = 46 THEN
          IF (va >= 0) & (va < NP) & (p[va MOD NP].stare # Liber) THEN
            m := "["; Strings.Append(p[va MOD NP].nume, m); Strings.Append("] oprit de ", m); Strings.Append(p[s].nume, m); Spune(m);
            p[va MOD NP].stare := Liber
          END;
          cont := p[s].stare # Liber
        ELSIF op = 47 THEN
          m := "["; Strings.Append(p[s].nume, m); Strings.Append("] s-a oprit", m); Spune(m);
          p[s].stare := Liber; cont := FALSE
        ELSE cont := FALSE   (* CEDEAZA *)
        END
      END
    END;
    RETURN cont
  END Pas;

  PROCEDURE Trezeste(acum: INTEGER);   (* cine doarme, simte campul sau asteapta un mesaj si are de ce, se trezeste *)
    VAR s, st: INTEGER;
  BEGIN
    FOR s := 0 TO NP - 1 DO
      st := p[s].stare;
      IF (st = Doarme) & (acum >= p[s].trezire) OR (st = Simte) & (Tor7.Scrieri() > p[s].vazut) OR (st = Primeste) & (p[s].nq > 0) THEN
        p[s].stare := Activ
      END
    END
  END Trezeste;

  PROCEDURE Ruleaza*(buget: INTEGER);   (* o bucata de timp: cel mult buget instructiuni, impartite pe rand *)
    VAR acum, s, k, n: INTEGER; a, cont: BOOLEAN;
  BEGIN
    acum := Sunet.Ms();
    IF acum - secDe >= 1000 THEN   (* CPU% = instructiunile fiecaruia din ultima secunda *)
      FOR s := 0 TO NP - 1 DO
        IF totalSec > 0 THEN p[s].cpu := (p[s].pasiSec * 200 + totalSec) DIV (2 * totalSec) ELSE p[s].cpu := 0 END;
        p[s].pasiSec := 0
      END;
      totalSec := 0; secDe := acum
    END;
    REPEAT
      a := FALSE;
      FOR k := 0 TO NP - 1 DO
        s := (rr + k) MOD NP;
        Trezeste(acum);
        IF (p[s].stare = Activ) & (buget > 0) THEN
          n := 0; cont := TRUE;
          WHILE cont & (n < Felie) & (buget > 0) & (p[s].stare = Activ) DO cont := Pas(s, acum); INC(n); DEC(buget) END;
          a := TRUE
        END
      END
    UNTIL ~a OR (buget <= 0);
    rr := (rr + 1) MOD NP
  END Ruleaza;

  PROCEDURE Porneste*(numeDat: ARRAY OF CHAR): INTEGER;   (* programul .z7 / .z7l din Cubicum FS intra intr-o tura libera *)
    VAR nume: ARRAY 32 OF CHAR; s, i, n, k: INTEGER; m: ARRAY 72 OF CHAR;
  BEGIN
    Strings.Copy(numeDat, nume);
    s := -1; k := 0;
    WHILE (s < 0) & (k < NP) DO IF p[k].stare = Liber THEN s := k END; INC(k) END;
    i := CFS.Gaseste(nume);
    IF (i < 0) & (Strings.Pos(".", nume, 0) < 0) THEN   (* fara extensie: intai limbajul Z7, apoi asamblarea *)
      Strings.Copy(nume, m); Strings.Append(".z7l", m); i := CFS.Gaseste(m);
      IF i < 0 THEN Strings.Copy(nume, m); Strings.Append(".z7", m); i := CFS.Gaseste(m) END;
      IF i >= 0 THEN Strings.Copy(m, nume) END
    END;
    IF (s < 0) & (i >= 0) & areLoc THEN   (* 7·B v9: un expert lasa tura lui *)
      s := loc(-1, 0); IF (s < 0) OR (s >= NP) THEN s := -1 ELSIF p[s].stare # Liber THEN s := -1 END
    END;
    IF s < 0 THEN Spune("nucleul: toate cele 7 ture ale spiralei sunt ocupate · ps = ce rulează · kill N eliberează tura N")
    ELSIF i < 0 THEN m := "nucleul: nu găsesc "; Strings.Append(nume, m); Spune(m); s := -1
    ELSE
      n := Compileaza(s, nume);
      IF n < 0 THEN s := -1
      ELSE
        Strings.Copy(nume, p[s].fisier); Strings.Copy(nume, p[s].nume);
        k := Strings.Pos(".", p[s].nume, 0); IF k > 0 THEN p[s].nume[k] := 0X END;
        p[s].pid := urmPid; INC(urmPid);
        p[s].lung := n; p[s].caderi := 0; Curat(s);
        p[s].stare := Activ;
        m := "["; Strings.Append(p[s].nume, m); Strings.Append("] pornit pe tura ", m); Strings.AppendInt(s + 1, 0, m);
        Strings.Append(" a spiralei · pid ", m); Strings.AppendInt(p[s].pid, 0, m); Spune(m)
      END
    END;
    RETURN s
  END Porneste;

  PROCEDURE PuneDrepturi*(h: DreptP);   (* 7·B v13 *)
  BEGIN drepturi := h; areDrept := TRUE
  END PuneDrepturi;

  PROCEDURE Redrepturi*;   (* 7·B v13: drepturile s-au schimbat: fiecare proces le afla din nou *)
    VAR s: INTEGER;
  BEGIN FOR s := 0 TO NP - 1 DO p[s].drept := -1 END
  END Redrepturi;

  PROCEDURE PuneLoc*(h: ExpertP);   (* 7·B v9 *)
  BEGIN loc := h; areLoc := TRUE
  END PuneLoc;

  PROCEDURE PuneApp*(h: ExpertP);   (* 7·B v7: cine deseneaza pentru ASCULTA(-(3000 + cod)) *)
  BEGIN app := h; areApp := TRUE
  END PuneApp;

  PROCEDURE PuneExpert*(h: ExpertP);   (* Cubicum 7: cine raspunde la ASCULTA(-(1000 + cod)) *)
  BEGIN expert := h; areExpert := TRUE
  END PuneExpert;

  PROCEDURE Opreste*(s: INTEGER);
    VAR m: ARRAY 72 OF CHAR;
  BEGIN
    IF (s >= 0) & (s < NP) & (p[s].stare # Liber) THEN
      m := "["; Strings.Append(p[s].nume, m); Strings.Append("] oprit", m); Spune(m);
      p[s].stare := Liber
    END
  END Opreste;

  PROCEDURE Cale(nume: ARRAY OF CHAR; VAR c: ARRAY OF CHAR);
  BEGIN Strings.Copy(dosar, c); Strings.Append("/", c); Strings.Append(nume, c)
  END Cale;

  PROCEDURE De(ce, c: ARRAY OF CHAR);   (* de ce n-a mers salvarea: pasul si fisierul *)
  BEGIN Strings.Copy(ce, motiv); Strings.Append(" ", motiv); Strings.Append(c, motiv)
  END De;

  PROCEDURE ScrieSesiunea(): BOOLEAN;   (* tabela proceselor si numarul sesiunii *)
    VAR f: Files.File; s, k, acum, r: INTEGER; ok: BOOLEAN; c, t: ARRAY 180 OF CHAR;
  BEGIN
    acum := Sunet.Ms(); Cale("sesiune.tmp", t); f := Files.Create(t); ok := f # NIL;
    IF ~ok THEN De("nu pot crea", t)
    ELSE
      Files.WriteInt(f, SemnS25); Files.WriteInt(f, sesiune); Files.WriteInt(f, urmPid);
      FOR s := 0 TO NP - 1 DO
        Files.WriteInt(f, p[s].stare); Files.WriteStr(f, p[s].nume); Files.WriteInt(f, p[s].pid); Files.WriteInt(f, p[s].pc);
        Files.WriteInt(f, p[s].lung); Files.WriteInt(f, p[s].vazut); Files.WriteInt(f, p[s].trezire - acum);
        Files.WriteInt(f, p[s].ultimNota - acum); Files.WriteInt(f, p[s].pasi); Files.WriteInt(f, p[s].dela);
        FOR k := 0 TO 6 DO Files.WriteInt(f, p[s].r[k]) END;
        Files.WriteInt(f, p[s].nq); FOR k := 0 TO p[s].nq - 1 DO Files.WriteInt(f, p[s].qv[k]); Files.WriteInt(f, p[s].qs[k]) END;
        Files.WriteStr(f, p[s].linie);
        Files.WriteInt(f, p[s].caderi); Files.WriteStr(f, p[s].fisier);   (* v2.5 *)
        Files.WriteInt(f, p[s].nrs); FOR k := 0 TO p[s].nrs - 1 DO Files.WriteInt(f, p[s].rs[k]) END
      END;
      Tor7.ScrieCeas(f);   (* v1.9: ceasul si prima pornire nu ard *)
      ok := Files.Status(f) = Files.OK; Files.Close(f);
      IF ~ok THEN De("eroare la scris", t) END;
      Cale("sesiune.bin", c);
      IF ok THEN
        IF Files.Exists(c) THEN r := Files.Delete(c) END;
        ok := Files.Rename(t, c) = Files.OK; IF ~ok THEN De("nu pot muta în", c) END
      END
    END;
    RETURN ok
  END ScrieSesiunea;

  PROCEDURE Salveaza*(): BOOLEAN;   (* sesiunea de acum: torul intreg + procesele *)
    VAR c, t: ARRAY 180 OF CHAR; ok: BOOLEAN; r: INTEGER;
  BEGIN
    ok := FALSE; motiv := "";
    IF dosar = "" THEN motiv := "nucleul nu știe dosarul"
    ELSE
      Cale("tor7.tmp", t); Cale("tor7.bin", c);
      ok := Tor7.Salveaza(t);
      IF ~ok THEN De("torul nu se scrie în", t)
      ELSE
        IF Files.Exists(c) THEN r := Files.Delete(c) END;
        ok := Files.Rename(t, c) = Files.OK; IF ~ok THEN De("torul nu se mută în", c) END
      END;
      ok := ok & ScrieSesiunea()
    END;
    RETURN ok
  END Salveaza;

  PROCEDURE Motiv*(VAR s: ARRAY OF CHAR);   (* de ce n-a mers ultima salvare *)
  BEGIN Strings.Copy(motiv, s)
  END Motiv;

  PROCEDURE Reia*(d: ARRAY OF CHAR): BOOLEAN;   (* leaga nucleul de dosar si reia sesiunea salvata; TRUE = s-a reluat *)
    VAR f: Files.File; s, k, acum, x, semn, vechi: INTEGER; ok, tor: BOOLEAN; c: ARRAY 180 OF CHAR; m: ARRAY 120 OF CHAR;
  BEGIN
    Strings.Copy(d, dosar); ok := FALSE; acum := Sunet.Ms(); vechi := 0;
    Cale("sesiune.bin", c); f := Files.Open(c);
    IF f # NIL THEN
      semn := Files.ReadInt(f);
      IF (semn = SemnS25) OR (semn = SemnS) OR (semn = SemnS18) THEN
        sesiune := Files.ReadInt(f); urmPid := Files.ReadInt(f);
        Cale("tor7.bin", c); tor := Files.Exists(c) & Tor7.Incarca(c);
        FOR s := 0 TO NP - 1 DO
          p[s].stare := Files.ReadInt(f); k := Files.ReadStr(f, p[s].nume); p[s].pid := Files.ReadInt(f); p[s].pc := Files.ReadInt(f);
          p[s].lung := Files.ReadInt(f); p[s].vazut := Files.ReadInt(f); p[s].trezire := Files.ReadInt(f) + acum;
          p[s].ultimNota := Files.ReadInt(f) + acum; p[s].pasi := Files.ReadInt(f); p[s].dela := Files.ReadInt(f);
          FOR k := 0 TO 6 DO p[s].r[k] := Files.ReadInt(f) END;
          p[s].nq := Files.ReadInt(f); IF (p[s].nq < 0) OR (p[s].nq > NQ) THEN p[s].nq := 0 END;
          FOR k := 0 TO p[s].nq - 1 DO p[s].qv[k] := Files.ReadInt(f); p[s].qs[k] := Files.ReadInt(f) END;
          k := Files.ReadStr(f, p[s].linie);
          p[s].cpu := 0; p[s].pasiSec := 0; p[s].caderi := 0; p[s].nrs := 0; p[s].fisier := ""; p[s].drept := -1;
          IF semn = SemnS25 THEN
            p[s].caderi := Files.ReadInt(f); k := Files.ReadStr(f, p[s].fisier);
            p[s].nrs := Files.ReadInt(f); IF (p[s].nrs < 0) OR (p[s].nrs > NR) THEN p[s].nrs := 0 END;
            FOR k := 0 TO p[s].nrs - 1 DO p[s].rs[k] := Files.ReadInt(f) END
          ELSIF p[s].stare # Liber THEN INC(vechi)   (* v2.5: codul vechi e scris in tor cu numerele vechi: nu se reia *)
          END;
          IF (p[s].stare < Liber) OR (p[s].stare > Doarme) OR ~tor OR (semn # SemnS25) THEN p[s].stare := Liber END
        END;
        IF (semn = SemnS) OR (semn = SemnS25) THEN Tor7.CitesteCeas(f) END;
        ok := Files.Status(f) = Files.OK
      END;
      Files.Close(f)
    END;
    IF ok THEN
      x := 0; FOR s := 0 TO NP - 1 DO IF p[s].stare # Liber THEN INC(x) END END;
      m := "∿ sesiunea "; Strings.AppendInt(sesiune, 0, m); Strings.Append(" continuă · ", m); Strings.AppendInt(x, 0, m);
      Strings.Append(" procese reluate", m); Spune(m);
      IF vechi > 0 THEN
        m := "∿ v2.5: "; Strings.AppendInt(vechi, 0, m);
        Strings.Append(" procese din sesiunea veche nu se reiau (codul lor are numerele vechi) · pornește-le din nou", m); Spune(m)
      END
    ELSE
      FOR s := 0 TO NP - 1 DO p[s].stare := Liber END
    END;
    RETURN ok
  END Reia;

  PROCEDURE Arde*;   (* Burn: procesele si torul ard, si sesiunea salvata; raman Ash si Cubicum FS *)
    VAR s, r: INTEGER; m: ARRAY 72 OF CHAR; c: ARRAY 180 OF CHAR; ok: BOOLEAN;
  BEGIN
    FOR s := 0 TO NP - 1 DO   (* nimic din procese nu ramane *)
      p[s].stare := Liber; p[s].nq := 0; p[s].cpu := 0; p[s].pc := 0; p[s].lung := 0; p[s].pasi := 0; p[s].nrs := 0; p[s].caderi := 0;
      FOR r := 0 TO 6 DO p[s].r[r] := 0 END
    END;
    Tor7.Arde;
    m := "∿ Burn: sesiunea "; Strings.AppendInt(sesiune, 0, m); Strings.Append(" a ars · rămân Ash și Cubicum FS", m); Spune(m);
    m := "∿ ceasul nu arde: ciclul w = "; Strings.AppendInt(Tor7.Ciclu(), 0, m); Strings.Append(" · Burn-uri: ", m);
    Strings.AppendInt(Tor7.Arderi(), 0, m); Spune(m);
    INC(sesiune);
    IF dosar # "" THEN
      Cale("tor7.bin", c); IF Files.Exists(c) THEN r := Files.Delete(c) END;
      ok := ScrieSesiunea()
    END
  END Arde;

  (* ---------- ce vede interfata ---------- *)

  PROCEDURE Stare*(s: INTEGER): INTEGER;
  BEGIN RETURN p[s MOD NP].stare
  END Stare;

  PROCEDURE NumeStare*(st: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN
    IF st = Activ THEN s := "rulează" ELSIF st = Simte THEN s := "simte câmpul" ELSIF st = Primeste THEN s := "primește"
    ELSIF st = Doarme THEN s := "doarme" ELSE s := "liber"
    END
  END NumeStare;

  PROCEDURE Nume*(s: INTEGER; VAR n: ARRAY OF CHAR);
  BEGIN IF p[s MOD NP].stare = Liber THEN n := "" ELSE Strings.Copy(p[s MOD NP].nume, n) END
  END Nume;

  PROCEDURE Pid*(s: INTEGER): INTEGER;
  BEGIN RETURN p[s MOD NP].pid
  END Pid;

  PROCEDURE Cpu*(s: INTEGER): INTEGER;
  BEGIN RETURN p[s MOD NP].cpu
  END Cpu;

  PROCEDURE Pasi*(s: INTEGER): INTEGER;
  BEGIN RETURN p[s MOD NP].pasi
  END Pasi;

  PROCEDURE Lung*(s: INTEGER): INTEGER;
  BEGIN RETURN p[s MOD NP].lung
  END Lung;

  PROCEDURE Pc*(s: INTEGER): INTEGER;
  BEGIN RETURN p[s MOD NP].pc
  END Pc;

  PROCEDURE Reg*(s, k: INTEGER): INTEGER;
  BEGIN RETURN p[s MOD NP].r[k MOD 7]
  END Reg;

  PROCEDURE Vii*(): INTEGER;
    VAR s, n: INTEGER;
  BEGIN n := 0; FOR s := 0 TO NP - 1 DO IF p[s].stare # Liber THEN INC(n) END END; RETURN n
  END Vii;

  PROCEDURE Sesiune*(): INTEGER;
  BEGIN RETURN sesiune
  END Sesiune;

  PROCEDURE Trimise*(): INTEGER;   (* cate mesaje s-au trimis de la pornire *)
  BEGIN RETURN trimise
  END Trimise;

  PROCEDURE Pachet*(k: INTEGER; VAR de, la: INTEGER);   (* mesajul numarul k (din ultimele NK) *)
  BEGIN de := pkF[k MOD NK]; la := pkT[k MOD NK]
  END Pachet;

  PROCEDURE Mn(k: INTEGER; s: ARRAY OF CHAR; f: INTEGER);
  BEGIN Strings.Copy(s, mn[k]); fel[k] := f
  END Mn;

BEGIN
  z7[0] := 196.0; z7[1] := 220.0; z7[2] := 246.94; z7[3] := 261.63; z7[4] := 293.66; z7[5] := 329.63; z7[6] := 369.99;
  (* fel: 0 fara operanzi, 1 Ra, 2 Ra Rb, 3 Ra cifra, 4 SET, 5 salt, 6 salt conditionat
     v2.5: codul = grupa * 7 + locul; 0 = celula goala (nu are nume) *)
  Mn(0, "", 0); Mn(1, "SET", 4); Mn(2, "DIG", 3); Mn(3, "MOV", 2); Mn(4, "LD", 2); Mn(5, "ST", 2); Mn(6, "NOTAC", 2);
  Mn(7, "ADD", 2); Mn(8, "SUB", 2); Mn(9, "MUL", 2); Mn(10, "DIV", 2); Mn(11, "MOD", 2); Mn(12, "INC", 1); Mn(13, "DEC", 1);
  Mn(14, "LT", 2); Mn(15, "EQ", 2); Mn(16, "JMP", 5); Mn(17, "JZ", 6); Mn(18, "JNZ", 6); Mn(19, "CALL", 5); Mn(20, "RET", 0);
  Mn(21, "LDW", 2); Mn(22, "STW", 2); Mn(23, "STEP", 2); Mn(24, "COORD", 2); Mn(25, "CAMP", 1); Mn(26, "ASTEAPTA", 0); Mn(27, "BAZA", 1);
  Mn(28, "NEF", 2); Mn(29, "PUNENEF", 2); Mn(30, "COLT", 1); Mn(31, "EMITE", 2); Mn(32, "ASCULTA", 2); Mn(33, "CANTA", 1); Mn(34, "NOTA", 2);
  Mn(35, "OPAL", 2); Mn(36, "SIST", 3); Mn(37, "ASH", 1); Mn(38, "DORMI", 1); Mn(39, "SCRIE", 1); Mn(40, "SCRIEC", 1); Mn(41, "SCRIEN", 1);
  Mn(42, "TRIMITE", 2); Mn(43, "PRIMESTE", 2); Mn(44, "VECIN", 1); Mn(45, "PORN", 2); Mn(46, "OPR", 1); Mn(47, "STOP", 0); Mn(48, "CEDEAZA", 0);
  porneste := Porneste; dosar := ""; areExpert := FALSE; areApp := FALSE; areLoc := FALSE; areDrept := FALSE;
  urmPid := 2; sesiune := 1; rr := 0; secDe := 0; totalSec := 0; trimise := 0; nies := 0;
  FOR rr := 0 TO NP - 1 DO p[rr].stare := Liber; p[rr].pid := 0 END;
  rr := 0
END Salamandra.


MODULE E7Txt; (* Eula 7 in Oberon: literele si sirurile. Felul fiecarui semn (litera, cifra, majuscula) si literele
  mici/mari vin din unicode.bin, un tabel facut o data din Java (aceleasi raspunsuri ca Character.isLetter & co.).
  Plus: vectori mari de intregi si de semne (pe bucati de 64 K) si Tabel = siruri unice numerotate 0, 1, 2 ...
  in ordinea in care intra (ca HashMap<String, Integer> + ArrayList<String> din Eula 7).  Pion & Claude, 20.10.2026 *)

  IMPORT Files;

  CONST B* = 65536; NB = 4096; MaxCuv* = 1024;

  TYPE
    IBloc = POINTER TO IBlocDesc;
    IBlocDesc = RECORD a: ARRAY B OF INTEGER END;
    Ints* = POINTER TO IntsDesc;
    IntsDesc* = RECORD b: ARRAY NB OF IBloc END;

    CBloc = POINTER TO CBlocDesc;
    CBlocDesc = RECORD a: ARRAY B OF CHAR END;
    Chars* = POINTER TO CharsDesc;
    CharsDesc* = RECORD b: ARRAY NB OF CBloc END;

    Tabel* = POINTER TO TabelDesc;
    TabelDesc* = RECORD
      n*: INTEGER;              (* cate siruri *)
      cap: INTEGER;             (* sloturile (putere a lui 2) *)
      slot: Ints;               (* id + 1, 0 = gol *)
      st, ln, hs: Ints;         (* unde incepe sirul in pool, cat e de lung, hash-ul lui *)
      pool: Chars; np: INTEGER;
      val*: Ints                (* o valoare pentru fiecare sir, pentru cine are nevoie *)
    END ;

  VAR fel: ARRAY 65536 OF BYTE;
    mic, mare: ARRAY 65536 OF CHAR;
    ubuf: ARRAY 65536 OF BYTE; uk: INTEGER;
    gata*: BOOLEAN;

  (* ---------- vectorii mari ---------- *)

  PROCEDURE NouInts*(): Ints;
    VAR x: Ints;
  BEGIN NEW(x); RETURN x
  END NouInts;

  PROCEDURE Ia*(x: Ints; i: INTEGER): INTEGER;
    VAR b: IBloc; r: INTEGER;
  BEGIN b := x.b[i DIV B];
    IF b = NIL THEN r := 0 ELSE r := b.a[i MOD B] END ;
    RETURN r
  END Ia;

  PROCEDURE Pune*(x: Ints; i, v: INTEGER);
    VAR k: INTEGER;
  BEGIN k := i DIV B;
    IF x.b[k] = NIL THEN NEW(x.b[k]) END ;
    x.b[k].a[i MOD B] := v
  END Pune;

  PROCEDURE NouChars*(): Chars;
    VAR x: Chars;
  BEGIN NEW(x); RETURN x
  END NouChars;

  PROCEDURE C*(x: Chars; i: INTEGER): CHAR;
    VAR b: CBloc; r: CHAR;
  BEGIN b := x.b[i DIV B];
    IF b = NIL THEN r := 0X ELSE r := b.a[i MOD B] END ;
    RETURN r
  END C;

  PROCEDURE PuneC*(x: Chars; i: INTEGER; c: CHAR);
    VAR k: INTEGER;
  BEGIN k := i DIV B;
    IF x.b[k] = NIL THEN NEW(x.b[k]) END ;
    x.b[k].a[i MOD B] := c
  END PuneC;

  (* ---------- felul semnelor (din unicode.bin) ---------- *)

  PROCEDURE Litera*(c: CHAR): BOOLEAN;     (* Character.isLetter *)
  BEGIN RETURN ODD(fel[ORD(c)])
  END Litera;

  PROCEDURE Cifra*(c: CHAR): BOOLEAN;      (* Character.isDigit *)
  BEGIN RETURN ODD(fel[ORD(c)] DIV 2)
  END Cifra;

  PROCEDURE LitCif*(c: CHAR): BOOLEAN;     (* Character.isLetterOrDigit *)
  BEGIN RETURN fel[ORD(c)] MOD 4 # 0
  END LitCif;

  PROCEDURE Majuscula*(c: CHAR): BOOLEAN;  (* Character.isUpperCase *)
  BEGIN RETURN ODD(fel[ORD(c)] DIV 4)
  END Majuscula;

  PROCEDURE Lu*(c: CHAR): BOOLEAN;         (* \p{Lu} din expresii *)
  BEGIN RETURN ODD(fel[ORD(c)] DIV 8)
  END Lu;

  PROCEDURE Cuv*(c: CHAR): BOOLEAN;        (* semn de cuvant pentru \b (litera, cifra, semn diacritic, _) *)
  BEGIN RETURN ODD(fel[ORD(c)] DIV 16)
  END Cuv;

  PROCEDURE Mic*(c: CHAR): CHAR;           (* Character.toLowerCase *)
  BEGIN RETURN mic[ORD(c)]
  END Mic;

  PROCEDURE Mare*(c: CHAR): CHAR;          (* Character.toUpperCase *)
  BEGIN RETURN mare[ORD(c)]
  END Mare;

  PROCEDURE Spatiu*(c: CHAR): BOOLEAN;     (* \s: spatiu, \t \n \v \f \r *)
  BEGIN RETURN (c = " ") OR (c >= 9X) & (c <= 0DX)
  END Spatiu;

  (* fara diacritice (doar literele mici, ca Memorie.fold): ă â -> a, î -> i, ș ş -> s, ț ţ -> t *)
  PROCEDURE Fold*(c: CHAR): CHAR;
    VAR o: INTEGER;
  BEGIN o := ORD(c);
    IF (o = 103H) OR (o = 0E2H) THEN c := "a"
    ELSIF o = 0EEH THEN c := "i"
    ELSIF (o = 219H) OR (o = 15FH) THEN c := "s"
    ELSIF (o = 21BH) OR (o = 163H) THEN c := "t"
    END ;
    RETURN c
  END Fold;

  PROCEDURE Incarca*(cale: ARRAY OF CHAR): BOOLEAN;
    VAR f: Files.File; n, i, a, b: INTEGER;

    PROCEDURE Int(): INTEGER;
      VAR x: INTEGER;
    BEGIN x := ubuf[uk] * 1000000H + ubuf[uk+1] * 10000H + ubuf[uk+2] * 100H + ubuf[uk+3]; uk := uk + 4;
      RETURN x
    END Int;

    PROCEDURE Sh(): INTEGER;
      VAR x: INTEGER;
    BEGIN x := ubuf[uk] * 100H + ubuf[uk+1]; uk := uk + 2;
      RETURN x
    END Sh;

  BEGIN gata := FALSE;
    IF Files.Exists(cale) THEN
      FOR i := 0 TO 65535 DO mic[i] := CHR(i); mare[i] := CHR(i) END ;
      f := Files.Open(cale);
      IF f # NIL THEN
        Files.ReadBytes(f, fel, n);
        IF n = 65536 THEN
          Files.ReadBytes(f, ubuf, n); uk := 0;
          a := Int();
          FOR i := 1 TO a DO b := Sh(); mic[b] := CHR(Sh()) END ;
          a := Int();
          FOR i := 1 TO a DO b := Sh(); mare[b] := CHR(Sh()) END ;
          gata := uk <= n
        END ;
        Files.Close(f)
      END
    END ;
    RETURN gata
  END Incarca;

  (* ---------- siruri ---------- *)

  PROCEDURE Len*(s: ARRAY OF CHAR): INTEGER;
    VAR i: INTEGER;
  BEGIN i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) DO INC(i) END ;
    RETURN i
  END Len;

  PROCEDURE Copy*(s: ARRAY OF CHAR; VAR d: ARRAY OF CHAR);
    VAR i: INTEGER;
  BEGIN i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) & (i < LEN(d) - 1) DO d[i] := s[i]; INC(i) END ;
    d[i] := 0X
  END Copy;

  PROCEDURE Add*(VAR d: ARRAY OF CHAR; s: ARRAY OF CHAR);
    VAR i, j: INTEGER;
  BEGIN i := Len(d); j := 0;
    WHILE (j < LEN(s)) & (s[j] # 0X) & (i < LEN(d) - 1) DO d[i] := s[j]; INC(i); INC(j) END ;
    d[i] := 0X
  END Add;

  PROCEDURE AddCh*(VAR d: ARRAY OF CHAR; c: CHAR);
    VAR i: INTEGER;
  BEGIN i := Len(d);
    IF i < LEN(d) - 1 THEN d[i] := c; d[i+1] := 0X END
  END AddCh;

  PROCEDURE AddInt*(VAR d: ARRAY OF CHAR; x: INTEGER);
    VAR t: ARRAY 16 OF CHAR; i, q: INTEGER;
  BEGIN
    IF x = 0 THEN AddCh(d, "0")
    ELSE i := 0;
      IF x < 0 THEN AddCh(d, "-") END ;
      WHILE x # 0 DO
        q := x DIV 10;
        IF (x < 0) & (q * 10 # x) THEN q := q + 1 END ;
        t[i] := CHR(ORD("0") + ABS(x - q * 10)); INC(i); x := q
      END ;
      WHILE i > 0 DO DEC(i); AddCh(d, t[i]) END
    END
  END AddInt;

  (* String.format("%,d") cu punct in loc de virgula: 1.234.567 *)
  PROCEDURE AddNr*(VAR d: ARRAY OF CHAR; x: INTEGER);
    VAR t: ARRAY 16 OF CHAR; i, k: INTEGER;
  BEGIN
    IF x < 0 THEN AddCh(d, "-"); x := -x END ;
    i := 0;
    REPEAT t[i] := CHR(ORD("0") + x MOD 10); x := x DIV 10; INC(i) UNTIL x = 0;
    k := i;
    WHILE i > 0 DO
      DEC(i); AddCh(d, t[i]);
      IF (i > 0) & (i MOD 3 = 0) THEN AddCh(d, ".") END
    END
  END AddNr;

  PROCEDURE Eq*(a, b: ARRAY OF CHAR): BOOLEAN;
    VAR i: INTEGER;
  BEGIN i := 0;
    WHILE (i < LEN(a)) & (i < LEN(b)) & (a[i] = b[i]) & (a[i] # 0X) DO INC(i) END ;
    RETURN ((i = LEN(a)) OR (a[i] = 0X)) & ((i = LEN(b)) OR (b[i] = 0X))
  END Eq;

  PROCEDURE Incepe*(s, p: ARRAY OF CHAR): BOOLEAN;
    VAR i: INTEGER;
  BEGIN i := 0;
    WHILE (i < LEN(p)) & (p[i] # 0X) & (i < LEN(s)) & (s[i] = p[i]) DO INC(i) END ;
    RETURN (i >= LEN(p)) OR (p[i] = 0X)
  END Incepe;

  (* incepe s, de la pozitia k, cu p? *)
  PROCEDURE IncepeLa*(s: ARRAY OF CHAR; k: INTEGER; p: ARRAY OF CHAR): BOOLEAN;
    VAR i: INTEGER;
  BEGIN i := 0;
    WHILE (i < LEN(p)) & (p[i] # 0X) & (k + i < LEN(s)) & (s[k+i] = p[i]) DO INC(i) END ;
    RETURN (i >= LEN(p)) OR (p[i] = 0X)
  END IncepeLa;

  PROCEDURE Sfarsit*(s, p: ARRAY OF CHAR): BOOLEAN;
    VAR i, j: INTEGER;
  BEGIN i := Len(s); j := Len(p);
    WHILE (j > 0) & (i > 0) & (s[i-1] = p[j-1]) DO DEC(i); DEC(j) END ;
    RETURN j = 0
  END Sfarsit;

  (* pozitia lui p in s de la „de” incolo, sau -1 *)
  PROCEDURE Pos*(p, s: ARRAY OF CHAR; de: INTEGER): INTEGER;
    VAR i, j, n, m, r: INTEGER;
  BEGIN n := Len(s); m := Len(p); r := -1; i := de;
    WHILE (r < 0) & (i + m <= n) DO
      j := 0;
      WHILE (j < m) & (s[i+j] = p[j]) DO INC(j) END ;
      IF j = m THEN r := i END ;
      INC(i)
    END ;
    RETURN r
  END Pos;

  PROCEDURE Contine*(s, p: ARRAY OF CHAR): BOOLEAN;
  BEGIN RETURN Pos(p, s, 0) >= 0
  END Contine;

  (* bucata s[a..b) in d *)
  PROCEDURE Sub*(s: ARRAY OF CHAR; a, b: INTEGER; VAR d: ARRAY OF CHAR);
    VAR i: INTEGER;
  BEGIN i := 0;
    WHILE (a < b) & (i < LEN(d) - 1) DO d[i] := s[a]; INC(i); INC(a) END ;
    d[i] := 0X
  END Sub;

  (* String.trim: scoate ce e <= " " de la capete *)
  PROCEDURE Trim*(VAR s: ARRAY OF CHAR);
    VAR a, b, i: INTEGER;
  BEGIN b := Len(s); a := 0;
    WHILE (a < b) & (s[a] <= " ") DO INC(a) END ;
    WHILE (b > a) & (s[b-1] <= " ") DO DEC(b) END ;
    i := 0;
    WHILE a < b DO s[i] := s[a]; INC(i); INC(a) END ;
    s[i] := 0X
  END Trim;

  (* toLowerCase, semn cu semn *)
  PROCEDURE MicS*(VAR s: ARRAY OF CHAR);
    VAR i: INTEGER;
  BEGIN i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) DO s[i] := mic[ORD(s[i])]; INC(i) END
  END MicS;

  (* Memorie.fold *)
  PROCEDURE FoldS*(VAR s: ARRAY OF CHAR);
    VAR i: INTEGER;
  BEGIN i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) DO s[i] := Fold(s[i]); INC(i) END
  END FoldS;

  (* String.hashCode *)
  PROCEDURE Hash*(s: ARRAY OF CHAR): INTEGER;
    VAR h, i: INTEGER;
  BEGIN h := 0; i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) DO h := h * 31 + ORD(s[i]); INC(i) END ;
    RETURN h
  END Hash;

  (* intre literele dintr-o lista despartita de "|": e s chiar unul dintre ele? *)
  PROCEDURE InLista*(s, lista: ARRAY OF CHAR): BOOLEAN;
    VAR i, j: INTEGER; da, gasit: BOOLEAN;
  BEGIN i := 0; gasit := FALSE;
    WHILE ~gasit & (i < LEN(lista)) & (lista[i] # 0X) DO
      j := 0; da := TRUE;
      WHILE (i < LEN(lista)) & (lista[i] # 0X) & (lista[i] # "|") DO
        IF da & (j < LEN(s)) & (s[j] = lista[i]) THEN INC(j) ELSE da := FALSE END ;
        INC(i)
      END ;
      IF da & ((j = LEN(s)) OR (s[j] = 0X)) THEN gasit := TRUE END ;
      IF (i < LEN(lista)) & (lista[i] = "|") THEN INC(i) END
    END ;
    RETURN gasit
  END InLista;

  (* ---------- Tabel: siruri unice, numerotate in ordinea intrarii ---------- *)

  PROCEDURE NouTabel*(): Tabel;
    VAR t: Tabel;
  BEGIN NEW(t); t.n := 0; t.cap := 1024; t.slot := NouInts(); t.st := NouInts(); t.ln := NouInts(); t.hs := NouInts();
    t.pool := NouChars(); t.np := 0; t.val := NouInts();
    RETURN t
  END NouTabel;

  PROCEDURE Goleste*(t: Tabel);
  BEGIN t.n := 0; t.cap := 1024; t.slot := NouInts(); t.st := NouInts(); t.ln := NouInts(); t.hs := NouInts();
    t.pool := NouChars(); t.np := 0; t.val := NouInts()
  END Goleste;

  PROCEDURE Loc(h, cap: INTEGER): INTEGER;
  BEGIN RETURN ASR(h * 1103515245 + 12345, 7) MOD cap
  END Loc;

  PROCEDURE Acelasi(t: Tabel; id: INTEGER; s: ARRAY OF CHAR; n: INTEGER): BOOLEAN;
    VAR a, i: INTEGER; da: BOOLEAN;
  BEGIN da := Ia(t.ln, id) = n;
    IF da THEN
      a := Ia(t.st, id); i := 0;
      WHILE da & (i < n) DO da := C(t.pool, a + i) = s[i]; INC(i) END
    END ;
    RETURN da
  END Acelasi;

  (* numarul sirului s, sau -1 *)
  PROCEDURE Gaseste*(t: Tabel; s: ARRAY OF CHAR): INTEGER;
    VAR h, n, k, id, r: INTEGER;
  BEGIN n := Len(s); h := Hash(s); k := Loc(h, t.cap); r := -2;
    WHILE r = -2 DO
      id := Ia(t.slot, k) - 1;
      IF id < 0 THEN r := -1
      ELSIF (Ia(t.hs, id) = h) & Acelasi(t, id, s, n) THEN r := id
      ELSE k := (k + 1) MOD t.cap
      END
    END ;
    RETURN r
  END Gaseste;

  PROCEDURE Creste(t: Tabel);
    VAR s: Ints; id, k: INTEGER;
  BEGIN t.cap := t.cap * 2; s := NouInts();
    FOR id := 0 TO t.n - 1 DO
      k := Loc(Ia(t.hs, id), t.cap);
      WHILE Ia(s, k) # 0 DO k := (k + 1) MOD t.cap END ;
      Pune(s, k, id + 1)
    END ;
    t.slot := s
  END Creste;

  (* numarul sirului s; daca nu era, il adauga (cu urmatorul numar) *)
  PROCEDURE Adauga*(t: Tabel; s: ARRAY OF CHAR): INTEGER;
    VAR h, n, k, id, i: INTEGER;
  BEGIN id := Gaseste(t, s);
    IF id < 0 THEN
      IF 2 * (t.n + 1) > t.cap THEN Creste(t) END ;
      n := Len(s); h := Hash(s); id := t.n; INC(t.n);
      Pune(t.st, id, t.np); Pune(t.ln, id, n); Pune(t.hs, id, h);
      FOR i := 0 TO n - 1 DO PuneC(t.pool, t.np, s[i]); INC(t.np) END ;
      k := Loc(h, t.cap);
      WHILE Ia(t.slot, k) # 0 DO k := (k + 1) MOD t.cap END ;
      Pune(t.slot, k, id + 1)
    END ;
    RETURN id
  END Adauga;

  PROCEDURE Are*(t: Tabel; s: ARRAY OF CHAR): BOOLEAN;
  BEGIN RETURN Gaseste(t, s) >= 0
  END Are;

  PROCEDURE Sir*(t: Tabel; id: INTEGER; VAR s: ARRAY OF CHAR);
    VAR a, n, i: INTEGER;
  BEGIN a := Ia(t.st, id); n := Ia(t.ln, id); i := 0;
    WHILE (i < n) & (i < LEN(s) - 1) DO s[i] := C(t.pool, a + i); INC(i) END ;
    s[i] := 0X
  END Sir;

  PROCEDURE Lung*(t: Tabel; id: INTEGER): INTEGER;
  BEGIN RETURN Ia(t.ln, id)
  END Lung;

  PROCEDURE SirC*(t: Tabel; id, i: INTEGER): CHAR;      (* semnul i al sirului id *)
  BEGIN RETURN C(t.pool, Ia(t.st, id) + i)
  END SirC;

  (* incepe sirul id cu p? *)
  PROCEDURE SirIncepe*(t: Tabel; id: INTEGER; p: ARRAY OF CHAR): BOOLEAN;
    VAR a, n, i: INTEGER; da: BOOLEAN;
  BEGIN a := Ia(t.st, id); n := Ia(t.ln, id); i := 0; da := TRUE;
    WHILE da & (i < LEN(p)) & (p[i] # 0X) DO da := (i < n) & (C(t.pool, a + i) = p[i]); INC(i) END ;
    RETURN da
  END SirIncepe;

  (* o lista de cuvinte despartite de spatii intra in tabel *)
  PROCEDURE Lista*(t: Tabel; s: ARRAY OF CHAR);
    VAR w: ARRAY 64 OF CHAR; i, j, id: INTEGER;
  BEGIN i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) DO
      WHILE s[i] = " " DO INC(i) END ;
      j := 0;
      WHILE (i < LEN(s)) & (s[i] # 0X) & (s[i] # " ") DO w[j] := s[i]; INC(j); INC(i) END ;
      w[j] := 0X;
      IF j > 0 THEN id := Adauga(t, w) END
    END
  END Lista;

  (* tabele implicite, cand nu e unicode.bin (de pilda in Cubicum OS): ASCII, Latin-1, Latin Extended-A, ș ț,
     grec si chirilic de baza. fel: 1 litera, 2 cifra, 4 majuscula, 8 \p{Lu}, 16 semn de cuvant *)
  PROCEDURE Pereche(m, mi: INTEGER);   (* m majuscula, mi litera mica *)
  BEGIN fel[m] := 1 + 4 + 8 + 16; fel[mi] := 1 + 16; mic[m] := CHR(mi); mare[mi] := CHR(m)
  END Pereche;

  PROCEDURE Implicit*;
    VAR i: INTEGER;
  BEGIN
    FOR i := 0 TO 65535 DO fel[i] := 0; mic[i] := CHR(i); mare[i] := CHR(i) END;
    FOR i := 41H TO 5AH DO Pereche(i, i + 32) END;
    FOR i := 30H TO 39H DO fel[i] := 2 + 16 END; fel[5FH] := 16;
    FOR i := 0C0H TO 0DEH DO IF i # 0D7H THEN Pereche(i, i + 32) END END;
    fel[0DFH] := 1 + 16; fel[0AAH] := 1 + 16; fel[0BAH] := 1 + 16; fel[0B5H] := 1 + 16; Pereche(178H, 0FFH);
    FOR i := 100H TO 137H DO IF ~ODD(i) THEN Pereche(i, i + 1) END END;
    FOR i := 139H TO 148H DO IF ODD(i) THEN Pereche(i, i + 1) END END;
    FOR i := 14AH TO 177H DO IF ~ODD(i) THEN Pereche(i, i + 1) END END;
    FOR i := 179H TO 17EH DO IF ODD(i) THEN Pereche(i, i + 1) END END;
    fel[138H] := 1 + 16; fel[149H] := 1 + 16; fel[17FH] := 1 + 16;
    Pereche(130H, 69H); mic[130H] := "i"; fel[131H] := 1 + 16; mare[131H] := "I";
    Pereche(218H, 219H); Pereche(21AH, 21BH);
    FOR i := 300H TO 36FH DO fel[i] := 16 END;
    FOR i := 391H TO 3A9H DO IF i # 3A2H THEN Pereche(i, i + 32) END END; fel[3C2H] := 1 + 16;
    FOR i := 410H TO 42FH DO Pereche(i, i + 32) END;
    FOR i := 400H TO 40FH DO Pereche(i, i + 80) END
  END Implicit;

BEGIN gata := FALSE; Implicit
END E7Txt.


MODULE E7Teorie; (* Eula Music in Oberon: teoria muzicii, calculata (nu cautata), ca Teorie.java din Eula Music v3.
  Note cu numele romanesti (Do Re Mi Fa Sol La Si, diez/bemol), intervale, game si moduri, acorduri, armura,
  relative, cercul cvintelor, frecvente. Fiecare raspuns vine cu ce trebuie cantat: evenimentele (nota midi,
  cand incepe si cat tine, in zece-miimi de bataie, vocea 0 melodie / 1 acompaniament / 2 bas).
  Expresiile regulate din Java sunt scrise de mana, cu aceeasi ordine de incercare (si aceleasi intoarceri).
  Pion & Claude, 21.10.2026 *)

  IMPORT Files, T := E7Txt;

  CONST NE* = 12000; LT* = 8192; NG = 15; NA = 13; NCG = 46; NCA = 34; LQ = 1024;
    Bt* = 10000;   (* o bataie *)

  TYPE Sir = ARRAY 48 OF CHAR;

  VAR
    txt*: ARRAY LT OF CHAR;                          (* textul raspunsului *)
    nev*: INTEGER; em*, et*, ed*, ev*: ARRAY NE OF INTEGER;   (* evenimentele *)
    LIT*: ARRAY 7 OF ARRAY 4 OF CHAR; LITEN: ARRAY 8 OF CHAR;
    PC*: ARRAY 7 OF INTEGER;
    (* game *)
    gCheie*, gNume*: ARRAY NG OF Sir; gSemi*, gLit*: ARRAY NG OF ARRAY 12 OF INTEGER; gN*: ARRAY NG OF INTEGER;
    gL7*, gCrom: ARRAY NG OF BOOLEAN;
    (* acorduri *)
    aCheie, aNume, aSuf: ARRAY NA OF Sir; aSemi, aLit: ARRAY NA OF ARRAY 6 OF INTEGER; aN: ARRAY NA OF INTEGER;
    (* cuvintele pentru game si acorduri, cele lungi intai *)
    cgK*, cgV*: ARRAY NCG OF Sir; ncg*: INTEGER;
    caK, caV: ARRAY NCA OF Sir; nca: INTEGER;
    NUMAR: ARRAY 7 OF ARRAY 12 OF CHAR; REF: ARRAY 7 OF INTEGER; PERFECT: ARRAY 7 OF BOOLEAN;
    f2: ARRAY 240 OF INTEGER; f1: ARRAY 12 OF INTEGER;   (* frecventele scrise (sutimi, zecimi), din Java *)
    fold: ARRAY 65536 OF CHAR; foldOk: BOOLEAN; fb: ARRAY 131072 OF BYTE;
    fapt*: ARRAY 40000 OF CHAR;                      (* fapte(): frazele pentru memorie *)
    (* rezultatul ultimei potriviri a unei note in text *)
    nLit*, nAlt*: INTEGER;

  (* ---------- evenimentele ---------- *)

  PROCEDURE Goleste*;
  BEGIN nev := 0; txt[0] := 0X
  END Goleste;

  PROCEDURE PuneTxt*(s: ARRAY OF CHAR);   (* textul raspunsului, scris din alt modul *)
  BEGIN T.Copy(s, txt)
  END PuneTxt;

  PROCEDURE Ev*(midi, t, d, voce: INTEGER);
  BEGIN
    IF nev < NE THEN em[nev] := midi; et[nev] := t; ed[nev] := d; ev[nev] := voce; INC(nev) END
  END Ev;

  (* ---------- notele ---------- *)

  PROCEDURE Norm7(l: INTEGER): INTEGER;
  BEGIN RETURN l MOD 7
  END Norm7;

  PROCEDURE Pc*(lit, alt: INTEGER): INTEGER;
  BEGIN RETURN (PC[lit MOD 7] + alt) MOD 12
  END Pc;

  (* nota aflata la lo litere si semi semitonuri deasupra *)
  PROCEDURE Sus*(lit, alt, lo, semi: INTEGER; VAR rl, ra: INTEGER);
    VAR l, tinta, a: INTEGER;
  BEGIN
    l := (lit + lo) MOD 7;
    tinta := (Pc(lit, alt) + semi) MOD 12;
    a := tinta - PC[l];
    WHILE a > 6 DO a := a - 12 END;
    WHILE a < -6 DO a := a + 12 END;
    rl := l; ra := a
  END Sus;

  PROCEDURE AddNume*(VAR d: ARRAY OF CHAR; lit, alt: INTEGER);
  BEGIN
    T.Add(d, LIT[lit MOD 7]);
    IF alt = 1 THEN T.Add(d, " diez") ELSIF alt = -1 THEN T.Add(d, " bemol")
    ELSIF alt = 2 THEN T.Add(d, " dublu diez") ELSIF alt = -2 THEN T.Add(d, " dublu bemol")
    END
  END AddNume;

  PROCEDURE AddSimbol(VAR d: ARRAY OF CHAR; lit, alt: INTEGER);
  BEGIN
    T.AddCh(d, LITEN[lit MOD 7]);
    IF alt = 1 THEN T.Add(d, "#") ELSIF alt = -1 THEN T.Add(d, "b") ELSIF alt = 2 THEN T.Add(d, "##") ELSIF alt = -2 THEN T.Add(d, "bb") END
  END AddSimbol;

  (* notele unei game / unui acord: semi + litere; fara litere (cromatica): diezi la urcare *)
  PROCEDURE Scrie*(rl, ra: INTEGER; semi, lit: ARRAY OF INTEGER; n: INTEGER; crom: BOOLEAN; VAR ol, oa: ARRAY OF INTEGER);
    VAR i, k, l, pc: INTEGER;
  BEGIN
    FOR i := 0 TO n - 1 DO
      IF crom THEN
        pc := (Pc(rl, ra) + semi[i]) MOD 12; l := 0;
        k := 6; WHILE (k >= 0) & (PC[k] > pc) DO DEC(k) END; IF k >= 0 THEN l := k END;
        ol[i] := l; oa[i] := pc - PC[l]
      ELSE Sus(rl, ra, lit[i], semi[i], ol[i], oa[i])
      END
    END
  END Scrie;

  PROCEDURE AddLista*(VAR d: ARRAY OF CHAR; nl, na: ARRAY OF INTEGER; n: INTEGER);
    VAR i: INTEGER;
  BEGIN
    FOR i := 0 TO n - 1 DO
      IF i > 0 THEN IF i = n - 1 THEN T.Add(d, " și ") ELSE T.Add(d, ", ") END END;
      AddNume(d, nl[i], na[i])
    END
  END AddLista;

  PROCEDURE Gama*(cheie: ARRAY OF CHAR): INTEGER;
    VAR i, r: INTEGER;
  BEGIN r := 0; i := NG - 1; WHILE i >= 0 DO IF T.Eq(gCheie[i], cheie) THEN r := i END; DEC(i) END; RETURN r
  END Gama;

  PROCEDURE Acord(cheie: ARRAY OF CHAR): INTEGER;
    VAR i, r: INTEGER;
  BEGIN r := 0; i := NA - 1; WHILE i >= 0 DO IF T.Eq(aCheie[i], cheie) THEN r := i END; DEC(i) END; RETURN r
  END Acord;

  (* ---------- intervale ---------- *)

  PROCEDURE AddInterval(VAR d: ARRAY OF CHAR; al, aa, bl, ba: INTEGER);   (* intervalul urcator de la a la b *)
    VAR n, s, x: INTEGER;
  BEGIN
    n := (bl - al) MOD 7;
    s := (Pc(bl, ba) - Pc(al, aa)) MOD 12;
    x := s - REF[n];
    WHILE x > 6 DO x := x - 12 END;
    WHILE x < -6 DO x := x + 12 END;
    IF (n = 0) & (x = 0) THEN T.Add(d, "primă perfectă (unison)")
    ELSE
      T.Add(d, NUMAR[n]); T.Add(d, " ");
      IF PERFECT[n] THEN
        IF x = 0 THEN T.Add(d, "perfectă") ELSIF x = 1 THEN T.Add(d, "mărită") ELSIF x = -1 THEN T.Add(d, "micșorată")
        ELSIF x > 0 THEN T.Add(d, "de două ori mărită") ELSE T.Add(d, "de două ori micșorată") END
      ELSE
        IF x = 0 THEN T.Add(d, "mare") ELSIF x = -1 THEN T.Add(d, "mică") ELSIF x = 1 THEN T.Add(d, "mărită") ELSIF x = -2 THEN T.Add(d, "micșorată")
        ELSIF x > 0 THEN T.Add(d, "de două ori mărită") ELSE T.Add(d, "de două ori micșorată") END
      END
    END
  END AddInterval;

  PROCEDURE Semi(al, aa, bl, ba: INTEGER): INTEGER;
  BEGIN RETURN (Pc(bl, ba) - Pc(al, aa)) MOD 12
  END Semi;

  PROCEDURE MidiRad*(lit, alt: INTEGER): INTEGER;   (* Do4 = 60, in jurul lui Do4 *)
    VAR m: INTEGER;
  BEGIN m := 60 + Pc(lit, alt); IF m > 66 THEN m := m - 12 END; RETURN m
  END MidiRad;

  PROCEDURE AddZec(VAR d: ARRAY OF CHAR; v, zec: INTEGER);   (* v in sutimi / zecimi, cu virgula *)
    VAR p, k: INTEGER;
  BEGIN
    p := 1; FOR k := 1 TO zec DO p := p * 10 END;
    T.AddInt(d, v DIV p); T.AddCh(d, ",");
    v := v MOD p; k := p DIV 10;
    WHILE k > 0 DO T.AddCh(d, CHR(ORD("0") + v DIV k MOD 10)); k := k DIV 10 END
  END AddZec;

  (* ---------- armura ---------- *)

  PROCEDURE Armura(tl, ta: INTEGER; minor: BOOLEAN; VAR ol, oa: ARRAY OF INTEGER): INTEGER;
    VAR ml, ma, i, j, n, x, y, t: INTEGER; nl, na, ord, poz: ARRAY 7 OF INTEGER; schimb: BOOLEAN;
  BEGIN
    IF minor THEN Sus(tl, ta, 2, 3, ml, ma) ELSE ml := tl; ma := ta END;
    Scrie(ml, ma, gSemi[0], gLit[0], 7, FALSE, nl, na);
    n := 0; FOR i := 0 TO 6 DO IF na[i] # 0 THEN ol[n] := nl[i]; oa[n] := na[i]; INC(n) END END;
    ord[0] := 3; ord[1] := 0; ord[2] := 4; ord[3] := 1; ord[4] := 5; ord[5] := 2; ord[6] := 6;
    FOR i := 0 TO 6 DO poz[ord[i]] := i END;
    (* Collections.sort e stabil: sortare prin insertie cu acelasi comparator *)
    FOR i := 1 TO n - 1 DO
      j := i; schimb := TRUE;
      WHILE (j > 0) & schimb DO
        x := poz[ol[j - 1]]; y := poz[ol[j]];
        IF oa[j - 1] > 0 THEN schimb := x - y > 0 ELSE schimb := y - x > 0 END;
        IF schimb THEN
          t := ol[j]; ol[j] := ol[j - 1]; ol[j - 1] := t; t := oa[j]; oa[j] := oa[j - 1]; oa[j - 1] := t; DEC(j)
        END
      END
    END;
    RETURN n
  END Armura;

  PROCEDURE AddArmura(VAR d: ARRAY OF CHAR; tl, ta: INTEGER; minor: BOOLEAN);
    VAR ol, oa: ARRAY 7 OF INTEGER; n, i: INTEGER; diez, teor: BOOLEAN;
  BEGIN
    n := Armura(tl, ta, minor, ol, oa);
    IF n = 0 THEN T.Add(d, "Nu are alterații la armură.")
    ELSE
      diez := oa[0] > 0; teor := FALSE;
      FOR i := 0 TO n - 1 DO IF ABS(oa[i]) > 1 THEN teor := TRUE END END;
      IF teor THEN T.Add(d, "E o tonalitate teoretică (ar cere dublu-alterații); în practică se scrie enarmonic.")
      ELSE
        T.Add(d, "Are "); T.AddInt(d, n);
        IF n = 1 THEN IF diez THEN T.Add(d, " diez") ELSE T.Add(d, " bemol") END
        ELSIF diez THEN T.Add(d, " diezi") ELSE T.Add(d, " bemoli")
        END;
        T.Add(d, " la armură: "); AddLista(d, ol, oa, n); T.Add(d, ".")
      END
    END
  END AddArmura;

  (* inlocuieste toate aparitiile lui a cu b (String.replace) *)
  PROCEDURE Inloc*(VAR s: ARRAY OF CHAR; a, b: ARRAY OF CHAR);
    VAR r: ARRAY LT OF CHAR; i, n, m: INTEGER;
  BEGIN
    n := T.Len(s); m := T.Len(a); r[0] := 0X; i := 0;
    IF m > 0 THEN
      WHILE i < n DO
        IF T.IncepeLa(s, i, a) THEN T.Add(r, b); i := i + m ELSE T.AddCh(r, s[i]); INC(i) END
      END;
      T.Copy(r, s)
    END
  END Inloc;

  (* ---------- textul intrebarii ---------- *)

  PROCEDURE IncarcaFold*(cale: ARRAY OF CHAR): BOOLEAN;   (* fold.bin: toLowerCase(ROOT) + NFD fara semne diacritice, semn cu semn *)
    VAR f: Files.File; i, a, b, n: INTEGER;
  BEGIN
    f := Files.Open(cale);
    IF f # NIL THEN
      n := 0; Files.ReadBytes(f, fb, n);
      IF n = 131072 THEN
        FOR i := 0 TO 65535 DO a := fb[2 * i]; b := fb[2 * i + 1]; fold[i] := CHR(a * 256 + b) END; foldOk := TRUE
      END;
      Files.Close(f)
    END;
    RETURN foldOk
  END IncarcaFold;

  PROCEDURE FoldC(c: CHAR): CHAR;   (* 0X = dispare; FFFFX = ramane cum e (se desface in mai multe semne) *)
    VAR r: CHAR;
  BEGIN
    IF foldOk THEN r := fold[ORD(c)]; IF ORD(r) = 0FFFFH THEN r := T.Mic(c) END
    ELSE r := T.Fold(T.Mic(c))
    END;
    RETURN r
  END FoldC;

  PROCEDURE Fold*(s: ARRAY OF CHAR; VAR d: ARRAY OF CHAR);   (* Teorie.fold *)
    VAR i, k, n: INTEGER; c: CHAR; sp: BOOLEAN;
  BEGIN
    n := T.Len(s); k := 0; sp := FALSE;
    FOR i := 0 TO n - 1 DO
      c := FoldC(s[i]);
      IF ORD(c) = 266FH THEN c := "#" ELSIF ORD(c) = 266DH THEN c := "b" END;
      IF (ORD(c) = 201EH) OR (ORD(c) = 201DH) OR (c = 22X) OR (c = "?") OR (c = "!") OR (c = ".") OR (c = ",") OR (c = ";")
        OR (c = ":") OR (c = "(") OR (c = ")") THEN c := " " END;
      IF c # 0X THEN
        IF T.Spatiu(c) THEN sp := TRUE
        ELSE
          IF sp & (k > 0) & (k < LEN(d) - 1) THEN d[k] := " "; INC(k) END;
          sp := FALSE;
          IF k < LEN(d) - 1 THEN d[k] := c; INC(k) END
        END
      END
    END;
    d[k] := 0X;
    T.Trim(d)   (* trim scoate si alte semne <= " " *)
  END Fold;

  PROCEDURE Az(c: CHAR): BOOLEAN;
  BEGIN RETURN (c >= "a") & (c <= "z")
  END Az;

  PROCEDURE Dig(c: CHAR): BOOLEAN;
  BEGIN RETURN (c >= "0") & (c <= "9")
  END Dig;

  PROCEDURE W(c: CHAR): BOOLEAN;   (* semn de cuvant in Java: a-z A-Z _ 0-9 *)
  BEGIN RETURN Az(c) OR (c >= "A") & (c <= "Z") OR Dig(c) OR (c = "_")
  END W;

  PROCEDURE At*(VAR s: ARRAY OF CHAR; i: INTEGER): CHAR;
    VAR c: CHAR;
  BEGIN IF (i >= 0) & (i < LEN(s)) THEN c := s[i] ELSE c := 0X END; RETURN c
  END At;

  PROCEDURE Lit*(VAR s: ARRAY OF CHAR; i: INTEGER; p: ARRAY OF CHAR): INTEGER;   (* p la i? capatul, altfel -1 *)
    VAR r: INTEGER;
  BEGIN IF T.IncepeLa(s, i, p) THEN r := i + T.Len(p) ELSE r := -1 END; RETURN r
  END Lit;

  PROCEDURE Sp(VAR s: ARRAY OF CHAR; i: INTEGER): INTEGER;   (* sare spatiile *)
  BEGIN WHILE T.Spatiu(At(s, i)) & (At(s, i) # 0X) DO INC(i) END; RETURN i
  END Sp;

  PROCEDURE Sp1*(VAR s: ARRAY OF CHAR; i: INTEGER): INTEGER;   (* unul sau mai multe spatii (lacom): capatul sau -1 *)
    VAR j: INTEGER;
  BEGIN j := Sp(s, i); IF j = i THEN j := -1 END; RETURN j
  END Sp1;

  PROCEDURE LitNota(VAR s: ARRAY OF CHAR; i: INTEGER; VAR l, e: INTEGER): BOOLEAN;   (* (do|re|mi|fa|sol|la|si) *)

  BEGIN
    l := -1; e := -1;
    IF Lit(s, i, "do") >= 0 THEN l := 0 ELSIF Lit(s, i, "re") >= 0 THEN l := 1 ELSIF Lit(s, i, "mi") >= 0 THEN l := 2
    ELSIF Lit(s, i, "fa") >= 0 THEN l := 3 ELSIF Lit(s, i, "sol") >= 0 THEN l := 4 ELSIF Lit(s, i, "la") >= 0 THEN l := 5
    ELSIF Lit(s, i, "si") >= 0 THEN l := 6
    END;
    IF l = 4 THEN e := i + 3 ELSIF l >= 0 THEN e := i + 2 END;
    RETURN l >= 0
  END LitNota;

  (* alteratia a k-a, in ordinea din expresie: dublu diez, dublu bemol, diez, bemol (cu spatii inainte), ##, #, bb, b, nimic;
     capatul ei sau -1 *)
  PROCEDURE AltK(VAR s: ARRAY OF CHAR; i, k: INTEGER; VAR alt: INTEGER): INTEGER;
    VAR j, r: INTEGER;
  BEGIN
    r := -1; alt := 0;
    IF k = 0 THEN j := Lit(s, Sp(s, i), "dublu"); IF j >= 0 THEN r := Lit(s, Sp(s, j), "diez"); alt := 2 END
    ELSIF k = 1 THEN j := Lit(s, Sp(s, i), "dublu"); IF j >= 0 THEN r := Lit(s, Sp(s, j), "bemol"); alt := -2 END
    ELSIF k = 2 THEN r := Lit(s, Sp(s, i), "diez"); alt := 1
    ELSIF k = 3 THEN r := Lit(s, Sp(s, i), "bemol"); alt := -1
    ELSIF k = 4 THEN r := Lit(s, i, "##"); alt := 2
    ELSIF k = 5 THEN r := Lit(s, i, "#"); alt := 1
    ELSIF k = 6 THEN r := Lit(s, i, "bb"); alt := -2
    ELSIF k = 7 THEN r := Lit(s, i, "b"); alt := -1
    ELSE r := i; alt := 0
    END;
    RETURN r
  END AltK;

  (* NOTA la i: candidatul c (0, 1, ...) in ordinea incercarilor; capatul sau -1 cand nu mai sunt. Pune nLit, nAlt. *)
  PROCEDURE Nota*(VAR s: ARRAY OF CHAR; i, c: INTEGER): INTEGER;
    VAR l, e, k, r, a, x: INTEGER; ch: CHAR;
  BEGIN
    r := -1;
    IF LitNota(s, i, l, e) THEN
      k := 0;
      WHILE (k <= 8) & (r < 0) DO
        x := AltK(s, e, k, a);
        IF x >= 0 THEN
          ch := At(s, x);
          IF ~(Az(ch) OR Dig(ch) OR (ch = "#")) THEN
            IF c = 0 THEN r := x; nLit := l; nAlt := a ELSE DEC(c) END
          END
        END;
        INC(k)
      END
    END;
    RETURN r
  END Nota;

  (* NOTA_OCT: nota, alteratia, un spatiu poate, octava (cifra, poate cu minus); fara a-z sau # dupa; candidatul c; pune nLit, nAlt si oct (4 daca lipseste) *)
  PROCEDURE NotaOct(VAR s: ARRAY OF CHAR; i, c: INTEGER; VAR oct: INTEGER): INTEGER;
    VAR l, e, k, r, a, x, sp, o, y, z: INTEGER; ch: CHAR;
  BEGIN
    r := -1;
    IF LitNota(s, i, l, e) THEN
      k := 0;
      WHILE (k <= 8) & (r < 0) DO
        x := AltK(s, e, k, a);
        IF x >= 0 THEN
          sp := 0;
          WHILE (sp <= 1) & (r < 0) DO
            y := -1;
            IF sp = 0 THEN IF T.Spatiu(At(s, x)) & (At(s, x) # 0X) THEN y := x + 1 END ELSE y := x END;
            IF y >= 0 THEN
              o := 0;
              WHILE (o <= 2) & (r < 0) DO
                z := -1;
                IF (o = 0) & (At(s, y) = "-") & Dig(At(s, y + 1)) THEN z := y + 2
                ELSIF (o = 1) & Dig(At(s, y)) THEN z := y + 1
                ELSIF o = 2 THEN z := y
                END;
                IF z >= 0 THEN
                  ch := At(s, z);
                  IF ~(Az(ch) OR (ch = "#")) THEN
                    IF c = 0 THEN
                      r := z; nLit := l; nAlt := a;
                      IF o = 0 THEN oct := -(ORD(At(s, y + 1)) - ORD("0")) ELSIF o = 1 THEN oct := ORD(At(s, y)) - ORD("0") ELSE oct := 4 END
                    ELSE DEC(c)
                    END
                  END
                END;
                INC(o)
              END
            END;
            INC(sp)
          END
        END;
        INC(k)
      END
    END;
    RETURN r
  END NotaOct;

  PROCEDURE Urmeaza*(r0: ARRAY OF CHAR; gama: BOOLEAN): INTEGER;   (* urmeaza(rest, CUV_GAMA / CUV_ACORD): indicele sau -1 *)
    VAR r, i, n: INTEGER; p: ARRAY 64 OF CHAR; rest: ARRAY LQ OF CHAR;
  BEGIN
    T.Copy(r0, rest); T.Trim(rest); r := -1; i := 0;
    IF gama THEN n := ncg ELSE n := nca END;
    WHILE (r < 0) & (i < n) DO
      IF gama THEN T.Copy(cgK[i], p) ELSE T.Copy(caK[i], p) END;
      IF T.Eq(rest, p) THEN r := i ELSE T.AddCh(p, " "); IF T.Incepe(rest, p) THEN r := i END END;
      INC(i)
    END;
    RETURN r
  END Urmeaza;

  PROCEDURE Are(VAR t: ARRAY OF CHAR; a: ARRAY OF CHAR): BOOLEAN;
  BEGIN RETURN T.Contine(t, a)
  END Are;

  (* ---------- raspunsurile ---------- *)

  PROCEDURE AcordRasp*(rl, ra, a: INTEGER);
    VAR nl, na: ARRAY 6 OF INTEGER; i, b, t0: INTEGER; iv: ARRAY 64 OF CHAR;
  BEGIN
    Scrie(rl, ra, aSemi[a], aLit[a], aN[a], FALSE, nl, na);
    txt := "Acordul de "; AddNume(txt, rl, ra); T.Add(txt, " "); T.Add(txt, aNume[a]); T.Add(txt, " (");
    AddSimbol(txt, rl, ra); T.Add(txt, aSuf[a]); T.Add(txt, ") are notele "); AddLista(txt, nl, na, aN[a]);
    T.Add(txt, ": fundamentala, apoi ");
    FOR i := 1 TO aN[a] - 1 DO
      IF i > 1 THEN IF i = aN[a] - 1 THEN T.Add(txt, " și ") ELSE T.Add(txt, ", ") END END;
      iv := ""; AddInterval(iv, rl, ra, nl[i], na[i]);
      IF aSemi[a][i] >= 12 THEN Inloc(iv, "secundă", "nonă") END;
      T.Add(txt, iv)
    END;
    T.Add(txt, " deasupra ei.");
    nev := 0; b := MidiRad(rl, ra);
    FOR i := 0 TO aN[a] - 1 DO Ev(b + aSemi[a][i], i * 5000, 5000, 0) END;
    t0 := aN[a] * 5000 + 2500;
    FOR i := 0 TO aN[a] - 1 DO Ev(b + aSemi[a][i], t0, 30000, 1) END;
    Ev(b - 12, t0, 30000, 2)
  END AcordRasp;

  PROCEDURE GamaSunet(rl, ra, g, t0: INTEGER);
    VAR b, k, i: INTEGER;
  BEGIN
    b := MidiRad(rl, ra); k := 0;
    FOR i := 0 TO gN[g] - 1 DO Ev(b + gSemi[g][i], t0 + 5000 * k, 5000, 0); INC(k) END;
    Ev(b + 12, t0 + 5000 * k, 15000, 0);
    Ev(b - 12, t0, 5000 * k + 15000, 2)
  END GamaSunet;

  PROCEDURE Rom*(i: INTEGER; mare: BOOLEAN; VAR s: ARRAY OF CHAR);
  BEGIN
    IF i = 0 THEN s := "I" ELSIF i = 1 THEN s := "II" ELSIF i = 2 THEN s := "III" ELSIF i = 3 THEN s := "IV"
    ELSIF i = 4 THEN s := "V" ELSIF i = 5 THEN s := "VI" ELSE s := "VII" END;
    IF ~mare THEN T.MicS(s) END
  END Rom;

  PROCEDURE GamaRasp*(rl, ra, g: INTEGER);
    VAR nl, na: ARRAY 12 OF INTEGER; i, d, t3, t5, ul, ua: INTEGER; minor: BOOLEAN; tip, nr: ARRAY 16 OF CHAR;
  BEGIN
    Scrie(rl, ra, gSemi[g], gLit[g], gN[g], gCrom[g], nl, na);
    txt := "Gama "; AddNume(txt, rl, ra); T.Add(txt, " "); T.Add(txt, gNume[g]); T.Add(txt, " are notele ");
    AddLista(txt, nl, na, gN[g]); T.Add(txt, " (pașii: ");
    FOR i := 0 TO gN[g] - 1 DO
      IF i + 1 < gN[g] THEN d := gSemi[g][i + 1] - gSemi[g][i] ELSE d := 12 - gSemi[g][i] END;
      IF i > 0 THEN T.Add(txt, " ") END;
      IF d = 1 THEN T.Add(txt, "S") ELSIF d = 2 THEN T.Add(txt, "T") ELSIF d = 3 THEN T.Add(txt, "T+S") ELSE T.AddInt(txt, d); T.Add(txt, "S") END
    END;
    T.Add(txt, ").");
    IF (g = 0) OR (g = 1) THEN
      minor := g = 1;
      T.Add(txt, " "); AddArmura(txt, rl, ra, minor);
      IF minor THEN Sus(rl, ra, 2, 3, ul, ua) ELSE Sus(rl, ra, 5, 9, ul, ua) END;
      T.Add(txt, " Relativa: "); AddNume(txt, ul, ua); IF minor THEN T.Add(txt, " major.") ELSE T.Add(txt, " minor.") END
    END;
    IF gL7[g] THEN
      T.Add(txt, " Acordurile pe trepte: ");
      FOR i := 0 TO 6 DO
        t3 := Semi(nl[i], na[i], nl[(i + 2) MOD 7], na[(i + 2) MOD 7]); t5 := Semi(nl[i], na[i], nl[(i + 4) MOD 7], na[(i + 4) MOD 7]);
        IF (t3 = 4) & (t5 = 7) THEN tip := "major" ELSIF (t3 = 3) & (t5 = 7) THEN tip := "minor" ELSIF (t3 = 3) & (t5 = 6) THEN tip := "diminuat"
        ELSIF (t3 = 4) & (t5 = 8) THEN tip := "mărit" ELSE tip := "?" END;
        Rom(i, T.Eq(tip, "major") OR T.Eq(tip, "mărit"), nr);
        IF T.Eq(tip, "diminuat") THEN T.Add(nr, "°") END;
        IF T.Eq(tip, "mărit") THEN T.Add(nr, "+") END;
        IF i > 0 THEN T.Add(txt, ", ") END;
        T.Add(txt, nr); T.Add(txt, " "); AddNume(txt, nl[i], na[i]); T.Add(txt, " "); T.Add(txt, tip)
      END;
      T.Add(txt, ".")
    END;
    nev := 0; GamaSunet(rl, ra, g, 0)
  END GamaRasp;


  PROCEDURE IntervalRasp(al, aa, bl, ba: INTEGER);
    VAR s, m1, m2: INTEGER;
  BEGIN
    s := Semi(al, aa, bl, ba);
    txt := "De la "; AddNume(txt, al, aa); T.Add(txt, " în sus la "); AddNume(txt, bl, ba); T.Add(txt, " e o ");
    AddInterval(txt, al, aa, bl, ba); T.Add(txt, " ("); T.AddInt(txt, s); T.Add(txt, " semiton"); IF s # 1 THEN T.Add(txt, "uri") END;
    IF s = 6 THEN T.Add(txt, ", tritonul — jumătate de octavă") END;
    T.Add(txt, "). În jos, de la "); AddNume(txt, bl, ba); T.Add(txt, " la "); AddNume(txt, al, aa); T.Add(txt, ", e ");
    AddInterval(txt, bl, ba, al, aa); T.Add(txt, " ("); T.AddInt(txt, (12 - s) MOD 12); T.Add(txt, " semitonuri).");
    nev := 0; m1 := MidiRad(al, aa); IF s = 0 THEN m2 := m1 + 12 ELSE m2 := m1 + s END;
    Ev(m1, 0, 10000, 0); Ev(m2, 10000, 10000, 0); Ev(m1, 22000, 20000, 1); Ev(m2, 22000, 20000, 1)
  END IntervalRasp;

  PROCEDURE Cerc;
    VAR i, m: INTEGER;
  BEGIN
    txt := "Cercul cvintelor: urcând din cvintă în cvintă — Do (0), Sol (1#), Re (2#), La (3#), Mi (4#), Si (5#), Fa diez (6#), Do diez (7#)";
    T.Add(txt, "; coborând — Fa (1b), Si bemol (2b), Mi bemol (3b), La bemol (4b), Re bemol (5b), Sol bemol (6b), Do bemol (7b)");
    T.Add(txt, ". Fiecare pas adaugă o alterație la armură; după 12 cvinte te întorci (aproape) la Do — ");
    T.Add(txt, "cu cvinte pure ar rămâne o diferență mică, virgula pitagoreică, de aceea pianul folosește temperamentul egal. ");
    T.Add(txt, "Relativele minore stau în același loc: La, Mi, Si, Fa diez… sub Do, Sol, Re, La…");
    nev := 0; m := 48;
    FOR i := 0 TO 12 DO
      Ev(m, i * 6000, 5500, 2); Ev(m + 12, i * 6000, 5500, 1); Ev(m + 16, i * 6000, 5500, 1); Ev(m + 19, i * 6000, 5500, 1);
      m := m + 7; IF m > 54 THEN m := m - 12 END
    END
  END Cerc;

  (* tipurile scurte de acord care pot fi „la 7 ani” *)
  PROCEDURE Scurt(VAR k: ARRAY OF CHAR): BOOLEAN;
  BEGIN RETURN T.Eq(k, "7") OR T.Eq(k, "9") OR T.Eq(k, "6") OR T.Eq(k, "m") OR T.Eq(k, "sus") OR T.Eq(k, "dim") OR T.Eq(k, "aug")
  END Scurt;

  PROCEDURE CheieInainte(VAR s: ARRAY OF CHAR): BOOLEAN;   (* se termina in gama, gamei, scara, tonalitatea, tonalitate, nota, notei, nota de, modul, in (poate + „ de”) *)
    VAR r: BOOLEAN; i: INTEGER; w: ARRAY 16 OF CHAR; x: ARRAY 20 OF CHAR;
  BEGIN
    r := FALSE;
    FOR i := 0 TO 9 DO
      CASE i OF 0: w := "gama" | 1: w := "gamei" | 2: w := "scara" | 3: w := "tonalitatea" | 4: w := "tonalitate" | 5: w := "nota"
      | 6: w := "notei" | 7: w := "nota de" | 8: w := "modul" | 9: w := "in" END;
      T.Copy(w, x); T.Add(x, " de");
      IF T.Sfarsit(s, w) OR T.Sfarsit(s, x) THEN r := TRUE END
    END;
    RETURN r
  END CheieInainte;

  PROCEDURE Raspunde*(original: ARRAY OF CHAR): BOOLEAN;   (* raspunsul calculat in txt + evenimente; FALSE = nu e teorie *)
    VAR t, inainte, dupa, o2: ARRAY LQ OF CHAR; r, gasit, minor, vreaAcord, vreaGama, vreaArmura, cheie: BOOLEAN;
      s, j, k, q, e1, e2, c1, n, l1, a1, l2, a2, rl, ra, oct, midi, ga, ac, mi, ss, se, acc, suf, i, t0, x: INTEGER;
      ch: CHAR; w: ARRAY 64 OF CHAR; at: ARRAY 512 OF CHAR; gt: ARRAY LT OF CHAR;
      gm, gtt, gd, gv: ARRAY 64 OF INTEGER; gn: INTEGER;
  BEGIN
    Fold(original, t); r := FALSE; gasit := FALSE; nev := 0; txt[0] := 0X; n := T.Len(t);
    IF Are(t, "cercul cvintelor") OR Are(t, "cercul de cvinte") OR Are(t, "cercul quintelor") THEN Cerc; r := TRUE; gasit := TRUE END;
    (* interval: intre|dintre NOTA si|cu NOTA *)
    s := 0;
    WHILE ~gasit & (s < n) DO
      k := 0;
      WHILE ~gasit & (k < 2) DO
        IF k = 0 THEN q := Lit(t, s, "intre") ELSE q := Lit(t, s, "dintre") END;
        IF q >= 0 THEN
          q := Sp1(t, q);
          IF q >= 0 THEN
            c1 := 0; e1 := Nota(t, q, 0);
            WHILE ~gasit & (e1 >= 0) DO
              l1 := nLit; a1 := nAlt;
              j := Sp1(t, e1);
              IF j >= 0 THEN
                x := Lit(t, j, "si"); IF x < 0 THEN x := Lit(t, j, "cu") END;
                IF x >= 0 THEN x := Sp1(t, x); IF x >= 0 THEN e2 := Nota(t, x, 0); IF e2 >= 0 THEN gasit := TRUE; l2 := nLit; a2 := nAlt END END END
              END;
              INC(c1); IF ~gasit THEN e1 := Nota(t, q, c1) END
            END
          END
        END;
        INC(k)
      END;
      INC(s)
    END;
    (* de la NOTA [pana] la NOTA *)
    s := 0;
    WHILE ~gasit & ~r & (s < n) DO
      q := Lit(t, s, "de la");
      IF q >= 0 THEN q := Sp1(t, q) END;
      IF q >= 0 THEN
        c1 := 0; e1 := Nota(t, q, 0);
        WHILE ~gasit & (e1 >= 0) DO
          l1 := nLit; a1 := nAlt;
          j := Sp1(t, e1);
          IF j >= 0 THEN
            k := 0;
            WHILE ~gasit & (k < 2) DO
              x := j;
              IF k = 0 THEN x := Lit(t, j, "pana"); IF x >= 0 THEN x := Sp1(t, x) END END;
              IF x >= 0 THEN
                x := Lit(t, x, "la");
                IF x >= 0 THEN x := Sp1(t, x); IF x >= 0 THEN e2 := Nota(t, x, 0); IF e2 >= 0 THEN gasit := TRUE; l2 := nLit; a2 := nAlt END END END
              END;
              INC(k)
            END
          END;
          INC(c1); IF ~gasit THEN e1 := Nota(t, q, c1) END
        END
      END;
      INC(s)
    END;
    IF gasit & ~r THEN IntervalRasp(l1, a1, l2, a2); r := TRUE END;

    (* relativa: „relativ…” [a] [lui|de|din] [gamei|tonalitatii] NOTA [major…|minor…] *)
    s := 0;
    WHILE ~r & (s < n) DO
      q := Lit(t, s, "relativ");
      IF q >= 0 THEN WHILE W(At(t, q)) DO INC(q) END; q := Sp1(t, q) END;
      IF q >= 0 THEN
        i := 0;
        WHILE ~r & (i < 2 * 4 * 3) DO
          x := q;
          IF i DIV 12 = 0 THEN x := Lit(t, x, "a"); IF x >= 0 THEN x := Sp1(t, x) END END;
          IF x >= 0 THEN
            k := i DIV 3 MOD 4;
            IF k = 0 THEN x := Lit(t, x, "lui") ELSIF k = 1 THEN x := Lit(t, x, "de") ELSIF k = 2 THEN x := Lit(t, x, "din") END;
            IF (x >= 0) & (k < 3) THEN x := Sp1(t, x) END
          END;
          IF x >= 0 THEN
            k := i MOD 3;
            IF k = 0 THEN x := Lit(t, x, "gamei") ELSIF k = 1 THEN x := Lit(t, x, "tonalitatii") END;
            IF (x >= 0) & (k < 2) THEN x := Sp1(t, x) END
          END;
          IF x >= 0 THEN
            e1 := Nota(t, x, 0);
            IF e1 >= 0 THEN
              l1 := nLit; a1 := nAlt; j := Sp(t, e1); minor := Lit(t, j, "minor") >= 0;
              IF minor THEN Sus(l1, a1, 2, 3, rl, ra) ELSE Sus(l1, a1, 5, 9, rl, ra) END;
              at := ""; AddArmura(at, l1, a1, minor);
              Inloc(at, "Are ", ""); Inloc(at, "Nu are alterații la armură.", "nicio alterație"); Inloc(at, ".", "");
              txt := "Relativa lui "; AddNume(txt, l1, a1); IF minor THEN T.Add(txt, " minor") ELSE T.Add(txt, " major") END;
              T.Add(txt, " este "); AddNume(txt, rl, ra); IF minor THEN T.Add(txt, " major") ELSE T.Add(txt, " minor") END;
              T.Add(txt, ": au aceeași armură ("); T.Add(txt, at); T.Add(txt, ").");
              nev := 0;
              IF minor THEN GamaSunet(l1, a1, 1, 0); GamaSunet(rl, ra, 0, 90000) ELSE GamaSunet(l1, a1, 0, 0); GamaSunet(rl, ra, 1, 90000) END;
              r := TRUE
            END
          END;
          INC(i)
        END
      END;
      INC(s)
    END;

    (* frecventa: frecvent…|hz|herti, apoi oricate din a/lui/notei/pentru/la, apoi NOTA_OCT *)
    s := 0;
    WHILE ~r & (s < n) DO
      k := 0;
      WHILE ~r & (k < 3) DO
        IF k = 0 THEN q := Lit(t, s, "frecvent"); IF q >= 0 THEN WHILE W(At(t, q)) DO INC(q) END END
        ELSIF k = 1 THEN q := Lit(t, s, "hz") ELSE q := Lit(t, s, "herti") END;
        IF q >= 0 THEN q := Sp1(t, q) END;
        IF q >= 0 THEN
          (* lantul repetarilor: gm[0] = q, gm[1] … *)
          gn := 0; gm[0] := q; x := q;
          REPEAT
            j := -1;
            IF Lit(t, x, "a") >= 0 THEN j := Sp1(t, Lit(t, x, "a")) END;
            IF (j < 0) & (Lit(t, x, "lui") >= 0) THEN j := Sp1(t, Lit(t, x, "lui")) END;
            IF (j < 0) & (Lit(t, x, "notei") >= 0) THEN j := Sp1(t, Lit(t, x, "notei")) END;
            IF (j < 0) & (Lit(t, x, "pentru") >= 0) THEN j := Sp1(t, Lit(t, x, "pentru")) END;
            IF (j < 0) & (Lit(t, x, "la") >= 0) THEN j := Sp1(t, Lit(t, x, "la")) END;
            IF (j >= 0) & (gn < 63) THEN INC(gn); gm[gn] := j; x := j END
          UNTIL (j < 0) OR (gn >= 63);
          i := gn;
          WHILE ~r & (i >= 0) DO
            e1 := NotaOct(t, gm[i], 0, oct);
            IF e1 >= 0 THEN
              l1 := nLit; a1 := nAlt;
              midi := 12 * (oct + 1) + Pc(l1, a1);
              IF (l1 = 0) & (a1 < 0) THEN midi := midi + 12 END;
              IF (l1 = 6) & (a1 > 0) THEN midi := midi - 12 END;
              txt := ""; AddNume(txt, l1, a1); T.AddInt(txt, oct); T.Add(txt, " are ");
              IF (midi >= -108) & (midi <= 131) THEN AddZec(txt, f2[midi + 108], 2) ELSE T.Add(txt, "?") END;
              T.Add(txt, " Hz în acordajul temperat egal (La4 = 440 Hz). Octava de sus are frecvența dublă, cea de jos jumătate.");
              nev := 0; Ev(midi, 0, 20000, 0); r := TRUE
            END;
            DEC(i)
          END
        END;
        INC(k)
      END;
      INC(s)
    END;

    IF ~r THEN
      vreaAcord := Are(t, "acord");
      vreaGama := Are(t, "gama") OR Are(t, "game") OR Are(t, "scara") OR Are(t, "tonalitat") OR Are(t, "modul") OR Are(t, "mod ");
      vreaArmura := Are(t, "armur") OR Are(t, "alteratii") OR Are(t, "cati diezi") OR Are(t, "cati bemoli") OR Are(t, "ce diezi") OR Are(t, "ce bemoli");
      (* simbol de acord, pe textul original: litera A..G (fara litera inainte), # sau b, sufixul (maj7 m7b5 dim7 sus2 sus4 dim aug m7 m 7 9 6), fara litera/cifra/# dupa *)
      T.Copy(original, o2); n := T.Len(o2); ss := -1; s := 0;
      WHILE (ss < 0) & (s < n) DO
        ch := o2[s];
        IF (ch >= "A") & (ch <= "G") & ((s = 0) OR ~((At(o2, s - 1) >= "A") & (At(o2, s - 1) <= "Z") OR (At(o2, s - 1) >= "a") & (At(o2, s - 1) <= "z"))) THEN
          k := 0;
          WHILE (ss < 0) & (k < 2) DO
            x := -1;
            IF (k = 0) & ((At(o2, s + 1) = "#") OR (At(o2, s + 1) = "b")) THEN x := s + 2 ELSIF k = 1 THEN x := s + 1 END;
            IF x >= 0 THEN
              j := 0;
              WHILE (ss < 0) & (j <= 12) DO
                CASE j OF 0: w := "maj7" | 1: w := "m7b5" | 2: w := "dim7" | 3: w := "sus2" | 4: w := "sus4" | 5: w := "dim" | 6: w := "aug"
                | 7: w := "m7" | 8: w := "m" | 9: w := "7" | 10: w := "9" | 11: w := "6" | 12: w := "" END;
                q := Lit(o2, x, w);
                IF q >= 0 THEN
                  ch := At(o2, q);
                  IF ~((ch >= "A") & (ch <= "Z") OR (ch >= "a") & (ch <= "z") OR Dig(ch) OR (ch = "#")) THEN
                    ss := s; se := q; acc := k; suf := j
                  END
                END;
                INC(j)
              END
            END;
            INC(k)
          END
        END;
        INC(s)
      END;
      IF ss >= 0 THEN
        T.Copy(original, inainte); T.Trim(inainte);
        IF vreaAcord OR (T.Len(inainte) = se - ss) OR Are(t, "canta") OR Are(t, "ce note") THEN
          l1 := ORD(o2[ss]) - ORD("C"); IF l1 < 0 THEN l1 := l1 + 7 END;   (* CDEFGAB *)
          a1 := 0; IF acc = 0 THEN IF o2[ss + 1] = "#" THEN a1 := 1 ELSE a1 := -1 END END;
          CASE suf OF 0: w := "maj7" | 1: w := "m7b5" | 2: w := "dim7" | 3: w := "sus2" | 4: w := "sus4" | 5: w := "dim" | 6: w := "aug"
          | 7: w := "m7" | 8: w := "minor" | 9: w := "7" | 10: w := "9" | 11: w := "6" | 12: w := "major" END;
          AcordRasp(l1, a1, Acord(w)); r := TRUE
        END
      END
    END;

    (* nota + tip: NOTA la inceput sau dupa un spatiu, cautat din nou dupa fiecare potrivire *)
    s := 0; n := T.Len(t);
    WHILE ~r & (s < n) DO
      e1 := -1;
      IF s = 0 THEN e1 := Nota(t, 0, 0) END;
      IF (e1 < 0) & T.Spatiu(t[s]) THEN e1 := Nota(t, s + 1, 0) END;
      IF e1 < 0 THEN INC(s)
      ELSE
        l1 := nLit; a1 := nAlt;
        T.Sub(t, 0, s, inainte); T.Trim(inainte); T.Sub(t, e1, n, dupa);
        ga := Urmeaza(dupa, TRUE); ac := Urmeaza(dupa, FALSE);
        mi := -1; i := 0;
        WHILE (mi < 0) & (i < ncg) DO
          T.Copy(cgK[i], w);
          IF T.Sfarsit(inainte, w) THEN mi := i END;
          T.Copy(cgK[i], w); T.Add(w, " de"); IF T.Sfarsit(inainte, w) THEN mi := i END;
          T.Copy(cgK[i], w); T.Add(w, " pe"); IF T.Sfarsit(inainte, w) THEN mi := i END;
          T.Copy(cgK[i], w); T.Add(w, " din"); IF T.Sfarsit(inainte, w) THEN mi := i END;
          INC(i)
        END;
        cheie := T.Sfarsit(inainte, "acord") OR T.Sfarsit(inainte, "acordul") OR T.Sfarsit(inainte, "acordul de") OR T.Sfarsit(inainte, "acord de")
          OR CheieInainte(inainte) OR T.Sfarsit(inainte, "canta") OR T.Sfarsit(inainte, "cantami");
        T.Copy(dupa, at); T.Trim(at);
        IF (ga < 0) & (ac < 0) & (mi < 0) & ~cheie THEN (* „la”, „si”, „mi” obisnuite *)
        ELSIF (ga < 0) & (mi < 0) & ~cheie & ~vreaAcord & (ac >= 0) & Scurt(caK[ac]) & ~((inainte[0] = 0X) & T.Eq(at, caK[ac])) THEN (* „la 7 ani” *)
        ELSIF vreaArmura THEN
          minor := (ga >= 0) & ~T.Eq(cgV[ga], "major");
          at := ""; AddArmura(at, l1, a1, minor);
          txt := ""; AddNume(txt, l1, a1); IF minor THEN T.Add(txt, " minor ") ELSE T.Add(txt, " major ") END;
          at[0] := T.Mic(at[0]); T.Add(txt, at);
          nev := 0; IF minor THEN GamaSunet(l1, a1, 1, 0) ELSE GamaSunet(l1, a1, 0, 0) END;
          r := TRUE
        ELSIF vreaAcord OR ~vreaGama & (ac >= 0) & (ga < 0) THEN
          IF ac < 0 THEN AcordRasp(l1, a1, 0) ELSE AcordRasp(l1, a1, Acord(caV[ac])) END; r := TRUE
        ELSE
          IF (mi >= 0) & (ga < 0) THEN ga := mi END;
          IF vreaGama OR (ga >= 0) & (ac < 0) OR (ga >= 0) & ~T.Eq(cgV[ga], "major") & ~T.Eq(cgV[ga], "minor") THEN
            IF ga < 0 THEN GamaRasp(l1, a1, 0) ELSE GamaRasp(l1, a1, Gama(cgV[ga])) END; r := TRUE
          ELSIF ga >= 0 THEN   (* „La minor” fara alt cuvant: si acordul, si gama *)
            GamaRasp(l1, a1, Gama(cgV[ga])); T.Copy(txt, gt);
            gn := nev; FOR i := 0 TO nev - 1 DO gm[i] := em[i]; gtt[i] := et[i]; gd[i] := ed[i]; gv[i] := ev[i] END;
            AcordRasp(l1, a1, Acord(cgV[ga]));
            T.AddCh(txt, 0AX); T.Add(txt, gt);
            t0 := 0; FOR i := 0 TO nev - 1 DO IF et[i] + ed[i] > t0 THEN t0 := et[i] + ed[i] END END;
            FOR i := 0 TO gn - 1 DO Ev(gm[i], gtt[i] + t0 + Bt, gd[i], gv[i]) END;
            r := TRUE
          ELSIF T.Sfarsit(inainte, "nota") OR T.Sfarsit(inainte, "notei") OR T.Sfarsit(inainte, "nota de") THEN
            midi := MidiRad(l1, a1);
            txt := ""; AddNume(txt, l1, a1); T.Add(txt, " ("); AddSimbol(txt, l1, a1); T.Add(txt, ") e treapta a ");
            T.AddInt(txt, l1 + 1); T.Add(txt, "-a din gama naturală");
            IF a1 # 0 THEN
              T.Add(txt, ", "); IF a1 > 0 THEN T.Add(txt, "urcată") ELSE T.Add(txt, "coborâtă") END;
              T.Add(txt, " cu "); T.AddInt(txt, ABS(a1)); T.Add(txt, " semiton"); IF ABS(a1) > 1 THEN T.Add(txt, "uri") END
            END;
            T.Add(txt, "; în octava a 4-a are "); AddZec(txt, f1[Pc(l1, a1)], 1); T.Add(txt, " Hz.");
            nev := 0; Ev(midi, 0, 20000, 0); r := TRUE
          ELSE AcordRasp(l1, a1, 0); r := TRUE
          END
        END;
        s := e1   (* cautarea urmatoare incepe unde s-a terminat potrivirea *)
      END
    END;
    RETURN r
  END Raspunde;

  (* primul acord / prima gama numita explicit in prima fraza a unui text, ca s-o cante *)
  PROCEDURE DinText*(text: ARRAY OF CHAR): BOOLEAN;
    VAR p, s, n, k, q, x, e, kw, ac, ga: INTEGER; t, u, dupa: ARRAY LQ OF CHAR; r: BOOLEAN;
  BEGIN
    p := T.Pos(". ", text, 0);
    IF p > 0 THEN T.Sub(text, 0, p, u) ELSE T.Copy(text, u) END;
    Fold(u, t); n := T.Len(t); r := FALSE; s := 0;
    WHILE ~r & (s < n) DO
      k := 0;
      WHILE ~r & (k < 4) DO
        IF k = 0 THEN q := Lit(t, s, "acordul") ELSIF k = 1 THEN q := Lit(t, s, "acord") ELSIF k = 2 THEN q := Lit(t, s, "gama") ELSE q := Lit(t, s, "scara") END;
        IF q >= 0 THEN q := Sp1(t, q) END;
        IF q >= 0 THEN
          x := Lit(t, q, "de"); IF x >= 0 THEN x := Sp1(t, x) END;
          e := -1; IF x >= 0 THEN e := Nota(t, x, 0) END;
          IF e < 0 THEN e := Nota(t, q, 0) END;
          IF e >= 0 THEN r := TRUE; kw := k; T.Sub(t, e, n, dupa) END
        END;
        INC(k)
      END;
      INC(s)
    END;
    IF r THEN
      IF kw <= 1 THEN ac := Urmeaza(dupa, FALSE); IF ac < 0 THEN AcordRasp(nLit, nAlt, 0) ELSE AcordRasp(nLit, nAlt, Acord(caV[ac])) END
      ELSE ga := Urmeaza(dupa, TRUE); IF ga < 0 THEN GamaRasp(nLit, nAlt, 0) ELSE GamaRasp(nLit, nAlt, Gama(cgV[ga])) END
      END
    END;
    RETURN r
  END DinText;

  (* fraze pentru memoria Eulei: acorduri si game pe toate cele 12 fundamentale *)
  PROCEDURE Fapte*;
    VAR rl, ra: ARRAY 14 OF INTEGER; i, c, g: INTEGER; nl, na: ARRAY 7 OF INTEGER; at, w: ARRAY 512 OF CHAR; minor: BOOLEAN;
  BEGIN
    rl[0] := 0; ra[0] := 0; rl[1] := 0; ra[1] := 1; rl[2] := 1; ra[2] := -1; rl[3] := 1; ra[3] := 0; rl[4] := 2; ra[4] := -1;
    rl[5] := 2; ra[5] := 0; rl[6] := 3; ra[6] := 0; rl[7] := 3; ra[7] := 1; rl[8] := 4; ra[8] := -1; rl[9] := 4; ra[9] := 0;
    rl[10] := 5; ra[10] := -1; rl[11] := 5; ra[11] := 0; rl[12] := 6; ra[12] := -1; rl[13] := 6; ra[13] := 0;
    fapt[0] := 0X;
    FOR i := 0 TO 13 DO
      FOR c := 0 TO 3 DO
        IF c = 0 THEN AcordRasp(rl[i], ra[i], Acord("major")) ELSIF c = 1 THEN AcordRasp(rl[i], ra[i], Acord("minor"))
        ELSIF c = 2 THEN AcordRasp(rl[i], ra[i], Acord("7")) ELSE AcordRasp(rl[i], ra[i], Acord("dim")) END;
        T.Add(fapt, txt); T.AddCh(fapt, 0AX); T.AddCh(fapt, 0AX)
      END;
      FOR g := 0 TO 1 DO
        minor := g = 1;
        Scrie(rl[i], ra[i], gSemi[g], gLit[0], 7, FALSE, nl, na);
        T.Add(fapt, "Gama "); AddNume(fapt, rl[i], ra[i]); IF minor THEN T.Add(fapt, " minor") ELSE T.Add(fapt, " major") END;
        T.Add(fapt, " are notele "); AddLista(fapt, nl, na, 7); T.Add(fapt, ". ");
        at := ""; AddArmura(at, rl[i], ra[i], minor);
        w := "Tonalitatea "; AddNume(w, rl[i], ra[i]); IF minor THEN T.Add(w, " minor are ") ELSE T.Add(w, " major are ") END;
        Inloc(at, "Are ", w);
        T.Add(fapt, at); T.AddCh(fapt, 0AX); T.AddCh(fapt, 0AX)
      END
    END;
    nev := 0
  END Fapte;

  (* ---------- tabelele ---------- *)

  PROCEDURE G(i: INTEGER; ch, nm: ARRAY OF CHAR; s0, s1, s2, s3, s4, s5, s6: INTEGER; n: INTEGER);
  BEGIN
    T.Copy(ch, gCheie[i]); T.Copy(nm, gNume[i]); gN[i] := n;
    gSemi[i][0] := s0; gSemi[i][1] := s1; gSemi[i][2] := s2; gSemi[i][3] := s3; gSemi[i][4] := s4; gSemi[i][5] := s5; gSemi[i][6] := s6;
    gLit[i][0] := 0; gLit[i][1] := 1; gLit[i][2] := 2; gLit[i][3] := 3; gLit[i][4] := 4; gLit[i][5] := 5; gLit[i][6] := 6;
    gL7[i] := TRUE; gCrom[i] := FALSE
  END G;

  PROCEDURE A(i: INTEGER; ch, nm, sf: ARRAY OF CHAR; n, s0, s1, s2, s3, s4, l0, l1, l2, l3, l4: INTEGER);
  BEGIN
    T.Copy(ch, aCheie[i]); T.Copy(nm, aNume[i]); T.Copy(sf, aSuf[i]); aN[i] := n;
    aSemi[i][0] := s0; aSemi[i][1] := s1; aSemi[i][2] := s2; aSemi[i][3] := s3; aSemi[i][4] := s4;
    aLit[i][0] := l0; aLit[i][1] := l1; aLit[i][2] := l2; aLit[i][3] := l3; aLit[i][4] := l4
  END A;

  PROCEDURE CG(k, v: ARRAY OF CHAR);
  BEGIN T.Copy(k, cgK[ncg]); T.Copy(v, cgV[ncg]); INC(ncg)
  END CG;

  PROCEDURE CA(k, v: ARRAY OF CHAR);
  BEGIN T.Copy(k, caK[nca]); T.Copy(v, caV[nca]); INC(nca)
  END CA;

  PROCEDURE Init;
    VAR i: INTEGER;
  BEGIN
    LIT[0] := "Do"; LIT[1] := "Re"; LIT[2] := "Mi"; LIT[3] := "Fa"; LIT[4] := "Sol"; LIT[5] := "La"; LIT[6] := "Si";
    LITEN := "CDEFGAB";
    PC[0] := 0; PC[1] := 2; PC[2] := 4; PC[3] := 5; PC[4] := 7; PC[5] := 9; PC[6] := 11;
    FOR i := 0 TO 6 DO REF[i] := PC[i] END;
    NUMAR[0] := "primă"; NUMAR[1] := "secundă"; NUMAR[2] := "terță"; NUMAR[3] := "cvartă"; NUMAR[4] := "cvintă"; NUMAR[5] := "sextă"; NUMAR[6] := "septimă";
    PERFECT[0] := TRUE; PERFECT[1] := FALSE; PERFECT[2] := FALSE; PERFECT[3] := TRUE; PERFECT[4] := TRUE; PERFECT[5] := FALSE; PERFECT[6] := FALSE;
    A(0, "major", "major", "", 3, 0, 4, 7, 0, 0, 0, 2, 4, 0, 0);
    A(1, "minor", "minor", "m", 3, 0, 3, 7, 0, 0, 0, 2, 4, 0, 0);
    A(2, "dim", "diminuat", "dim", 3, 0, 3, 6, 0, 0, 0, 2, 4, 0, 0);
    A(3, "aug", "mărit", "aug", 3, 0, 4, 8, 0, 0, 0, 2, 4, 0, 0);
    A(4, "sus2", "cu secundă (sus2)", "sus2", 3, 0, 2, 7, 0, 0, 0, 1, 4, 0, 0);
    A(5, "sus4", "cu cvartă (sus4)", "sus4", 3, 0, 5, 7, 0, 0, 0, 3, 4, 0, 0);
    A(6, "6", "cu sextă", "6", 4, 0, 4, 7, 9, 0, 0, 2, 4, 5, 0);
    A(7, "7", "de septimă (dominant)", "7", 4, 0, 4, 7, 10, 0, 0, 2, 4, 6, 0);
    A(8, "maj7", "major cu septimă mare", "maj7", 4, 0, 4, 7, 11, 0, 0, 2, 4, 6, 0);
    A(9, "m7", "minor cu septimă", "m7", 4, 0, 3, 7, 10, 0, 0, 2, 4, 6, 0);
    A(10, "m7b5", "semidiminuat", "m7b5", 4, 0, 3, 6, 10, 0, 0, 2, 4, 6, 0);
    A(11, "dim7", "diminuat cu septimă", "dim7", 4, 0, 3, 6, 9, 0, 0, 2, 4, 6, 0);
    A(12, "9", "de nonă", "9", 5, 0, 4, 7, 10, 14, 0, 2, 4, 6, 1);
    G(0, "major", "major", 0, 2, 4, 5, 7, 9, 11, 7);
    G(1, "minor", "minor natural", 0, 2, 3, 5, 7, 8, 10, 7);
    G(2, "armonic", "minor armonic", 0, 2, 3, 5, 7, 8, 11, 7);
    G(3, "melodic", "minor melodic (urcând)", 0, 2, 3, 5, 7, 9, 11, 7);
    G(4, "doric", "doric", 0, 2, 3, 5, 7, 9, 10, 7);
    G(5, "frigic", "frigic", 0, 1, 3, 5, 7, 8, 10, 7);
    G(6, "lidic", "lidic", 0, 2, 4, 6, 7, 9, 11, 7);
    G(7, "mixolidic", "mixolidic", 0, 2, 4, 5, 7, 9, 10, 7);
    G(8, "locric", "locric", 0, 1, 3, 5, 6, 8, 10, 7);
    G(9, "pentamaj", "pentatonică majoră", 0, 2, 4, 7, 9, 0, 0, 5);
    gLit[9][0] := 0; gLit[9][1] := 1; gLit[9][2] := 2; gLit[9][3] := 4; gLit[9][4] := 5; gL7[9] := FALSE;
    G(10, "pentamin", "pentatonică minoră", 0, 3, 5, 7, 10, 0, 0, 5);
    gLit[10][0] := 0; gLit[10][1] := 2; gLit[10][2] := 3; gLit[10][3] := 4; gLit[10][4] := 6; gL7[10] := FALSE;
    G(11, "blues", "blues", 0, 3, 5, 6, 7, 10, 0, 6);
    gLit[11][0] := 0; gLit[11][1] := 2; gLit[11][2] := 3; gLit[11][3] := 4; gLit[11][4] := 4; gLit[11][5] := 6; gL7[11] := FALSE;
    G(12, "romaneasca", "românească (doric cu cvarta mărită)", 0, 2, 3, 6, 7, 9, 10, 7);
    G(13, "orientala", "orientală (dublu armonică)", 0, 1, 4, 5, 7, 8, 11, 7);
    G(14, "cromatic", "cromatică", 0, 1, 2, 3, 4, 5, 6, 12);
    FOR i := 0 TO 11 DO gSemi[14][i] := i END; gL7[14] := FALSE; gCrom[14] := TRUE;
    nca := 0;
    CA("diminuat cu septima", "dim7"); CA("dim7", "dim7"); CA("semidiminuat", "m7b5"); CA("m7b5", "m7b5");
    CA("minor cu septima", "m7"); CA("minor de septima", "m7"); CA("minor 7", "m7"); CA("m7", "m7");
    CA("major cu septima mare", "maj7"); CA("cu septima mare", "maj7"); CA("maj7", "maj7"); CA("major 7", "maj7");
    CA("de septima", "7"); CA("cu septima", "7"); CA("dominant", "7"); CA("7", "7");
    CA("de nona", "9"); CA("cu nona", "9"); CA("9", "9"); CA("cu sexta", "6"); CA("6", "6");
    CA("sus2", "sus2"); CA("cu secunda", "sus2"); CA("sus4", "sus4"); CA("cu cvarta", "sus4"); CA("sus", "sus4");
    CA("diminuat", "dim"); CA("dim", "dim"); CA("marit", "aug"); CA("augmentat", "aug"); CA("aug", "aug");
    CA("minor", "minor"); CA("m", "minor"); CA("major", "major");
    ncg := 0;
    CG("pentatonica majora", "pentamaj"); CG("pentatonic major", "pentamaj"); CG("pentatonica minora", "pentamin"); CG("pentatonic minor", "pentamin");
    CG("pentatonica", "pentamaj"); CG("pentatonic", "pentamaj");
    CG("minora armonica", "armonic"); CG("minor armonic", "armonic"); CG("armonica", "armonic"); CG("armonic", "armonic");
    CG("minora melodica", "melodic"); CG("minor melodic", "melodic"); CG("melodica", "melodic"); CG("melodic", "melodic");
    CG("minora naturala", "minor"); CG("minor natural", "minor"); CG("minora", "minor"); CG("minor", "minor"); CG("eolic", "minor"); CG("eoliana", "minor");
    CG("majora", "major"); CG("major", "major"); CG("ionic", "major"); CG("ionian", "major");
    CG("doric", "doric"); CG("doriana", "doric"); CG("frigic", "frigic"); CG("frigiana", "frigic"); CG("lidic", "lidic"); CG("lidiana", "lidic");
    CG("mixolidic", "mixolidic"); CG("mixolidiana", "mixolidic"); CG("locric", "locric"); CG("locriana", "locric");
    CG("blues", "blues"); CG("romaneasca", "romaneasca"); CG("doric acut", "romaneasca"); CG("orientala", "orientala");
    CG("dublu armonica", "orientala"); CG("araba", "orientala"); CG("cromatica", "cromatic"); CG("cromatic", "cromatic");
    foldOk := FALSE;
    f2[0] := 2; f2[1] := 2; f2[2] := 2; f2[3] := 2; f2[4] := 2; f2[5] := 2; 
    f2[6] := 2; f2[7] := 2; f2[8] := 3; f2[9] := 3; f2[10] := 3; f2[11] := 3; 
    f2[12] := 3; f2[13] := 3; f2[14] := 4; f2[15] := 4; f2[16] := 4; f2[17] := 4; 
    f2[18] := 5; f2[19] := 5; f2[20] := 5; f2[21] := 5; f2[22] := 6; f2[23] := 6; 
