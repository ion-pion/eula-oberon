  END Programe26;

  PROCEDURE Programe27*;   (* v2.7: primul joc in cub *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "cubicum:roller|Cub Roller");
    Strings.Append("Cub Roller: o bilă într-o țeavă colorată prin cubul Z₇, cu bifurcații, urcări și coborâri. ", c);
    Strings.Append("Stânga-dreapta = volanul (bila se învârte și pe tavan) · vârful telefonului de la tine = viteza · drept = stă. ", c);
    Strings.Append("Prinzi notele de pe podea; tobele cresc cu progresul. Atingi = pauză · atingi sus = aici e drept · ✕ = înapoi în cub. ", c);
    Strings.Append("Rulează în cub, nu e altă aplicație. Din Shell: joc", c);
    k := CFS.Scrie("cub-roller.app", c);
    c := "Cubicum OS v2.7 · Cub Roller în cub (joc) · nucleul Salamandra · Tor7 unit (7 grupe, Salamandra în procesor) · Styx între cuburi: styx asculta retea, styx leaga IP";
    Strings.Append(" · Opal · Roler · Prolog în limbajul Z7 · Eula ♪ · Cubicum FS pe 7⁷", c);
    k := CFS.Scrie("sistem.txt", c)
  END Programe27;

  PROCEDURE ScrieApp(nume: ARRAY OF CHAR; VAR c: ARRAY OF CHAR);   (* 7·B v7: ` devine ghilimele; scrie programul daca nu e in cub *)
    VAR i, k: INTEGER;
  BEGIN
    FOR i := 0 TO Strings.Length(c) - 1 DO IF c[i] = "`" THEN c[i] := 22X END END;
    IF CFS.Gaseste(nume) < 0 THEN k := CFS.Scrie(nume, c) END
  END ScrieApp;

  PROCEDURE AplicatiiZ7*;   (* 7·B v7: trei aplicatii Z7 cu fereastra, ca exemplu *)
    VAR c: ARRAY LC OF CHAR;
  BEGIN
    c := ""; L(c, "(* bile: trei bile care sar prin fereastra · atinge si vin la deget · ✕ opreste *)");
    L(c, "VAR x[3], y[3], vx[3], vy[3]"); L(c, "h := INALTIME; i := 0");
    L(c, "WHILE i < 3 DO x[i] := 50 + i * 100; y[i] := 60 + i * 40; vx[i] := 2 + i; vy[i] := 3 - i; i := i + 1 END");
    L(c, "WHILE 1 = 1 DO"); L(c, "  STERGE"); L(c, "  CULOARE(26, 10, 44); DREPT(0, 0, 343, h)"); L(c, "  i := 0");
    L(c, "  WHILE i < 3 DO"); L(c, "    IF APASAT = 1 THEN x[i] := ATINSX; y[i] := ATINSY END");
    L(c, "    x[i] := x[i] + vx[i]; y[i] := y[i] + vy[i]");
    L(c, "    IF (x[i] < 14) OR (x[i] > 329) THEN vx[i] := 0 - vx[i] END");
    L(c, "    IF (y[i] < 14) OR (y[i] > h - 14) THEN vy[i] := 0 - vy[i] END");
    L(c, "    IF i = 0 THEN CULOARE(214, 150, 84) ELSIF i = 1 THEN CULOARE(150, 120, 230) ELSE CULOARE(90, 200, 160) END");
    L(c, "    CERC(x[i], y[i], 14); i := i + 1"); L(c, "  END");
    L(c, "  CULOARE(240, 186, 118); MARIME(12); TEXT(10, 22, `atinge: bilele vin la deget`)");
    L(c, "  ARATA; DORMI(25)"); L(c, "END");
    ScrieApp("bile.z7l", c);
    c := ""; L(c, "(* ceas: ora telefonului, mare; secundele ca 7 bile care se aprind pe rand *)");
    L(c, "h := INALTIME"); L(c, "WHILE 1 = 1 DO"); L(c, "  o := ORA; m := MINUT; s := SECUNDA"); L(c, "  STERGE");
    L(c, "  CULOARE(18, 6, 32); DREPT(0, 0, 343, h)"); L(c, "  CULOARE(214, 150, 84); MARIME(70)");
    L(c, "  IF o < 10 THEN TEXT(63, 150, `0`); TEXTN(106, 150, o) ELSE TEXTN(63, 150, o) END");
    L(c, "  TEXT(150, 150, `:`)");
    L(c, "  IF m < 10 THEN TEXT(193, 150, `0`); TEXTN(236, 150, m) ELSE TEXTN(193, 150, m) END");
    L(c, "  CULOARE(150, 120, 230); DREPT(20, 185, s * 303 DIV 59, 10)");
    L(c, "  i := 0"); L(c, "  WHILE i < 7 DO");
    L(c, "    IF i < s MOD 7 + 1 THEN CULOARE(240, 186, 118) ELSE CULOARE(60, 40, 80) END");
    L(c, "    CERC(51 + i * 40, 240, 12); i := i + 1"); L(c, "  END");
    L(c, "  CULOARE(184, 164, 222); MARIME(14); TEXT(20, 295, `secunde:`); TEXTN(130, 295, s)");
    L(c, "  ARATA; DORMI(250)"); L(c, "END");
    ScrieApp("ceas.z7l", c);
    c := ""; L(c, "(* desen: trage cu degetul ca sa desenezi · jos: culoarea; X sterge tot *)");
    L(c, "VAR rr[8], gg[8], bb[8]");
    L(c, "rr[1] := 214; gg[1] := 150; bb[1] := 84; rr[2] := 150; gg[2] := 120; bb[2] := 230");
    L(c, "rr[3] := 90; gg[3] := 200; bb[3] := 160; rr[4] := 240; gg[4] := 90; bb[4] := 110");
    L(c, "rr[5] := 90; gg[5] := 160; bb[5] := 240; rr[6] := 240; gg[6] := 230; bb[6] := 140");
    L(c, "rr[7] := 250; gg[7] := 250; bb[7] := 250");
    L(c, "h := INALTIME; c := 1; nou := 1"); L(c, "WHILE 1 = 1 DO"); L(c, "  IF nou = 1 THEN");
    L(c, "    STERGE; CULOARE(18, 6, 32); DREPT(0, 0, 343, h)");
    L(c, "    CULOARE(60, 40, 80); DREPT(0, h - 40, 42, 40); CULOARE(240, 186, 118); MARIME(18); TEXT(12, h - 12, `X`)");
    L(c, "    i := 1"); L(c, "    WHILE i < 8 DO CULOARE(rr[i], gg[i], bb[i]); DREPT(i * 43 + 2, h - 38, 39, 36); i := i + 1 END");
    L(c, "    ARATA; nou := 0"); L(c, "  END");
    L(c, "  IF APASAT = 1 THEN"); L(c, "    x := ATINSX; y := ATINSY");
    L(c, "    IF y > h - 40 THEN k := x DIV 43; IF k = 0 THEN nou := 1 ELSIF k < 8 THEN c := k END");
    L(c, "    ELSE CULOARE(rr[c], gg[c], bb[c]); CERC(x, y, 5); ARATA"); L(c, "    END"); L(c, "  END");
    L(c, "  DORMI(15)"); L(c, "END");
    ScrieApp("desen.z7l", c)
  END AplicatiiZ7;

END Cub7Programe.

MODULE Cub7Memento;  (* Cubicum 7·B v12 (29 oct 2026): mementourile si sarcinile la ora (al 7-lea punct din lista de OS).
     aminteste-mi la 18:00 sa sun la banca · aminteste in 20 de minute ceaiul · aminteste maine la 9 dentist
     zilnic 08:00 bea apa (in fiecare zi) · zilnic 07:30 fa pasune tot (fa = Cubicum face comanda)
     mementouri = lista · mementouri sterge 2 · mementouri sterge tot
     Stau in cub (mementouri.txt). Cand vine ora: rand in Shell, un sunet si o notificare pe telefon. *)
  IMPORT Strings, Ecran, Sunet, CFS := CubicumFS, Tx := E7Txt;

  CONST N = 12; LT = 100; NW = 40;
    cText = 0; cGold = 2; cRed = 4; cDim = 5;   (* culorile Shell-ului (Iesire7) *)

  TYPE IesireP* = PROCEDURE (col: INTEGER; s: ARRAY OF CHAR);
    TextP* = PROCEDURE (s: ARRAY OF CHAR);
    OraP* = PROCEDURE (): INTEGER;

  VAR fel: ARRAY N OF INTEGER;   (* 0 = liber, 1 = o data, 2 = zilnic *)
    cand: ARRAY N OF INTEGER;   (* ora locala, in secunde de la 1970 *)
    txt: ARRAY N OF ARRAY LT OF CHAR;
    iesire: IesireP; executa: TextP; ora: OraP; pornit: BOOLEAN; ultim: INTEGER;
    wf: ARRAY NW OF ARRAY 32 OF CHAR; wb, we: ARRAY NW OF INTEGER; nw: INTEGER;
    folosit: ARRAY NW OF BOOLEAN;

  PROCEDURE Doi(v: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF v < 10 THEN Strings.Append("0", s) END; Strings.AppendInt(v, 0, s)
  END Doi;

  PROCEDURE OraText(t: INTEGER; VAR s: ARRAY OF CHAR);   (* HH:MM *)
    VAR x: INTEGER;
  BEGIN x := t MOD 86400; Doi(x DIV 3600, s); Strings.Append(":", s); Doi(x DIV 60 MOD 60, s)
  END OraText;

  PROCEDURE Salveaza;
    VAR s: ARRAY CFS.LC OF CHAR; i, k: INTEGER;
  BEGIN
    s := "";
    FOR i := 0 TO N - 1 DO
      IF fel[i] # 0 THEN
        Strings.AppendInt(fel[i], 0, s); Strings.Append(" ", s); Strings.AppendInt(cand[i], 0, s); Strings.Append(" ", s);
        Strings.Append(txt[i], s); Strings.AppendChar(0AX, s)
      END
    END;
    IF s = "" THEN s := "-" END;
    k := CFS.Scrie("mementouri.txt", s)
  END Salveaza;

  PROCEDURE Incarca;
    VAR t: ARRAY CFS.LC OF CHAR; i, k, j, v: INTEGER;
  BEGIN
    FOR k := 0 TO N - 1 DO fel[k] := 0; txt[k] := "" END;
    i := CFS.Gaseste("mementouri.txt");
    IF i >= 0 THEN
      CFS.Continut(i, t); i := 0; k := 0;
      WHILE (k < N) & (i < LEN(t) - 1) & (t[i] >= "1") & (t[i] <= "2") DO
        fel[k] := ORD(t[i]) - ORD("0"); INC(i); IF t[i] = " " THEN INC(i) END;
        v := 0; WHILE (t[i] >= "0") & (t[i] <= "9") DO v := v * 10 + ORD(t[i]) - ORD("0"); INC(i) END;
        cand[k] := v; IF t[i] = " " THEN INC(i) END;
        j := 0; WHILE (i < LEN(t) - 1) & (t[i] # 0AX) & (t[i] # 0X) DO IF j < LT - 1 THEN txt[k][j] := t[i]; INC(j) END; INC(i) END;
        txt[k][j] := 0X; IF t[i] = 0AX THEN INC(i) END;
        INC(k)
      END
    END
  END Incarca;

  PROCEDURE Are*(): BOOLEAN;   (* sunt mementouri care asteapta? atunci cubul ramane treaz in spate *)
    VAR i: INTEGER; r: BOOLEAN;
  BEGIN r := FALSE; FOR i := 0 TO N - 1 DO IF fel[i] # 0 THEN r := TRUE END END; RETURN r
  END Are;

  PROCEDURE Cand(t: INTEGER; VAR s: ARRAY OF CHAR);   (* azi 18:00 · maine 09:00 · in 3 zile 10:00 *)
    VAR z: INTEGER;
  BEGIN
    z := t DIV 86400 - ora() DIV 86400;
    IF z <= 0 THEN Strings.Append("azi ", s) ELSIF z = 1 THEN Strings.Append("mâine ", s)
    ELSE Strings.Append("peste ", s); Strings.AppendInt(z, 0, s); Strings.Append(" zile, ", s)
    END;
    OraText(t, s)
  END Cand;

  PROCEDURE Lista*;
    VAR i, n: INTEGER; s: ARRAY 200 OF CHAR;
  BEGIN
    n := 0;
    FOR i := 0 TO N - 1 DO
      IF fel[i] # 0 THEN
        INC(n); s := "  ⏰ "; Strings.AppendInt(i + 1, 0, s); Strings.Append(" · ", s);
        IF fel[i] = 2 THEN Strings.Append("zilnic ", s); OraText(cand[i], s) ELSE Cand(cand[i], s) END;
        Strings.Append(" · ", s); Strings.Append(txt[i], s); iesire(cText, s)
      END
    END;
    IF n = 0 THEN iesire(cDim, "⏰ niciun memento · aminteste-mi la 18:00 să … · zilnic 08:00 …")
    ELSE iesire(cDim, "  mementouri sterge N · mementouri sterge tot")
    END
  END Lista;

  PROCEDURE Cuvinte(l: ARRAY OF CHAR);   (* cuvintele liniei: mici, fara diacritice, cu locul lor in linia scrisa *)
    VAR i, j, n: INTEGER;
  BEGIN
    nw := 0; i := 0; n := Strings.Length(l);
    WHILE (i < n) & (nw < NW) DO
      WHILE (i < n) & (l[i] = " ") DO INC(i) END;
      IF i < n THEN
        wb[nw] := i; j := 0;
        WHILE (i < n) & (l[i] # " ") DO IF j < 31 THEN wf[nw][j] := Tx.Fold(Tx.Mic(l[i])); INC(j) END; INC(i) END;
        wf[nw][j] := 0X; we[nw] := i; folosit[nw] := FALSE; INC(nw)
      END
    END
  END Cuvinte;

  PROCEDURE Nr(w: ARRAY OF CHAR; VAR v: INTEGER): BOOLEAN;   (* un numar intreg mic *)
    VAR i: INTEGER;
  BEGIN
    v := 0; i := 0; WHILE (w[i] >= "0") & (w[i] <= "9") & (i < 6) DO v := v * 10 + ORD(w[i]) - ORD("0"); INC(i) END;
    RETURN (i > 0) & (w[i] = 0X)
  END Nr;

  PROCEDURE Ora(w: ARRAY OF CHAR; VAR h, m: INTEGER): BOOLEAN;   (* 18:00 · 18.30 · 9:05 *)
    VAR i: INTEGER; ok: BOOLEAN;
  BEGIN
    h := 0; m := 0; i := 0; ok := FALSE;
    WHILE (w[i] >= "0") & (w[i] <= "9") & (i < 2) DO h := h * 10 + ORD(w[i]) - ORD("0"); INC(i) END;
    IF (i > 0) & ((w[i] = ":") OR (w[i] = ".")) THEN
      INC(i); IF (w[i] >= "0") & (w[i] <= "9") & (w[i + 1] >= "0") & (w[i + 1] <= "9") THEN
        m := (ORD(w[i]) - ORD("0")) * 10 + ORD(w[i + 1]) - ORD("0"); ok := (w[i + 2] = 0X) & (h < 24) & (m < 60)
      END
    END;
    RETURN ok
  END Ora;

  PROCEDURE Timp(de: INTEGER; VAR t: INTEGER): BOOLEAN;   (* cauta ora in cuvinte, de la al de-lea; marcheaza ce a folosit *)
    VAR i, h, m, v, acum, zi: INTEGER; abs, rel, gasit: BOOLEAN;
  BEGIN
    acum := ora(); zi := 0; abs := FALSE; rel := FALSE; gasit := FALSE; h := 0; m := 0; v := 0;
    FOR i := de TO nw - 1 DO
      IF (wf[i] = "maine") & ~gasit THEN zi := 1; folosit[i] := TRUE
      ELSIF (wf[i] = "poimaine") & ~gasit THEN zi := 2; folosit[i] := TRUE
      END
    END;
    i := de;
    WHILE (i < nw) & ~gasit DO
      IF Ora(wf[i], h, m) THEN
        abs := TRUE; gasit := TRUE; folosit[i] := TRUE;
        IF (i > de) & ((wf[i - 1] = "la") OR (wf[i - 1] = "ora")) THEN folosit[i - 1] := TRUE;
          IF (i > de + 1) & (wf[i - 1] = "ora") & (wf[i - 2] = "la") THEN folosit[i - 2] := TRUE END
        END
      ELSIF (wf[i] = "la") & (i + 1 < nw) & Nr(wf[i + 1], v) & (v < 24) THEN   (* la 18 *)
        abs := TRUE; gasit := TRUE; h := v; m := 0; folosit[i] := TRUE; folosit[i + 1] := TRUE
      ELSIF (wf[i] = "la") & (i + 2 < nw) & (wf[i + 1] = "ora") & Nr(wf[i + 2], v) & (v < 24) THEN   (* la ora 9 *)
        abs := TRUE; gasit := TRUE; h := v; m := 0; folosit[i] := TRUE; folosit[i + 1] := TRUE; folosit[i + 2] := TRUE
      ELSIF ((wf[i] = "in") OR (wf[i] = "peste")) & (i + 2 < nw) & Nr(wf[i + 1], v) THEN   (* in 20 de minute · peste 2 ore *)
        h := i + 2; IF (wf[h] = "de") & (h + 1 < nw) THEN INC(h) END;
        IF Tx.Incepe(wf[h], "min") OR (wf[h] = "m") THEN rel := TRUE; t := acum + v * 60
        ELSIF Tx.Incepe(wf[h], "or") OR (wf[h] = "h") THEN rel := TRUE; t := acum + v * 3600
        ELSIF Tx.Incepe(wf[h], "sec") THEN rel := TRUE; t := acum + v
        END;
        IF rel THEN gasit := TRUE; WHILE i <= h DO folosit[i] := TRUE; INC(i) END; DEC(i) END
      END;
      INC(i)
    END;
    IF abs THEN
      t := acum DIV 86400 * 86400 + h * 3600 + m * 60 + zi * 86400;
      IF (zi = 0) & (t <= acum) THEN t := t + 86400 END
    ELSIF ~rel & (zi > 0) THEN t := acum DIV 86400 * 86400 + 9 * 3600 + zi * 86400; gasit := TRUE   (* maine, fara ora: la 9 *)
    END;
    RETURN gasit
  END Timp;

  PROCEDURE Rest(l: ARRAY OF CHAR; de: INTEGER; VAR s: ARRAY OF CHAR);   (* ce n-a fost ora: mesajul, din linia scrisa *)
    VAR i, j, k: INTEGER; prim: BOOLEAN;
  BEGIN
    s := ""; k := 0; prim := TRUE;
    FOR i := de TO nw - 1 DO
      IF ~folosit[i] & ~(prim & ((wf[i] = "sa") OR (wf[i] = "ca") OR (wf[i] = "de") OR (wf[i] = "-mi") OR (wf[i] = "mi") OR (wf[i] = "imi"))) THEN
        IF k > 0 THEN IF k < LEN(s) - 1 THEN s[k] := " "; INC(k) END END;
        j := wb[i]; WHILE (j < we[i]) & (k < LEN(s) - 1) DO s[k] := l[j]; INC(k); INC(j) END;
        prim := FALSE
      END
    END;
    s[k] := 0X
  END Rest;

  PROCEDURE Loc(): INTEGER;
    VAR i, r: INTEGER;
  BEGIN r := -1; FOR i := N - 1 TO 0 BY -1 DO IF fel[i] = 0 THEN r := i END END; RETURN r
  END Loc;

  PROCEDURE Pune(f, t: INTEGER; s: ARRAY OF CHAR);
    VAR i: INTEGER; m: ARRAY 200 OF CHAR;
  BEGIN
    i := Loc();
    IF i < 0 THEN iesire(cRed, "⏰ sunt deja 12 mementouri · mementouri sterge N")
    ELSE
      fel[i] := f; cand[i] := t; Strings.Copy(s, txt[i]); Salveaza;
      m := "⏰ "; IF f = 2 THEN Strings.Append("zilnic la ", m); OraText(t, m) ELSE Cand(t, m) END;
      Strings.Append(" · ", m); Strings.Append(s, m); iesire(cGold, m);
      IF f = 2 THEN
        IF Tx.Incepe(s, "fa ") OR Tx.Incepe(s, "fă ") THEN iesire(cDim, "  la ora aceea Cubicum face comanda și te anunță")
        ELSE iesire(cDim, "  te anunț în fiecare zi · zilnic 07:30 fa pasune tot = Cubicum face comanda")
        END
      ELSE iesire(cDim, "  te anunț și cu aplicația în spate · mementouri = lista")
      END
    END
  END Pune;

  PROCEDURE Cmd*(l: ARRAY OF CHAR): BOOLEAN;   (* TRUE = era o comanda de memento *)
    VAR r: BOOLEAN; t, k, v, de: INTEGER; s: ARRAY LT OF CHAR; w0: ARRAY 32 OF CHAR;
  BEGIN
    Cuvinte(l); r := FALSE;
    IF nw > 0 THEN
      Strings.Copy(wf[0], w0); de := 1;
      IF (w0 = "aminteste-mi") OR (w0 = "amintestemi") OR (w0 = "aminteste") OR (w0 = "memento") OR (w0 = "aminteste-ne") THEN
        r := TRUE;
        IF (nw > 1) & ((wf[1] = "-mi") OR (wf[1] = "mi") OR (wf[1] = "imi")) THEN de := 2 END;
        IF ~Timp(de, t) THEN iesire(cRed, "⏰ când? de pildă: aminteste-mi la 18:00 să … · aminteste în 20 de minute … · aminteste mâine la 9 …")
        ELSE Rest(l, de, s); IF s = "" THEN s := "memento" END; Pune(1, t, s)
        END
      ELSIF w0 = "zilnic" THEN
        r := TRUE;
        IF ~Timp(1, t) THEN iesire(cRed, "⏰ la ce oră? zilnic 08:00 bea apă · zilnic 07:30 fa pasune tot")
        ELSE Rest(l, 1, s); IF s = "" THEN s := "memento" END; Pune(2, t, s)
        END
      ELSIF (w0 = "mementouri") OR (w0 = "mementourile") THEN
        r := TRUE;
        IF (nw > 2) & (wf[1] = "sterge") & (wf[2] = "tot") THEN
          FOR k := 0 TO N - 1 DO fel[k] := 0 END; Salveaza; iesire(cGold, "⏰ toate mementourile s-au șters")
        ELSIF (nw > 2) & (wf[1] = "sterge") & Nr(wf[2], v) THEN
          IF (v >= 1) & (v <= N) & (fel[v - 1] # 0) THEN
            fel[v - 1] := 0; Salveaza; s := "⏰ șters: "; Strings.Append(txt[v - 1], s); iesire(cGold, s)
          ELSE iesire(cRed, "⏰ nu e memento cu numărul ăsta · mementouri = lista")
          END
        ELSE Lista
        END
      END
    END;
    RETURN r
  END Cmd;

  PROCEDURE Tic*;   (* o data pe secunda: a venit ora vreunui memento? *)
    VAR i, t: INTEGER; s: ARRAY 200 OF CHAR; c: ARRAY LT OF CHAR; schimbat: BOOLEAN;
  BEGIN
    IF pornit THEN
      t := ora();
      IF t # ultim THEN
        ultim := t; schimbat := FALSE;
        FOR i := 0 TO N - 1 DO
          IF (fel[i] # 0) & (t >= cand[i]) THEN
            schimbat := TRUE; s := "⏰ "; OraText(cand[i], s); Strings.Append(" · ", s); Strings.Append(txt[i], s);
            IF t - cand[i] > 120 THEN Strings.Append(" (a trecut ora, cubul era oprit)", s) END;
            iesire(cGold, s); Sunet.Nota(784, 350, 40); Ecran.Anunta("Cubicum 7·B ⏰", txt[i]);
            IF fel[i] = 2 THEN
              WHILE cand[i] <= t DO cand[i] := cand[i] + 86400 END;
              IF Tx.Incepe(txt[i], "fa ") OR Tx.Incepe(txt[i], "fă ") THEN
                Tx.Sub(txt[i], 3, Strings.Length(txt[i]), c); IF Tx.Incepe(txt[i], "fă ") THEN Tx.Sub(txt[i], 3, Strings.Length(txt[i]), c) END;
                executa(c)
              END
            ELSE fel[i] := 0
            END
          END
        END;
        IF schimbat THEN Salveaza END
      END
    END
  END Tic;

  PROCEDURE Porneste*(ies: IesireP; exe: TextP; o: OraP);   (* dupa ce s-a montat Cubicum FS; nu scrie nimic pe ecran *)
  BEGIN iesire := ies; executa := exe; ora := o; Incarca; ultim := 0; pornit := TRUE
  END Porneste;

BEGIN pornit := FALSE; nw := 0
END Cub7Memento.

MODULE Cub7Drepturi;  (* Cubicum 7·B v13 (29 oct 2026): permisiunile (al 8-lea punct din lista de OS).
     Fiecare program Z7 are drepturile lui, dupa nume. Ce poate face un program fara niciun drept: sa socoteasca,
     sa scrie in tura lui (variabilele lui), sa scrie in Shell, sa trimita mesaje. Drepturile:
       tor       scrie in tor in afara turei lui (memoria si codul altor programe), Roler, Nephilim, colturile
       opri      opreste alte programe (OPRESTE)
       porni     porneste programe (PORNESTE)
       sunet     NOTA, CANTA
       fereastra deseneaza in fereastra Shell-ului (aplicatiile Z7)
       experti   vorbeste cu Oul si cu artele (ASCULTA -1000)
     Programele care erau in cub cand a venit v13 le-a scris Cubicum: au toate drepturile.
     Un program nou (edit, adu) primeste sunet si fereastra. drepturi = lista · drept X +tor -sunet · drept X tot / nimic *)
  IMPORT Strings, CFS := CubicumFS, Sal := Salamandra, Tx := E7Txt;

  CONST NN = 80; Toate* = 63; Implicit* = 24;   (* 8 sunet + 16 fereastra *)
    cText = 0; cGold = 2; cRed = 4; cDim = 5;

  TYPE IesireP* = PROCEDURE (col: INTEGER; s: ARRAY OF CHAR);

  VAR nume: ARRAY NN OF ARRAY 24 OF CHAR; dr: ARRAY NN OF INTEGER; n: INTEGER;
    iesire: IesireP; dNume: ARRAY 6 OF ARRAY 12 OF CHAR;
    vestea*: ARRAY 160 OF CHAR;   (* ce se spune la primul cadru *)

  PROCEDURE Baza(s: ARRAY OF CHAR; VAR b: ARRAY OF CHAR);   (* numele fara .z7 / .z7l *)
    VAR k: INTEGER;
  BEGIN Strings.Copy(s, b); k := Strings.Pos(".", b, 0); IF k > 0 THEN b[k] := 0X END
  END Baza;

  PROCEDURE Gas(b: ARRAY OF CHAR): INTEGER;
    VAR i, r: INTEGER;
  BEGIN r := -1; FOR i := 0 TO n - 1 DO IF nume[i] = b THEN r := i END END; RETURN r
  END Gas;

  PROCEDURE Drept*(prog: ARRAY OF CHAR): INTEGER;   (* drepturile programului (cu sau fara .z7l) *)
    VAR b: ARRAY 24 OF CHAR; i, r: INTEGER;
  BEGIN Baza(prog, b); i := Gas(b); IF i >= 0 THEN r := dr[i] ELSE r := Implicit END; RETURN r
  END Drept;

  PROCEDURE Text(d: INTEGER; VAR s: ARRAY OF CHAR);   (* tor opri sunet … *)
    VAR k, m: INTEGER; prim: BOOLEAN;
  BEGIN
    IF d = Toate THEN Strings.Append("toate", s)
    ELSIF d = 0 THEN Strings.Append("niciunul", s)
    ELSE
      m := 1; prim := TRUE;
      FOR k := 0 TO 5 DO
        IF d DIV m MOD 2 = 1 THEN IF ~prim THEN Strings.Append(" ", s) END; Strings.Append(dNume[k], s); prim := FALSE END;
        m := m * 2
      END
    END
  END Text;

  PROCEDURE Salveaza;
    VAR s: ARRAY CFS.LC OF CHAR; i, k: INTEGER;
  BEGIN
    s := "";
    FOR i := 0 TO n - 1 DO
      IF Strings.Length(s) + Strings.Length(nume[i]) + 6 < CFS.LC THEN
        Strings.Append(nume[i], s); Strings.Append(" ", s); Strings.AppendInt(dr[i], 0, s); Strings.AppendChar(0AX, s)
      END
    END;
    IF s = "" THEN s := "-" END;
    k := CFS.Scrie("drepturi.txt", s)
  END Salveaza;

  PROCEDURE Pune(b: ARRAY OF CHAR; d: INTEGER);
    VAR i: INTEGER;
  BEGIN
    i := Gas(b);
    IF (i < 0) & (n < NN) THEN i := n; INC(n); Strings.Copy(b, nume[i]) END;
    IF i >= 0 THEN dr[i] := d END
  END Pune;

  PROCEDURE Lista*;
    VAR i, k: INTEGER; s: ARRAY 400 OF CHAR;
  BEGIN
    iesire(cGold, "⚿ drepturile programelor (cele care nu sunt aici: sunet fereastra):");
    s := "  toate: "; k := 0;   (* intai cele cu toate drepturile, pe un rand *)
    FOR i := 0 TO n - 1 DO
      IF (dr[i] = Toate) & (Strings.Length(s) + Strings.Length(nume[i]) < LEN(s) - 4) THEN
        IF k > 0 THEN Strings.Append(", ", s) END; Strings.Append(nume[i], s); INC(k)
      END
    END;
    IF k > 0 THEN iesire(cText, s) END;
    FOR i := 0 TO n - 1 DO
      IF (dr[i] # Implicit) & (dr[i] # Toate) THEN s := "  "; Strings.Append(nume[i], s); Strings.Append(": ", s); Text(dr[i], s); iesire(cText, s) END
    END;
    iesire(cDim, "  drept X = ce poate X · drept X +tor -sunet · drept X tot · drept X nimic");
    iesire(cDim, "  tor · opri · porni · sunet · fereastra · experti")
  END Lista;

  PROCEDURE Bit(w: ARRAY OF CHAR): INTEGER;   (* "tor" → 1; 0 = nu e drept *)
    VAR k, m, r: INTEGER;
  BEGIN
    r := 0; m := 1;
    FOR k := 0 TO 5 DO IF Tx.Incepe(dNume[k], w) & (Strings.Length(w) >= 3) THEN r := m END; m := m * 2 END;
    RETURN r
  END Bit;

  PROCEDURE Cmd*(l: ARRAY OF CHAR): BOOLEAN;   (* drepturi · drept X … ; TRUE = era a mea *)
    VAR w: ARRAY 16 OF ARRAY 24 OF CHAR; nw, i, j, d, b: INTEGER; r, rau: BOOLEAN; s: ARRAY 200 OF CHAR; pr: ARRAY 24 OF CHAR;
  BEGIN
    nw := 0; i := 0;
    WHILE (l[i] # 0X) & (nw < 16) DO
      WHILE l[i] = " " DO INC(i) END;
      IF l[i] # 0X THEN
        j := 0; WHILE (l[i] # " ") & (l[i] # 0X) DO IF j < 23 THEN w[nw][j] := Tx.Fold(Tx.Mic(l[i])); INC(j) END; INC(i) END;
        w[nw][j] := 0X; INC(nw)
      END
    END;
    r := FALSE;
    IF (nw >= 1) & ((w[0] = "drepturi") OR (w[0] = "permisiuni")) THEN r := TRUE; Lista
    ELSIF (nw >= 1) & ((w[0] = "drept") OR (w[0] = "permisiune")) THEN
      r := TRUE;
      IF nw = 1 THEN Lista
      ELSE
        Baza(w[1], pr); d := Drept(pr); rau := FALSE;
        FOR i := 2 TO nw - 1 DO
          IF w[i] = "tot" THEN d := Toate ELSIF (w[i] = "nimic") OR (w[i] = "niciunul") THEN d := 0
          ELSIF (w[i][0] = "+") OR (w[i][0] = "-") THEN
            Tx.Sub(w[i], 1, Strings.Length(w[i]), s); b := Bit(s);
            IF b = 0 THEN rau := TRUE
            ELSIF w[i][0] = "+" THEN IF d DIV b MOD 2 = 0 THEN d := d + b END
            ELSIF d DIV b MOD 2 = 1 THEN d := d - b
            END
          ELSE rau := TRUE
          END
        END;
        IF rau THEN iesire(cRed, "⚿ nu înțeleg · drept X +tor -sunet · drept X tot · drept X nimic · drepturile: tor opri porni sunet fereastra experti")
        ELSE
          IF nw > 2 THEN Pune(pr, d); Salveaza; Sal.Redrepturi END;
          s := "⚿ "; Strings.Append(pr, s); Strings.Append(" · ", s); Text(d, s); iesire(cGold, s);
          IF nw > 2 THEN iesire(cDim, "  se aplică și programelor care rulează acum") END
        END
      END
    END;
    RETURN r
  END Cmd;

  PROCEDURE Incarca(): BOOLEAN;   (* FALSE = nu era drepturi.txt *)
    VAR t: ARRAY CFS.LC OF CHAR; i, j, v: INTEGER; b: ARRAY 24 OF CHAR; ok: BOOLEAN;
  BEGIN
    n := 0; i := CFS.Gaseste("drepturi.txt"); ok := i >= 0;
    IF ok THEN
      CFS.Continut(i, t); i := 0;
      WHILE (n < NN) & (i < LEN(t) - 1) & (t[i] # 0X) & (t[i] # "-") DO
        j := 0; WHILE (i < LEN(t) - 1) & (t[i] # " ") & (t[i] # 0X) & (t[i] # 0AX) DO IF j < 23 THEN b[j] := t[i]; INC(j) END; INC(i) END;
        b[j] := 0X; IF t[i] = " " THEN INC(i) END;
        v := 0; WHILE (t[i] >= "0") & (t[i] <= "9") DO v := v * 10 + ORD(t[i]) - ORD("0"); INC(i) END;
        IF t[i] = 0AX THEN INC(i) END;
        IF (j > 0) & (v <= Toate) THEN Pune(b, v) END
      END
    END;
    RETURN ok
  END Incarca;

  PROCEDURE Spus*;   (* vestea s-a spus *)
  BEGIN vestea := ""
  END Spus;

  PROCEDURE Porneste*(ies: IesireP);   (* dupa ce Cubicum si-a scris programele in cub; nu scrie nimic pe ecran *)
    VAR i, k: INTEGER; s, b: ARRAY 64 OF CHAR;
  BEGIN
    iesire := ies; vestea := "";
    IF ~Incarca() THEN   (* prima data: tot ce e acum in cub a scris Cubicum *)
      k := 0;
      FOR i := 0 TO CFS.N() - 1 DO
        CFS.Nume(i, s);
        IF Tx.Sfarsit(s, ".z7") OR Tx.Sfarsit(s, ".z7l") THEN Baza(s, b); Pune(b, Toate); INC(k) END
      END;
      Salveaza;
      vestea := "⚿ permisiunile: cele "; Strings.AppendInt(k, 0, vestea);
      Strings.Append(" programe scrise de Cubicum au toate drepturile; cele noi doar sunet și fereastră · drepturi", vestea)
    END;
    Sal.PuneDrepturi(Drept)
  END Porneste;

BEGIN
  n := 0; vestea := "";
  dNume[0] := "tor"; dNume[1] := "opri"; dNume[2] := "porni"; dNume[3] := "sunet"; dNume[4] := "fereastra"; dNume[5] := "experti"
END Cub7Drepturi.

MODULE Cubicum7B;  (* Cubicum 7·B (29 oct 2026): aplicatie separata, baza 7 cu cifrele 1..7 (Tor7, adrese, ture, solzi, socoteli).
      v2.7 (27 oct 2026): Cub Roller, primul joc care ruleaza in cub (joc / cub-roller.app).
     v2.6 (26 oct 2026): styx asculta retea / styx leaga IP / styx dezleaga - un cub intreaba alt cub (Eula Oberon v31).
     v2.5 (26 oct 2026): Tor7 unit cu TOR7-1 - 7 grupe, Salamandra in procesor, CALL/RET, STEP/COORD, SIST.
     Cubicum OS v1.0 adus din HTML in Oberon, cu Cubicum FS inauntru. O faci cu:  apk CubicumOS.Mod "Cubicum OS"
     Boot in 5 faze, desktop izometric, 7 ferestre (Procese, Retea, Alchimist, Shell, VM, Orga CRDA, Trilogia) si a opta,
     Cubicum FS: fisierele stau in cubul Z7^3, la adresa data de nume, tip si zi. Pe telefon e loc de o fereastra:
     ea ocupa ecranul, iar bara de jos le schimba. *)
  IMPORT Math, Strings, Os, Files, Ecran, Z7P, Sunet, CFS := CubicumFS, Tor7, Sal := Salamandra,
    Tx := E7Txt, Te := E7Teorie, E7Comp, E7Sonor, E7Synth, Styx, CubRoller, Mesh343, V7 := Cub7Ver, E7 := Cub7Eule, Cp := Cub7Copie, Pr := Cub7Programe, Mem := Cub7Memento, Dr := Cub7Drepturi, Mm := Cub7Memoria;   (* v1.6: muzica din Eula ♪; v2.7: jocul *)

  CONST Eu = 6;   (* Cubicum 7·B: 6 (7783); Cubicum 7 EN: 5 (7782); Cubicum 7: 4 (7781); v2.8: al catelea cub: 0 A = Cubicum OS (7777), 1 B (7778), 2 C (7779) *)
    Av = 62;   (* pasul literei: 0.62 din marime, ca un font monospatiat (in HTML: Share Tech Mono) *)
    NS = 120; NP = 24; NL = 400; LL = 100; NF = 8; LT = 256; LC = CFS.LC;

  VAR
    dp: REAL; G1: INTEGER;
    W, H, t0, acum, ultimCadru, dt: INTEGER;
    faza, fazaSunata: INTEGER; booted: BOOLEAN;
    seed: INTEGER;
    salvRau: BOOLEAN; mot: ARRAY 240 OF CHAR;
    z7: ARRAY 7 OF REAL; notaN: ARRAY 7 OF ARRAY 4 OF CHAR;
    fazaTxt, fazaSub: ARRAY 5 OF ARRAY 40 OF CHAR; fazaT, fazaBar: ARRAY 5 OF INTEGER;
    cBg2, cGold, cGold2, cCyan, cGreen, cPurple, cRed, cDim, cText, cWin, cBord, cBordF, cTitlu, cYel: INTEGER;
    sx, sy, sr, sa, sda, sdx: ARRAY NS OF REAL;
    barH, tbY, wx, wy, ww, wh, titH, bx, by, bw, bh, clip0, clip1: INTEGER;
    cur: INTEGER;                                     (* fereastra deschisa; -1 = desktopul gol *)
    icon, titlu, scurt: ARRAY NF OF ARRAY 32 OF CHAR;
    era: BOOLEAN; jx, jy, ultimY, mutat: INTEGER;    (* atingerea *)
    shSus, shJos, shViz, shLh, shTot: INTEGER;   (* v8 (Cubicum 7): unde e textul Shell-ului, ca bara de derulare sa se poata trage *)
    scroll, inalt: ARRAY NF OF INTEGER;
    ceasS: ARRAY 12 OF CHAR; ceasT, ceasL: INTEGER;   (* 7·B v12: ceasL = ora locala, in secunde *)
    (* procese *)
    procSel, salDe, undaDe, scrVazute: INTEGER;
    ultimaSalvare, scrSalvate: INTEGER;
    linie: ARRAY 160 OF CHAR; tastatura, editez: BOOLEAN; edNume: ARRAY 32 OF CHAR; edBuf: ARRAY LC OF CHAR;
    (* retea *)
    pkF, pkT, pkC: ARRAY NP OF INTEGER; pkU: ARRAY NP OF REAL; npk, vazTrimise: INTEGER;
    (* alchimist *)
    asym, anume: ARRAY 8 OF ARRAY 24 OF CHAR; adesc: ARRAY 8 OF ARRAY 48 OF CHAR;
    instEu, instDe: INTEGER;
    (* shell *)
    sl: ARRAY NL OF ARRAY LL OF CHAR; slc: ARRAY NL OF INTEGER; nsl: INTEGER;
    slCont: ARRAY NL OF BOOLEAN; rCont: BOOLEAN; shPt: INTEGER;
    treazMereu, treazAcum: BOOLEAN;   (* 7·B v5: Cubicum ramane treaz in spate *)
    appVede, appAp: BOOLEAN; appTura, appX, appY, appM: INTEGER; appNume: ARRAY 32 OF CHAR;
    wPlin, hPlin: INTEGER;   (* 7·B v10: ecranul fara tastatura *)   (* 7·B v7: aplicatia Z7 din fereastra *)
    dOp, dA, dB, dC, dD, dE: ARRAY 2 OF ARRAY 3000 OF INTEGER; dT: ARRAY 2 OF ARRAY 6000 OF CHAR; nd, nt: ARRAY 2 OF INTEGER;   (* lista de desen: 0 se scrie, 1 se vede *)
    editor, edMod, edUrm, edIes: BOOLEAN; edT: ARRAY LC OF CHAR; edN, edC, edSus, edPx, edNL, edMsgDe: INTEGER;   (* 7·B v6: editorul *)
    edLs: ARRAY 400 OF INTEGER; edNumeE: ARRAY 40 OF CHAR; edMsg: ARRAY 120 OF CHAR; edB: ARRAY 10 OF ARRAY 12 OF CHAR;
    hist: ARRAY 20 OF ARRAY 160 OF CHAR; nh, hp: INTEGER;   (* 7·B v5: comenzile de dinainte (↑) *)   (* 7·B v3: bucata continua randul de dinainte; marimea textului din Shell *)
    tl: ARRAY NL OF ARRAY LL OF CHAR; tc: ARRAY NL OF INTEGER; tCont: ARRAY NL OF BOOLEAN;   (* copia, la rearanjare *)
    cmd: ARRAY 10 OF ARRAY 8 OF CHAR; ultimaCmd: ARRAY 8 OF CHAR;
    (* vm *)
    vmSel: INTEGER;
    (* orga *)
    on: ARRAY 343 OF BOOLEAN; arp: BOOLEAN; arpI, ultimArp: INTEGER;
    oCx, oCy, oBtnY: INTEGER; oSt: REAL;
    mesaj: ARRAY 80 OF CHAR; mesajPana: INTEGER;
    obt: ARRAY 5 OF ARRAY 16 OF CHAR;
    (* trilogia *)
    trN, trT, trB, trZ: ARRAY 4 OF ARRAY LT OF CHAR;
    (* cubicum fs *)
    sel, vede, ardeDe: INTEGER;
    (* muzica (v1.6) *)
    deCantat: INTEGER;   (* > 0: piesa se randeaza peste atatea cadre (intai apare textul) *)
    (* Styx pe socket (v2.3) *)
    sAsc, sLegat, sRetea: BOOLEAN; sAn, sMesaje: INTEGER;
    sAcc: ARRAY 140000 OF BYTE; sIn, sMsg, sOut: ARRAY 66000 OF BYTE;
    (* fisierele telefonului (v1.7) *)
    dlDosar: ARRAY 256 OF CHAR; dlNume: ARRAY 2000 OF ARRAY 64 OF CHAR; dlMar: ARRAY 2000 OF INTEGER; dlN: INTEGER;
    lista: INTEGER;   (* ultima lista numerotata: 0 Download, 1 caut (harta) *)
    gasite: ARRAY 40 OF INTEGER; ng: INTEGER;
    hartaDe, hartaSpus: INTEGER; s0: ARRAY 300 OF CHAR;
    cod: ARRAY LC OF CHAR;
    cCx, cCy, lY0, lY1, rowH: INTEGER; cSt: REAL;
    joc: BOOLEAN;   (* v2.7: Cub Roller ocupa ecranul *)
    mesh: BOOLEAN;   (* v2.9: cele 343 de cuburi ocupa ecranul *)
    tarNume: ARRAY 22 OF ARRAY 24 OF CHAR; tarCuv: ARRAY 22 OF ARRAY 16 OF CHAR;   (* C6: Eula ☾ *)
    tarSus, tarJos: ARRAY 22 OF ARRAY 72 OF CHAR;
    zodNume: ARRAY 12 OF ARRAY 16 OF CHAR; hInima, hMunca, hDrum: ARRAY 7 OF ARRAY 64 OF CHAR;
    progI, progAles, ultimX: INTEGER;   (* v2.7c: selectorul din Process: ce se vede, ce e ales (-1 = nimic) *)

  (* ---------- unelte ---------- *)

  PROCEDURE D(v: INTEGER): INTEGER;   (* dp -> pixeli *)
  BEGIN RETURN FLOOR(FLT(v) * dp + 0.5)
  END D;

  PROCEDURE Min(a, b: INTEGER): INTEGER;
  BEGIN IF b < a THEN a := b END; RETURN a
  END Min;

  PROCEDURE Rnd(n: INTEGER): INTEGER;
  BEGIN seed := seed * 69069 + 1; RETURN (seed DIV 65536) MOD n
  END Rnd;

  PROCEDURE RndR(): REAL;
  BEGIN RETURN FLT(Rnd(10000)) / 10000.0
  END RndR;

  PROCEDURE Am(r, g, b: INTEGER; a: REAL): INTEGER;   (* culoarea (r,g,b) cu opacitatea a, peste fundalul inchis *)
  BEGIN
    IF a < 0.0 THEN a := 0.0 ELSIF a > 1.0 THEN a := 1.0 END;
    RETURN Ecran.RGB(26 + FLOOR(FLT(r - 26) * a), 10 + FLOOR(FLT(g - 10) * a), 44 + FLOOR(FLT(b - 44) * a))   (* 7·B v2: peste violet *)
  END Am;

  PROCEDURE Roata(grad: INTEGER; a: REAL): INTEGER;   (* culoarea notei: nuanta pe roata culorilor *)
    VAR h, f, r, g, b: INTEGER;
  BEGIN
    grad := grad MOD 360; h := grad DIV 60; f := (grad MOD 60) * 255 DIV 60;
    IF h = 0 THEN r := 255; g := f; b := 0 ELSIF h = 1 THEN r := 255 - f; g := 255; b := 0
    ELSIF h = 2 THEN r := 0; g := 255; b := f ELSIF h = 3 THEN r := 0; g := 255 - f; b := 255
    ELSIF h = 4 THEN r := f; g := 0; b := 255 ELSE r := 255; g := 0; b := 255 - f
    END;
    RETURN Am(r, g, b, a)
  END Roata;

  PROCEDURE Lat(s: ARRAY OF CHAR; m: INTEGER): INTEGER;   (* latimea aproximativa a textului *)
  BEGIN RETURN Strings.Length(s) * m * Av DIV 100
  END Lat;

  PROCEDURE Vede(y, m: INTEGER): BOOLEAN;
  BEGIN RETURN (y - m >= clip0) & (y <= clip1)
  END Vede;

  PROCEDURE T(x, y, m: INTEGER; s: ARRAY OF CHAR);   (* text aliniat la stanga, litera cu litera pe pasi egali *)
    VAR i, a: INTEGER; c: ARRAY 2 OF CHAR;
  BEGIN
    IF Vede(y, m) THEN
      a := m * Av; i := 0; c[1] := 0X;
      WHILE (i < LEN(s)) & (s[i] # 0X) DO
        IF s[i] # " " THEN c[0] := s[i]; Ecran.Text(x + (i * a + a DIV 2) DIV 100, y, m, c) END;
        INC(i)
      END
    END
  END T;

  PROCEDURE TC(x, y, m: INTEGER; s: ARRAY OF CHAR);  (* centrat *)
  BEGIN IF Vede(y, m) THEN Ecran.Text(x, y, m, s) END
  END TC;

  PROCEDURE TD(x, y, m: INTEGER; s: ARRAY OF CHAR);  (* aliniat la dreapta *)
  BEGIN T(x - Lat(s, m), y, m, s)
  END TD;

  PROCEDURE Contur(x, y, w, h: INTEGER);
  BEGIN
    Ecran.Linie(x, y, x + w, y); Ecran.Linie(x + w, y, x + w, y + h);
    Ecran.Linie(x + w, y + h, x, y + h); Ecran.Linie(x, y + h, x, y)
  END Contur;

  PROCEDURE Buton(x, y, w, h: INTEGER; s: ARRAY OF CHAR; fond, scris, chenar: INTEGER);
    VAR m: INTEGER;
  BEGIN
    Ecran.Culoare(fond); Ecran.Dreptunghi(x, y, w, h);
    Ecran.Culoare(chenar); Ecran.Grosime(G1); Contur(x, y, w, h);
    m := D(12);
    IF Strings.Length(s) * m * Av DIV 100 > w - D(6) THEN m := (w - D(6)) * 100 DIV (Strings.Length(s) * Av) END;   (* 7·B v2: pasul adevarat al literei *)
    Ecran.Culoare(scris); TC(x + w DIV 2, y + h DIV 2 + m DIV 3, m, s)
  END Buton;

  PROCEDURE Buton2(x, y, w, h: INTEGER; ic, s: ARRAY OF CHAR; fond, scris, chenar: INTEGER);   (* 7·B v2: semnul sus, numele mic dedesubt *)
    VAR m: INTEGER;
  BEGIN
    Ecran.Culoare(fond); Ecran.Dreptunghi(x, y, w, h);
    Ecran.Culoare(chenar); Ecran.Grosime(G1); Contur(x, y, w, h);
    Ecran.Culoare(scris); TC(x + w DIV 2, y + D(17), D(14), ic);
    m := D(10);
    IF Strings.Length(s) * m * Av DIV 100 > w - D(4) THEN m := (w - D(4)) * 100 DIV (Strings.Length(s) * Av) END;
    TC(x + w DIV 2, y + h - D(7), m, s)
  END Buton2;

  PROCEDURE In(x, y, x0, y0, w, h: INTEGER): BOOLEAN;
  BEGIN RETURN (x >= x0) & (x < x0 + w) & (y >= y0) & (y < y0 + h)
  END In;

  PROCEDURE Paragraf(x, y, m, lat: INTEGER; s: ARRAY OF CHAR): INTEGER;   (* scrie s pe randuri; intoarce y-ul ultimului rand *)
    VAR maxc, n, start, k, j: INTEGER; r: ARRAY LL OF CHAR; nou: BOOLEAN;
  BEGIN
    maxc := lat * 100 DIV (m * Av);
    IF maxc < 8 THEN maxc := 8 ELSIF maxc > LL - 1 THEN maxc := LL - 1 END;
    n := Strings.Length(s); start := 0;
    WHILE start < n DO
      j := start; WHILE (j < n) & (j < start + maxc) & (s[j] # 0AX) DO INC(j) END;
      nou := (j < n) & (s[j] = 0AX);
      IF nou OR (j >= n) THEN k := j - start
      ELSE
        k := maxc;
        WHILE (k > 0) & (s[start + k] # " ") DO DEC(k) END;
        IF k = 0 THEN k := maxc END
      END;
      Strings.Extract(s, start, k, r);
      y := y + m * 13 DIV 10; T(x, y, m, r);
      start := start + k;
      IF nou THEN INC(start) ELSE WHILE (start < n) & (s[start] = " ") DO INC(start) END END
    END;
    RETURN y
  END Paragraf;

  PROCEDURE Elipsa(cx, cy: INTEGER; rx, ry: REAL; plin: BOOLEAN);
    VAR i, x0, y0, x1, y1: INTEGER; a: REAL;
  BEGIN
    x0 := cx + FLOOR(rx + 0.5); y0 := cy;
    FOR i := 1 TO 48 DO
      a := FLT(i) * 2.0 * Math.pi / 48.0;
      x1 := cx + FLOOR(rx * Math.cos(a) + 0.5); y1 := cy + FLOOR(ry * Math.sin(a) + 0.5);
      IF plin THEN Ecran.Triunghi(cx, cy, x0, y0, x1, y1) ELSE Ecran.Linie(x0, y0, x1, y1) END;
      x0 := x1; y0 := y1
    END
  END Elipsa;

  PROCEDURE CubIso(cx, cy, s, ct, cl, cr, cm: INTEGER);   (* cubul izometric: fata de sus, stanga, dreapta, muchiile *)
    VAR h, v: INTEGER;
  BEGIN
    h := s * 577 DIV 1000; v := s * 11 DIV 10;
    Ecran.Culoare(ct); Ecran.Triunghi(cx, cy - h, cx + s, cy, cx, cy + h); Ecran.Triunghi(cx, cy - h, cx, cy + h, cx - s, cy);
    Ecran.Culoare(cl); Ecran.Triunghi(cx - s, cy, cx, cy + h, cx, cy + h + v); Ecran.Triunghi(cx - s, cy, cx, cy + h + v, cx - s, cy + v);
    Ecran.Culoare(cr); Ecran.Triunghi(cx, cy + h, cx + s, cy, cx + s, cy + v); Ecran.Triunghi(cx, cy + h, cx + s, cy + v, cx, cy + h + v);
    Ecran.Culoare(cm); Ecran.Grosime(G1);
    Ecran.Linie(cx, cy - h, cx + s, cy); Ecran.Linie(cx + s, cy, cx, cy + h);
    Ecran.Linie(cx, cy + h, cx - s, cy); Ecran.Linie(cx - s, cy, cx, cy - h);
    Ecran.Linie(cx - s, cy, cx - s, cy + v); Ecran.Linie(cx, cy + h, cx, cy + h + v); Ecran.Linie(cx + s, cy, cx + s, cy + v);
    Ecran.Linie(cx - s, cy + v, cx, cy + h + v); Ecran.Linie(cx, cy + h + v, cx + s, cy + v)
  END CubIso;

  (* proiectia izometrica a celulei (x, y, z), ca in orga CRDA din HTML *)
  PROCEDURE Proiect(x, y, z, cx, cy: INTEGER; st: REAL; VAR px, py: INTEGER);
  BEGIN
    px := cx + FLOOR(FLT(x - y) * st) + (z - 3) * D(2);
    py := cy + FLOOR(FLT(x + y) * st * 0.577 * 0.5) - FLOOR(FLT(z) * st * 0.577 * 0.9)
  END Proiect;

  (* ---------- ceasul (ora Romaniei: UTC+2, vara UTC+3) ---------- *)

  PROCEDURE Bisect(a: INTEGER): BOOLEAN;
  BEGIN RETURN (a MOD 4 = 0) & ((a MOD 100 # 0) OR (a MOD 400 = 0))
  END Bisect;

  PROCEDURE ZileLuna(a, l: INTEGER): INTEGER;
    VAR r: INTEGER;
  BEGIN
    IF l = 2 THEN IF Bisect(a) THEN r := 29 ELSE r := 28 END
    ELSIF (l = 4) OR (l = 6) OR (l = 9) OR (l = 11) THEN r := 30
    ELSE r := 31
    END;
    RETURN r
  END ZileLuna;

  PROCEDURE Zile(a, l, z: INTEGER): INTEGER;   (* zile de la 1 ian 2010 *)
    VAR n, i: INTEGER;
  BEGIN
    n := 0;
    FOR i := 2010 TO a - 1 DO IF Bisect(i) THEN n := n + 366 ELSE n := n + 365 END END;
    FOR i := 1 TO l - 1 DO n := n + ZileLuna(a, i) END;
    RETURN n + z - 1
  END Zile;

  PROCEDURE UltimaDuminica(a, l: INTEGER): INTEGER;   (* 1 ian 2010 a fost vineri *)
    VAR d: INTEGER;
  BEGIN d := Zile(a, l, 31); RETURN d - (d + 5) MOD 7
  END UltimaDuminica;

  PROCEDURE Doi(v: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF v < 10 THEN Strings.Append("0", s) END; Strings.AppendInt(v, 0, s)
  END Doi;

  PROCEDURE Ceas;
    VAR t, a, sec: INTEGER;
  BEGIN
    t := Os.CurrentTime();
    IF t # ceasT THEN
      ceasT := t; a := 2010;
      WHILE t DIV 86400 >= Zile(a + 1, 1, 1) DO INC(a) END;
      IF (t >= UltimaDuminica(a, 3) * 86400 + 3600) & (t < UltimaDuminica(a, 10) * 86400 + 3600) THEN t := t + 3 * 3600
      ELSE t := t + 2 * 3600
      END;
      sec := t MOD 86400; ceasL := t;
      ceasS := ""; Doi(sec DIV 3600, ceasS); Strings.Append(":", ceasS); Doi(sec DIV 60 MOD 60, ceasS);
      Strings.Append(":", ceasS); Doi(sec MOD 60, ceasS)
    END
  END Ceas;

  PROCEDURE AcumLocal(): INTEGER;   (* 7·B v12: pentru mementouri *)
  BEGIN Ceas; RETURN ceasL
  END AcumLocal;

  (* ---------- asezarea pe ecran ---------- *)

  PROCEDURE Asaza;
    VAR ah, top: INTEGER;
  BEGIN
    W := Ecran.Latime(); H := Ecran.Inaltime(); clip0 := 0; clip1 := H;
    IF W # wPlin THEN wPlin := W; hPlin := H ELSIF H > hPlin THEN hPlin := H END;   (* 7·B v10: tastatura micsoreaza H *)
    dp := FLT(Ecran.Densitate()) / 100.0; IF dp < 1.0 THEN dp := 1.0 END;
    G1 := D(1); IF G1 < 1 THEN G1 := 1 END;
    barH := D(30); tbY := H - D(50);   (* 7·B v2: o singura banda de ferestre *)
    wx := D(6); wy := barH + D(6); ww := W - 2 * wx; wh := tbY - D(6) - wy; titH := D(34);
    bx := wx + D(10); by := wy + titH + D(8); bw := ww - D(20); bh := wh - titH - D(16);
    (* orga: nodurile deasupra, butoanele jos *)
    oBtnY := by + bh - D(36) - D(22);
    top := by; ah := oBtnY - D(8) - top;
    oSt := FLT(bw - D(16)) / 12.5;
    IF FLT(ah) / 7.0 < oSt THEN oSt := FLT(ah) / 7.0 END;
    oCx := bx + bw DIV 2; oCy := top + ah DIV 2 - FLOOR(0.17 * oSt);
    (* cubicum fs: cubul sus, lista dedesubt *)
    ah := bh * 38 DIV 100;
    cSt := FLT(bw - D(60)) / 12.5;
    IF FLT(ah - D(24)) / 7.0 < cSt THEN cSt := FLT(ah - D(24)) / 7.0 END;
    cCx := bx + bw DIV 2; cCy := by + ah DIV 2 - FLOOR(0.17 * cSt) + D(4);
    lY0 := by + ah + D(44); lY1 := by + bh - D(46); rowH := D(36)
  END Asaza;

  PROCEDURE TbBtn(i: INTEGER; VAR x, y, w, h: INTEGER);   (* 7·B v2: butoanele barei de jos, toate 8 pe o banda *)
    VAR g: INTEGER;
  BEGIN
    g := D(3); w := (W - 9 * g) DIV 8; h := D(42);
    x := g + i * (w + g); y := tbY + D(4)
  END TbBtn;

  (* ---------- shell: randurile ---------- *)

  PROCEDURE Rand1(col: INTEGER; s: ARRAY OF CHAR);
    VAR i: INTEGER;
  BEGIN
    IF nsl = NL THEN
      FOR i := 0 TO NL - 2 DO sl[i] := sl[i + 1]; slc[i] := slc[i + 1]; slCont[i] := slCont[i + 1] END;
      DEC(nsl)
    END;
    Strings.Copy(s, sl[nsl]); slc[nsl] := col; slCont[nsl] := rCont; INC(nsl)
  END Rand1;

  PROCEDURE Rand(col: INTEGER; s: ARRAY OF CHAR);   (* un rand de shell, impartit ca sa incapa pe latime *)
    VAR maxc, n, start, k: INTEGER; r: ARRAY LL OF CHAR;
  BEGIN
    IF D(shPt) * Av > 0 THEN maxc := bw * 100 DIV (D(shPt) * Av) ELSE maxc := 40 END;   (* 7·B v3: dupa marimea aleasa *)
    IF maxc < 10 THEN maxc := 10 ELSIF maxc > LL - 1 THEN maxc := LL - 1 END;
    n := Strings.Length(s); start := 0; rCont := FALSE;
    IF n = 0 THEN Rand1(col, "") END;
    WHILE start < n DO
      IF n - start <= maxc THEN k := n - start
      ELSE
        k := maxc;
        WHILE (k > 0) & (s[start + k] # " ") DO DEC(k) END;
        IF k = 0 THEN k := maxc END
      END;
      Strings.Extract(s, start, k, r); Rand1(col, r); rCont := TRUE;
      start := start + k;
      WHILE (start < n) & (s[start] = " ") DO INC(start) END
    END;
    rCont := FALSE
  END Rand;

  PROCEDURE Rearanjeaza;   (* 7·B v3: randurile din Shell, taiate din nou pe latimea noii marimi *)
    VAR i, n: INTEGER; b: ARRAY 800 OF CHAR;
  BEGIN
    n := nsl; FOR i := 0 TO n - 1 DO tl[i] := sl[i]; tc[i] := slc[i]; tCont[i] := slCont[i] END;
    nsl := 0; i := 0;
    WHILE i < n DO
      Strings.Copy(tl[i], b); INC(i);
      WHILE (i < n) & tCont[i] DO
        IF Strings.Length(b) + Strings.Length(tl[i]) < LEN(b) - 2 THEN Strings.Append(" ", b); Strings.Append(tl[i], b) END; INC(i)
      END;
      Rand(tc[i - 1], b)
    END
  END Rearanjeaza;

  PROCEDURE ScrieMarime;   (* marimea textului din Shell ramane in cub *)
    VAR t: ARRAY 16 OF CHAR; k: INTEGER;
  BEGIN t := ""; Strings.AppendInt(shPt, 0, t); k := CFS.Scrie("shell.txt", t)
  END ScrieMarime;

  PROCEDURE TuraSh(): INTEGER;   (* tura pe care ruleaza shell-ul scris in Z7 (sh.z7l), -1 = nu ruleaza *)
    VAR t, r: INTEGER; n: ARRAY 32 OF CHAR;
  BEGIN
    r := -1; FOR t := 0 TO Sal.NP - 1 DO Sal.Nume(t, n); IF (n = "sh") & (r < 0) THEN r := t END END;
    RETURN r
  END TuraSh;

  PROCEDURE CatreSh(t: INTEGER; l: ARRAY OF CHAR);   (* randul ajunge la sh litera cu litera, apoi 10 *)
    VAR i: INTEGER; s: ARRAY LL OF CHAR;
  BEGIN
    s := "∿ sh > "; Strings.Append(l, s); Rand(Am(214, 150, 84, 0.6), s);
    i := 0; WHILE (i < LEN(l)) & (l[i] # 0X) DO Sal.Posta(t, ORD(l[i])); INC(i) END;
    Sal.Posta(t, 10)
  END CatreSh;

  (* ---------- orga ---------- *)

  PROCEDURE NodP(i: INTEGER; VAR px, py: INTEGER);
  BEGIN Proiect(i MOD 7, i DIV 7 MOD 7, i DIV 49, oCx, oCy, oSt, px, py)
  END NodP;

  PROCEDURE Hz(i: INTEGER): INTEGER;   (* frecventa nodului: nota x din Z7, octava z MOD 3 *)
    VAR k, m: INTEGER;
  BEGIN
    m := 1; FOR k := 1 TO i DIV 49 MOD 3 DO m := m * 2 END;
    RETURN FLOOR(z7[i MOD 7] * FLT(m) + 0.5)
  END Hz;

  PROCEDURE Aprinse(): INTEGER;
    VAR i, n: INTEGER;
  BEGIN n := 0; FOR i := 0 TO 342 DO IF on[i] THEN INC(n) END END; RETURN n
  END Aprinse;

  PROCEDURE Acord;   (* toate nodurile aprinse deodata (cel mult 16, cat duce sintetizatorul) *)
    VAR i, k: INTEGER;
  BEGIN
    k := 0;
    FOR i := 0 TO 342 DO IF on[i] & (k < 16) THEN Sunet.Nota(Hz(i), 600, 28); INC(k) END END
  END Acord;

  PROCEDURE Mesaj(s: ARRAY OF CHAR);
  BEGIN Strings.Copy(s, mesaj); mesajPana := acum + 2500
  END Mesaj;

  PROCEDURE SalveazaAcord;   (* acordul din orga devine fisier in Cubicum FS: acord-N.crda *)
    VAR i, k: INTEGER; nume: ARRAY 32 OF CHAR; c: ARRAY LC OF CHAR; s: ARRAY 80 OF CHAR;
  BEGIN
    IF Aprinse() = 0 THEN Mesaj("nimic aprins · atinge noduri întâi")
    ELSE
      k := 1;
      REPEAT nume := "acord-"; Strings.AppendInt(k, 0, nume); Strings.Append(".crda", nume); INC(k)
      UNTIL CFS.Gaseste(nume) < 0;
      c := "";
      FOR i := 0 TO 342 DO
        IF on[i] & (Strings.Length(c) < LC - 6) THEN
          IF c # "" THEN Strings.Append(" ", c) END;
          Strings.AppendInt(i, 0, c)
        END
      END;
      k := CFS.Scrie(nume, c);
      IF k >= 0 THEN
        s := "salvat: "; Strings.Append(nume, s); Strings.Append(" → cfs://", s);
        CFS.AdresaText(k, nume); Strings.Append(nume, s); Mesaj(s);
        Sunet.Nota(370, 200, 35)
      ELSE Mesaj("n-a mers · vezi ash în shell")
      END
    END
  END SalveazaAcord;

  PROCEDURE IncarcaAcord(c: ARRAY OF CHAR);   (* "12 57 300" -> nodurile aprinse *)
    VAR i, v: INTEGER; cifre: BOOLEAN;
  BEGIN
    FOR i := 0 TO 342 DO on[i] := FALSE END;
    arp := FALSE; v := 0; cifre := FALSE; i := 0;
    WHILE (i < LEN(c)) & (c[i] # 0X) DO
      IF (c[i] >= "0") & (c[i] <= "9") THEN v := v * 10 + ORD(c[i]) - ORD("0"); cifre := TRUE
      ELSE IF cifre & (v < 343) THEN on[v] := TRUE END; v := 0; cifre := FALSE
      END;
      INC(i)
    END;
    IF cifre & (v < 343) THEN on[v] := TRUE END
  END IncarcaAcord;

  (* ---------- procesele si alchimistul ---------- *)


  PROCEDURE NumePkg(i: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN Strings.Copy(anume[i], s); Strings.Append(".pkg", s)
  END NumePkg;

  PROCEDURE StareAlch(i: INTEGER): INTEGER;   (* 0 disponibil, 1 se instaleaza, 2 instalat (= fisier in Cubicum FS) *)
    VAR s: ARRAY 32 OF CHAR; r: INTEGER;
  BEGIN
    NumePkg(i, s);
    IF instEu = i THEN r := 1 ELSIF CFS.Gaseste(s) >= 0 THEN r := 2 ELSE r := 0 END;
    RETURN r
  END StareAlch;

  (* ---------- comenzile shell-ului ---------- *)

  PROCEDURE Tinta(i: INTEGER; VAR t: ARRAY OF CHAR);   (* primul rand al unei scurtaturi .app: pe cine porneste *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    CFS.Continut(i, c); k := 0;
    WHILE (k < LEN(t) - 1) & (c[k] # 0X) & (c[k] # 0AX) DO t[k] := c[k]; INC(k) END;
    t[k] := 0X
  END Tinta;

  PROCEDURE PornesteJoc;   (* v2.7: Cub Roller ia ecranul; cand iese, ne intoarcem unde eram *)
  BEGIN
    IF tastatura THEN tastatura := FALSE; Ecran.Tastatura(FALSE) END;
    CubRoller.Porneste; joc := TRUE;
    Rand(cCyan, "▶ Cub Roller · ✕ din dreapta sus te întoarce în cub")
  END PornesteJoc;

  PROCEDURE PornesteMesh;   (* v2.9: cele 343 de cuburi mici iau ecranul *)
  BEGIN
    IF tastatura THEN tastatura := FALSE; Ecran.Tastatura(FALSE) END;
    Mesh343.Porneste; mesh := TRUE;
    Rand(cCyan, "▶ 343 de cuburi · ✕ din dreapta sus te întoarce în cub")
  END PornesteMesh;

  PROCEDURE LansezApp(i: INTEGER);   (* scurtatura i din cub: porneste aplicatia ei *)
    VAR t: ARRAY 128 OF CHAR; n: ARRAY 32 OF CHAR; s: ARRAY LL OF CHAR;
  BEGIN
    CFS.Nume(i, n); Tinta(i, t);
    IF Strings.Pos("cubicum:roller", t, 0) = 0 THEN PornesteJoc   (* v2.7: programul ruleaza in cub, nu e alta aplicatie *)
    ELSIF Ecran.Lanseaza(t) THEN s := "↗ deschid "; Strings.Append(n, s); Rand(cCyan, s); Mesaj(s)
    ELSE s := "✕ nu e instalată pe telefon: "; Strings.Append(n, s); Strings.Append(" (", s); Strings.Append(t, s); Strings.Append(")", s);
      Rand(cRed, s); Mesaj(s)
    END
  END LansezApp;

  PROCEDURE Numar(a: ARRAY OF CHAR; i: INTEGER): INTEGER;   (* numarul zecimal din a, de la pozitia i *)
    VAR n: INTEGER;
  BEGIN
    n := 0; WHILE (i < LEN(a)) & (a[i] = " ") DO INC(i) END;
    WHILE (i < LEN(a)) & (a[i] >= "0") & (a[i] <= "9") DO n := n * 10 + ORD(a[i]) - ORD("0"); INC(i) END;
    RETURN n
  END Numar;

  PROCEDURE RolerSpune(t, n: INTEGER; emis: BOOLEAN);
    VAR s: ARRAY LL OF CHAR;
  BEGIN
    s := "Roler · colțul "; Strings.AppendInt(Tor7.Colt(), 0, s); Strings.Append(" · treapta ", s); Strings.AppendInt(t, 0, s);
    Strings.Append(" = ", s); Strings.Append(notaN[t MOD 7], s); Strings.AppendInt(t DIV 7 + 2, 0, s);
    Strings.Append(" (", s); Strings.AppendInt(Tor7.Hz(t), 0, s); Strings.Append(" Hz)", s); Rand(cGold, s);
    IF emis THEN s := "  a emis: "; Strings.AppendInt(n, 0, s); Strings.Append(" celule au rezonat și și-au schimbat starea", s); Rand(cCyan, s) END;
    IF emis THEN s := "  acum: " ELSE s := "  rezonează: " END;
    Strings.AppendInt(Tor7.Asculta(t), 0, s); Strings.Append(" active · ", s); Strings.AppendInt(Tor7.Stinse(), 0, s);
    Strings.Append(" stinse · comă (aceeași notă, altă octavă): ", s); Strings.AppendInt(Tor7.Coma(), 0, s); Rand(cCyan, s);
    IF emis THEN Sunet.Nota(Tor7.Hz(t), 500, 35) END
  END RolerSpune;

  PROCEDURE DataText(t: INTEGER; VAR s: ARRAY OF CHAR);   (* 20 oct 2026, 14:05 (ora Romaniei) *)
    VAR lt, a, l, z: INTEGER; lun: ARRAY 4 OF CHAR;
  BEGIN
    lt := CFS.Local(t); CFS.Data(lt DIV 86400, a, l, z);
    CASE l OF 1: lun := "ian" | 2: lun := "feb" | 3: lun := "mar" | 4: lun := "apr" | 5: lun := "mai" | 6: lun := "iun"
    | 7: lun := "iul" | 8: lun := "aug" | 9: lun := "sep" | 10: lun := "oct" | 11: lun := "nov" | 12: lun := "dec" END;
    Strings.AppendInt(z, 0, s); Strings.Append(" ", s); Strings.Append(lun, s); Strings.Append(" ", s); Strings.AppendInt(a, 0, s);
    Strings.Append(", ", s); Doi(lt MOD 86400 DIV 3600, s); Strings.Append(":", s); Doi(lt MOD 3600 DIV 60, s)
  END DataText;

  PROCEDURE OpalCeas;   (* Opal: ceasul pe niveluri *)
    VAR k, p, v, t: INTEGER; s: ARRAY LL OF CHAR;
  BEGIN
    s := "Opal · ciclul w = "; Strings.AppendInt(Tor7.Ciclu(), 0, s); Strings.Append(" · bătaia ", s);
    Strings.AppendInt(Tor7.BataieOra(), 0, s); Strings.Append("/1155 · colțul Do ", s); Strings.AppendInt(Tor7.Colt(), 0, s);
    Rand(cGold, s);
    s := "  torul s-a născut "; IF Tor7.Nascut() >= 0 THEN DataText(Tor7.Nascut(), s) ELSE Strings.Append("(nu știu când)", s) END;
    Strings.Append(" · Burn-uri: ", s); Strings.AppendInt(Tor7.Arderi(), 0, s); Strings.Append(" · ceasul nu arde", s); Rand(cText, s);
    FOR k := 0 TO 4 DO
      IF k = 0 THEN p := 1 ELSIF k = 1 THEN p := 3 ELSIF k = 2 THEN p := 5 ELSIF k = 3 THEN p := 7 ELSE p := 11 END;
      s := "  acul "; Strings.AppendInt(p, 2, s); Strings.Append(" → locul ", s); Strings.AppendInt(Tor7.Pozitie(p), 0, s);
      v := Tor7.Opal(p); Strings.Append(" · citit ", s);
      IF v < 0 THEN Strings.Append("–", s) ELSE Strings.AppendInt(v, 0, s) END;
      Strings.Append(" · emis ", s); Strings.AppendInt(Tor7.Emisii(p), 0, s);
      Rand(cCyan, s)
    END;
    t := Tor7.Treapta(0);
    s := "  adresa 0 stă pe locul "; Strings.AppendInt(Tor7.Fizic(0), 0, s); Strings.Append(" · cântă ", s);
    Strings.Append(notaN[t MOD 7], s); Strings.AppendInt(t DIV 7 + 2, 0, s); Strings.Append(" (", s);
    Strings.AppendInt(Tor7.Hz(t), 0, s); Strings.Append(" Hz)", s); Rand(cText, s)
  END OpalCeas;

  (* ---------- muzica: Eula ♪ in Shell (v1.6) ---------- *)
  PROCEDURE Scris(col: INTEGER; t: ARRAY OF CHAR);   (* un text cu mai multe randuri (despartite de 0AX) *)
    VAR i, j, n: INTEGER; r: ARRAY 1024 OF CHAR;
  BEGIN
    n := Strings.Length(t); i := 0;
    WHILE i <= n DO
      j := 0; WHILE (i < n) & (t[i] # 0AX) DO IF j < LEN(r) - 1 THEN r[j] := t[i]; INC(j) END; INC(i) END;
      r[j] := 0X; IF (j > 0) OR (i < n) THEN Rand(col, r) END; INC(i)
    END
  END Scris;

  PROCEDURE CantaMuz;   (* textul apare acum; sunetul se randeaza peste doua cadre *)
  BEGIN IF Te.nev > 0 THEN deCantat := 2; Rand(Am(214, 150, 84, 0.6), "  (pregătesc sunetul… · stop îl oprește)") END
  END CantaMuz;

  PROCEDURE Sonor(nume: ARRAY OF CHAR);   (* cod tine textul *)
  BEGIN
    E7Sonor.Sonifica(cod, nume, TRUE); Rand(cPurple, "Eula ♪:"); Scris(cText, Te.txt); CantaMuz
  END Sonor;

  PROCEDURE GasesteProg(VAR a: ARRAY OF CHAR): INTEGER;   (* ca run: numele, apoi .z7l, apoi .z7 *)
    VAR i: INTEGER; m: ARRAY 64 OF CHAR;
  BEGIN
    i := CFS.Gaseste(a);
    IF (i < 0) & (Strings.Pos(".", a, 0) < 0) THEN
      Strings.Copy(a, m); Strings.Append(".z7l", m); i := CFS.Gaseste(m);
      IF i < 0 THEN Strings.Copy(a, m); Strings.Append(".z7", m); i := CFS.Gaseste(m) END;
      IF i >= 0 THEN Strings.Copy(m, a) END
    END;
    RETURN i
  END GasesteProg;

  PROCEDURE Muzica(l: ARRAY OF CHAR): BOOLEAN;   (* TRUE daca linia era pentru Eula ♪ *)
    VAR f, rest, rf: ARRAY 256 OF CHAR; s: ARRAY LL OF CHAR; i, n: INTEGER; da: BOOLEAN;
  BEGIN
    Te.Fold(l, f); Tx.Trim(f); da := TRUE;
    Tx.Copy(l, rest); Tx.Trim(rest);   (* restul liniei, dupa primul cuvant *)
    i := 0; WHILE (rest[i] # 0X) & ~Tx.Spatiu(rest[i]) DO INC(i) END;
    WHILE (rest[i] # 0X) & Tx.Spatiu(rest[i]) DO INC(i) END;
    Tx.Sub(rest, i, Tx.Len(rest), rest); Te.Fold(rest, rf);
    IF Tx.Eq(f, "stop") OR Tx.Eq(f, "taci") OR Tx.Eq(f, "liniste") THEN deCantat := 0; Sunet.Liniste; Rand(cGold, "(oprit)")
    ELSIF Tx.Incepe(f, "compune") OR Tx.Incepe(f, "improvizeaza") THEN
      E7Comp.Comanda(l); Rand(cPurple, "Eula ♪:"); Scris(cText, Te.txt);
      s := "  (instrument: "; Strings.Append(E7Synth.INSTR[0], s); Strings.Append(", ♩=100)", s); Rand(Am(214, 150, 84, 0.6), s);
      CantaMuz
    ELSIF Tx.Incepe(f, "sonifica") THEN
      IF Tx.Incepe(rf, "tura") THEN
        n := Numar(rf, 4) - 1;   (* 7·B: tura 1..7 *)
        IF (n >= 0) & (n < Sal.NP) THEN Sal.Nume(n, f) ELSE f := "" END;
        IF f = "" THEN s := "pe tura "; Strings.AppendInt(n + 1, 0, s); Strings.Append(" nu rulează nimic", s); Rand(cRed, s)
        ELSE
          i := GasesteProg(f);
          IF i < 0 THEN s := "programul de pe tura nu mai e în cub: "; Strings.Append(f, s); Rand(cRed, s)
          ELSE CFS.Continut(i, cod); s := "(cânt programul de pe tura "; Strings.AppendInt(n, 0, s); Strings.Append(": ", s);
            Strings.Append(f, s); Strings.Append(")", s); Rand(cGold, s); Sonor(f)
          END
        END
      ELSIF Tx.Incepe(rf, "gresit") THEN Tx.Copy(E7Sonor.GRESIT, cod); Scris(cText, cod); Sonor("exemplul greșit")
      ELSIF (rf[0] = 0X) OR Tx.Incepe(rf, "exemplu") THEN Tx.Copy(E7Sonor.EXEMPLU, cod); Scris(cText, cod); Sonor("exemplul")
      ELSE
        i := GasesteProg(rest);
        IF i < 0 THEN s := "nu e în cub: "; Strings.Append(rest, s); Rand(cRed, s)
        ELSE CFS.Continut(i, cod); s := "(cânt "; Strings.Append(rest, s); Strings.Append(" din cub)", s); Rand(cGold, s); Sonor(rest)
        END
      END
    ELSIF Tx.Incepe(f, "muzica") & ((f[6] = 0X) OR (f[6] = " ")) THEN
      IF rest[0] = 0X THEN Rand(cRed, "muzica ce? de pildă: muzica acordul de La minor · muzica gama Re major")
      ELSIF Te.Raspunde(rest) THEN Rand(cPurple, "Eula ♪:"); Scris(cText, Te.txt); CantaMuz
      ELSE s := "Eula ♪ nu știe încă asta: "; Strings.Append(rest, s); Rand(cRed, s)
      END
    ELSIF Te.Raspunde(l) THEN Rand(cPurple, "Eula ♪:"); Scris(cText, Te.txt); CantaMuz   (* o intrebare de muzica scrisa direct *)
    ELSE da := FALSE
    END;
    RETURN da
  END Muzica;

  (* ---------- fisierele telefonului: harta pe torul 7^7 (v1.8) si copiile in cub (v1.7) ---------- *)
  PROCEDURE Ko(m: INTEGER; VAR s: ARRAY OF CHAR);   (* 12 octeți · 3,4 KB · 2,1 MB · 1,2 GB *)
  BEGIN
    IF m < 1024 THEN Strings.AppendInt(m, 0, s); Strings.Append(" octeți", s)
    ELSIF m < 1048576 THEN Strings.AppendInt(m DIV 1024, 0, s); Strings.Append(",", s); Strings.AppendInt(m MOD 1024 * 10 DIV 1024, 0, s); Strings.Append(" KB", s)
    ELSIF m < 1073741824 THEN Strings.AppendInt(m DIV 1048576, 0, s); Strings.Append(",", s); Strings.AppendInt(m MOD 1048576 DIV 104858, 0, s); Strings.Append(" MB", s)
    ELSE Strings.AppendInt(m DIV 1073741824, 0, s); Strings.Append(",", s); Strings.AppendInt(m MOD 1073741824 DIV 107374183, 0, s); Strings.Append(" GB", s)
    END
  END Ko;

  PROCEDURE Mii(v: INTEGER; VAR s: ARRAY OF CHAR);   (* 48.213 *)
    VAR t: ARRAY 16 OF CHAR;
  BEGIN
    IF v >= 1000 THEN Mii(v DIV 1000, s); Strings.Append(".", s); t := ""; Strings.AppendInt(v MOD 1000 + 1000, 0, t); Strings.Extract(t, 1, 3, t); Strings.Append(t, s)
    ELSE Strings.AppendInt(v, 0, s)
    END
  END Mii;

  PROCEDURE Adu(nume, cale: ARRAY OF CHAR);   (* un fisier de pe telefon copiat in cub; spune unde a ajuns *)
    VAR i: INTEGER; s, t: ARRAY LL OF CHAR; c: ARRAY 4 OF CHAR;
  BEGIN
    i := CFS.Aduce(nume, cale);
    IF i >= 0 THEN
      CFS.Nume(i, t); s := "⇩ adus în cub: "; Strings.Append(t, s); Strings.Append(" · ", s); Ko(CFS.Marime(i), s);
      Strings.Append(" · ", s); Strings.AppendInt(CFS.Celule(i), 0, s);
      IF CFS.Celule(i) = 1 THEN Strings.Append(" celulă", s) ELSE Strings.Append(" celule", s) END;
      Strings.Append(" de la cfs://", s); CFS.AdresaText(i, t); Strings.Append(t, s);
      CFS.Continut(i, c); IF c[0] = 0X THEN Strings.Append(" · nu e text", s) END;
      Rand(cGreen, s); Sunet.Nota(370, 200, 30)
    ELSE CFS.Ash(CFS.NrAsh() - 1, t); s := "✕ "; Strings.Append(t, s); Rand(cRed, s)
    END
  END Adu;

  PROCEDURE Voie(): BOOLEAN;   (* dosarul Download (si voia la fisiere) *)
    VAR ok: BOOLEAN;
  BEGIN
    ok := Ecran.Descarcari(dlDosar);
    IF ~ok THEN Rand(cYel, "Cubicum cere voie la fișierele telefonului: răspunde pe ecran, apoi încearcă iar") END;
    RETURN ok
  END Voie;

  PROCEDURE Download(filtru: ARRAY OF CHAR);   (* dosarul Download al telefonului, numerotat (doar cele cu filtru in nume) *)
    VAR i, k, m: INTEGER; s: ARRAY LL OF CHAR; nm: ARRAY 64 OF CHAR;
  BEGIN
    lista := 0; dlN := 0;
    IF Voie() THEN
      k := Ecran.Intrari(dlDosar);
      IF k < 0 THEN Rand(cRed, "nu pot citi Download")
      ELSE
        FOR i := 0 TO k - 1 DO
          m := Ecran.Intrare(i, nm);
          IF (m >= 0) & (dlN < LEN(dlNume)) & ((filtru = "") OR (Strings.Pos(filtru, nm, 0) >= 0)) THEN
            Strings.Copy(nm, dlNume[dlN]); dlMar[dlN] := m; INC(dlN)
          END
        END;
        FOR i := 0 TO dlN - 1 DO
          s := ""; Strings.AppendInt(i + 1, 3, s); Strings.Append("  ", s); Strings.Append(dlNume[i], s); Strings.Append(" · ", s);
          Ko(dlMar[i], s); Rand(cText, s)
        END;
        s := "Download · "; Mii(dlN, s); Strings.Append(" fișiere", s);
        IF filtru # "" THEN Strings.Append(" cu „", s); Strings.Append(filtru, s); Strings.Append("”", s) END;
        Strings.Append(" · adu N îl copiază în cub · vezi N îl arată", s); Rand(cGold, s)
      END
    END
  END Download;

  PROCEDURE HartaMers;   (* cat a mers harta *)
    VAR s: ARRAY LL OF CHAR;
  BEGIN
    s := "  … "; Mii(CFS.nh, s); Strings.Append(" fișiere, ", s); Mii(CFS.dq, s); Strings.Append(" din ", s); Mii(CFS.nd, s);
    Strings.Append(" dosare", s); Rand(Am(214, 150, 84, 0.6), s)
  END HartaMers;

  PROCEDURE Harta;   (* harta din nou: tot telefonul, de la radacina lui (dosarul de deasupra lui Download) *)
    VAR r: ARRAY 256 OF CHAR; k: INTEGER;
  BEGIN
    IF CFS.scan THEN HartaMers
    ELSIF Voie() THEN
      Strings.Copy(dlDosar, r); k := Strings.Length(r) - 1;
      WHILE (k > 0) & (r[k] # "/") DO DEC(k) END;
      IF k > 0 THEN r[k] := 0X END;
      CFS.HartaPorneste(r); hartaDe := acum; hartaSpus := acum; cur := 3;
      s0 := "◉ fac harta telefonului, de la "; Strings.Append(r, s0); Strings.Append(" · pe torul 7⁷ = 823.543 de celule", s0); Rand(cCyan, s0)
    END
  END Harta;

  PROCEDURE HartaGata;
    VAR s: ARRAY 400 OF CHAR;
  BEGIN
    s := "◉ harta telefonului: "; Mii(CFS.nh, s); Strings.Append(" fișiere în ", s); Mii(CFS.nd, s);
    Strings.Append(" dosare, fiecare pe celula lui de pe torul 7⁷ · ", s); Mii(CFS.ciocniri, s);
    Strings.Append(" au găsit celula ocupată și au mers mai departe · ", s); Strings.AppendInt((acum - hartaDe) DIV 1000, 0, s);
    Strings.Append(" s", s); Rand(cGreen, s);
    IF CFS.plin THEN s := "  oprită: încap cel mult "; Mii(CFS.MaxH, s); Strings.Append(" de fișiere", s); Rand(cRed, s) END;
    IF CFS.sarite > 0 THEN s := "  dosare sărite (prea multe sau cale prea lungă): "; Mii(CFS.sarite, s); Rand(cYel, s) END;
    Rand(cText, "  caut <nume> · vezi N · adu N · celula x.y.z.a.b.c.d");
    Sunet.Nota(392, 300, 30)
  END HartaGata;

  PROCEDURE Sens(c: INTEGER; VAR s: ARRAY OF CHAR);   (* ce inseamna fiecare cifra a adresei *)
    VAR d: ARRAY 7 OF INTEGER;
  BEGIN
    CFS.Cifre(c, d); s := "  nume "; Strings.AppendInt(d[0] + 1, 0, s); Strings.Append(" · tip ", s); Strings.AppendInt(d[1] + 1, 0, s);
    Strings.Append(" · zi ", s); Strings.AppendInt(d[2] + 1, 0, s); Strings.Append(" · dosar ", s); Strings.AppendInt(d[3] + 1, 0, s);
    Strings.Append(" · mărime ", s); Strings.AppendInt(d[4] + 1, 0, s); Strings.Append(" · lună ", s); Strings.AppendInt(d[5] + 1, 0, s);
    Strings.Append(" · oră ", s); Strings.AppendInt(d[6] + 1, 0, s)
  END Sens;

  PROCEDURE RandHarta(nr, j: INTEGER);   (* un fisier de pe harta, cu numarul lui din lista *)
    VAR s: ARRAY 1500 OF CHAR; t: ARRAY 1100 OF CHAR;
  BEGIN
    s := ""; IF nr > 0 THEN Strings.AppendInt(nr, 3, s); Strings.Append("  ", s) END;
    CFS.HNume(j, t); Strings.Append(t, s); Strings.Append(" · ", s); Ko(CFS.HMarime(j), s);
    Strings.Append(" · cfs://", s); CFS.CelText(CFS.HCel(j), t); Strings.Append(t, s);
    CFS.HDosar(j, t); Strings.Append(" · /", s); Strings.Append(t, s); Rand(cText, s)
  END RandHarta;

  PROCEDURE Caut(a: ARRAY OF CHAR);
    VAR i, tot: INTEGER; s: ARRAY LL OF CHAR;
  BEGIN
    IF CFS.nh = 0 THEN Rand(cYel, "harta e goală · scrie întâi harta")
    ELSE
      tot := CFS.Cauta(a, gasite, ng); lista := 1;
      FOR i := 0 TO ng - 1 DO RandHarta(i + 1, gasite[i]) END;
      s := "caut „"; Strings.Append(a, s); Strings.Append("”: ", s); Mii(tot, s); Strings.Append(" pe hartă", s);
      IF tot > ng THEN Strings.Append(", arăt primele ", s); Strings.AppendInt(ng, 0, s) END;
      Strings.Append(" · vezi N · adu N", s); Rand(cGold, s)
    END
  END Caut;

  PROCEDURE Ales(a: ARRAY OF CHAR; VAR cale, nume: ARRAY OF CHAR; VAR j: INTEGER): BOOLEAN;
    (* N din ultima lista (download sau caut), sau un nume din Download; j = pe harta (-1 = nu) *)
    VAR i, k: INTEGER; ok: BOOLEAN;
  BEGIN
    ok := FALSE; j := -1; k := -1;
    IF (a[0] >= "0") & (a[0] <= "9") THEN k := Numar(a, 0) - 1 END;
    IF (lista = 1) & (k >= 0) THEN
      IF k < ng THEN j := gasite[k]; CFS.HCale(j, cale); CFS.HNume(j, nume); ok := TRUE ELSE Rand(cRed, "nu e în listă · caută întâi") END
    ELSIF k >= 0 THEN
      IF k < dlN THEN Strings.Copy(dlNume[k], nume); ok := TRUE ELSE Rand(cRed, "nu e în listă · scrie întâi download sau caut") END
    ELSE Strings.Copy(a, nume); ok := TRUE;
      FOR i := 0 TO dlN - 1 DO IF dlNume[i] = a THEN Strings.Copy(dlNume[i], nume) END END
    END;
    IF ok & (j < 0) THEN
      IF (dlDosar = "") & ~Voie() THEN ok := FALSE
      ELSE Strings.Copy(dlDosar, cale); Strings.Append("/", cale); Strings.Append(nume, cale)
      END
    END;
    IF ok & ~Files.Exists(cale) THEN
      ok := FALSE; Strings.Copy("nu e pe telefon: ", cod); Strings.Append(nume, cod);
      Strings.Append(" · scrie numărul din listă, de pildă vezi 3 sau adu 3 (lista vine din caut sau download)", cod); Rand(cRed, cod)
    END;
    RETURN ok
  END Ales;

  PROCEDURE AduDin(a: ARRAY OF CHAR);   (* adu N / adu nume *)
    VAR cale: ARRAY 1300 OF CHAR; nm: ARRAY 256 OF CHAR; j: INTEGER;
  BEGIN IF Ales(a, cale, nm, j) THEN Adu(nm, cale) END
  END AduDin;

  PROCEDURE Vezi(a: ARRAY OF CHAR);   (* inceputul fisierului de pe telefon, citit de acolo (nu copiat) *)
    VAR cale: ARRAY 1300 OF CHAR; nm: ARRAY 256 OF CHAR; j, k, nb: INTEGER; g: Files.File; b: ARRAY LC OF BYTE;
      t: ARRAY LC OF CHAR; s: ARRAY LL OF CHAR; r: ARRAY LL OF CHAR;
  BEGIN
    IF Ales(a, cale, nm, j) THEN
      IF j >= 0 THEN RandHarta(0, j); Sens(CFS.HCel(j), s); Rand(cCyan, s) END;
      g := Files.Open(cale);
      IF g = NIL THEN s := "nu pot citi: "; Strings.Append(nm, s); Rand(cRed, s)
      ELSE
        nb := 0; Files.ReadBytes(g, b, nb); IF nb < 0 THEN nb := 0 END; IF nb > Files.Size(g) THEN nb := Files.Size(g) END;
        IF CFS.TextUtf8(b, nb, t) THEN
          j := 0; nb := Strings.Length(t); k := 0;
          WHILE (j < nb) & (k < 30) DO
            r := "  "; WHILE (j < nb) & (t[j] # 0AX) DO IF Strings.Length(r) < LL - 3 THEN Strings.AppendChar(t[j], r) END; INC(j) END;
            Rand(cText, r); INC(j); INC(k)
          END;
          s := "  (citit de pe telefon: "; Ko(Files.Size(g), s); Strings.Append("; aici e doar începutul)", s); Rand(cGold, s)
        ELSE s := "  nu e text · "; Ko(Files.Size(g), s); Strings.Append(" · stă pe telefon, pe hartă doar adresa", s); Rand(cGold, s)
        END;
        Files.Close(g)
      END
    END
  END Vezi;

  PROCEDURE Celula(a: ARRAY OF CHAR);   (* ce sta la adresa x.y.z.a.b.c.d *)
    VAR c, v: INTEGER; s: ARRAY LL OF CHAR; t: ARRAY 64 OF CHAR;
  BEGIN
    c := CFS.DinText(a);
    IF c < 0 THEN Rand(cRed, "adresa are 7 cifre de la 0 la 6: celula 3.6.2.0.4.1.5")
    ELSE
      v := CFS.LaCelula7(c); s := "cfs://"; CFS.CelText(c, t); Strings.Append(t, s);
      IF v = -1 THEN Strings.Append(" · liberă", s); Rand(cText, s)
      ELSIF v >= 0 THEN
        CFS.Nume(v, t); Strings.Append(" · ", s); Strings.Append(t, s);
        IF CFS.EsteCap7(c) THEN Strings.Append(" (în cub)", s) ELSE Strings.Append(" (o bucată a lui)", s) END; Rand(cGold, s)
      ELSE Rand(cGold, s); RandHarta(0, -v - 2)
      END;
      Sens(c, s); Rand(cCyan, s)
    END
  END Celula;

  PROCEDURE Exec(k: INTEGER);
    VAR i, j: INTEGER; s: ARRAY LL OF CHAR; t: ARRAY LL OF CHAR; cnt: ARRAY 8 OF INTEGER;
  BEGIN
    Strings.Copy(cmd[k], ultimaCmd); scroll[3] := 0;
    s := "Z₇ > "; Strings.Append(cmd[k], s); Rand(Am(214, 150, 84, 0.6), s);
    Sunet.Nota(220, 60, 18);
    IF k = 0 THEN
      Rand(cCyan, "CUBICUM OS Shell Z₇ · comenzi disponibile:");
      Rand(cGold, "  z7 · ls · ps · ash · cube · cfs · ver · who · clear");
      Rand(cGold, "  scrise: run X · kill N · burn · app X · cat X · edit X · rm X");
      Rand(cGold, "  programe: .z7 asamblare · .z7l limbajul Z7 · run sh = shell-ul pe spirală");
      Rand(cGold, "  ceas = Opal: ciclul, bătaia, acele 1 3 5 7 11 · run trandafir");
      Rand(cGold, "  Roler: do N = colțul lui (0..127) · roler T = ascultă treapta T · emite T S · run roler");
      Rand(cGold, "  memoria care răspunde la notă: AMINTESTE(t) în Z7 · run amintire · ceasul nu arde la burn");
      Rand(cGold, "  Prolog: run familie, apoi ?- bunic(ion, N). · run liste · run bunici");
      Rand(cGold, "  noi: edit X = editorul · treaz · salveaza tot · restaureaza · copiaza · lipeste · ↑ · help comanda");
      Rand(cGold, "  aplicații Z7 cu fereastră: run bile · run ceas · run desen · help app (cum îți scrii una)");
      Rand(cGold, "  Eula ♪: muzica acordul de La minor · compune în Re minor din pion · sonifica sh · sonifica tura 1 · stop");
      Rand(cGold, "  telefonul: harta = tot telefonul pe torul 7⁷ · caut nume · vezi N · celula x.y.z.a.b.c.d");
      Rand(cGold, "  copii în cub: adu = alegi fișiere · download [text] · adu N");
      Rand(cText, "  atinge rândul Z₇ > ca să apară tastatura · toate comenzile: cat comenzi.txt")
    ELSIF k = 1 THEN Rand(cGold, "CUBICUM 7·B · baza 1–7 · solzi · joc · Styx între cuburi (styx leaga IP) · Tor7 în 7 grupe · Prolog în Z7 (cu variabilele programului) · Salamandra + Tor7 (7⁷ celule) · Opal (ceasul nu arde) · Roler · AMINTESTE · Eula ♪ · Cubicum FS pe 7⁷ · Oberon")
    ELSIF k = 2 THEN Rand(cCyan, "jahbalon@cubicum · mason solomonar · pictor")
    ELSIF k = 3 THEN
      Rand(cGold, "Cubicum FS · fără căi: 8 rădăcini, colțurile cubului");
      FOR j := 0 TO 7 DO cnt[j] := 0 END;
      FOR i := 0 TO CFS.N() - 1 DO INC(cnt[CFS.Radacina(i)]) END;
      FOR j := 0 TO 3 DO
        s := "◢ "; CFS.NumeRadacina(2 * j, t); Strings.Append(t, s); Strings.Append(" : ", s);
        Strings.AppendInt(cnt[2 * j], 0, s); Strings.Append("      ◢ ", s);
        CFS.NumeRadacina(2 * j + 1, t); Strings.Append(t, s); Strings.Append(" : ", s); Strings.AppendInt(cnt[2 * j + 1], 0, s);
        Rand(cText, s)
      END
    ELSIF k = 4 THEN
      Rand(cGold, "    1 salamandra   (nucleul, Oul)");
      FOR i := 0 TO Sal.NP - 1 DO
        IF Sal.Stare(i) # Sal.Liber THEN
          s := ""; Strings.AppendInt(Sal.Pid(i), 5, s); Strings.Append(" ", s); Sal.Nume(i, t); Strings.Append(t, s);
          Strings.Append("   tura ", s); Strings.AppendInt(i + 1, 0, s); Strings.Append(" · ", s); Sal.NumeStare(Sal.Stare(i), t);
          Strings.Append(t, s); Strings.Append(" · ", s); Strings.AppendInt(Sal.Cpu(i), 0, s); Strings.Append("%", s);
          Rand(cGreen, s)
        END
      END;
      IF Sal.Vii() = 0 THEN Rand(cText, "  niciun program pornit · pornește unul din Process") END
    ELSIF k = 5 THEN
      IF CFS.NrAsh() = 0 THEN Rand(cGold, "ASH · erori conservate · ∅ erori noi · Salamandra veghează")
      ELSE
        s := "ASH · "; Strings.AppendInt(CFS.NrAsh(), 0, s); Strings.Append(" erori conservate · Salamandra veghează", s);
        Rand(cGold, s);
        FOR i := 0 TO CFS.NrAsh() - 1 DO CFS.Ash(i, t); s := "  "; Strings.Append(t, s); Rand(cRed, s) END
      END
    ELSIF k = 6 THEN
      Rand(cGold, "CUBICUM THEOREM:"); Rand(cCyan, "  în spațiul toroidal Z₇,");
      Rand(cCyan, "  cel mai scurt drum între două puncte"); Rand(cGold, "  descrie un CUB. □")
    ELSIF k = 7 THEN Rand(cCyan, "Z₇ = {1,2,3,4,5,6,7} · ciclic · toroidal · pur · 7 = cercul întreg")
    ELSIF k = 8 THEN
      s := "Cubicum FS · "; Strings.AppendInt(CFS.N(), 0, s); Strings.Append(" fișiere în cub + ", s); Mii(CFS.nh, s);
      Strings.Append(" pe harta telefonului · torul 7⁷ = 823.543 de celule", s); Rand(cGold, s);
      FOR i := 0 TO CFS.N() - 1 DO
        CFS.AdresaText(i, t); s := "  "; Strings.Append(t, s); Strings.Append("  ", s); CFS.Nume(i, t); Strings.Append(t, s);
        IF CFS.Marime(i) >= 0 THEN Strings.Append(" · ", s); Ko(CFS.Marime(i), s); Strings.Append(" · ", s); Strings.AppendInt(CFS.Celule(i), 0, s); Strings.Append(" cel.", s) END;
        Rand(cText, s)
      END
    ELSIF k = 9 THEN nsl := 0; Rand(cGold, "· cleared ·")
    END
  END Exec;

  PROCEDURE Cuvinte(l: ARRAY OF CHAR; VAR c, a: ARRAY OF CHAR);   (* primul cuvant (cu litere mari) si restul *)
    VAR i, k: INTEGER;
  BEGIN
    i := 0; WHILE (i < LEN(l)) & (l[i] = " ") DO INC(i) END;
    k := 0; WHILE (i < LEN(l)) & (l[i] # 0X) & (l[i] # " ") DO IF k < LEN(c) - 1 THEN c[k] := l[i]; INC(k) END; INC(i) END;
    c[k] := 0X; Strings.Cap(c);
    WHILE (i < LEN(l)) & (l[i] = " ") DO INC(i) END;
    k := 0; WHILE (i < LEN(l)) & (l[i] # 0X) DO IF k < LEN(a) - 1 THEN a[k] := l[i]; INC(k) END; INC(i) END;
    WHILE (k > 0) & (a[k - 1] = " ") DO DEC(k) END;
    a[k] := 0X
  END Cuvinte;

  PROCEDURE CuExt(VAR a: ARRAY OF CHAR; ext: ARRAY OF CHAR);   (* adauga extensia daca numele n-are punct *)
  BEGIN IF Strings.Pos(".", a, 0) < 0 THEN Strings.Append(ext, a) END
  END CuExt;

  PROCEDURE Intreb(VAR l: ARRAY OF CHAR);   (* ?- scopuri.  din Shell: Prolog peste tot ce e in tor *)
    VAR s: ARRAY 300 OF CHAR; n, i: INTEGER;
  BEGIN
    s := "Z₇ > "; Strings.Append(l, s); Rand(Am(214, 150, 84, 0.6), s); Strings.Copy(l, ultimaCmd); scroll[3] := 0;
    n := Strings.Length(l); WHILE (n > 0) & (l[n - 1] = " ") DO DEC(n); l[n] := 0X END;
    IF (n > 0) & (l[n - 1] # ".") & (n < LEN(l) - 1) THEN l[n] := "."; l[n + 1] := 0X END;   (* punctul de la sfarsit il pun eu *)
    n := Z7P.IntrebareText(l);
    FOR i := 0 TO Z7P.nrez - 1 DO
      IF Z7P.rez[i] = "nu" THEN Rand(cRed, Z7P.rez[i]) ELSE Rand(cCyan, Z7P.rez[i]) END
    END;
    IF (n = 0) & (Z7P.Clauze() = 0) THEN Rand(cYel, "  în tor nu e nicio clauză: rulează întâi un program cu clauze (run familie)") END;
    l[0] := 0X
  END Intreb;

  PROCEDURE Indemn(c: ARRAY OF CHAR);   (* v1.9b: CEAS(3) & co. scrise in Shell: sunt ale programelor *)
    VAR s: ARRAY 300 OF CHAR; k: INTEGER; f: ARRAY 16 OF CHAR;
  BEGIN
    k := Strings.Pos("(", c, 0); Strings.Extract(c, 0, k, f);
    s := ""; Strings.Append(c, s); Strings.Append(" e o funcție a limbajului Z7: se scrie într-un program (edit nume.z7l), nu în Shell", s);
    Rand(cYel, s);
    IF (f = "CEAS") OR (f = "OPAL") THEN s := "  în Shell scrie: ceas"
    ELSIF f = "ASCULTA" THEN s := "  în Shell scrie: roler T (de pildă roler 7)"
    ELSIF f = "EMITE" THEN s := "  în Shell scrie: emite T S (de pildă emite 7 1)"
    ELSIF f = "COLT" THEN s := "  în Shell scrie: do N (de pildă do 127)"
    ELSIF f = "AMINTESTE" THEN s := "  ca s-o vezi lucrând: run amintire"
    ELSIF (f = "NOTA") OR (f = "CANTA") OR (f = "NOTAC") THEN s := "  ca să auzi celulele: run trandafir"
    ELSE s := "  tot limbajul: cat limbaj-z7.txt"
    END;
    Strings.Append(" · toate comenzile: cat comenzi.txt", s); Rand(cText, s)
  END Indemn;

  PROCEDURE Retea*;   (* v2.3: o cheama Eula Oberon cand sosesc octeti pe socket (si cand aplicatia e in spate) *)
    VAR n, m, i, k: INTEGER; s: ARRAY LL OF CHAR;
  BEGIN
    IF sAsc THEN
      IF Ecran.Legat() & ~sLegat THEN
        sLegat := TRUE; sMesaje := 0;
        s := "⇄ Styx: s-a legat un client (port "; Strings.AppendInt(7777 + Eu, 0, s); Strings.Append(")", s); Rand(cCyan, s)
      END;
      REPEAT
        n := Ecran.Primeste(sIn);
        IF n < 0 THEN
          sAn := 0;
          IF sLegat THEN
            s := "⇄ Styx: clientul a plecat · "; Strings.AppendInt(sMesaje, 0, s); Strings.Append(" mesaje", s); Rand(cCyan, s)
          END;
          sLegat := FALSE
        ELSIF n > 0 THEN
          IF sAn + n > LEN(sAcc) THEN sAn := 0 END;   (* fir stricat: o iau de la capat *)
          FOR i := 0 TO n - 1 DO sAcc[sAn + i] := sIn[i] END; sAn := sAn + n
        END
      UNTIL n <= 0;
      m := 0;
      WHILE (sAn >= 4) & (m >= 0) DO
        m := sAcc[0] MOD 256 + sAcc[1] MOD 256 * 256 + sAcc[2] MOD 256 * 65536 + sAcc[3] MOD 256 * 16777216;
        IF (m < 7) OR (m > LEN(sMsg)) THEN sAn := 0; m := -1   (* nu e Styx *)
        ELSIF sAn < m THEN m := -1   (* inca vine *)
        ELSE
          FOR i := 0 TO m - 1 DO sMsg[i] := sAcc[i] END;
          FOR i := m TO sAn - 1 DO sAcc[i - m] := sAcc[i] END; sAn := sAn - m;
          k := Styx.Proceseaza(sMsg, m, sOut); INC(sMesaje);
          IF k > 0 THEN Ecran.Trimite(sOut, k) END
        END
      END
    END
  END Retea;

  PROCEDURE StyxCmd(VAR l: ARRAY OF CHAR);   (* v2.2: styx ls /cale · styx cat /cale · styx scrie /cale text: mesaje Styx adevarate *)
    VAR i, k, j: INTEGER; sub: ARRAY 16 OF CHAR; cale: ARRAY 200 OF CHAR; text: ARRAY 160 OF CHAR; s: ARRAY LL OF CHAR;
  BEGIN
    i := 0; WHILE l[i] = " " DO INC(i) END; WHILE (l[i] # 0X) & (l[i] # " ") DO INC(i) END;   (* styx *)
    WHILE l[i] = " " DO INC(i) END;
    k := 0; WHILE (l[i] # 0X) & (l[i] # " ") DO IF k < LEN(sub) - 1 THEN sub[k] := l[i]; INC(k) END; INC(i) END; sub[k] := 0X; Strings.Cap(sub);
    WHILE l[i] = " " DO INC(i) END;
    k := 0; WHILE (l[i] # 0X) & (l[i] # " ") DO IF k < LEN(cale) - 1 THEN cale[k] := l[i]; INC(k) END; INC(i) END; cale[k] := 0X;
    WHILE l[i] = " " DO INC(i) END;
    k := 0; WHILE l[i] # 0X DO IF k < LEN(text) - 1 THEN text[k] := l[i]; INC(k) END; INC(i) END; text[k] := 0X;
    IF cale = "" THEN cale := "/" END;
    IF (sub = "ASCULTA") & ((cale = "retea") OR (cale = "rețea")) THEN   (* v2.6: tot Wi-Fi-ul poate intra *)
      Styx.Goleste;
      IF Ecran.AscultaRetea(7777 + Eu) THEN
        sAsc := TRUE; sRetea := TRUE;
        IF Ecran.AdresaMea(text) THEN s := "⇄ Styx ascultă pe rețea: "; Strings.Append(text, s); Strings.Append(":7777", s)
        ELSE s := "⇄ Styx ascultă pe rețea, port 7777 (telefonul nu pare să fie într-un Wi-Fi)"
        END;
        Rand(cCyan, s);
        IF text # "" THEN s := "  pe celălalt telefon, în Cubicum: styx leaga "; Strings.Append(text, s); Rand(cText, s) END;
        Rand(cRed, "  fără parolă: oricine din același Wi-Fi îți poate citi și scrie cubul · styx opreste îl închide")
      ELSE Rand(cRed, "Styx: portul 7777 nu se poate deschide pe rețea (e luat? Eula Oberon v31+?)")
      END
    ELSIF sub = "ASCULTA" THEN
      Styx.Goleste; sRetea := FALSE;
      IF Ecran.Asculta(7777 + Eu) THEN
        sAsc := TRUE; Rand(cCyan, "⇄ Styx ascultă pe 127.0.0.1:7777 (doar din telefon) · styx opreste îl închide");
        Rand(cText, "  în Eula Oberon scrie inferno, apoi un singur rând:");
        Rand(cText, "  mount -A tcp!127.0.0.1!7777 /n/remote; ls /n/remote");
        Rand(cText, "  (cât ascultă, Cubicum ține o notificare: așa merge și în spate)")
      ELSE Rand(cRed, "Styx: portul 7777 nu se poate deschide (e luat? Eula Oberon v27+?)")
      END
    ELSIF (sub = "OPRESTE") OR (sub = "STOP") THEN
      Styx.Goleste; Ecran.Inchide; sAsc := FALSE; sRetea := FALSE; sLegat := FALSE; sAn := 0; Rand(cCyan, "⇄ Styx nu mai ascultă")
    ELSIF sub = "" THEN
      Styx.Goleste;
      IF Styx.departe THEN s := "clientul e legat de "; Strings.Append(Styx.unde, s); Strings.Append(" · styx dezleaga", s); Rand(cCyan, s) END;
      IF ~sAsc THEN Rand(cText, "Styx nu ascultă · styx asculta îl pornește (127.0.0.1:7777) · styx asculta retea (tot Wi-Fi-ul)")
      ELSIF sLegat THEN Rand(cText, "Styx ascultă pe 127.0.0.1:7777 · e un client legat")
      ELSE Rand(cText, "Styx ascultă pe 127.0.0.1:7777 · nimeni legat")
      END
    ELSIF sub = "LEAGA" THEN   (* v2.6: styx leaga 192.168.1.20  sau  styx leaga 192.168.1.20:7777 *)
      k := Strings.Pos(":", cale, 0); i := 7777;
      IF k > 0 THEN
        i := 0; j := k + 1; WHILE (cale[j] >= "0") & (cale[j] <= "9") DO i := i * 10 + ORD(cale[j]) - ORD("0"); INC(j) END;
        cale[k] := 0X
      END;
      IF cale = "/" THEN Styx.Goleste; Rand(cRed, "styx leaga unde? de pildă: styx leaga 192.168.1.20 (ce scrie styx asculta retea pe celălalt)")
      ELSE Rand(cCyan, "⇄ mă leg ..."); Styx.Leaga(cale, i)
      END
    ELSIF (sub = "DEZLEAGA") OR (sub = "DEZLEGA") THEN Styx.Dezleaga
    ELSIF ((sub = "LS") OR (sub = "CAT") OR (sub = "SCRIE") OR (sub = "ECHO")) & Styx.departe THEN
      s := "⇄ "; Strings.Append(Styx.unde, s); Rand(cCyan, s);
      IF sub = "LS" THEN Styx.Ls(cale) ELSIF sub = "CAT" THEN Styx.Cat(cale) ELSE Styx.Scrie(cale, text) END
    ELSIF sub = "LS" THEN Styx.Ls(cale)
    ELSIF sub = "CAT" THEN Styx.Cat(cale)
    ELSIF (sub = "SCRIE") OR (sub = "ECHO") THEN Styx.Scrie(cale, text)
    ELSE Styx.Goleste; Rand(cRed, "styx ce? ls / · cat /opal · scrie /prolog bunic(ion, N) · asculta [retea] · leaga IP · dezleaga")
    END;
    FOR i := 0 TO Styx.nlinii - 1 DO
      IF (Styx.linii[i][0] = "e") & (Strings.Pos("eroare Styx", Styx.linii[i], 0) = 0) THEN Rand(cRed, Styx.linii[i])
      ELSE s := "  "; IF sub = "LS" THEN s := "" END; Strings.Append(Styx.linii[i], s); Rand(cText, s)
      END
    END;
    IF Styx.CereCantec() THEN CantaMuz END
  END StyxCmd;


  (* ---------- v2.8: Eulele din trei cuburi voteaza prin Styx ---------- *)

  PROCEDURE Gama(s: ARRAY OF CHAR; VAR g: ARRAY OF INTEGER): BOOLEAN;   (* "0 2 4 5 7 9 11" -> g[0..6] *)
    VAR i, k, v: INTEGER; ok: BOOLEAN;
  BEGIN
    i := 0; k := 0; ok := TRUE;
    WHILE ok & (k < 7) DO
      WHILE (i < LEN(s) - 1) & ((s[i] = " ") OR (s[i] = 0AX) OR (s[i] = 0DX)) DO INC(i) END;
      IF (s[i] >= "0") & (s[i] <= "9") THEN
        v := 0; WHILE (i < LEN(s) - 1) & (s[i] >= "0") & (s[i] <= "9") DO v := v * 10 + ORD(s[i]) - ORD("0"); INC(i) END;
        g[k] := v MOD 12; INC(k)
      ELSE ok := FALSE
      END
    END;
    RETURN ok
  END Gama;

  PROCEDURE GamaText(VAR g: ARRAY OF INTEGER; VAR s: ARRAY OF CHAR);
    VAR k: INTEGER;
  BEGIN
    s := ""; FOR k := 0 TO 6 DO IF k > 0 THEN Strings.Append(" ", s) END; Strings.AppendInt(g[k], 0, s) END
  END GamaText;

  PROCEDURE CitesteGama(c: INTEGER; VAR g: ARRAY OF INTEGER): BOOLEAN;   (* gama Eulei din cubul c (0 A, 1 B, 2 C) *)
    VAR ok: BOOLEAN; i: INTEGER; t: ARRAY LC OF CHAR;
  BEGIN
    ok := FALSE;
    IF c = Eu THEN i := CFS.Gaseste("gama.txt"); IF i >= 0 THEN CFS.Continut(i, t); ok := Gama(t, g) END
    ELSE
      Styx.Leaga("127.0.0.1", 7777 + c);
      IF Styx.departe THEN
        Styx.Cat("/cub/gama.txt");
        IF Styx.nlinii > 0 THEN ok := Gama(Styx.linii[0], g) END;
        Styx.Dezleaga
      END
    END;
    RETURN ok
  END CitesteGama;

  PROCEDURE ScrieGama(c: INTEGER; VAR g: ARRAY OF INTEGER);
    VAR i: INTEGER; t: ARRAY 64 OF CHAR;
  BEGIN
    GamaText(g, t);
    IF c = Eu THEN i := CFS.Scrie("gama.txt", t)
    ELSE
      Styx.Leaga("127.0.0.1", 7777 + c);
      IF Styx.departe THEN Styx.Scrie("/cub/gama.txt", t); Styx.Dezleaga END
    END
  END ScrieGama;

  PROCEDURE Vot;   (* A = Cubicum OS (7777), B (7778), C (7779): fiecare Eula isi spune gama, majoritatea o repara pe cea gresita *)
    VAR g: ARRAY 3 OF ARRAY 7 OF INTEGER; are, rau: ARRAY 3 OF BOOLEAN; c, k, n, b, nb, x, j: INTEGER; s: ARRAY LL OF CHAR;
  BEGIN
    n := 0;
    FOR c := 0 TO 2 DO are[c] := CitesteGama(c, g[c]); rau[c] := FALSE; IF are[c] THEN INC(n) END END;
    s := "vot · Eule găsite:"; FOR c := 0 TO 2 DO IF are[c] THEN Strings.Append(" ", s); Strings.AppendChar(CHR(ORD("A") + c), s) END END;
    Rand(cCyan, s);
    IF n < 2 THEN Rand(cRed, "prea puține Eule · deschide întâi Cubicum OS, Cubicum B și Cubicum C, apoi vot")
    ELSE
      Rand(cText, "  coloanele: A B C (- = cubul nu răspunde)");
      FOR k := 0 TO 6 DO
        b := -1; nb := 0;
        FOR c := 0 TO 2 DO
          IF are[c] THEN
            x := 0; FOR j := 0 TO 2 DO IF are[j] & (g[j][k] = g[c][k]) THEN INC(x) END END;
            IF x > nb THEN nb := x; b := g[c][k] END
          END
        END;
        s := "T"; Strings.AppendInt(k, 0, s); Strings.Append(":", s);
        FOR c := 0 TO 2 DO IF are[c] THEN Strings.Append(" ", s); Strings.AppendInt(g[c][k], 0, s) ELSE Strings.Append(" -", s) END END;
        IF nb = n THEN Strings.Append(" ok", s); Rand(cGreen, s)
        ELSIF 2 * nb > n THEN
          Strings.Append(" > ", s); Strings.AppendInt(b, 0, s);
          FOR c := 0 TO 2 DO
            IF are[c] & (g[c][k] # b) THEN
              g[c][k] := b; rau[c] := TRUE; Strings.Append(" · ", s); Strings.AppendChar(CHR(ORD("A") + c), s); Strings.Append(" greșește", s)
            END
          END;
          Rand(cYel, s)
        ELSE Strings.Append(" · fără majoritate", s); Rand(cRed, s)
        END
      END;
      FOR c := 0 TO 2 DO
        IF rau[c] THEN ScrieGama(c, g[c]); s := "  Eula "; Strings.AppendChar(CHR(ORD("A") + c), s); Strings.Append(" reparată prin Styx", s); Rand(cGreen, s) END
      END;
      c := (Rnd(3) + Sunet.Ms()) MOD 3; WHILE ~are[c] DO c := (c + 1) MOD 3 END;   (* v2.8b: raza cade la fiecare vot; afli unde la votul urmator *)
      k := (Rnd(7) + Sunet.Ms() DIV 7) MOD 7; g[c][k] := (g[c][k] + 1) MOD 12; ScrieGama(c, g[c]);
      Rand(cYel, "⚡ o rază a lovit o Eulă · scrie vot din nou ca să vezi care")
    END
  END Vot;

  (* ---------- C6: Eula ☾ - tarot si zodii (jocul cuvintelor nespuse) ---------- *)

  PROCEDURE Amesteca(x: INTEGER): INTEGER;   (* un numar din altul, ca un zar: acelasi x da acelasi rezultat *)
  BEGIN x := x * 69069 + 12345; x := x * 69069 + 54321; RETURN (x DIV 65536) MOD 32768
  END Amesteca;

  PROCEDURE Taro(a: ARRAY OF CHAR);   (* trei carti din Arcanele Mari: trecut, prezent, viitor *)
    VAR c: ARRAY 3 OF INTEGER; inv: ARRAY 3 OF BOOLEAN; i, k, h: INTEGER; s: ARRAY 300 OF CHAR; bun: BOOLEAN;
  BEGIN
    h := Sunet.Ms(); i := 0; WHILE (i < LEN(a)) & (a[i] # 0X) DO h := h * 31 + ORD(a[i]); INC(i) END;
    seed := seed + h;
    FOR k := 0 TO 2 DO
      REPEAT c[k] := Rnd(22); bun := TRUE; FOR i := 0 TO k - 1 DO IF c[i] = c[k] THEN bun := FALSE END END UNTIL bun;
      inv[k] := Rnd(3) = 0
    END;
    IF a # "" THEN s := "☾ Eula trage trei cărți pentru: "; Strings.Append(a, s) ELSE s := "☾ Eula trage trei cărți: trecut · prezent · viitor" END;
    Rand(cPurple, s);
    FOR k := 0 TO 2 DO
      IF k = 0 THEN s := "  trecut · " ELSIF k = 1 THEN s := "  prezent · " ELSE s := "  viitor · " END;
      Strings.Append(tarNume[c[k]], s); IF inv[k] THEN Strings.Append(" (întoarsă)", s) END;
      Rand(cGold, s);
      s := "    "; IF inv[k] THEN Strings.Append(tarJos[c[k]], s) ELSE Strings.Append(tarSus[c[k]], s) END; Rand(cText, s);
      Sunet.Nota(FLOOR(z7[c[k] MOD 7] * 2.0 + 0.5), 900, 22)
    END;
    s := "  cuvântul nespus: "; Strings.Append(tarCuv[c[1]], s); Rand(cCyan, s);
    Rand(Am(200, 200, 232, 0.5), "  (e un joc: cărțile nu știu viitorul, dar te pot face să te gândești)")
  END Taro;

  PROCEDURE Zodie(a: ARRAY OF CHAR);   (* horoscopul zilei: acelasi semn, aceeasi zi, acelasi raspuns *)
    VAR z, i, h: INTEGER; s: ARRAY 300 OF CHAR; m: ARRAY 64 OF CHAR;
  BEGIN
    Strings.Copy(a, m); Strings.Cap(m); z := -1;
    IF m[0] = "B" THEN IF m[1] = "E" THEN z := 0 ELSE z := 6 END
    ELSIF m[0] = "T" THEN z := 1 ELSIF m[0] = "G" THEN z := 2 ELSIF m[0] = "R" THEN z := 3 ELSIF m[0] = "L" THEN z := 4
    ELSIF m[0] = "F" THEN z := 5 ELSIF m[0] = "S" THEN IF m[1] = "C" THEN z := 7 ELSE z := 8 END
    ELSIF m[0] = "C" THEN z := 9 ELSIF m[0] = "V" THEN z := 10 ELSIF m[0] = "P" THEN z := 11
    END;
    IF z < 0 THEN Rand(cRed, "zodie ce? de pildă: zodie leu · berbec taur gemeni rac leu fecioară balanță scorpion săgetător capricorn vărsător pești")
    ELSE
      h := (z + 1) * 7919 + CFS.Local(Os.CurrentTime()) DIV 86400 * 343;
      s := "☾ "; Strings.Append(zodNume[z], s); Strings.Append(" · azi", s); Rand(cPurple, s);
      s := "  inima: "; Strings.Append(hInima[Amesteca(h) MOD 7], s); Rand(cText, s);
      s := "  munca: "; Strings.Append(hMunca[Amesteca(h + 1) MOD 7], s); Rand(cText, s);
      s := "  drumul: "; Strings.Append(hDrum[Amesteca(h + 2) MOD 7], s); Rand(cText, s);
      i := Amesteca(h + 3) MOD 7;
      s := "  nota zilei: "; Strings.Append(notaN[i], s); Strings.Append(" · cifra zilei: ", s); Strings.AppendInt(Amesteca(h + 4) MOD 7 + 1, 0, s);
      Rand(cGold, s);
      Sunet.Nota(FLOOR(z7[i] * 2.0 + 0.5), 900, 25);
      Rand(Am(200, 200, 232, 0.5), "  (aceeași zi, același semn, același răspuns · e un joc, nu o prezicere)")
    END
  END Zodie;

  PROCEDURE Carte(i: INTEGER; n, cuv, sus, jos: ARRAY OF CHAR);
  BEGIN Strings.Copy(n, tarNume[i]); Strings.Copy(cuv, tarCuv[i]); Strings.Copy(sus, tarSus[i]); Strings.Copy(jos, tarJos[i])
  END Carte;

  PROCEDURE InitStele;
  BEGIN
    Carte(0, "Nebunul", "începutul", "un început fără hartă: sari, dar uită-te unde calci", "grabă și neatenție; încă nu e momentul saltului");
    Carte(1, "Magicianul", "voința", "ai uneltele pe masă: ce ai în mână ajunge", "talent risipit sau un truc; vezi cine te convinge");
    Carte(2, "Marea Preoteasă", "tăcerea", "răspunsul e deja în tine; ascultă liniștea", "nu asculți ce simți; o taină ținută prea mult");
    Carte(3, "Împărăteasa", "rodul", "ceva crește: grijă, roadă, frumusețe", "dai prea mult sau nu primești; ai grijă și de tine");
    Carte(4, "Împăratul", "ordinea", "ordine, temelie, o hotărâre fermă", "rigiditate; control prea strâns");
    Carte(5, "Ierofantul", "învățătura", "o tradiție, un maestru, o regulă care te ajută", "o regulă care nu mai e a ta");
    Carte(6, "Îndrăgostiții", "alegerea", "o alegere din inimă; o legătură", "nehotărâre: două drumuri care te trag");
    Carte(7, "Carul", "drumul", "mergi înainte cu voință; ții frâiele", "forțezi direcția; caii trag în părți diferite");
    Carte(8, "Puterea", "curajul", "blândețea care îmblânzește leul", "îndoială; putere ascunsă sub frică");
    Carte(9, "Pustnicul", "felinarul", "retragere; cauți înăuntru cu felinarul tău", "singurătate ținută prea mult");
    Carte(10, "Roata Norocului", "roata", "roata se întoarce; începe un ciclu nou", "un ciclu care se repetă până înveți ceva");
    Carte(11, "Dreptatea", "cântarul", "cântar drept: ce semeni culegi", "o judecată strâmbă sau amânată");
    Carte(12, "Spânzuratul", "răbdarea", "privește invers; pauza aduce înțelegere", "aștepți degeaba; e timpul să cobori");
    Carte(13, "Moartea", "schimbarea", "ceva se încheie ca să înceapă altceva", "te agăți de ce s-a terminat");
    Carte(14, "Cumpătarea", "măsura", "amesteci cu măsură; echilibru", "exces, grabă, lipsă de măsură");
    Carte(15, "Diavolul", "lanțul", "un lanț pe care îl poți scoate singur", "începi să vezi lanțul și să-l slăbești");
    Carte(16, "Turnul", "fulgerul", "o zguduire dărâmă ce era șubred", "o prăbușire evitată sau doar amânată");
    Carte(17, "Steaua", "speranța", "speranță; apă limpede după furtună", "ai pierdut steaua din ochi");
    Carte(18, "Luna", "visul", "nu tot ce vezi e cum pare; mergi încet prin ceață", "ceața se ridică; frica scade");
    Carte(19, "Soarele", "căldura", "bucurie, limpezime, căldură", "o bucurie amânată, dar vine");
    Carte(20, "Judecata", "chemarea", "o chemare: te ridici și răspunzi", "îți e frică să auzi chemarea");
    Carte(21, "Lumea", "întregul", "un cerc se închide; totul la locul lui", "aproape gata; mai e un pas");
    zodNume[0] := "Berbec"; zodNume[1] := "Taur"; zodNume[2] := "Gemeni"; zodNume[3] := "Rac"; zodNume[4] := "Leu"; zodNume[5] := "Fecioară";
    zodNume[6] := "Balanță"; zodNume[7] := "Scorpion"; zodNume[8] := "Săgetător"; zodNume[9] := "Capricorn"; zodNume[10] := "Vărsător"; zodNume[11] := "Pești";
    hInima[0] := "cineva apropiat așteaptă un cuvânt de la tine"; hInima[1] := "o discuție simplă repară mai mult decât crezi";
    hInima[2] := "lasă loc tăcerii; nu tot trebuie spus azi"; hInima[3] := "un gest mic contează mai mult decât un plan mare";
    hInima[4] := "ascultă până la capăt înainte să răspunzi"; hInima[5] := "o amintire veche se întoarce în altă lumină";
    hInima[6] := "ziua e bună pentru împăcare";
    hMunca[0] := "termină un lucru început înainte să apuci altul"; hMunca[1] := "o idee care părea nebună merită pusă pe hârtie";
    hMunca[2] := "ordinea de azi te scutește de graba de mâine"; hMunca[3] := "cere ajutor la pasul pe care îl tot amâni";
    hMunca[4] := "un detaliu mic schimbă tot; verifică de două ori"; hMunca[5] := "lucrul făcut cu mâinile te limpezește";
    hMunca[6] := "nu tot ce strălucește e gata; mai lasă-l să se coacă";
    hDrum[0] := "mergi pe jos o bucată; gândurile se așază"; hDrum[1] := "alege un singur lucru și du-l la capăt";
    hDrum[2] := "ce cauți e mai aproape decât pare"; hDrum[3] := "un ocol scurt te scapă de o grabă lungă";
    hDrum[4] := "seara aduce răspunsul pe care dimineața nu-l avea"; hDrum[5] := "privește cubul și din alt colț";
    hDrum[6] := "odihna e și ea un drum"
  END InitStele;

  (* ---------- C7: intreaba - fiecare cub stie altceva, C judeca ---------- *)

  PROCEDURE Cheie(q: ARRAY OF CHAR; VAR kw: ARRAY OF ARRAY OF CHAR): INTEGER;   (* cuvintele de cautat: litere mici, fara diacritice *)
    VAR i, j, n: INTEGER; w: ARRAY 32 OF CHAR; t: ARRAY 128 OF CHAR;
  BEGIN
    Strings.Copy(q, t); Tx.MicS(t); Tx.FoldS(t); n := 0; i := 0;
    WHILE (i < LEN(t)) & (t[i] # 0X) DO
      j := 0;
      WHILE (i < LEN(t)) & (t[i] # 0X) & Tx.Litera(t[i]) DO IF j < LEN(w) - 1 THEN w[j] := t[i]; INC(j) END; INC(i) END;
      w[j] := 0X;
      IF (j >= 3) & (n < LEN(kw)) & ~Tx.InLista(w, "ce|este|care|cum|cine|unde|despre|sunt|esti|spune|pentru|face|fac|din|sau|cel|cea|mai|imi|iti|lui|are|sti|stii") THEN
        Strings.Copy(w, kw[n]); INC(n)
      END;
      WHILE (i < LEN(t)) & (t[i] # 0X) & ~Tx.Litera(t[i]) DO INC(i) END
    END;
    RETURN n
  END Cheie;

  PROCEDURE Potrivire(linie: ARRAY OF CHAR; VAR kw: ARRAY OF ARRAY OF CHAR; n: INTEGER): INTEGER;   (* cate cuvinte cheie are randul *)
    VAR t: ARRAY 256 OF CHAR; k, s: INTEGER;
  BEGIN
    Strings.Copy(linie, t); Tx.MicS(t); Tx.FoldS(t); s := 0;
    FOR k := 0 TO n - 1 DO IF Tx.Contine(t, kw[k]) THEN INC(s) END END;
    RETURN s
  END Potrivire;

  PROCEDURE Intreaba(q: ARRAY OF CHAR);   (* A = teoria muzicii (/eula), B = memoria cubului (fisierele .txt), C judeca *)
    VAR kw: ARRAY 8 OF ARRAY 32 OF CHAR; nk, i, j, k, sc, best, nf, gasite: INTEGER;
      nume: ARRAY 40 OF ARRAY 40 OF CHAR; s: ARRAY 300 OF CHAR; bunL: ARRAY 200 OF CHAR; bunF: ARRAY 40 OF CHAR;
      stieA, stieB: BOOLEAN;
  BEGIN
    IF q = "" THEN Rand(cRed, "intreaba ce? de pildă: intreaba ce e Salamandra · intreaba acordul de Re minor")
    ELSE
      s := "? "; Strings.Append(q, s); Rand(cGold, s);
      stieA := FALSE; stieB := FALSE;
      Styx.Leaga("127.0.0.1", 7777);   (* A: Eula ♪, teoria muzicii *)
      IF ~Styx.departe THEN Rand(cRed, "  ♪ A (teoria muzicii): nu răspunde · deschide Cubicum OS")
      ELSE
        Styx.Scrie("/eula", q); Styx.Cat("/eula");
        stieA := (Styx.nlinii > 0) & (Strings.Pos("nu știe", Styx.linii[0], 0) < 0) & (Strings.Pos("eroare", Styx.linii[0], 0) # 0);
        IF stieA THEN
          Rand(cCyan, "  ♪ A (teoria muzicii): știu");
          j := Styx.nlinii; IF j > 4 THEN j := 4 END;
          FOR i := 0 TO j - 1 DO s := "    "; Strings.Append(Styx.linii[i], s); Rand(cText, s) END
        ELSE Rand(Am(200, 200, 232, 0.6), "  ♪ A (teoria muzicii): nu știu")
        END;
        Styx.Dezleaga
      END;
      nk := Cheie(q, kw);
      IF nk = 0 THEN Rand(Am(200, 200, 232, 0.6), "  ▣ B (memoria cubului): n-am cuvinte de căutat")
      ELSE
        Styx.Leaga("127.0.0.1", 7778);   (* B: ce scrie in fisierele cubului *)
        IF ~Styx.departe THEN Rand(cRed, "  ▣ B (memoria cubului): nu răspunde · deschide Cubicum B")
        ELSE
          Styx.Ls("/cub"); nf := 0;
          FOR i := 0 TO Styx.nlinii - 1 DO
            Strings.Copy(Styx.linii[i], s); k := 0; WHILE s[k] = " " DO INC(k) END;
            IF (nf < LEN(nume)) & (Strings.Pos(".txt", s, 0) > 0) THEN Strings.Extract(s, k, Strings.Length(s) - k, nume[nf]); INC(nf) END
          END;
          best := 0; gasite := 0; bunL := ""; bunF := "";
          FOR i := 0 TO nf - 1 DO
            s := "/cub/"; Strings.Append(nume[i], s); Styx.Cat(s);
            FOR j := 0 TO Styx.nlinii - 1 DO
              sc := Potrivire(Styx.linii[j], kw, nk);
              IF sc > 0 THEN INC(gasite) END;
              IF sc > best THEN best := sc; Strings.Copy(Styx.linii[j], bunL); Strings.Copy(nume[i], bunF) END
            END
          END;
          Styx.Dezleaga;
          stieB := best > 0;
          IF stieB THEN
            s := "  ▣ B (memoria cubului): "; IF 2 * best >= nk THEN Strings.Append("știu", s) ELSE Strings.Append("bănuiesc", s) END;
            Strings.Append(" · din ", s); Strings.Append(bunF, s); Strings.Append(" · ", s); Strings.AppendInt(gasite, 0, s);
            Strings.Append(" rânduri potrivite", s); Rand(cCyan, s);
            s := "    "; Strings.Append(bunL, s); Rand(cText, s)
          ELSE Rand(Am(200, 200, 232, 0.6), "  ▣ B (memoria cubului): nu știu")
          END
        END
      END;
      IF stieA & stieB THEN Rand(cGold, "☾ C: amândouă știu ceva · le pun cap la cap: teoria de la A, ce scrie în cub de la B")
      ELSIF stieA THEN Rand(cGold, "☾ C: răspunde A · e o întrebare de muzică")
      ELSIF stieB THEN Rand(cGold, "☾ C: răspunde B · e în memoria cubului")
      ELSE Rand(cGold, "☾ C: nimeni nu știe încă · dă-i lui B un text despre asta (în Cubicum B: adu …)")
      END
    END
  END Intreaba;

  PROCEDURE Iesire7(col: INTEGER; s: ARRAY OF CHAR);   (* Cubicum 7: ce scriu expertii ajunge in Shell *)
    VAR c, k: INTEGER;
  BEGIN
    k := col MOD 10;
    IF k = 1 THEN c := cCyan ELSIF k = 2 THEN c := cGold ELSIF k = 3 THEN c := cPurple ELSIF k = 4 THEN c := cRed
    ELSIF k = 5 THEN c := cDim ELSIF k = 6 THEN c := cGreen ELSIF k = 7 THEN c := cYel ELSE c := cText
    END;
    IF col >= 10 THEN Scris(c, s) ELSE Rand(c, s) END
  END Iesire7;

  PROCEDURE EdDeschide(a: ARRAY OF CHAR);   (* 7·B v6: edit X - editorul, in fereastra Shell *)
    VAR i: INTEGER; s: ARRAY 120 OF CHAR;
  BEGIN
    i := CFS.Gaseste(a);
    IF (i >= 0) & (CFS.Celule(i) > 1) THEN
      s := "✎ "; Strings.Append(a, s); Strings.Append(" e un fișier mare, adus de pe telefon: editorul ține cel mult ", s);
      Strings.AppendInt(LC - 1, 0, s); Strings.Append(" de semne", s); Rand(cRed, s)
    ELSE
      Strings.Copy(a, edNumeE); edT := ""; IF i >= 0 THEN CFS.Continut(i, edT) END;
      edN := Strings.Length(edT); edC := edN; edSus := 0; edPx := 0; edMod := FALSE; edUrm := TRUE; edIes := FALSE;
      IF i >= 0 THEN edMsg := "deschis · atinge textul ca să muți cursorul" ELSE edMsg := "fișier nou · scrie, apoi salvez" END;
      edMsgDe := acum; editor := TRUE; cur := 3; tastatura := TRUE; Ecran.Tastatura(TRUE)
    END
  END EdDeschide;

  PROCEDURE TreazCmd(a: ARRAY OF CHAR);   (* 7·B v5 *)
  BEGIN
    IF (a = "nu") OR (a = "NU") OR (a = "oprit") THEN treazMereu := FALSE; Rand(cGold, "◆ în spate lucrez doar cât pasc")
    ELSIF (a = "da") OR (a = "DA") THEN
      treazMereu := TRUE; Rand(cGold, "◆ rămân treaz și cu ecranul stins: procesele, rondul, pășunea · treaz nu = doar cât pasc");
      Rand(cDim, "  (procesorul nu doarme: bateria scade mai repede)")
    ELSIF treazMereu THEN Rand(cGold, "◆ treaz mereu, și cu ecranul stins · treaz nu = doar cât pasc")
    ELSE Rand(cGold, "◆ treaz doar cât pasc · treaz da = și procesele, rondul, cu ecranul stins")
    END
  END TreazCmd;

  PROCEDURE CopieCmd;   (* salveaza tot *)
    VAR s: ARRAY 300 OF CHAR;
  BEGIN
    Rand(cDim, "  fac copia…");
    IF Sal.Salveaza() THEN END; E7.PeDisc;   (* hrana, pasunea si obiceiurile ajung pe disc inainte de copie *)
    IF Cp.Salveaza(s) THEN Rand(cGold, s); Rand(cDim, "  restaureaza = lista copiilor · restaureaza NUME = te întorci la ea")
    ELSE Rand(cRed, s)
    END
  END CopieCmd;

  PROCEDURE RestaurareCmd(a: ARRAY OF CHAR);
    VAR s: ARRAY 2000 OF CHAR; n: INTEGER;
  BEGIN
    IF a = "" THEN
      n := Cp.Lista(s);
      IF n = 0 THEN Rand(cDim, "◆ nu am nicio copie în Download · salveaza tot face una")
      ELSE Rand(cPurple, "◆ copiile din Download:"); Scris(cText, s); Rand(cDim, "  restaureaza NUME (cu tot cu .z7c) = la pornirea următoare cubul devine copia")
      END
    ELSIF Cp.Restaureaza(a, s) THEN Rand(cYel, s)
    ELSE Rand(cRed, s)
    END
  END RestaurareCmd;

  PROCEDURE CopiazaCmd(a: ARRAY OF CHAR);   (* copiaza = ultimul raspuns · copiaza tot = ultimele randuri din Shell *)
    VAR t: ARRAY 4000 OF CHAR; i: INTEGER;
  BEGIN
    IF (a = "tot") OR (a = "ecran") OR (a = "shell") THEN
      t := ""; i := nsl - 40; IF i < 0 THEN i := 0 END;
      WHILE i < nsl DO
        IF (i > 0) & ~slCont[i] & (t # "") THEN Strings.AppendChar(0AX, t) ELSIF slCont[i] THEN Strings.Append(" ", t) END;
        IF Strings.Length(t) + Strings.Length(sl[i]) < LEN(t) - 2 THEN Strings.Append(sl[i], t) END; INC(i)
      END;
      Ecran.Copiaza(t); Rand(cGold, "◆ am copiat ultimele rânduri din Shell · le lipești unde vrei")
    ELSIF E7.ultimRasp = "" THEN Rand(cDim, "◆ încă n-am un răspuns de copiat · copiaza tot = ultimele rânduri din Shell")
    ELSE Ecran.Copiaza(E7.ultimRasp); Rand(cGold, "◆ am copiat ultimul răspuns · îl lipești unde vrei (ține apăsat, Lipește)")
    END
  END CopiazaCmd;

  PROCEDURE LipesteCmd;   (* clipboard -> randul de scris *)
    VAR t: ARRAY 2000 OF CHAR; i: INTEGER;
  BEGIN
    IF ~Ecran.Lipeste(t) THEN Rand(cDim, "◆ clipboard-ul e gol")
    ELSE
      linie := ""; i := 0;
      WHILE (i < 150) & (t[i] # 0X) DO IF (t[i] = 0AX) OR (t[i] = 0DX) THEN Strings.AppendChar(" ", linie) ELSE Strings.AppendChar(t[i], linie) END; INC(i) END;
      tastatura := TRUE; Ecran.Tastatura(TRUE);
      IF t[i] # 0X THEN Rand(cDim, "◆ am pus începutul în rândul de scris · textul e lung: hraneste arta clipboard îl dă întreg unei arte")
      ELSE Rand(cDim, "◆ lipit în rândul de scris")
      END
    END
  END LipesteCmd;

  PROCEDURE Ajutor(a: ARRAY OF CHAR);   (* help comanda *)
    VAR c: ARRAY 64 OF CHAR; i: INTEGER;
  BEGIN
    Strings.Copy(a, c); FOR i := 0 TO Strings.Length(c) - 1 DO IF (c[i] >= "A") & (c[i] <= "Z") THEN c[i] := CHR(ORD(c[i]) + 32) END END;
    IF c = "pasune" THEN Rand(cText, "pasune arta[.subdomeniu] [N] [en] = N articole de pe Wikipedia (en = în engleză)"); Rand(cText, "pasune tot = toți solzii, câte 5 articole · pasune stop · pasune = ce a mâncat fiecare · pasune auto / oprit")
    ELSIF c = "hraneste" THEN Rand(cText, "hraneste arta[.subdomeniu] = alegi un fișier de pe telefon"); Rand(cText, "hraneste arta wiki Titlu · hraneste arta url adresa · hraneste arta clipboard = textul copiat")
    ELSIF c = "invata" THEN Rand(cText, "invata arta[.subdomeniu] o frază = o frază scrisă de tine"); Rand(cText, "de pildă: invata retorica.citate Cine se scoală de dimineață departe ajunge.")
    ELSIF c = "solzi" THEN Rand(cText, "solzi = cele 7 arte × 7 subdomenii și câte fraze are fiecare"); Rand(cText, "solzi geometria = subdomeniile unei arte, cu numerele 1–7")
    ELSIF (c = "bun") OR (c = "gresit") OR (c = "incredere") OR (c = "legaturi") THEN Rand(cText, "după un răspuns: bun = îl face cristal, crește încrederea și Oul leagă cuvintele întrebării de arta care a știut · gresit = scade încrederea, slăbește legătura și Oul încearcă următorul expert"); Rand(cText, "incredere = tabelul 3 × 7 · legaturi = ce a învățat Oul")
    ELSIF (c = "memoria") OR (c = "memorie") THEN
      Rand(cText, "memoria eulei = memoria Eulei celei vechi intră în cub (eula-memorie.txt din Download, sau îl alegi de pe telefon; în Eula cea în Java îl faci cu „exportă memoria”)");
      Rand(cText, "Oul o citește înainte să întrebe Wikipedia · memoria = câte fraze știe · memoria eulei stop")
    ELSIF (c = "drepturi") OR (c = "drept") OR (c = "permisiuni") THEN
      Rand(cText, "fiecare program Z7 are drepturile lui: tor (scrie în afara turei lui) · opri (alte programe) · porni · sunet · fereastra · experti");
      Rand(cText, "fără drepturi, un program tot poate socoti, scrie în tura lui și în Shell · drepturi = lista · drept X +tor -sunet · drept X tot · drept X nimic")
    ELSIF (c = "aminteste") OR (c = "zilnic") OR (c = "mementouri") OR (c = "memento") THEN
      Rand(cText, "aminteste-mi la 18:00 să … · aminteste în 20 de minute … · aminteste mâine la 9 … · zilnic 08:00 … (zilnic … fa pasune tot = face comanda)"); Rand(cText, "mementouri = lista · mementouri sterge N · mementouri sterge tot · te anunță și cu aplicația în spate")
    ELSIF c = "treaz" THEN Rand(cText, "treaz da = Cubicum lucrează și cu ecranul stins (procese, rond, pășune)"); Rand(cText, "treaz nu = doar cât paște · treaz = cum e acum")
    ELSIF (c = "salveaza") OR (c = "restaureaza") OR (c = "copie") THEN Rand(cText, "salveaza tot = o copie a cubului în Download (.z7c); una se face și singură, o dată pe zi"); Rand(cText, "restaureaza = lista · restaureaza NUME = la pornirea următoare cubul devine copia")
    ELSIF (c = "copiaza") OR (c = "lipeste") THEN Rand(cText, "copiaza = ultimul răspuns în clipboard · copiaza tot = ultimele rânduri din Shell"); Rand(cText, "lipeste = clipboard-ul în rândul de scris")
    ELSIF (c = "run") OR (c = "kill") OR (c = "ps") THEN Scris(cText, "run X = programul X pe o tură liberă a spiralei · ps = ce rulează · kill N = oprește tura N (1–7)")
    ELSIF (c = "app") OR (c = "aplicatie") OR (c = "desen") THEN
      Rand(cText, "o aplicație Z7 desenează pe o pânză lată de 343: CULOARE(r, g, b) DREPT(x, y, l, h) CERC(x, y, r) LINIE(x1, y1, x2, y2)");
      Rand(cText, "TEXT(x, y, text între ghilimele) TEXTN(x, y, n) MARIME(m) · STERGE = pagină nouă · ARATA = se vede");
      Rand(cText, "ATINSX ATINSY (-1 = nu atingi) APASAT LATIME INALTIME ORA MINUT SECUNDA ALEATOR(n) · DORMI(ms) între cadre");
      Rand(cDim, "de pildă: edit bile.z7l · rulez · ✕ oprește aplicația")
    ELSIF (c = "edit") OR (c = "ed") OR (c = "editor") THEN
      Rand(cText, "edit X = editorul: textul pe rânduri, atingi unde vrei să scrii, tragi ca să derulezi");
      Rand(cText, "◀ ▶ ▲ ▼ = cursorul · ⇤ ⇥ = începutul / sfârșitul rândului · ⌨ = tastatura");
      Rand(cText, "rulez = salvez + run (.z7 / .z7l) · salvez · ieșire (de două ori dacă n-ai salvat)");
      Rand(cDim, "un fișier din cub ține cel mult 1599 de semne · scrie X = vechiul mod, rând cu rând, până la un rând .")
    ELSIF (c = "cat") OR (c = "rm") OR (c = "ls") THEN Rand(cText, "ls = fișierele cubului · cat X = îl arată · edit X = editorul · rm X = îl arde")
    ELSIF (c = "adu") OR (c = "harta") OR (c = "caut") OR (c = "vezi") THEN Rand(cText, "adu = un fișier de pe telefon intră în cub · harta = tot telefonul pe tor"); Rand(cText, "caut X = caută pe hartă · vezi N = un rezultat")
    ELSIF c = "versiuni" THEN Rand(cText, "versiuni = ce .Mod ai în Download, ce merge, cu ce te întorci"); Rand(cText, "merge X / cade X = notezi · instaleaza X = cele două comenzi de copiat")
    ELSIF (c = "eula") OR (c = "intrebare") THEN Rand(cText, "scrie direct întrebarea (sau eula întrebarea): cele 7 arte răspund, Oul alege"); Rand(cText, "de pildă: 14 în baza 7 · ora la Tokyo · câte plăci de 30x30 pentru 4x5 · acordul de Re minor")
    ELSE Rand(cDim, "help pasune · hraneste · invata · solzi · bun · treaz · salveaza · copiaza · run · cat · adu · versiuni · eula")
    END
  END Ajutor;

  PROCEDURE ExecLinie(l0: ARRAY OF CHAR);   (* o linie scrisa cu tastatura *)
    VAR c: ARRAY 16 OF CHAR; a: ARRAY 64 OF CHAR; s: ARRAY LL OF CHAR; t: ARRAY LC OF CHAR; r: ARRAY LL OF CHAR;
      i, k, n, j: INTEGER; l: ARRAY 160 OF CHAR;
  BEGIN
    Strings.Copy(l0, l);
    IF editez THEN
      s := "  "; Strings.Append(l, s); Rand(cText, s);
      IF l = "." THEN
        k := CFS.Scrie(edNume, edBuf); editez := FALSE;
        IF k >= 0 THEN s := "salvat în cub: "; Strings.Append(edNume, s); Strings.Append(" → cfs://", s); CFS.AdresaText(k, a); Strings.Append(a, s); Rand(cGold, s)
        ELSE Rand(cRed, "n-a mers · vezi ash")
        END
      ELSIF Strings.Length(edBuf) + Strings.Length(l) < LC - 2 THEN Strings.Append(l, edBuf); Strings.AppendChar(0AX, edBuf)
      ELSE Rand(cRed, "fișierul e plin (1600 de semne)")
      END
    ELSE
      i := 0; WHILE l[i] = " " DO INC(i) END;
      IF (l[i] = "?") & (l[i + 1] = "-") THEN Intreb(l) END;   (* v2.0: o intrebare Prolog *)
      n := Strings.Length(l);   (* v1.9b: punctul (si spatiile) de la sfarsit nu fac parte din comanda *)
      WHILE (n > 0) & ((l[n - 1] = ".") OR (l[n - 1] = " ")) DO DEC(n); l[n] := 0X END;
      IF (l # "") & ((nh = 0) OR (hist[nh - 1] # l)) THEN   (* 7·B v5: istoricul *)
        IF nh = LEN(hist) THEN FOR i := 0 TO nh - 2 DO hist[i] := hist[i + 1] END; DEC(nh) END;
        Strings.Copy(l, hist[nh]); INC(nh)
      END;
      hp := nh;
      Cuvinte(l, c, a);
      k := -1; FOR i := 0 TO 9 DO Strings.Copy(cmd[i], s); Strings.Cap(s); IF s = c THEN k := i END END;
      IF l = "" THEN   (* era o intrebare Prolog *)
      ELSIF (k >= 0) & (a = "") THEN Exec(k)
      ELSE
        s := "Z₇ > "; Strings.Append(l, s); Rand(Am(214, 150, 84, 0.6), s); Strings.Copy(l, ultimaCmd); scroll[3] := 0;
        IF Mem.Cmd(l) THEN   (* 7·B v12: aminteste, zilnic, mementouri *)
        ELSIF Dr.Cmd(l) THEN   (* 7·B v13: drepturi, drept X … *)
        ELSIF Mm.Cmd(l) THEN   (* 7·B v18: memoria eulei, memoria *)
        ELSIF (c = "RUN") OR (c = "PORNESTE") THEN i := Sal.Porneste(a); IF i >= 0 THEN procSel := i; vmSel := i END
        ELSIF (c = "KILL") OR (c = "OPRESTE") THEN n := Sal.NP; IF (a[0] >= "1") & (a[0] <= "7") THEN n := ORD(a[0]) - ORD("1") END;   (* 7·B: kill 1..7 *)
          IF (n < Sal.NP) & (Sal.Stare(n) # Sal.Liber) THEN Sal.Opreste(n) ELSE Rand(cRed, "pe tura asta nu rulează nimic") END
        ELSIF c = "BURN" THEN Sal.Arde; procSel := -1
        ELSIF (c = "CEAS") OR (c = "OPAL") THEN OpalCeas
        ELSIF c = "DO" THEN
          n := 0; i := 0; WHILE (a[i] >= "0") & (a[i] <= "9") DO n := n * 10 + ORD(a[i]) - ORD("0"); INC(i) END;
          Tor7.PuneColt(n); s := "Roler stă în colțul "; Strings.AppendInt(Tor7.Colt(), 0, s); Strings.Append(" (din 128) · acolo e Do · notele s-au reacordat", s); Rand(cGold, s)
        ELSIF (c = "ROLER") OR (c = "ASCULTA") THEN
          n := Numar(a, 0); j := Tor7.Asculta(n); RolerSpune(n, j, FALSE)
        ELSIF c = "EMITE" THEN
          n := Numar(a, 0); i := Strings.Pos(" ", a, 0); k := 1; IF i > 0 THEN k := Numar(a, i + 1) END;
          j := Tor7.Emite(n, k); RolerSpune(n, j, TRUE)
        ELSIF (c = "APP") OR (c = "DESCHIDE") THEN
          i := CFS.Gaseste(a); IF i < 0 THEN CuExt(a, ".app"); i := CFS.Gaseste(a) END;
          IF i >= 0 THEN LansezApp(i) ELSE s := "nu e în cub: "; Strings.Append(a, s); Rand(cRed, s) END
        ELSIF c = "CAT" THEN
          i := CFS.Gaseste(a);
          IF i < 0 THEN s := "nu e în cub: "; Strings.Append(a, s); Rand(cRed, s)
          ELSE
            CFS.Continut(i, t); j := 0; n := Strings.Length(t);
            IF (n = 0) & (CFS.Marime(i) > 0) THEN
              s := "  adus de pe telefon · "; Ko(CFS.Marime(i), s); Strings.Append(" pe ", s); Strings.AppendInt(CFS.Celule(i), 0, s);
              Strings.Append(" celule · nu e text", s); Rand(cGold, s)
            END;
            WHILE j < n DO
              k := 0; WHILE (j < n) & (t[j] # 0AX) DO IF k < LL - 3 THEN r[k] := t[j]; INC(k) END; INC(j) END;
              r[k] := 0X; s := "  "; Strings.Append(r, s); Rand(cText, s); INC(j)
            END;
            IF (n > 0) & (CFS.Celule(i) > 1) THEN
              s := "  … ("; Ko(CFS.Marime(i), s); Strings.Append(" în tot, pe ", s); Strings.AppendInt(CFS.Celule(i), 0, s);
              Strings.Append(" celule; aici e doar începutul)", s); Rand(cGold, s)
            END
          END
        ELSIF (c = "EDIT") OR (c = "ED") THEN   (* 7·B v6: editorul *)
          IF a = "" THEN Rand(cRed, "edit cum? de pildă: edit melodie.z7l · edit note.txt")
          ELSE CuExt(a, ".z7"); EdDeschide(a)
          END
        ELSIF c = "SCRIE" THEN   (* scrie X: ca inainte, rand cu rand, pana la un rand cu . *)
          IF a = "" THEN Rand(cRed, "scrie cum? de pildă: scrie melodie.z7")
          ELSE
            CuExt(a, ".z7"); Strings.Copy(a, edNume); edBuf := ""; editez := TRUE;
            s := "✎ "; Strings.Append(a, s); Strings.Append(": scrie rândurile; termini cu un rând care e doar .", s); Rand(cYel, s);
            IF CFS.Gaseste(a) >= 0 THEN Rand(cYel, "  (există deja: îl rescrii · cat îl arată)") END
          END
        ELSIF (c = "RM") OR (c = "ARDE") THEN
          i := CFS.Gaseste(a);
          IF i >= 0 THEN CFS.Arde(i); s := "ars: "; Strings.Append(a, s); Rand(cGold, s) ELSE s := "nu e în cub: "; Strings.Append(a, s); Rand(cRed, s) END
        ELSIF (c = "ADU") OR (c = "IMPORT") THEN E7.Nimic;
          IF a = "" THEN Ecran.AlegeFisier; Rand(cCyan, "⇩ alege de pe telefon unul sau mai multe fișiere · intră în cub pe rând")
          ELSE AduDin(a)
          END
        ELSIF (c = "DOWNLOAD") OR (c = "DESCARCARI") THEN Download(a)
        ELSIF c = "HARTA" THEN Harta
        ELSIF c = "STYX" THEN StyxCmd(l)
        ELSIF c = "VOT" THEN Vot
        ELSIF (c = "MESH") OR (c = "343") THEN PornesteMesh
        ELSIF (c = "TARO") OR (c = "TAROT") THEN Taro(a)
        ELSIF (c = "ZODIE") OR (c = "HOROSCOP") THEN Zodie(a)
        ELSIF c = "INTREABA" THEN Intreaba(a)
        ELSIF c = "EULA" THEN E7.EulaCmd(a)
        ELSIF c = "BUN" THEN E7.Parere(TRUE)
        ELSIF c = "GRESIT" THEN E7.Parere(FALSE)
        ELSIF c = "INCREDERE" THEN E7.ArataIncr
        ELSIF (c = "HRANESTE") OR (c = "HRANA") & (a # "") THEN E7.HranaCmd(l)
        ELSIF c = "HRANA" THEN E7.HranaCate
        ELSIF (c = "SOLZI") OR (c = "SOLZ") THEN E7.SolziCmd(a)   (* v11 *)
        ELSIF c = "INVATA" THEN E7.InvataCmd(l)
        ELSIF c = "DA" THEN E7.Da
        ELSIF (c = "OBICEIURI") OR (c = "OBICEI") THEN E7.Obiceiuri
        ELSIF (c = "LEGATURI") OR (c = "LEGATURILE") THEN E7.Legaturi   (* 7·B v12 *)
        ELSIF c = "ROND" THEN E7.Rond(TRUE)
        ELSIF c = "GHID" THEN E7.Ghid
        ELSIF c = "TREAZ" THEN TreazCmd(a)   (* 7·B v5 *)
        ELSIF (c = "SALVEAZA") OR (c = "COPIE") THEN CopieCmd
        ELSIF c = "RESTAUREAZA" THEN RestaurareCmd(a)
        ELSIF c = "COPIAZA" THEN CopiazaCmd(a)
        ELSIF c = "LIPESTE" THEN LipesteCmd
        ELSIF (c = "HELP") OR (c = "AJUTOR") THEN Ajutor(a)
        ELSIF c = "VERSIUNI" THEN V7.Versiuni(a)
        ELSIF (c = "PASUNE") OR (c = "PASTE") THEN E7.PasuneCmd(l)
        ELSIF c = "MERGE" THEN V7.Marcheaza(a, 1)
        ELSIF c = "CADE" THEN V7.Marcheaza(a, 2)
        ELSIF c = "INSTALEAZA" THEN V7.Instaleaza(a)
        ELSIF (c = "JOC") OR (c = "CUBROLLER") THEN PornesteJoc
        ELSIF (c = "CAUT") OR (c = "CAUTA") OR (c = "FIND") THEN Caut(a)
        ELSIF c = "VEZI" THEN Vezi(a)
        ELSIF c = "CELULA" THEN Celula(a)
        ELSIF Strings.Pos("(", c, 0) > 0 THEN Indemn(c)
        ELSIF Muzica(l) THEN
        ELSE E7.EulaCmd(l)   (* v10: ce nu e comanda ajunge la Oul *)
        END
      END
    END
  END ExecLinie;

  (* ---------- boot ---------- *)

  PROCEDURE Boot(e: INTEGER);
    VAR cx, cy, y0, i, x, y, xp, yp, xa, ya, s, lb, f, k: INTEGER; a, r, ang, p, u: REAL;
  BEGIN
    Ecran.Fond(Ecran.RGB(0, 0, 0));
    cx := W DIV 2; cy := H DIV 2; y0 := cy - D(80);
    a := FLT(e) * 0.0012;   (* bootAnim din HTML: +0.02 pe cadru, 60 de cadre pe secunda *)
    faza := 0; WHILE (faza < 4) & (e >= fazaT[faza + 1]) DO INC(faza) END;
    IF faza > fazaSunata THEN fazaSunata := faza; Sunet.Nota(FLOOR(z7[faza] * 0.5 + 0.5), 400, 35) END;
    IF faza = 0 THEN   (* vidul: trei puncte *)
      FOR i := 0 TO 2 DO
        x := cx + FLOOR(Math.sin(a * 0.7 + FLT(i) * 2.1) * FLT(D(60)));
        y := y0 + FLOOR(Math.cos(a * 0.5 + FLT(i)) * FLT(D(30)));
        Ecran.Culoare(Am(214, 150, 84, 0.25 + Math.sin(a + FLT(i)) * 0.15)); Ecran.Disc(x, y, D(2))
      END
    ELSIF faza = 1 THEN   (* oul auriu care pulseaza, apoi crapa *)
      r := FLT(D(40)) + Math.sin(a * 2.0) * FLT(D(4));
      Ecran.Culoare(Am(214, 150, 84, 0.12)); Elipsa(cx, y0, r, r * 1.4, TRUE);
      Ecran.Culoare(Am(220, 185, 126, 0.25)); Elipsa(cx, y0, r * 0.6, r * 0.84, TRUE);
      Ecran.Culoare(Am(232, 201, 142, 0.42)); Elipsa(cx, y0, r * 0.25, r * 0.35, TRUE);
      Ecran.Culoare(Am(214, 150, 84, 0.5 + Math.sin(a) * 0.3)); Ecran.Grosime(Min(D(2), 3)); Elipsa(cx, y0, r, r * 1.4, FALSE);
      IF e > 1600 THEN
        Ecran.Culoare(Am(0, 212, 255, 0.5)); Ecran.Grosime(G1);
        Ecran.Linie(cx, y0 - D(30), cx + D(8), y0 - D(10)); Ecran.Linie(cx + D(8), y0 - D(10), cx - D(3), y0 + D(10))
      END
    ELSIF faza = 2 THEN   (* salamandra: corp sinusoidal, cap, ochi *)
      Ecran.Culoare(Am(57, 255, 20, 0.8)); Ecran.Grosime(D(2));
      xa := 0; ya := 0;
      FOR k := 0 TO 60 DO
        xp := cx - D(60) + D(2 * k);
        yp := y0 + FLOOR(Math.sin(FLT(2 * k) / 120.0 * Math.pi * 3.0 + a * 4.0) * FLT(D(20)));
        IF k > 0 THEN Ecran.Linie(xa, ya, xp, yp) END;
        xa := xp; ya := yp
      END;
      y := y0 + FLOOR(Math.sin(a * 4.0) * FLT(D(20)));
      Ecran.Culoare(Am(57, 255, 20, 0.9)); Ecran.Disc(cx - D(60), y, D(5));
      Ecran.Culoare(Ecran.RGB(255, 255, 255)); Ecran.Disc(cx - D(64), y - D(2), Min(D(2), 2) + 1)
    ELSE   (* cubul se naste, cu un inel de 7 stele *)
      p := 20.0 + a * 1.5; IF (p > 45.0) OR (faza = 4) THEN p := 45.0 END;
      s := FLOOR(p * dp);
      u := 0.2 + Math.sin(a) * 0.1;
      CubIso(cx, cy - D(60), s, Am(214, 150, 84, u), Am(100, 80, 40, 0.35), Am(60, 50, 20, 0.4), Am(214, 150, 84, 0.6));
      IF faza = 3 THEN
        FOR i := 0 TO 6 DO
          ang := FLT(i) / 7.0 * Math.pi * 2.0 + a * 0.5;
          x := cx + FLOOR(Math.cos(ang) * FLT(D(80))); y := cy - D(60) + FLOOR(Math.sin(ang) * FLT(D(40)));
          Ecran.Culoare(Am(214, 150, 84, 0.35 + Math.sin(a * 2.0 + FLT(i)) * 0.3)); Ecran.Disc(x, y, D(2))
        END
      END
    END;
    (* textul fazei care pulseaza, sub-titlul si bara *)
    Ecran.Culoare(Am(214, 150, 84, 0.8 + 0.2 * Math.cos(FLT(e) / 1000.0 * 2.0 * Math.pi)));
    TC(cx, cy + D(30), D(30), fazaTxt[faza]);
    Ecran.Culoare(Am(0, 212, 255, 0.7)); TC(cx, cy + D(62), D(14), fazaSub[faza]);
    lb := Min(D(300), W - D(40));
    Ecran.Culoare(Ecran.RGB(168, 148, 206)); Ecran.Dreptunghi(cx - lb DIV 2, cy + D(88), lb, D(3));
    f := fazaBar[faza];
    IF faza > 0 THEN   (* tranzitia de 0.3 s din CSS *)
      u := FLT(e - fazaT[faza]) / 300.0; IF u > 1.0 THEN u := 1.0 END;
      f := fazaBar[faza - 1] + FLOOR(FLT(fazaBar[faza] - fazaBar[faza - 1]) * u)
    END;
    f := lb * f DIV 100;
    FOR k := 0 TO 9 DO   (* degradeul auriu -> cyan, in 10 felii *)
      u := FLT(k) / 9.0;
      Ecran.Culoare(Ecran.RGB(200 - FLOOR(200.0 * u), 169 + FLOOR(43.0 * u), 110 + FLOOR(145.0 * u)));
      x := lb * k DIV 10; IF x < f THEN Ecran.Dreptunghi(cx - lb DIV 2 + x, cy + D(88), Min(lb DIV 10 + 1, f - x), D(3)) END
    END
  END Boot;

  (* ---------- desktopul ---------- *)

  PROCEDURE PunStele;
    VAR i: INTEGER;
  BEGIN
    FOR i := 0 TO NS - 1 DO
      sx[i] := RndR() * FLT(W); sy[i] := RndR() * FLT(tbY);
      sr[i] := RndR() * 1.2 + 0.3; sa[i] := RndR();
      sda[i] := (RndR() - 0.5) * 0.005; sdx[i] := (RndR() - 0.5) * 0.08
    END
  END PunStele;

  PROCEDURE FundalDesen(e: INTEGER);
    VAR k, S, h, off, x, r, i: INTEGER; L, f: REAL;
  BEGIN
    Ecran.Fond(Ecran.RGB(18, 6, 32));   (* 7·B v2: violet inchis *)
    FOR k := 5 TO 1 BY -1 DO   (* degradeul radial, in inele *)
      f := (FLT(k) - 0.5) / 5.0;
      Ecran.Culoare(Ecran.RGB(38 - FLOOR(16.0 * f), 14 - FLOOR(7.0 * f), 64 - FLOOR(26.0 * f)));
      Ecran.Disc(W DIV 2, H DIV 2, H * k DIV 5)
    END;
    (* grila izometrica: romburile sunt doua familii de linii paralele *)
    S := D(36); h := FLOOR(FLT(S) * 0.577); IF h < 1 THEN h := 1 END;
    off := FLOOR(FLT(e) * 0.00009 * dp) MOD (2 * S);
    L := FLT(H) * FLT(S) / FLT(h);
    f := 1.0 - FLT(acum - undaDe) / 400.0; IF f < 0.0 THEN f := 0.0 END;   (* o scriere oriunde in tor: toata grila o simte *)
    Ecran.Culoare(Am(214, 150, 84, 0.08 + 0.12 * f)); Ecran.Grosime(G1);
    x := off + S - (FLOOR(L) DIV (2 * S) + 2) * 2 * S;
    WHILE x <= W + FLOOR(L) DO
      IF (x <= W) & (x + FLOOR(L) >= 0) THEN Ecran.Linie(x, 0, x + FLOOR(L), H) END;
      IF (x >= 0) & (x - FLOOR(L) <= W) THEN Ecran.Linie(x, 0, x - FLOOR(L), H) END;
      x := x + 2 * S
    END;
    (* stelele *)
    f := FLT(dt) / 16.7;
    FOR i := 0 TO NS - 1 DO
      sa[i] := sa[i] + sda[i] * f;
      IF sa[i] < 0.0 THEN sda[i] := ABS(sda[i]) END;
      IF sa[i] > 1.0 THEN sda[i] := -ABS(sda[i]) END;
      sx[i] := sx[i] + sdx[i] * f * dp;
      IF sx[i] < 0.0 THEN sx[i] := FLT(W) ELSIF sx[i] > FLT(W) THEN sx[i] := 0.0 END;
      Ecran.Culoare(Am(214, 150, 84, sa[i] * 0.8));
      r := FLOOR(sr[i] * dp + 0.5); IF r < 1 THEN r := 1 END;
      Ecran.Disc(FLOOR(sx[i]), FLOOR(sy[i]), r)
    END;
    (* cubul stins din fundal *)
    k := Min(W, H) * 18 DIV 100;
    CubIso(W - k * 3 DIV 2, H * 3 DIV 10, k, Am(214, 150, 84, 0.06), Am(100, 80, 40, 0.1), Am(60, 50, 20, 0.12), Am(214, 150, 84, 0.1))
  END FundalDesen;

  PROCEDURE BaraSus;
    VAR u: REAL;
  BEGIN
    Ecran.Culoare(cWin); Ecran.Dreptunghi(0, 0, W, barH);
    Ecran.Culoare(cBord); Ecran.Grosime(G1); Ecran.Linie(0, barH, W, barH);
    Ecran.Culoare(cGold); T(D(10), barH DIV 2 + D(5), D(13), "⬡ CUBICUM 7·B");
    u := 0.6 + 0.4 * Math.sin(FLT(acum) / 900.0);
    IF acum - salDe < 3000 THEN Ecran.Culoare(cRed); TC(W DIV 2 + D(20), barH DIV 2 + D(6), D(14), "∿ BURN?")
    ELSE Ecran.Culoare(Am(214, 150, 84, u)); TC(W DIV 2 + D(20), barH DIV 2 + D(6), D(16), "∿ SAL")
    END;
    Ceas; Ecran.Culoare(cGold2); TD(W - D(10), barH DIV 2 + D(6), D(15), ceasS)
  END BaraSus;

  PROCEDURE BaraJos;
    VAR i, x, y, w, h: INTEGER;
  BEGIN
    Ecran.Culoare(cWin); Ecran.Dreptunghi(0, tbY - D(6), W, H - tbY + D(6));
    Ecran.Culoare(cBord); Ecran.Grosime(G1); Ecran.Linie(0, tbY, W, tbY);
    FOR i := 0 TO NF - 1 DO
      TbBtn(i, x, y, w, h);
      IF i = cur THEN Buton2(x, y, w, h, icon[i], scurt[i], Am(0, 212, 255, 0.15), cCyan, cCyan)
      ELSE Buton2(x, y, w, h, icon[i], scurt[i], Am(214, 150, 84, 0.1), cGold, Am(214, 150, 84, 0.45))
      END
    END
  END BaraJos;

  PROCEDURE CorpFereastra;
  BEGIN Ecran.Culoare(cWin); Ecran.Dreptunghi(wx, wy, ww, wh)
  END CorpFereastra;

  PROCEDURE ZoomB(k: INTEGER; VAR x, y, w, h: INTEGER);   (* 7·B v12: ↑ A− A+ in bara de titlu a Shell-ului (0 = ↑, 1 = A−, 2 = A+) *)
  BEGIN w := D(36); h := D(24); x := wx + ww - D(74) - (3 - k) * w - (2 - k) * D(5); y := wy + (titH - h) DIV 2
  END ZoomB;

  PROCEDURE TitluFereastra;
    VAR s: ARRAY 64 OF CHAR; cy, k, x, y, w, h: INTEGER;
  BEGIN
    Ecran.Culoare(cWin); Ecran.Dreptunghi(wx, wy, ww, titH);
    Ecran.Culoare(cTitlu); Ecran.Dreptunghi(wx, wy, ww, titH);
    Ecran.Culoare(cBord); Ecran.Grosime(G1); Ecran.Linie(wx, wy + titH, wx + ww, wy + titH);
    s := ""; Strings.Append(icon[cur], s); Strings.Append("  ", s); Strings.Append(titlu[cur], s);
    Ecran.Culoare(cGold); T(wx + D(12), wy + titH DIV 2 + D(5), D(15), s);
    cy := wy + titH DIV 2;
    Ecran.Culoare(Ecran.RGB(251, 191, 36)); Ecran.Disc(wx + ww - D(48), cy, D(8));
    Ecran.Culoare(Ecran.RGB(239, 68, 68)); Ecran.Disc(wx + ww - D(20), cy, D(8));
    Ecran.Culoare(Ecran.RGB(0, 0, 0)); TC(wx + ww - D(48), cy + D(4), D(11), "─");
    Ecran.Culoare(Ecran.RGB(255, 255, 255)); TC(wx + ww - D(20), cy + D(4), D(11), "✕");
    IF (cur = 3) & ~appVede & ~editor THEN   (* 7·B v12: ↑ A− A+ *)
      FOR k := 0 TO 2 DO
        ZoomB(k, x, y, w, h);
        Ecran.Culoare(Am(214, 150, 84, 0.12)); Ecran.Dreptunghi(x, y, w, h);
        Ecran.Culoare(Am(214, 150, 84, 0.6)); Ecran.Grosime(G1); Contur(x, y, w, h);
        Ecran.Culoare(cGold); IF k = 0 THEN TC(x + w DIV 2, y + h DIV 2 + D(5), D(14), "↑") ELSIF k = 1 THEN TC(x + w DIV 2, y + h DIV 2 + D(4), D(11), "A−") ELSE TC(x + w DIV 2, y + h DIV 2 + D(5), D(14), "A+") END
      END
    END;
    Ecran.Culoare(cBordF); Contur(wx, wy, ww, wh)
  END TitluFereastra;

  (* ---------- ferestrele ---------- *)

  PROCEDURE ProcRand(i: INTEGER): INTEGER;   (* y-ul de sus al randului turei i *)
  BEGIN RETURN by + D(62) + i * D(30)
  END ProcRand;

  PROCEDURE ProcB(k: INTEGER; VAR x, y, w, h: INTEGER);   (* OPRESTE si BURN *)
  BEGIN w := (bw - D(8)) DIV 2; h := D(36); x := bx + k * (w + D(8)); y := ProcRand(7) + D(8)
  END ProcB;


  PROCEDURE Progs(VAR idx: ARRAY OF INTEGER): INTEGER;   (* v2.7c: intai aplicatiile .app (si jocul), apoi programele .z7 *)
    VAR i, n, t: INTEGER; s: ARRAY 32 OF CHAR;
  BEGIN
    n := 0;
    FOR t := 5 TO 4 BY -1 DO
      FOR i := 0 TO CFS.N() - 1 DO CFS.Nume(i, s); IF (CFS.Tip(s) = t) & (n < LEN(idx)) THEN idx[n] := i; INC(n) END END
    END;
    RETURN n
  END Progs;

  PROCEDURE SelB(k: INTEGER; VAR x, y, w, h: INTEGER);   (* v2.7c: 0 = ◀, 1 = casuta, 2 = ▶ *)
    VAR a: INTEGER;
  BEGIN
    a := D(52); y := ProcRand(7) + D(78); h := D(84);
    IF k = 0 THEN x := bx; w := a ELSIF k = 1 THEN x := bx + a + D(6); w := bw - 2 * a - D(12) ELSE x := bx + bw - a; w := a END
  END SelB;

  PROCEDURE Descriere(i: INTEGER; VAR d: ARRAY OF CHAR);   (* ce scrie despre program: randul 2 la .app, comentariul # la .z7 *)
    VAR c: ARRAY LC OF CHAR; n: ARRAY 32 OF CHAR; j, k: INTEGER;
  BEGIN
    CFS.Continut(i, c); CFS.Nume(i, n); j := 0; k := 0; d[0] := 0X;
    IF CFS.Tip(n) = 5 THEN WHILE (c[j] # 0X) & (c[j] # 0AX) DO INC(j) END; IF c[j] = 0AX THEN INC(j) END
    ELSE WHILE (c[j] = "#") OR (c[j] = " ") DO INC(j) END
    END;
    WHILE (c[j] # 0X) & (c[j] # 0AX) & (k < LEN(d) - 1) DO d[k] := c[j]; INC(k); INC(j) END;
    d[k] := 0X
  END Descriere;

  PROCEDURE Procese;
    VAR i, y, yb, x1, x2, x3, st, n, x, w, h, k: INTEGER; s, t: ARRAY 64 OF CHAR; idx: ARRAY 64 OF INTEGER; d: ARRAY 600 OF CHAR;
  BEGIN
    s := "∿ salamandra (pid 1) · sesiunea "; Strings.AppendInt(Sal.Sesiune(), 0, s);
    Strings.Append(" · câmp ", s); Strings.AppendInt(Tor7.Camp(), 0, s);
    Ecran.Culoare(cGold); T(bx, by + D(14), D(12), s);
    s := "procesor = memorie = torul Z₇⁷ · scrieri: "; Strings.AppendInt(Tor7.Scrieri(), 0, s);
    Ecran.Culoare(Ecran.RGB(184, 164, 222)); T(bx, by + D(31), D(10), s);
    x1 := bx + bw * 47 DIV 100; x2 := bx + bw * 58 DIV 100; x3 := bx + bw;
    y := by + D(54);
    Ecran.Culoare(cGold); T(bx, y, D(10), "TURA"); T(bx + D(42), y, D(10), "PROCES"); T(x1, y, D(10), "PID");
    T(x2, y, D(10), "STARE"); TD(x3, y, D(10), "CPU%");
    Ecran.Culoare(Ecran.RGB(168, 148, 206)); Ecran.Grosime(G1); Ecran.Linie(bx, y + D(6), x3, y + D(6));
    FOR i := 0 TO Sal.NP - 1 DO
      y := ProcRand(i); yb := y + D(21); st := Sal.Stare(i);
      IF i = procSel THEN Ecran.Culoare(Am(0, 212, 255, 0.12)); Ecran.Dreptunghi(bx, y + D(3), bw, D(27)) END;
      s := ""; Strings.AppendInt(i + 1, 0, s); Ecran.Culoare(Am(214, 150, 84, 0.6)); T(bx + D(10), yb, D(12), s);   (* 7·B: tura 1..7 *)
      IF st = Sal.Liber THEN Ecran.Culoare(Ecran.RGB(168, 148, 206)); T(bx + D(42), yb, D(12), "· liber")
      ELSE
        Sal.Nume(i, s); Ecran.Culoare(cCyan); T(bx + D(42), yb, D(12), s);
        s := ""; Strings.AppendInt(Sal.Pid(i), 0, s); Ecran.Culoare(Am(200, 200, 232, 0.6)); T(x1, yb, D(12), s);
        IF st = Sal.Activ THEN Ecran.Culoare(cGreen) ELSIF st = Sal.Simte THEN Ecran.Culoare(cCyan)
        ELSIF st = Sal.Primeste THEN Ecran.Culoare(cPurple) ELSE Ecran.Culoare(Am(200, 200, 232, 0.6))
        END;
        Sal.NumeStare(st, t); T(x2, yb, D(10), t);
        s := ""; Strings.AppendInt(Sal.Cpu(i), 0, s); Ecran.Culoare(cPurple); TD(x3, yb, D(12), s)
      END
    END;
    ProcB(0, x, y, w, h);
    IF (procSel >= 0) & (Sal.Stare(procSel) # Sal.Liber) THEN Buton(x, y, w, h, "■ OPREȘTE", Am(255, 51, 102, 0.1), cRed, Am(255, 51, 102, 0.5))
    ELSE Buton(x, y, w, h, "■ OPREȘTE", cWin, cDim, cDim)
    END;
    ProcB(1, x, y, w, h);
    IF acum - salDe < 3000 THEN Buton(x, y, w, h, "∿ SIGUR? ATINGE IAR", Am(255, 51, 102, 0.3), cRed, cRed)
    ELSE Buton(x, y, w, h, "∿ BURN", Am(214, 150, 84, 0.1), cGold, Am(214, 150, 84, 0.3))
    END;
    Ecran.Culoare(Ecran.RGB(184, 164, 222)); T(bx, ProcRand(7) + D(66), D(10), "din Cubicum FS: ▶ program pe spirală · ↗ aplicație");
    n := Progs(idx);
    IF n > 0 THEN   (* v2.7c: selectorul ◀ casuta ▶ *)
      IF progI >= n THEN progI := 0 END;
      SelB(0, x, y, w, h); Buton(x, y, w, h, "◀", Am(214, 150, 84, 0.1), cGold, Am(214, 150, 84, 0.3));
      SelB(2, x, y, w, h); Buton(x, y, w, h, "▶", Am(214, 150, 84, 0.1), cGold, Am(214, 150, 84, 0.3));
      SelB(1, x, y, w, h); CFS.Nume(idx[progI], t);
      IF CFS.Tip(t) = 5 THEN k := Strings.Pos(".", t, 0); IF k > 0 THEN t[k] := 0X END; s := "↗ "; i := cCyan
      ELSE k := Strings.Pos(".z7l", t, 0); IF k > 0 THEN t[k] := 0X END; s := "▶ "; i := cGreen
      END;
      Strings.Append(t, s);
      IF progAles = progI THEN
        Ecran.Culoare(Am(251, 191, 36, 0.14)); Ecran.Dreptunghi(x, y, w, h); Ecran.Culoare(cYel); Ecran.Grosime(2 * G1); Contur(x, y, w, h)
      ELSE Ecran.Culoare(Am(0, 212, 255, 0.06)); Ecran.Dreptunghi(x, y, w, h); Ecran.Culoare(Am(214, 150, 84, 0.35)); Ecran.Grosime(G1); Contur(x, y, w, h)
      END;
      Ecran.Culoare(i); TC(x + w DIV 2, y + D(30), D(17), s);
      t := ""; Strings.AppendInt(progI + 1, 0, t); Strings.Append(" / ", t); Strings.AppendInt(n, 0, t);
      Ecran.Culoare(Ecran.RGB(184, 164, 222)); TC(x + w DIV 2, y + D(52), D(10), t);
      IF progAles = progI THEN Ecran.Culoare(cYel); TC(x + w DIV 2, y + D(72), D(11), "atinge iar ca să pornească")
      ELSE Ecran.Culoare(Am(214, 150, 84, 0.6)); TC(x + w DIV 2, y + D(72), D(10), "atinge o dată: alegi")
      END;
      Descriere(idx[progI], d);   (* sub selector: ce face *)
      IF Strings.Length(d) > 0 THEN
        Ecran.Culoare(Am(200, 200, 232, 0.7)); k := Paragraf(bx, y + h + D(22), D(11), bw, d)
      END
    END;
    IF n = 0 THEN Ecran.Culoare(cDim); T(bx, ProcRand(7) + D(96), D(11), "niciun .z7 în cub") END;
    IF acum < mesajPana THEN Ecran.Culoare(cCyan); TC(bx + bw DIV 2, by + bh - D(6), D(11), mesaj) END
  END Procese;

  PROCEDURE FereastraRetea;
    VAR i, j, k, cx, cy, r, x, y, c: INTEGER; nx, ny: ARRAY 7 OF INTEGER; ang: REAL; activ, viu: BOOLEAN; s: ARRAY 48 OF CHAR;
  BEGIN
    cx := bx + bw DIV 2; cy := by + bh DIV 2 - D(10); r := Min(bw, bh) * 65 DIV 200;
    FOR i := 0 TO 6 DO
      ang := FLT(i) / 7.0 * Math.pi * 2.0 - Math.pi / 2.0;
      nx[i] := cx + FLOOR(Math.cos(ang) * FLT(r)); ny[i] := cy + FLOOR(Math.sin(ang) * FLT(r))
    END;
    Ecran.Grosime(G1);
    FOR i := 0 TO 5 DO
      FOR j := i + 1 TO 6 DO
        IF (Sal.Stare(i) # Sal.Liber) & (Sal.Stare(j) # Sal.Liber) THEN Ecran.Culoare(Am(214, 150, 84, 0.35))
        ELSE Ecran.Culoare(Am(214, 150, 84, 0.1))
        END;
        Ecran.Linie(nx[i], ny[i], nx[j], ny[j])
      END
    END;
    k := 0;
    FOR i := 0 TO npk - 1 DO
      pkU[i] := pkU[i] + 0.03 * FLT(dt) / 16.7;
      IF pkU[i] <= 1.0 THEN pkF[k] := pkF[i]; pkT[k] := pkT[i]; pkU[k] := pkU[i]; pkC[k] := pkC[i]; INC(k) END
    END;
    npk := k;
    FOR i := 0 TO npk - 1 DO
      x := nx[pkF[i]] + FLOOR(FLT(nx[pkT[i]] - nx[pkF[i]]) * pkU[i]);
      y := ny[pkF[i]] + FLOOR(FLT(ny[pkT[i]] - ny[pkF[i]]) * pkU[i]);
      IF pkF[i] = pkT[i] THEN y := y - D(20) + FLOOR(FLT(D(20)) * pkU[i]) END;
      Ecran.Culoare(pkC[i]); Ecran.Disc(x, y, D(4));
      IF pkC[i] = cGreen THEN c := Am(57, 255, 20, 0.3) ELSE c := Am(255, 51, 102, 0.3) END;
      Ecran.Culoare(c); Ecran.Cerc(x, y, D(7))
    END;
    FOR i := 0 TO 6 DO
      activ := FALSE; viu := Sal.Stare(i) # Sal.Liber;
      FOR k := 0 TO npk - 1 DO IF (pkF[k] = i) OR (pkT[k] = i) & (pkU[k] > 0.9) THEN activ := TRUE END END;
      IF activ THEN Ecran.Culoare(Am(57, 255, 20, 0.3)) ELSIF viu THEN Ecran.Culoare(Am(214, 150, 84, 0.18)) ELSE Ecran.Culoare(cWin) END;
      Ecran.Disc(nx[i], ny[i], D(18));
      IF activ THEN Ecran.Culoare(cGreen) ELSIF viu THEN Ecran.Culoare(cGold) ELSE Ecran.Culoare(Ecran.RGB(168, 148, 206)) END;
      Ecran.Cerc(nx[i], ny[i], D(18));
      IF viu THEN Sal.Nume(i, s); s[4] := 0X ELSE s := "·" END;
      TC(nx[i], ny[i] + D(4), D(10), s);
      s := "tura "; Strings.AppendInt(i + 1, 0, s); Ecran.Culoare(Ecran.RGB(184, 164, 222)); TC(nx[i], ny[i] + D(32), D(9), s)
    END;
    s := "mesaje reale între procese: "; Strings.AppendInt(Sal.Trimise(), 0, s);
    Ecran.Culoare(cText); TC(cx, by + bh - D(24), D(11), s);
    Ecran.Culoare(Ecran.RGB(184, 164, 222)); TC(cx, by + bh - D(6), D(10), "verde = ajuns · roșu = tura e goală, mesajul se pierde")
  END FereastraRetea;

  PROCEDURE Alchimist;
    VAR i, y, rh, st, xb, yb: INTEGER;
  BEGIN
    Ecran.Culoare(cGold); TC(bx + bw DIV 2, by + D(22), D(20), "⚗ ALCHIMIST");
    rh := D(50); y := by + D(36);
    FOR i := 0 TO 7 DO
      Ecran.Culoare(Am(214, 150, 84, 0.15)); Ecran.Grosime(G1); Contur(bx, y, bw, rh - D(6));
      Ecran.Culoare(cGold); TC(bx + D(18), y + D(29), D(20), asym[i]);
      Ecran.Culoare(cGold2); T(bx + D(38), y + D(19), D(13), anume[i]);
      Ecran.Culoare(Am(200, 200, 232, 0.5)); T(bx + D(38), y + D(36), D(10), adesc[i]);
      st := StareAlch(i); xb := bx + bw - D(86); yb := y + (rh - D(6)) DIV 2 - D(10);
      IF st = 2 THEN
        Ecran.Culoare(Am(57, 255, 20, 0.15)); Ecran.Dreptunghi(xb, yb, D(80), D(20));
        Ecran.Culoare(cGreen); TC(xb + D(40), yb + D(14), D(10), "INSTALAT")
      ELSIF st = 1 THEN
        Ecran.Culoare(cYel); TC(xb + D(40), yb + D(14), D(10), "INSTALEZ...")
      ELSE
        Ecran.Culoare(Am(0, 212, 255, 0.1)); Ecran.Dreptunghi(xb, yb, D(80), D(20));
        Ecran.Culoare(cCyan); TC(xb + D(40), yb + D(14), D(10), "DISPONIBIL")
      END;
      y := y + rh
    END;
    Ecran.Culoare(Ecran.RGB(168, 148, 206)); T(bx, y + D(14), D(10), "un pachet instalat = un fișier .pkg în Cubicum FS")
  END Alchimist;

  PROCEDURE ShellB(k: INTEGER; VAR x, y, w, h: INTEGER);   (* 7·B v2: cele 10 comenzi rapide pe o singura banda ingusta *)
  BEGIN
    w := (bw - 9 * D(3)) DIV 10; h := D(28);
    x := bx + k * (w + D(3)); y := by + bh - h
  END ShellB;


  PROCEDURE EdLinii(m: INTEGER);   (* 7·B v6: randurile vazute: unde incepe fiecare (rupte la Enter sau la latime) *)
    VAR i, k, maxc: INTEGER;
  BEGIN
    maxc := (bw - D(8)) * 100 DIV (m * Av); IF maxc < 8 THEN maxc := 8 END;
    edLs[0] := 0; edNL := 1; i := 0; k := 0;
    WHILE (i < edN) & (edNL < LEN(edLs)) DO
      IF edT[i] = 0AX THEN edLs[edNL] := i + 1; INC(edNL); k := 0
      ELSE INC(k); IF (k >= maxc) & (i + 1 < edN) & (edT[i + 1] # 0AX) THEN edLs[edNL] := i + 1; INC(edNL); k := 0 END
      END;
      INC(i)
    END
  END EdLinii;

  PROCEDURE EdRand(c: INTEGER): INTEGER;   (* randul vazut in care sta indicele c *)
    VAR j: INTEGER;
  BEGIN j := edNL - 1; WHILE (j > 0) & (edLs[j] > c) DO DEC(j) END; RETURN j
  END EdRand;

  PROCEDURE EdCapat(j: INTEGER): INTEGER;   (* unde se termina randul j (inaintea Enter-ului lui) *)
    VAR e: INTEGER;
  BEGIN
    IF j + 1 < edNL THEN e := edLs[j + 1]; IF (e > 0) & (edT[e - 1] = 0AX) THEN DEC(e) END ELSE e := edN END;
    RETURN e
  END EdCapat;

  PROCEDURE EdSus(m: INTEGER): INTEGER;   (* y-ul primului rand de text *)
  BEGIN RETURN by + D(24) + m DIV 4
  END EdSus;

  PROCEDURE EdViz(m: INTEGER): INTEGER;   (* cate randuri incap *)
    VAR x, y, w, h, v: INTEGER;
  BEGIN ShellB(0, x, y, w, h); v := (y - D(10) - EdSus(m)) DIV (m * 17 DIV 12); IF v < 1 THEN v := 1 END; RETURN v
  END EdViz;

  PROCEDURE Editor;   (* 7·B v6: desenul editorului *)
    VAR m, lh, a, i, j, e, k, x, y, w, h, top, viz, cr, lm: INTEGER; s: ARRAY 200 OF CHAR;
  BEGIN
    m := D(shPt); lh := m * 17 DIV 12; a := m * Av; EdLinii(m);
    top := EdSus(m); viz := EdViz(m); cr := EdRand(edC);
    IF edUrm THEN IF cr < edSus THEN edSus := cr ELSIF cr >= edSus + viz THEN edSus := cr - viz + 1 END; edUrm := FALSE END;
    IF edSus > edNL - 1 THEN edSus := edNL - 1 END; IF edSus < 0 THEN edSus := 0 END;
    s := "✎ "; Strings.Append(edNumeE, s); Strings.Append(" · rândul ", s); Strings.AppendInt(cr + 1, 0, s); Strings.Append(" din ", s);
    Strings.AppendInt(edNL, 0, s); Strings.Append(" · ", s); Strings.AppendInt(edN, 0, s); Strings.Append(" / ", s); Strings.AppendInt(LC - 1, 0, s);
    IF edMod THEN Strings.Append(" · nesalvat", s) END;
    Ecran.Culoare(cYel); T(bx, by + D(12), D(11), s);
    IF acum - edMsgDe < 4000 THEN Ecran.Culoare(cGold); T(bx, by + D(24), D(9), edMsg) END;
    FOR j := edSus TO edSus + viz - 1 DO
      IF j < edNL THEN
        e := EdCapat(j); k := 0; i := edLs[j];
        WHILE (i < e) & (k < LEN(s) - 1) DO s[k] := edT[i]; INC(k); INC(i) END; s[k] := 0X;
        y := top + (j - edSus + 1) * lh;
        Ecran.Culoare(cText); T(bx, y, m, s);
        IF (j = cr) & (acum DIV 500 MOD 2 = 0) THEN
          Ecran.Culoare(cGreen); Ecran.Dreptunghi(bx + (edC - edLs[j]) * a DIV 100, y - m, D(2), m + D(3))
        END
      END
    END;
    IF edNL > viz THEN   (* bara: unde esti in text *)
      h := (viz * (EdViz(m) * lh)) DIV edNL; IF h < D(30) THEN h := D(30) END;
      y := top + (EdViz(m) * lh - h) * edSus DIV (edNL - viz + 1);
      Ecran.Culoare(Am(214, 150, 84, 0.5)); Ecran.Dreptunghi(bx + bw - D(4), y, D(4), h)
    END;
    FOR k := 0 TO 9 DO
      ShellB(k, x, y, w, h);
      IF (k >= 7) & ((k # 8) OR edMod) THEN Ecran.Culoare(Am(214, 150, 84, 0.25)) ELSE Ecran.Culoare(Am(214, 150, 84, 0.1)) END;
      Ecran.Dreptunghi(x, y, w, h);
      Ecran.Culoare(Am(214, 150, 84, 0.5)); Ecran.Grosime(G1); Contur(x, y, w, h);
      IF k < 7 THEN lm := D(17) ELSE lm := (w - D(4)) * 100 DIV (6 * Av); IF lm > D(14) THEN lm := D(14) END END;   (* sagetile mari, cuvintele cat incap *)
      Ecran.Culoare(cGold); TC(x + w DIV 2, y + h DIV 2 + lm DIV 3, lm, edB[k])
    END
  END Editor;

  PROCEDURE EdPune(ch: CHAR);   (* un semn la cursor *)
    VAR i: INTEGER;
  BEGIN
    IF edN < LC - 1 THEN
      FOR i := edN TO edC + 1 BY -1 DO edT[i] := edT[i - 1] END;
      edT[edC] := ch; INC(edN); INC(edC); edT[edN] := 0X; edMod := TRUE; edUrm := TRUE; edIes := FALSE
    ELSE edMsg := "fișierul e plin (un fișier din cub ține cel mult 1599 de semne)"; edMsgDe := acum
    END
  END EdPune;

  PROCEDURE EdSterge;   (* semnul dinaintea cursorului *)
    VAR i: INTEGER;
  BEGIN
    IF edC > 0 THEN
      FOR i := edC - 1 TO edN - 2 DO edT[i] := edT[i + 1] END;
      DEC(edN); DEC(edC); edT[edN] := 0X; edMod := TRUE; edUrm := TRUE; edIes := FALSE
    END
  END EdSterge;

  PROCEDURE EdSalveaza(): BOOLEAN;
    VAR k: INTEGER; a: ARRAY 64 OF CHAR;
  BEGIN
    k := CFS.Scrie(edNumeE, edT);
    IF k >= 0 THEN
      edMod := FALSE; edMsg := "salvat → cfs://"; CFS.AdresaText(k, a); Strings.Append(a, edMsg)
    ELSE edMsg := "n-am putut salva (cubul e plin?)"
    END;
    edMsgDe := acum;
    RETURN k >= 0
  END EdSalveaza;

  PROCEDURE EdButon(k: INTEGER);   (* ◀ ▶ ▲ ▼ ⇤ ⇥ ⌨ rulez salvez iesire *)
    VAR m, cr, col: INTEGER; c: ARRAY 64 OF CHAR;
  BEGIN
    m := D(shPt); EdLinii(m); cr := EdRand(edC); edUrm := TRUE;
    IF (k = 0) & (edC > 0) THEN DEC(edC)
    ELSIF (k = 1) & (edC < edN) THEN INC(edC)
    ELSIF ((k = 2) & (cr > 0)) OR ((k = 3) & (cr + 1 < edNL)) THEN
      col := edC - edLs[cr]; IF k = 2 THEN DEC(cr) ELSE INC(cr) END;
      edC := edLs[cr] + col; IF edC > EdCapat(cr) THEN edC := EdCapat(cr) END
    ELSIF k = 4 THEN edC := edLs[cr]
    ELSIF k = 5 THEN edC := EdCapat(cr)
    ELSIF k = 6 THEN tastatura := ~tastatura; Ecran.Tastatura(tastatura)
    ELSIF k = 7 THEN   (* rulez: salvez si pornesc programul *)
      IF (Strings.Pos(".z7", edNumeE, 0) > 0) & EdSalveaza() THEN
        editor := FALSE; c := "run "; Strings.Append(edNumeE, c); Rand(cGold, "✎ salvat · îl pornesc:"); ExecLinie(c)
      ELSIF Strings.Pos(".z7", edNumeE, 0) < 0 THEN edMsg := "doar programele .z7 / .z7l se rulează · salvez îl păstrează"; edMsgDe := acum
      END
    ELSIF k = 8 THEN IF EdSalveaza() THEN Sunet.Nota(523, 80, 20) END
    ELSIF k = 9 THEN
      IF edMod & ~edIes THEN edIes := TRUE; edMsg := "nesalvat! încă o dată ieșire = renunți la schimbări · salvez = le păstrezi"; edMsgDe := acum
      ELSE
        editor := FALSE; c := "✎ închis: "; Strings.Append(edNumeE, c); IF edMod THEN Strings.Append(" (fără schimbări)", c) END; Rand(cGold, c)
      END
    END
  END EdButon;

  PROCEDURE ApasaEditor(x, y: INTEGER);   (* butoanele, sau cursorul unde ai atins *)
    VAR k, bxx, byy, w, h, m, lh, j, col, gata: INTEGER;
  BEGIN
    gata := 0;
    FOR k := 0 TO 9 DO ShellB(k, bxx, byy, w, h); IF In(x, y, bxx, byy, w, h) THEN EdButon(k); gata := 1 END END;
    IF (gata = 0) & (y > by + D(20)) THEN
      m := D(shPt); lh := m * 17 DIV 12; EdLinii(m);
      j := edSus + (y - EdSus(m)) DIV lh; IF j >= edNL THEN j := edNL - 1 END; IF j < 0 THEN j := 0 END;
      col := (x - bx) * 100 DIV (m * Av); IF col < 0 THEN col := 0 END;
      edC := edLs[j] + col; IF edC > EdCapat(j) THEN edC := EdCapat(j) END;
      edIes := FALSE; IF ~tastatura THEN tastatura := TRUE; Ecran.Tastatura(TRUE) END
    END
  END ApasaEditor;

  PROCEDURE AppPune(op, a, b, c, d: INTEGER);   (* 7·B v7: o comanda de desen in lista care se scrie *)
    VAR k: INTEGER;
  BEGIN
    k := nd[0];
    IF k < LEN(dOp[0]) THEN dOp[0][k] := op; dA[0][k] := a; dB[0][k] := b; dC[0][k] := c; dD[0][k] := d; dE[0][k] := 0; INC(nd[0]) END
  END AppPune;

  PROCEDURE AppInalt(): INTEGER;   (* inaltimea panzei, in unitati (latimea = 343) *)
    VAR h: INTEGER;
  BEGIN h := 343; IF bw > 0 THEN h := (bh + hPlin - H) * 343 DIV bw END; RETURN h   (* 7·B v10: fara tastatura *)
  END AppInalt;

  PROCEDURE AppHook(t, cod: INTEGER): INTEGER;   (* 7·B v7: ASCULTA(-(3000 + cod)) dintr-un program Z7 *)
    VAR c, r0, r1, r2, r3, v, k, lt, i: INTEGER; nm: ARRAY 32 OF CHAR;
  BEGIN
    c := cod MOD 100; v := 0;
    r0 := Sal.Reg(t, 0); r1 := Sal.Reg(t, 1); r2 := Sal.Reg(t, 2); r3 := Sal.Reg(t, 3);
    IF (c >= 1) & (c <= 10) & (~appVede OR (appTura # t)) THEN   (* o aplicatie noua ia fereastra *)
      IF appTura # t THEN nd[0] := 0; nt[0] := 0; nd[1] := 0; nt[1] := 0; appM := 14 END;
      appTura := t; appVede := TRUE; cur := 3; Sal.Nume(t, nm); Strings.Copy(nm, appNume);
      IF tastatura THEN tastatura := FALSE; Ecran.Tastatura(FALSE) END
    END;
    IF c = 1 THEN AppPune(1, Ecran.RGB(r0, r1, r2), 0, 0, 0)
    ELSIF c = 2 THEN AppPune(2, r0, r1, r2, r3)
    ELSIF c = 3 THEN AppPune(3, r0, r1, r2, 0)
    ELSIF c = 4 THEN AppPune(4, r0, r1, r2, r3)
    ELSIF c = 5 THEN   (* TEXTN: numarul ca text *)
      nm := ""; Strings.AppendInt(r2, 0, nm); AppPune(6, r0, r1, appM, nt[0]);
      FOR i := 0 TO Strings.Length(nm) - 1 DO IF nt[0] < LEN(dT[0]) THEN dT[0][nt[0]] := nm[i]; INC(nt[0]) END END;
      IF nd[0] > 0 THEN dE[0][nd[0] - 1] := Strings.Length(nm) END
    ELSIF c = 6 THEN AppPune(6, r0, r1, appM, nt[0])
    ELSIF c = 7 THEN
      IF (nd[0] > 0) & (dOp[0][nd[0] - 1] = 6) & (nt[0] < LEN(dT[0])) & (r0 > 0) & (r0 < 65536) THEN
        dT[0][nt[0]] := CHR(r0); INC(nt[0]); INC(dE[0][nd[0] - 1])
      END
    ELSIF c = 8 THEN   (* ARATA: ce s-a scris se vede *)
      k := nd[0]; lt := nt[0];
      FOR i := 0 TO k - 1 DO dOp[1][i] := dOp[0][i]; dA[1][i] := dA[0][i]; dB[1][i] := dB[0][i]; dC[1][i] := dC[0][i]; dD[1][i] := dD[0][i]; dE[1][i] := dE[0][i] END;
      FOR i := 0 TO lt - 1 DO dT[1][i] := dT[0][i] END;
      nd[1] := k; nt[1] := lt
    ELSIF c = 9 THEN nd[0] := 0; nt[0] := 0
    ELSIF c = 10 THEN IF (r0 >= 4) & (r0 <= 200) THEN appM := r0 END
    ELSIF c = 20 THEN IF appAp THEN v := appX ELSE v := -1 END
    ELSIF c = 21 THEN IF appAp THEN v := appY ELSE v := -1 END
    ELSIF c = 22 THEN IF appAp & appVede THEN v := 1 END
    ELSIF c = 23 THEN v := 343
    ELSIF c = 24 THEN v := AppInalt()
    ELSIF (c >= 25) & (c <= 27) THEN
      k := CFS.Local(Os.CurrentTime()) MOD 86400;
      IF c = 25 THEN v := k DIV 3600 ELSIF c = 26 THEN v := k MOD 3600 DIV 60 ELSE v := k MOD 60 END
    ELSIF c = 28 THEN k := Sal.Reg(t, cod DIV 100); IF k > 0 THEN v := Rnd(k) END
    END;
    RETURN v
  END AppHook;

  PROCEDURE AppX(x: INTEGER): INTEGER;
  BEGIN RETURN bx + x * bw DIV 343
  END AppX;

  PROCEDURE AppY(y: INTEGER): INTEGER;
  BEGIN RETURN by + y * bw DIV 343
  END AppY;

  PROCEDURE AppInchide(VAR x, y, w, h: INTEGER);   (* butonul ✕ al aplicatiei, sus in dreapta *)
  BEGIN w := D(86); h := D(26); x := bx + bw - w; y := by
  END AppInchide;

  PROCEDURE Aplicatia;   (* 7·B v7: desenul aplicatiei Z7, in locul Shell-ului *)
    VAR i, k, x, y, w, h, x2, y2, m: INTEGER; t: ARRAY 200 OF CHAR;
  BEGIN
    IF (appTura < 0) OR (Sal.Stare(appTura) = Sal.Liber) THEN
      appVede := FALSE; t := "◀ aplicația s-a oprit: "; Strings.Append(appNume, t); Rand(cGold, t)
    ELSE
      Ecran.Culoare(Ecran.RGB(0, 0, 0)); Ecran.Dreptunghi(bx, by, bw, bh);
      FOR i := 0 TO nd[1] - 1 DO
        IF dOp[1][i] = 1 THEN Ecran.Culoare(dA[1][i])
        ELSIF dOp[1][i] = 2 THEN
          x := AppX(dA[1][i]); y := AppY(dB[1][i]); x2 := AppX(dA[1][i] + dC[1][i]); y2 := AppY(dB[1][i] + dD[1][i]);
          IF x < bx THEN x := bx END; IF y < by THEN y := by END; IF x2 > bx + bw THEN x2 := bx + bw END; IF y2 > by + bh THEN y2 := by + bh END;
          IF (x2 > x) & (y2 > y) THEN Ecran.Dreptunghi(x, y, x2 - x, y2 - y) END
        ELSIF dOp[1][i] = 3 THEN
          y := AppY(dB[1][i]); IF (y >= by) & (y <= by + bh) THEN Ecran.Disc(AppX(dA[1][i]), y, dC[1][i] * bw DIV 343 + 1) END
        ELSIF dOp[1][i] = 4 THEN Ecran.Grosime(D(2)); Ecran.Linie(AppX(dA[1][i]), AppY(dB[1][i]), AppX(dC[1][i]), AppY(dD[1][i]))
        ELSIF dOp[1][i] = 6 THEN
          k := 0; WHILE (k < dE[1][i]) & (k < LEN(t) - 1) DO t[k] := dT[1][dD[1][i] + k]; INC(k) END; t[k] := 0X;
          m := dC[1][i] * bw DIV 343; IF m < 4 THEN m := 4 END;
          T(AppX(dA[1][i]), AppY(dB[1][i]), m, t)
        END
      END;
      AppInchide(x, y, w, h);
      Ecran.Culoare(Am(214, 150, 84, 0.25)); Ecran.Dreptunghi(x, y, w, h);
      Ecran.Culoare(cGold); TC(x + w DIV 2, y + h DIV 2 + D(4), D(11), "✕ oprește")
    END
  END Aplicatia;

  PROCEDURE Shell;   (* 7·B v11: ce scrii e ultimul rand din fereastra, ca intr-un terminal *)
    VAR i, lh, k, x, y, w, h, jos, viz, sc, start, hb, yb, m, maxc, np, n, p, c, tot, col, lm: INTEGER;
      pr: ARRAY 8 OF CHAR; pl: ARRAY 24 OF ARRAY LL OF CHAR; cur1: BOOLEAN;
  BEGIN
    m := D(shPt); lh := m * 17 DIV 12;
    IF D(shPt) * Av > 0 THEN maxc := bw * 100 DIV (D(shPt) * Av) ELSE maxc := 40 END;   (* aceeasi latime ca Rand *)
    IF maxc < 10 THEN maxc := 10 ELSIF maxc > LL - 1 THEN maxc := LL - 1 END;
    IF editez THEN pr := "✎ > "; col := cYel ELSIF TuraSh() >= 0 THEN pr := "∿sh> "; col := cGreen ELSE pr := "Z₇ > "; col := cGold END;
    (* randul de scris, taiat pe latime: pl[0] incepe cu semnul, apoi ce ai scris *)
    n := Strings.Length(linie); p := 0; np := 0; c := maxc - Strings.Length(pr);
    REPEAT
      k := 0; WHILE (k < c) & (p < n) & (k < LL - 1) DO pl[np][k] := linie[p]; INC(k); INC(p) END; pl[np][k] := 0X;
      INC(np); c := maxc
    UNTIL (p >= n) OR (np >= 23);
    cur1 := Strings.Length(pl[np - 1]) + (Strings.Length(pr) * ORD(np = 1)) >= maxc;   (* cursorul trece pe randul urmator *)
    IF cur1 & (np < 23) THEN pl[np] := ""; INC(np) END;
    ShellB(0, x, y, w, h); jos := y - D(8);   (* 7·B v12: textul coboara pana la comenzi *)
    Ecran.Culoare(Ecran.RGB(168, 148, 206)); Ecran.Grosime(G1); Ecran.Linie(bx, jos + D(2), bx + bw, jos + D(2));
    viz := (jos - by) DIV lh; IF viz < 1 THEN viz := 1 END;
    tot := nsl + np; shSus := by; shJos := jos; shViz := viz; shLh := lh; shTot := tot;
    IF scroll[3] > (tot - viz) * lh THEN scroll[3] := (tot - viz) * lh END; IF scroll[3] < 0 THEN scroll[3] := 0 END;
    sc := scroll[3] DIV lh;
    start := tot - viz - sc; IF start < 0 THEN start := 0 END;
    i := start;
    WHILE (i < tot) & (i < start + viz) DO
      y := by + (i - start + 1) * lh;
      IF i < nsl THEN Ecran.Culoare(slc[i]); T(bx, y, m, sl[i])
      ELSE
        k := i - nsl; x := bx;
        IF k = 0 THEN Ecran.Culoare(col); T(bx, y, m, pr); x := bx + Lat(pr, m) END;
        Ecran.Culoare(cGreen); T(x, y, m, pl[k]);
        IF k = np - 1 THEN
          x := x + Lat(pl[k], m);
          IF tastatura OR editez THEN IF acum DIV 500 MOD 2 = 0 THEN T(x + D(2), y, m, "▌") END
          ELSIF linie = "" THEN Ecran.Culoare(Ecran.RGB(184, 164, 222)); T(x + D(4), y, m * 4 DIV 5, "atinge aici ca să scrii")
          END
        END
      END;
      INC(i)
    END;
    IF sc > 0 THEN Ecran.Culoare(cDim); TD(bx + bw, by + D(12), D(10), "↓ trage în jos / sus") END;
    IF tot > viz THEN   (* v5: bara din dreapta: cat vezi si unde esti *)
      hb := (jos - by) * viz DIV tot; IF hb < D(36) THEN hb := D(36) END;
      yb := by + (jos - by - hb) * (tot - viz - sc) DIV (tot - viz);
      Ecran.Culoare(Am(214, 150, 84, 0.12)); Ecran.Dreptunghi(bx + bw - D(3), by, D(3), jos - by);
      IF mutat = 3 THEN Ecran.Culoare(cGold); Ecran.Dreptunghi(bx + bw - D(6), yb, D(6), hb)
      ELSE Ecran.Culoare(Am(214, 150, 84, 0.5)); Ecran.Dreptunghi(bx + bw - D(4), yb, D(4), hb)
      END
    END;
    FOR k := 0 TO 9 DO
      ShellB(k, x, y, w, h);   (* 7·B v2: aceeasi marime de litera pe toata banda (cat incape „clear”) *)
      Ecran.Culoare(Am(214, 150, 84, 0.1)); Ecran.Dreptunghi(x, y, w, h);
      Ecran.Culoare(Am(214, 150, 84, 0.5)); Ecran.Grosime(G1); Contur(x, y, w, h);
      lm := (w - D(4)) * 100 DIV (5 * Av); IF lm > D(13) THEN lm := D(13) END;
      Ecran.Culoare(cGold); TC(x + w DIV 2, y + h DIV 2 + lm DIV 3, lm, cmd[k])
    END
  END Shell;

  PROCEDURE VM;
    VAR i, k, g, w, h, x, y, top, cs, gr, s, u, ul, n: INTEGER; t: ARRAY 72 OF CHAR; z: ARRAY 16 OF CHAR; d: ARRAY 7 OF INTEGER;
  BEGIN
    s := vmSel;
    IF Sal.Stare(s) = Sal.Liber THEN k := 0; WHILE (k < 7) & (Sal.Stare((s + k) MOD 7) = Sal.Liber) DO INC(k) END; IF k < 7 THEN s := (s + k) MOD 7; vmSel := s END END;
    IF Sal.Stare(s) # Sal.Liber THEN
      Sal.Nume(s, z); t := "tura "; Strings.AppendInt(s + 1, 0, t); Strings.Append(" · ", t); Strings.Append(z, t);
      Strings.Append(" · pc ", t); Strings.AppendInt(Sal.Pc(s), 0, t); Strings.Append("/", t); Strings.AppendInt(Sal.Lung(s), 0, t);
      Strings.Append(" · pași ", t); Strings.AppendInt(Sal.Pasi(s), 0, t)
    ELSE t := "niciun proces viu · registrele sunt goale"
    END;
    Ecran.Culoare(cGold2); T(bx, by + D(14), D(11), t);
    g := D(6); w := (bw - 6 * g) DIV 7; h := D(48); y := by + D(24);
    FOR i := 0 TO 6 DO
      x := bx + i * (w + g);
      Ecran.Culoare(Am(139, 92, 246, 0.1)); Ecran.Dreptunghi(x, y, w, h);
      Ecran.Culoare(Am(139, 92, 246, 0.3)); Ecran.Grosime(G1); Contur(x, y, w, h);
      z := "R"; Strings.AppendInt(i, 0, z); Ecran.Culoare(cPurple); TC(x + w DIV 2, y + D(16), D(10), z);
      IF Sal.Stare(s) # Sal.Liber THEN n := Sal.Reg(s, i) ELSE n := 0 END;
      z := ""; Strings.AppendInt(n, 0, z);
      u := D(16); IF Lat(z, u) > w - D(4) THEN u := (w - D(4)) * 100 DIV (Strings.Length(z) * 60) END;
      Ecran.Culoare(cCyan); TC(x + w DIV 2, y + D(39), u, z)
    END;
    Ecran.Culoare(Ecran.RGB(184, 164, 222)); TC(bx + bw DIV 2, y + h + D(14), D(9), "atinge registrele: următorul proces");
    (* campul si ultima scriere *)
    y := y + h + D(42);
    t := "câmp T = "; Strings.AppendInt(Tor7.Camp(), 0, t); Ecran.Culoare(cGreen); T(bx, y, D(17), t);
    t := "scrieri: "; Strings.AppendInt(Tor7.Scrieri(), 0, t); Ecran.Culoare(cText); TD(bx + bw, y, D(12), t);
    t := "Opal · ciclul "; Strings.AppendInt(Tor7.Ciclu(), 0, t); Strings.Append(" · bătaia ", t);
    Strings.AppendInt(Tor7.BataieOra(), 0, t); Strings.Append("/1155 · Roler/Do = colțul ", t); Strings.AppendInt(Tor7.Colt(), 0, t);
    Ecran.Culoare(cCyan); T(bx, y + D(40), D(11), t);
    ul := Tor7.Ultima();
    IF ul >= 0 THEN Tor7.Coord(ul, d) ELSE FOR k := 0 TO 6 DO d[k] := 0 END; d[6] := s END;
    t := "ultima scriere: "; FOR k := 0 TO 6 DO Strings.AppendInt(d[k] + 1, 0, t); IF k < 6 THEN Strings.Append(".", t) END END;
    IF ul >= 0 THEN Strings.Append("  (celula ", t); Strings.AppendInt(ul, 0, t); Strings.Append(")", t) END;
    Ecran.Culoare(cGold); T(bx, y + D(22), D(11), t);
    top := y + D(70);
    Ecran.Culoare(Ecran.RGB(184, 164, 222)); T(bx, top - D(10), D(10), "felia d0 × d1 prin ultima scriere · culoarea = nota");
    gr := D(4); cs := (bw - 6 * gr) DIV 7;
    IF (by + bh - top - 6 * gr) DIV 7 < cs THEN cs := (by + bh - top - 6 * gr) DIV 7 END;
    FOR i := 0 TO 48 DO
      x := bx + (i MOD 7) * (cs + gr); y := top + (i DIV 7) * (cs + gr);
      d[0] := i MOD 7; d[1] := i DIV 7; k := Tor7.Index(d);
      z := ""; Strings.AppendInt(Tor7.Citeste(k), 0, z);
      n := Tor7.Treapta(k);
      IF Tor7.Stare(k) = Tor7.Inactiv THEN Ecran.Culoare(Am(60, 60, 80, 0.3)) ELSE Ecran.Culoare(Roata(Tor7.Nuanta(n), 0.22)) END;
      Ecran.Dreptunghi(x, y, cs, cs);
      IF k = ul THEN Ecran.Culoare(cGreen) ELSE Ecran.Culoare(Am(214, 150, 84, 0.3)) END;
      Contur(x, y, cs, cs);
      Ecran.Culoare(cText); TC(x + cs DIV 2, y + cs DIV 2 + D(1), D(13), z);
      Ecran.Culoare(Roata(Tor7.Nuanta(n), 0.9)); TC(x + cs DIV 2, y + cs - D(5), D(9), notaN[n MOD 7])
    END
  END VM;

  PROCEDURE OrgaB(k: INTEGER; VAR x, y, w, h: INTEGER);
  BEGIN
    w := (bw - 4 * D(5)) DIV 5; h := D(36);
    x := bx + k * (w + D(5)); y := oBtnY
  END OrgaB;

  PROCEDURE Orga;
    VAR i, x, y, w, h, z: INTEGER; s: ARRAY 80 OF CHAR;
  BEGIN
    FOR i := 0 TO 342 DO
      NodP(i, x, y); z := i DIV 49;
      IF on[i] THEN
        Ecran.Culoare(Am(214, 150, 84, 0.22)); Ecran.Disc(x, y, D(12));
        Ecran.Culoare(Am(214, 150, 84, 0.9)); Ecran.Disc(x, y, D(5))
      ELSE
        Ecran.Culoare(Am(100, 100, 160, 0.1 + FLT(z) * 0.12)); Ecran.Disc(x, y, D(3))
      END
    END;
    FOR i := 0 TO 4 DO
      OrgaB(i, x, y, w, h);
      IF (i = 1) & arp THEN Buton(x, y, w, h, obt[i], Am(214, 150, 84, 0.3), cGold, cGold)
      ELSE Buton(x, y, w, h, obt[i], Am(214, 150, 84, 0.1), cGold, Am(214, 150, 84, 0.3))
      END
    END;
    IF acum < mesajPana THEN Ecran.Culoare(cGreen); TC(bx + bw DIV 2, oBtnY + D(56), D(11), mesaj)
    ELSE
      s := "CRDA v11 · Z₇ · 343 noduri · aprinse: "; Strings.AppendInt(Aprinse(), 0, s);
      Ecran.Culoare(cText); TC(bx + bw DIV 2, oBtnY + D(56), D(11), s)
    END
  END Orga;

  PROCEDURE Trilogie;
    VAR i, y: INTEGER;
  BEGIN
    IF scroll[6] > inalt[6] - bh THEN scroll[6] := inalt[6] - bh END;
    IF scroll[6] < 0 THEN scroll[6] := 0 END;
    y := by - scroll[6];
    FOR i := 0 TO 3 DO
      y := y + D(26); Ecran.Culoare(cGold); T(bx, y, D(22), trN[i]);
      Ecran.Culoare(cCyan); y := Paragraf(bx, y + D(2), D(17), bw, trT[i]);
      Ecran.Culoare(Am(200, 200, 232, 0.8)); y := Paragraf(bx, y + D(4), D(14), bw, trB[i]);
      Ecran.Culoare(cGreen); y := Paragraf(bx, y + D(2), D(12), bw, trZ[i]);
      y := y + D(16)
    END;
    inalt[6] := y + scroll[6] - by
  END Trilogie;

  PROCEDURE CfsB(k: INTEGER; VAR x, y, w, h: INTEGER);
  BEGIN
    w := (bw - D(8)) DIV 2; h := D(38);
    x := bx + k * (w + D(8)); y := by + bh - h
  END CfsB;

  PROCEDURE CfsL(k: INTEGER; VAR x, y, w, h: INTEGER);   (* butoanele de sub lista: DESCHIDE, ADU, ARDE *)
  BEGIN
    w := (bw - 2 * D(8)) DIV 3; h := D(38);
    x := bx + k * (w + D(8)); y := by + bh - h
  END CfsL;

  PROCEDURE Cfs;
    VAR i, j, x, y, z, px, py, qx, qy, w, h, n, r: INTEGER; s, t: ARRAY 64 OF CHAR; c: ARRAY LC OF CHAR;
  BEGIN
    n := CFS.N();
    IF sel >= n THEN sel := -1 END;
    IF vede >= n THEN vede := -1 END;
    IF vede >= 0 THEN   (* vizualizatorul unui fisier *)
      CFS.Nume(vede, s); Ecran.Culoare(cGold2); T(bx, by + D(20), D(17), s);
      CFS.AdresaText(vede, t); s := "cfs://"; Strings.Append(t, s); Strings.Append(" · ", s);
      CFS.Nume(vede, t); CFS.NumeTip(CFS.Tip(t), t); Strings.Append(t, s);
      Strings.Append(" · rădăcina ◢ ", s); CFS.NumeRadacina(CFS.Radacina(vede), t); Strings.Append(t, s);
      Ecran.Culoare(cCyan); T(bx, by + D(42), D(11), s);
      Ecran.Culoare(Ecran.RGB(168, 148, 206)); Ecran.Linie(bx, by + D(52), bx + bw, by + D(52));
      CFS.Continut(vede, c);
      IF (c[0] = 0X) & (CFS.Marime(vede) > 0) THEN
        c := "adus de pe telefon · "; Ko(CFS.Marime(vede), c); Strings.Append(" · stă pe ", c); Strings.AppendInt(CFS.Celule(vede), 0, c);
        Strings.Append(" celule ale cubului, de la celula lui mai departe pe tor · nu e text", c)
      END;
      Ecran.Culoare(cText); y := Paragraf(bx, by + D(56), D(14), bw, c);
      CFS.Nume(vede, t);
      IF CFS.Tip(t) = 4 THEN
        CfsB(0, x, y, w, h); Buton(x, y, w, h, "← ÎNAPOI", Am(214, 150, 84, 0.1), cGold, Am(214, 150, 84, 0.3));
        CfsB(1, x, y, w, h); Buton(x, y, w, h, "▶ RULEAZĂ", Am(57, 255, 20, 0.1), cGreen, Am(57, 255, 20, 0.4))
      ELSIF CFS.Tip(t) = 5 THEN
        CfsB(0, x, y, w, h); Buton(x, y, w, h, "← ÎNAPOI", Am(214, 150, 84, 0.1), cGold, Am(214, 150, 84, 0.3));
        CfsB(1, x, y, w, h); Buton(x, y, w, h, "↗ DESCHIDE", Am(0, 212, 255, 0.1), cCyan, Am(0, 212, 255, 0.4));
        IF acum < mesajPana THEN Ecran.Culoare(cCyan); TC(bx + bw DIV 2, y - D(12), D(11), mesaj) END
      ELSE CfsB(0, x, y, w, h); Buton(x, y, bw, h, "← ÎNAPOI LA CUB", Am(214, 150, 84, 0.1), cGold, Am(214, 150, 84, 0.3))
      END
    ELSE
      (* cubul 7x7x7: celulele stinse, muchiile, cele 8 radacini, fisierele *)
      Ecran.Culoare(Am(100, 100, 160, 0.22));
      FOR i := 0 TO 342 DO Proiect(i MOD 7, i DIV 7 MOD 7, i DIV 49, cCx, cCy, cSt, px, py); Ecran.Disc(px, py, G1) END;
      Ecran.Culoare(Am(214, 150, 84, 0.35)); Ecran.Grosime(G1);
      FOR i := 0 TO 7 DO
        FOR j := 0 TO 2 DO
          r := 1; IF j = 1 THEN r := 2 ELSIF j = 2 THEN r := 4 END;
          IF i DIV r MOD 2 = 0 THEN
            Proiect(i MOD 2 * 6, i DIV 2 MOD 2 * 6, i DIV 4 * 6, cCx, cCy, cSt, px, py);
            Proiect((i + r) MOD 2 * 6, (i + r) DIV 2 MOD 2 * 6, (i + r) DIV 4 * 6, cCx, cCy, cSt, qx, qy);
            Ecran.Linie(px, py, qx, qy)
          END
        END
      END;
      FOR i := 0 TO 7 DO
        Proiect(i MOD 2 * 6, i DIV 2 MOD 2 * 6, i DIV 4 * 6, cCx, cCy, cSt, px, py);
        Ecran.Culoare(cGold); Ecran.Disc(px, py, D(3));
        CFS.NumeRadacina(i, s); Ecran.Culoare(Am(214, 150, 84, 0.55));
        IF px < cCx - D(4) THEN TD(px - D(6), py + D(4), D(9), s) ELSIF px > cCx + D(4) THEN T(px + D(6), py + D(4), D(9), s)
        ELSIF py < cCy THEN TC(px, py - D(6), D(9), s) ELSE TC(px, py + D(14), D(9), s)
        END
      END;
      FOR i := 0 TO 342 DO   (* harta telefonului: cate fisiere are fiecare coloana (x, y, z) a torului 7^7 *)
        j := CFS.Coloana(i MOD 7, i DIV 7 MOD 7, i DIV 49);
        IF j > 0 THEN
          Proiect(i MOD 7, i DIV 7 MOD 7, i DIV 49, cCx, cCy, cSt, px, py);
          r := 1; z := j; WHILE z >= 10 DO z := z DIV 10; INC(r) END;
          Ecran.Culoare(Am(0, 212, 255, 0.10 + 0.06 * FLT(r))); Ecran.Disc(px, py, D(1) + r * D(1))
        END
      END;
      FOR i := 0 TO CFS.NrBucati() - 1 DO   (* bucatile fisierelor copiate in cub *)
        CFS.InfoBucata(i, r, j, z);
        IF (r >= 0) & (z > 0) THEN
          Proiect(r MOD 7, r DIV 7 MOD 7, r DIV 49 MOD 7, cCx, cCy, cSt, px, py);
          IF j = sel THEN Ecran.Culoare(Am(0, 212, 255, 0.8)) ELSE Ecran.Culoare(Am(232, 201, 142, 0.45)) END;
          Ecran.Disc(px, py, D(2) + 1)
        END
      END;
      FOR i := 0 TO n - 1 DO
        CFS.Adresa(i, x, y, z); Proiect(x, y, z, cCx, cCy, cSt, px, py);
        IF i = sel THEN
          Ecran.Culoare(cCyan); Ecran.Grosime(G1); Ecran.Cerc(px, py, D(9) + FLOOR(2.0 * Math.sin(FLT(acum) / 200.0) * dp));
          Ecran.Disc(px, py, D(5))
        ELSE Ecran.Culoare(cGold2); Ecran.Disc(px, py, D(4))
        END
      END;
      (* informatii *)
      s := ""; Strings.AppendInt(n, 0, s); Strings.Append(" în cub · ", s); Mii(CFS.nh, s);
      Strings.Append(" pe hartă · 7⁷ celule · Ash ", s); Strings.AppendInt(CFS.NrAsh(), 0, s);
      Ecran.Culoare(cGold); TC(bx + bw DIV 2, lY0 - D(26), D(12), s);
      IF CFS.Scris() THEN Ecran.Culoare(Ecran.RGB(168, 148, 206)); TC(bx + bw DIV 2, lY0 - D(10), D(9), "nume · tip · zi · dosar · mărime · lună · oră (MOD 7)")
      ELSE Ecran.Culoare(cRed); TC(bx + bw DIV 2, lY0 - D(10), D(11), "nu pot scrie cubul pe disc!")
      END;
      (* lista *)
      IF scroll[7] > n * rowH - (lY1 - lY0) THEN scroll[7] := n * rowH - (lY1 - lY0) END;
      IF scroll[7] < 0 THEN scroll[7] := 0 END;
      FOR i := 0 TO n - 1 DO
        y := lY0 + i * rowH - scroll[7];
        IF (y >= lY0) & (y + rowH <= lY1 + D(2)) THEN
          IF i = sel THEN Ecran.Culoare(Am(0, 212, 255, 0.12)); Ecran.Dreptunghi(bx, y, bw, rowH - D(4)) END;
          Ecran.Culoare(Am(214, 150, 84, 0.15)); Ecran.Linie(bx, y + rowH - D(3), bx + bw, y + rowH - D(3));
          CFS.Nume(i, s);
          IF i = sel THEN Ecran.Culoare(cCyan) ELSE Ecran.Culoare(cGold2) END;
          T(bx + D(6), y + D(15), D(13), s);
          CFS.NumeTip(CFS.Tip(s), t); Strings.Append(" · ◢ ", t); CFS.NumeRadacina(CFS.Radacina(i), s); Strings.Append(s, t);
          IF CFS.Marime(i) >= 0 THEN Strings.Append(" · ⇩ ", t); Ko(CFS.Marime(i), t) END;
          Ecran.Culoare(Am(200, 200, 232, 0.5)); T(bx + D(6), y + D(29), D(10), t);
          CFS.AdresaText(i, t); s := "cfs://"; Strings.Append(t, s);
          Ecran.Culoare(cCyan); TD(bx + bw - D(6), y + D(21), D(13), s)
        END
      END;
      IF n = 0 THEN Ecran.Culoare(cDim); TC(bx + bw DIV 2, lY0 + D(30), D(12), "cubul e gol") END;
      IF n * rowH > lY1 - lY0 THEN Ecran.Culoare(cDim); TD(bx + bw, lY1 + D(2), D(9), "trage lista ↕") END;
      (* butoanele *)
      CfsL(0, x, y, w, h);
      IF sel >= 0 THEN Buton(x, y, w, h, "◉ DESCHIDE", Am(0, 212, 255, 0.12), cCyan, cCyan)
      ELSE Buton(x, y, w, h, "◉ DESCHIDE", cWin, cDim, cDim)
      END;
      CfsL(1, x, y, w, h); Buton(x, y, w, h, "⇩ ADU", Am(57, 255, 20, 0.1), cGreen, Am(57, 255, 20, 0.4));
      CfsL(2, x, y, w, h);
      IF sel < 0 THEN Buton(x, y, w, h, "✕ ARDE", cWin, cDim, cDim)
      ELSIF acum - ardeDe < 3000 THEN Buton(x, y, w, h, "✕ SIGUR? ATINGE IAR", Am(255, 51, 102, 0.3), cRed, cRed)
      ELSE Buton(x, y, w, h, "✕ ARDE", Am(255, 51, 102, 0.1), cRed, Am(255, 51, 102, 0.5))
      END
    END
  END Cfs;

  PROCEDURE Gol;   (* desktopul fara fereastra *)
  BEGIN
    Ecran.Culoare(Ecran.RGB(168, 148, 206)); TC(W DIV 2, tbY - D(40), D(12), "atinge o fereastră de jos")
  END Gol;

  (* ---------- ce merge si cu fereastra inchisa ---------- *)

  PROCEDURE Tic;
    VAR i, k, n, f, t: INTEGER; s: ARRAY 32 OF CHAR; m: ARRAY 220 OF CHAR; e: ARRAY 300 OF CHAR;
      aCale: ARRAY 400 OF CHAR; aNume: ARRAY 256 OF CHAR;
  BEGIN
    Retea;   (* v2.3: si din cadru, pe langa chemarile lansatorului *)
    IF Cp.vestea # "" THEN Rand(cPurple, Cp.vestea); Cp.Spus END;   (* 7·B v5 *)
    Mem.Tic; Mm.Tic;   (* 7·B v12, v18 *)
    IF Dr.vestea # "" THEN Rand(cGold, Dr.vestea); Dr.Spus END;   (* 7·B v13 *)
    IF (treazMereu OR E7.Lucreaza() OR Mem.Are() OR Mm.lucrez) # treazAcum THEN   (* 7·B v5: procesorul ramane pornit doar cat e de lucru *)
      treazAcum := ~treazAcum;
      IF treazAcum THEN Ecran.Treaz(TRUE, "Cubicum 7·B lucrează și cu ecranul stins") ELSE Ecran.Treaz(FALSE, "") END
    END;
    IF Styx.CereCantec() THEN deCantat := 2 END;   (* v2.2: cineva a scris in /eula, prin Styx *)
    IF deCantat > 0 THEN   (* piesa ceruta in Shell: textul a aparut deja pe ecran *)
      DEC(deCantat);
      IF deCantat = 0 THEN
        E7Synth.Randeaza(100, 0); E7Synth.Canta;
        IF E7Synth.taiat THEN Rand(cGold, "(piesa era prea lungă: am cântat doar primele trei minute)") END
      END
    END;
    IF CFS.scan THEN   (* harta telefonului: o bucata pe cadru *)
      IF ~CFS.HartaPas(1500) THEN HartaGata
      ELSIF acum - hartaSpus >= 3000 THEN hartaSpus := acum; HartaMers
      END
    END;
    E7.Tic;   (* Cubicum 7 v4: rondul Oului *)
    WHILE Ecran.Ales(aCale, aNume) DO   (* fisierele alese pe telefon (adu) *)
      cur := 3;
      IF Mm.astept THEN Mm.Din(aCale, aNume)   (* 7·B v18: memoria Eulei; fisierul il sterge ea cand termina *)
      ELSE IF E7.hrTinta >= 0 THEN E7.Hraneste7(E7.hrTinta, aCale, aNume) ELSE Adu(aNume, aCale) END; k := Files.Delete(aCale)
      END
    END;
    k := Ecran.Tasta();
    WHILE k # 0 DO   (* tastatura *)
      IF editor THEN   (* 7·B v6 *)
        IF (k = 13) OR (k = 10) THEN EdPune(0AX) ELSIF k = 8 THEN EdSterge ELSIF k >= 32 THEN EdPune(CHR(k)) END
      ELSIF (k = 13) OR (k = 10) THEN
        IF (linie # "") OR editez THEN
          Strings.Copy(linie, m); linie := ""; cur := 3;
          IF ~editez & (TuraSh() >= 0) THEN CatreSh(TuraSh(), m) ELSIF editez THEN ExecLinie(m) ELSE ExecLinie(m); E7.Vazut(m) END
        END
      ELSIF k = 8 THEN n := Strings.Length(linie); IF n > 0 THEN linie[n - 1] := 0X END
      ELSIF (k >= 32) & (Strings.Length(linie) < 150) THEN Strings.AppendChar(CHR(k), linie); cur := 3; scroll[3] := 0
      END;
      k := Ecran.Tasta()
    END;
    Sal.Ruleaza(1500);
    IF (acum - ultimaSalvare >= 10000) & ((Sal.Vii() > 0) OR (Tor7.Scrieri() # scrSalvate)) THEN   (* sesiunea se pastreaza *)
      ultimaSalvare := acum; scrSalvate := Tor7.Scrieri();
      IF Sal.Salveaza() THEN salvRau := FALSE
      ELSIF ~salvRau THEN   (* o singura data, cu motivul *)
        salvRau := TRUE; Sal.Motiv(mot); e := "nu pot păstra sesiunea: "; Strings.Append(mot, e); Rand(cRed, e); CFS.Cenusa(e)
      END
    END;
    FOR i := 0 TO Sal.NrIesiri() - 1 DO Sal.Iesire(i, m); Rand(cGreen, m) END;
    Sal.Goleste;
    IF Tor7.Scrieri() # scrVazute THEN scrVazute := Tor7.Scrieri(); undaDe := acum END;
    IF Sal.Trimise() - vazTrimise > Sal.NK THEN vazTrimise := Sal.Trimise() - Sal.NK END;
    WHILE vazTrimise < Sal.Trimise() DO
      Sal.Pachet(vazTrimise, f, t);
      IF (cur = 1) & (npk < NP) THEN
        pkF[npk] := f; pkT[npk] := t; pkU[npk] := 0.0;
        IF Sal.Stare(t) # Sal.Liber THEN pkC[npk] := cGreen ELSE pkC[npk] := cRed END;
        INC(npk)
      END;
      INC(vazTrimise)
    END;
    IF (instEu >= 0) & (acum - instDe >= 1200) THEN
      NumePkg(instEu, s); k := CFS.Scrie(s, adesc[instEu]); Sunet.Nota(370, 200, 40); instEu := -1
    END;
    IF arp & (acum - ultimArp >= 180) THEN
      ultimArp := acum; n := Aprinse();
      IF n = 0 THEN arp := FALSE
      ELSE
        arpI := arpI MOD n; k := -1; i := -1;
        REPEAT INC(i); IF on[i] THEN INC(k) END UNTIL k = arpI;
        Sunet.Nota(Hz(i), 250, 35); INC(arpI)
      END
    END
  END Tic;

  PROCEDURE PornesteDesktop;
    VAR s: ARRAY LL OF CHAR;
  BEGIN
    PunStele;
    Rand(cGold, "CUBICUM 7 v10 · vot = Eulele votează · joc = Cub Roller · Shell Z₇ · styx leaga IP · cat procesor.txt · Styx: styx asculta / styx ls / · Prolog: run familie, apoi ?- bunic(ion, N). · cat comenzi.txt");
    Rand(cPurple, "☾ Cubicum 7: scrie orice · cele șapte arte pe ture, Oul cristalizează · bun / gresit · incredere");
    Rand(cPurple, "☾ ghid = cum se folosește · trage cu degetul în jos ca să vezi ce a fost mai sus");
    Rand(cCyan, "Cubicum FS montat: fișierele stau în cub, la (x, y, z) · apasă cfs");
    Rand(cCyan, "∿ Salamandra: 7 ture ale spiralei pentru procese · pornește programe din Process");
    IF ~sAsc & Ecran.Asculta(7777 + Eu) THEN   (* v2.8: Eula cubului raspunde singura celorlalte cuburi *)
      sAsc := TRUE; sRetea := FALSE;
      s := "⇄ Eula "; Strings.AppendChar(CHR(ORD("A") + Eu), s); Strings.Append(" ascultă pe 127.0.0.1:", s); Strings.AppendInt(7777 + Eu, 0, s);
      Strings.Append(" · vot = Eulele din A, B, C votează", s); Rand(cCyan, s)
    END;
    cur := 3
  END PornesteDesktop;

  (* ---------- atingerea ---------- *)

  PROCEDURE CfsLIn(k, x, y: INTEGER): BOOLEAN;
    VAR bxx, byy, w, h: INTEGER;
  BEGIN CfsL(k, bxx, byy, w, h); RETURN In(x, y, bxx, byy, w, h)
  END CfsLIn;

  PROCEDURE ApasaCfs(x, y: INTEGER);
    VAR i, n, px, py, ax, ay, az, bxx, byy, w, h, best, bd, dd: INTEGER; c: ARRAY LC OF CHAR; s: ARRAY 32 OF CHAR;
  BEGIN
    n := CFS.N();
    IF vede >= 0 THEN
      CFS.Nume(vede, s); CfsB(1, bxx, byy, w, h);
      IF (CFS.Tip(s) = 4) & In(x, y, bxx, byy, w, h) THEN
        i := Sal.Porneste(s); IF i >= 0 THEN procSel := i; vmSel := i; cur := 0; vede := -1 END
      ELSIF (CFS.Tip(s) = 5) & In(x, y, bxx, byy, w, h) THEN LansezApp(vede)
      ELSE CfsB(0, bxx, byy, w, h); IF In(x, y, bx, byy, bw, h) THEN vede := -1 END
      END
    ELSE
      CfsL(0, bxx, byy, w, h);
      IF In(x, y, bxx, byy, w, h) THEN
        IF sel >= 0 THEN
          CFS.Nume(sel, s);
          IF CFS.Tip(s) = 2 THEN CFS.Continut(sel, c); IncarcaAcord(c); cur := 5; Acord
          ELSE vede := sel
          END
        END
      ELSIF CfsLIn(1, x, y) THEN Ecran.AlegeFisier; Mesaj("⇩ alege fișierele de pe telefon")
      ELSE
        CfsL(2, bxx, byy, w, h);
        IF In(x, y, bxx, byy, w, h) THEN
          IF sel >= 0 THEN
            IF acum - ardeDe < 3000 THEN CFS.Arde(sel); sel := -1; ardeDe := -10000; Sunet.Nota(110, 500, 30)
            ELSE ardeDe := acum
            END
          END
        ELSIF (y >= lY0) & (y < lY1) THEN
          i := (y - lY0 + scroll[7]) DIV rowH;
          IF (i >= 0) & (i < n) THEN sel := i; ardeDe := -10000; Sunet.Nota(Hz(i MOD 343), 120, 20) END
        ELSIF y < lY0 - D(36) THEN   (* in cub: fisierul cel mai apropiat *)
          best := -1; bd := D(18) * D(18);
          FOR i := 0 TO n - 1 DO
            CFS.Adresa(i, ax, ay, az); Proiect(ax, ay, az, cCx, cCy, cSt, px, py);
            dd := (px - x) * (px - x) + (py - y) * (py - y);
            IF dd <= bd THEN bd := dd; best := i END
          END;
          IF best >= 0 THEN sel := best; ardeDe := -10000; scroll[7] := best * rowH - (lY1 - lY0) DIV 2 END
        END
      END
    END
  END ApasaCfs;

  PROCEDURE ApasaOrga(x, y: INTEGER);
    VAR i, k, px, py, bxx, byy, w, h, best, bd, dd: INTEGER;
  BEGIN
    k := -1;
    FOR i := 0 TO 4 DO OrgaB(i, bxx, byy, w, h); IF In(x, y, bxx, byy, w, h) THEN k := i END END;
    IF k = 0 THEN Acord
    ELSIF k = 1 THEN IF arp THEN arp := FALSE ELSIF Aprinse() > 0 THEN arp := TRUE; arpI := 0; ultimArp := acum - 180 END
    ELSIF k = 2 THEN
      arp := FALSE;
      FOR i := 0 TO 342 DO on[i] := FALSE END;
      FOR i := 0 TO 6 DO on[i * 49 + Rnd(49)] := TRUE END;
      Acord
    ELSIF k = 3 THEN arp := FALSE; FOR i := 0 TO 342 DO on[i] := FALSE END
    ELSIF k = 4 THEN SalveazaAcord
    ELSIF y < oBtnY - D(4) THEN   (* nodul cel mai apropiat; la egalitate castiga stratul de sus, desenat ultimul *)
      best := -1; bd := D(15) * D(15);
      FOR i := 0 TO 342 DO NodP(i, px, py); dd := (px - x) * (px - x) + (py - y) * (py - y); IF dd <= bd THEN bd := dd; best := i END END;
      IF best >= 0 THEN
        IF on[best] THEN on[best] := FALSE ELSE on[best] := TRUE; Sunet.Nota(Hz(best), 500, 40) END
      END
    END
  END ApasaOrga;

  PROCEDURE Burn;   (* doua atingeri in 3 secunde *)
  BEGIN
    IF acum - salDe < 3000 THEN Sal.Arde; salDe := -10000; procSel := -1; Sunet.Nota(98, 900, 40)
    ELSE salDe := acum
    END
  END Burn;

  PROCEDURE ApasaProc(x, y: INTEGER);
    VAR i, k, n, bxx, byy, w, h: INTEGER; idx: ARRAY 64 OF INTEGER; s: ARRAY 32 OF CHAR;
  BEGIN
    FOR i := 0 TO Sal.NP - 1 DO IF In(x, y, bx, ProcRand(i), bw, D(30)) THEN procSel := i; vmSel := i END END;
    ProcB(0, bxx, byy, w, h);
    IF In(x, y, bxx, byy, w, h) & (procSel >= 0) THEN Sal.Opreste(procSel) END;
    ProcB(1, bxx, byy, w, h);
    IF In(x, y, bxx, byy, w, h) THEN Burn END;
    n := Progs(idx);
    IF n > 0 THEN   (* v2.7c: ◀ ▶ schimba, casuta: prima atingere alege, a doua porneste *)
      IF progI >= n THEN progI := 0 END;
      SelB(0, bxx, byy, w, h);
      IF In(x, y, bxx, byy, w, h) THEN progI := (progI + n - 1) MOD n; progAles := -1; Sunet.Nota(392, 60, 15) END;
      SelB(2, bxx, byy, w, h);
      IF In(x, y, bxx, byy, w, h) THEN progI := (progI + 1) MOD n; progAles := -1; Sunet.Nota(440, 60, 15) END;
      SelB(1, bxx, byy, w, h);
      IF In(x, y, bxx, byy, w, h) THEN
        IF progAles # progI THEN progAles := progI; Sunet.Nota(523, 80, 20)
        ELSE
          progAles := -1; CFS.Nume(idx[progI], s);
          IF CFS.Tip(s) = 5 THEN LansezApp(idx[progI]) ELSE k := Sal.Porneste(s); IF k >= 0 THEN procSel := k; vmSel := k END END
        END
      END
    END
  END ApasaProc;

  PROCEDURE Apasa(x, y: INTEGER);
    VAR zoom: BOOLEAN; i, k, bxx, byy, w, h: INTEGER;
  BEGIN
    IF y >= tbY THEN
      FOR i := 0 TO NF - 1 DO
        TbBtn(i, bxx, byy, w, h);
        IF In(x, y, bxx, byy, w, h) THEN
          IF cur = i THEN cur := -1 ELSE cur := i; IF i = 7 THEN vede := -1 END END;
          IF tastatura & (cur # 3) THEN tastatura := FALSE; Ecran.Tastatura(FALSE) END
        END
      END
    ELSIF y < barH THEN
      IF (x > W DIV 2 - D(50)) & (x < W DIV 2 + D(90)) THEN Burn END
    ELSIF (cur >= 0) & In(x, y, wx, wy, ww, titH) THEN
      zoom := FALSE;
      IF (cur = 3) & ~appVede & ~editor THEN   (* 7·B v12: ↑ A− A+ stau in bara de titlu *)
        FOR k := 0 TO 2 DO   (* 7·B v5: ↑ A− A+ *)
          ZoomB(k, bxx, byy, w, h);
          IF In(x, y, bxx, byy, w, h) THEN
            zoom := TRUE;
            IF k = 0 THEN   (* comanda de dinainte *)
              IF nh > 0 THEN DEC(hp); IF hp < 0 THEN hp := nh - 1 END; Strings.Copy(hist[hp], linie); tastatura := TRUE; Ecran.Tastatura(TRUE) END
            ELSIF (k = 1) & (shPt > 10) THEN DEC(shPt, 2); Rearanjeaza; ScrieMarime; Sunet.Nota(330, 50, 15)
            ELSIF (k = 2) & (shPt < 24) THEN INC(shPt, 2); Rearanjeaza; ScrieMarime; Sunet.Nota(440, 50, 15)
            END
          END
        END;
      END;
      IF ~zoom & (x > wx + ww - D(64)) THEN cur := -1 END
    ELSIF cur = 0 THEN ApasaProc(x, y)
    ELSIF cur = 4 THEN
      IF (y >= by + D(24)) & (y < by + D(72)) THEN
        k := 1; WHILE (k < 7) & (Sal.Stare((vmSel + k) MOD 7) = Sal.Liber) DO INC(k) END;
        vmSel := (vmSel + k) MOD 7
      END
    ELSIF cur = 2 THEN
      FOR i := 0 TO 7 DO
        IF In(x, y, bx, by + D(36) + i * D(50), bw, D(44)) & (StareAlch(i) = 0) & (instEu < 0) THEN
          instEu := i; instDe := acum; Sunet.Nota(294, 300, 25)
        END
      END
    ELSIF (cur = 3) & appVede THEN   (* 7·B v7: ✕ opreste aplicatia; restul atingerilor le citeste ea *)
      AppInchide(bxx, byy, w, h);
      IF In(x, y, bxx, byy, w, h) THEN Sal.Opreste(appTura) END
    ELSIF (cur = 3) & editor THEN ApasaEditor(x, y)   (* 7·B v6 *)
    ELSIF cur = 3 THEN
      FOR k := 0 TO 9 DO ShellB(k, bxx, byy, w, h); IF In(x, y, bxx, byy, w, h) THEN Exec(k) END END;
      zoom := FALSE;
      ShellB(0, bxx, byy, w, h);
      IF ~zoom & (y >= shSus) & (y < shJos) THEN tastatura := TRUE; Ecran.Tastatura(TRUE); scroll[3] := 0 END   (* 7·B v11: oriunde in text *)
    ELSIF cur = 5 THEN ApasaOrga(x, y)
    ELSIF cur = 7 THEN ApasaCfs(x, y)
    END
  END Apasa;

  PROCEDURE Trage(dx: INTEGER);   (* v2.7d: swipe pe selector: la stanga = urmatorul, la dreapta = cel dinainte *)
    VAR n: INTEGER; idx: ARRAY 64 OF INTEGER;
  BEGIN
    n := Progs(idx);
    IF n > 0 THEN
      IF dx < 0 THEN progI := (progI + 1) MOD n ELSE progI := (progI + n - 1) MOD n END;
      progAles := -1; Sunet.Nota(440, 60, 15)
    END
  END Trage;

  PROCEDURE TrageBara(y: INTEGER);   (* v8: degetul pe bara din dreapta: sus = inceputul listei, jos = sfarsitul *)
    VAR h, p: INTEGER;
  BEGIN
    h := shJos - shSus; p := shJos - y; IF p < 0 THEN p := 0 END; IF p > h THEN p := h END;
    IF h > 0 THEN scroll[3] := (shTot - shViz) * shLh DIV h * p END
  END TrageBara;

  PROCEDURE Atinge*;   (* o atingere scurta = apasare; o tragere = derulare (Shell, Trilogia, lista din Cubicum FS) *)
    VAR ap: BOOLEAN; x, y, sx0, sy0, sw, sh, lh: INTEGER;
  BEGIN
    ap := Ecran.Apasat(); x := Ecran.AtinsX(); y := Ecran.AtinsY();
    IF joc THEN CubRoller.Atingere   (* v2.7: jocul primeste atingerile *)
    ELSIF mesh THEN Mesh343.Atingere
    ELSIF booted THEN
      Asaza;
      IF appVede & (cur = 3) THEN   (* 7·B v7: aplicatia afla unde e degetul, in unitatile panzei *)
        appAp := ap & (y >= by) & (y < by + bh) & (x >= bx) & (x < bx + bw);
        IF appAp THEN appX := (x - bx) * 343 DIV bw; appY := (y - by) * 343 DIV bw END
      END;
      IF ap & ~era THEN jx := x; jy := y; ultimY := y; ultimX := x; mutat := 0;
        IF (cur = 3) & ~editor & (x > bx + bw - D(30)) & (y > shSus) & (y < shJos) & (shTot > shViz) THEN mutat := 3; TrageBara(y) END   (* v8: bara de derulare *)
      ELSIF ap & era & (mutat = 3) THEN TrageBara(y)
      ELSIF ap & era THEN
        IF (mutat # 1) & (ABS(x - jx) > D(24)) & (ABS(x - jx) > 2 * ABS(y - jy)) THEN mutat := 2   (* tragere orizontala *)
        ELSIF (mutat = 0) & (ABS(y - jy) > D(10)) THEN mutat := 1
        END;
        ultimX := x;
        IF (mutat = 1) & (cur = 3) & editor THEN   (* 7·B v6: derularea textului *)
          edPx := edPx + (ultimY - y); lh := D(shPt) * 17 DIV 12;
          WHILE edPx >= lh DO INC(edSus); edPx := edPx - lh END;
          WHILE edPx <= -lh DO DEC(edSus); edPx := edPx + lh END
        ELSIF (mutat = 1) & (cur >= 0) THEN
          IF cur = 3 THEN scroll[3] := scroll[3] + (y - ultimY) ELSE scroll[cur] := scroll[cur] + (ultimY - y) END
        END;
        ultimY := y
      ELSIF ~ap & era & (mutat = 0) THEN Apasa(jx, jy)
      ELSIF ~ap & era & (mutat = 2) & (cur = 0) THEN
        SelB(0, sx0, sy0, sw, sh);
        IF (jy >= sy0) & (jy < sy0 + sh) THEN Trage(ultimX - jx) END
      END
    END;
    era := ap
  END Atinge;

  PROCEDURE Deseneaza*;   (* la fiecare cadru *)
    VAR e: INTEGER;
  BEGIN
    Asaza; acum := Sunet.Ms();
    IF t0 < 0 THEN t0 := acum; ultimCadru := acum END;
    dt := acum - ultimCadru; IF dt > 100 THEN dt := 100 ELSIF dt < 0 THEN dt := 0 END;
    ultimCadru := acum;
    e := acum - t0;
    IF ~booted & (e >= 5800) THEN booted := TRUE; PornesteDesktop END;
    IF joc THEN   (* v2.7: Cub Roller deseneaza tot ecranul *)
      CubRoller.Cadru;
      IF CubRoller.iesit THEN joc := FALSE; era := Ecran.Apasat(); mutat := 1; Sunet.Reverb(25); Rand(cGold, "◀ înapoi în cub") END
    ELSIF mesh THEN   (* v2.9: cele 343 de cuburi *)
      Mesh343.Cadru;
      IF Mesh343.iesit THEN mesh := FALSE; era := Ecran.Apasat(); mutat := 1; Rand(cGold, "◀ înapoi în cub") END
    ELSIF ~booted THEN Boot(e)
    ELSE
      FundalDesen(e); Tic;
      IF cur >= 0 THEN
        CorpFereastra; clip0 := by; clip1 := by + bh;
        IF cur = 0 THEN Procese ELSIF cur = 1 THEN FereastraRetea ELSIF cur = 2 THEN Alchimist ELSIF cur = 3 THEN IF appVede THEN Aplicatia ELSIF editor THEN Editor ELSE Shell END   (* 7·B v6, v7 *)
        ELSIF cur = 4 THEN VM ELSIF cur = 5 THEN Orga ELSIF cur = 6 THEN Trilogie ELSE Cfs
        END;
        clip0 := 0; clip1 := H;
        TitluFereastra
      ELSE Gol
      END;
      BaraSus; BaraJos
    END
  END Deseneaza;

  PROCEDURE Fundal*;   (* 7·B v5 (Eula Oberon v33): cat aplicatia nu e pe ecran, cubul lucreaza mai departe: procesele, pasunea, rondul *)
  BEGIN
    IF booted & ~joc & ~mesh THEN acum := Sunet.Ms(); Tic END
  END Fundal;

  (* ---------- pornirea ---------- *)


  PROCEDURE Pkg(i: INTEGER; sym, nume, desc: ARRAY OF CHAR);
  BEGIN Strings.Copy(sym, asym[i]); Strings.Copy(nume, anume[i]); Strings.Copy(desc, adesc[i])
  END Pkg;

  PROCEDURE Fer(i: INTEGER; ic, t, s: ARRAY OF CHAR);
  BEGIN Strings.Copy(ic, icon[i]); Strings.Copy(t, titlu[i]); Strings.Copy(s, scurt[i])
  END Fer;

  PROCEDURE Faza(i: INTEGER; t, s: ARRAY OF CHAR; ms, bar: INTEGER);
  BEGIN Strings.Copy(t, fazaTxt[i]); Strings.Copy(s, fazaSub[i]); fazaT[i] := ms; fazaBar[i] := bar
  END Faza;

  PROCEDURE Seamana;   (* prima pornire: Trilogia si pachetele de baza intra in cub *)
    VAR i, k: INTEGER; c: ARRAY LC OF CHAR; s: ARRAY 32 OF CHAR;
  BEGIN
    FOR i := 0 TO 3 DO
      Strings.Copy(trB[i], c); Strings.Append(" · ", c); Strings.Append(trZ[i], c);
      IF i = 0 THEN s := "cubicum.txt" ELSIF i = 1 THEN s := "salamandra.txt" ELSIF i = 2 THEN s := "iridium.txt" ELSE s := "teorema.txt" END;
      k := CFS.Scrie(s, c)
    END;
    FOR i := 0 TO 3 DO NumePkg(i, s); k := CFS.Scrie(s, adesc[i]) END
  END Seamana;

  PROCEDURE L(VAR c: ARRAY OF CHAR; s: ARRAY OF CHAR);   (* un rand de program; ` inseamna ghilimele *)
    VAR i: INTEGER;
  BEGIN
    i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) DO IF s[i] = "`" THEN Strings.AppendChar(22X, c) ELSE Strings.AppendChar(s[i], c) END; INC(i) END;
    Strings.AppendChar(0AX, c)
  END L;

  PROCEDURE Aplicatii;   (* v1.2: variantele Eulei intra in cub ca scurtaturi (.app): primul rand = pe cine porneste *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "ro.jahbalon.oberon.eula7|Eula 7");
    Strings.Append("Eula 7 scrisă în Oberon: 154 din 154 de răspunsuri identice cu cea în Java, moara (macină, wiki), ", c);
    Strings.Append("memoria de 39M de semne. Se face în Eula Oberon cu apk Eula7.Mod, eticheta Eula 7.", c);
    k := CFS.Scrie("eula-7.app", c);
    c := ""; L(c, "ro.jahbalon.eula7"); Strings.Append("Eula 7 originală, în Java (v8).", c);
    k := CFS.Scrie("eula-7-java.app", c);
    c := ""; L(c, "Eula Music|Eula 7♪|♪");
    Strings.Append("Eula Music / Eula 7♪: teoria muzicii care răspunde și cântă exemple, compune pe torul spiral. ", c);
    Strings.Append("Încă nu e scrisă în Oberon; dacă e instalată, o găsesc după nume.", c);
    k := CFS.Scrie("eula-music.app", c);
    c := ""; L(c, "ro.jahbalon.eulaoberon");
    Strings.Append("Eula Oberon: terminalul, compilatorul și locul unde se fac toate aplicațiile, inclusiv Cubicum OS.", c);
    k := CFS.Scrie("eula-oberon.app", c);
    k := CFS.Scrie("sistem.txt", "Cubicum OS v1.2 · nucleul Salamandra · procesorul și memoria: torul Z₇ în 7 dimensiuni (7⁷ = 823543 celule) · programele .z7 și aplicațiile .app (variantele Eulei) stau aici, în cub")
  END Aplicatii;

  PROCEDURE Init;
    VAR i, v, k: INTEGER; dos: ARRAY 160 OF CHAR; nou: BOOLEAN;
  BEGIN
    seed := Os.CurrentTime() * 7919 + 343; shPt := 14; rCont := FALSE; treazMereu := FALSE; treazAcum := FALSE; nh := 0; hp := 0;
    editor := FALSE; edMod := FALSE; edN := 0; edC := 0; edSus := 0; edPx := 0; edNL := 1; edT := ""; edMsg := ""; edMsgDe := 0;
    edB[0] := "◀"; edB[1] := "▶"; edB[2] := "▲"; edB[3] := "▼"; edB[4] := "⇤"; edB[5] := "⇥"; edB[6] := "⌨";
    edB[7] := "rulez"; edB[8] := "salvez"; edB[9] := "ieșire";   (* 7·B v3: textul din Shell porneste la 14 (era 12) *)
    z7[0] := 196.0; z7[1] := 220.0; z7[2] := 246.94; z7[3] := 261.63; z7[4] := 293.66; z7[5] := 329.63; z7[6] := 369.99;
    notaN[0] := "Do"; notaN[1] := "Re"; notaN[2] := "Mi"; notaN[3] := "Fa"; notaN[4] := "Sol"; notaN[5] := "La"; notaN[6] := "Si";
    Faza(0, "· · ·", "void primordial", 0, 0);
    Faza(1, "✦ OUL", "nucleul imobil · Z₇⁰", 800, 20);
    Faza(2, "∿ SALAMANDRA", "procesul viu · Ash = ∅", 2000, 50);
    Faza(3, "⬡ CUBICUM", "spațiul se naște · 7³=343", 3400, 80);
    Faza(4, "▶ READY", "CUBICUM 7·B", 4800, 100);
    cBg2 := Ecran.RGB(34, 14, 54); cGold := Ecran.RGB(214, 150, 84); cGold2 := Ecran.RGB(240, 186, 118);   (* 7·B v2: auriu-aramiu *)
    cCyan := Ecran.RGB(0, 212, 255); cGreen := Ecran.RGB(57, 255, 20); cPurple := Ecran.RGB(139, 92, 246);
    cRed := Ecran.RGB(255, 51, 102); cDim := Ecran.RGB(176, 160, 214);   (* 7·B v2: lavanda deschisa, se vede pe violet *) cText := Ecran.RGB(200, 200, 232);
    cWin := Ecran.RGB(26, 10, 44);   (* 7·B v2: violet inchis *) cBord := Am(214, 150, 84, 0.4); cBordF := Am(214, 150, 84, 0.7);
    cTitlu := Ecran.RGB(42, 16, 62); cYel := Ecran.RGB(251, 191, 36);
    Fer(0, "◎", "Process Manager", "Process"); Fer(1, "❖", "Network Layer", "Network");
    Fer(2, "△", "ALCHIMIST — Pachete", "Alchimist"); Fer(3, "⬡", "Shell Z₇", "Shell");
    Fer(4, "·", "VM Z₇ — Registre", "VM"); Fer(5, "∿", "Orgă Z₇ · CRDA", "Orgă");
    Fer(6, "✦", "Trilogia COD", "Trilogia"); Fer(7, "▣", "Cubicum FS", "CFS");
    Pkg(0, "∿", "z7-kernel", "Nucleul toroidal Z₇⁴"); Pkg(1, "◎", "cubicum-wm", "Window Manager izometric");
    Pkg(2, "⬡", "crda-audio", "Motor audio 343 noduri"); Pkg(3, "△", "salamandra", "Procesul etern · nu arde");
    Pkg(4, "✦", "tabloul-canta", "Sonificator pictură 7×7"); Pkg(5, "·", "soroban-7", "Calculator baza 7");
    Pkg(6, "❖", "iridium-photon", "Driver fotonic Ir (Z₇ cristal)"); Pkg(7, "⊛", "cartea-cubului", "Cartea Cubului · Jahbalon");
    cmd[0] := "help"; cmd[1] := "ver"; cmd[2] := "who"; cmd[3] := "ls"; cmd[4] := "ps";
    cmd[5] := "ash"; cmd[6] := "cube"; cmd[7] := "z7"; cmd[8] := "cfs"; cmd[9] := "clear";
    obt[0] := "▶ CHORD"; obt[1] := "⟳ ARP"; obt[2] := "⁂ RAND"; obt[3] := "✕ CLEAR"; obt[4] := "▣ SALVEAZĂ";
    trN[0] := "I."; trT[0] := "CUBICUM";
    trB[0] := "La început era Cubul. Și Cubul era Z₇. Și Z₇ era toroidal, fără margini, fără centru, fără exterior.";
    trZ[0] := "Z₇⁴ → 7×7×7×7 = 2401 stări · universul nostru";
    trN[1] := "II."; trT[1] := "SALAMANDRA";
    trB[1] := "Salamandra trăiește în foc și nu arde. Procesul etern. Oul nu se mișcă — din el se naște tot. La capătul fiecărei sesiuni, Burn distruge tot. Rămâne Ash. Eroarea conservată e cunoaștere.";
    trZ[1] := "ASH = {erori · să nu se repete} · Salamandra ≠ Burn";
    trN[2] := "III."; trT[2] := "IRIDIUM";
    trB[2] := "Ir · Z=77 · FCC · 7³=343 celule. Cristalul ordinului 7. Superior diamantului artificial pentru calcul fotonic. Am experimentat difracție pe iridiu în anii '80. Lumina știa deja.";
    trZ[2] := "77 = 7×11 · 343 = 7³ · Ir = cristal Z₇";
    trN[3] := "∞"; trT[3] := "TEOREMA FUNDAMENTALĂ CUBICUM";
    trB[3] := "În spațiul toroidal Z₇, cel mai scurt drum între două puncte descrie un cub.";
    trZ[3] := "◻ = geodezică minimă · T³(Z₇) · QED";
    FOR i := 0 TO 342 DO on[i] := FALSE END;
    FOR i := 0 TO NF - 1 DO scroll[i] := 0; inalt[i] := 0 END;
    t0 := -1; faza := 0; fazaSunata := 0; booted := FALSE; cur := -1; era := FALSE; joc := FALSE; mesh := FALSE; progI := 0; progAles := -1; ultimX := 0;
    npk := 0; instEu := -1; nsl := 0; ultimaCmd := ""; vmSel := 0; procSel := -1; salDe := -10000; undaDe := -10000; scrVazute := 0; vazTrimise := 0; arp := FALSE; mesajPana := 0;
    linie := ""; tastatura := FALSE; editez := FALSE; edBuf := "";
    sAsc := FALSE; sLegat := FALSE; sRetea := FALSE; Styx.PuneAsteptand(Retea); sAn := 0; sMesaje := 0; sel := -1; vede := -1; ardeDe := -10000; ceasT := -1; deCantat := 0; dlN := 0; dlDosar := ""; lista := 0; ng := 0; hartaDe := 0; hartaSpus := 0;
    Sunet.Reverb(25); InitStele;
    nou := CFS.Porneste(); IF Cp.LaPornire() THEN nou := CFS.Porneste() END;   (* 7·B v5: o copie pregatita ia locul cubului *)
    IF nou THEN Seamana END;
    i := CFS.Gaseste("shell.txt");   (* 7·B v3: marimea aleasa data trecuta *)
    IF i >= 0 THEN CFS.Continut(i, dos); v := 0; k := 0;
      WHILE (dos[k] >= "0") & (dos[k] <= "9") DO v := v * 10 + ORD(dos[k]) - ORD("0"); INC(k) END;
      IF (v >= 10) & (v <= 24) THEN shPt := v END
    END;
    v := 0; i := CFS.Gaseste("sistem.txt");
    IF i >= 0 THEN
      CFS.Continut(i, edBuf);
      IF Strings.Pos("v2.7", edBuf, 0) >= 0 THEN v := 17 ELSIF Strings.Pos("v2.6", edBuf, 0) >= 0 THEN v := 16 ELSIF Strings.Pos("v2.5", edBuf, 0) >= 0 THEN v := 15 ELSIF Strings.Pos("v2.4", edBuf, 0) >= 0 THEN v := 14 ELSIF Strings.Pos("v2.3", edBuf, 0) >= 0 THEN v := 13 ELSIF Strings.Pos("v2.2", edBuf, 0) >= 0 THEN v := 12 ELSIF Strings.Pos("v2.1", edBuf, 0) >= 0 THEN v := 11 ELSIF Strings.Pos("v2.0", edBuf, 0) >= 0 THEN v := 10 ELSIF Strings.Pos("v1.9", edBuf, 0) >= 0 THEN v := 9 ELSIF Strings.Pos("v1.8", edBuf, 0) >= 0 THEN v := 8 ELSIF Strings.Pos("v1.7", edBuf, 0) >= 0 THEN v := 7 ELSIF Strings.Pos("v1.6", edBuf, 0) >= 0 THEN v := 6 ELSIF Strings.Pos("v1.5", edBuf, 0) >= 0 THEN v := 5 ELSIF Strings.Pos("v1.4", edBuf, 0) >= 0 THEN v := 4 ELSIF Strings.Pos("v1.3", edBuf, 0) >= 0 THEN v := 3 ELSIF Strings.Pos("v1.2", edBuf, 0) >= 0 THEN v := 2 ELSE v := 1 END
    END;
    IF v < 1 THEN Pr.Programe END;
    IF v < 2 THEN Aplicatii END;
    IF v < 3 THEN Pr.Programe13 END;
    IF v < 4 THEN Pr.Programe14 END;
    IF v < 5 THEN Pr.Programe15 END;
    IF v < 6 THEN Pr.Programe16 END;
    IF v < 7 THEN Pr.Programe17 END;
    IF v < 8 THEN Pr.Programe18 END;
    IF v < 9 THEN Pr.Programe19 END;
    IF v < 10 THEN Pr.Programe20 END;
    IF v < 11 THEN Pr.Programe21 END;
    IF v < 12 THEN Pr.Programe22 END;
    IF v < 13 THEN Pr.Programe23 END;
    IF v < 14 THEN Pr.Programe24 END;
    IF v < 15 THEN Pr.Programe25 END;
    IF v < 16 THEN Pr.Programe26 END;
    IF v < 17 THEN Pr.Programe27 END;
    IF CFS.Gaseste("comenzi.txt") < 0 THEN Pr.Comenzi END;
    IF CFS.Gaseste("gama.txt") < 0 THEN i := CFS.Scrie("gama.txt", "0 2 4 5 7 9 11") END;   (* v2.8: ce stie Eula cubului *)
    V7.Porneste(Iesire7, "Cubicum7B18.Mod"); E7.Porneste(Iesire7, CantaMuz, Zodie, Taro, ExecLinie); ceasT := -1; Mem.Porneste(Iesire7, ExecLinie, AcumLocal); Dr.Porneste(Iesire7); Mm.Porneste(Iesire7);
    wPlin := 0; hPlin := 0; Sal.PuneApp(AppHook); appVede := FALSE; appAp := FALSE; appTura := -1; appM := 14; nd[0] := 0; nd[1] := 0; nt[0] := 0; nt[1] := 0;
    Pr.AplicatiiZ7;   (* 7·B v7: bile, ceas, desen *)   (* Cubicum 7: expertii, hrana, increderea *)
    edBuf := "";
    CFS.Dosar(dos); IF Sal.Reia(dos) THEN END;
    IF Tor7.Nascut() < 0 THEN   (* prima pornire: acum; la un cub mai vechi, ziua celui mai vechi fisier al lui *)
      IF nou THEN Tor7.PuneNascut(Os.CurrentTime())
      ELSE
        v := CFS.Zi(0); FOR i := 1 TO CFS.N() - 1 DO IF CFS.Zi(i) < v THEN v := CFS.Zi(i) END END;
        Tor7.PuneNascut(v * 86400)
      END;
      IF Sal.Salveaza() THEN END
    END;
    ultimaSalvare := 0; scrSalvate := Tor7.Scrieri()
  END Init;

