MODULE Styx;  (* Styx (9P2000, protocolul lui Inferno) in Cubicum OS v2.2: lumea cubului ca arbore de fisiere.
     Proceseaza primeste un mesaj T (octetii lui, asa cum vin pe fir) si da mesajul R. Arborele:
       /cub/<nume>       fisierele din Cubicum FS (citesti UTF-8; scrii, iar la inchidere se scrie in cub; creezi; stergi)
       /harta            harta telefonului, cate un rand: cfs://adresa nume marime /dosar      (doar citit)
       /proc/0..6/stare  „liber” sau „nume pid stare”;  /proc/0..6/ctl: scrii „kill” si tura se opreste
       /opal             ciclul, bataia, prima pornire, Burn-uri                              (doar citit)
       /prolog           scrii o intrebare, citesti raspunsurile ultimei intrebari
       /eula             scrii o intrebare de muzica, citesti raspunsul Eulei ♪ (si suna)
     Fara parola (ca Inferno cu mount -A): auth si wstat raspund cu eroare. Firul (socket-ul) nu e aici: il da Eula
     Oberon (treapta 2); pana atunci il folosesc Shell-ul (styx ls / cat / scrie) si testele.
     v2.6: clientul din Shell merge si pe fir, catre alt cub (sau orice server Styx): Leaga(gazda, port) trimite
     Tversion; dupa el, Ls / Cat / Scrie pleaca pe fir (Ecran.Spre / Dinspre, Eula Oberon v31) pana la Dezleaga.
     Cat asteapta raspunsul, cheama Asteptand (Cubicum ii da Retea: daca se leaga de el insusi, isi raspunde). *)
  IMPORT Strings, Tor7, CFS := CubicumFS, Sal := Salamandra, Z7P, Te := E7Teorie, Ecran, Sunet;

  CONST MaxMsg* = 65560; MS = 65536;
    Tversion = 100; Rversion = 101; Tauth = 102; Tattach = 104; Rattach = 105; Rerror = 107; Tflush = 108; Rflush = 109;
    Twalk = 110; Rwalk = 111; Topen = 112; Ropen = 113; Tcreate = 114; Rcreate = 115; Tread = 116; Rread = 117;
    Twrite = 118; Rwrite = 119; Tclunk = 120; Rclunk = 121; Tremove = 122; Rremove = 123; Tstat = 124; Rstat = 125;
    Twstat = 126;
    kRoot = 1; kCub = 2; kCubF = 3; kHarta = 4; kProc = 5; kProcT = 6; kStare = 7; kCtl = 8; kOpal = 9; kProlog = 10; kEula = 11;
    NF = 256; LW = 8192; LB = 4000000;
    DMDIR = 80000000H;

  VAR
    msize: INTEGER;
    fNr, fKind, fT, fMode, fWn: ARRAY NF OF INTEGER; fUsed, fOpen, fDirty: ARRAY NF OF BOOLEAN;
    fNume: ARRAY NF OF ARRAY 64 OF CHAR;
    fW: ARRAY NF OF ARRAY LW OF BYTE;
    sb: ARRAY MS OF BYTE; sn: INTEGER;          (* continutul unui fisier mic, facut la cerere *)
    hb: ARRAY LB OF BYTE; hn: INTEGER;          (* /harta, facuta la deschidere *)
    pr, eu: ARRAY 16000 OF CHAR;                (* ultimele raspunsuri: /prolog, /eula *)
    canta: BOOLEAN;
    cont: PROCEDURE (k, t: INTEGER; VAR n: ARRAY OF CHAR);
    ob: ARRAY MaxMsg OF BYTE; on: INTEGER;      (* raspunsul in lucru *)
    (* clientul din Shell *)
    cq, cr: ARRAY MaxMsg OF BYTE; ctag: INTEGER;
    departe*: BOOLEAN; unde*: ARRAY 80 OF CHAR;   (* v2.6: clientul e legat de alt server *)
    stricat: BOOLEAN;                            (* firul s-a rupt in mijlocul comenzii: restul ei nu mai pleaca *)
    tb: ARRAY MaxMsg OF BYTE; tn: INTEGER;       (* ce a venit pe fir si n-a fost inca luat *)
    Asteptand: PROCEDURE;                        (* cheamata cat asteptam raspunsul de pe fir *)
    linii*: ARRAY 400 OF ARRAY 200 OF CHAR; nlinii*: INTEGER;

  (* ======================= octetii ======================= *)

  PROCEDURE Get1(VAR b: ARRAY OF BYTE; i: INTEGER): INTEGER;
  BEGIN RETURN b[i] MOD 256
  END Get1;

  PROCEDURE Get2(VAR b: ARRAY OF BYTE; i: INTEGER): INTEGER;
  BEGIN RETURN b[i] MOD 256 + b[i + 1] MOD 256 * 256
  END Get2;

  PROCEDURE Get4(VAR b: ARRAY OF BYTE; i: INTEGER): INTEGER;   (* valori pana la 2^31 - 1; mai mari = -1 *)
    VAR r: INTEGER;
  BEGIN
    IF b[i + 3] MOD 256 >= 128 THEN r := -1
    ELSE r := b[i] MOD 256 + b[i + 1] MOD 256 * 256 + b[i + 2] MOD 256 * 65536 + b[i + 3] MOD 256 * 16777216
    END;
    RETURN r
  END Get4;

  PROCEDURE Get8(VAR b: ARRAY OF BYTE; i: INTEGER): INTEGER;   (* offset-uri: peste 2^31 - 1 = un numar mare *)
    VAR r: INTEGER;
  BEGIN
    r := Get4(b, i);
    IF (b[i + 4] # 0) OR (b[i + 5] # 0) OR (b[i + 6] # 0) OR (b[i + 7] # 0) OR (r < 0) THEN r := 7FFFFFFFH END;
    RETURN r
  END Get8;

  PROCEDURE P1(v: INTEGER);
  BEGIN IF on < LEN(ob) THEN ob[on] := v MOD 256; INC(on) END
  END P1;

  PROCEDURE P2(v: INTEGER);
  BEGIN P1(v MOD 256); P1(v DIV 256 MOD 256)
  END P2;

  PROCEDURE P4(v: INTEGER);
  BEGIN P1(v MOD 256); P1(v DIV 256 MOD 256); P1(v DIV 65536 MOD 256); P1(v DIV 16777216 MOD 256)
  END P4;

  PROCEDURE P8(v: INTEGER);
  BEGIN P4(v); P4(0)
  END P8;

  PROCEDURE Utf8(s: ARRAY OF CHAR; VAR b: ARRAY OF BYTE; VAR n: INTEGER);   (* adauga s ca UTF-8 la b[n..] *)
    VAR i, c, d: INTEGER;
  BEGIN
    i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) & (n < LEN(b) - 4) DO
      c := ORD(s[i]); INC(i);
      IF (c >= 0D800H) & (c < 0DC00H) & (i < LEN(s)) & (ORD(s[i]) >= 0DC00H) & (ORD(s[i]) < 0E000H) THEN
        d := ORD(s[i]); INC(i); c := 10000H + (c - 0D800H) * 400H + (d - 0DC00H)
      END;
      IF c < 80H THEN b[n] := c; INC(n)
      ELSIF c < 800H THEN b[n] := 0C0H + c DIV 64; b[n + 1] := 80H + c MOD 64; INC(n, 2)
      ELSIF c < 10000H THEN b[n] := 0E0H + c DIV 4096; b[n + 1] := 80H + c DIV 64 MOD 64; b[n + 2] := 80H + c MOD 64; INC(n, 3)
      ELSE b[n] := 0F0H + c DIV 262144; b[n + 1] := 80H + c DIV 4096 MOD 64; b[n + 2] := 80H + c DIV 64 MOD 64; b[n + 3] := 80H + c MOD 64; INC(n, 4)
      END
    END
  END Utf8;

  PROCEDURE DinUtf8(VAR b: ARRAY OF BYTE; i, n: INTEGER; VAR s: ARRAY OF CHAR);   (* n octeti de la b[i] -> s *)
    VAR k, c, x, r, e: INTEGER;
  BEGIN
    k := 0; e := i + n; r := 0; x := 0;
    WHILE (i < e) & (k < LEN(s) - 2) DO
      c := b[i] MOD 256; INC(i);
      IF r > 0 THEN x := x * 64 + c MOD 64; DEC(r)
      ELSIF c < 80H THEN x := c
      ELSIF c < 0E0H THEN x := c MOD 32; r := 1
      ELSIF c < 0F0H THEN x := c MOD 16; r := 2
      ELSE x := c MOD 8; r := 3
      END;
      IF r = 0 THEN
        IF x >= 10000H THEN s[k] := CHR(0D800H + (x - 10000H) DIV 400H); INC(k); x := 0DC00H + (x - 10000H) MOD 400H END;
        s[k] := CHR(x); INC(k)
      END
    END;
    s[k] := 0X
  END DinUtf8;

  PROCEDURE PS(s: ARRAY OF CHAR);   (* sir 9P: lungimea pe 2 octeti, apoi UTF-8 *)
    VAR a: INTEGER;
  BEGIN a := on; P2(0); Utf8(s, ob, on); ob[a] := (on - a - 2) MOD 256; ob[a + 1] := (on - a - 2) DIV 256
  END PS;

  PROCEDURE GetS(VAR b: ARRAY OF BYTE; VAR i: INTEGER; VAR s: ARRAY OF CHAR);
    VAR n: INTEGER;
  BEGIN n := Get2(b, i); DinUtf8(b, i + 2, n, s); i := i + 2 + n
  END GetS;

  PROCEDURE Incepe(tip, tag: INTEGER);
  BEGIN on := 0; P4(0); P1(tip); P2(tag)
  END Incepe;

  PROCEDURE Gata(): INTEGER;   (* marimea, in primii 4 octeti *)
    VAR n: INTEGER;
  BEGIN n := on; on := 0; P4(n); on := n; RETURN n
  END Gata;

  PROCEDURE Eroare(tag: INTEGER; m: ARRAY OF CHAR): INTEGER;
  BEGIN Incepe(Rerror, tag); PS(m); RETURN Gata()
  END Eroare;

  (* ======================= arborele ======================= *)

  PROCEDURE EDosar(k: INTEGER): BOOLEAN;
  BEGIN RETURN (k = kRoot) OR (k = kCub) OR (k = kProc) OR (k = kProcT)
  END EDosar;

  PROCEDURE CubIdx(VAR n: ARRAY OF CHAR): INTEGER;
  BEGIN RETURN CFS.Gaseste(n)
  END CubIdx;

  PROCEDURE Cale(k, t: INTEGER; VAR n: ARRAY OF CHAR): INTEGER;   (* qid.path *)
    VAR r: INTEGER;
  BEGIN
    IF k = kRoot THEN r := 0 ELSIF k = kCub THEN r := 1 ELSIF k = kHarta THEN r := 2 ELSIF k = kProc THEN r := 3
    ELSIF k = kOpal THEN r := 4 ELSIF k = kProlog THEN r := 5 ELSIF k = kEula THEN r := 6
    ELSIF k = kProcT THEN r := 10 + t ELSIF k = kStare THEN r := 20 + t ELSIF k = kCtl THEN r := 30 + t
    ELSE r := 1000 + CFS.Celula(CubIdx(n))
    END;
    RETURN r
  END Cale;

  PROCEDURE Qid(k, t: INTEGER; VAR n: ARRAY OF CHAR);
  BEGIN IF EDosar(k) THEN P1(80H) ELSE P1(0) END; P4(0); P8(Cale(k, t, n))
  END Qid;

  PROCEDURE NumeNod(k, t: INTEGER; VAR n, nm: ARRAY OF CHAR);
  BEGIN
    IF k = kRoot THEN nm := "/" ELSIF k = kCub THEN nm := "cub" ELSIF k = kHarta THEN nm := "harta" ELSIF k = kProc THEN nm := "proc"
    ELSIF k = kOpal THEN nm := "opal" ELSIF k = kProlog THEN nm := "prolog" ELSIF k = kEula THEN nm := "eula"
    ELSIF k = kProcT THEN nm := ""; Strings.AppendInt(t, 0, nm) ELSIF k = kStare THEN nm := "stare" ELSIF k = kCtl THEN nm := "ctl"
    ELSE Strings.Copy(n, nm)
    END
  END NumeNod;

  PROCEDURE Stat(k, t: INTEGER; VAR n: ARRAY OF CHAR);   (* un stat 9P la sfarsitul lui ob *)
    VAR a, mode, len: INTEGER; nm: ARRAY 64 OF CHAR;
  BEGIN
    a := on; P2(0); P2(0); P4(0); Qid(k, t, n);
    IF EDosar(k) THEN mode := DMDIR + 365 ELSIF k = kCubF THEN mode := 420 ELSIF k = kCtl THEN mode := 146
    ELSIF (k = kProlog) OR (k = kEula) THEN mode := 438 ELSE mode := 292
    END;
    P4(mode); P4(Tor7.Nascut() + 1262304000); P4(Tor7.Nascut() + 1262304000);
    len := 0; IF k = kCubF THEN cont(k, t, n); len := sn END;
    P8(len); NumeNod(k, t, n, nm); PS(nm); PS("pion"); PS("pion"); PS("pion");
    ob[a] := (on - a - 2) MOD 256; ob[a + 1] := (on - a - 2) DIV 256
  END Stat;

  PROCEDURE Ln(s: ARRAY OF CHAR);   (* un rand la sb *)
  BEGIN Utf8(s, sb, sn); IF sn < LEN(sb) THEN sb[sn] := 0AH; INC(sn) END
  END Ln;

  PROCEDURE Doi(v: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF v < 10 THEN Strings.Append("0", s) END; Strings.AppendInt(v, 0, s)
  END Doi;

  PROCEDURE Opal;   (* aceleasi randuri ca ceas din Shell *)
    VAR s: ARRAY 200 OF CHAR; lt, a, l, z, k, p, v, t: INTEGER; lun, nt: ARRAY 4 OF CHAR;
  BEGIN
    s := "Opal · ciclul w = "; Strings.AppendInt(Tor7.Ciclu(), 0, s); Strings.Append(" · bătaia ", s); Strings.AppendInt(Tor7.BataieOra(), 0, s);
    Strings.Append("/1155 · colțul Do ", s); Strings.AppendInt(Tor7.Colt(), 0, s); Ln(s);
    s := "  torul s-a născut ";
    IF Tor7.Nascut() >= 0 THEN
      lt := CFS.Local(Tor7.Nascut()); CFS.Data(lt DIV 86400, a, l, z);
      CASE l OF 1: lun := "ian" | 2: lun := "feb" | 3: lun := "mar" | 4: lun := "apr" | 5: lun := "mai" | 6: lun := "iun"
      | 7: lun := "iul" | 8: lun := "aug" | 9: lun := "sep" | 10: lun := "oct" | 11: lun := "nov" | 12: lun := "dec" END;
      Strings.AppendInt(z, 0, s); Strings.Append(" ", s); Strings.Append(lun, s); Strings.Append(" ", s); Strings.AppendInt(a, 0, s);
      Strings.Append(", ", s); Doi(lt MOD 86400 DIV 3600, s); Strings.Append(":", s); Doi(lt MOD 3600 DIV 60, s)
    ELSE Strings.Append("(nu știu când)", s)
    END;
    Strings.Append(" · Burn-uri: ", s); Strings.AppendInt(Tor7.Arderi(), 0, s); Strings.Append(" · ceasul nu arde", s); Ln(s);
    FOR k := 0 TO 4 DO
      IF k = 0 THEN p := 1 ELSIF k = 1 THEN p := 3 ELSIF k = 2 THEN p := 5 ELSIF k = 3 THEN p := 7 ELSE p := 11 END;
      s := "  acul "; Strings.AppendInt(p, 2, s); Strings.Append(" → locul ", s); Strings.AppendInt(Tor7.Pozitie(p), 0, s);
      v := Tor7.Opal(p); Strings.Append(" · citit ", s);
      IF v < 0 THEN Strings.Append("–", s) ELSE Strings.AppendInt(v, 0, s) END;
      Strings.Append(" · emis ", s); Strings.AppendInt(Tor7.Emisii(p), 0, s); Ln(s)
    END;
    t := Tor7.Treapta(0);
    CASE t MOD 7 OF 0: nt := "Do" | 1: nt := "Re" | 2: nt := "Mi" | 3: nt := "Fa" | 4: nt := "Sol" | 5: nt := "La" | 6: nt := "Si" END;
    s := "  adresa 0 stă pe locul "; Strings.AppendInt(Tor7.Fizic(0), 0, s); Strings.Append(" · cântă ", s);
    Strings.Append(nt, s); Strings.AppendInt(t DIV 7 + 2, 0, s); Strings.Append(" (", s);
    Strings.AppendInt(Tor7.Hz(t), 0, s); Strings.Append(" Hz)", s); Ln(s)
  END Opal;

  PROCEDURE Stare(t: INTEGER);
    VAR s, x: ARRAY 120 OF CHAR;
  BEGIN
    IF Sal.Stare(t) = Sal.Liber THEN Ln("liber")
    ELSE Sal.Nume(t, s); Strings.Append(" ", s); Strings.AppendInt(Sal.Pid(t), 0, s); Strings.Append(" ", s); Sal.NumeStare(Sal.Stare(t), x); Strings.Append(x, s); Ln(s)
    END
  END Stare;

  PROCEDURE ContinutImpl(k, t: INTEGER; VAR n: ARRAY OF CHAR);   (* continutul unui fisier mic, in sb[0..sn) *)
    VAR i, m: INTEGER; c: ARRAY CFS.LC OF CHAR;
  BEGIN
    sn := 0;
    IF k = kCubF THEN
      i := CubIdx(n);
      IF i >= 0 THEN
        m := CFS.Marime(i);
        IF m >= 0 THEN IF m > LEN(sb) THEN m := LEN(sb) END; sn := CFS.Octeti(i, 0, sb)
        ELSE CFS.Continut(i, c); Utf8(c, sb, sn)
        END
      END
    ELSIF k = kOpal THEN Opal
    ELSIF k = kStare THEN Stare(t)
    ELSIF k = kProlog THEN Utf8(pr, sb, sn)
    ELSIF k = kEula THEN Utf8(eu, sb, sn)
    END
  END ContinutImpl;

  PROCEDURE Harta;   (* /harta in hb, la deschidere *)
    VAR j: INTEGER; s: ARRAY 1500 OF CHAR; t: ARRAY 1100 OF CHAR;
  BEGIN
    hn := 0;
    FOR j := 0 TO CFS.nh - 1 DO
      IF hn < LB - 3000 THEN
        s := "cfs://"; CFS.CelText(CFS.HCel(j), t); Strings.Append(t, s); Strings.Append(" ", s);
        CFS.HNume(j, t); Strings.Append(t, s); Strings.Append(" ", s); Strings.AppendInt(CFS.HMarime(j), 0, s);
        Strings.Append(" /", s); CFS.HDosar(j, t); Strings.Append(t, s);
        Utf8(s, hb, hn); hb[hn] := 0AH; INC(hn)
      END
    END
  END Harta;

  PROCEDURE Pas(VAR k, t: INTEGER; VAR n: ARRAY OF CHAR; VAR nm: ARRAY OF CHAR): BOOLEAN;   (* un pas de walk *)
    VAR ok: BOOLEAN; v: INTEGER;
  BEGIN
    ok := TRUE;
    IF nm = ".." THEN
      IF (k = kCub) OR (k = kProc) THEN k := kRoot ELSIF k = kProcT THEN k := kProc ELSIF k = kRoot THEN
      ELSE ok := FALSE
      END
    ELSIF k = kRoot THEN
      IF nm = "cub" THEN k := kCub ELSIF nm = "harta" THEN k := kHarta ELSIF nm = "proc" THEN k := kProc ELSIF nm = "opal" THEN k := kOpal
      ELSIF nm = "prolog" THEN k := kProlog ELSIF nm = "eula" THEN k := kEula ELSE ok := FALSE
      END
    ELSIF k = kCub THEN
      IF CFS.Gaseste(nm) >= 0 THEN k := kCubF; Strings.Copy(nm, n) ELSE ok := FALSE END
    ELSIF k = kProc THEN
      IF (nm[0] >= "0") & (nm[0] <= "6") & (nm[1] = 0X) THEN v := ORD(nm[0]) - ORD("0"); k := kProcT; t := v ELSE ok := FALSE END
    ELSIF k = kProcT THEN
      IF nm = "stare" THEN k := kStare ELSIF nm = "ctl" THEN k := kCtl ELSE ok := FALSE END
    ELSE ok := FALSE
    END;
    RETURN ok
  END Pas;

  PROCEDURE Dosar(k, t: INTEGER);   (* toate intrarile dosarului, ca stat-uri, in sb *)
    VAR i, a: INTEGER; nm: ARRAY 64 OF CHAR;
  BEGIN
    a := on; on := 0;   (* folosesc ob ca loc de lucru: il copiez in sb *)
    nm := "";
    IF k = kRoot THEN Stat(kCub, 0, nm); Stat(kHarta, 0, nm); Stat(kProc, 0, nm); Stat(kOpal, 0, nm); Stat(kProlog, 0, nm); Stat(kEula, 0, nm)
    ELSIF k = kCub THEN FOR i := 0 TO CFS.N() - 1 DO CFS.Nume(i, nm); IF on < LEN(ob) - 600 THEN Stat(kCubF, 0, nm) END END
    ELSIF k = kProc THEN FOR i := 0 TO 6 DO Stat(kProcT, i, nm) END
    ELSIF k = kProcT THEN Stat(kStare, t, nm); Stat(kCtl, t, nm)
    END;
    sn := on; FOR i := 0 TO sn - 1 DO sb[i] := ob[i] END;
    on := a
  END Dosar;

  (* ======================= fid-urile ======================= *)

  PROCEDURE Fid(nr: INTEGER): INTEGER;
    VAR i, r: INTEGER;
  BEGIN r := -1; FOR i := 0 TO NF - 1 DO IF fUsed[i] & (fNr[i] = nr) THEN r := i END END; RETURN r
  END Fid;

  PROCEDURE NouFid(nr: INTEGER): INTEGER;
    VAR i, r: INTEGER;
  BEGIN
    r := -1; i := 0; WHILE (r < 0) & (i < NF) DO IF ~fUsed[i] THEN r := i END; INC(i) END;
    IF r >= 0 THEN fUsed[r] := TRUE; fNr[r] := nr; fOpen[r] := FALSE; fDirty[r] := FALSE; fWn[r] := 0; fNume[r] := "" END;
    RETURN r
  END NouFid;

  PROCEDURE Inchide(f: INTEGER);   (* clunk: ce s-a scris intr-un fisier din cub ajunge in cub *)
    VAR c: ARRAY CFS.LC OF CHAR; k: INTEGER;
  BEGIN
    IF fDirty[f] & (fKind[f] = kCubF) THEN DinUtf8(fW[f], 0, fWn[f], c); k := CFS.Scrie(fNume[f], c) END;
    fUsed[f] := FALSE
  END Inchide;

  PROCEDURE Scris(f: INTEGER);   (* o scriere in /prolog, /eula, ctl: se face pe loc *)
    VAR s: ARRAY 2000 OF CHAR; i, n: INTEGER; q: ARRAY 2010 OF CHAR;
  BEGIN
    DinUtf8(fW[f], 0, fWn[f], s);
    n := Strings.Length(s); WHILE (n > 0) & ((s[n - 1] = 0AX) OR (s[n - 1] = " ") OR (s[n - 1] = 0DX)) DO DEC(n); s[n] := 0X END;
    IF fKind[f] = kCtl THEN
      IF s = "kill" THEN IF Sal.Stare(fT[f]) # Sal.Liber THEN Sal.Opreste(fT[f]) END END
    ELSIF fKind[f] = kProlog THEN
      IF Strings.Pos("?-", s, 0) < 0 THEN q := "?- "; Strings.Append(s, q) ELSE Strings.Copy(s, q) END;
      n := Strings.Length(q); IF (n > 0) & (q[n - 1] # ".") THEN Strings.Append(".", q) END;
      n := Z7P.IntrebareText(q); pr := "";
      FOR i := 0 TO Z7P.nrez - 1 DO Strings.Append(Z7P.rez[i], pr); Strings.AppendChar(0AX, pr) END
    ELSIF fKind[f] = kEula THEN
      IF Te.Raspunde(s) THEN Strings.Copy(Te.txt, eu); canta := Te.nev > 0 ELSE eu := "Eula ♪ nu știe asta: "; Strings.Append(s, eu) END;
      Strings.AppendChar(0AX, eu)
    END;
    fWn[f] := 0
  END Scris;

  PROCEDURE CereCantec*(): BOOLEAN;   (* /eula a cerut sa cante (o data) *)
    VAR r: BOOLEAN;
  BEGIN r := canta; canta := FALSE; RETURN r
  END CereCantec;

  (* ======================= mesajele ======================= *)

  PROCEDURE Proceseaza*(VAR b: ARRAY OF BYTE; n: INTEGER; VAR r: ARRAY OF BYTE): INTEGER;
    (* un mesaj T (b[0..n)) -> mesajul R in r; intoarce marimea lui R (0 = nimic de raspuns) *)
    VAR tip, tag, f, g, nf, k, t, i, j, nw, off, cnt, mode, len, p, a: INTEGER; nm, nume: ARRAY 64 OF CHAR;
      s: ARRAY 64 OF CHAR; ok: BOOLEAN; nq: INTEGER;
  BEGIN
    len := 0;
    IF (n < 7) OR (Get4(b, 0) # n) THEN len := 0
    ELSE
      tip := Get1(b, 4); tag := Get2(b, 5); p := 7;
      IF tip = Tversion THEN
        k := Get4(b, 7); p := 11; GetS(b, p, s);
        FOR i := 0 TO NF - 1 DO fUsed[i] := FALSE END;
        IF (k < 0) OR (k > MS) THEN k := MS END; IF k < 256 THEN k := 256 END; msize := k;
        Incepe(Rversion, tag); P4(msize); IF Strings.Pos("9P2000", s, 0) = 0 THEN PS("9P2000") ELSE PS("unknown") END; len := Gata()
      ELSIF n > msize THEN len := Eroare(tag, "mesajul e mai mare decât msize")
      ELSIF tip = Tauth THEN len := Eroare(tag, "fără parolă: montează cu -A")
      ELSIF tip = Tattach THEN
        f := Get4(b, 7);
        IF Fid(f) >= 0 THEN len := Eroare(tag, "fid folosit deja")
        ELSE g := NouFid(f);
          IF g < 0 THEN len := Eroare(tag, "prea multe fid-uri") ELSE fKind[g] := kRoot; fT[g] := 0; nm := ""; Incepe(Rattach, tag); Qid(kRoot, 0, nm); len := Gata() END
        END
      ELSIF tip = Tflush THEN Incepe(Rflush, tag); len := Gata()
      ELSIF tip = Twalk THEN
        f := Fid(Get4(b, 7)); nf := Get4(b, 11); nw := Get2(b, 15); p := 17;
        IF f < 0 THEN len := Eroare(tag, "fid necunoscut")
        ELSIF fOpen[f] THEN len := Eroare(tag, "fid deschis")
        ELSIF (nf # fNr[f]) & (Fid(nf) >= 0) THEN len := Eroare(tag, "newfid folosit deja")
        ELSIF nw > 16 THEN len := Eroare(tag, "prea multe nume")
        ELSE
          k := fKind[f]; t := fT[f]; Strings.Copy(fNume[f], nume); j := 0; ok := TRUE;
          Incepe(Rwalk, tag); a := on; P2(0);
          WHILE ok & (j < nw) DO
            GetS(b, p, nm);
            IF Pas(k, t, nume, nm) THEN Qid(k, t, nume); INC(j) ELSE ok := FALSE END
          END;
          IF (j = 0) & (nw > 0) THEN len := Eroare(tag, "nu există")
          ELSE
            ob[a] := j MOD 256; ob[a + 1] := j DIV 256;
            IF j = nw THEN
              IF nf = fNr[f] THEN g := f ELSE g := NouFid(nf) END;
              IF g < 0 THEN len := Eroare(tag, "prea multe fid-uri")
              ELSE fKind[g] := k; fT[g] := t; Strings.Copy(nume, fNume[g]); len := Gata()
              END
            ELSE len := Gata()
            END
          END
        END
      ELSIF tip = Topen THEN
        f := Fid(Get4(b, 7)); mode := Get1(b, 11);
        IF f < 0 THEN len := Eroare(tag, "fid necunoscut")
        ELSIF fOpen[f] THEN len := Eroare(tag, "deja deschis")
        ELSE
          k := fKind[f]; ok := TRUE;
          IF EDosar(k) & (mode MOD 4 # 0) THEN ok := FALSE
          ELSIF ((k = kHarta) OR (k = kOpal) OR (k = kStare)) & (mode MOD 4 # 0) THEN ok := FALSE
          ELSIF (k = kCtl) & (mode MOD 4 = 0) THEN ok := FALSE
          END;
          IF (k = kCubF) & (CubIdx(fNume[f]) < 0) THEN len := Eroare(tag, "nu mai există")
          ELSIF ~ok THEN len := Eroare(tag, "nu se poate deschide așa")
          ELSE
            fOpen[f] := TRUE; fMode[f] := mode; fWn[f] := 0; fDirty[f] := FALSE;
            IF k = kHarta THEN Harta END;
            IF (k = kCubF) & (mode MOD 4 # 0) THEN
              IF mode DIV 16 MOD 2 = 1 THEN fDirty[f] := TRUE   (* OTRUNC: gol *)
              ELSE cont(k, fT[f], fNume[f]); FOR i := 0 TO sn - 1 DO IF i < LW THEN fW[f][i] := sb[i] END END; fWn[f] := sn; IF fWn[f] > LW THEN fWn[f] := LW END
              END
            END;
            Incepe(Ropen, tag); Qid(k, fT[f], fNume[f]); P4(0); len := Gata()
          END
        END
      ELSIF tip = Tcreate THEN
        f := Fid(Get4(b, 7)); p := 11; GetS(b, p, nm); mode := Get1(b, p + 4);
        IF f < 0 THEN len := Eroare(tag, "fid necunoscut")
        ELSIF fKind[f] # kCub THEN len := Eroare(tag, "se creează doar în /cub")
        ELSIF Get4(b, p) < 0 THEN len := Eroare(tag, "în /cub nu se fac dosare")
        ELSIF (nm = "") OR (Strings.Length(nm) >= CFS.LN) OR (Strings.Pos("/", nm, 0) >= 0) THEN len := Eroare(tag, "nume prea lung sau greșit")
        ELSE
          IF CFS.Gaseste(nm) < 0 THEN k := CFS.Scrie(nm, "") END;
          IF CFS.Gaseste(nm) < 0 THEN len := Eroare(tag, "cubul e plin")
          ELSE
            fKind[f] := kCubF; Strings.Copy(nm, fNume[f]); fOpen[f] := TRUE; fMode[f] := mode; fWn[f] := 0; fDirty[f] := TRUE;
            Incepe(Rcreate, tag); Qid(kCubF, 0, nm); P4(0); len := Gata()
          END
        END
      ELSIF tip = Tread THEN
        f := Fid(Get4(b, 7)); off := Get8(b, 11); cnt := Get4(b, 19);
        IF f < 0 THEN len := Eroare(tag, "fid necunoscut")
        ELSIF ~fOpen[f] THEN len := Eroare(tag, "nu e deschis")
        ELSE
          k := fKind[f]; IF (cnt < 0) OR (cnt > msize - 11) THEN cnt := msize - 11 END;
          IF EDosar(k) THEN Dosar(k, fT[f]) END;   (* Dosar lucreaza in ob: inainte de antet *)
          Incepe(Rread, tag); a := on; P4(0);
          IF EDosar(k) THEN   (* intrari intregi, de la off *)
            i := off; j := 0;
            WHILE (i < sn) & (j + Get2(sb, i) + 2 <= cnt) DO
              len := Get2(sb, i) + 2; FOR p := 0 TO len - 1 DO P1(sb[i + p]) END; i := i + len; j := j + len
            END
          ELSIF k = kHarta THEN j := 0; WHILE (off + j < hn) & (j < cnt) DO P1(hb[off + j]); INC(j) END
          ELSIF k = kCtl THEN j := 0
          ELSE cont(k, fT[f], fNume[f]); j := 0; WHILE (off + j < sn) & (j < cnt) DO P1(sb[off + j]); INC(j) END
          END;
          ob[a] := j MOD 256; ob[a + 1] := j DIV 256 MOD 256; ob[a + 2] := j DIV 65536 MOD 256; ob[a + 3] := 0;
          len := Gata()
        END
      ELSIF tip = Twrite THEN
        f := Fid(Get4(b, 7)); off := Get8(b, 11); cnt := Get4(b, 19);
        IF f < 0 THEN len := Eroare(tag, "fid necunoscut")
        ELSIF ~fOpen[f] OR (fMode[f] MOD 4 = 0) THEN len := Eroare(tag, "nu e deschis pentru scris")
        ELSIF (cnt < 0) OR (23 + cnt > n) THEN len := Eroare(tag, "mesaj stricat")
        ELSE
          k := fKind[f];
          IF (k = kCubF) THEN
            IF off + cnt > LW THEN len := Eroare(tag, "fișierul e prea mare pentru o celulă de text")
            ELSE
              FOR i := 0 TO cnt - 1 DO fW[f][off + i] := b[23 + i] END;
              IF off + cnt > fWn[f] THEN fWn[f] := off + cnt END; fDirty[f] := TRUE;
              Incepe(Rwrite, tag); P4(cnt); len := Gata()
            END
          ELSIF (k = kCtl) OR (k = kProlog) OR (k = kEula) THEN
            fWn[f] := 0; FOR i := 0 TO cnt - 1 DO IF i < LW THEN fW[f][i] := b[23 + i]; INC(fWn[f]) END END;
            Scris(f); Incepe(Rwrite, tag); P4(cnt); len := Gata()
          ELSE len := Eroare(tag, "doar citit")
          END
        END
      ELSIF tip = Tclunk THEN
        f := Fid(Get4(b, 7));
        IF f < 0 THEN len := Eroare(tag, "fid necunoscut") ELSE Inchide(f); Incepe(Rclunk, tag); len := Gata() END
      ELSIF tip = Tremove THEN
        f := Fid(Get4(b, 7));
        IF f < 0 THEN len := Eroare(tag, "fid necunoscut")
        ELSIF (fKind[f] = kCubF) & (CubIdx(fNume[f]) >= 0) THEN
          CFS.Arde(CubIdx(fNume[f])); fDirty[f] := FALSE; Inchide(f); Incepe(Rremove, tag); len := Gata()
        ELSE fDirty[f] := FALSE; Inchide(f); len := Eroare(tag, "nu se poate șterge")
        END
      ELSIF tip = Tstat THEN
        f := Fid(Get4(b, 7));
        IF f < 0 THEN len := Eroare(tag, "fid necunoscut")
        ELSIF (fKind[f] = kCubF) & (CubIdx(fNume[f]) < 0) THEN len := Eroare(tag, "nu mai există")
        ELSE Incepe(Rstat, tag); a := on; P2(0); Stat(fKind[f], fT[f], fNume[f]); nq := on - a - 2; ob[a] := nq MOD 256; ob[a + 1] := nq DIV 256; len := Gata()
        END
      ELSIF tip = Twstat THEN len := Eroare(tag, "wstat nu se poate (încă)")
      ELSE len := Eroare(tag, "mesaj necunoscut")
      END
    END;
    FOR i := 0 TO len - 1 DO r[i] := ob[i] END;
    RETURN len
  END Proceseaza;

  (* ======================= clientul din Shell (styx ls / cat / scrie) ======================= *)

  PROCEDURE CLinie(s: ARRAY OF CHAR);
  BEGIN IF nlinii < LEN(linii) THEN Strings.Copy(s, linii[nlinii]); INC(nlinii) END
  END CLinie;

  PROCEDURE PeFir(n: INTEGER): INTEGER;   (* v2.6: cq pleaca pe fir, raspunsul vine in cr; tipul lui, 0 = nimic *)
    VAR r, k, m, i, t0: INTEGER; gata, rupt: BOOLEAN;
  BEGIN
    r := 0; gata := FALSE; rupt := FALSE;
    Ecran.Spre(cq, n); t0 := Sunet.Ms();
    REPEAT
      k := Ecran.Dinspre(cr);   (* cr e doar locul in care vin; ce vine se pune in coada tb *)
      IF k < 0 THEN rupt := TRUE
      ELSIF k > 0 THEN
        IF tn + k > LEN(tb) THEN tn := 0 END;
        FOR i := 0 TO k - 1 DO tb[tn + i] := cr[i] END; tn := tn + k
      ELSIF Asteptand # NIL THEN Asteptand
      END;
      IF tn >= 4 THEN
        m := Get4(tb, 0);
        IF (m < 7) OR (m > LEN(cr)) THEN tn := 0; rupt := TRUE   (* nu e Styx *)
        ELSIF tn >= m THEN
          FOR i := 0 TO m - 1 DO cr[i] := tb[i] END;
          FOR i := m TO tn - 1 DO tb[i - m] := tb[i] END; tn := tn - m;
          IF Get2(cr, 5) = Get2(cq, 5) THEN r := Get1(cr, 4); gata := TRUE END   (* alt tag = un raspuns vechi: il sar *)
        END
      END
    UNTIL gata OR rupt OR (Sunet.Ms() - t0 > 5000);
    IF ~gata THEN
      Ecran.Dezleaga; departe := FALSE; tn := 0; stricat := TRUE;
      IF rupt THEN CLinie("eroare Styx: legătura s-a rupt · înapoi la cubul tău")
      ELSE CLinie("eroare Styx: serverul nu răspunde · înapoi la cubul tău")
      END
    END;
    RETURN r
  END PeFir;

  PROCEDURE CRpc(): INTEGER;   (* trimite cq (marimea e in primii 4 octeti); raspunsul in cr; intoarce tipul *)
    VAR n, r: INTEGER;
  BEGIN
    n := Get4(cq, 0); r := 0;
    IF stricat THEN r := 0   (* comanda asta nu mai continua (nici local) *)
    ELSIF (n > 0) & departe THEN r := PeFir(n)
    ELSIF n > 0 THEN n := Proceseaza(cq, n, cr); IF n >= 7 THEN r := Get1(cr, 4) END
    END;
    RETURN r
  END CRpc;

  PROCEDURE CT(tip: INTEGER);   (* incep un mesaj in cq (prin ob) *)
  BEGIN INC(ctag); Incepe(tip, ctag MOD 65000)
  END CT;

  PROCEDURE CTrimite(): INTEGER;
    VAR n, i: INTEGER;
  BEGIN n := Gata(); FOR i := 0 TO n - 1 DO cq[i] := ob[i] END; RETURN CRpc()
  END CTrimite;

  PROCEDURE CEroare;   (* mesajul unui Rerror din cr *)
    VAR i: INTEGER; s: ARRAY 200 OF CHAR; m: ARRAY 160 OF CHAR;
  BEGIN IF ~stricat THEN i := 7; GetS(cr, i, m); s := "eroare Styx: "; Strings.Append(m, s); CLinie(s) END
  END CEroare;

  PROCEDURE CWalk(cale: ARRAY OF CHAR; fid: INTEGER): BOOLEAN;   (* attach 60000, walk catre fid *)
    VAR i, k, nw, r: INTEGER; nm: ARRAY 64 OF CHAR; ok: BOOLEAN; parti: ARRAY 16 OF ARRAY 64 OF CHAR;
  BEGIN
    CT(Tclunk); P4(60000); r := CTrimite(); CT(Tclunk); P4(fid); r := CTrimite();
    CT(Tattach); P4(60000); P4(-1); PS("pion"); PS(""); r := CTrimite(); ok := r = Rattach;
    nw := 0; i := 0; k := 0;
    WHILE (i <= Strings.Length(cale)) & (nw < 16) DO
      IF (i = Strings.Length(cale)) OR (cale[i] = "/") THEN
        nm[k] := 0X; IF k > 0 THEN Strings.Copy(nm, parti[nw]); INC(nw) END; k := 0
      ELSIF k < 63 THEN nm[k] := cale[i]; INC(k)
      END;
      INC(i)
    END;
    IF ok THEN
      CT(Twalk); P4(60000); P4(fid); P2(nw); FOR i := 0 TO nw - 1 DO PS(parti[i]) END;
      r := CTrimite();
      IF r # Rwalk THEN ok := FALSE; CEroare
      ELSIF Get2(cr, 7) # nw THEN ok := FALSE; IF ~stricat THEN CLinie("eroare Styx: nu există") END
      END
    END;
    RETURN ok
  END CWalk;

  PROCEDURE Leaga*(gazda: ARRAY OF CHAR; port: INTEGER);   (* v2.6: clientul se leaga de alt server Styx -> linii *)
    VAR t0, st, r: INTEGER; s: ARRAY 200 OF CHAR;
  BEGIN
    nlinii := 0; departe := FALSE; tn := 0; stricat := FALSE;
    IF ~Ecran.Leaga(gazda, port) THEN CLinie("eroare Styx: adresa nu e bună")
    ELSE
      t0 := Sunet.Ms(); st := Ecran.Legatura();
      WHILE (st = 1) & (Sunet.Ms() - t0 < 5000) DO IF Asteptand # NIL THEN Asteptand END; st := Ecran.Legatura() END;
      IF st # 2 THEN
        Ecran.Dezleaga; s := "eroare Styx: nu mă pot lega de "; Strings.Append(gazda, s); Strings.Append(":", s);
        Strings.AppendInt(port, 0, s); CLinie(s)
      ELSE
        departe := TRUE;
        INC(ctag); Incepe(Tversion, 65535); P4(8216); PS("9P2000"); r := CTrimite();
        IF ~departe THEN   (* PeFir a scris deja de ce *)
        ELSIF r # Rversion THEN Ecran.Dezleaga; departe := FALSE; CLinie("eroare Styx: acolo nu e un server Styx")
        ELSE
          Strings.Copy(gazda, unde); Strings.Append(":", unde); Strings.AppendInt(port, 0, unde);
          s := "legat de "; Strings.Append(unde, s); Strings.Append(" · styx ls / cat / scrie merg acolo · styx dezleaga", s); CLinie(s)
        END
      END
    END
  END Leaga;

  PROCEDURE PuneAsteptand*(p: PROCEDURE);   (* v2.6: ce sa faca cubul cat asteapta raspunsul (Cubicum: Retea) *)
  BEGIN Asteptand := p
  END PuneAsteptand;

  PROCEDURE Dezleaga*;   (* v2.6: clientul se intoarce la cubul tau *)
  BEGIN
    nlinii := 0;
    IF departe THEN Ecran.Dezleaga; departe := FALSE; tn := 0; CLinie("dezlegat · styx ls / cat / scrie merg iar la cubul tău")
    ELSE CLinie("nu ești legat de alt cub")
    END
  END Dezleaga;

  PROCEDURE Goleste*;
  BEGIN nlinii := 0
  END Goleste;

  PROCEDURE Ls*(cale: ARRAY OF CHAR);   (* styx ls /cale -> linii *)
    VAR r, off, n, i, k, l: INTEGER; nm: ARRAY 64 OF CHAR; s: ARRAY 200 OF CHAR; dir: BOOLEAN;
  BEGIN
    nlinii := 0; stricat := FALSE;
    IF CWalk(cale, 60001) THEN
      CT(Topen); P4(60001); P1(0); r := CTrimite();
      IF r # Ropen THEN CEroare
      ELSIF Get1(cr, 7) # 80H THEN Strings.Copy(cale, s); Strings.Append(" (fișier)", s); CLinie(s)
      ELSE
        off := 0;
        REPEAT
          CT(Tread); P4(60001); P8(off); P4(8000); r := CTrimite(); n := Get4(cr, 7); i := 11;
          WHILE (r = Rread) & (i < 11 + n) DO
            l := Get2(cr, i); dir := Get1(cr, i + 2 + 2 + 4) = 80H; k := i + 2 + 2 + 4 + 13 + 4 + 4 + 4 + 8;
            GetS(cr, k, nm); s := "  "; Strings.Append(nm, s); IF dir THEN Strings.Append("/", s) END; CLinie(s);
            i := i + l + 2
          END;
          off := off + n
        UNTIL (r # Rread) OR (n = 0)
      END;
      CT(Tclunk); P4(60001); r := CTrimite()
    END
  END Ls;

  PROCEDURE Cat*(cale: ARRAY OF CHAR);   (* styx cat /cale -> linii *)
    VAR r, off, n, i, k: INTEGER; s: ARRAY 200 OF CHAR; buf: ARRAY 9000 OF BYTE; m: INTEGER;
  BEGIN
    nlinii := 0; stricat := FALSE;
    IF CWalk(cale, 60001) THEN
      CT(Topen); P4(60001); P1(0); r := CTrimite();
      IF r # Ropen THEN CEroare
      ELSE
        off := 0; m := 0;
        REPEAT
          CT(Tread); P4(60001); P8(off); P4(4000); r := CTrimite(); n := Get4(cr, 7);
          IF r = Rread THEN
            FOR i := 0 TO n - 1 DO
              k := Get1(cr, 11 + i);
              IF k = 0AH THEN DinUtf8(buf, 0, m, s); CLinie(s); m := 0
              ELSIF m < LEN(buf) THEN buf[m] := k; INC(m)
              END
            END
          ELSE CEroare
          END;
          off := off + n
        UNTIL (r # Rread) OR (n = 0) OR (nlinii >= LEN(linii));
        IF m > 0 THEN DinUtf8(buf, 0, m, s); CLinie(s) END
      END;
      CT(Tclunk); P4(60001); r := CTrimite()
    END
  END Cat;

  PROCEDURE Scrie*(cale, text: ARRAY OF CHAR);   (* styx scrie /cale text -> linii *)
    VAR r, a, n: INTEGER; s: ARRAY 100 OF CHAR;
  BEGIN
    nlinii := 0; stricat := FALSE;
    IF CWalk(cale, 60001) THEN
      CT(Topen); P4(60001); P1(1 + 16); r := CTrimite();   (* OWRITE | OTRUNC *)
      IF r # Ropen THEN CEroare
      ELSE
        CT(Twrite); P4(60001); P8(0); a := on; P4(0); n := on; Utf8(text, ob, on); n := on - n;
        ob[a] := n MOD 256; ob[a + 1] := n DIV 256 MOD 256; ob[a + 2] := 0; ob[a + 3] := 0;
        r := CTrimite();
        IF r # Rwrite THEN CEroare ELSE s := "(scris "; Strings.AppendInt(Get4(cr, 7), 0, s); Strings.Append(" octeți)", s); CLinie(s) END
      END;
      CT(Tclunk); P4(60001); r := CTrimite()
    END
  END Scrie;

BEGIN
  msize := 8216; on := 0; sn := 0; hn := 0; pr := ""; eu := ""; canta := FALSE; ctag := 0; nlinii := 0;
  departe := FALSE; unde := ""; tn := 0; Asteptand := NIL; stricat := FALSE;
  FOR on := 0 TO NF - 1 DO fUsed[on] := FALSE END; on := 0;
  cont := ContinutImpl
END Styx.


MODULE CubRoller;  (* Cub Roller 9 ca program in Cubicum OS (v2.7): acelasi joc, dar fara sa fie aplicatie de sine
  statatoare. Cubicum OS il cheama: Porneste (de fiecare data un labirint nou), apoi Cadru la fiecare cadru si Atingere
  la fiecare atingere; cand apesi X (dreapta sus), iesit devine TRUE si Cubicum OS se intoarce in cub.
  Jocul: o teava colorata prin cubul Z7 (torul 7 x 7 x 7), cu bifurcatii, urcari si coborari. Stanga-dreapta = volanul
  (bila se invarte pe cercul tevii, si pe tavan); varful telefonului de la tine = viteza; drept = bila sta. Notele de pe
  podea (stanga grave, dreapta inalte) se prind trecand prin ele; muzica (tobe, bas, arpegiu) creste cu progresul.
  Atingi: pauza. Atingi sus: aici e drept.        Pion & Claude, 27.10.2026 *)
  IMPORT Ecran, Senzor, Sunet, Math, Strings;

  CONST
    N = 7; C = 343;
    Bucle = 30;             (* pereti deschisi in plus fata de labirintul perfect: bifurcatiile *)
    Inainte = 9;            (* cate noduri vezi in fata *)
    Ln2 = 0.693147; Ln15 = 0.405465; Ln175 = 0.559616;
    LBar = 60000;           (* jumatate de masura, cel mult (la 92 de batai pe minut) *)
    LKick = 11025; LSnare = 7938; LHat = 2205; LTom = 8820;   (* lungimile tobelor, in esantioane la 44100 Hz *)

  VAR
    deschis: ARRAY C, 6 OF BOOLEAN;
    dX, dY, dZ, opus: ARRAY 6 OF INTEGER;
    seed: INTEGER;
    nod, dir, urm, prevDir: INTEGER;     (* nodul de unde vin, directia de acum, cea de dupa nodul urmator, cea dinainte *)
    t, v: REAL;                          (* cat din drum am facut (0..1), viteza in noduri / s *)
    merge, gravitatie, inainte: BOOLEAN;
    gx0, gy0, ultim, notaDin, sclipire, noduri, bifurcatii: INTEGER;
    tiltX, tiltY: REAL;
    pvx, pvy, pvz: REAL;                 (* unde esti pe peretele tevii: directia din centru spre tine *)
    luat: ARRAY C, 6 OF BOOLEAN;         (* notele prinse *)
    pent: ARRAY 8 OF INTEGER; slotCul: ARRAY 8 OF INTEGER;
    prinse, ratate, combo, prinsDin, prinsSlot, ratatDin: INTEGER;
    (* drumul vazut in fata: pozitii fara tor (ca sa se vada continuu) *)
    pX, pY, pZ: ARRAY Inainte + 2 OF INTEGER; pNod: ARRAY Inainte + 2 OF INTEGER; pN: INTEGER;
    aur, stins: INTEGER;
    zona, zonaVeche, zonaLa: INTEGER;    (* culoarea tronsonului = nodul in care ai intrat la ultima bifurcatie *)
    kick, snare, hat, tom: ARRAY LKick OF REAL;
    zs, nivel, pas16: INTEGER; ph16: REAL;
    gfx, gfy, gfz, al0, phi, tinta, rola, pa0, vtinta, omega: REAL;   (* gravitatia neteda, unghiul tau pe cerc (0 = jos) *)
    cux, cuy, cuz: REAL;                 (* sus-ul camerei, purtat de-a lungul tevii *)
    bara: ARRAY 2, LBar OF REAL; bb, barEnd, jum: INTEGER;
    tabSin: ARRAY 4096 OF REAL;
    iesit*: BOOLEAN;                     (* TRUE: jucatorul a apasat X, Cubicum OS se intoarce in cub *)
    i, j: INTEGER;

  (* ---------- unelte ---------- *)

  PROCEDURE Nr(m: INTEGER): INTEGER;
  BEGIN seed := (seed * 75 + 74) MOD 65537; RETURN seed MOD m
  END Nr;

  PROCEDURE Celula(x, y, z: INTEGER): INTEGER;
  BEGIN RETURN (x MOD N) * 49 + (y MOD N) * 7 + z MOD N
  END Celula;

  PROCEDURE Vecin(c, k: INTEGER): INTEGER;
  BEGIN RETURN Celula(c DIV 49 + dX[k], (c DIV 7) MOD 7 + dY[k], c MOD 7 + dZ[k])
  END Vecin;

  PROCEDURE Culoare(c, procent: INTEGER): INTEGER;   (* culoarea nodului, ca in CubDans *)
    VAR x, y, z: INTEGER;
  BEGIN x := c DIV 49; y := (c DIV 7) MOD 7; z := c MOD 7;
    RETURN Ecran.RGB(18 + x * 38 * procent DIV 100, 18 + y * 38 * procent DIV 100, 18 + z * 38 * procent DIV 100)
  END Culoare;

  PROCEDURE Nota(c: INTEGER): INTEGER;   (* frecventa Z7 a nodului, adusa pe gama pentatonica Sol-La-Do-Re-Mi *)
    VAR f, x, bd: REAL; m, k, best, d: INTEGER;
  BEGIN
    f := 256.0 * Math.exp(FLT(c DIV 49) * Ln15 + FLT((c DIV 7) MOD 7) * Ln2 + FLT(c MOD 7) * Ln175);
    WHILE f >= 784.0 DO f := f / 2.0 END;
    WHILE f < 392.0 DO f := f * 2.0 END;
    x := 12.0 * Math.ln(f / 261.63) / Ln2; m := FLOOR(x + 0.5); bd := 99.0; best := m;
    FOR d := -2 TO 2 DO
      k := (m + d) MOD 12;
      IF ((k = 0) OR (k = 2) OR (k = 4) OR (k = 7) OR (k = 9)) & (ABS(FLT(m + d) - x) < bd) THEN bd := ABS(FLT(m + d) - x); best := m + d END
    END;
    RETURN FLOOR(261.63 * Math.exp(FLT(best) / 12.0 * Ln2) + 0.5)
  END Nota;

  (* culoarea unui tronson: x = rosu, y = verde, z = albastru, dar vie (fara negru) *)
  PROCEDURE ZonaCul(c: INTEGER; VAR r, g, b: INTEGER);
  BEGIN r := 50 + (c DIV 49) * 34; g := 50 + ((c DIV 7) MOD 7) * 34; b := 50 + (c MOD 7) * 34
  END ZonaCul;

  PROCEDURE Nuanta(r, g, b, p: INTEGER): INTEGER;   (* culoarea la p la suta din lumina *)
    VAR rr, gg, bb: INTEGER;
  BEGIN rr := r * p DIV 100; gg := g * p DIV 100; bb := b * p DIV 100;
    IF rr > 255 THEN rr := 255 END; IF gg > 255 THEN gg := 255 END; IF bb > 255 THEN bb := 255 END;
    RETURN Ecran.RGB(rr, gg, bb)
  END Nuanta;

  (* ---------- tobele: facute o data, la pornire ---------- *)

  PROCEDURE Zg(): REAL;
  BEGIN zs := (zs * 75 + 74) MOD 65537; RETURN FLT(zs) / 32768.0 - 1.0
  END Zg;

  PROCEDURE Coada(VAR b: ARRAY OF REAL; n: INTEGER);   (* ultimele 600 de esantioane se sting *)
    VAR k: INTEGER;
  BEGIN FOR k := 0 TO 599 DO b[n - 600 + k] := b[n - 600 + k] * FLT(600 - k) / 600.0 END
  END Coada;

  PROCEDURE FaTobe;
    VAR i: INTEGER; tt, ph, f, n0, n1: REAL;
  BEGIN
    ph := 0.0;   (* toba mare: un sinus care cade repede de la 155 la 45 Hz *)
    FOR i := 0 TO LKick - 1 DO
      tt := FLT(i) / 44100.0; f := 45.0 + 110.0 * Math.exp(-tt * 28.0); ph := ph + 6.2832 * f / 44100.0;
      kick[i] := 15000.0 * Math.sin(ph) * Math.exp(-tt * 9.0);
      IF i < 80 THEN kick[i] := kick[i] + 3000.0 * Zg() * FLT(80 - i) / 80.0 END
    END;
    Coada(kick, LKick);
    n0 := 0.0;   (* toba mica: un ton scurt si zgomot *)
    FOR i := 0 TO LSnare - 1 DO
      tt := FLT(i) / 44100.0; n1 := Zg();
      snare[i] := 5000.0 * Math.sin(6.2832 * 190.0 * tt) * Math.exp(-tt * 35.0) + 7000.0 * (n1 - 0.6 * n0) * Math.exp(-tt * 20.0);
      n0 := n1
    END;
    Coada(snare, LSnare);
    n0 := 0.0;   (* cinelul: zgomot ascutit, foarte scurt *)
    FOR i := 0 TO LHat - 1 DO
      tt := FLT(i) / 44100.0; n1 := Zg();
      hat[i] := 4500.0 * (n1 - n0) * Math.exp(-tt * 85.0); n0 := n1
    END;
    Coada(hat, LHat);
    ph := 0.0;   (* toba joasa, pentru bifurcatii *)
    FOR i := 0 TO LTom - 1 DO
      tt := FLT(i) / 44100.0; f := 95.0 + 70.0 * Math.exp(-tt * 18.0); ph := ph + 6.2832 * f / 44100.0;
      tom[i] := 11000.0 * Math.sin(ph) * Math.exp(-tt * 8.0)
    END;
    Coada(tom, LTom)
  END FaTobe;

  (* muzica: o bucata de jumatate de masura (8 saisprezecimi) scrisa intr-un buffer si cantata dintr-o data;
     doua buffere, pe rand, ca sa nu scriu peste cel care inca suna *)
  PROCEDURE Adauga(VAR src: ARRAY OF REAL; n, la, lung: INTEGER; g: REAL);
    VAR k, m: INTEGER;
  BEGIN m := n; IF la + m > lung THEN m := lung - la END;
    FOR k := 0 TO m - 1 DO bara[bb, la + k] := bara[bb, la + k] + g * src[k] END
  END Adauga;

  PROCEDURE Ton(f, g: REAL; la, n, lung: INTEGER);   (* o nota calda: fundamentala si octava, care se stinge *)
    VAR k, m, i1, i2: INTEGER; p, dp, e, ke, a: REAL;
  BEGIN m := n; IF la + m > lung THEN m := lung - la END;
    p := 0.0; dp := f * 4096.0 / 44100.0; e := g; ke := Math.exp(-5.0 / 44100.0);
    FOR k := 0 TO m - 1 DO
      i1 := FLOOR(p) MOD 4096; i2 := (2 * FLOOR(p)) MOD 4096;
      IF k < 120 THEN a := FLT(k) / 120.0 ELSIF k > m - 300 THEN a := FLT(m - k) / 300.0 ELSE a := 1.0 END;
      bara[bb, la + k] := bara[bb, la + k] + e * a * (tabSin[i1] + 0.35 * tabSin[i2]);
      p := p + dp; IF p >= 4096.0 THEN p := p - 4096.0 END;
      e := e * ke
    END
  END Ton;

  (* nivelul creste cu progresul: 0 toba mare + cinel + bas, 1 toba mica + cvinta, 2 arpegiu, 3 mai des,
     4 (cand prinzi 5 la rand) tot setul *)
  PROCEDURE FaBara(pasN: INTEGER): INTEGER;
    VAR lung, s, s16, k: INTEGER; rad: REAL;
  BEGIN
    bb := jum MOD 2; lung := 8 * pasN; IF lung > LBar THEN lung := LBar; pasN := LBar DIV 8 END;
    FOR k := 0 TO lung - 1 DO bara[bb, k] := 0.0 END;
    nivel := prinse DIV 6; IF nivel > 3 THEN nivel := 3 END; IF combo >= 5 THEN INC(nivel) END;
    rad := FLT(Nota(zona)) / 4.0;
    FOR s := 0 TO 7 DO
      s16 := (jum MOD 2) * 8 + s; k := s * pasN;
      IF (s16 = 0) OR (s16 = 8) OR (nivel >= 3) & (s16 = 10) OR (nivel >= 4) & ((s16 = 3) OR (s16 = 6)) THEN
        Adauga(kick, LKick, k, lung, 1.0)
      END;
      IF (nivel >= 1) & ((s16 = 4) OR (s16 = 12)) THEN Adauga(snare, LSnare, k, lung, 0.75) END;
      IF (nivel >= 4) & (s16 = 15) THEN Adauga(snare, LSnare, k, lung, 0.3) END;
      IF s MOD 2 = 0 THEN Adauga(hat, LHat, k, lung, 0.5)
      ELSIF nivel >= 3 THEN Adauga(hat, LHat, k, lung, 0.25)
      END;
      IF (s16 = 0) OR (s16 = 8) THEN Ton(rad, 6000.0, k, 4 * pasN, lung)
      ELSIF (nivel >= 1) & (s16 MOD 4 = 2) THEN Ton(rad * 1.5, 4000.0, k, 2 * pasN, lung)
      ELSIF (nivel >= 3) & (s16 MOD 4 = 3) THEN Ton(rad * 2.0, 3000.0, k, pasN, lung)
      END;
      IF (nivel >= 2) & (s MOD 2 = 0) THEN Ton(FLT(pent[(s16 DIV 2 + zona) MOD 8]), 1800.0, k, 2 * pasN, lung) END
    END;
    FOR k := 0 TO lung - 1 DO
      IF bara[bb, k] > 24000.0 THEN bara[bb, k] := 24000.0 ELSIF bara[bb, k] < -24000.0 THEN bara[bb, k] := -24000.0 END
    END;
    FOR k := 0 TO 299 DO bara[bb, lung - 300 + k] := bara[bb, lung - 300 + k] * FLT(300 - k) / 300.0 END;
    INC(jum);
    RETURN lung
  END FaBara;

  (* ---------- teava: un labirint pe tor, cu bucle ---------- *)

  PROCEDURE Sapa;
    VAR viz: ARRAY C OF BOOLEAN; st: ARRAY C OF INTEGER; opt: ARRAY 6 OF INTEGER; n, c, k, m, i, nb, incercari: INTEGER;
  BEGIN
    FOR c := 0 TO C - 1 DO viz[c] := FALSE; FOR k := 0 TO 5 DO deschis[c, k] := FALSE END END;
    st[0] := Celula(3, 3, 3); viz[st[0]] := TRUE; n := 1;
    WHILE n > 0 DO
      c := st[n - 1]; m := 0;
      FOR k := 0 TO 5 DO IF ~viz[Vecin(c, k)] THEN opt[m] := k; INC(m) END END;
      IF m = 0 THEN DEC(n)
      ELSE
        k := opt[Nr(m)]; nb := Vecin(c, k);
        deschis[c, k] := TRUE; deschis[nb, opus[k]] := TRUE; viz[nb] := TRUE; st[n] := nb; INC(n)
      END
    END;
    i := 0; incercari := 0;
    WHILE (i < Bucle) & (incercari < 5000) DO
      INC(incercari); c := Nr(C); k := Nr(6);
      IF ~deschis[c, k] THEN nb := Vecin(c, k); deschis[c, k] := TRUE; deschis[nb, opus[k]] := TRUE; INC(i) END
    END
  END Sapa;

  (* directia aleasa la un nod, venind pe directia `din`: drept inainte daca nu inclini, altfel unde inclini *)
  PROCEDURE Alege(c, din: INTEGER): INTEGER;
    VAR k, best, rx, ry, rz, ux, uy, uz: INTEGER; s, bs: REAL;
  BEGIN
    (* sus-ul tevii: cerul (y), sau z cand mergi pe verticala; dreapta = inainte x sus *)
    IF dY[din] # 0 THEN ux := 0; uy := 0; uz := 1 ELSE ux := 0; uy := 1; uz := 0 END;
    rx := dY[din] * uz - dZ[din] * uy; ry := dZ[din] * ux - dX[din] * uz; rz := dX[din] * uy - dY[din] * ux;
    best := -1; bs := -1.0E9;
    FOR k := 0 TO 5 DO
      IF deschis[c, k] & (k # opus[din]) THEN
        s := 0.6 * FLT(dX[k] * dX[din] + dY[k] * dY[din] + dZ[k] * dZ[din])
           + 1.4 * (FLT(dX[k]) * pvx + FLT(dY[k]) * pvy + FLT(dZ[k]) * pvz);   (* spre peretele pe care esti *)
        IF s > bs THEN bs := s; best := k END
      END
    END;
    IF best < 0 THEN best := opus[din] END;   (* fundatura: te intorci *)
    RETURN best
  END Alege;

  PROCEDURE Iesiri(c, din: INTEGER): INTEGER;
    VAR k, n: INTEGER;
  BEGIN n := 0; FOR k := 0 TO 5 DO IF deschis[c, k] & (k # opus[din]) THEN INC(n) END END;
    RETURN n
  END Iesiri;

  (* notele de pe pereti: pe segmentul care pleaca din nodul c pe directia k sta (sau nu) o nota, intr-unul din
     cele 8 locuri de pe cercul tevii. Intoarce locul 0..7 sau -1 *)
  PROCEDURE NotaPe(c, k: INTEGER): INTEGER;
    VAR h, r: INTEGER;
  BEGIN h := (c * 7 + k * 13 + c DIV 7) MOD 11;
    IF h < 6 THEN r := (c + k * 3 + c DIV 49) MOD 8 ELSE r := -1 END;
    RETURN r
  END NotaPe;

  PROCEDURE Unghi(s: INTEGER): REAL;   (* culoarul notei s pe podea: -70 .. +70 de grade, din 20 in 20 *)
  BEGIN RETURN (FLT(s) - 3.5) * 0.349066
  END Unghi;

  PROCEDURE Prinde(c, k: INTEGER);   (* treci prin mijlocul segmentului: ai prins nota de acolo? *)
    VAR s, f: INTEGER; th: REAL;
  BEGIN
    s := NotaPe(c, k);
    IF (s >= 0) & ~luat[c, k] THEN
      th := phi - Unghi(s);
      IF th > 3.14159 THEN th := th - 6.28318 ELSIF th < -3.14159 THEN th := th + 6.28318 END;
      IF ABS(th) < 0.32 THEN   (* bila e pe culoarul notei *)
        luat[c, k] := TRUE; INC(prinse); INC(combo); prinsDin := Sunet.Ms(); prinsSlot := s;
        f := pent[s]; Sunet.Nota(f, 700, 75);
        f := pent[s] * 3 DIV 2; Sunet.Nota(f, 500, 25);
        IF combo MOD 7 = 0 THEN f := pent[s] * 2; Sunet.Nota(f, 900, 45) END   (* sapte la rand: o octava in plus *)
      ELSE INC(ratate); combo := 0; ratatDin := Sunet.Ms(); f := pent[s]; Sunet.Nota(f, 300, 10)   (* ratata: se aude in soapta *)
      END
    END
  END Prinde;

  (* drumul din fata: de la nodul de plecare, pe directia de acum, apoi cum ai alege daca ai tine telefonul asa *)
  PROCEDURE Prevede;
    VAR i, c, d: INTEGER;
  BEGIN
    pX[0] := 0; pY[0] := 0; pZ[0] := 0; pNod[0] := nod; c := nod; d := dir; pN := 1;
    FOR i := 1 TO Inainte DO
      c := Vecin(c, d);
      pX[i] := pX[i - 1] + dX[d]; pY[i] := pY[i - 1] + dY[d]; pZ[i] := pZ[i - 1] + dZ[d]; pNod[i] := c; INC(pN);
      IF i = 1 THEN d := urm ELSE d := Alege(c, d) END
    END
  END Prevede;

  PROCEDURE Pas(dt: REAL; acum: INTEGER);
    VAR a, th, tOld, bpm: REAL; c, n, f, nx: INTEGER;
  BEGIN
    IF gravitatie THEN   (* cat de mult e rasucit telefonul: acolo e jos, acolo se duce bila *)
      gfx := gfx + (FLT(Senzor.GX()) - gfx) * 0.25; gfy := gfy + (FLT(Senzor.GY()) - gfy) * 0.25;
      gfz := gfz + (FLT(Senzor.GZ()) - gfz) * 0.25;
      th := Math.arctan2(-gfx, Math.sqrt(gfy * gfy + gfz * gfz)) - al0;   (* stanga-dreapta *)
      IF th > 0.06 THEN th := th - 0.06 ELSIF th < -0.06 THEN th := th + 0.06 ELSE th := 0.0 END;   (* zona moarta *)
      tinta := 4.5 * th;   (* viteza de rotire pe cerc, in radiani pe secunda *)
      IF tinta > 5.0 THEN tinta := 5.0 ELSIF tinta < -5.0 THEN tinta := -5.0 END;
      th := Math.arctan2(gfz, gfy) - pa0;   (* inainte-inapoi: varful de la tine = da-i viteza *)
      IF th > 0.05 THEN vtinta := (th - 0.05) * 12.0 ELSE vtinta := 0.0 END;
      IF vtinta > 5.0 THEN vtinta := 5.0 END
    END;
    th := 10.0 * dt; IF th > 1.0 THEN th := 1.0 END;
    omega := omega + (tinta - omega) * th;   (* volanul: bila se tot invarte cat timp tii inclinat *)
    phi := phi + omega * dt;
    IF phi > 3.14159 THEN phi := phi - 6.28318 ELSIF phi < -3.14159 THEN phi := phi + 6.28318 END;
    urm := Alege(Vecin(nod, dir), dir);
    IF merge THEN
      a := 6.0 * (vtinta - v);   (* tu dai viteza; panta doar te impinge putin *)
      IF dY[dir] < 0 THEN a := a + 0.6 ELSIF dY[dir] > 0 THEN a := a - 0.6 END;
      v := v + a * dt; IF v < 0.0 THEN v := 0.0 ELSIF v > 6.0 THEN v := 6.0 END;
      IF (vtinta = 0.0) & (v < 0.15) THEN v := 0.0 END;
      rola := rola + v * dt * 6.0;
      IF acum >= barEnd - 30 THEN   (* bucata urmatoare de muzica, lipita de cea dinainte *)
        bpm := 92.0 + v * 14.0; IF bpm > 168.0 THEN bpm := 168.0 END;
        n := FaBara(FLOOR(44100.0 * 15.0 / bpm)); Sunet.RedaPan(bara[bb], n, 70, 0);
        IF acum - barEnd > 300 THEN barEnd := acum END;
        barEnd := barEnd + n * 10 DIV 441
      END;
      tOld := t; t := t + v * dt;
      IF (tOld < 0.3) & (t >= 0.3) THEN Prinde(nod, dir) END;   (* bila e cu 0,2 in fata camerei *)
      WHILE t >= 1.0 DO
        t := t - 1.0; c := Vecin(nod, dir); n := Iesiri(c, dir);
        f := Nota(c) DIV 2; Sunet.Nota(f, 1200, 14);   (* isonul: nota nodului, jos si incet *)
        sclipire := acum; INC(noduri);
        IF n = 0 THEN Sunet.Nota(110, 200, 45)   (* fundatura: bufnet, te intorci *)
        ELSIF n > 1 THEN INC(bifurcatii)
        END;
        prevDir := dir; dir := Alege(c, dir); nod := c;
        IF n > 1 THEN   (* bifurcatie: intri in culoarea ramurii alese, cu o toba joasa *)
          zonaVeche := zona; zona := Vecin(c, dir); zonaLa := c; Sunet.RedaPan(tom, LTom, 55, 0)
        END;
        urm := Alege(Vecin(nod, dir), dir);
        IF t >= 0.3 THEN Prinde(nod, dir) END;
        nx := Vecin(nod, dir);
        IF Iesiri(nx, dir) > 1 THEN f := Nota(nx) * 2; Sunet.Nota(f, 90, 18) END   (* vine o bifurcatie: un clinchet *)
      END
    END
  END Pas;

  (* ---------- desenul: tunelul in perspectiva ---------- *)

  (* centrul tevii: la fiecare nod i, cotul e o curba (Bezier) de la mijlocul segmentului dinainte la mijlocul celui
     de dupa, cu nodul ca punct de control; u = 0..1. Intoarce punctul si directia (tangenta, normata) *)
  PROCEDURE Curba(i: INTEGER; u: REAL; VAR qx, qy, qz, tx, ty, tz: REAL);
    VAR ax, ay, az, bx, by, bz, px, py, pz, l: REAL;
  BEGIN
    px := FLT(pX[i]); py := FLT(pY[i]); pz := FLT(pZ[i]);
    IF i = 0 THEN ax := px - 0.5 * FLT(dX[prevDir]); ay := py - 0.5 * FLT(dY[prevDir]); az := pz - 0.5 * FLT(dZ[prevDir])
    ELSE ax := (FLT(pX[i - 1]) + px) * 0.5; ay := (FLT(pY[i - 1]) + py) * 0.5; az := (FLT(pZ[i - 1]) + pz) * 0.5
    END;
    bx := (FLT(pX[i + 1]) + px) * 0.5; by := (FLT(pY[i + 1]) + py) * 0.5; bz := (FLT(pZ[i + 1]) + pz) * 0.5;
    qx := (1.0 - u) * (1.0 - u) * ax + 2.0 * u * (1.0 - u) * px + u * u * bx;
    qy := (1.0 - u) * (1.0 - u) * ay + 2.0 * u * (1.0 - u) * py + u * u * by;
    qz := (1.0 - u) * (1.0 - u) * az + 2.0 * u * (1.0 - u) * pz + u * u * bz;
    tx := 2.0 * (1.0 - u) * (px - ax) + 2.0 * u * (bx - px);
    ty := 2.0 * (1.0 - u) * (py - ay) + 2.0 * u * (by - py);
    tz := 2.0 * (1.0 - u) * (pz - az) + 2.0 * u * (bz - pz);
    l := Math.sqrt(tx * tx + ty * ty + tz * tz); IF l < 0.0001 THEN l := 0.0001 END;
    tx := tx / l; ty := ty / l; tz := tz / l
  END Curba;

  (* doua directii perpendiculare pe tangenta (inelul tevii): a = dreapta, b = sus *)
  PROCEDURE Baza(tx, ty, tz: REAL; VAR ax, ay, az, bx, by, bz: REAL);
    VAR wx, wy, wz, l: REAL;
  BEGIN
    IF ABS(ty) > 0.7 THEN wx := 0.0; wy := 0.0; wz := 1.0 ELSE wx := 0.0; wy := 1.0; wz := 0.0 END;
    ax := ty * wz - tz * wy; ay := tz * wx - tx * wz; az := tx * wy - ty * wx;
    l := Math.sqrt(ax * ax + ay * ay + az * az); ax := ax / l; ay := ay / l; az := az / l;
    bx := ay * tz - az * ty; by := az * tx - ax * tz; bz := ax * ty - ay * tx
  END Baza;

  PROCEDURE Centru(s0: REAL; VAR qx, qy, qz, tx, ty, tz: REAL);   (* punctul de pe centrul tevii, s0 noduri dupa nod *)
    VAR i: INTEGER; u: REAL;
  BEGIN i := FLOOR(s0 + 0.5); IF i < 0 THEN i := 0 ELSIF i > Inainte - 2 THEN i := Inainte - 2 END;
    u := s0 + 0.5 - FLT(i); Curba(i, u, qx, qy, qz, tx, ty, tz)
  END Centru;

  PROCEDURE DirIdx(i: INTEGER): INTEGER;   (* directia de la punctul i la i+1 al drumului din fata *)
    VAR k: INTEGER;
  BEGIN k := 0;
    WHILE (k < 5) & ((dX[k] # pX[i + 1] - pX[i]) OR (dY[k] # pY[i + 1] - pY[i]) OR (dZ[k] # pZ[i + 1] - pZ[i])) DO INC(k) END;
    RETURN k
  END DirIdx;

  PROCEDURE Cadru*;
    CONST P = 16;   (* puncte pe un inel *)
    VAR w, h, d, acum, i, j, k, a, cx, cy, n, cul, pr, r: INTEGER; dt, F, u, ox, oy, oz, fx, fy, fz, rx, ry, rz, ux, uy, uz,
      qx, qy, qz, tx, ty, tz, ax, ay, az, bx, by, bz, x, y, z, ex, ey, ez, cs, sn, dd: REAL; bun: BOOLEAN;
      ix, iy, sh: ARRAY 36, P OF INTEGER; viu: ARRAY 36 OF BOOLEAN; cr, cg, cb, pk, par: ARRAY 36 OF INTEGER;
      gxs, gys: ARRAY 36 OF INTEGER; gv: ARRAY 36 OF BOOLEAN; g2x, g2y, g2z: REAL;
      tx2: ARRAY 96 OF CHAR; zc, zf, zt, fr, fg, fb, tr, tg, tb, b2, mx, my: INTEGER;
  BEGIN
    w := Ecran.Latime(); h := Ecran.Inaltime(); d := Ecran.Densitate() DIV 100 + 1;
    acum := Sunet.Ms(); dt := FLT(acum - ultim) / 1000.0; ultim := acum; IF dt > 0.1 THEN dt := 0.1 ELSIF dt < 0.0 THEN dt := 0.0 END;
    Pas(dt, acum); Prevede;
    ZonaCul(zona, fr, fg, fb); Ecran.Fond(Nuanta(fr, fg, fb, 40));   (* peretele de langa tine *)
    cx := w DIV 2; cy := h * 36 DIV 100; F := FLT(w) * 0.7;

    (* camera: pe centrul tevii, la t; priveste de-a lungul tevii, putin in spate *)
    (* camera sta pe curba, in spatele bilei, si priveste spre un punct de dupa ea: asa nu iese prin perete in coturi *)
    Centru(t - 0.35, ox, oy, oz, fx, fy, fz); Centru(t + 0.5, qx, qy, qz, tx, ty, tz);
    fx := qx - ox; fy := qy - oy; fz := qz - oz; u := Math.sqrt(fx * fx + fy * fy + fz * fz);
    IF u > 0.01 THEN fx := fx / u; fy := fy / u; fz := fz / u ELSE fx := tx; fy := ty; fz := tz END;
    (* sus-ul camerei e purtat de-a lungul tevii, fara rasuciri: camera nu se mai roteste cu tine *)
    u := cux * fx + cuy * fy + cuz * fz; cux := cux - u * fx; cuy := cuy - u * fy; cuz := cuz - u * fz;
    u := Math.sqrt(cux * cux + cuy * cuy + cuz * cuz);
    IF u < 0.1 THEN Baza(fx, fy, fz, rx, ry, rz, cux, cuy, cuz) ELSE cux := cux / u; cuy := cuy / u; cuz := cuz / u END;
    ux := cux; uy := cuy; uz := cuz;
    rx := fy * uz - fz * uy; ry := fz * ux - fx * uz; rz := fx * uy - fy * ux;
    (* tu: unghiul phi pe cercul tevii; 0 = jos, pozitiv = spre dreapta ecranului *)
    cs := Math.cos(phi); sn := Math.sin(phi);
    pvx := -ux * cs + rx * sn; pvy := -uy * cs + ry * sn; pvz := -uz * cs + rz * sn;
    (* camera: putin in spate si putin mai sus de centru, ca bila sa stea jos pe ecran *)
    ox := ox + ux * 0.22; oy := oy + uy * 0.22; oz := oz + uz * 0.22;

    (* inelele: 4 pe fiecare cot, perpendiculare pe teava; culoarea tronsonului se schimba treptat la bifurcatii *)
    n := 0; zc := zona;
    FOR i := 0 TO pN - 2 DO
      zf := zc; zt := zc;
      IF i = 0 THEN
        IF zonaLa = pNod[0] THEN zf := zonaVeche END
      ELSIF Iesiri(pNod[i], DirIdx(i - 1)) > 1 THEN zt := pNod[i + 1]
      END;
      ZonaCul(zf, fr, fg, fb); ZonaCul(zt, tr, tg, tb);
      FOR j := 0 TO 3 DO
        IF n < 36 THEN
          u := FLT(j) / 4.0; Curba(i, u, qx, qy, qz, tx, ty, tz); Baza(tx, ty, tz, ax, ay, az, bx, by, bz);
          bun := TRUE; a := 0;
          WHILE bun & (a < P) DO
            cs := Math.cos(FLT(a) * 6.2832 / FLT(P)) * 0.42; sn := Math.sin(FLT(a) * 6.2832 / FLT(P)) * 0.42;
            x := qx + cs * ax + sn * bx - ox; y := qy + cs * ay + sn * by - oy; z := qz + cs * az + sn * bz - oz;
            ez := x * fx + y * fy + z * fz;
            IF ez < 0.12 THEN bun := FALSE
            ELSE
              ex := x * rx + y * ry + z * rz; ey := x * ux + y * uy + z * uz;
              ix[n, a] := cx + FLOOR(F * ex / ez); iy[n, a] := cy - FLOOR(F * ey / ez);
              (* lumina panoului a: podeaua luminoasa, tavanul stins (dupa camera, nu dupa bila) *)
              cs := Math.cos((FLT(a) + 0.5) * 6.2832 / FLT(P)); sn := Math.sin((FLT(a) + 0.5) * 6.2832 / FLT(P));
              dd := -((cs * ax + sn * bx) * ux + (cs * ay + sn * by) * uy + (cs * az + sn * bz) * uz);
              sh[n, a] := 62 + FLOOR(38.0 * dd)
            END;
            INC(a)
          END;
          viu[n] := bun; gv[n] := FALSE;
          (* sina: unde e bila pe inelul asta, daca tii telefonul asa *)
          dd := pvx * tx + pvy * ty + pvz * tz; g2x := pvx - dd * tx; g2y := pvy - dd * ty; g2z := pvz - dd * tz;
          dd := Math.sqrt(g2x * g2x + g2y * g2y + g2z * g2z);
          IF dd > 0.1 THEN
            g2x := qx + 0.39 * g2x / dd - ox; g2y := qy + 0.39 * g2y / dd - oy; g2z := qz + 0.39 * g2z / dd - oz;
            dd := g2x * fx + g2y * fy + g2z * fz;
            IF dd > 0.8 THEN
              gv[n] := TRUE; gxs[n] := cx + FLOOR(F * (g2x * rx + g2y * ry + g2z * rz) / dd); gys[n] := cy - FLOOR(F * (g2x * ux + g2y * uy + g2z * uz) / dd)
            END
          END;
          IF bun THEN
            z := (qx - ox) * fx + (qy - oy) * fy + (qz - oz) * fz;
            pr := 100 - FLOOR(z * 9.0); IF pr < 15 THEN pr := 15 END;
            pk[n] := pr; par[n] := (i * 4 + j) MOD 2;
            cr[n] := (fr * (4 - j) + tr * j) DIV 4; cg[n] := (fg * (4 - j) + tg * j) DIV 4; cb[n] := (fb * (4 - j) + tb * j) DIV 4
          END;
          INC(n)
        END
      END;
      zc := zt
    END;
    (* lumina de la capatul tevii, in culoarea tronsonului de acolo *)
    k := n - 1; WHILE (k > 0) & ~viu[k] DO DEC(k) END;
    IF (k >= 0) & viu[k] THEN
      mx := 0; my := 0; FOR a := 0 TO P - 1 DO mx := mx + ix[k, a]; my := my + iy[k, a] END;
      mx := mx DIV P; my := my DIV P;
      Ecran.Culoare(Nuanta(cr[k] + 70, cg[k] + 70, cb[k] + 70, 100));
      FOR a := 0 TO P - 1 DO b2 := (a + 1) MOD P; Ecran.Triunghi(mx, my, ix[k, a], iy[k, a], ix[k, b2], iy[k, b2]) END
    END;
    (* peretii plini, de la cei departati la cei apropiati, cu linii fine de-a lungul tevii *)
    FOR k := n - 2 TO 0 BY -1 DO
      IF viu[k] & viu[k + 1] THEN
        FOR a := 0 TO P - 1 DO
          b2 := (a + 1) MOD P;
          Ecran.Culoare(Nuanta(cr[k], cg[k], cb[k], pk[k] * sh[k, a] DIV 100));
          Ecran.Triunghi(ix[k, a], iy[k, a], ix[k, b2], iy[k, b2], ix[k + 1, b2], iy[k + 1, b2]);
          Ecran.Triunghi(ix[k, a], iy[k, a], ix[k + 1, b2], iy[k + 1, b2], ix[k + 1, a], iy[k + 1, a])
        END;
        Ecran.Culoare(Nuanta(cr[k] + 60, cg[k] + 60, cb[k] + 60, pk[k] * 55 DIV 100)); Ecran.Grosime(1);
        FOR a := 0 TO P - 1 DO Ecran.Linie(ix[k, a], iy[k, a], ix[k + 1, a], iy[k + 1, a]) END
      END
    END;
    (* bifurcatiile din fata: o gura intunecata in perete, cu marginea in culoarea ramurii *)
    FOR i := 1 TO pN - 2 DO
      FOR k := 0 TO 5 DO
        IF deschis[pNod[i], k] & ((pX[i + 1] - pX[i] # dX[k]) OR (pY[i + 1] - pY[i] # dY[k]) OR (pZ[i + 1] - pZ[i] # dZ[k]))
           & ((pX[i - 1] - pX[i] # dX[k]) OR (pY[i - 1] - pY[i] # dY[k]) OR (pZ[i - 1] - pZ[i] # dZ[k])) THEN
          x := FLT(pX[i]) + FLT(dX[k]) * 0.42 - ox; y := FLT(pY[i]) + FLT(dY[k]) * 0.42 - oy; z := FLT(pZ[i]) + FLT(dZ[k]) * 0.42 - oz;
          ez := x * fx + y * fy + z * fz;
          IF ez > 0.7 THEN   (* aproape de tine gura nu se mai deseneaza *)
            r := FLOOR(F * 0.16 / ez); IF r < 3 THEN r := 3 ELSIF r > 16 * d THEN r := 16 * d END;
            mx := cx + FLOOR(F * (x * rx + y * ry + z * rz) / ez); my := cy - FLOOR(F * (x * ux + y * uy + z * uz) / ez);
            ZonaCul(Vecin(pNod[i], k), fr, fg, fb);
            Ecran.Culoare(Nuanta(fr, fg, fb, 22)); Ecran.Disc(mx, my, r);
            Ecran.Culoare(Nuanta(fr + 40, fg + 40, fb + 40, 100)); Ecran.Grosime(2 * d); Ecran.Cerc(mx, my, r)
          END
        END
      END
    END;

    (* sina de puncte din fata bilei *)
    FOR k := n - 1 TO 0 BY -1 DO
      IF gv[k] & (k MOD 2 = 0) THEN
        Ecran.Culoare(Nuanta(cr[k] + 120, cg[k] + 120, cb[k] + 120, 45 + pk[k] DIV 2));
        Ecran.Disc(gxs[k], gys[k], 1 + d * pk[k] DIV 60)
      END
    END;
    (* notele: clape pe podea, in culoarul lor (unghiul fata de jos-ul camerei), cele departate intai *)
    FOR i := pN - 2 TO 0 BY -1 DO
      k := DirIdx(i);
      a := NotaPe(pNod[i], k);
      IF (a >= 0) & ~luat[pNod[i], k] THEN
        Curba(i, 1.0, qx, qy, qz, tx, ty, tz);
        cs := Math.cos(Unghi(a)); sn := Math.sin(Unghi(a));
        ax := -ux * cs + rx * sn; ay := -uy * cs + ry * sn; az := -uz * cs + rz * sn;
        dd := ax * tx + ay * ty + az * tz; ax := ax - dd * tx; ay := ay - dd * ty; az := az - dd * tz;
        dd := Math.sqrt(ax * ax + ay * ay + az * az); IF dd < 0.1 THEN dd := 0.1 END;
        x := qx + 0.36 * ax / dd - ox; y := qy + 0.36 * ay / dd - oy; z := qz + 0.36 * az / dd - oz;
        ez := x * fx + y * fy + z * fz;
        IF ez > 0.15 THEN
          r := FLOOR(F * 0.08 / ez); IF r < 2 THEN r := 2 ELSIF r > 30 * d THEN r := 30 * d END;
          ex := FLT(cx) + F * (x * rx + y * ry + z * rz) / ez; ey := FLT(cy) - F * (x * ux + y * uy + z * uz) / ez;
          Ecran.Culoare(Ecran.RGB(10, 8, 14)); Ecran.Disc(FLOOR(ex), FLOOR(ey), r + 1 + r DIV 6);
          Ecran.Culoare(slotCul[a]); Ecran.Disc(FLOOR(ex), FLOOR(ey), r);
          Ecran.Culoare(Ecran.RGB(255, 255, 255)); Ecran.Disc(FLOOR(ex), FLOOR(ey), r DIV 3)
        END
      END
    END;
    (* bila: pe peretele tevii, putin in fata camerei; ea se misca, teava sta *)
    u := t + 0.7;   (* bila e cu 0,2 noduri in fata, pe curba adevarata a tevii *)
    IF u < 1.0 THEN Curba(0, u, qx, qy, qz, tx, ty, tz) ELSIF u < 2.0 THEN Curba(1, u - 1.0, qx, qy, qz, tx, ty, tz)
    ELSE Curba(2, u - 2.0, qx, qy, qz, tx, ty, tz) END;
    u := pvx * tx + pvy * ty + pvz * tz; ax := pvx - u * tx; ay := pvy - u * ty; az := pvz - u * tz;
    u := Math.sqrt(ax * ax + ay * ay + az * az); IF u < 0.1 THEN u := 0.1 END;
    x := qx + 0.335 * ax / u - ox; y := qy + 0.335 * ay / u - oy; z := qz + 0.335 * az / u - oz;
    ez := x * fx + y * fy + z * fz; IF ez < 0.2 THEN ez := 0.2 END; ex := FLT(cx) + F * (x * rx + y * ry + z * rz) / ez; ey := FLT(cy) - F * (x * ux + y * uy + z * uz) / ez;
    r := FLOOR(F * 0.085 / ez); mx := FLOOR(ex); my := FLOOR(ey);
    (* culoarea bilei: opusa tevii, ca sa se vada mereu *)
    ZonaCul(zona, fr, fg, fb); fr := 255 - fr; fg := 255 - fg; fb := 255 - fb;
    IF fr + fg + fb < 300 THEN fr := (fr + 255) DIV 2; fg := (fg + 255) DIV 2; fb := (fb + 255) DIV 2 END;
    IF acum - prinsDin < 250 THEN fr := 255; fg := 255; fb := 255 END;   (* cand prinzi o nota, se aprinde *)
    Ecran.Culoare(Ecran.RGB(10, 8, 14)); Ecran.Disc(mx, my, r + 3 * d);
    IF acum - prinsDin < 250 THEN Ecran.Culoare(slotCul[prinsSlot]); Ecran.Disc(mx, my, r + 2 * d) END;
    Ecran.Culoare(Nuanta(fr, fg, fb, 65)); Ecran.Disc(mx, my, r);
    Ecran.Culoare(Nuanta(fr, fg, fb, 100)); Ecran.Disc(mx - r DIV 8, my - r DIV 8, r * 80 DIV 100);
    Ecran.Culoare(Nuanta(fr + 80, fg + 80, fb + 80, 100)); Ecran.Disc(mx - r * 3 DIV 10, my - r * 3 DIV 10, r DIV 4);

    (* sus: ce e *)
    Ecran.Culoare(Ecran.RGB(6, 4, 10)); Ecran.Dreptunghi(0, 0, w, 96 * d);
    Ecran.Culoare(aur); Ecran.Text(w DIV 2, 30 * d, 17 * d, "CUB ROLLER");
    Ecran.Culoare(Ecran.RGB(239, 68, 68)); Ecran.Disc(w - 30 * d, 30 * d, 16 * d);   (* X: inapoi in cub *)
    Ecran.Culoare(Ecran.RGB(255, 255, 255)); Ecran.Text(w - 30 * d, 36 * d, 16 * d, "✕");
    cul := Vecin(nod, dir);
    tx2 := "nod ("; Strings.AppendInt(cul DIV 49 + 1, 0, tx2); Strings.Append(",", tx2); Strings.AppendInt((cul DIV 7) MOD 7 + 1, 0, tx2);
    Strings.Append(",", tx2); Strings.AppendInt(cul MOD 7 + 1, 0, tx2); Strings.Append(")   ", tx2); Strings.AppendInt(Nota(cul), 0, tx2); Strings.Append(" Hz", tx2);
    Ecran.Culoare(Culoare(cul, 100)); Ecran.Dreptunghi(w DIV 2 - 120 * d, 44 * d, 12 * d, 12 * d);
    Ecran.Culoare(Ecran.RGB(232, 216, 150)); Ecran.Text(w DIV 2, 54 * d, 13 * d, tx2);
    tx2 := "prinse "; Strings.AppendInt(prinse, 0, tx2); Strings.Append("  ratate ", tx2); Strings.AppendInt(ratate, 0, tx2);
    Strings.Append("  la rand ", tx2); Strings.AppendInt(combo, 0, tx2);
    Strings.Append("  tobe ", tx2); Strings.AppendInt(nivel, 0, tx2);
    IF dY[dir] < 0 THEN Strings.Append("   coboara", tx2) ELSIF dY[dir] > 0 THEN Strings.Append("   urca", tx2) END;
    Ecran.Culoare(stins); Ecran.Text(w DIV 2, 76 * d, 11 * d, tx2);
    IF acum - sclipire < 150 THEN Ecran.Culoare(Culoare(nod, 100)); Ecran.Dreptunghi(0, 94 * d, w, 2 * d) END;
    (* jos *)
    Ecran.Culoare(stins);
    IF merge THEN Ecran.Text(w DIV 2, h - 40 * d, 12 * d, "stanga-dreapta: bila   varful de la tine: viteza")
    ELSE Ecran.Culoare(aur); Ecran.Text(w DIV 2, h - 40 * d, 15 * d, "atinge ca sa pornesti");
      Ecran.Culoare(stins); Ecran.Text(w DIV 2, h - 62 * d, 11 * d, "la o bifurcatie bila o ia spre peretele pe care e")
    END;
    Ecran.Culoare(stins); Ecran.Text(w DIV 2, h - 18 * d, 10 * d, "atinge: pauza     atinge sus: aici e drept")
  END Cadru;

  PROCEDURE Atingere*;
    VAR a: BOOLEAN; d: INTEGER;
  BEGIN
    a := Ecran.Apasat(); d := Ecran.Densitate() DIV 100 + 1;
    IF a & ~inainte THEN
      IF (Ecran.AtinsY() < 70 * d) & (Ecran.AtinsX() > Ecran.Latime() - 70 * d) THEN merge := FALSE; iesit := TRUE
      ELSIF Ecran.AtinsY() < 96 * d THEN al0 := Math.arctan2(-gfx, Math.sqrt(gfy * gfy + gfz * gfz)); pa0 := Math.arctan2(gfz, gfy); Sunet.Nota(523, 150, 30)
      ELSE merge := ~merge
      END
    END;
    inainte := a
  END Atingere;

  (* o tura noua: alt labirint (samanta din ceas), scorul de la zero, telefonul de acum e "drept" *)
  PROCEDURE Porneste*;
  BEGIN
    seed := 343 + Sunet.Ms() MOD 60000; Sapa;
    nod := Celula(3, 3, 3); dir := 0; WHILE ~deschis[nod, dir] DO INC(dir) END;
    t := 0.0; v := 0.0; merge := FALSE; inainte := Ecran.Apasat(); iesit := FALSE;
    noduri := 0; bifurcatii := 0; sclipire := -1000;
    prinse := 0; ratate := 0; combo := 0; prinsDin := -1000; prinsSlot := 0; ratatDin := -1000;
    FOR i := 0 TO C - 1 DO FOR j := 0 TO 5 DO luat[i, j] := FALSE END END;
    ultim := Sunet.Ms(); urm := dir; prevDir := dir;
    zona := Vecin(nod, dir); zonaVeche := zona; zonaLa := -1;
    nivel := 0; barEnd := 0; jum := 0; phi := 0.0; tinta := 0.0; rola := 0.0; omega := 0.0;
    IF dY[dir] # 0 THEN cux := 0.0; cuy := 0.0; cuz := 1.0 ELSE cux := 0.0; cuy := 1.0; cuz := 0.0 END;
    IF gravitatie THEN gfx := FLT(Senzor.GX()); gfy := FLT(Senzor.GY()); gfz := FLT(Senzor.GZ()) END;
    al0 := Math.arctan2(-gfx, Math.sqrt(gfy * gfy + gfz * gfz)); pa0 := Math.arctan2(gfz, gfy); vtinta := 0.0;
    Sunet.Reverb(45)
  END Porneste;

BEGIN
  dX[0] := 1; dY[0] := 0; dZ[0] := 0;  dX[1] := -1; dY[1] := 0; dZ[1] := 0;
  dX[2] := 0; dY[2] := 1; dZ[2] := 0;  dX[3] := 0; dY[3] := -1; dZ[3] := 0;
  dX[4] := 0; dY[4] := 0; dZ[4] := 1;  dX[5] := 0; dY[5] := 0; dZ[5] := -1;
  opus[0] := 1; opus[1] := 0; opus[2] := 3; opus[3] := 2; opus[4] := 5; opus[5] := 4;
  aur := Ecran.RGB(201, 168, 94); stins := Ecran.RGB(150, 128, 84);
  seed := 343; Sapa;
  nod := Celula(3, 3, 3); dir := 0; WHILE ~deschis[nod, dir] DO INC(dir) END;
  t := 0.0; v := 0.0; merge := FALSE; inainte := FALSE; tiltX := 0.0; tiltY := 0.0;
  noduri := 0; bifurcatii := 0; sclipire := -1000; notaDin := 0;
  prinse := 0; ratate := 0; combo := 0; prinsDin := -1000; prinsSlot := 0; ratatDin := -1000;
  FOR i := 0 TO C - 1 DO FOR j := 0 TO 5 DO luat[i, j] := FALSE END END;
  IF dY[dir] # 0 THEN pvx := 0.0; pvy := 0.0; pvz := -1.0 ELSE pvx := 0.0; pvy := -1.0; pvz := 0.0 END;   (* incepi jos *)
  pent[0] := 392; pent[1] := 440; pent[2] := 523; pent[3] := 587; pent[4] := 659; pent[5] := 784; pent[6] := 880; pent[7] := 1047;
  slotCul[0] := Ecran.RGB(255, 90, 90); slotCul[1] := Ecran.RGB(255, 160, 60); slotCul[2] := Ecran.RGB(255, 230, 80); slotCul[3] := Ecran.RGB(120, 230, 100);
  slotCul[4] := Ecran.RGB(80, 220, 220); slotCul[5] := Ecran.RGB(90, 140, 255); slotCul[6] := Ecran.RGB(170, 100, 255); slotCul[7] := Ecran.RGB(255, 110, 210);
  gravitatie := Senzor.PornesteGravitatia(); gx0 := Senzor.GX(); gy0 := Senzor.GY();
  ultim := Sunet.Ms(); iesit := FALSE; urm := dir; prevDir := dir;
  zona := Vecin(nod, dir); zonaVeche := zona; zonaLa := -1;
  zs := 777; FaTobe; nivel := 0; pas16 := 15; ph16 := 0.99;
  FOR i := 0 TO 4095 DO tabSin[i] := Math.sin(6.2831853 * FLT(i) / 4096.0) END;
  bb := 0; barEnd := 0; jum := 0; phi := 0.0; tinta := 0.0; rola := 0.0; omega := 0.0;
  IF dY[dir] # 0 THEN cux := 0.0; cuy := 0.0; cuz := 1.0 ELSE cux := 0.0; cuy := 1.0; cuz := 0.0 END;
  gfx := FLT(Senzor.GX()); gfy := FLT(Senzor.GY()); gfz := FLT(Senzor.GZ());
  al0 := Math.arctan2(-gfx, Math.sqrt(gfy * gfy + gfz * gfz)); pa0 := Math.arctan2(gfz, gfy); vtinta := 0.0
END CubRoller.


MODULE Mesh343;  (* v2.9 (28 oct 2026): 343 de cuburi mici intr-o singura aplicatie. Fiecare cub are torul lui de 7 x 7 x 7 = 343
  celule si o Eula care tine aceeasi lege: celula (x, y, z) = (x + 2y + 3z) MOD 7. Cuburile stau si ele pe un tor 7 x 7 x 7:
  fiecare isi intreaba cei 6 vecini (un mesaj pe vecin) si isi repara celulele prin majoritate (el + 6 vecini = 7 voturi).
  Razele lovesc celule la intamplare; o atingere = o furtuna de 49 de raze. 343 x 343 = 117.649 celule = cat o tura a spiralei.
  Cubicum il cheama: Porneste, apoi Cadru la fiecare cadru si Atingere; X (dreapta sus) face iesit = TRUE.
  Pion & Claude, 28.10.2026 *)
  IMPORT Ecran, Sunet, Strings;

  CONST N = 7; C = 343; T = C * C; PeCadru = 3;   (* cate cuburi isi intreaba vecinii la fiecare cadru *)

  VAR cel: ARRAY T OF BYTE;                   (* cubul i: celulele i * 343 .. i * 343 + 342 *)
    lege: ARRAY C OF INTEGER;                 (* ce ar trebui sa fie in fiecare celula (doar pentru numaratoare) *)
    vec: ARRAY C, 6 OF INTEGER;               (* cei 6 vecini pe tor *)
    rau, lov, rep: ARRAY C OF INTEGER;        (* celule gresite, cand a fost lovit, cand s-a reparat *)
    lovite, reparate, mesaje, gresite, urm, seed, ultimRaza, ultimNota: INTEGER;
    pent: ARRAY 7 OF INTEGER;
    nz: ARRAY 7 OF ARRAY 8 OF CHAR;          (* C4: numele straturilor *)
    inainte, pauza: BOOLEAN;                  (* C5: atingi bara de sus = totul sta pe loc *)
    iesit*: BOOLEAN;

  PROCEDURE Rnd(n: INTEGER): INTEGER;
  BEGIN seed := seed * 69069 + 1; RETURN (seed DIV 65536) MOD n
  END Rnd;

  PROCEDURE Raza;   (* o celula a unui cub, la intamplare, primeste alta cifra *)
    VAR i, j, k, v: INTEGER; inainteRau, acumRau: BOOLEAN;
  BEGIN
    i := Rnd(C); j := Rnd(C); k := i * C + j;
    inainteRau := cel[k] # lege[j];
    v := (cel[k] + 1 + Rnd(6)) MOD 7; cel[k] := v;
    acumRau := v # lege[j];
    IF acumRau & ~inainteRau THEN INC(rau[i]); INC(gresite) ELSIF inainteRau & ~acumRau THEN DEC(rau[i]); DEC(gresite) END;
    lov[i] := Sunet.Ms(); INC(lovite)
  END Raza;

  PROCEDURE Verifica(i: INTEGER): BOOLEAN;   (* cubul i isi intreaba vecinii; TRUE = a reparat ceva *)
    VAR j, k, a, m, best, x: INTEGER; nr: ARRAY 7 OF INTEGER; r: BOOLEAN;
  BEGIN
    mesaje := mesaje + 6; r := FALSE;
    FOR j := 0 TO C - 1 DO
      FOR a := 0 TO 6 DO nr[a] := 0 END;
      x := cel[i * C + j]; INC(nr[x]);
      FOR k := 0 TO 5 DO INC(nr[cel[vec[i, k] * C + j]]) END;
      m := 0; best := 0; FOR a := 0 TO 6 DO IF nr[a] > best THEN best := nr[a]; m := a END END;
      IF (best >= 4) & (x # m) THEN
        IF (x # lege[j]) & (m = lege[j]) THEN DEC(rau[i]); DEC(gresite)
        ELSIF (x = lege[j]) & (m # lege[j]) THEN INC(rau[i]); INC(gresite)
        END;
        cel[i * C + j] := m; INC(reparate); r := TRUE
      END
    END;
    IF r THEN rep[i] := Sunet.Ms() END;
    RETURN r
  END Verifica;

  PROCEDURE Cadru*;
    VAR w, h, d, acum, i, k, x, y, z, px, py, s, r, sunat, ox, oy: INTEGER; t: ARRAY 96 OF CHAR;
  BEGIN
    w := Ecran.Latime(); h := Ecran.Inaltime(); d := Ecran.Densitate() DIV 100 + 1; acum := Sunet.Ms();
    sunat := -1;
    IF ~pauza THEN
      IF acum - ultimRaza >= 350 THEN ultimRaza := acum; Raza END;
      FOR k := 1 TO PeCadru DO
        IF Verifica(urm) THEN sunat := urm END;
        urm := (urm + 1) MOD C
      END
    END;
    IF (sunat >= 0) & (acum - ultimNota >= 90) THEN ultimNota := acum; Sunet.Nota(pent[sunat DIV 7 MOD 7], 140, 22) END;
    Ecran.Fond(Ecran.RGB(8, 8, 16));
    s := w DIV 24; r := s * 36 DIV 100 + 1;   (* C4: cele 7 straturi z, fiecare un patrat 7 x 7, ca sa se vada toate 343 *)
    FOR z := 0 TO N - 1 DO
      ox := (z MOD 3) * 8 * s + s DIV 2; oy := 110 * d + (z DIV 3) * 9 * s;
      IF z = 6 THEN ox := 8 * s + s DIV 2 END;
      Ecran.Culoare(Ecran.RGB(120, 120, 150)); Ecran.Text(ox + 7 * s DIV 2, oy + s DIV 2, 9 * d, nz[z]);
      FOR y := 0 TO N - 1 DO
        FOR x := 0 TO N - 1 DO
          i := x + N * y + N * N * z;
          px := ox + x * s + s DIV 2; py := oy + s + (N - 1 - y) * s + s DIV 2;
          IF (rau[i] > 0) & (acum - lov[i] < 250) THEN Ecran.Culoare(Ecran.RGB(255, 255, 255)); Ecran.Disc(px, py, r + r DIV 2)
          ELSIF rau[i] > 0 THEN Ecran.Culoare(Ecran.RGB(239, 68, 68)); Ecran.Disc(px, py, r + r DIV 2)
          ELSIF acum - rep[i] < 500 THEN Ecran.Culoare(Ecran.RGB(251, 191, 36)); Ecran.Disc(px, py, r + r DIV 3)
          ELSE Ecran.Culoare(Ecran.RGB(40, 150 - 10 * z, 90 + 15 * z)); Ecran.Disc(px, py, r)
          END
        END
      END
    END;
    Ecran.Culoare(Ecran.RGB(6, 4, 10)); Ecran.Dreptunghi(0, 0, w, 96 * d);
    Ecran.Culoare(Ecran.RGB(200, 169, 110)); Ecran.Text(w DIV 2, 30 * d, 17 * d, "343 DE CUBURI");
    Ecran.Culoare(Ecran.RGB(239, 68, 68)); Ecran.Disc(w - 30 * d, 30 * d, 16 * d);   (* X: inapoi in cub *)
    Ecran.Culoare(Ecran.RGB(255, 255, 255)); Ecran.Text(w - 30 * d, 36 * d, 16 * d, "✕");
    t := "lovite "; Strings.AppendInt(lovite, 0, t); Strings.Append(" · reparate ", t); Strings.AppendInt(reparate, 0, t);
    Ecran.Culoare(Ecran.RGB(232, 216, 150)); Ecran.Text(w DIV 2, 56 * d, 12 * d, t);
    t := "celule greșite acum: "; Strings.AppendInt(gresite, 0, t);
    IF gresite > 0 THEN Ecran.Culoare(Ecran.RGB(239, 68, 68)) ELSE Ecran.Culoare(Ecran.RGB(57, 255, 20)) END;
    Ecran.Text(w DIV 2, 78 * d, 12 * d, t);
    t := "mesaje între cuburi: "; Strings.AppendInt(mesaje, 0, t);
    Ecran.Culoare(Ecran.RGB(0, 212, 255)); Ecran.Text(w DIV 2, h - 72 * d, 12 * d, t);
    IF pauza THEN Ecran.Culoare(Ecran.RGB(0, 212, 255)); Ecran.Text(w DIV 2, h - 48 * d, 13 * d, "PAUZĂ · atinge sus ca să meargă iar")
    ELSE Ecran.Culoare(Ecran.RGB(232, 216, 150)); Ecran.Text(w DIV 2, h - 48 * d, 13 * d, "jos = furtună de 49 de raze · sus = pauză")
    END;
    Ecran.Culoare(Ecran.RGB(120, 120, 150)); Ecran.Text(w DIV 2, h - 26 * d, 10 * d, "343 cuburi × 343 celule = 117.649 = o tură a spiralei")
  END Cadru;

  PROCEDURE Atingere*;
    VAR a: BOOLEAN; d, k: INTEGER;
  BEGIN
    a := Ecran.Apasat(); d := Ecran.Densitate() DIV 100 + 1;
    IF a & ~inainte THEN
      IF (Ecran.AtinsY() < 70 * d) & (Ecran.AtinsX() > Ecran.Latime() - 70 * d) THEN iesit := TRUE
      ELSIF Ecran.AtinsY() < 96 * d THEN pauza := ~pauza; Sunet.Nota(523, 120, 25)
      ELSIF ~pauza THEN FOR k := 1 TO 49 DO Raza END; Sunet.Nota(110, 300, 35)
      END
    END;
    inainte := a
  END Atingere;

  PROCEDURE Porneste*;   (* toate cuburile curate, legea in toate *)
    VAR i, j, x, y, z: INTEGER;
  BEGIN
    seed := 343 + Sunet.Ms() MOD 60000;
    FOR j := 0 TO C - 1 DO lege[j] := (j MOD 7 + 2 * (j DIV 7 MOD 7) + 3 * (j DIV 49)) MOD 7 END;
    FOR i := 0 TO C - 1 DO
      x := i MOD 7; y := i DIV 7 MOD 7; z := i DIV 49;
      vec[i, 0] := (x + 1) MOD 7 + 7 * y + 49 * z; vec[i, 1] := (x + 6) MOD 7 + 7 * y + 49 * z;
      vec[i, 2] := x + 7 * ((y + 1) MOD 7) + 49 * z; vec[i, 3] := x + 7 * ((y + 6) MOD 7) + 49 * z;
      vec[i, 4] := x + 7 * y + 49 * ((z + 1) MOD 7); vec[i, 5] := x + 7 * y + 49 * ((z + 6) MOD 7);
      rau[i] := 0; lov[i] := -10000; rep[i] := -10000;
      FOR j := 0 TO C - 1 DO cel[i * C + j] := lege[j] END
    END;
    lovite := 0; reparate := 0; mesaje := 0; gresite := 0; urm := 0; ultimRaza := Sunet.Ms(); ultimNota := 0;
    inainte := Ecran.Apasat(); iesit := FALSE; pauza := FALSE
  END Porneste;

BEGIN
  pent[0] := 392; pent[1] := 440; pent[2] := 523; pent[3] := 587; pent[4] := 659; pent[5] := 784; pent[6] := 880;
  nz[0] := "z = 0"; nz[1] := "z = 1"; nz[2] := "z = 2"; nz[3] := "z = 3"; nz[4] := "z = 4"; nz[5] := "z = 5"; nz[6] := "z = 6";
  iesit := FALSE; inainte := FALSE; pauza := FALSE; seed := 343
END Mesh343.



MODULE Cub7Ver;  (* Cubicum 7 v8: copiile -1/-2 ale Android-ului stau sub fisierul lor, numele cu Z7 nu mai sunt luate drept versiuni,
     data fiecarui fisier (Ecran.Schimbat), versiuni = doar familiile cu mai multe versiuni (versiuni tot / versiuni copii).
   v6 (28 oct 2026): Oul tine evidenta versiunilor .Mod din Download: ce familie (Cubicum 7, Cubicum C...),
     ce versiune, ce merge (✓), ce cade (✗), ce ruleaza acum (◆) si cu ce te intorci daca noua versiune cade.
     Totul sta in versiuni7.mem, langa cub. *)
  IMPORT Strings, Files, Ecran, CFS := CubicumFS, Tx := E7Txt;

  CONST NV = 300;
    cText = 0; cGold = 2; cPurple = 3; cRed = 4; cDim = 5; cGreen = 6; cYel = 7;   (* culorile Shell-ului (Iesire7) *)

  TYPE IesireP* = PROCEDURE (col: INTEGER; s: ARRAY OF CHAR);

  VAR iesire: IesireP; eu: ARRAY 40 OF CHAR; dos: ARRAY 256 OF CHAR;
    vNume: ARRAY NV OF ARRAY 40 OF CHAR; vFam: ARRAY NV OF ARRAY 24 OF CHAR; vVer: ARRAY NV OF ARRAY 12 OF CHAR;
    vEt: ARRAY NV OF ARRAY 24 OF CHAR; vMar, vStare, vZi: ARRAY NV OF INTEGER; nv: INTEGER;
    vCopie: ARRAY NV OF BOOLEAN;   (* v8: X-1.Mod, X-2.Mod: copia pe care o face Android cand descarci iar X.Mod *)
    vBaza: ARRAY NV OF ARRAY 40 OF CHAR;   (* v8: numele fara -1 *)   (* stare: 0 nu stiu, 1 merge, 2 cade *)

  PROCEDURE Rand(col: INTEGER; s: ARRAY OF CHAR);
  BEGIN iesire(col, s)
  END Rand;

  PROCEDURE Cale(VAR c: ARRAY OF CHAR);
  BEGIN CFS.Dosar(c); Strings.Append("/versiuni7.mem", c)
  END Cale;

  PROCEDURE Salveaza;
    VAR f: Files.File; i, r: INTEGER; c, t: ARRAY 200 OF CHAR;
  BEGIN
    Cale(c); Strings.Copy(c, t); Strings.Append(".tmp", t);
    f := Files.Create(t);
    IF f # NIL THEN
      Files.WriteInt(f, 7352); Files.WriteInt(f, nv);
      FOR i := 0 TO nv - 1 DO
        Files.WriteStr(f, vNume[i]); Files.WriteStr(f, vFam[i]); Files.WriteStr(f, vVer[i]); Files.WriteStr(f, vEt[i]);
        Files.WriteInt(f, vMar[i]); Files.WriteInt(f, vStare[i]); Files.WriteInt(f, vZi[i])
      END;
      Files.Close(f);
      IF Files.Exists(c) THEN r := Files.Delete(c) END;
      r := Files.Rename(t, c)
    END
  END Salveaza;

  PROCEDURE Incarca;
    VAR f: Files.File; i, k, n: INTEGER; c: ARRAY 200 OF CHAR;
  BEGIN
    nv := 0; Cale(c); f := Files.Open(c);
    IF f # NIL THEN
      IF Files.ReadInt(f) = 7352 THEN
        n := Files.ReadInt(f); IF (n < 0) OR (n > NV) THEN n := 0 END;
        FOR i := 0 TO n - 1 DO
          k := Files.ReadStr(f, vNume[i]); k := Files.ReadStr(f, vFam[i]); k := Files.ReadStr(f, vVer[i]); k := Files.ReadStr(f, vEt[i]);
          vMar[i] := Files.ReadInt(f); vStare[i] := Files.ReadInt(f); vZi[i] := Files.ReadInt(f)
        END;
        nv := n
      END;
      Files.Close(f)
    END
  END Incarca;

  PROCEDURE Cifra(c: CHAR): BOOLEAN;
  BEGIN RETURN (c >= "0") & (c <= "9")
  END Cifra;

  PROCEDURE Desparte(nume: ARRAY OF CHAR; VAR fam, ver, baza: ARRAY OF CHAR; VAR copie: BOOLEAN);
    (* Cubicum7v5.Mod -> Cubicum7 + v5; CubicumOS27d -> CubicumOS + 27d; SonicZ7-2.Mod -> copie a SonicZ7.Mod, fara versiune *)
    VAR b: ARRAY 40 OF CHAR; n, k: INTEGER;
  BEGIN
    Strings.Copy(nume, b); k := Strings.Pos(".Mod", b, 0); IF k >= 0 THEN b[k] := 0X END;
    n := Strings.Length(b); k := n; copie := FALSE;
    WHILE (k > 0) & Cifra(b[k - 1]) DO DEC(k) END;
    IF (k > 1) & (k < n) & (b[k - 1] = "-") THEN copie := TRUE; b[k - 1] := 0X; n := k - 1 END;   (* X-1 = copia lui X *)
    Strings.Copy(b, baza); Strings.Append(".Mod", baza);
    k := n;
    IF (k >= 2) & (b[k - 1] >= "a") & (b[k - 1] <= "z") & Cifra(b[k - 2]) THEN DEC(k) END;
    WHILE (k > 0) & Cifra(b[k - 1]) DO DEC(k) END;
    IF (k > 0) & (k < n) & (b[k - 1] = "Z") THEN k := n END;   (* SonicZ7, ResonantZ7: Z7 e din nume *)
    IF (k >= 2) & (k < n) & (b[k - 1] = "v") & Cifra(b[k - 2]) THEN DEC(k) END;
    IF (k = n) OR (k = 0) THEN Strings.Copy(b, fam); ver := ""
    ELSE Strings.Extract(b, 0, k, fam); Strings.Extract(b, k, n - k, ver)
    END
  END Desparte;

  PROCEDURE Data(zi: INTEGER; VAR s: ARRAY OF CHAR);   (* zi de la 2010 -> "28.10" *)
    VAR a, l, z: INTEGER;
  BEGIN
    CFS.Data(zi, a, l, z); Strings.AppendInt(z, 0, s); Strings.Append(".", s); IF l < 10 THEN Strings.Append("0", s) END; Strings.AppendInt(l, 0, s)
  END Data;

  PROCEDURE Ordine(ver: ARRAY OF CHAR): INTEGER;   (* v5 -> 150, 27d -> 814 *)
    VAR i, v, l: INTEGER;
  BEGIN
    i := 0; v := 0; l := 0; IF ver[0] = "v" THEN i := 1 END;
    WHILE Cifra(ver[i]) DO IF v < 1000000 THEN v := v * 10 + ORD(ver[i]) - ORD("0") END; INC(i) END;
    IF (ver[i] >= "a") & (ver[i] <= "z") THEN l := ORD(ver[i]) - ORD("a") + 1 END;
    RETURN v * 30 + l
  END Ordine;

  PROCEDURE Eticheta(nume: ARRAY OF CHAR; VAR et: ARRAY OF CHAR);   (* din „apk X.Mod "Eticheta"” de la inceputul fisierului *)
    VAR f: Files.File; b: ARRAY 4096 OF BYTE; t: ARRAY 4100 OF CHAR; c: ARRAY 300 OF CHAR; n, i, p, k: INTEGER; gh: ARRAY 2 OF CHAR;
  BEGIN
    et := ""; gh[0] := CHR(34); gh[1] := 0X; Strings.Copy(dos, c); Strings.Append("/", c); Strings.Append(nume, c);
    f := Files.Open(c);
    IF f # NIL THEN
      n := 0; Files.ReadBytes(f, b, n); Files.Close(f);
      FOR i := 0 TO n - 1 DO IF (b[i] MOD 256 >= 32) & (b[i] MOD 256 < 127) THEN t[i] := CHR(b[i] MOD 256) ELSE t[i] := " " END END;
      t[n] := 0X;
      p := Tx.Pos("apk ", t, 0);
      IF p >= 0 THEN
        p := Tx.Pos(gh, t, p);
        IF p >= 0 THEN
          k := 0; INC(p);
          WHILE (t[p] # 0X) & (t[p] # CHR(34)) & (k < LEN(et) - 1) DO et[k] := t[p]; INC(k); INC(p) END;
          et[k] := 0X
        END
      END
    END
  END Eticheta;

  PROCEDURE Gaseste(nume: ARRAY OF CHAR): INTEGER;
    VAR i, r: INTEGER;
  BEGIN
    r := -1; FOR i := 0 TO nv - 1 DO IF vNume[i] = nume THEN r := i END END;
    RETURN r
  END Gaseste;

  PROCEDURE Scaneaza(VAR noi: INTEGER; spune: BOOLEAN): BOOLEAN;   (* fisierele .Mod din Download intra in evidenta *)
    VAR k, i, m, j, L: INTEGER; nm: ARRAY 64 OF CHAR; ok: BOOLEAN; s: ARRAY 200 OF CHAR;
  BEGIN
    noi := 0; ok := Ecran.Descarcari(dos);
    IF ok THEN
      k := Ecran.Intrari(dos);
      IF k < 0 THEN ok := FALSE
      ELSE
        FOR i := 0 TO k - 1 DO
          m := Ecran.Intrare(i, nm); L := Strings.Length(nm);
          j := Gaseste(nm); IF j >= 0 THEN vZi[j] := Ecran.Schimbat(i) DIV 86400; vMar[j] := m END;   (* v8: ziua adevarata a fisierului *)
          IF (m >= 0) & (L > 4) & (L < 40) & (Strings.Pos(".Mod", nm, 0) = L - 4) & (Gaseste(nm) < 0) & (nv < NV) THEN
            j := nv; Strings.Copy(nm, vNume[j]); Desparte(nm, vFam[j], vVer[j], vBaza[j], vCopie[j]); Eticheta(nm, vEt[j]);
            IF vEt[j] = "" THEN Strings.Copy(vFam[j], vEt[j]) END;
            vMar[j] := m; vStare[j] := 0; vZi[j] := Ecran.Schimbat(i) DIV 86400; INC(nv); INC(noi);
            IF spune & ~vCopie[j] THEN
              s := "  nou în Download: "; Strings.Append(nm, s); Strings.Append(" (", s); Strings.Append(vEt[j], s);
              Strings.Append(") · instaleaza ", s); Strings.Append(vVer[j], s); Rand(cText, s)
            END
          END
        END
      END
    END;
    j := Gaseste(eu); IF (j >= 0) & (vStare[j] # 1) THEN vStare[j] := 1; INC(noi) END;   (* eu rulez, deci m-am compilat si pornesc *)
    IF noi > 0 THEN Salveaza END;
    RETURN ok
  END Scaneaza;

  PROCEDURE Familie(f: ARRAY OF CHAR);   (* un rand: Cubicum 7 · v1 ✗ · v2 ✗ · v3 ✓ · v5 ◆ · 26.10–28.10 (+2 copii) ; apoi cu ce te intorci *)
    VAR id: ARRAY 60 OF INTEGER; n, i, j, t, ultim, inapoi, copii, z0, z1: INTEGER; s: ARRAY 300 OF CHAR;
  BEGIN
    n := 0; copii := 0; z0 := 1000000; z1 := 0;
    FOR i := 0 TO nv - 1 DO
      IF vFam[i] = f THEN
        IF vZi[i] < z0 THEN z0 := vZi[i] END; IF vZi[i] > z1 THEN z1 := vZi[i] END;
        IF vCopie[i] THEN INC(copii) ELSIF n < LEN(id) THEN id[n] := i; INC(n) END
      END
    END;
    FOR i := 0 TO n - 2 DO FOR j := i + 1 TO n - 1 DO IF Ordine(vVer[id[j]]) < Ordine(vVer[id[i]]) THEN t := id[i]; id[i] := id[j]; id[j] := t END END END;
    IF n > 0 THEN
      s := "  "; Strings.Append(vEt[id[n - 1]], s); Strings.Append(":", s); inapoi := -1; ultim := id[n - 1];
      FOR i := 0 TO n - 1 DO
        j := id[i];
        IF vVer[j] # "" THEN
          Strings.Append(" ", s); Strings.Append(vVer[j], s);
          IF vNume[j] = eu THEN Strings.Append(" ◆", s) ELSIF vStare[j] = 1 THEN Strings.Append(" ✓", s) ELSIF vStare[j] = 2 THEN Strings.Append(" ✗", s) END
        ELSIF n = 1 THEN IF vNume[j] = eu THEN Strings.Append(" ◆", s) ELSIF vStare[j] = 1 THEN Strings.Append(" ✓", s) ELSIF vStare[j] = 2 THEN Strings.Append(" ✗", s) END
        ELSE Strings.Append(" ", s); Strings.Append(vNume[j], s)
        END;
        IF (vStare[j] = 1) & (vNume[j] # eu) & (j # ultim) THEN inapoi := j END
      END;
      Strings.Append(" · ", s); Data(z0, s); IF z1 > z0 THEN Strings.Append("–", s); Data(z1, s) END;
      IF copii > 0 THEN Strings.Append(" (+", s); Strings.AppendInt(copii, 0, s); IF copii = 1 THEN Strings.Append(" copie)", s) ELSE Strings.Append(" copii)", s) END END;
      Rand(cText, s);
      IF (inapoi >= 0) & (vStare[ultim] # 2) THEN s := "    dacă "; Strings.Append(vNume[ultim], s); Strings.Append(" cade, te întorci la ", s); Strings.Append(vNume[inapoi], s); Rand(cDim, s)
      ELSIF inapoi >= 0 THEN s := "    cel bun: "; Strings.Append(vNume[inapoi], s); Rand(cGreen, s)
      END
    END
  END Familie;

  PROCEDURE Copii;   (* versiuni copii: copiile X-1.Mod si daca sunt la fel de mari ca X.Mod *)
    VAR i, j, b, n, k: INTEGER; s: ARRAY 200 OF CHAR;
  BEGIN
    Rand(cPurple, "◆ copiile din Download (Android le face când descarci iar același nume)");
    n := 0; k := 0;
    FOR i := 0 TO nv - 1 DO
      IF vCopie[i] THEN
        INC(n); b := -1; FOR j := 0 TO nv - 1 DO IF vNume[j] = vBaza[i] THEN b := j END END;
        s := "  "; Strings.Append(vNume[i], s);
        IF b < 0 THEN Strings.Append(" · originalul nu mai e", s)
        ELSIF vMar[b] = vMar[i] THEN Strings.Append(" = ", s); Strings.Append(vNume[b], s); Strings.Append(" (aceeași mărime: o poți șterge)", s); INC(k)
        ELSE Strings.Append(" ≠ ", s); Strings.Append(vNume[b], s); Strings.Append(" (altă mărime: altă versiune)", s)
        END;
        Rand(cText, s)
      END
    END;
    s := "  "; Strings.AppendInt(n, 0, s); Strings.Append(" copii, din care ", s); Strings.AppendInt(k, 0, s); Strings.Append(" la fel ca originalul", s); Rand(cDim, s)
  END Copii;

  PROCEDURE Versiuni*(filtru: ARRAY OF CHAR);   (* versiuni · versiuni tot · versiuni copii · versiuni [ceva din nume] *)
    VAR i, j, noi, n, fam, singure, copii, e: INTEGER; vazut, tot, arat: BOOLEAN; fl, x: ARRAY 64 OF CHAR; s: ARRAY 200 OF CHAR;
  BEGIN
    IF ~Scaneaza(noi, TRUE) THEN Rand(cYel, "◆ Oul nu poate citi Download · răspunde la cererea de voie, apoi încearcă iar") END;
    Tx.Copy(filtru, fl); Tx.MicS(fl); Tx.FoldS(fl); Tx.Trim(fl);
    IF fl = "copii" THEN Copii
    ELSE
      tot := fl = "tot"; IF tot THEN fl := "" END;
      Rand(cPurple, "◆ versiunile din Download · ✓ merge · ✗ cade · ◆ rulează acum");
      fam := 0; singure := 0; copii := 0; e := Gaseste(eu);
      FOR i := 0 TO nv - 1 DO
        IF vCopie[i] THEN INC(copii) END;
        vazut := FALSE; FOR j := 0 TO i - 1 DO IF vFam[j] = vFam[i] THEN vazut := TRUE END END;
        IF ~vazut THEN
          INC(fam); n := 0; FOR j := 0 TO nv - 1 DO IF (vFam[j] = vFam[i]) & ~vCopie[j] THEN INC(n) END END;
          Tx.Copy(vEt[i], x); Tx.MicS(x); Tx.FoldS(x);
          IF fl # "" THEN arat := Tx.Contine(x, fl) OR Tx.Contine(vFam[i], filtru)
          ELSE arat := tot OR (n >= 2) OR (e >= 0) & (vFam[i] = vFam[e])
          END;
          IF arat THEN Familie(vFam[i]) ELSE INC(singure) END
        END
      END;
      IF nv = 0 THEN Rand(cDim, "  niciun .Mod în Download")
      ELSE
        s := "  "; Strings.AppendInt(nv, 0, s); Strings.Append(" fișiere .Mod · ", s); Strings.AppendInt(fam, 0, s); Strings.Append(" programe · ", s);
        Strings.AppendInt(copii, 0, s); Strings.Append(" copii (versiuni copii)", s); Rand(cDim, s);
        IF singure > 0 THEN s := "  încă "; Strings.AppendInt(singure, 0, s); Strings.Append(" programe cu o singură versiune · versiuni tot", s); Rand(cDim, s) END
      END;
      Rand(cDim, "  merge X / cade X = îi spui Oului cum a mers · instaleaza X = comenzile pentru Eula Oberon")
    END
  END Versiuni;

  PROCEDURE Alege(a: ARRAY OF CHAR): INTEGER;   (* „7v5”, „CubicumC7”, „c7” -> fisierul; cel mai nou daca sunt mai multe *)
    VAR i, r: INTEGER; t, x: ARRAY 64 OF CHAR;
  BEGIN
    Tx.Copy(a, t); Tx.MicS(t); Tx.Trim(t); r := -1;
    IF t # "" THEN
      FOR i := 0 TO nv - 1 DO
        Tx.Copy(vNume[i], x); Tx.MicS(x);
        IF Tx.Contine(x, t) & ((r < 0) OR (vFam[i] = vFam[r]) & (Ordine(vVer[i]) > Ordine(vVer[r]))) THEN r := i END
      END
    END;
    RETURN r
  END Alege;

  PROCEDURE Marcheaza*(a: ARRAY OF CHAR; st: INTEGER);   (* merge X (st = 1) / cade X (st = 2) *)
    VAR i, noi: INTEGER; s: ARRAY 200 OF CHAR; ok: BOOLEAN;
  BEGIN
    ok := Scaneaza(noi, FALSE); i := Alege(a);
    IF i < 0 THEN s := "◆ Oul nu găsește în Download: "; Strings.Append(a, s); Strings.Append(" · scrie versiuni", s); Rand(cRed, s)
    ELSE
      vStare[i] := st; Salveaza;
      s := "◆ "; Strings.Append(vNume[i], s); IF st = 1 THEN Strings.Append(" merge ✓", s) ELSE Strings.Append(" cade ✗", s) END;
      Rand(cPurple, s); IF ~ok THEN Rand(cYel, "  (Download nu s-a putut citi acum)") END;
      Familie(vFam[i])
    END
  END Marcheaza;

  PROCEDURE Instaleaza*(a: ARRAY OF CHAR);   (* instaleaza X: cele doua comenzi pentru Eula Oberon, gata de copiat *)
    VAR i, noi: INTEGER; s: ARRAY 200 OF CHAR; ok: BOOLEAN;
  BEGIN
    ok := Scaneaza(noi, FALSE); i := Alege(a);
    IF ~ok THEN Rand(cYel, "◆ Oul nu poate citi Download acum") END;
    IF i < 0 THEN s := "◆ Oul nu găsește în Download: "; Strings.Append(a, s); Rand(cRed, s)
    ELSE
      s := "◆ în Eula Oberon, câte una (pentru "; Strings.Append(vEt[i], s); Strings.Append("):", s); Rand(cPurple, s);
      s := "cp /sdcard/Download/"; Strings.Append(vNume[i], s); Strings.Append(" ", s); Strings.Append(vNume[i], s); Rand(cGold, s);
      s := "apk "; Strings.Append(vNume[i], s); Strings.Append(" ", s); Strings.AppendChar(CHR(34), s); Strings.Append(vEt[i], s);
      Strings.AppendChar(CHR(34), s); Rand(cGold, s);
      Rand(cDim, "  apoi: merge X sau cade X, ca Oul să știe")
    END
  END Instaleaza;

  PROCEDURE Noi*(): INTEGER;   (* pentru rond: ce .Mod-uri noi au aparut in Download *)
    VAR noi: INTEGER;
  BEGIN
    IF ~Scaneaza(noi, TRUE) THEN noi := 0 END;
    RETURN noi
  END Noi;

  PROCEDURE Porneste*(ies: IesireP; numeEu: ARRAY OF CHAR);
    VAR i: INTEGER;
  BEGIN
    iesire := ies; Strings.Copy(numeEu, eu); dos := ""; Incarca;
    FOR i := 0 TO nv - 1 DO
      Desparte(vNume[i], vFam[i], vVer[i], vBaza[i], vCopie[i]);   (* v8: regulile noi si pentru cele vechi *)
      IF (vEt[i] # vFam[i]) & Tx.Incepe(vFam[i], vEt[i]) THEN Strings.Copy(vFam[i], vEt[i]) END   (* v9: eticheta veche „SonicZ” -> SonicZ7 *)
    END
  END Porneste;

BEGIN
  nv := 0
END Cub7Ver.

MODULE Cub7Copie;  (* Cubicum 7·B v5 (29 oct 2026): copia de siguranta. Tot dosarul cubului (cubul, sesiunea torului, solzii,
     increderea, obiceiurile, versiunile) intr-un singur fisier .z7c in Download: salveaza tot, si o copie automata pe zi
     (Cubicum7B-copie-auto.z7c). restaureaza X pune copia deoparte; la pornirea urmatoare ea ia locul fisierelor. *)
  IMPORT Strings, Files, Os, Ecran, CFS := CubicumFS;

  CONST SEMN = 7377; NF = 200; BUF = 4096;

  VAR vestea*: ARRAY 300 OF CHAR;   (* ce spune la primul cadru (la pornire ecranul inca n-are latime) *)
    ultimaZi: INTEGER;
    nume: ARRAY NF OF ARRAY 64 OF CHAR; marime: ARRAY NF OF INTEGER;
    b: ARRAY BUF OF BYTE;

  PROCEDURE Bun(n: ARRAY OF CHAR): BOOLEAN;   (* ce intra in copie: nu fisierele de lucru *)
    VAR l: INTEGER;
  BEGIN
    l := Strings.Length(n);
    RETURN (l > 0) & (Strings.Pos(".tmp", n, 0) < 0) & (n # "restaurare.z7c") & (n # "wiki7.json") & (n # "adus7.md")
      & (n # "eula.fr") & (n # "eula.idx")   (* 7·B v18: memoria Eulei e mare si se poate pune din nou din eula-memorie.txt *)
  END Bun;

  PROCEDURE Bucata(f, g: Files.File; rest: INTEGER; VAR n: INTEGER);   (* din f in g: o bucata de BUF (repede), sau restul
      de la capatul fisierului octet cu octet, ca sa nu citesc mai mult decat am voie; g = NIL: doar citesc; n = cat am mutat *)
  BEGIN
    IF rest >= BUF THEN n := 0; Files.ReadBytes(f, b, n)
    ELSE n := 0; WHILE n < rest DO b[n] := Files.Read(f); INC(n) END
    END;
    IF (g # NIL) & (n > 0) THEN Files.WriteNBytes(g, b, n) END
  END Bucata;

  PROCEDURE Doi(v: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF v < 10 THEN Strings.Append("0", s) END; Strings.AppendInt(v, 0, s)
  END Doi;

  PROCEDURE Scrie(cale: ARRAY OF CHAR; VAR nf, oct: INTEGER): BOOLEAN;   (* tot dosarul cubului in fisierul cale *)
    VAR dos, c, t: ARRAY 300 OF CHAR; i, k, n, m, r: INTEGER; f, g: Files.File; ok: BOOLEAN;
  BEGIN
    ok := FALSE; nf := 0; oct := 0; CFS.Dosar(dos);
    n := Ecran.Intrari(dos);
    IF n > 0 THEN
      FOR i := 0 TO n - 1 DO
        m := Ecran.Intrare(i, t);
        IF (m >= 0) & (nf < NF) & (Strings.Length(t) < 64) & Bun(t) THEN Strings.Copy(t, nume[nf]); marime[nf] := m; INC(nf) END
      END;
      Strings.Copy(cale, t); Strings.Append(".tmp", t); g := Files.Create(t);
      IF g # NIL THEN
        Files.WriteInt(g, SEMN); Files.WriteInt(g, nf);
        FOR i := 0 TO nf - 1 DO
          Strings.Copy(dos, c); Strings.Append("/", c); Strings.Append(nume[i], c);
          Files.WriteStr(g, nume[i]); f := Files.Open(c);
          IF f = NIL THEN Files.WriteInt(g, 0)
          ELSE
            m := Files.Size(f); IF m < 0 THEN m := 0 END;
            Files.WriteInt(g, m); k := 0;
            WHILE k < m DO Bucata(f, g, m - k, n); IF n <= 0 THEN k := m ELSE k := k + n END END;
            oct := oct + m; Files.Close(f)
          END
        END;
        Files.Close(g);
        IF Files.Exists(cale) THEN r := Files.Delete(cale) END;
        ok := Files.Rename(t, cale) = Files.OK
      END
    END;
    RETURN ok
  END Scrie;

  PROCEDURE Salveaza*(VAR s: ARRAY OF CHAR): BOOLEAN;   (* salveaza tot: Download/Cubicum7B-copie-ZZ.LL-HHMM.z7c; s = ce s-a intamplat *)
    VAR d, cale, nm: ARRAY 300 OF CHAR; t, a, l, z, nf, oct: INTEGER; ok: BOOLEAN;
  BEGIN
    ok := FALSE; s := "";
    IF ~Ecran.Descarcari(d) THEN s := "nu am voie la Download · dă voie și încearcă din nou"
    ELSE
      t := CFS.Local(Os.CurrentTime()); CFS.Data(t DIV 86400, a, l, z);
      nm := "Cubicum7B-copie-"; Doi(z, nm); Strings.Append(".", nm); Doi(l, nm); Strings.Append("-", nm);
      Doi(t MOD 86400 DIV 3600, nm); Doi(t MOD 3600 DIV 60, nm); Strings.Append(".z7c", nm);
      Strings.Copy(d, cale); Strings.Append("/", cale); Strings.Append(nm, cale);
      IF Scrie(cale, nf, oct) THEN
        ok := TRUE; s := "◆ copie de siguranță: Download/"; Strings.Append(nm, s); Strings.Append(" · ", s);
        Strings.AppendInt(nf, 0, s); Strings.Append(" fișiere, ", s); Strings.AppendInt(oct DIV 1024, 0, s); Strings.Append(" KB", s)
      ELSE s := "n-am putut scrie copia în Download"
      END
    END;
    RETURN ok
  END Salveaza;

  PROCEDURE Auto*(): BOOLEAN;   (* o data pe zi: Download/Cubicum7B-copie-auto.z7c (aceeasi, rescrisa) *)
    VAR d, cale: ARRAY 300 OF CHAR; nf, oct: INTEGER; ok: BOOLEAN;
  BEGIN
    ok := FALSE;
    IF CFS.Azi() # ultimaZi THEN
      ultimaZi := CFS.Azi();
      IF Ecran.Descarcari(d) THEN
        Strings.Copy(d, cale); Strings.Append("/Cubicum7B-copie-auto.z7c", cale);
        ok := Scrie(cale, nf, oct)
      END
    END;
    RETURN ok
  END Auto;

  PROCEDURE Lista*(VAR s: ARRAY OF CHAR): INTEGER;   (* copiile din Download, intr-un rand: "a.z7c · b.z7c"; cate sunt *)
    VAR d, t: ARRAY 300 OF CHAR; i, n, k: INTEGER;
  BEGIN
    s := ""; k := 0;
    IF Ecran.Descarcari(d) THEN
      n := Ecran.Intrari(d);
      FOR i := 0 TO n - 1 DO
        IF (Ecran.Intrare(i, t) > 0) & (Strings.Pos("Cubicum7B-", t, 0) = 0) & (Strings.Pos(".z7c", t, 0) > 0) THEN
          IF k > 0 THEN Strings.Append(" · ", s) END; Strings.Append(t, s); INC(k)
        END
      END
    END;
    RETURN k
  END Lista;

  PROCEDURE Copiaza(din, spre: ARRAY OF CHAR): BOOLEAN;   (* un fisier intreg, octet cu octet *)
    VAR f, g: Files.File; m, k, n, r: INTEGER; t: ARRAY 300 OF CHAR; ok: BOOLEAN;
  BEGIN
    ok := FALSE; f := Files.Open(din);
    IF f # NIL THEN
      Strings.Copy(spre, t); Strings.Append(".tmp", t); g := Files.Create(t);
      IF g # NIL THEN
        m := Files.Size(f); k := 0;
        WHILE k < m DO Bucata(f, g, m - k, n); IF n <= 0 THEN k := m ELSE k := k + n END END;
        Files.Close(g);
        IF Files.Exists(spre) THEN r := Files.Delete(spre) END;
        ok := Files.Rename(t, spre) = Files.OK
      END;
      Files.Close(f)
    END;
    RETURN ok
  END Copiaza;

  PROCEDURE Restaureaza*(numeCopie: ARRAY OF CHAR; VAR s: ARRAY OF CHAR): BOOLEAN;   (* copia din Download sta deoparte
      in dosarul cubului; la pornirea urmatoare ia locul fisierelor *)
    VAR d, din, spre: ARRAY 300 OF CHAR; f: Files.File; ok: BOOLEAN;
  BEGIN
    ok := FALSE; s := "";
    IF ~Ecran.Descarcari(d) THEN s := "nu am voie la Download"
    ELSE
      Strings.Copy(d, din); Strings.Append("/", din); Strings.Append(numeCopie, din);
      IF Strings.Pos(".z7c", din, 0) < 0 THEN Strings.Append(".z7c", din) END;
      f := Files.Open(din);
      IF f = NIL THEN s := "nu găsesc copia în Download · restaureaza = lista copiilor"
      ELSIF Files.ReadInt(f) # SEMN THEN Files.Close(f); s := "fișierul nu e o copie Cubicum (.z7c)"
      ELSE
        Files.Close(f); CFS.Dosar(spre); Strings.Append("/restaurare.z7c", spre);
        IF Copiaza(din, spre) THEN
          ok := TRUE; s := "◆ copia e pregătită · închide aplicația (din aplicațiile recente) și deschide-o din nou: la pornire o pun în locul cubului de acum"
        ELSE s := "n-am putut pregăti copia"
        END
      END
    END;
    RETURN ok
  END Restaureaza;

  PROCEDURE LaPornire*(): BOOLEAN;   (* la pornire, dupa CFS.Porneste: daca e o copie pregatita, ia locul fisierelor; TRUE = am restaurat *)
    VAR dos, c, t, nm: ARRAY 300 OF CHAR; f, g: Files.File; i, n, m, k, j, r: INTEGER; ok: BOOLEAN;
  BEGIN
    ok := FALSE; CFS.Dosar(dos); Strings.Copy(dos, c); Strings.Append("/restaurare.z7c", c);
    f := Files.Open(c);
    IF f # NIL THEN
      IF Files.ReadInt(f) = SEMN THEN
        n := Files.ReadInt(f); IF (n < 0) OR (n > NF) THEN n := 0 END;
        FOR i := 0 TO n - 1 DO
          k := Files.ReadStr(f, nm); m := Files.ReadInt(f);
          Strings.Copy(dos, t); Strings.Append("/", t); Strings.Append(nm, t); Strings.Append(".tmp", t);
          g := Files.Create(t); k := 0;
          WHILE k < m DO Bucata(f, g, m - k, j); IF j <= 0 THEN k := m ELSE k := k + j END END;
          IF g # NIL THEN
            Files.Close(g); Strings.Copy(dos, c); Strings.Append("/", c); Strings.Append(nm, c);
            IF Files.Exists(c) THEN r := Files.Delete(c) END; r := Files.Rename(t, c)
          END
        END;
        ok := n > 0;
        vestea := "◆ am restaurat cubul din copie: "; Strings.AppendInt(n, 0, vestea); Strings.Append(" fișiere", vestea)
      END;
      Files.Close(f);
      Strings.Copy(dos, c); Strings.Append("/restaurare.z7c", c); r := Files.Delete(c)
    END;
    RETURN ok
  END LaPornire;

  PROCEDURE Spus*;   (* vestea a fost aratata *)
  BEGIN vestea := ""
  END Spus;

BEGIN vestea := ""; ultimaZi := -1
END Cub7Copie.

MODULE Cub7Solz;  (* Cubicum 7 v11 (29 oct 2026): solzii (Pion: „în loc de o armură din plăci mari, solzi ca la pești sau la pangolin”).
     Fiecare artă are 7 subdomenii, iar fiecare subdomeniu are fișierul lui de hrană pe disc: solz.<arta>.<0..6>.mem (al 8-lea, solz.cristale.0.mem,
     ține cristalele Oului). Hrana nu mai stă toată în memorie: când vine o întrebare, arta deschide doar solzii ei, caută și îi închide.
     Aici stau și uneltele comune ale artelor: cuvintele cheie ale întrebării, numerele din text, potrivirea unei fraze. *)
  IMPORT Strings, Files, CFS := CubicumFS, Tx := E7Txt;

  CONST NA* = 8; NS* = 7; MAXF* = 4000; NP = 200; SEMN = 7370;

  VAR
    q*: ARRAY 128 OF CHAR; t*: ARRAY 200 OF CHAR; kw*: ARRAY 8 OF ARRAY 32 OF CHAR; nk*: INTEGER;   (* intrebarea, cu litere mici, fara diacritice *)
    nr*: ARRAY NA OF ARRAY NS OF INTEGER;   (* cate fraze are fiecare solz *)
    arta*: ARRAY NA OF ARRAY 16 OF CHAR;
    sid*: ARRAY NA OF ARRAY NS OF ARRAY 16 OF CHAR;   (* numele scurt al subdomeniului: geometria.santier *)
    snume*: ARRAY NA OF ARRAY NS OF ARRAY 32 OF CHAR;   (* numele lui frumos: șantier *)
    samanta*: ARRAY NA OF ARRAY NS OF ARRAY 40 OF CHAR;   (* primul articol de pe Wikipedia pentru pășunea solzului *)
    lista: ARRAY NA OF ARRAY NS OF ARRAY 256 OF CHAR;   (* radacinile cuvintelor fiecarui subdomeniu: "gresie|faianta|..." *)
    implicit: ARRAY NA OF INTEGER;
    pf: ARRAY NP OF ARRAY 200 OF CHAR; pa, ps: ARRAY NP OF INTEGER; np: INTEGER;   (* frazele care inca n-au ajuns pe disc *)
    dinHrana*, cristal*: BOOLEAN;   (* raspunsul artei a venit din hrana (si e un cristal) *)
    cf: Files.File; cA, cS, cRam, cP: INTEGER;   (* cursorul: un solz citit fraza cu fraza *)
    eroare*: BOOLEAN;

  PROCEDURE Cheie*(q0: ARRAY OF CHAR; VAR k: ARRAY OF ARRAY OF CHAR): INTEGER;   (* cuvintele de cautat: litere mici, fara diacritice *)
    VAR i, j, n: INTEGER; w: ARRAY 32 OF CHAR; u: ARRAY 128 OF CHAR;
  BEGIN
    Strings.Copy(q0, u); Tx.MicS(u); Tx.FoldS(u); n := 0; i := 0;
    WHILE (i < LEN(u)) & (u[i] # 0X) DO
      j := 0;
      WHILE (i < LEN(u)) & (u[i] # 0X) & Tx.Litera(u[i]) DO IF j < LEN(w) - 1 THEN w[j] := u[i]; INC(j) END; INC(i) END;
      w[j] := 0X;
      IF (j >= 3) & (n < LEN(k)) & ~Tx.InLista(w, "ce|este|care|cum|cine|unde|despre|sunt|esti|spune|pentru|face|fac|din|sau|cel|cea|mai|imi|iti|lui|are|sti|stii") THEN
        Strings.Copy(w, k[n]); INC(n)
      END;
      WHILE (i < LEN(u)) & (u[i] # 0X) & ~Tx.Litera(u[i]) DO INC(i) END
    END;
    RETURN n
  END Cheie;

  PROCEDURE Intreaba*(s: ARRAY OF CHAR);   (* intrebarea noua: o vad toate artele *)
  BEGIN
    Tx.Copy(s, q); Tx.Copy(s, t); Tx.MicS(t); Tx.FoldS(t); nk := Cheie(q, kw); dinHrana := FALSE; cristal := FALSE
  END Intreaba;

  PROCEDURE Curat*;   (* inaintea fiecarei arte *)
  BEGIN dinHrana := FALSE; cristal := FALSE
  END Curat;

  PROCEDURE Are*(w: ARRAY OF CHAR): BOOLEAN;   (* intrebarea contine w (litere mici, fara diacritice) *)
  BEGIN RETURN Tx.Contine(t, w)
  END Are;

  PROCEDURE AreCuv*(VAR u: ARRAY OF CHAR; w: ARRAY OF CHAR): BOOLEAN;   (* w e in u ca inceput de cuvant (3 litere: cuvant intreg) *)
    VAR p, m: INTEGER; ok: BOOLEAN;
  BEGIN
    m := Tx.Len(w); ok := FALSE; p := Tx.Pos(w, u, 0);
    WHILE (p >= 0) & ~ok DO
      IF ((p = 0) OR ~Tx.Litera(u[p - 1])) & ((m >= 4) OR (p + m >= LEN(u)) OR ~Tx.Litera(u[p + m])) THEN ok := TRUE
      ELSE p := Tx.Pos(w, u, p + 1)
      END
    END;
    RETURN ok
  END AreCuv;

  PROCEDURE Cuv*(w: ARRAY OF CHAR): BOOLEAN;   (* intrebarea are cuvantul w (sau un cuvant care incepe cu w, de la 4 litere) *)
  BEGIN RETURN AreCuv(t, w)
  END Cuv;

  PROCEDURE Potrivire*(linie: ARRAY OF CHAR): INTEGER;   (* cate cuvinte cheie ale intrebarii are randul *)
    VAR u: ARRAY 256 OF CHAR; k, s: INTEGER;
  BEGIN
    Tx.Copy(linie, u); Tx.MicS(u); Tx.FoldS(u); s := 0;
    FOR k := 0 TO nk - 1 DO IF AreCuv(u, kw[k]) THEN INC(s) END END;
    RETURN s
  END Potrivire;

  PROCEDURE Conf*(best: INTEGER): INTEGER;   (* cate cuvinte s-au potrivit -> 0 nu stiu, 1 banuiesc, 2 stiu *)
    VAR c: INTEGER;
  BEGIN
    c := 0; IF (best = nk) & (nk >= 2) THEN c := 2 ELSIF (best > 0) & (2 * best >= nk) THEN c := 1 END;
    RETURN c
  END Conf;

  PROCEDURE EsteMuzica*(q0: ARRAY OF CHAR): BOOLEAN;   (* intrebarea are cuvinte de muzica? *)
    VAR u: ARRAY 128 OF CHAR;
  BEGIN
    Tx.Copy(q0, u); Tx.MicS(u); Tx.FoldS(u);
    RETURN Tx.Contine(u, "acord") OR Tx.Contine(u, "gama") OR Tx.Contine(u, "nota") OR Tx.Contine(u, "note")
      OR Tx.Contine(u, "interval") OR Tx.Contine(u, "cvint") OR Tx.Contine(u, "tert") OR Tx.Contine(u, "armur")
      OR Tx.Contine(u, "major") OR Tx.Contine(u, "minor") OR Tx.Contine(u, "diez") OR Tx.Contine(u, "bemol")
      OR Tx.Contine(u, "frecvent") OR Tx.Contine(u, "hz") OR Tx.Contine(u, "relativ") OR Tx.Contine(u, "septim")
      OR Tx.Contine(u, "cvart") OR Tx.Contine(u, "sext") OR Tx.Contine(u, "pentaton") OR Tx.Contine(u, "doric")
      OR Tx.Contine(u, "lidic") OR Tx.Contine(u, "frigic") OR Tx.Contine(u, "mixolid") OR Tx.Contine(u, "locric")
      OR Tx.Contine(u, "bpm") OR Tx.Contine(u, "tempo")
  END EsteMuzica;

  PROCEDURE Numere*(u: ARRAY OF CHAR; VAR x: ARRAY OF REAL; VAR n: INTEGER);   (* numerele din text (virgula sau punct zecimal; -3 e negativ) *)
    VAR i: INTEGER; v, f: REAL; are, neg: BOOLEAN;
  BEGIN
    n := 0; i := 0;
    WHILE (i < LEN(u) - 1) & (u[i] # 0X) & (n < LEN(x)) DO
      IF (u[i] >= "0") & (u[i] <= "9") THEN
        neg := (i > 0) & (u[i - 1] = "-") & ((i = 1) OR ~((u[i - 2] >= "0") & (u[i - 2] <= "9")) & ~Tx.Litera(u[i - 2]));
        v := 0.0; are := TRUE;
        WHILE (i < LEN(u) - 1) & (u[i] >= "0") & (u[i] <= "9") DO v := v * 10.0 + FLT(ORD(u[i]) - ORD("0")); INC(i) END;
        IF (i < LEN(u) - 2) & ((u[i] = ",") OR (u[i] = ".")) & (u[i + 1] >= "0") & (u[i + 1] <= "9") THEN
          INC(i); f := 0.1;
          WHILE (i < LEN(u) - 1) & (u[i] >= "0") & (u[i] <= "9") DO v := v + f * FLT(ORD(u[i]) - ORD("0")); f := f / 10.0; INC(i) END;
          IF (i < LEN(u) - 2) & (u[i] = ".") & (u[i + 1] >= "0") & (u[i + 1] <= "9") THEN are := FALSE END   (* 1.2.3 e o celula, nu un numar *)
        END;
        IF are THEN IF neg THEN v := -v END; x[n] := v; INC(n) END
      ELSE INC(i)
      END
    END
  END Numere;

  PROCEDURE Nr*(x: REAL; VAR s: ARRAY OF CHAR);   (* 12,57 (doua zecimale, fara zerouri la coada) *)
    VAR v, ip, fp: INTEGER;
  BEGIN
    IF x < 0.0 THEN Strings.Append("-", s); x := -x END;
    IF x > 20000000.0 THEN Strings.Append("peste 20 de milioane", s)
    ELSE
      v := FLOOR(x * 100.0 + 0.5); ip := v DIV 100; fp := v MOD 100;
      Strings.AppendInt(ip, 0, s);
      IF fp # 0 THEN
        Strings.Append(",", s); Strings.AppendInt(fp DIV 10, 0, s); IF fp MOD 10 # 0 THEN Strings.AppendInt(fp MOD 10, 0, s) END
      END
    END
  END Nr;

  PROCEDURE Ora*(min: INTEGER; VAR s: ARRAY OF CHAR);   (* minute de la miezul noptii -> 7:05 *)
  BEGIN
    min := (min MOD 1440 + 1440) MOD 1440;
    Strings.AppendInt(min DIV 60, 0, s); Strings.Append(":", s); IF min MOD 60 < 10 THEN Strings.Append("0", s) END; Strings.AppendInt(min MOD 60, 0, s)
  END Ora;

  PROCEDURE UltimulCuvant*(VAR w: ARRAY OF CHAR);   (* ultimul cuvant din intrebare, cu diacritice *)
    VAR i, j, k: INTEGER;
  BEGIN
    i := Strings.Length(q);
    WHILE (i > 0) & ~Tx.Litera(q[i - 1]) DO DEC(i) END;
    j := i; WHILE (j > 0) & Tx.Litera(q[j - 1]) DO DEC(j) END;
    k := 0; WHILE (j < i) & (k < LEN(w) - 1) DO w[k] := q[j]; INC(k); INC(j) END; w[k] := 0X
  END UltimulCuvant;

  PROCEDURE DupaDouaPuncte*(VAR s: ARRAY OF CHAR): BOOLEAN;   (* textul de dupa „:” sau dintre ghilimele; FALSE = nu e *)
    VAR i, j, k: INTEGER;
  BEGIN
    s := ""; i := Strings.Pos(":", q, 0); j := -1;
    IF i < 0 THEN i := Strings.Pos("„", q, 0); IF i >= 0 THEN j := Strings.Pos("”", q, i + 1) END END;
    IF i < 0 THEN i := Strings.Pos(22X, q, 0); IF i >= 0 THEN j := Strings.Pos(22X, q, i + 1) END END;
    IF i >= 0 THEN
      INC(i); IF j < 0 THEN j := Strings.Length(q) END; k := 0;
      WHILE (i < j) & (k < LEN(s) - 1) DO s[k] := q[i]; INC(k); INC(i) END; s[k] := 0X; Tx.Trim(s)
    END;
    RETURN s # ""
  END DupaDouaPuncte;

  (* ---------- subdomeniile: fiecare arta isi spune cele 7 subdomenii la pornire ---------- *)

  PROCEDURE Sub*(a, i: INTEGER; id, nume, cuv, sam: ARRAY OF CHAR);
  BEGIN
    IF (a >= 0) & (a < NA) & (i >= 0) & (i < NS) THEN
      Strings.Copy(id, sid[a][i]); Strings.Copy(nume, snume[a][i]); Strings.Copy(cuv, lista[a][i]); Strings.Copy(sam, samanta[a][i])
    END
  END Sub;

  PROCEDURE Implicit*(a, i: INTEGER);   (* unde merge o fraza pe care n-o pot aseza *)
  BEGIN IF (a >= 0) & (a < NA) THEN implicit[a] := i END
  END Implicit;

  PROCEDURE Radacini(VAR u: ARRAY OF CHAR; VAR l: ARRAY OF CHAR): INTEGER;   (* cate cuvinte din u incep cu o radacina din l ("a|b|c") *)
    VAR i, j, k, n: INTEGER; w: ARRAY 32 OF CHAR; r: ARRAY 32 OF CHAR; gasit: BOOLEAN;
  BEGIN
    n := 0; i := 0;
    WHILE (i < LEN(u)) & (u[i] # 0X) DO
      j := 0; WHILE (i < LEN(u)) & (u[i] # 0X) & (Tx.Litera(u[i]) OR (u[i] >= "0") & (u[i] <= "9")) DO IF j < LEN(w) - 1 THEN w[j] := u[i]; INC(j) END; INC(i) END;
      w[j] := 0X;
      IF j >= 2 THEN
        k := 0; gasit := FALSE;
        WHILE (k < LEN(l)) & (l[k] # 0X) & ~gasit DO
          j := 0; WHILE (k < LEN(l)) & (l[k] # 0X) & (l[k] # "|") DO IF j < LEN(r) - 1 THEN r[j] := l[k]; INC(j) END; INC(k) END; r[j] := 0X;
          IF (k < LEN(l)) & (l[k] = "|") THEN INC(k) END;
          IF (r # "") & Tx.Incepe(w, r) & ((j >= 4) OR (w = r)) THEN gasit := TRUE END
        END;
        IF gasit THEN INC(n) END
      END;
      WHILE (i < LEN(u)) & (u[i] # 0X) & ~(Tx.Litera(u[i]) OR (u[i] >= "0") & (u[i] <= "9")) DO INC(i) END
    END;
    RETURN n
  END Radacini;

  PROCEDURE Clasifica*(a: INTEGER; fraza: ARRAY OF CHAR): INTEGER;   (* in care subdomeniu al artei a se potriveste fraza *)
    VAR u: ARRAY 256 OF CHAR; i, b, bi, sc: INTEGER;
  BEGIN
    bi := 0;
    IF (a >= 0) & (a < NA) THEN
      Tx.Copy(fraza, u); Tx.MicS(u); Tx.FoldS(u); b := 0; bi := implicit[a];
      FOR i := 0 TO NS - 1 DO
        IF lista[a][i] # "" THEN sc := Radacini(u, lista[a][i]); IF sc > b THEN b := sc; bi := i END END
      END
    END;
    RETURN bi
  END Clasifica;

  PROCEDURE Unde*(a: INTEGER): INTEGER;   (* subdomeniul intrebarii, pentru arta a; -1 = niciunul anume *)
    VAR i, b, bi, sc: INTEGER;
  BEGIN
    b := 0; bi := -1;
    IF (a >= 0) & (a < NA) THEN
      FOR i := 0 TO NS - 1 DO
        IF lista[a][i] # "" THEN sc := Radacini(t, lista[a][i]); IF sc > b THEN b := sc; bi := i END END
      END
    END;
    RETURN bi
  END Unde;

  PROCEDURE SubDin*(a: INTEGER; w: ARRAY OF CHAR): INTEGER;   (* "santier" -> 4; -1 = nu e *)
    VAR u: ARRAY 32 OF CHAR; i, r: INTEGER;
  BEGIN
    r := -1; Tx.Copy(w, u); Tx.MicS(u); Tx.FoldS(u);
    IF (a >= 0) & (a < NA) & (Tx.Len(u) >= 3) THEN
      FOR i := NS - 1 TO 0 BY -1 DO IF (sid[a][i] # "") & Tx.Incepe(sid[a][i], u) THEN r := i END END;
      IF (r < 0) & (u[0] >= "1") & (u[0] <= "7") & (u[1] = 0X) THEN r := ORD(u[0]) - ORD("1") END
    END;
    IF (r < 0) & (u[0] >= "1") & (u[0] <= "7") & (u[1] = 0X) THEN r := ORD(u[0]) - ORD("1") END;   (* 7·B: geometria.5 = al cincilea *)
    RETURN r
  END SubDin;

  (* ---------- solzii pe disc ---------- *)

  PROCEDURE Cale*(a, s: INTEGER; VAR c: ARRAY OF CHAR);
  BEGIN
    CFS.Dosar(c); Strings.Append("/solz.", c); Strings.Append(arta[a], c); Strings.Append(".", c); Strings.AppendInt(s + 1, 0, c); Strings.Append(".mem", c)   (* 7·B: solz.geometria.1..7 *)
  END Cale;

  PROCEDURE ScrieUnul(a, s: INTEGER);   (* solzul (a, s) se rescrie: ce avea, plus frazele noi *)
    VAR f, g: Files.File; c, tm: ARRAY 200 OF CHAR; fr: ARRAY 256 OF CHAR; n, i, k, vechi: INTEGER;
  BEGIN
    Cale(a, s, c); Strings.Copy(c, tm); Strings.Append(".tmp", tm);
    g := Files.Create(tm);
    IF g = NIL THEN eroare := TRUE
    ELSE
      vechi := 0; f := Files.Open(c);
      IF f # NIL THEN
        IF Files.ReadInt(f) = SEMN THEN vechi := Files.ReadInt(f); IF (vechi < 0) OR (vechi > MAXF) THEN vechi := 0 END END
      END;
      n := vechi; FOR i := 0 TO np - 1 DO IF (pa[i] = a) & (ps[i] = s) THEN INC(n) END END;
      Files.WriteInt(g, SEMN); Files.WriteInt(g, n);
      FOR i := 0 TO vechi - 1 DO k := Files.ReadStr(f, fr); Files.WriteStr(g, fr) END;
      IF f # NIL THEN Files.Close(f) END;
      FOR i := 0 TO np - 1 DO IF (pa[i] = a) & (ps[i] = s) THEN Files.WriteStr(g, pf[i]); pa[i] := -1 END END;
      Files.Close(g);
      IF Files.Exists(c) THEN k := Files.Delete(c) END;
      k := Files.Rename(tm, c);
      nr[a][s] := n
    END
  END ScrieUnul;

  PROCEDURE Scrie*;   (* frazele noi ajung pe disc, fiecare in solzul ei *)
    VAR i: INTEGER;
  BEGIN
    IF cf # NIL THEN Files.Close(cf); cf := NIL; cRam := 0 END;
    FOR i := 0 TO np - 1 DO IF pa[i] >= 0 THEN ScrieUnul(pa[i], ps[i]) END END;
    np := 0
  END Scrie;

  PROCEDURE Pune*(a, s: INTEGER; fraza: ARRAY OF CHAR): BOOLEAN;   (* o fraza in solzul (a, s); FALSE = prea scurta sau solzul e plin *)
    VAR ok: BOOLEAN; u: ARRAY 200 OF CHAR;
  BEGIN
    ok := FALSE; Tx.Copy(fraza, u); Tx.Trim(u);
    IF (s < 0) OR (s >= NS) THEN s := 0 END;
    IF (a >= 0) & (a < NA) & (Tx.Len(u) >= 12) & (nr[a][s] < MAXF) THEN
      IF np >= NP THEN Scrie END;
      Strings.Copy(u, pf[np]); pa[np] := a; ps[np] := s; INC(np); INC(nr[a][s]); ok := TRUE
    END;
    RETURN ok
  END Pune;

  PROCEDURE Inchide*;
  BEGIN IF cf # NIL THEN Files.Close(cf); cf := NIL END; cRam := 0; cP := np
  END Inchide;

  PROCEDURE Deschide*(a, s: INTEGER);   (* cursorul pe solzul (a, s): apoi Urm, fraza cu fraza *)
    VAR c: ARRAY 200 OF CHAR;
  BEGIN
    Inchide; cA := a; cS := s; cP := 0; cRam := 0;
    IF (a >= 0) & (a < NA) & (s >= 0) & (s < NS) THEN
      Cale(a, s, c); cf := Files.Open(c);
      IF cf # NIL THEN
        IF Files.ReadInt(cf) = SEMN THEN cRam := Files.ReadInt(cf); IF (cRam < 0) OR (cRam > MAXF) THEN cRam := 0 END END
      END
    ELSE cP := np
    END
  END Deschide;

  PROCEDURE Urm*(VAR fr: ARRAY OF CHAR): BOOLEAN;   (* urmatoarea fraza a solzului deschis; FALSE = gata *)
    VAR ok: BOOLEAN; k: INTEGER;
  BEGIN
    ok := FALSE;
    IF (cRam > 0) & (cf # NIL) THEN k := Files.ReadStr(cf, fr); DEC(cRam); ok := TRUE
    ELSE
      IF cf # NIL THEN Files.Close(cf); cf := NIL END;
      WHILE (cP < np) & ~((pa[cP] = cA) & (ps[cP] = cS)) DO INC(cP) END;
      IF cP < np THEN Strings.Copy(pf[cP], fr); INC(cP); ok := TRUE END
    END;
    RETURN ok
  END Urm;

  PROCEDURE Cauta*(a, s: INTEGER; VAR best: ARRAY OF CHAR): INTEGER;   (* fraza solzului cu cele mai multe cuvinte ale intrebarii *)
    VAR b, sc: INTEGER; fr: ARRAY 256 OF CHAR;
  BEGIN
    b := 0; best := "";
    IF (nk > 0) & (a >= 0) & (a < NA) & (s >= 0) & (s < NS) & (nr[a][s] > 0) THEN
      Deschide(a, s);
      WHILE (b < nk) & Urm(fr) DO sc := Potrivire(fr); IF sc > b THEN b := sc; Strings.Copy(fr, best) END END;
      Inchide
    END;
    RETURN b
  END Cauta;

  PROCEDURE Memorie*(a, pref: INTEGER; VAR txt: ARRAY OF CHAR; VAR sub: INTEGER): INTEGER;   (* cat stie arta a din solzii ei:
      intai solzul intrebarii, apoi ceilalti; 0 / 1 / 2 *)
    VAR b, sc, s: INTEGER; fr: ARRAY 256 OF CHAR;
  BEGIN
    b := 0; sub := -1; txt := "";
    IF (pref >= 0) & (pref < NS) THEN b := Cauta(a, pref, fr); IF b > 0 THEN sub := pref; Strings.Copy(fr, txt) END END;
    s := 0;
    WHILE (s < NS) & (b < nk) DO
      IF s # pref THEN sc := Cauta(a, s, fr); IF sc > b THEN b := sc; sub := s; Strings.Copy(fr, txt) END END;
      INC(s)
    END;
    RETURN Conf(b)
  END Memorie;

  PROCEDURE Incheie*(a, c, pref: INTEGER; VAR r, sursa: ARRAY OF CHAR; VAR sub: INTEGER): INTEGER;   (* oul artei: daca solzii stiu mai mult
      decat a calculat subdomeniul, castiga hrana *)
    VAR m, ms: INTEGER; txt: ARRAY 256 OF CHAR;
  BEGIN
    IF (sub < 0) & (pref >= 0) THEN sub := pref END;
    IF c < 2 THEN
      m := Memorie(a, pref, txt, ms);
      IF m > c THEN
        c := m; Strings.Copy(txt, r); sub := ms; dinHrana := TRUE;
        sursa := "din hrana · "; Strings.Append(snume[a][ms], sursa)
      END
    END;
    RETURN c
  END Incheie;

  PROCEDURE Hrana*(cr: BOOLEAN);   (* raspunsul pe care il da arta e din hrana *)
  BEGIN dinHrana := TRUE; cristal := cr
  END Hrana;

  PROCEDURE TotalArta*(a: INTEGER): INTEGER;
    VAR s, n: INTEGER;
  BEGIN
    n := 0; IF (a >= 0) & (a < NA) THEN FOR s := 0 TO NS - 1 DO n := n + nr[a][s] END END;
    RETURN n
  END TotalArta;

  PROCEDURE Total*(): INTEGER;
    VAR a, n: INTEGER;
  BEGIN
    n := 0; FOR a := 0 TO NA - 1 DO n := n + TotalArta(a) END;
    RETURN n
  END Total;

  PROCEDURE Loc*(a: INTEGER): INTEGER;   (* cate fraze mai incap in solzii artei a *)
  BEGIN RETURN NS * MAXF - TotalArta(a)
  END Loc;

  PROCEDURE Flamand*(VAR a, s: INTEGER);   (* solzul cel mai gol (din cele sapte arte) *)
    VAR i, j, m: INTEGER;
  BEGIN
    a := 0; s := 0; m := MAXF + 1;
    FOR i := 0 TO 6 DO FOR j := 0 TO NS - 1 DO IF (samanta[i][j] # "") & (nr[i][j] < m) THEN m := nr[i][j]; a := i; s := j END END END
  END Flamand;

  PROCEDURE Porneste*;   (* numara ce e in fiecare solz *)
    VAR a, s: INTEGER; c: ARRAY 200 OF CHAR; f: Files.File;
  BEGIN
    FOR a := 0 TO NA - 1 DO
      FOR s := 0 TO NS - 1 DO
        nr[a][s] := 0; Cale(a, s, c); f := Files.Open(c);
        IF f # NIL THEN
          IF Files.ReadInt(f) = SEMN THEN nr[a][s] := Files.ReadInt(f); IF (nr[a][s] < 0) OR (nr[a][s] > MAXF) THEN nr[a][s] := 0 END END;
          Files.Close(f)
        END
      END
    END
  END Porneste;

  PROCEDURE Init;
    VAR a, s: INTEGER;
  BEGIN
    arta[0] := "gramatica"; arta[1] := "dialectica"; arta[2] := "retorica"; arta[3] := "aritmetica";
    arta[4] := "geometria"; arta[5] := "muzica"; arta[6] := "astronomia"; arta[7] := "cristale";
    FOR a := 0 TO NA - 1 DO
      implicit[a] := 0;
      FOR s := 0 TO NS - 1 DO nr[a][s] := 0; sid[a][s] := ""; snume[a][s] := ""; lista[a][s] := ""; samanta[a][s] := "" END
    END;
    sid[7][0] := "cristale"; snume[7][0] := "cristale";
    np := 0; cf := NIL; cRam := 0; cP := 0; nk := 0; q := ""; t := ""; dinHrana := FALSE; cristal := FALSE; eroare := FALSE
  END Init;

BEGIN Init
END Cub7Solz.

MODULE ArtaGramatica;  (* ✎ Gramatica, oul ei (Cubicum 7 v11): cuvintele. Șapte subdomenii, fiecare cu solzul lui de hrană:
     0 lexic (parte de vorbire, din lexicon-ro.tsv) · 1 ortografie (litere, vocale, palindrom) · 2 flexiune (formele unui cuvânt)
     3 dicționar (ce înseamnă, din ce a citit) · 4 etimologie · 5 traducere · 6 analiza textului (cuvinte, propoziții) *)
  IMPORT Strings, Files, Ecran, Tx := E7Txt, S := Cub7Solz;

  CONST A = 0;

  VAR sub*: INTEGER;

  PROCEDURE ParteVorbire(upos: ARRAY OF CHAR; VAR s: ARRAY OF CHAR);
  BEGIN
    IF upos = "NOUN" THEN Strings.Append("substantiv", s) ELSIF upos = "VERB" THEN Strings.Append("verb", s)
    ELSIF upos = "ADJ" THEN Strings.Append("adjectiv", s) ELSIF upos = "ADV" THEN Strings.Append("adverb", s)
    ELSIF upos = "PROPN" THEN Strings.Append("nume propriu", s) ELSIF upos = "NUM" THEN Strings.Append("numeral", s)
    ELSIF upos = "PRON" THEN Strings.Append("pronume", s) ELSIF upos = "DET" THEN Strings.Append("determinant (articol, adjectiv pronominal)", s)
    ELSIF upos = "ADP" THEN Strings.Append("prepoziție", s) ELSIF upos = "AUX" THEN Strings.Append("verb auxiliar", s)
    ELSIF (upos = "CCONJ") OR (upos = "SCONJ") THEN Strings.Append("conjuncție", s) ELSIF upos = "INTJ" THEN Strings.Append("interjecție", s)
    ELSIF upos = "PART" THEN Strings.Append("particulă", s) ELSE Strings.Append(upos, s)
    END
  END ParteVorbire;

  PROCEDURE Lexicon(cuv: ARRAY OF CHAR; forme: BOOLEAN; VAR rez, lema0: ARRAY OF CHAR): INTEGER;   (* lexicon-ro.tsv din Download:
      forme = FALSE: ce este forma cuv (parte de vorbire, lema); forme = TRUE: toate formele lemei cuv. -1 = nu am lexiconul *)
    VAR f: Files.File; b: ARRAY 8192 OF BYTE; d: ARRAY 256 OF CHAR; c: ARRAY 300 OF CHAR; w, cmp, cl: ARRAY 64 OF CHAR;
      lin: ARRAY 200 OF CHAR; n, i, x, r, cc, j, gasite, camp, k: INTEGER; forma, upos, lema: ARRAY 64 OF CHAR;
  BEGIN
    gasite := -1; rez := ""; lema0 := "";
    IF Ecran.Descarcari(d) THEN
      Strings.Copy(d, c); Strings.Append("/lexicon-ro.tsv", c); f := Files.Open(c);
      IF f # NIL THEN
        gasite := 0; Tx.Copy(cuv, w); Tx.MicS(w); Tx.FoldS(w); j := 0; r := 0; x := 0;
        REPEAT
          n := 0; Files.ReadBytes(f, b, n);
          FOR i := 0 TO n - 1 DO
            cc := b[i] MOD 256;
            IF r > 0 THEN x := x * 64 + cc MOD 64; DEC(r)
            ELSIF cc < 80H THEN x := cc ELSIF cc DIV 32 = 6 THEN x := cc MOD 32; r := 1 ELSIF cc DIV 16 = 14 THEN x := cc MOD 16; r := 2 ELSE x := cc MOD 8; r := 3
            END;
            IF r = 0 THEN
              IF x = 10 THEN
                lin[j] := 0X; j := 0;
                IF (lin[0] # "#") & (gasite < 14) THEN   (* forma TAB upos TAB lema *)
                  camp := 0; k := 0; forma := ""; upos := ""; lema := "";
                  WHILE lin[k] # 0X DO
                    IF lin[k] = 09X THEN INC(camp)
                    ELSIF camp = 0 THEN Strings.AppendChar(lin[k], forma)
                    ELSIF camp = 1 THEN Strings.AppendChar(lin[k], upos)
                    ELSIF camp = 2 THEN Strings.AppendChar(lin[k], lema)
                    END;
                    INC(k)
                  END;
                  IF forme THEN
                    Tx.Copy(lema, cl); Tx.MicS(cl); Tx.FoldS(cl);
                    IF cl = w THEN
                      IF gasite > 0 THEN Strings.Append(", ", rez) END; Strings.Append(forma, rez); INC(gasite)
                    END
                  ELSE
                    Tx.Copy(forma, cmp); Tx.MicS(cmp); Tx.FoldS(cmp);
                    IF (cmp = w) & (gasite < 4) THEN
                      IF gasite > 0 THEN Strings.Append("; ", rez) END;
                      Strings.Append(forma, rez); Strings.Append(" = ", rez); ParteVorbire(upos, rez);
                      IF (lema # "") & (lema # forma) THEN Strings.Append(", forma de bază „", rez); Strings.Append(lema, rez); Strings.Append("”", rez) END;
                      IF lema0 = "" THEN Strings.Copy(lema, lema0) END;
                      INC(gasite)
                    END
                  END
                END
              ELSIF (x >= 9) & (j < LEN(lin) - 1) & (x < 10000H) THEN lin[j] := CHR(x); INC(j)
              END
            END
          END
        UNTIL n <= 0;
        Files.Close(f)
      END
    END;
    RETURN gasite
  END Lexicon;

  PROCEDURE Copula(VAR t: ARRAY OF CHAR; k: INTEGER): BOOLEAN;   (* 7·B v17: de la k: [ (…) ] este / e un / e o / sunt / inseamna / reprezinta / a fost *)
    VAR a: INTEGER;
  BEGIN
    WHILE (k < LEN(t)) & (t[k] = " ") DO INC(k) END;
    IF (k < LEN(t)) & (t[k] = "(") THEN
      a := 1; INC(k); WHILE (k < LEN(t)) & (t[k] # 0X) & (a > 0) DO IF t[k] = "(" THEN INC(a) ELSIF t[k] = ")" THEN DEC(a) END; INC(k) END;
      WHILE (k < LEN(t)) & ((t[k] = " ") OR (t[k] = ",")) DO INC(k) END
    END;
    RETURN Tx.IncepeLa(t, k, "este ") OR Tx.IncepeLa(t, k, "e un") OR Tx.IncepeLa(t, k, "e o ") OR Tx.IncepeLa(t, k, "sunt ")
      OR Tx.IncepeLa(t, k, "inseamna ") OR Tx.IncepeLa(t, k, "reprezinta ") OR Tx.IncepeLa(t, k, "a fost ") OR Tx.IncepeLa(t, k, "era ")
  END Copula;

  PROCEDURE Scan(a, s: INTEGER; VAR w, rez: ARRAY OF CHAR; VAR citite: INTEGER): BOOLEAN;   (* in solzul (a, s): o fraza „w este ...” *)
    VAR t: ARRAY 256 OF CHAR; fr: ARRAY 256 OF CHAR; ok: BOOLEAN;
  BEGIN
    ok := FALSE;
    IF S.nr[a][s] > 0 THEN
      S.Deschide(a, s);
      WHILE ~ok & (citite < 6000) & S.Urm(fr) DO
        INC(citite); Tx.Copy(fr, t); Tx.MicS(t); Tx.FoldS(t);
        IF Tx.Incepe(t, w) & ~Tx.Litera(t[Tx.Len(w)]) & Copula(t, Tx.Len(w)) THEN   (* 7·B v17: verbul chiar dupa cuvant *)
          ok := TRUE; Strings.Copy(fr, rez)
        END
      END;
      S.Inchide
    END;
    RETURN ok
  END Scan;

  PROCEDURE Lema*(cuv: ARRAY OF CHAR; VAR lema: ARRAY OF CHAR): BOOLEAN;   (* 7·B v17: forma de baza din lexicon-ro.tsv; FALSE = n-o stiu *)
    VAR rez: ARRAY 300 OF CHAR;
  BEGIN lema := ""; RETURN (Lexicon(cuv, FALSE, rez, lema) > 0) & (lema # "")
  END Lema;

  PROCEDURE Definitie(VAR cuv: ARRAY OF CHAR; VAR rez: ARRAY OF CHAR): BOOLEAN;   (* o fraza din solzi care incepe cu cuvantul si spune ce este:
      intai dictionarul Gramaticii, apoi toti solzii (cel mult 6000 de fraze citite) *)
    VAR a, s, citite: INTEGER; w: ARRAY 64 OF CHAR; ok: BOOLEAN;
  BEGIN
    Tx.Copy(cuv, w); Tx.MicS(w); Tx.FoldS(w); citite := 0;
    ok := Scan(A, 3, w, rez, citite); a := 0;
    WHILE ~ok & (a < S.NA) DO
      s := 0;
      WHILE ~ok & (s < S.NS) DO IF (a # A) OR (s # 3) THEN ok := Scan(a, s, w, rez, citite) END; INC(s) END;
      INC(a)
    END;
    RETURN ok
  END Definitie;

  PROCEDURE Ortografie(VAR w, r: ARRAY OF CHAR);   (* 1: litere, vocale, consoane, invers, palindrom *)
    VAR i, n, v: INTEGER; s: ARRAY 64 OF CHAR;
  BEGIN
    n := Tx.Len(w); v := 0; Tx.Copy(w, s); Tx.MicS(s); Tx.FoldS(s);
    FOR i := 0 TO Tx.Len(s) - 1 DO IF (s[i] = "a") OR (s[i] = "e") OR (s[i] = "i") OR (s[i] = "o") OR (s[i] = "u") THEN INC(v) END END;
    r := "„"; Strings.Append(w, r); Strings.Append("” are ", r); Strings.AppendInt(n, 0, r); Strings.Append(" litere: ", r);
    Strings.AppendInt(v, 0, r); Strings.Append(" vocale și ", r); Strings.AppendInt(n - v, 0, r); Strings.Append(" consoane · invers: ", r);
    FOR i := Tx.Len(w) - 1 TO 0 BY -1 DO Strings.AppendChar(w[i], r) END;
    n := Tx.Len(s); i := 0; WHILE (i < n DIV 2) & (s[i] = s[n - 1 - i]) DO INC(i) END;
    IF (n > 1) & (i = n DIV 2) THEN Strings.Append(" · e palindrom", r) END
  END Ortografie;

  PROCEDURE Analiza(VAR txt, r: ARRAY OF CHAR);   (* 6: cate cuvinte, propozitii, semne are un text *)
    VAR i, cuv, prop, sem, lung, cl: INTEGER; inCuv: BOOLEAN; lm: ARRAY 64 OF CHAR; w: ARRAY 64 OF CHAR;
  BEGIN
    cuv := 0; prop := 0; sem := 0; inCuv := FALSE; lung := 0; cl := 0; lm := ""; w := "";
    i := 0;
    WHILE (i < LEN(txt)) & (txt[i] # 0X) DO
      INC(sem);
      IF Tx.Litera(txt[i]) OR (txt[i] >= "0") & (txt[i] <= "9") THEN
        IF ~inCuv THEN INC(cuv); inCuv := TRUE; cl := 0 END;
        IF cl < LEN(w) - 1 THEN w[cl] := txt[i]; INC(cl); w[cl] := 0X END
      ELSE
        IF inCuv & (cl > lung) THEN lung := cl; Strings.Copy(w, lm) END;
        inCuv := FALSE;
        IF (txt[i] = ".") OR (txt[i] = "!") OR (txt[i] = "?") THEN INC(prop) END
      END;
      INC(i)
    END;
    IF inCuv & (cl > lung) THEN Strings.Copy(w, lm) END;
    IF (prop = 0) & (cuv > 0) THEN prop := 1 END;
    r := "textul are "; Strings.AppendInt(cuv, 0, r); Strings.Append(" cuvinte, ", r); Strings.AppendInt(prop, 0, r);
    Strings.Append(" propoziții și ", r); Strings.AppendInt(sem, 0, r); Strings.Append(" semne", r);
    IF lm # "" THEN Strings.Append(" · cel mai lung cuvânt: „", r); Strings.Append(lm, r); Strings.Append("”", r) END
  END Analiza;

  PROCEDURE Raspunde*(VAR r, sursa: ARRAY OF CHAR): INTEGER;
    VAR c, n, pref: INTEGER; w: ARRAY 64 OF CHAR; s: ARRAY 400 OF CHAR; lema: ARRAY 64 OF CHAR; txt: ARRAY 200 OF CHAR; lex: BOOLEAN;
  BEGIN
    c := 0; r := ""; sursa := ""; sub := -1; pref := S.Unde(A); S.UltimulCuvant(w);
    IF (S.Are("cate cuvinte") OR S.Are("analiz") OR S.Are("numara cuvint") OR S.Are("cate propozit")) & S.DupaDouaPuncte(txt) THEN
      Analiza(txt, s); Strings.Copy(s, r); sub := 6; c := 2
    ELSIF w # "" THEN
      IF S.Are("litere") OR S.Are("vocale") OR S.Are("consoane") OR S.Are("invers") OR S.Are("palindrom") THEN
        Ortografie(w, s); Strings.Copy(s, r); sub := 1; c := 2
      ELSIF S.Are("formele") OR S.Are("pluralul") OR S.Are("flexiun") OR S.Are("conjuga") OR S.Are("declin") OR S.Are("forme ale") THEN
        n := Lexicon(w, FALSE, s, lema);
        IF (n > 0) & (lema # "") THEN Strings.Copy(lema, w) END;
        n := Lexicon(w, TRUE, s, lema);
        IF n > 0 THEN r := "formele lui „"; Strings.Append(w, r); Strings.Append("”: ", r); Strings.Append(s, r); sursa := "din lexicon-ro.tsv"; sub := 2; c := 2
        ELSIF n < 0 THEN r := "n-am lexiconul: pune lexicon-ro.tsv în Download"; sub := 2; c := 1
        END
      ELSE
        lex := S.Are("parte de vorbire") OR S.Are("fel de cuvant") OR S.Are("lema") OR S.Are("forma de baza")
          OR S.Are("substantiv") OR S.Are("adjectiv") OR S.Are("adverb") OR S.Are("gramatic");
        IF S.Are("inseamna") OR S.Are("definit") OR S.Are("ce este") OR S.Are("ce e ") OR lex THEN
          IF ~lex & (Definitie(w, s) OR (Lexicon(w, FALSE, s, lema) > 0) & (lema # "") & (lema # w) & Definitie(lema, s)) THEN   (* 7·B v17: si forma de baza *)
            Strings.Copy(s, r); sursa := "din ce am citit"; sub := 3; S.Hrana(FALSE); c := 2
          ELSE
            n := Lexicon(w, FALSE, s, lema);
            IF n > 0 THEN Strings.Copy(s, r); sursa := "din lexicon-ro.tsv"; sub := 0; IF lex THEN c := 2 ELSE c := 1 END
            ELSIF (n < 0) & lex THEN r := "n-am lexiconul: pune lexicon-ro.tsv în Download"; sub := 0; c := 1
            END
          END
        END
      END
    END;
    RETURN S.Incheie(A, c, pref, r, sursa, sub)
  END Raspunde;


  PROCEDURE Porneste*;   (* il cheama Oul: pe Java, corpul modulului (subdomeniile) ruleaza abia cand modulul e atins prima oara *)
  BEGIN
  END Porneste;

BEGIN
  sub := -1;
  S.Sub(A, 0, "lexic", "lexic", "substantiv|adjectiv|adverb|pronum|prepozit|conjunct|interject|lema|vorbir|numeral|articol|verb", "Parte de vorbire");
  S.Sub(A, 1, "ortografie", "ortografie", "liter|vocal|consoan|silab|diacritic|ortograf|majuscul|palindrom|cratim|alfabet", "Ortografia limbii române");
  S.Sub(A, 2, "flexiune", "flexiune", "plural|singular|forme|formel|conjug|declin|persoan|feminin|masculin|neutru|articulat|flexiun|timpul", "Flexiune");
  S.Sub(A, 3, "dictionar", "dicționar", "inseamna|definit|sens|sinonim|antonim|dictionar|termen|explica|cuvant", "Dicționar");
  S.Sub(A, 4, "etimologie", "etimologie", "etimolog|origin|provin|latin|latinesc|slav|grec|franc|turc|maghiar|imprumut|derivat", "Etimologie");
  S.Sub(A, 5, "traducere", "traducere", "tradu|traduc|englez|francez|german|italian|spaniol|rusa|limba|limbi|strain", "Traducere");
  S.Sub(A, 6, "text", "analiza textului", "fraza|propozit|text|subiect|predicat|complement|virgul|punctuat|stil|paragraf", "Sintaxă");
  S.Implicit(A, 3)
END ArtaGramatica.

MODULE ArtaDialectica;  (* ∴ Dialectica, oul ei (Cubicum 7 v11): logica. Șapte subdomenii:
     0 comparații · 1 logica propozițiilor (adevărat / fals) · 2 silogisme („X este Y?” după ce a citit) · 3 programare (parantezele codului)
     4 mulțimi ({1, 2} și {2, 3}) · 5 argumentare · 6 decizii *)
  IMPORT Strings, Tx := E7Txt, S := Cub7Solz;

  CONST A = 1;

  VAR sub*: INTEGER;

  PROCEDURE Bool(t: ARRAY OF CHAR; VAR rez: BOOLEAN): BOOLEAN;   (* adevarat si nu fals sau ... ; daca A atunci B. FALSE = nu e o expresie *)
    VAR i, k, n, p: INTEGER; w: ARRAY 16 OF CHAR; tok: ARRAY 40 OF INTEGER; ok, neg, si, sau, vazut, a: BOOLEAN;
      parte: ARRAY 2 OF BOOLEAN;   (* tok: 1 adevarat, 0 fals, 10 si, 11 sau, 12 nu, 13 atunci *)
  BEGIN
    n := 0; i := 0;
    WHILE (t[i] # 0X) & (n < LEN(tok)) DO
      IF Tx.Litera(t[i]) THEN
        k := 0; WHILE Tx.Litera(t[i]) DO IF k < 15 THEN w[k] := t[i]; INC(k) END; INC(i) END; w[k] := 0X;
        IF (w = "adevarat") OR (w = "true") THEN tok[n] := 1; INC(n) ELSIF (w = "fals") OR (w = "false") THEN tok[n] := 0; INC(n)
        ELSIF (w = "si") OR (w = "and") THEN tok[n] := 10; INC(n) ELSIF (w = "sau") OR (w = "or") THEN tok[n] := 11; INC(n)
        ELSIF (w = "nu") OR (w = "not") THEN tok[n] := 12; INC(n) ELSIF (w = "atunci") OR (w = "implica") THEN tok[n] := 13; INC(n)
        END
      ELSE INC(i)
      END
    END;
    ok := TRUE; p := 0; parte[0] := FALSE; parte[1] := FALSE;
    sau := FALSE; si := TRUE; neg := FALSE; vazut := FALSE; i := 0;
    WHILE ok & (i <= n) DO
      IF (i = n) OR (tok[i] = 13) THEN   (* sfarsitul unei parti: sau-ul termenilor si *)
        IF ~vazut OR (p > 1) THEN ok := FALSE ELSE parte[p] := sau OR si; INC(p) END;
        sau := FALSE; si := TRUE; neg := FALSE; vazut := FALSE
      ELSIF tok[i] = 12 THEN neg := ~neg
      ELSIF tok[i] <= 1 THEN a := tok[i] = 1; IF neg THEN a := ~a END; si := si & a; neg := FALSE; vazut := TRUE
      ELSIF tok[i] = 11 THEN sau := sau OR si; si := TRUE
      END;
      INC(i)
    END;
    IF p = 2 THEN rez := ~parte[0] OR parte[1] ELSE rez := parte[0] END;   (* A atunci B = nu A sau B *)
    RETURN ok & (p >= 1)
  END Bool;

  PROCEDURE Silogism(VAR r: ARRAY OF CHAR): INTEGER;   (* 2: caut in toti solzii o fraza cu toate cuvintele si cu „este” *)
    VAR a, s, c, citite: INTEGER; fr: ARRAY 256 OF CHAR; h: ARRAY 256 OF CHAR;
  BEGIN
    c := 0; citite := 0; a := 0;
    WHILE (c = 0) & (a < S.NA) & (citite < 8000) DO
      s := 0;
      WHILE (c = 0) & (s < S.NS) DO
        IF S.nr[a][s] > 0 THEN
          S.Deschide(a, s);
          WHILE (c = 0) & (citite < 8000) & S.Urm(fr) DO
            INC(citite);
            IF S.Potrivire(fr) = S.nk THEN
              Tx.Copy(fr, h); Tx.MicS(h); Tx.FoldS(h);
              IF Tx.Contine(h, " nu este ") OR Tx.Contine(h, " nu e ") THEN r := "nu, după ce am citit: „"; c := 1
              ELSIF Tx.Contine(h, " este ") OR Tx.Contine(h, " e ") OR Tx.Contine(h, " sunt ") THEN r := "da, după ce am citit: „"; c := 1
              END;
              IF c > 0 THEN Strings.Append(fr, r); Strings.Append("”", r); S.Hrana(a = 7) END
            END
          END;
          S.Inchide
        END;
        INC(s)
      END;
      INC(a)
    END;
    RETURN c
  END Silogism;

  PROCEDURE Paranteze(VAR cod, r: ARRAY OF CHAR);   (* 3: se inchid parantezele ( [ { ? *)
    VAR st: ARRAY 64 OF CHAR; n, i, rand, gres: INTEGER; ch, astept: CHAR;
  BEGIN
    n := 0; i := 0; rand := 1; gres := -1;
    WHILE (gres < 0) & (i < LEN(cod)) & (cod[i] # 0X) DO
      ch := cod[i];
      IF (ch = "(") OR (ch = "[") OR (ch = "{") THEN IF n < LEN(st) THEN st[n] := ch; INC(n) ELSE gres := i END
      ELSIF (ch = ")") OR (ch = "]") OR (ch = "}") THEN
        IF ch = ")" THEN astept := "(" ELSIF ch = "]" THEN astept := "[" ELSE astept := "{" END;
        IF (n > 0) & (st[n - 1] = astept) THEN DEC(n) ELSE gres := i END
      ELSIF ch = 0AX THEN INC(rand)
      END;
      INC(i)
    END;
    IF gres >= 0 THEN
      r := "parantezele nu se potrivesc: semnul "; Strings.AppendInt(gres + 1, 0, r); Strings.Append(" („", r); Strings.AppendChar(cod[gres], r);
      Strings.Append("”) nu închide ce era deschis", r)
    ELSIF n > 0 THEN
      r := "lipsesc "; Strings.AppendInt(n, 0, r); Strings.Append(" închideri · ultima deschisă: „", r); Strings.AppendChar(st[n - 1], r); Strings.Append("”", r)
    ELSE r := "parantezele se închid toate, în ordine (( ), [ ], { })"
    END
  END Paranteze;

  PROCEDURE Multime(VAR u: ARRAY OF CHAR; VAR de: INTEGER; VAR m: ARRAY OF INTEGER; VAR n: INTEGER): BOOLEAN;   (* {1, 2, 3} de la de *)
    VAR i, v, k: INTEGER; ok, neg, are: BOOLEAN;
  BEGIN
    ok := FALSE; n := 0; i := de;
    WHILE (i < LEN(u)) & (u[i] # 0X) & (u[i] # "{") DO INC(i) END;
    IF (i < LEN(u)) & (u[i] = "{") THEN
      INC(i);
      WHILE (i < LEN(u)) & (u[i] # 0X) & (u[i] # "}") DO
        neg := u[i] = "-"; IF neg THEN INC(i) END;
        v := 0; are := FALSE;
        WHILE (i < LEN(u)) & (u[i] >= "0") & (u[i] <= "9") DO IF v < 1000000 THEN v := v * 10 + ORD(u[i]) - ORD("0") END; are := TRUE; INC(i) END;
        IF are & (n < LEN(m)) THEN
          IF neg THEN v := -v END;
          k := 0; WHILE (k < n) & (m[k] # v) DO INC(k) END;
          IF k = n THEN m[n] := v; INC(n) END
        ELSIF ~are THEN INC(i)
        END
      END;
      IF (i < LEN(u)) & (u[i] = "}") THEN ok := TRUE; INC(i) END
    END;
    de := i;
    RETURN ok
  END Multime;

  PROCEDURE Are(VAR m: ARRAY OF INTEGER; n, v: INTEGER): BOOLEAN;
    VAR k: INTEGER;
  BEGIN k := 0; WHILE (k < n) & (m[k] # v) DO INC(k) END; RETURN k < n
  END Are;

  PROCEDURE Scrie(VAR m: ARRAY OF INTEGER; n: INTEGER; VAR r: ARRAY OF CHAR);   (* {1, 2, 3}, in ordine *)
    VAR i, j, x: INTEGER;
  BEGIN
    FOR i := 1 TO n - 1 DO x := m[i]; j := i; WHILE (j > 0) & (m[j - 1] > x) DO m[j] := m[j - 1]; DEC(j) END; m[j] := x END;
    Strings.Append("{", r);
    FOR i := 0 TO n - 1 DO IF i > 0 THEN Strings.Append(", ", r) END; Strings.AppendInt(m[i], 0, r) END;
    Strings.Append("}", r)
  END Scrie;

  PROCEDURE Multimi(VAR r: ARRAY OF CHAR): BOOLEAN;   (* 4: reuniunea, intersectia, diferenta a doua multimi *)
    VAR a, b, c: ARRAY 40 OF INTEGER; na, nb, nc, i, de: INTEGER; ok, toate: BOOLEAN; u: ARRAY 200 OF CHAR;
  BEGIN
    Tx.Copy(S.q, u); de := 0; ok := FALSE;
    IF Multime(u, de, a, na) & Multime(u, de, b, nb) THEN
      ok := TRUE; r := "";
      toate := ~(S.Are("reuniun") OR S.Are("intersect") OR S.Are("diferent") OR S.Are("inclus") OR S.Are("submultim"));
      IF toate OR S.Are("reuniun") THEN
        nc := 0; FOR i := 0 TO na - 1 DO c[nc] := a[i]; INC(nc) END;
        FOR i := 0 TO nb - 1 DO IF ~Are(c, nc, b[i]) & (nc < LEN(c)) THEN c[nc] := b[i]; INC(nc) END END;
        Strings.Append("A ∪ B = ", r); Scrie(c, nc, r)
      END;
      IF toate OR S.Are("intersect") THEN
        nc := 0; FOR i := 0 TO na - 1 DO IF Are(b, nb, a[i]) THEN c[nc] := a[i]; INC(nc) END END;
        IF r # "" THEN Strings.Append(" · ", r) END; Strings.Append("A ∩ B = ", r); Scrie(c, nc, r)
      END;
      IF toate OR S.Are("diferent") THEN
        nc := 0; FOR i := 0 TO na - 1 DO IF ~Are(b, nb, a[i]) THEN c[nc] := a[i]; INC(nc) END END;
        IF r # "" THEN Strings.Append(" · ", r) END; Strings.Append("A − B = ", r); Scrie(c, nc, r)
      END;
      IF toate OR S.Are("inclus") OR S.Are("submultim") THEN
        nc := 0; FOR i := 0 TO na - 1 DO IF Are(b, nb, a[i]) THEN INC(nc) END END;
        IF r # "" THEN Strings.Append(" · ", r) END;
        IF nc = na THEN Strings.Append("A ⊆ B", r) ELSE Strings.Append("A nu e inclusă în B", r) END
      END
    END;
    RETURN ok
  END Multimi;

  PROCEDURE Raspunde*(VAR r, sursa: ARRAY OF CHAR): INTEGER;
    VAR c, n, pref: INTEGER; x: ARRAY 4 OF REAL; s: ARRAY 400 OF CHAR; b: BOOLEAN; cod: ARRAY 200 OF CHAR;
  BEGIN
    c := 0; r := ""; sursa := ""; sub := -1; s := ""; pref := S.Unde(A);
    S.Numere(S.t, x, n);
    IF Tx.Contine(S.q, "{") & Multimi(s) THEN sub := 4; c := 2
    ELSIF (S.Are("parantez") OR S.Are("acolad") OR S.Are("cod")) & S.DupaDouaPuncte(cod) THEN Paranteze(cod, s); sub := 3; c := 2
    ELSIF (n >= 2) & (S.Are("mai mare") OR S.Are("mai mic") OR S.Are("egal") OR S.Are(">") OR S.Are("<")) THEN
      IF S.Are("mai mare") OR S.Are(">") THEN b := x[0] > x[1]; S.Nr(x[0], s); Strings.Append(" > ", s)
      ELSIF S.Are("mai mic") OR S.Are("<") THEN b := x[0] < x[1]; S.Nr(x[0], s); Strings.Append(" < ", s)
      ELSE b := x[0] = x[1]; S.Nr(x[0], s); Strings.Append(" = ", s)
      END;
      S.Nr(x[1], s); IF b THEN Strings.Append(" · adevărat", s) ELSE Strings.Append(" · fals", s) END; sub := 0; c := 2
    ELSIF (S.Are("adevarat") OR S.Are("fals")) & Bool(S.t, b) THEN
      IF b THEN s := "adevărat" ELSE s := "fals" END;
      Strings.Append(" (nu leagă cel mai tare, apoi și, apoi sau; dacă A atunci B = nu A sau B)", s); sub := 1; c := 2
    ELSIF (S.nk >= 2) & (S.Are(" este ") OR S.Are(" e ")) & (S.Are("?") OR Tx.Incepe(S.t, "este") OR Tx.Incepe(S.t, "e ")) THEN
      c := Silogism(s); sub := 2
    END;
    Strings.Copy(s, r);
    RETURN S.Incheie(A, c, pref, r, sursa, sub)
  END Raspunde;


  PROCEDURE Porneste*;   (* il cheama Oul: pe Java, corpul modulului (subdomeniile) ruleaza abia cand modulul e atins prima oara *)
  BEGIN
  END Porneste;

BEGIN
  sub := -1;
  S.Sub(A, 0, "comparatii", "comparații", "mare|mic|egal|compar|diferent|maxim|minim|ordine", "Relație de ordine");
  S.Sub(A, 1, "logica", "logica propozițiilor", "adevarat|fals|atunci|implica|logic|boolean|negati|conjunct|disjunct", "Logică propozițională");
  S.Sub(A, 2, "silogisme", "silogisme", "toti|toate|niciun|unii|silogism|premis|concluz|deduc|rezulta|inferent", "Silogism");
  S.Sub(A, 3, "programare", "programare", "cod|program|functi|variabil|bucla|paranteze|sintax|oberon|python|java|algoritm|bug|compil", "Programare");
  S.Sub(A, 4, "multimi", "mulțimi", "multim|reuniun|intersect|submultim|element|apartin|acolad|vida", "Mulțime");
  S.Sub(A, 5, "argumentare", "argumentare", "argument|sofism|dovad|demonstr|contraargument|eroar|ipotez|paradox", "Argumentare");
  S.Sub(A, 6, "decizii", "decizii", "decizi|alege|alegere|varianta|pro|contra|merita|optiun|risc|dilem", "Teoria deciziei");
  S.Implicit(A, 2)
END ArtaDialectica.

MODULE ArtaRetorica;  (* ¶ Retorica, oul ei (Cubicum 7 v11): ce au scris alții și cum se spune. Șapte subdomenii:
     0 textele cubului · 1 rețeaua (celelalte cuburi, prin Styx) · 2 cristalele (ce ai aprobat cu bun) · 3 citate și proverbe
     4 scrisori și mesaje (felicitări, mulțumiri, scuze, invitații) · 5 discurs · 6 povești *)
  IMPORT Strings, CFS := CubicumFS, Styx, Tx := E7Txt, S := Cub7Solz;

  CONST A = 2; LC = CFS.LC;

  VAR sub*, cuburi*: INTEGER; litera: ARRAY 4 OF ARRAY 2 OF CHAR;

  PROCEDURE TexteCub(VAR raw, sursa: ARRAY OF CHAR): INTEGER;   (* 0: frazele din fisierele .txt ale cubului *)
    VAR i, j, a, sc, best: INTEGER; nm: ARRAY 40 OF CHAR; t: ARRAY LC OF CHAR; fr: ARRAY 300 OF CHAR;
  BEGIN
    raw := ""; sursa := ""; best := 0;
    IF S.nk > 0 THEN
      FOR i := 0 TO CFS.N() - 1 DO
        CFS.Nume(i, nm);
        IF (Strings.Pos(".txt", nm, 0) > 0) & ~Tx.InLista(nm, "drepturi.txt|legaturi.txt|mementouri.txt|incredere10.txt|shell.txt|comenzi.txt") THEN   (* 7·B v14: nu fisierele interne *)
          CFS.Continut(i, t); j := 0;
          WHILE (j < LEN(t)) & (t[j] # 0X) DO
            a := 0;
            WHILE (j < LEN(t)) & (t[j] # 0X) & (t[j] # 0AX) & ~((t[j] = ".") & (j + 1 < LEN(t)) & (t[j + 1] = " ")) & (a < LEN(fr) - 2) DO fr[a] := t[j]; INC(a); INC(j) END;
            IF (j < LEN(t)) & (t[j] = ".") THEN fr[a] := "."; INC(a) END;
            fr[a] := 0X; IF (j < LEN(t)) & (t[j] # 0X) THEN INC(j) END;
            sc := S.Potrivire(fr);
            IF sc > best THEN best := sc; Tx.Copy(fr, raw); Tx.Trim(raw); sursa := "din "; Strings.Append(nm, sursa) END
          END
        END
      END
    END;
    RETURN S.Conf(best)
  END TexteCub;

  PROCEDURE TexteRetea(VAR raw, sursa: ARRAY OF CHAR): INTEGER;   (* 1: fisierele .txt ale celorlalte cuburi (A, B, C, D), prin Styx *)
    VAR i, j, k, p, nf, sc, best: INTEGER; nume: ARRAY 40 OF ARRAY 40 OF CHAR; s: ARRAY 300 OF CHAR;
  BEGIN
    best := 0; cuburi := 0; raw := ""; sursa := "";
    IF S.nk > 0 THEN
      FOR p := 0 TO 3 DO
        Styx.Leaga("127.0.0.1", 7777 + p);
        IF Styx.departe THEN
          INC(cuburi);
          Styx.Ls("/cub"); nf := 0;
          FOR i := 0 TO Styx.nlinii - 1 DO
            Strings.Copy(Styx.linii[i], s); k := 0; WHILE s[k] = " " DO INC(k) END;
            IF (nf < LEN(nume)) & (Strings.Pos(".txt", s, 0) > 0) THEN Strings.Extract(s, k, Strings.Length(s) - k, nume[nf]); INC(nf) END
          END;
          FOR i := 0 TO nf - 1 DO
            s := "/cub/"; Strings.Append(nume[i], s); Styx.Cat(s);
            FOR j := 0 TO Styx.nlinii - 1 DO
              sc := S.Potrivire(Styx.linii[j]);
              IF sc > best THEN
                best := sc; Tx.Copy(Styx.linii[j], raw); Tx.Trim(raw);
                sursa := "din cubul "; Strings.Append(litera[p], sursa); Strings.Append(": ", sursa); Strings.Append(nume[i], sursa)
              END
            END
          END;
          Styx.Dezleaga
        END
      END
    END;
    RETURN S.Conf(best)
  END TexteRetea;

  PROCEDURE Nume(VAR w: ARRAY OF CHAR);   (* cuvantul de dupa „pentru” / „lui” (cui ii scriu), cu majuscula *)
    VAR p, i, k: INTEGER; u: ARRAY 128 OF CHAR;
  BEGIN
    w := ""; Tx.Copy(S.q, u); p := Tx.Pos("pentru ", u, 0);
    IF p < 0 THEN p := Tx.Pos(" lui ", u, 0); IF p >= 0 THEN INC(p, 5) END ELSE INC(p, 7) END;
    IF p >= 0 THEN
      i := p; k := 0;
      WHILE (i < LEN(u)) & Tx.Litera(u[i]) & (k < LEN(w) - 1) DO w[k] := u[i]; INC(k); INC(i) END; w[k] := 0X;
      IF (w = "mama") OR (w = "mamei") THEN w := "mamă" ELSIF (w = "tata") OR (w = "tatei") THEN w := "tată"
      ELSIF Tx.InLista(w, "un|o|unei|unui|el|ea|ei|prieten|prietena|sef|seful|colegi|colega|coleg") THEN w := ""
      ELSIF k > 0 THEN w[0] := Tx.Mare(w[0])
      END
    END
  END Nume;

  PROCEDURE Mesaj(VAR r: ARRAY OF CHAR): BOOLEAN;   (* 4: o ciorna scurta; o poti cere apoi mai frumoasa *)
    VAR w: ARRAY 40 OF CHAR; ok: BOOLEAN;
  BEGIN
    ok := TRUE; Nume(w);
    IF S.Are("felicit") OR S.Are("la multi ani") OR S.Are("aniversar") OR S.Are("zi de nastere") THEN
      r := "La mulți ani"; IF w # "" THEN Strings.Append(", ", r); Strings.Append(w, r) END;
      Strings.Append("! Să ai un an cu sănătate, liniște și cu oameni buni în jur. Mă bucur că ești.", r)
    ELSIF S.Are("multum") THEN
      r := "Mulțumesc"; IF w # "" THEN Strings.Append(", ", r); Strings.Append(w, r) END;
      Strings.Append("! Ce ai făcut a contat pentru mine și n-o să uit.", r)
    ELSIF S.Are("scuz") OR S.Are("iarta") THEN
      r := "Îmi pare rău"; IF w # "" THEN Strings.Append(", ", r); Strings.Append(w, r) END;
      Strings.Append(". Am greșit și înțeleg de ce te-a supărat. Aș vrea să îndrept lucrurile, dacă mă lași.", r)
    ELSIF S.Are("invit") THEN
      r := "Bună"; IF w # "" THEN Strings.Append(", ", r); Strings.Append(w, r) END;
      Strings.Append("! Te aștept [ziua], la ora [ora], la [locul]. Mi-ar plăcea mult să vii. Îmi spui până [data]?", r)
    ELSIF S.Are("condolean") THEN
      r := "Îmi pare nespus de rău pentru pierderea ta. Sunt aici dacă ai nevoie de ceva, oricând."
    ELSE ok := FALSE
    END;
    RETURN ok
  END Mesaj;

  PROCEDURE Raspunde*(VAR r, sursa: ARRAY OF CHAR): INTEGER;
    VAR c, c2, pref, ms: INTEGER; s: ARRAY 400 OF CHAR; so: ARRAY 80 OF CHAR; txt: ARRAY 256 OF CHAR;
  BEGIN
    c := 0; r := ""; sursa := ""; sub := -1; cuburi := 0; pref := S.Unde(A);
    IF (S.Are("scrie") OR S.Are("compune") OR S.Are("mesaj") OR S.Are("text ") OR S.Are("o urare") OR S.Are("un bilet")) & Mesaj(s) THEN
      Strings.Copy(s, r); sursa := "ciornă · cere-mi alta dacă nu-ți place"; sub := 4; c := 1
    ELSE
      c := S.Memorie(7, 0, txt, ms);   (* 2: cristalele, intai *)
      IF c > 0 THEN Strings.Copy(txt, r); sursa := "◆ cristal"; sub := 2; S.Hrana(TRUE) END;
      IF c < 2 THEN
        c2 := TexteCub(s, so);
        IF c2 > c THEN c := c2; Strings.Copy(s, r); Strings.Copy(so, sursa); sub := 0; S.Curat END
      END;
      IF c < 2 THEN
        c2 := TexteRetea(s, so);
        IF c2 > c THEN c := c2; Strings.Copy(s, r); Strings.Copy(so, sursa); sub := 1; S.Curat END
      END
    END;
    RETURN S.Incheie(A, c, pref, r, sursa, sub)
  END Raspunde;


  PROCEDURE Porneste*;   (* il cheama Oul: pe Java, corpul modulului (subdomeniile) ruleaza abia cand modulul e atins prima oara *)
  BEGIN
  END Porneste;

BEGIN
  sub := -1; cuburi := 0;
  litera[0] := "A"; litera[1] := "B"; litera[2] := "C"; litera[3] := "D";
  S.Sub(A, 0, "texte", "textele cubului", "fisier|txt|notit|caiet|jurnal", "");
  S.Sub(A, 1, "retea", "rețeaua", "retea|styx|celelalt|vecin|mesh", "");
  S.Sub(A, 2, "cristale", "cristalele", "cristal|amint|memor|invatat", "");
  S.Sub(A, 3, "citate", "citate și proverbe", "citat|proverb|zicator|zicala|vorba|aforism|maxim|spunea", "Proverbe românești");
  S.Sub(A, 4, "mesaje", "scrisori și mesaje", "scrisoar|mesaj|email|mail|felicit|invit|cerere|salut|bilet|urare|multum|scuz", "Scrisoare");
  S.Sub(A, 5, "discurs", "discurs", "discurs|prezentar|toast|convinge|persuas|oratori|public|auditor|retoric", "Retorică");
  S.Sub(A, 6, "povesti", "povești", "poveste|povest|basm|nuvel|roman|personaj|narat|legend|mit|fabul|eroul", "Basm");
  S.Implicit(A, 3)
END ArtaRetorica.

MODULE ArtaAritmetica;  (* ∑ Aritmetica, oul ei (Cubicum 7 v11): numerele. Șapte subdomenii:
     0 socoteli (2 + 3 * 4) · 1 baze de numerație · 2 numere prime și divizori · 3 procente · 4 bani (dobândă, rata unui credit)
     5 statistică (media, mediana) · 6 conversii (km și mile, kg și livre, °C și °F, metri și picioare, cm și țoli, litri și galoane) *)
  IMPORT Strings, Math, Tx := E7Txt, S := Cub7Solz;

  CONST A = 3;

  VAR sub*: INTEGER; ex: ARRAY 128 OF CHAR; ep: INTEGER; eok, eop: BOOLEAN; exprP: PROCEDURE (): INTEGER;
    un: ARRAY 12 OF ARRAY 40 OF CHAR; unNume: ARRAY 12 OF ARRAY 16 OF CHAR; unF: ARRAY 12 OF REAL;   (* unitatea 2k se schimba cu 2k+1 *)

  PROCEDURE Sare;
  BEGIN WHILE (ep < LEN(ex) - 1) & (ex[ep] = " ") DO INC(ep) END
  END Sare;

  PROCEDURE Factor(): INTEGER;
    VAR v, e, p, i: INTEGER;
  BEGIN
    Sare; v := 0;
    IF ex[ep] = "(" THEN INC(ep); v := exprP(); Sare; IF ex[ep] = ")" THEN INC(ep) ELSE eok := FALSE END
    ELSIF ex[ep] = "-" THEN INC(ep); v := -Factor()
    ELSIF (ex[ep] >= "0") & (ex[ep] <= "9") THEN
      WHILE (ex[ep] >= "0") & (ex[ep] <= "9") DO
        IF v < 100000000 THEN v := v * 10 + ORD(ex[ep]) - ORD("0") ELSE eok := FALSE END; INC(ep)
      END
    ELSE eok := FALSE
    END;
    Sare;
    IF eok & (ex[ep] = "^") THEN
      INC(ep); eop := TRUE; e := Factor(); p := 1; i := 0;
      WHILE eok & (i < e) DO IF ABS(p) < 100000000 THEN p := p * v ELSE eok := FALSE END; INC(i) END;
      v := p
    END;
    RETURN v
  END Factor;

  PROCEDURE Termen(): INTEGER;
    VAR v, b: INTEGER; op: CHAR;
  BEGIN
    v := Factor(); Sare;
    WHILE eok & ((ex[ep] = "*") OR (ex[ep] = "/") OR (ex[ep] = "%")) DO
      op := ex[ep]; INC(ep); eop := TRUE; b := Factor();
      IF op = "*" THEN IF (ABS(v) < 46340) & (ABS(b) < 46340) THEN v := v * b ELSE eok := FALSE END
      ELSIF b = 0 THEN eok := FALSE
      ELSIF op = "/" THEN v := v DIV b
      ELSE v := v MOD b
      END;
      Sare
    END;
    RETURN v
  END Termen;

  PROCEDURE Expr(): INTEGER;
    VAR v, b: INTEGER; op: CHAR;
  BEGIN
    v := Termen(); Sare;
    WHILE eok & ((ex[ep] = "+") OR (ex[ep] = "-")) DO
      op := ex[ep]; INC(ep); eop := TRUE; b := Termen();
      IF op = "+" THEN v := v + b ELSE v := v - b END;
      Sare
    END;
    RETURN v
  END Expr;

  PROCEDURE Baza(n, b: INTEGER; VAR s: ARRAY OF CHAR);   (* n scris in baza b (2..16) *)
    VAR d: ARRAY 40 OF CHAR; k, c: INTEGER; neg: BOOLEAN;
  BEGIN
    neg := n < 0; IF neg THEN n := -n END; k := 0;
    REPEAT c := n MOD b; IF c < 10 THEN d[k] := CHR(ORD("0") + c) ELSE d[k] := CHR(ORD("A") + c - 10) END; INC(k); n := n DIV b UNTIL n = 0;
    s := ""; IF neg THEN Strings.AppendChar("-", s) END;
    WHILE k > 0 DO DEC(k); Strings.AppendChar(d[k], s) END
  END Baza;

  PROCEDURE Baza7(n: INTEGER; VAR s: ARRAY OF CHAR);   (* 7·B: n in baza 7 cu cifrele 1..7 (bijectiva): 14 = 17, 343 = 667; zero n-are cifre *)
    VAR d: ARRAY 40 OF CHAR; k, c: INTEGER; neg: BOOLEAN;
  BEGIN
    s := "";
    IF n = 0 THEN s := "∅ (zero n-are cifre în baza 1–7)"
    ELSE
      neg := n < 0; IF neg THEN n := -n END; k := 0;
      WHILE n > 0 DO c := (n - 1) MOD 7 + 1; d[k] := CHR(ORD("0") + c); INC(k); n := (n - c) DIV 7 END;
      IF neg THEN Strings.AppendChar("-", s) END;
      WHILE k > 0 DO DEC(k); Strings.AppendChar(d[k], s) END
    END
  END Baza7;

  PROCEDURE PrimulNumar(VAR t: ARRAY OF CHAR; de: INTEGER; VAR v, unde: INTEGER): BOOLEAN;
    VAR i: INTEGER; ok: BOOLEAN;
  BEGIN
    i := de; ok := FALSE; v := 0;
    WHILE (i < LEN(t)) & (t[i] # 0X) & ~((t[i] >= "0") & (t[i] <= "9")) DO INC(i) END;
    IF (i < LEN(t)) & (t[i] >= "0") & (t[i] <= "9") THEN
      ok := TRUE;
      WHILE (i < LEN(t)) & (t[i] >= "0") & (t[i] <= "9") DO IF v < 100000000 THEN v := v * 10 + ORD(t[i]) - ORD("0") END; INC(i) END
    END;
    unde := i;
    RETURN ok
  END PrimulNumar;

  PROCEDURE Socoteala(VAR t, r: ARRAY OF CHAR): INTEGER;   (* 0 si 1: o socoteala sau un numar intr-o baza *)
    VAR i, k, v, b, p, u, c: INTEGER; ch: CHAR; s7: ARRAY 40 OF CHAR;
  BEGIN
    r := ""; c := 0; p := Tx.Pos("baza", t, 0);
    IF p >= 0 THEN
      IF PrimulNumar(t, p, b, u) & (b >= 2) & (b <= 16) THEN
        IF PrimulNumar(t, 0, v, u) & (u <= p) THEN
          IF b = 7 THEN Baza7(v, s7) ELSE Baza(v, b, s7) END; Strings.AppendInt(v, 0, r); Strings.Append(" în baza ", r); Strings.AppendInt(b, 0, r);
          IF b = 7 THEN Strings.Append(" (cifrele 1–7)", r) END;
          Strings.Append(" = ", r); Strings.Append(s7, r); c := 2; sub := 1
        END
      END
    END;
    IF c = 0 THEN
      i := 0; WHILE (i < LEN(t)) & (t[i] # 0X) & ~((t[i] >= "0") & (t[i] <= "9") OR (t[i] = "(")) DO INC(i) END;
      k := 0;
      WHILE (i < LEN(t)) & (t[i] # 0X) & (k < LEN(ex) - 1) DO
        ch := t[i];
        IF (ch = "x") OR (ORD(ch) = 0D7H) THEN ch := "*" ELSIF ch = ":" THEN ch := "/" END;
        IF (ch >= "0") & (ch <= "9") OR (ch = "+") OR (ch = "-") OR (ch = "*") OR (ch = "/") OR (ch = "%") OR (ch = "^")
          OR (ch = "(") OR (ch = ")") OR (ch = " ") THEN ex[k] := ch; INC(k); INC(i)
        ELSE i := LEN(t)
        END
      END;
      ex[k] := 0X;
      IF k > 0 THEN
        ep := 0; eok := TRUE; eop := FALSE; v := Expr(); Sare;
        IF eok & eop & (ex[ep] = 0X) THEN
          Tx.Trim(ex); Strings.Append(ex, r); Strings.Append(" = ", r); Strings.AppendInt(v, 0, r);
          Baza7(v, s7); Strings.Append(" · în baza 7 (1–7): ", r); Strings.Append(s7, r); c := 2; sub := 0
        END
      END
    END;
    RETURN c
  END Socoteala;

  PROCEDURE Cmmdc(a, b: INTEGER): INTEGER;
    VAR x: INTEGER;
  BEGIN a := ABS(a); b := ABS(b); WHILE b # 0 DO x := a MOD b; a := b; b := x END; RETURN a
  END Cmmdc;

  PROCEDURE Prime(VAR t, r: ARRAY OF CHAR): INTEGER;   (* 2: e prim? divizorii, factorii, cmmdc, cmmmc *)
    VAR c, n, m, u, d, k, x: INTEGER; prim: BOOLEAN;
  BEGIN
    c := 0; r := "";
    IF PrimulNumar(t, 0, n, u) & (n >= 1) THEN
      IF (Tx.Contine(t, "cmmdc") OR Tx.Contine(t, "cel mai mare divizor") OR Tx.Contine(t, "cmmmc") OR Tx.Contine(t, "cel mai mic multiplu"))
        & PrimulNumar(t, u, m, u) & (m >= 1) THEN
        d := Cmmdc(n, m);
        r := "cmmdc("; Strings.AppendInt(n, 0, r); Strings.Append(", ", r); Strings.AppendInt(m, 0, r); Strings.Append(") = ", r); Strings.AppendInt(d, 0, r);
        IF n DIV d <= 2147483647 DIV m THEN
          Strings.Append(" · cmmmc = ", r); Strings.AppendInt(n DIV d * m, 0, r)
        END;
        c := 2
      ELSIF Tx.Contine(t, "divizor") THEN
        r := "divizorii lui "; Strings.AppendInt(n, 0, r); Strings.Append(": ", r); k := 0; d := 1;
        WHILE (d <= n) & (k < 60) & (d <= 1000000) DO
          IF n MOD d = 0 THEN IF k > 0 THEN Strings.Append(", ", r) END; Strings.AppendInt(d, 0, r); INC(k) END; INC(d)
        END;
        IF d <= n THEN Strings.Append(" …", r) END; c := 2
      ELSIF Tx.Contine(t, "factor") OR Tx.Contine(t, "descompun") THEN
        r := ""; Strings.AppendInt(n, 0, r); Strings.Append(" = ", r); x := n; d := 2; k := 0;
        WHILE (x > 1) & (d <= 46340) & (d * d <= x) DO
          IF x MOD d = 0 THEN IF k > 0 THEN Strings.Append(" × ", r) END; Strings.AppendInt(d, 0, r); x := x DIV d; INC(k) ELSE INC(d) END
        END;
        IF x > 1 THEN IF k > 0 THEN Strings.Append(" × ", r) END; Strings.AppendInt(x, 0, r) END;
        IF n = 1 THEN Strings.Append("1", r) END; c := 2
      ELSIF Tx.Contine(t, "prim") THEN
        prim := n >= 2; d := 2;
        WHILE prim & (d <= 46340) & (d * d <= n) DO IF n MOD d = 0 THEN prim := FALSE ELSE INC(d) END END;
        Strings.AppendInt(n, 0, r);
        IF prim THEN Strings.Append(" e număr prim", r)
        ELSIF n < 2 THEN Strings.Append(" nu e prim (primele încep de la 2)", r)
        ELSE Strings.Append(" nu e prim: se împarte la ", r); Strings.AppendInt(d, 0, r)
        END;
        c := 2
      ELSIF Tx.Contine(t, " par") OR Tx.Contine(t, "impar") THEN
        Strings.AppendInt(n, 0, r); IF n MOD 2 = 0 THEN Strings.Append(" e par", r) ELSE Strings.Append(" e impar", r) END; c := 2
      END
    END;
    RETURN c
  END Prime;

  PROCEDURE Felul(VAR t: ARRAY OF CHAR; VAR x: ARRAY OF REAL; VAR fel: ARRAY OF INTEGER; VAR n: INTEGER);   (* numerele si ce urmeaza dupa ele:
      fel 1 = procent (%, la suta), 2 = ani, 3 = luni, 0 = altceva *)
    VAR i, j: INTEGER; v, f: REAL;
  BEGIN
    n := 0; i := 0;
    WHILE (i < LEN(t) - 1) & (t[i] # 0X) & (n < LEN(x)) DO
      IF (t[i] >= "0") & (t[i] <= "9") THEN
        v := 0.0;
        WHILE (i < LEN(t) - 1) & (t[i] >= "0") & (t[i] <= "9") DO v := v * 10.0 + FLT(ORD(t[i]) - ORD("0")); INC(i) END;
        IF (i < LEN(t) - 2) & ((t[i] = ",") OR (t[i] = ".")) & (t[i + 1] >= "0") & (t[i + 1] <= "9") THEN
          INC(i); f := 0.1;
          WHILE (i < LEN(t) - 1) & (t[i] >= "0") & (t[i] <= "9") DO v := v + f * FLT(ORD(t[i]) - ORD("0")); f := f / 10.0; INC(i) END
        END;
        j := i; WHILE (j < LEN(t) - 1) & (t[j] = " ") DO INC(j) END;
        IF Tx.IncepeLa(t, j, "de ") THEN INC(j, 3) END;   (* 20 de ani *)
        x[n] := v; fel[n] := 0;
        IF (t[j] = "%") OR Tx.IncepeLa(t, j, "la suta") OR Tx.IncepeLa(t, j, "procent") THEN fel[n] := 1
        ELSIF Tx.IncepeLa(t, j, "an") THEN fel[n] := 2
        ELSIF Tx.IncepeLa(t, j, "lun") THEN fel[n] := 3
        END;
        INC(n)
      ELSE INC(i)
      END
    END
  END Felul;

  PROCEDURE Procente(VAR t, r: ARRAY OF CHAR): INTEGER;   (* 3: X% din Y · cat la suta e X din Y · Y crescut / scazut cu X% *)
    VAR c, n, k: INTEGER; x: ARRAY 6 OF REAL; fel: ARRAY 6 OF INTEGER; p, b: REAL;
  BEGIN
    c := 0; r := ""; Felul(t, x, fel, n);
    IF n >= 2 THEN
      p := x[0]; b := x[1];
      FOR k := 0 TO n - 1 DO IF fel[k] = 1 THEN p := x[k]; IF k = 0 THEN b := x[1] ELSE b := x[0] END END END;
      IF Tx.Contine(t, "cat la suta") OR Tx.Contine(t, "ce procent") OR Tx.Contine(t, "cate procente") THEN
        IF x[1] # 0.0 THEN S.Nr(x[0], r); Strings.Append(" din ", r); S.Nr(x[1], r); Strings.Append(" înseamnă ", r); S.Nr(x[0] / x[1] * 100.0, r); Strings.Append("%", r); c := 2 END
      ELSIF Tx.Contine(t, "creste") OR Tx.Contine(t, "plus") OR Tx.Contine(t, "adaos") OR Tx.Contine(t, "tva") OR Tx.Contine(t, "scump") THEN
        S.Nr(b, r); Strings.Append(" + ", r); S.Nr(p, r); Strings.Append("% = ", r); S.Nr(b * (1.0 + p / 100.0), r); c := 2
      ELSIF Tx.Contine(t, "reducer") OR Tx.Contine(t, "scade") OR Tx.Contine(t, "minus") OR Tx.Contine(t, "ieftin") OR Tx.Contine(t, "discount") THEN
        S.Nr(b, r); Strings.Append(" − ", r); S.Nr(p, r); Strings.Append("% = ", r); S.Nr(b * (1.0 - p / 100.0), r);
        Strings.Append(" (economisești ", r); S.Nr(b * p / 100.0, r); Strings.Append(")", r); c := 2
      ELSE
        S.Nr(p, r); Strings.Append("% din ", r); S.Nr(b, r); Strings.Append(" = ", r); S.Nr(p * b / 100.0, r); c := 2
      END
    END;
    RETURN c
  END Procente;

  PROCEDURE Bani(VAR t, r: ARRAY OF CHAR): INTEGER;   (* 4: dobanda compusa · rata lunara a unui credit (anuitati) *)
    VAR c, n, k, luni: INTEGER; x: ARRAY 6 OF REAL; fel: ARRAY 6 OF INTEGER; p, d, ani, rl, ra, tot: REAL;
  BEGIN
    c := 0; r := ""; Felul(t, x, fel, n); p := 0.0; d := -1.0; ani := -1.0;
    FOR k := 0 TO n - 1 DO
      IF fel[k] = 1 THEN d := x[k] ELSIF fel[k] = 2 THEN ani := x[k] ELSIF fel[k] = 3 THEN ani := x[k] / 12.0 ELSIF x[k] > p THEN p := x[k] END
    END;
    IF (d > 0.0) & (ani > 0.0) & (p > 0.0) THEN
      IF Tx.Contine(t, "credit") OR Tx.Contine(t, "rata") OR Tx.Contine(t, "imprumut") OR Tx.Contine(t, "ipotec") THEN
        rl := d / 1200.0; luni := FLOOR(ani * 12.0 + 0.5);
        ra := p * rl / (1.0 - Math.power(-FLT(luni), 1.0 + rl)); tot := ra * FLT(luni);
        r := "creditul de "; S.Nr(p, r); Strings.Append(" cu dobânda de ", r); S.Nr(d, r); Strings.Append("% pe an, pe ", r); Strings.AppendInt(luni, 0, r);
        Strings.Append(" de luni: rata ≈ ", r); S.Nr(ra, r); Strings.Append(" · dai înapoi ", r); S.Nr(tot, r);
        Strings.Append(" (dobânda ", r); S.Nr(tot - p, r); Strings.Append(")", r); c := 2
      ELSE
        tot := p * Math.power(ani, 1.0 + d / 100.0);
        r := ""; S.Nr(p, r); Strings.Append(" cu dobânda de ", r); S.Nr(d, r); Strings.Append("% pe an, după ", r); S.Nr(ani, r);
        Strings.Append(" ani (dobândă la dobândă) ajung ", r); S.Nr(tot, r); Strings.Append(" · câștigul: ", r); S.Nr(tot - p, r); c := 2
      END
    END;
    RETURN c
  END Bani;

  PROCEDURE Statistica(VAR t, r: ARRAY OF CHAR): INTEGER;   (* 5: media, mediana, minim, maxim, abaterea *)
    VAR c, n, i, j: INTEGER; x: ARRAY 40 OF REAL; s, m, v, y: REAL;
  BEGIN
    c := 0; r := ""; S.Numere(t, x, n);
    IF n >= 2 THEN
      s := 0.0; FOR i := 0 TO n - 1 DO s := s + x[i] END; m := s / FLT(n);
      v := 0.0; FOR i := 0 TO n - 1 DO v := v + (x[i] - m) * (x[i] - m) END; v := Math.sqrt(v / FLT(n));
      FOR i := 1 TO n - 1 DO y := x[i]; j := i; WHILE (j > 0) & (x[j - 1] > y) DO x[j] := x[j - 1]; DEC(j) END; x[j] := y END;
      r := ""; Strings.AppendInt(n, 0, r); Strings.Append(" numere · media ", r); S.Nr(m, r); Strings.Append(" · mediana ", r);
      IF n MOD 2 = 1 THEN S.Nr(x[n DIV 2], r) ELSE S.Nr((x[n DIV 2 - 1] + x[n DIV 2]) / 2.0, r) END;
      Strings.Append(" · între ", r); S.Nr(x[0], r); Strings.Append(" și ", r); S.Nr(x[n - 1], r);
      Strings.Append(" · suma ", r); S.Nr(s, r); Strings.Append(" · abaterea ", r); S.Nr(v, r); c := 2
    END;
    RETURN c
  END Statistica;

  PROCEDURE Unitate(VAR t: ARRAY OF CHAR; i: INTEGER): INTEGER;   (* unde apare unitatea i in text; -1 = nu apare *)
    VAR k, j, p, best: INTEGER; r: ARRAY 16 OF CHAR;
  BEGIN
    best := -1; k := 0;
    WHILE un[i][k] # 0X DO
      j := 0; WHILE (un[i][k] # 0X) & (un[i][k] # "|") DO r[j] := un[i][k]; INC(j); INC(k) END; r[j] := 0X;
      IF un[i][k] = "|" THEN INC(k) END;
      p := Tx.Pos(r, t, 0);
      WHILE (p >= 0) & ~(((p = 0) OR ~Tx.Litera(t[p - 1])) & ((j >= 4) OR ~Tx.Litera(t[p + j]))) DO p := Tx.Pos(r, t, p + 1) END;
      IF (p >= 0) & ((best < 0) OR (p < best)) THEN best := p END
    END;
    RETURN best
  END Unitate;

  PROCEDURE Conversie(VAR t, r: ARRAY OF CHAR): INTEGER;   (* 6: din unitatea scrisa prima (dupa numar) in pereche *)
    VAR c, n, i, p, bi, bp, d: INTEGER; x: ARRAY 4 OF REAL; v: REAL;
  BEGIN
    c := 0; r := ""; S.Numere(t, x, n);
    IF n >= 1 THEN
      bi := -1; bp := 10000;
      FOR i := 0 TO 11 DO p := Unitate(t, i); IF (p >= 0) & (p < bp) THEN bp := p; bi := i END END;
      IF bi >= 0 THEN
        IF bi MOD 2 = 0 THEN d := bi + 1 ELSE d := bi - 1 END;
        IF bi = 4 THEN v := x[0] * 9.0 / 5.0 + 32.0
        ELSIF bi = 5 THEN v := (x[0] - 32.0) * 5.0 / 9.0
        ELSIF bi MOD 2 = 0 THEN v := x[0] / unF[bi]
        ELSE v := x[0] * unF[d]
        END;
        S.Nr(x[0], r); Strings.Append(" ", r); Strings.Append(unNume[bi], r); Strings.Append(" = ", r); S.Nr(v, r);
        Strings.Append(" ", r); Strings.Append(unNume[d], r); c := 2
      END
    END;
    RETURN c
  END Conversie;

  PROCEDURE Raspunde*(VAR r, sursa: ARRAY OF CHAR): INTEGER;
    VAR c, pref: INTEGER; t: ARRAY 200 OF CHAR; s: ARRAY 400 OF CHAR;
  BEGIN
    c := 0; r := ""; sursa := ""; sub := -1; pref := S.Unde(A); Tx.Copy(S.t, t); s := "";
    IF pref = 6 THEN c := Conversie(t, s); IF c > 0 THEN sub := 6 END END;
    IF (c = 0) & (pref = 4) THEN c := Bani(t, s); IF c > 0 THEN sub := 4 END END;
    IF (c = 0) & (Tx.Contine(t, "%") OR Tx.Contine(t, "la suta") OR Tx.Contine(t, "procent")) THEN c := Procente(t, s); IF c > 0 THEN sub := 3 END END;
    IF (c = 0) & (pref = 5) THEN c := Statistica(t, s); IF c > 0 THEN sub := 5 END END;
    IF (c = 0) & (pref = 2) THEN c := Prime(t, s); IF c > 0 THEN sub := 2 END END;
    IF c = 0 THEN c := Socoteala(t, s) END;
    Strings.Copy(s, r);
    RETURN S.Incheie(A, c, pref, r, sursa, sub)
  END Raspunde;


  PROCEDURE Porneste*;   (* il cheama Oul: pe Java, corpul modulului (subdomeniile) ruleaza abia cand modulul e atins prima oara *)
  BEGIN
  END Porneste;

BEGIN
  sub := -1; exprP := Expr;
  un[0] := "km|kilometr"; unNume[0] := "km"; un[1] := "mile|mila"; unNume[1] := "mile"; unF[0] := 1.609344;
  un[2] := "kg|kilogram"; unNume[2] := "kg"; un[3] := "livre|livra|lb|pound"; unNume[3] := "livre"; unF[2] := 0.45359237;
  un[4] := "celsius|grade c"; unNume[4] := "°C"; un[5] := "fahrenheit|grade f"; unNume[5] := "°F"; unF[4] := 1.0;
  un[6] := "metri|metru|metrii"; unNume[6] := "m"; un[7] := "picioare|picior|feet|ft"; unNume[7] := "picioare"; unF[6] := 0.3048;
  un[8] := "cm|centimetr"; unNume[8] := "cm"; un[9] := "toli|tol|inch|inci"; unNume[9] := "țoli"; unF[8] := 2.54;
  un[10] := "litri|litru|litrii"; unNume[10] := "l"; un[11] := "galoane|galon|gallon"; unNume[11] := "galoane"; unF[10] := 3.785411784;
  unF[1] := 0.0; unF[3] := 0.0; unF[5] := 0.0; unF[7] := 0.0; unF[9] := 0.0; unF[11] := 0.0;
  S.Sub(A, 0, "socoteli", "socoteli", "plus|minus|ori|impart|aduna|scad|inmult|calcul|socot|egal|rezultat", "Aritmetică");
  S.Sub(A, 1, "baze", "baze de numerație", "baza|binar|hexa|octal|zecimal|cifr|numeratie", "Sistem de numerație");
  S.Sub(A, 2, "prime", "prime și divizori", "prim|divizor|divide|multipl|cmmdc|cmmmc|factor|descompun|par|impar", "Număr prim");
  S.Sub(A, 3, "procente", "procente", "procent|suta|reducer|adaos|tva|discount|scumpi|ieftin", "Procent");
  S.Sub(A, 4, "bani", "bani", "dobanda|credit|rata|imprumut|depozit|economi|bani|lei|euro|dolar|investit|ipotec|buget|salariu", "Dobândă");
  S.Sub(A, 5, "statistica", "statistică", "medi|median|statist|abatere|suma|total|frecvent|sondaj|probabil", "Statistică");
  S.Sub(A, 6, "conversii", "conversii", "km|kilometr|mile|mila|kilogram|kg|livre|lb|celsius|fahrenheit|metri|picioare|toli|inch|litri|galoane|convert|transform", "Sistemul internațional de unități");
  S.Implicit(A, 0)
END ArtaAritmetica.

MODULE ArtaGeometria;  (* △ Geometria, oul ei (Cubicum 7 v11): formele și locurile. Șapte subdomenii:
     0 torul Z₇ (pași între celule) · 1 figuri plane · 2 corpuri · 3 trigonometrie (sin, cos, Pitagora, radical)
     4 șantier (plăci, vopsea, beton, cărămizi) · 5 coordonate (puncte, GPS) · 6 proporții (secțiunea de aur, scara, Fibonacci) *)
  IMPORT Strings, Math, Tx := E7Txt, S := Cub7Solz;

  CONST A = 4; PI = 3.14159265; RAD = 0.017453293;   (* 7·B: adresele torului se scriu 1.1.1 ... 7.7.7 *)

  VAR sub*: INTEGER;

  PROCEDURE Celule(VAR t: ARRAY OF CHAR; VAR a, b: ARRAY OF INTEGER; VAR dim: INTEGER): INTEGER;   (* cate adrese x.y.z (cifre 0..6) are textul *)
    VAR i, k, n, j, m: INTEGER; d: ARRAY 7 OF INTEGER;
  BEGIN
    n := 0; i := 0; dim := 0;
    WHILE (i < LEN(t) - 2) & (t[i] # 0X) DO
      IF (t[i] >= "1") & (t[i] <= "7") & ((i = 0) OR ~((t[i - 1] >= "0") & (t[i - 1] <= "9"))) & (t[i + 1] = ".") THEN   (* 7·B: 1..7 *)
        k := 0; j := i;
        WHILE (k < 7) & (j < LEN(t) - 2) & (t[j] >= "1") & (t[j] <= "7") & ((t[j + 1] = ".") OR ~((t[j + 1] >= "0") & (t[j + 1] <= "9"))) DO
          d[k] := ORD(t[j]) - ORD("1"); INC(k); INC(j); IF t[j] = "." THEN INC(j) END
        END;
        IF k >= 3 THEN
          IF n = 0 THEN FOR m := 0 TO k - 1 DO a[m] := d[m] END; dim := k ELSIF (n = 1) & (k = dim) THEN FOR m := 0 TO k - 1 DO b[m] := d[m] END END;
          INC(n); i := j
        ELSE INC(i)
        END
      ELSE INC(i)
      END
    END;
    RETURN n
  END Celule;

  PROCEDURE Tor(VAR t, s: ARRAY OF CHAR): INTEGER;   (* 0 *)
    VAR c, k, dim, sum, mx, d: INTEGER; a, b: ARRAY 7 OF INTEGER;
  BEGIN
    c := 0;
    IF (Celule(t, a, b, dim) >= 2) & (Tx.Contine(t, "distant") OR Tx.Contine(t, "departe") OR Tx.Contine(t, "pasi") OR Tx.Contine(t, "intre")) THEN
      sum := 0; mx := 0; s := "pe torul Z₇, pe fiecare axă: (";
      FOR k := 0 TO dim - 1 DO
        d := ABS(a[k] - b[k]); IF 7 - d < d THEN d := 7 - d END;
        sum := sum + d; IF d > mx THEN mx := d END;
        IF k > 0 THEN Strings.Append(", ", s) END; Strings.AppendInt(d, 0, s)
      END;
      Strings.Append(") · pași în cub: ", s); Strings.AppendInt(sum, 0, s); Strings.Append(" · pe diagonală: ", s); Strings.AppendInt(mx, 0, s);
      Strings.Append(" (pe tor, cel mai departe e 3 pe o axă)", s); c := 2
    END;
    RETURN c
  END Tor;

  PROCEDURE Forme(VAR t, s: ARRAY OF CHAR; VAR x: ARRAY OF REAL; n: INTEGER): INTEGER;   (* 1 si 2: figurile si corpurile *)
    VAR c: INTEGER; r, l, h, p: REAL; toate: BOOLEAN;
  BEGIN
    c := 0; r := 0.0; l := 0.0; h := 0.0;
    toate := ~(Tx.Contine(t, "arie") OR Tx.Contine(t, "aria") OR Tx.Contine(t, "suprafat") OR Tx.Contine(t, "perimetr") OR Tx.Contine(t, "circumferint")
      OR Tx.Contine(t, "volum") OR Tx.Contine(t, "diagonal"));
    IF n >= 1 THEN r := x[0]; l := x[0]; IF n >= 2 THEN h := x[1] ELSE h := x[0] END END;
    IF (n >= 1) & Tx.Contine(t, "diametr") THEN r := r / 2.0 END;
    IF n = 0 THEN
    ELSIF Tx.Contine(t, "cerc") OR Tx.Contine(t, "disc") THEN
      s := "cercul cu raza "; S.Nr(r, s);
      IF toate OR Tx.Contine(t, "ari") OR Tx.Contine(t, "suprafat") THEN Strings.Append(" · aria πr² = ", s); S.Nr(PI * r * r, s) END;
      IF toate OR Tx.Contine(t, "perimetr") OR Tx.Contine(t, "circumferint") THEN Strings.Append(" · lungimea 2πr = ", s); S.Nr(2.0 * PI * r, s) END; c := 2; sub := 1
    ELSIF Tx.Contine(t, "patrat") THEN
      s := "pătratul cu latura "; S.Nr(l, s);
      IF toate OR Tx.Contine(t, "ari") OR Tx.Contine(t, "suprafat") THEN Strings.Append(" · aria = ", s); S.Nr(l * l, s) END;
      IF toate OR Tx.Contine(t, "perimetr") THEN Strings.Append(" · perimetrul = ", s); S.Nr(4.0 * l, s) END;
      IF toate OR Tx.Contine(t, "diagonal") THEN Strings.Append(" · diagonala = ", s); S.Nr(l * Math.sqrt(2.0), s) END; c := 2; sub := 1
    ELSIF Tx.Contine(t, "dreptunghi") & (n >= 2) THEN
      s := "dreptunghiul "; S.Nr(x[0], s); Strings.Append(" × ", s); S.Nr(x[1], s);
      IF toate OR Tx.Contine(t, "ari") OR Tx.Contine(t, "suprafat") THEN Strings.Append(" · aria = ", s); S.Nr(x[0] * x[1], s) END;
      IF toate OR Tx.Contine(t, "perimetr") THEN Strings.Append(" · perimetrul = ", s); S.Nr(2.0 * (x[0] + x[1]), s) END;
      IF toate OR Tx.Contine(t, "diagonal") THEN Strings.Append(" · diagonala = ", s); S.Nr(Math.sqrt(x[0] * x[0] + x[1] * x[1]), s) END; c := 2; sub := 1
    ELSIF Tx.Contine(t, "trapez") & (n >= 3) THEN
      s := "trapezul cu bazele "; S.Nr(x[0], s); Strings.Append(" și ", s); S.Nr(x[1], s); Strings.Append(", înălțimea ", s); S.Nr(x[2], s);
      Strings.Append(" · aria = ", s); S.Nr((x[0] + x[1]) * x[2] / 2.0, s); c := 2; sub := 1
    ELSIF Tx.Contine(t, "romb") & (n >= 2) THEN
      s := "rombul cu diagonalele "; S.Nr(x[0], s); Strings.Append(" și ", s); S.Nr(x[1], s);
      Strings.Append(" · aria = ", s); S.Nr(x[0] * x[1] / 2.0, s);
      Strings.Append(" · latura = ", s); S.Nr(Math.sqrt(x[0] * x[0] + x[1] * x[1]) / 2.0, s); c := 2; sub := 1
    ELSIF Tx.Contine(t, "triunghi") THEN
      IF n >= 3 THEN
        p := (x[0] + x[1] + x[2]) / 2.0; h := p * (p - x[0]) * (p - x[1]) * (p - x[2]);
        s := "triunghiul cu laturile "; S.Nr(x[0], s); Strings.Append(", ", s); S.Nr(x[1], s); Strings.Append(", ", s); S.Nr(x[2], s);
        IF h > 0.0 THEN Strings.Append(" · aria (Heron) = ", s); S.Nr(Math.sqrt(h), s) ELSE Strings.Append(" · nu se poate închide", s) END;
        Strings.Append(" · perimetrul = ", s); S.Nr(2.0 * p, s); c := 2; sub := 1
      ELSIF n = 2 THEN s := "triunghiul cu baza "; S.Nr(x[0], s); Strings.Append(" și înălțimea ", s); S.Nr(x[1], s); Strings.Append(" · aria = ", s); S.Nr(x[0] * x[1] / 2.0, s); c := 2; sub := 1
      END
    ELSIF Tx.Contine(t, "cub") & ~Tx.Contine(t, "cubicum") & ~Tx.Contine(t, "cubul a") THEN
      s := "cubul cu latura "; S.Nr(l, s);
      IF toate OR Tx.Contine(t, "volum") THEN Strings.Append(" · volumul = ", s); S.Nr(l * l * l, s) END;
      IF toate OR Tx.Contine(t, "ari") OR Tx.Contine(t, "suprafat") THEN Strings.Append(" · aria = ", s); S.Nr(6.0 * l * l, s) END;
      IF toate OR Tx.Contine(t, "diagonal") THEN Strings.Append(" · diagonala = ", s); S.Nr(l * Math.sqrt(3.0), s) END; c := 2; sub := 2
    ELSIF Tx.Contine(t, "sfer") THEN
      s := "sfera cu raza "; S.Nr(r, s);
      IF toate OR Tx.Contine(t, "volum") THEN Strings.Append(" · volumul 4πr³/3 = ", s); S.Nr(4.0 * PI * r * r * r / 3.0, s) END;
      IF toate OR Tx.Contine(t, "ari") OR Tx.Contine(t, "suprafat") THEN Strings.Append(" · aria 4πr² = ", s); S.Nr(4.0 * PI * r * r, s) END; c := 2; sub := 2
    ELSIF Tx.Contine(t, "cilindr") & (n >= 2) THEN
      s := "cilindrul cu raza "; S.Nr(r, s); Strings.Append(" și înălțimea ", s); S.Nr(h, s);
      Strings.Append(" · volumul πr²h = ", s); S.Nr(PI * r * r * h, s); Strings.Append(" · aria = ", s); S.Nr(2.0 * PI * r * (r + h), s); c := 2; sub := 2
    ELSIF (S.Cuv("con") OR Tx.Contine(t, "conul")) & (n >= 2) THEN
      s := "conul cu raza "; S.Nr(r, s); Strings.Append(" și înălțimea ", s); S.Nr(h, s);
      Strings.Append(" · volumul πr²h/3 = ", s); S.Nr(PI * r * r * h / 3.0, s);
      Strings.Append(" · generatoarea = ", s); S.Nr(Math.sqrt(r * r + h * h), s); c := 2; sub := 2
    ELSIF Tx.Contine(t, "piramid") & (n >= 2) THEN
      s := "piramida cu baza pătrată de latură "; S.Nr(x[0], s); Strings.Append(" și înălțimea ", s); S.Nr(x[1], s);
      Strings.Append(" · volumul = ", s); S.Nr(x[0] * x[0] * x[1] / 3.0, s); c := 2; sub := 2
    ELSIF (Tx.Contine(t, "paralelipiped") OR Tx.Contine(t, "cutie") OR Tx.Contine(t, "cuboid")) & (n >= 3) THEN
      s := "paralelipipedul "; S.Nr(x[0], s); Strings.Append(" × ", s); S.Nr(x[1], s); Strings.Append(" × ", s); S.Nr(x[2], s);
      Strings.Append(" · volumul = ", s); S.Nr(x[0] * x[1] * x[2], s);
      Strings.Append(" · aria = ", s); S.Nr(2.0 * (x[0] * x[1] + x[1] * x[2] + x[0] * x[2]), s); c := 2; sub := 2
    END;
    RETURN c
  END Forme;

  PROCEDURE Trig(VAR t, s: ARRAY OF CHAR; VAR x: ARRAY OF REAL; n: INTEGER): INTEGER;   (* 3 *)
    VAR c: INTEGER; u: REAL;
  BEGIN
    c := 0;
    IF n = 0 THEN
    ELSIF Tx.Contine(t, "radical") OR Tx.Contine(t, "radacina") THEN
      IF x[0] >= 0.0 THEN s := "√"; S.Nr(x[0], s); Strings.Append(" = ", s); S.Nr(Math.sqrt(x[0]), s); c := 2 END
    ELSIF (Tx.Contine(t, "pitagora") OR Tx.Contine(t, "ipotenuz") OR Tx.Contine(t, "catet")) & (n >= 2) THEN
      s := "ipotenuza = √("; S.Nr(x[0], s); Strings.Append("² + ", s); S.Nr(x[1], s); Strings.Append("²) = ", s); S.Nr(Math.sqrt(x[0] * x[0] + x[1] * x[1]), s);
      IF x[1] > x[0] THEN Strings.Append(" · iar dacă ", s); S.Nr(x[1], s); Strings.Append(" e ipotenuza, cateta = ", s); S.Nr(Math.sqrt(x[1] * x[1] - x[0] * x[0]), s) END;
      c := 2
    ELSIF S.Cuv("sin") OR S.Cuv("cos") OR S.Cuv("tg") OR S.Cuv("tan") OR S.Cuv("sinus") OR S.Cuv("cosinus") OR S.Cuv("tangent") THEN
      u := x[0] * RAD; IF Tx.Contine(t, "radian") THEN u := x[0] END;
      s := "pentru "; S.Nr(x[0], s); IF Tx.Contine(t, "radian") THEN Strings.Append(" rad", s) ELSE Strings.Append("°", s) END;
      Strings.Append(": sin = ", s); S.Nr(Math.sin(u), s); Strings.Append(" · cos = ", s); S.Nr(Math.cos(u), s);
      IF ABS(Math.cos(u)) > 0.0001 THEN Strings.Append(" · tg = ", s); S.Nr(Math.sin(u) / Math.cos(u), s) END;
      c := 2
    ELSIF Tx.Contine(t, "radian") & Tx.Contine(t, "grad") THEN
      S.Nr(x[0], s); IF Tx.Pos("grad", t, 0) < Tx.Pos("radian", t, 0) THEN Strings.Append("° = ", s); S.Nr(x[0] * RAD, s); Strings.Append(" rad", s)
      ELSE Strings.Append(" rad = ", s); S.Nr(x[0] / RAD, s); Strings.Append("°", s) END;
      c := 2
    END;
    RETURN c
  END Trig;

  PROCEDURE Santier(VAR t, s: ARRAY OF CHAR; VAR x: ARRAY OF REAL; n: INTEGER): INTEGER;   (* 4: placi, vopsea, beton, caramizi *)
    VAR c, k: INTEGER; arie, pl, v: REAL;
  BEGIN
    c := 0;
    IF (Tx.Contine(t, "plac") OR Tx.Contine(t, "gresie") OR Tx.Contine(t, "faiant") OR Tx.Contine(t, "parchet") OR Tx.Contine(t, "dale")) & (n >= 3) THEN
      IF n >= 4 THEN   (* doua perechi: cea mica in metri (camera), cea mare in cm (placa) *)
        IF x[0] * x[1] < x[2] * x[3] THEN arie := x[0] * x[1]; pl := x[2] * x[3] ELSE arie := x[2] * x[3]; pl := x[0] * x[1] END
      ELSE arie := x[0] * x[1]; pl := x[2] * x[2]
      END;
      IF pl > 0.0 THEN
        k := FLOOR(arie * 10000.0 / pl * 1.1 + 0.999);
        s := "suprafața: "; S.Nr(arie, s); Strings.Append(" m² · o placă: ", s); S.Nr(pl, s); Strings.Append(" cm² · îți trebuie ≈ ", s);
        Strings.AppendInt(k, 0, s); Strings.Append(" plăci (cu 10% pentru tăieturi și spărturi)", s); c := 2
      END
    ELSIF (Tx.Contine(t, "vopsea") OR Tx.Contine(t, "lavabil") OR Tx.Contine(t, "zugrav")) & (n >= 2) THEN
      arie := x[0] * x[1]; IF n >= 3 THEN arie := arie * x[2] END;
      s := "suprafața: "; S.Nr(arie, s); Strings.Append(" m² · la 2 straturi, cu ~1 litru la 10 m² pe strat: ≈ ", s); S.Nr(arie * 2.0 / 10.0, s);
      Strings.Append(" litri (citește și cutia: unele acoperă 12–14 m² pe litru)", s); c := 2
    ELSIF (Tx.Contine(t, "beton") OR Tx.Contine(t, "sapa") OR Tx.Contine(t, "fundati")) & (n >= 3) THEN
      v := x[0] * x[1] * x[2];
      s := "volumul: "; S.Nr(v, s); Strings.Append(" m³ · la ~300 kg ciment pe m³: ≈ ", s); Strings.AppendInt(FLOOR(v * 300.0 / 40.0 + 0.999), 0, s);
      Strings.Append(" saci de 40 kg (plus nisip și pietriș)", s); c := 2
    ELSIF (Tx.Contine(t, "caramiz") OR Tx.Contine(t, "bca") OR Tx.Contine(t, "blocuri")) & (n >= 2) THEN
      arie := x[0] * x[1];
      s := "zidul: "; S.Nr(arie, s); Strings.Append(" m² · cărămizi pline (24 × 11,5 × 6,3), zid de 11,5 cm: ≈ ", s); Strings.AppendInt(FLOOR(arie * 51.0 + 0.999), 0, s);
      Strings.Append(" · zid de 24 cm: ≈ ", s); Strings.AppendInt(FLOOR(arie * 102.0 + 0.999), 0, s); c := 2
    END;
    RETURN c
  END Santier;

  PROCEDURE Coordonate(VAR t, s: ARRAY OF CHAR; VAR x: ARRAY OF REAL; n: INTEGER): INTEGER;   (* 5: doua puncte; GPS = pe Pamant *)
    VAR c: INTEGER; dx, dy, a, d: REAL;
  BEGIN
    c := 0;
    IF n >= 4 THEN
      IF Tx.Contine(t, "gps") OR Tx.Contine(t, "latitudin") OR Tx.Contine(t, "longitudin") OR Tx.Contine(t, "geografic") THEN
        dx := (x[2] - x[0]) * RAD; dy := (x[3] - x[1]) * RAD;   (* haversine *)
        a := Math.sin(dx / 2.0) * Math.sin(dx / 2.0) + Math.cos(x[0] * RAD) * Math.cos(x[2] * RAD) * Math.sin(dy / 2.0) * Math.sin(dy / 2.0);
        d := 2.0 * 6371.0 * Math.arctan2(Math.sqrt(a), Math.sqrt(1.0 - a));
        s := "pe Pământ, între ("; S.Nr(x[0], s); Strings.Append(", ", s); S.Nr(x[1], s); Strings.Append(") și (", s); S.Nr(x[2], s); Strings.Append(", ", s); S.Nr(x[3], s);
        Strings.Append("): ≈ ", s); S.Nr(d, s); Strings.Append(" km în linie dreaptă", s); c := 2
      ELSE
        dx := x[2] - x[0]; dy := x[3] - x[1];
        s := "distanța = "; S.Nr(Math.sqrt(dx * dx + dy * dy), s); Strings.Append(" · mijlocul = (", s); S.Nr((x[0] + x[2]) / 2.0, s); Strings.Append(", ", s);
        S.Nr((x[1] + x[3]) / 2.0, s); Strings.Append(")", s);
        IF dx # 0.0 THEN Strings.Append(" · panta = ", s); S.Nr(dy / dx, s); Strings.Append(" (", s); S.Nr(Math.arctan2(dy, dx) / RAD, s); Strings.Append("°)", s)
        ELSE Strings.Append(" · dreapta e verticală", s)
        END;
        c := 2
      END
    END;
    RETURN c
  END Coordonate;

  PROCEDURE Proportii(VAR t, s: ARRAY OF CHAR; VAR x: ARRAY OF REAL; n: INTEGER): INTEGER;   (* 6 *)
    CONST FI = 1.6180340;
    VAR c, k, a, b, m: INTEGER;
  BEGIN
    c := 0;
    IF Tx.Contine(t, "fibonacci") THEN
      m := 12; IF (n >= 1) & (x[0] >= 1.0) & (x[0] <= 40.0) THEN m := FLOOR(x[0]) END;
      s := "Fibonacci: "; a := 0; b := 1;
      FOR k := 1 TO m DO IF k > 1 THEN Strings.Append(", ", s) END; Strings.AppendInt(b, 0, s); b := a + b; a := b - a END;
      Strings.Append(" · raportul se apropie de φ = 1,618", s); c := 2
    ELSIF (Tx.Contine(t, "aur") OR Tx.Contine(t, "phi")) & (n >= 1) THEN
      s := "secțiunea de aur pentru "; S.Nr(x[0], s); Strings.Append(": partea mare ", s); S.Nr(x[0] / FI, s); Strings.Append(" + partea mică ", s);
      S.Nr(x[0] - x[0] / FI, s); Strings.Append(" · sau, în sus: ", s); S.Nr(x[0] * FI, s); Strings.Append(" (φ = 1,618)", s); c := 2
    ELSIF Tx.Contine(t, "scara") & (n >= 3) & (x[0] > 0.0) THEN
      s := "la scara "; S.Nr(x[0], s); Strings.Append(":", s); S.Nr(x[1], s); Strings.Append(", ", s); S.Nr(x[2], s);
      Strings.Append(" pe hârtie înseamnă ", s); S.Nr(x[2] * x[1] / x[0], s); Strings.Append(" în realitate (aceeași unitate; cm → ", s);
      S.Nr(x[2] * x[1] / x[0] / 100.0, s); Strings.Append(" m)", s); c := 2
    END;
    RETURN c
  END Proportii;

  PROCEDURE Raspunde*(VAR r, sursa: ARRAY OF CHAR): INTEGER;
    VAR c, n, pref: INTEGER; t: ARRAY 200 OF CHAR; s: ARRAY 400 OF CHAR; x: ARRAY 6 OF REAL;
  BEGIN
    c := 0; r := ""; sursa := ""; sub := -1; s := ""; pref := S.Unde(A); Tx.Copy(S.t, t);
    c := Tor(t, s); IF c > 0 THEN sub := 0 END;
    IF c = 0 THEN
      S.Numere(t, x, n);
      IF pref = 4 THEN c := Santier(t, s, x, n); IF c > 0 THEN sub := 4 END END;
      IF (c = 0) & (pref = 5) THEN c := Coordonate(t, s, x, n); IF c > 0 THEN sub := 5 END END;
      IF (c = 0) & (pref = 6) THEN c := Proportii(t, s, x, n); IF c > 0 THEN sub := 6 END END;
      IF c = 0 THEN c := Trig(t, s, x, n); IF c > 0 THEN sub := 3 END END;
      IF c = 0 THEN c := Forme(t, s, x, n) END
    END;
    Strings.Copy(s, r);
    RETURN S.Incheie(A, c, pref, r, sursa, sub)
  END Raspunde;


  PROCEDURE Porneste*;   (* il cheama Oul: pe Java, corpul modulului (subdomeniile) ruleaza abia cand modulul e atins prima oara *)
  BEGIN
  END Porneste;

BEGIN
  sub := -1;
  S.Sub(A, 0, "tor", "torul Z₇", "tor|celul|z7|spiral|axa|axe|dimensiun", "");
  S.Sub(A, 1, "figuri", "figuri plane", "cerc|patrat|dreptunghi|triunghi|romb|trapez|disc|poligon|perimetr|arie|aria|hexagon", "Figură geometrică");
  S.Sub(A, 2, "corpuri", "corpuri", "cub|sfer|cilindr|con|piramid|prism|volum|paralelipiped|poliedr|cutie", "Corp geometric");
  S.Sub(A, 3, "trigonometrie", "trigonometrie", "sin|cos|tg|tan|unghi|grade|radian|pitagora|ipotenuz|catet|radical|sinus|cosinus|trigonometr", "Trigonometrie");
  S.Sub(A, 4, "santier", "șantier", "santier|gresie|faianta|placi|vopsea|lavabil|perete|pardoseal|beton|caramiz|parchet|tapet|zugrav|fundati|acoperis|bca|mortar|sapa", "Construcție");
  S.Sub(A, 5, "coordonate", "coordonate", "coordonat|punct|punctel|harta|latitudin|longitudin|gps|panta|dreapta|segment|cartografi", "Sistem de coordonate");
  S.Sub(A, 6, "proportii", "proporții", "proporti|aur|sectiun|scara|desen|raport|asemanar|fibonacci|simetri|perspectiv", "Secțiunea de aur");
  S.Implicit(A, 1)
END ArtaGeometria.

MODULE ArtaMuzica;  (* ♪ Muzica, oul ei (Cubicum 7 v11): motorul Eulei ♪ și încă șase subdomenii:
     0 teorie (acorduri, game, intervale - E7Teorie) · 1 acustică (ce notă are 440 Hz) · 2 ritm și tempo (bpm)
     3 instrumente · 4 compoziție · 5 istoria muzicii · 6 ascultare *)
  IMPORT Strings, Math, Tx := E7Txt, Te := E7Teorie, S := Cub7Solz;

  CONST A = 5;

  VAR sub*: INTEGER; teorie*: BOOLEAN; lung*: ARRAY 8192 OF CHAR;   (* raspunsul lung al teoriei; teorie = E7Teorie a raspuns *)
    note: ARRAY 12 OF ARRAY 8 OF CHAR;

  PROCEDURE Hz(VAR t, r: ARRAY OF CHAR; VAR x: ARRAY OF REAL; n: INTEGER): INTEGER;   (* 1: frecventa -> nota cea mai apropiata *)
    VAR c, m, oct, ct: INTEGER; f, nn: REAL;
  BEGIN
    c := 0;
    IF (n >= 1) & (x[0] >= 16.0) & (x[0] <= 20000.0) & (Tx.Contine(t, "hz") OR Tx.Contine(t, "herti")) & ~Tx.Contine(t, "frecventa lui") & ~Tx.Contine(t, "frecventa notei") THEN
      f := x[0]; nn := 12.0 * Math.ln(f / 440.0) / Math.ln(2.0) + 69.0;
      m := FLOOR(nn + 0.5); ct := FLOOR((nn - FLT(m)) * 100.0 + 0.5); oct := m DIV 12 - 1;
      S.Nr(f, r); Strings.Append(" Hz e cel mai aproape de ", r); Strings.Append(note[m MOD 12], r); Strings.AppendInt(oct, 0, r);
      IF ct > 0 THEN Strings.Append(" (+", r); Strings.AppendInt(ct, 0, r); Strings.Append(" cenți)", r)
      ELSIF ct < 0 THEN Strings.Append(" (", r); Strings.AppendInt(ct, 0, r); Strings.Append(" cenți)", r)
      END;
      Strings.Append(" · lungimea de undă în aer: ", r); S.Nr(343.0 / f, r); Strings.Append(" m · perioada ", r); S.Nr(1000.0 / f, r); Strings.Append(" ms", r);
      c := 2
    END;
    RETURN c
  END Hz;

  PROCEDURE Tempo(VAR t, r: ARRAY OF CHAR; VAR x: ARRAY OF REAL; n: INTEGER): INTEGER;   (* 2: bpm -> durate si numele tempoului *)
    VAR c: INTEGER; b, ms: REAL;
  BEGIN
    c := 0;
    IF (n >= 1) & (x[0] >= 20.0) & (x[0] <= 400.0) & (Tx.Contine(t, "bpm") OR Tx.Contine(t, "tempo") OR Tx.Contine(t, "batai")) THEN
      b := x[0]; ms := 60000.0 / b;
      S.Nr(b, r); Strings.Append(" bpm: pătrimea ", r); S.Nr(ms, r); Strings.Append(" ms · optimea ", r); S.Nr(ms / 2.0, r);
      Strings.Append(" ms · șaisprezecimea ", r); S.Nr(ms / 4.0, r); Strings.Append(" ms · o măsură de 4/4: ", r); S.Nr(ms * 4.0 / 1000.0, r);
      Strings.Append(" s · ", r);
      IF b < 60.0 THEN Strings.Append("Largo", r) ELSIF b < 76.0 THEN Strings.Append("Adagio", r) ELSIF b < 108.0 THEN Strings.Append("Andante", r)
      ELSIF b < 120.0 THEN Strings.Append("Moderato", r) ELSIF b < 168.0 THEN Strings.Append("Allegro", r) ELSIF b < 200.0 THEN Strings.Append("Presto", r)
      ELSE Strings.Append("Prestissimo", r)
      END;
      c := 2
    END;
    RETURN c
  END Tempo;

  PROCEDURE Raspunde*(VAR r, sursa: ARRAY OF CHAR): INTEGER;
    VAR c, i, n, pref: INTEGER; t: ARRAY 200 OF CHAR; x: ARRAY 4 OF REAL; s: ARRAY 400 OF CHAR;
  BEGIN
    c := 0; r := ""; sursa := ""; sub := -1; teorie := FALSE; lung := ""; pref := S.Unde(A); Tx.Copy(S.t, t); s := "";
    S.Numere(t, x, n);
    c := Tempo(t, s, x, n); IF c > 0 THEN sub := 2 END;
    IF c = 0 THEN c := Hz(t, s, x, n); IF c > 0 THEN sub := 1 END END;
    IF c > 0 THEN Strings.Copy(s, r)
    ELSIF Te.Raspunde(S.q) THEN
      Tx.Copy(Te.txt, lung); teorie := TRUE; sub := 0;
      IF S.EsteMuzica(S.q) THEN c := 2 ELSE c := 1 END;
      i := 0; WHILE (i < LEN(r) - 1) & (lung[i] # 0X) & (lung[i] # 0AX) DO r[i] := lung[i]; INC(i) END; r[i] := 0X
    END;
    c := S.Incheie(A, c, pref, r, sursa, sub);
    IF S.dinHrana THEN teorie := FALSE END;
    RETURN c
  END Raspunde;


  PROCEDURE Porneste*;   (* il cheama Oul: pe Java, corpul modulului (subdomeniile) ruleaza abia cand modulul e atins prima oara *)
  BEGIN
  END Porneste;

BEGIN
  sub := -1; teorie := FALSE; lung := "";
  note[0] := "Do"; note[1] := "Do♯"; note[2] := "Re"; note[3] := "Re♯"; note[4] := "Mi"; note[5] := "Fa";
  note[6] := "Fa♯"; note[7] := "Sol"; note[8] := "Sol♯"; note[9] := "La"; note[10] := "La♯"; note[11] := "Si";
  S.Sub(A, 0, "teorie", "teorie", "acord|gama|interval|cvint|tert|armur|major|minor|diez|bemol|septim|cvart|sext|pentaton|doric|lidic|frigic|mixolid|locric|relativ", "Teoria muzicii");
  S.Sub(A, 1, "acustica", "acustică", "hz|herti|frecvent|sunet|acustic|unda|decibel|rezonant|vibrati|armonic", "Acustică");
  S.Sub(A, 2, "ritm", "ritm și tempo", "bpm|tempo|ritm|masura|patrim|optim|metronom|batai|sincop|groove", "Tempo");
  S.Sub(A, 3, "instrumente", "instrumente", "chitar|pian|vioar|flaut|tobe|toba|nai|cobz|tambal|acordeon|instrument|orga|saxofon|trompet|violoncel|clarinet", "Instrument muzical");
  S.Sub(A, 4, "compozitie", "compoziție", "compun|compozit|melodi|armoni|progresi|cantec|refren|strof|vers|aranjament|contrapunct", "Compoziție muzicală");
  S.Sub(A, 5, "istorie", "istoria muzicii", "compozitor|enescu|bach|mozart|beethoven|chopin|baroc|clasic|romantic|jazz|rock|folclor|doina|istori|epoca", "Istoria muzicii");
  S.Sub(A, 6, "ascultare", "ascultare", "asculta|canta|piesa|playlist|album|concert|gen|trupa|cantaret|solist", "Gen muzical");
  S.Implicit(A, 0)
END ArtaMuzica.

MODULE ArtaAstronomia;  (* ☾ Astronomia, oul ei (Cubicum 7 v11): cerul și ceasul. Șapte subdomenii:
     0 calendar și ora · 1 Luna · 2 Soarele (la Iași) · 3 zodiac și taro (un joc) · 4 planete și stele
     5 fusuri orare (ce oră e la Tokyo) · 6 anotimpuri (solstiții, echinocții) *)
  IMPORT Strings, Math, Os, CFS := CubicumFS, Tor7, Tx := E7Txt, S := Cub7Solz;

  CONST A = 6; NO = 16;

  VAR sub*, zod*: INTEGER; joc*: BOOLEAN; zNume*: ARRAY 12 OF ARRAY 16 OF CHAR;
    ziSapt: ARRAY 7 OF ARRAY 16 OF CHAR; luni: ARRAY 12 OF ARRAY 16 OF CHAR;
    oras: ARRAY NO OF ARRAY 16 OF CHAR; orasNume: ARRAY NO OF ARRAY 20 OF CHAR; orasMin: ARRAY NO OF INTEGER; orasVara: ARRAY NO OF INTEGER;
      (* vara: 0 fara ora de vara, 1 ca in Europa, 2 ca in America, 3 emisfera sudica (Sydney) *)

  PROCEDURE ZiDinAn(a, l, z: INTEGER): INTEGER;   (* 1..366 *)
    VAR m, d: INTEGER;
  BEGIN
    d := z;
    FOR m := 1 TO l - 1 DO
      IF m = 2 THEN IF (a MOD 4 = 0) & ((a MOD 100 # 0) OR (a MOD 400 = 0)) THEN d := d + 29 ELSE d := d + 28 END
      ELSIF (m = 4) OR (m = 6) OR (m = 9) OR (m = 11) THEN d := d + 30 ELSE d := d + 31
      END
    END;
    RETURN d
  END ZiDinAn;

  PROCEDURE Zile(a, l, z: INTEGER): INTEGER;   (* zile de la 1 ian 2010 *)
    VAR y, d: INTEGER;
  BEGIN
    d := 0; FOR y := 2010 TO a - 1 DO IF (y MOD 4 = 0) & ((y MOD 100 # 0) OR (y MOD 400 = 0)) THEN d := d + 366 ELSE d := d + 365 END END;
    RETURN d + ZiDinAn(a, l, z) - 1
  END Zile;

  PROCEDURE Duminica(a, l, n: INTEGER): INTEGER;   (* a n-a duminica din luna (ca zile de la 2010) *)
    VAR d, w: INTEGER;
  BEGIN
    d := Zile(a, l, 1); w := (d + 4) MOD 7;   (* 0 luni ... 6 duminica *)
    RETURN d + (6 - w + 7) MOD 7 + 7 * (n - 1)
  END Duminica;

  PROCEDURE Soarele(VAR s: ARRAY OF CHAR);   (* rasaritul si apusul la Iasi (47,16 N, 27,59 E), ca la NOAA, la cateva minute *)
    CONST RAD = 0.017453293; LAT = 47.16; LON = 27.59;
    VAR t, a, l, z, n, off: INTEGER; B, eot, dec, cw, w, amiaza: REAL;
  BEGIN
    t := Os.CurrentTime(); off := (CFS.Local(t) - t) DIV 60; CFS.Data(CFS.Local(t) DIV 86400, a, l, z); n := ZiDinAn(a, l, z);
    B := 2.0 * 3.14159265 * FLT(n - 81) / 365.0;
    eot := 9.87 * Math.sin(2.0 * B) - 7.53 * Math.cos(B) - 1.5 * Math.sin(B);
    dec := 23.44 * RAD * Math.sin(2.0 * 3.14159265 * FLT(284 + n) / 365.0);
    cw := (Math.sin(-0.833 * RAD) - Math.sin(LAT * RAD) * Math.sin(dec)) / (Math.cos(LAT * RAD) * Math.cos(dec));
    amiaza := 720.0 - 4.0 * LON - eot;
    IF cw > 1.0 THEN Strings.Append("Soarele nu răsare azi la Iași.", s)
    ELSIF cw < -1.0 THEN Strings.Append("Soarele nu apune azi la Iași.", s)
    ELSE
      w := Math.arccos(cw) / RAD;
      Strings.Append("La Iași soarele răsare la ", s); S.Ora(FLOOR(amiaza - 4.0 * w + 0.5) + off, s);
      Strings.Append(" și apune la ", s); S.Ora(FLOOR(amiaza + 4.0 * w + 0.5) + off, s);
      Strings.Append(" · ziua are ", s); S.Ora(FLOOR(8.0 * w + 0.5), s); Strings.Append(" ore de lumină.", s)
    END
  END Soarele;

  PROCEDURE LunaCer(VAR s: ARRAY OF CHAR);   (* faza Lunii: de la luna noua din 15 ian 2010, 07:11 UTC; luna sinodica = 29,530589 zile *)
    CONST SIN = 29.530589;
    VAR sec, cic: INTEGER; d, v, lum: REAL;
  BEGIN
    sec := Os.CurrentTime() - 1235460; d := FLT(sec DIV 86400) + FLT(sec MOD 86400) / 86400.0;
    cic := FLOOR(d / SIN); v := d - FLT(cic) * SIN;
    lum := (1.0 - Math.cos(2.0 * 3.14159265 * v / SIN)) / 2.0 * 100.0;
    Strings.Append("Luna are ", s); Strings.AppendInt(FLOOR(v + 0.5), 0, s); Strings.Append(" zile: ", s);
    IF v < 1.85 THEN Strings.Append("lună nouă", s) ELSIF v < 5.54 THEN Strings.Append("seceră în creștere", s)
    ELSIF v < 9.23 THEN Strings.Append("primul pătrar", s) ELSIF v < 12.92 THEN Strings.Append("gibboasă în creștere", s)
    ELSIF v < 16.61 THEN Strings.Append("lună plină", s) ELSIF v < 20.30 THEN Strings.Append("gibboasă în descreștere", s)
    ELSIF v < 23.99 THEN Strings.Append("ultimul pătrar", s) ELSIF v < 27.68 THEN Strings.Append("seceră în descreștere", s)
    ELSE Strings.Append("lună nouă", s)
    END;
    Strings.Append(", luminată ", s); Strings.AppendInt(FLOOR(lum + 0.5), 0, s); Strings.Append("% · ", s);
    IF v < 14.77 THEN Strings.Append("lună plină peste ", s); Strings.AppendInt(FLOOR(14.77 - v + 0.5), 0, s)
    ELSE Strings.Append("lună nouă peste ", s); Strings.AppendInt(FLOOR(SIN - v + 0.5), 0, s)
    END;
    Strings.Append(" zile.", s)
  END LunaCer;

  PROCEDURE Vara(fel, t: INTEGER): BOOLEAN;   (* e ora de vara acolo? t = secunde UTC de la 2010 *)
    VAR a, l, z, d, de, pana: INTEGER; da: BOOLEAN;
  BEGIN
    da := FALSE; d := t DIV 86400; CFS.Data(d, a, l, z);
    IF fel = 1 THEN da := CFS.Local(t) - t = 10800   (* Romania e in ora de vara *)
    ELSIF fel = 2 THEN de := Duminica(a, 3, 2); pana := Duminica(a, 11, 1); da := (d >= de) & (d < pana)
    ELSIF fel = 3 THEN de := Duminica(a, 10, 1); pana := Duminica(a, 4, 1); da := (d >= de) OR (d < pana)
    END;
    RETURN da
  END Vara;

  PROCEDURE OraLa(i: INTEGER; VAR s: ARRAY OF CHAR);   (* La Tokyo e 21:14 (UTC+9) *)
    VAR t, m: INTEGER;
  BEGIN
    t := Os.CurrentTime(); m := orasMin[i]; IF Vara(orasVara[i], t) THEN m := m + 60 END;
    Strings.Append(orasNume[i], s); Strings.Append(" ", s); S.Ora((t + m * 60) MOD 86400 DIV 60, s);
    Strings.Append(" (UTC", s); IF m >= 0 THEN Strings.Append("+", s) ELSE Strings.Append("−", s) END;
    Strings.AppendInt(ABS(m) DIV 60, 0, s); IF ABS(m) MOD 60 # 0 THEN Strings.Append(":", s); Strings.AppendInt(ABS(m) MOD 60, 0, s) END;
    Strings.Append(")", s)
  END OraLa;

  PROCEDURE Fusuri(VAR s: ARRAY OF CHAR): INTEGER;   (* 5 *)
    VAR c, i, n: INTEGER;
  BEGIN
    c := 0; n := 0;
    IF S.Cuv("ora") OR S.Are("ceas") OR S.Are("fus") OR S.Are("timp") OR S.Cuv("orele") THEN
    FOR i := 0 TO NO - 1 DO
      IF S.Are(oras[i]) THEN IF n = 0 THEN s := "Acum: " ELSE Strings.Append(" · ", s) END; OraLa(i, s); INC(n) END
    END
    END;
    IF (n = 0) & (S.Are("fus") OR S.Are("in lume")) THEN
      s := "Acum: ";
      FOR i := 0 TO NO - 1 DO IF i MOD 2 = 0 THEN IF i > 0 THEN Strings.Append(" · ", s) END; OraLa(i, s) END END;
      n := 1
    END;
    IF n > 0 THEN c := 2 END;
    RETURN c
  END Fusuri;

  PROCEDURE Anotimp(VAR s: ARRAY OF CHAR): INTEGER;   (* 6: anotimpul astronomic si cate zile mai sunt pana la urmatorul *)
    VAR a, l, z, azi, i, d, urm: INTEGER; ln, zi: ARRAY 4 OF INTEGER; nume: ARRAY 4 OF ARRAY 40 OF CHAR; an: ARRAY 4 OF ARRAY 16 OF CHAR;
  BEGIN
    azi := CFS.Local(Os.CurrentTime()) DIV 86400; CFS.Data(azi, a, l, z);
    ln[0] := 3; zi[0] := 20; nume[0] := "echinocțiul de primăvară"; an[0] := "iarnă";
    ln[1] := 6; zi[1] := 21; nume[1] := "solstițiul de vară"; an[1] := "primăvară";
    ln[2] := 9; zi[2] := 23; nume[2] := "echinocțiul de toamnă"; an[2] := "vară";
    ln[3] := 12; zi[3] := 21; nume[3] := "solstițiul de iarnă"; an[3] := "toamnă";
    urm := -1; i := 0;
    WHILE (urm < 0) & (i < 4) DO d := Zile(a, ln[i], zi[i]); IF d >= azi THEN urm := i ELSE INC(i) END END;
    IF urm < 0 THEN urm := 0; d := Zile(a + 1, 3, 20) END;
    s := "Acum e "; Strings.Append(an[urm], s); Strings.Append(" (astronomic) · ", s); Strings.Append(nume[urm], s);
    Strings.Append(" vine pe ", s); Strings.AppendInt(zi[urm], 0, s); Strings.Append(" ", s); Strings.Append(luni[ln[urm] - 1], s);
    IF d = azi THEN Strings.Append(", chiar azi", s) ELSE Strings.Append(", peste ", s); Strings.AppendInt(d - azi, 0, s); Strings.Append(" zile", s) END;
    Strings.Append(" (±1 zi)", s);
    RETURN 2
  END Anotimp;

  PROCEDURE Raspunde*(VAR r, sursa: ARRAY OF CHAR): INTEGER;
    VAR i, z, c, cz, t, zile, a, l, zz, n, pref: INTEGER; w: ARRAY 32 OF CHAR; timp, luna, soare: BOOLEAN; s: ARRAY 400 OF CHAR;
  BEGIN
    c := 0; cz := 0; zod := -1; r := ""; sursa := ""; sub := -1; timp := FALSE; luna := FALSE; soare := FALSE; pref := S.Unde(A);
    c := Fusuri(s); IF c > 0 THEN sub := 5; Strings.Copy(s, r) END;
    IF (c = 0) & ((pref = 6) OR S.Are("anotimp") OR S.Are("solstit") OR S.Are("echinoct")) THEN c := Anotimp(s); sub := 6; Strings.Copy(s, r) END;
    IF c = 0 THEN
      FOR i := 0 TO S.nk - 1 DO
        Tx.Copy(S.kw[i], w); z := -1;
        IF w = "berbec" THEN z := 0 ELSIF w = "taur" THEN z := 1 ELSIF w = "gemeni" THEN z := 2 ELSIF w = "rac" THEN z := 3
        ELSIF w = "leu" THEN z := 4 ELSIF Tx.Incepe(w, "fecioar") THEN z := 5 ELSIF Tx.Incepe(w, "balant") THEN z := 6
        ELSIF w = "scorpion" THEN z := 7 ELSIF Tx.Incepe(w, "sagetator") THEN z := 8 ELSIF w = "capricorn" THEN z := 9
        ELSIF Tx.Incepe(w, "varsator") THEN z := 10 ELSIF w = "pesti" THEN z := 11
        END;
        IF z >= 0 THEN zod := z; cz := 2
        ELSIF Tx.Incepe(w, "taro") OR Tx.Incepe(w, "horoscop") OR Tx.Incepe(w, "zodi") THEN cz := 2
        ELSIF (cz = 0) & (Tx.Incepe(w, "noroc") OR Tx.Incepe(w, "viitor") OR Tx.Incepe(w, "destin") OR Tx.Incepe(w, "soart") OR Tx.Incepe(w, "prezic")) THEN cz := 1
        END;
        IF (w = "ora") OR Tx.Incepe(w, "ceas") OR (w = "azi") OR (w = "astazi") OR (w = "data") OR (w = "ziua") OR Tx.Incepe(w, "varst")
          OR Tx.Incepe(w, "nascut") OR Tx.Incepe(w, "saptaman") OR (w = "anul") OR (w = "maine") OR (w = "ieri") THEN timp := TRUE
        END;
        IF Tx.Incepe(w, "soare") OR Tx.Incepe(w, "soarel") OR Tx.Incepe(w, "rasar") OR Tx.Incepe(w, "apus") OR Tx.Incepe(w, "lumin") THEN soare := TRUE END;
        IF Tx.Incepe(w, "lunii") OR Tx.Incepe(w, "faz") OR Tx.Incepe(w, "plina") OR Tx.Incepe(w, "eclips") THEN luna := TRUE END;
        IF Tx.Incepe(w, "cerul") OR Tx.Incepe(w, "astronom") THEN luna := TRUE; soare := TRUE END
      END;
      IF ~luna & (S.Are("luna noua") OR S.Are("luna pe cer") OR S.Are("cum e luna")) THEN luna := TRUE END;
      IF S.Are("ce luna") OR S.Are("in ce luna") THEN timp := TRUE END;
      IF timp THEN
        t := CFS.Local(Os.CurrentTime()); zile := t DIV 86400; CFS.Data(zile, a, l, zz);
        Strings.Append("Azi e ", r); Strings.Append(ziSapt[(zile + 4) MOD 7], r); Strings.Append(", ", r);
        Strings.AppendInt(zz, 0, r); Strings.Append(" ", r); Strings.Append(luni[l - 1], r); Strings.Append(" ", r);
        Strings.AppendInt(a, 0, r); Strings.Append(" (ziua ", r); Strings.AppendInt(ZiDinAn(a, l, zz), 0, r); Strings.Append(" a anului), ora ", r);
        S.Ora(t MOD 86400 DIV 60, r); Strings.Append(".", r);
        n := Tor7.Nascut();
        IF n >= 0 THEN Strings.Append(" Cubul s-a născut acum ", r); Strings.AppendInt((Os.CurrentTime() - n) DIV 86400, 0, r); Strings.Append(" zile.", r) END;
        c := 2; sub := 0
      END;
      IF luna THEN IF r # "" THEN Strings.AppendChar(0AX, r) END; LunaCer(r); c := 2; IF sub < 0 THEN sub := 1 END END;
      IF soare THEN IF r # "" THEN Strings.AppendChar(0AX, r) END; Soarele(r); c := 2; IF sub < 0 THEN sub := 2 END END;
      joc := cz > 0; IF cz > c THEN c := cz; sub := 3 END;
      IF joc & (r = "") THEN IF zod >= 0 THEN r := "zodia "; Strings.Append(zNume[zod], r) ELSE r := "trei cărți din Arcanele Mari" END END
    ELSE joc := FALSE
    END;
    c := S.Incheie(A, c, pref, r, sursa, sub);
    IF S.dinHrana THEN joc := FALSE END;
    RETURN c
  END Raspunde;

  PROCEDURE Oras(i: INTEGER; cauta, nume: ARRAY OF CHAR; min, vara: INTEGER);
  BEGIN Strings.Copy(cauta, oras[i]); Strings.Copy(nume, orasNume[i]); orasMin[i] := min; orasVara[i] := vara
  END Oras;


  PROCEDURE Porneste*;   (* il cheama Oul: pe Java, corpul modulului (subdomeniile) ruleaza abia cand modulul e atins prima oara *)
  BEGIN
  END Porneste;

BEGIN
  sub := -1; zod := -1; joc := FALSE;
  zNume[0] := "Berbec"; zNume[1] := "Taur"; zNume[2] := "Gemeni"; zNume[3] := "Rac"; zNume[4] := "Leu"; zNume[5] := "Fecioară";
  zNume[6] := "Balanță"; zNume[7] := "Scorpion"; zNume[8] := "Săgetător"; zNume[9] := "Capricorn"; zNume[10] := "Vărsător"; zNume[11] := "Pești";
  ziSapt[0] := "luni"; ziSapt[1] := "marți"; ziSapt[2] := "miercuri"; ziSapt[3] := "joi";
  ziSapt[4] := "vineri"; ziSapt[5] := "sâmbătă"; ziSapt[6] := "duminică";
  luni[0] := "ianuarie"; luni[1] := "februarie"; luni[2] := "martie"; luni[3] := "aprilie"; luni[4] := "mai"; luni[5] := "iunie";
  luni[6] := "iulie"; luni[7] := "august"; luni[8] := "septembrie"; luni[9] := "octombrie"; luni[10] := "noiembrie"; luni[11] := "decembrie";
  Oras(0, "londr", "Londra", 0, 1); Oras(1, "paris", "Paris", 60, 1); Oras(2, "berlin", "Berlin", 60, 1); Oras(3, "lisabon", "Lisabona", 0, 1);
  Oras(4, "moscov", "Moscova", 180, 0); Oras(5, "istanbul", "Istanbul", 180, 0); Oras(6, "dubai", "Dubai", 240, 0); Oras(7, "delhi", "Delhi", 330, 0);
  Oras(8, "beijing", "Beijing", 480, 0); Oras(9, "tokyo", "Tokyo", 540, 0); Oras(10, "sydney", "Sydney", 600, 3); Oras(11, "new york", "New York", -300, 2);
  Oras(12, "chicago", "Chicago", -360, 2); Oras(13, "los angeles", "Los Angeles", -480, 2); Oras(14, "toronto", "Toronto", -300, 2); Oras(15, "sao paulo", "São Paulo", -180, 0);
  S.Sub(A, 0, "calendar", "calendar și ora", "ora|ceas|azi|astazi|data|ziua|saptaman|anul|maine|ieri|calendar|varst|nascut|luna", "Calendarul gregorian");
  S.Sub(A, 1, "luna", "Luna", "lunii|faz|plina|patrar|eclips|selen", "Luna");
  S.Sub(A, 2, "soarele", "Soarele", "soare|soarel|rasar|apus|lumin|solar|amiaz", "Soare");
  S.Sub(A, 3, "zodiac", "zodiac și taro", "zodi|horoscop|taro|berbec|taur|gemeni|rac|leu|fecioar|balant|scorpion|sagetator|capricorn|varsator|pesti|noroc|destin", "");
  S.Sub(A, 4, "planete", "planete și stele", "planet|stea|stele|marte|venus|jupiter|saturn|mercur|constelat|galaxi|telescop|cometa|asteroid|nebuloas", "Sistemul solar");
  S.Sub(A, 5, "fusuri", "fusuri orare", "fus|londr|paris|berlin|lisabon|moscov|istanbul|dubai|delhi|beijing|tokyo|sydney|york|chicago|angeles|toronto", "Fus orar");
  S.Sub(A, 6, "anotimpuri", "anotimpuri", "anotimp|solstit|echinoct|primavar|vara|toamn|iarn", "Anotimp");
  S.Implicit(A, 4)
END ArtaAstronomia.

MODULE Cub7Memoria;  (* Cubicum 7·B v18 (29 oct 2026), Pion: „hai sa ii punem oului memoria eulei sa nu mai pasca la nesfarsit”.
     Memoria Eulei celei vechi (eula-memorie.txt, facut in Eula Java cu „exporta memoria”, ~39M de semne) intra in cub o data:
     frazele ei, una pe rand, in eula.fr, si un index (eula.idx): pentru fiecare cuvant (primele 5 litere), unde sunt frazele
     care il au; pentru primul cuvant al fiecarei fraze (primele 4 litere), separat - de acolo vin definitiile „X este …”.
     La o intrebare, Oul se uita intai aici, si abia apoi pe Wikipedia.
     memoria eulei = intra memoria (din Download, sau o alegi de pe telefon) · memoria = cat stie · memoria eulei stop *)
  IMPORT Strings, Files, Ecran, CFS := CubicumFS, Tx := E7Txt;

  CONST NB = 65536; SEMN = 7349; MAXK = 12; NC = 8192; MAXL = 3000; PAS = 300000;
    cText = 0; cCyan = 1; cGold = 2; cPurple = 3; cRed = 4; cDim = 5;

  TYPE IesireP* = PROCEDURE (col: INTEGER; s: ARRAY OF CHAR);

  VAR iesire: IesireP;
    gata*: BOOLEAN; nfr*, nidx: INTEGER;   (* memoria e in cub: cate fraze, cate intrari in index *)
    nc, st: ARRAY NB OF INTEGER; baza: INTEGER;   (* cate fraze are fiecare cheie, unde incep in index *)
    fi, ff: Files.File;   (* indexul si frazele, deschise pentru citit *)
    lucrez*, astept*: BOOLEAN;   (* intra memoria acum / asteapta fisierul ales pe telefon *)
    src, out: Files.File; srcCale: ARRAY 400 OF CHAR; stergSrc: BOOLEAN; srcMare, srcPos, outPos, pas: INTEGER;
    buf: ARRAY 65536 OF BYTE; ob: ARRAY 2400 OF BYTE;
    wb: ARRAY 262160 OF BYTE;   (* scrierea si citirea pe bucati mari (Files scrie octet cu octet) *)
    ab: ARRAY 65536 OF BYTE; nab: INTEGER;   (* frazele, inainte sa ajunga in eula.fr *)
    post, cu: Tx.Ints; faza, fi0: INTEGER; fidx: Files.File; tmpIdx: ARRAY 300 OF CHAR;   (* indexul se scrie in pasi, cate putin pe cadru *)
    fr: ARRAY 600 OF CHAR; nf: INTEGER; pend, sarRand, incRand: BOOLEAN; ur, ux: INTEGER;
    ph, po: Tx.Ints; np, nnoi: INTEGER;
    tk: ARRAY MAXK OF INTEGER; ntk: INTEGER;
    lst: ARRAY MAXL OF INTEGER;
    cOff, cHit: ARRAY NC OF INTEGER; tab: ARRAY 16384 OF INTEGER; ncand: INTEGER;
    sub*: ARRAY 400 OF INTEGER; nsub*: INTEGER;   (* frazele care incep cu subiectul (Subiect) *)

  PROCEDURE Cale(nume: ARRAY OF CHAR; VAR c: ARRAY OF CHAR);
  BEGIN CFS.Dosar(c); Strings.Append("/", c); Strings.Append(nume, c)
  END Cale;

  PROCEDURE Hash(w: ARRAY OF CHAR; n, salt: INTEGER): INTEGER;   (* primele n litere ale cuvantului -> 0 .. NB-1 *)
    VAR i, h: INTEGER;
  BEGIN
    h := salt; i := 0;
    WHILE (i < n) & (i < LEN(w)) & (w[i] # 0X) DO h := (h * 31 + ORD(w[i])) MOD 1000003; INC(i) END;
    RETURN h MOD NB
  END Hash;

  PROCEDURE CheieCuv(w: ARRAY OF CHAR): INTEGER;   (* un cuvant din fraza: primele 5 litere *)
  BEGIN RETURN Hash(w, 5, 1)
  END CheieCuv;

  PROCEDURE CheieSubiect(w: ARRAY OF CHAR): INTEGER;   (* primul cuvant al frazei: primele 4 litere *)
  BEGIN RETURN Hash(w, 4, 7)
  END CheieSubiect;

  (* ---------- intrarea memoriei ---------- *)

  PROCEDURE Pune(h: INTEGER);
    VAR i: INTEGER; era: BOOLEAN;
  BEGIN
    era := FALSE; FOR i := 0 TO ntk - 1 DO IF tk[i] = h THEN era := TRUE END END;
    IF ~era & (ntk < MAXK) THEN tk[ntk] := h; INC(ntk) END
  END Pune;

  PROCEDURE Fraza;   (* fraza strinsa in fr intra in eula.fr si in index *)
    VAR i, j, k, n, c, off, nb: INTEGER; w: ARRAY 40 OF CHAR; prim, spatiu: BOOLEAN;
  BEGIN
    fr[nf] := 0X; Tx.Trim(fr); n := Strings.Length(fr); spatiu := Strings.Pos(" ", fr, 0) > 0;
    IF (n >= 25) & (n <= 590) & spatiu THEN
      nb := 0; i := 0;   (* in UTF-8 *)
      WHILE i < n DO
        c := ORD(fr[i]);
        IF c < 80H THEN ob[nb] := c; INC(nb)
        ELSIF c < 800H THEN ob[nb] := 0C0H + c DIV 64; ob[nb + 1] := 80H + c MOD 64; nb := nb + 2
        ELSE ob[nb] := 0E0H + c DIV 4096; ob[nb + 1] := 80H + c DIV 64 MOD 64; ob[nb + 2] := 80H + c MOD 64; nb := nb + 3
        END;
        INC(i)
      END;
      ob[nb] := 10; INC(nb);
      off := outPos; outPos := outPos + nb;
      IF nab + nb > LEN(ab) THEN Files.WriteNBytes(out, ab, nab); nab := 0 END;
      FOR i := 0 TO nb - 1 DO ab[nab] := ob[i]; INC(nab) END;
      ntk := 0; i := 0; prim := TRUE;
      WHILE i < n DO   (* cuvintele *)
        WHILE (i < n) & ~Tx.Litera(fr[i]) DO INC(i) END;
        j := 0; WHILE (i < n) & Tx.Litera(fr[i]) DO IF j < LEN(w) - 1 THEN w[j] := Tx.Fold(Tx.Mic(fr[i])); INC(j) END; INC(i) END;
        w[j] := 0X;
        IF prim & (j >= 3) THEN Pune(CheieSubiect(w) + 0); prim := FALSE ELSIF j > 0 THEN prim := FALSE END;
        IF (j >= 4) & ~Tx.InLista(w, "este|sunt|care|pentru|acest|aceasta|aceste|acesta|fost|fiind|avea|avut|dintre|catre|prin|dupa|despre")
          & ~Tx.InLista(w, "foarte|poate|unei|unui|cele|celor|astfel|insa|daca|cand|atunci|doar|toate|toti|mult|multe|alte|alta|unde|chiar|fara|intre|inca|sale") THEN
          Pune(CheieCuv(w))
        END
      END;
      FOR k := 0 TO ntk - 1 DO Tx.Pune(ph, np, tk[k]); Tx.Pune(po, np, off); INC(nc[tk[k]]); INC(np) END;
      INC(nfr); INC(nnoi)
    END;
    nf := 0
  END Fraza;

  PROCEDURE Semn(c: INTEGER);   (* o litera din fisier *)
  BEGIN
    IF incRand & (c = 1EH) THEN sarRand := TRUE END;   (* antetul unei bucati din memoria Eulei: „␞timp TAB sursa” *)
    incRand := c = 10;
    IF sarRand THEN IF c = 10 THEN sarRand := FALSE END
    ELSIF c = 10 THEN IF nf > 0 THEN Fraza END; pend := FALSE
    ELSE
      IF pend & (c = 32) THEN Fraza END;
      pend := FALSE;
      IF (c >= 32) & ((c # 32) OR (nf > 0)) THEN
        IF nf < LEN(fr) - 2 THEN fr[nf] := CHR(c); INC(nf) ELSE Fraza END
      ELSIF (c = 9) & (nf > 0) & (nf < LEN(fr) - 2) THEN fr[nf] := " "; INC(nf)
      END;
      IF (c = ORD(".")) OR (c = ORD("!")) OR (c = ORD("?")) THEN pend := TRUE END
    END
  END Semn;

  PROCEDURE Inchide;   (* fisierele de citit *)
  BEGIN IF fi # NIL THEN Files.Close(fi); fi := NIL END; IF ff # NIL THEN Files.Close(ff); ff := NIL END
  END Inchide;

  PROCEDURE IntDin(VAR b: ARRAY OF BYTE; k: INTEGER): INTEGER;   (* 4 octeti, cel mic intai (ca Files.WriteInt) *)
  BEGIN RETURN b[k] MOD 256 + b[k + 1] MOD 256 * 256 + b[k + 2] MOD 256 * 65536 + b[k + 3] MOD 256 * 16777216
  END IntDin;

  PROCEDURE IntIn(v, k: INTEGER);   (* in wb, la k *)
  BEGIN wb[k] := v MOD 256; wb[k + 1] := v DIV 256 MOD 256; wb[k + 2] := v DIV 65536 MOD 256; wb[k + 3] := v DIV 16777216 MOD 256
  END IntIn;

  PROCEDURE Deschide(): BOOLEAN;   (* indexul de pe disc: cheile in memorie, frazele raman pe disc *)
    VAR c: ARRAY 300 OF CHAR; h, s, n: INTEGER; ok: BOOLEAN;
  BEGIN
    Inchide; ok := FALSE; Cale("eula.idx", c); fi := Files.Open(c);
    IF fi # NIL THEN
      n := 0; Files.ReadBytes(fi, wb, n);
      IF (n >= (3 + NB) * 4) & (IntDin(wb, 0) = SEMN) THEN
        nfr := IntDin(wb, 4); nidx := IntDin(wb, 8); s := 0;
        FOR h := 0 TO NB - 1 DO nc[h] := IntDin(wb, 12 + h * 4); st[h] := s; s := s + nc[h] END;
        baza := (3 + NB) * 4; Cale("eula.fr", c); ff := Files.Open(c);
        ok := (ff # NIL) & (s = nidx)
      END;
      IF ~ok THEN Inchide END
    END;
    gata := ok; RETURN ok
  END Deschide;

  PROCEDURE Termina;   (* fisierul s-a terminat: incepe scrierea indexului (Pas, cate putin pe cadru) *)
    VAR k, h, s: INTEGER;
  BEGIN
    IF nf > 0 THEN Fraza END;
    IF nab > 0 THEN Files.WriteNBytes(out, ab, nab); nab := 0 END;
    Files.Close(src); src := NIL; Files.Close(out); out := NIL;
    IF stergSrc THEN k := Files.Delete(srcCale) END;
    s := 0; FOR h := 0 TO NB - 1 DO st[h] := s; s := s + nc[h] END;
    cu := Tx.NouInts(); post := Tx.NouInts(); faza := 1; fi0 := 0;
    iesire(cDim, "  ◆ memoria Eulei: scriu indexul …")
  END Termina;

  PROCEDURE PasIndex;   (* o bucata din scrierea indexului *)
    VAR i, h, k, c, m: INTEGER; t: ARRAY 300 OF CHAR; s: ARRAY 200 OF CHAR;
  BEGIN
    IF faza = 1 THEN   (* fiecare intrare la locul ei: frazele cheii h, una dupa alta *)
      m := fi0 + PAS; IF m > np THEN m := np END;
      FOR i := fi0 TO m - 1 DO h := Tx.Ia(ph, i); c := Tx.Ia(cu, h); Tx.Pune(post, st[h] + c, Tx.Ia(po, i)); Tx.Pune(cu, h, c + 1) END;
      fi0 := m; IF fi0 >= np THEN faza := 2; ph := NIL; po := NIL; cu := NIL END
    ELSIF faza = 2 THEN   (* antetul: SEMN, fraze, intrari, cate are fiecare cheie *)
      Cale("eula.idx.tmp", tmpIdx); fidx := Files.Create(tmpIdx);
      IF fidx = NIL THEN faza := 0; lucrez := FALSE; iesire(cRed, "◆ memoria Eulei: nu pot scrie indexul")
      ELSE
        IntIn(SEMN, 0); IntIn(nfr, 4); IntIn(np, 8); FOR h := 0 TO NB - 1 DO IntIn(nc[h], 12 + h * 4) END;
        Files.WriteNBytes(fidx, wb, (3 + NB) * 4); faza := 3; fi0 := 0
      END
    ELSIF faza = 3 THEN   (* intrarile, cate 65536 pe cadru *)
      m := fi0 + 65536; IF m > np THEN m := np END; k := 0;
      FOR i := fi0 TO m - 1 DO IntIn(Tx.Ia(post, i), k); k := k + 4 END;
      IF k > 0 THEN Files.WriteNBytes(fidx, wb, k) END;
      fi0 := m;
      IF fi0 >= np THEN
        Files.Close(fidx); fidx := NIL; post := NIL; Cale("eula.idx", t); k := Files.Delete(t); k := Files.Rename(tmpIdx, t);
        faza := 0; lucrez := FALSE;
        IF Deschide() THEN
          s := "◆ memoria Eulei e în cub: "; Strings.AppendInt(nfr, 0, s); Strings.Append(" de fraze · Oul o citește înainte să întrebe Wikipedia", s); iesire(cPurple, s)
        ELSE iesire(cRed, "◆ memoria Eulei: indexul nu s-a putut citi (e loc pe telefon?)")
        END
      END
    END
  END PasIndex;

  PROCEDURE Tic*;   (* in fiecare cadru, cat intra memoria: o bucata din fisier *)
    VAR k, n, i, cc, p: INTEGER; m: ARRAY 120 OF CHAR;
  BEGIN
    IF lucrez & (faza > 0) THEN PasIndex
    ELSIF lucrez THEN
      k := 0;
      WHILE lucrez & (faza = 0) & (k < 4) DO
        n := 0; Files.ReadBytes(src, buf, n);
        IF n <= 0 THEN Termina
        ELSE
          FOR i := 0 TO n - 1 DO
            cc := buf[i] MOD 256;
            IF ur > 0 THEN ux := ux * 64 + cc MOD 64; DEC(ur); IF ur = 0 THEN IF ux < 10000H THEN Semn(ux) END END
            ELSIF cc < 80H THEN Semn(cc)
            ELSIF cc DIV 32 = 6 THEN ux := cc MOD 32; ur := 1
            ELSIF cc DIV 16 = 14 THEN ux := cc MOD 16; ur := 2
            ELSE ux := cc MOD 8; ur := 3
            END
          END;
          srcPos := srcPos + n; INC(k)
        END
      END;
      IF lucrez & (faza = 0) & (srcMare > 0) THEN
        p := srcPos DIV (srcMare DIV 100 + 1);
        IF p >= pas + 10 THEN
          pas := p - p MOD 10; m := "  ◆ memoria Eulei: "; Strings.AppendInt(pas, 0, m); Strings.Append("% · ", m); Strings.AppendInt(nnoi, 0, m); Strings.Append(" de fraze", m); iesire(cDim, m)
        END
      END
    END
  END Tic;

  PROCEDURE Din*(cale, nume: ARRAY OF CHAR);   (* fisierul cu memoria (din Download sau ales pe telefon) incepe sa intre *)
    VAR c: ARRAY 300 OF CHAR; h: INTEGER; m: ARRAY 300 OF CHAR;
  BEGIN
    astept := FALSE; Strings.Copy(cale, srcCale); src := Files.Open(srcCale);
    IF src = NIL THEN m := "◆ nu pot deschide "; Strings.Append(nume, m); iesire(cRed, m)
    ELSE
      Inchide; gata := FALSE;
      srcMare := Files.Size(src); srcPos := 0; pas := 0; Cale("eula.fr", c); out := Files.Create(c); outPos := 0;
      FOR h := 0 TO NB - 1 DO nc[h] := 0 END;
      ph := Tx.NouInts(); po := Tx.NouInts(); np := 0; nab := 0; faza := 0; nfr := 0; nnoi := 0; nf := 0; pend := FALSE; sarRand := FALSE; incRand := TRUE; ur := 0;
      lucrez := out # NIL;
      IF lucrez THEN
        m := "◆ intră memoria Eulei din „"; Strings.Append(nume, m); Strings.Append("” · ", m); Strings.AppendInt(srcMare DIV 1048576, 0, m);
        Strings.Append(" MB · câteva minute; poți folosi cubul între timp", m); iesire(cPurple, m)
      ELSE iesire(cRed, "◆ nu pot scrie eula.fr în cub")
      END
    END
  END Din;

  PROCEDURE Cmd*(l: ARRAY OF CHAR): BOOLEAN;   (* memoria eulei · memoria · memoria eulei stop *)
    VAR f: ARRAY 160 OF CHAR; d, c: ARRAY 400 OF CHAR; r: BOOLEAN; m: ARRAY 200 OF CHAR;
  BEGIN
    Tx.Copy(l, f); Tx.MicS(f); Tx.FoldS(f); Tx.Trim(f); r := FALSE;
    IF (f = "memoria eulei stop") OR (f = "memoria stop") THEN
      r := TRUE;
      IF lucrez & (faza = 0) THEN Files.Close(src); Files.Close(out); src := NIL; out := NIL; lucrez := FALSE; ph := NIL; po := NIL; iesire(cGold, "◆ memoria Eulei s-a oprit · memoria eulei o ia de la capăt")
      ELSE iesire(cDim, "◆ nu intră nimic acum")
      END
    ELSIF Tx.Incepe(f, "memoria eulei") OR (f = "memoria") OR (f = "memorie") THEN
      r := TRUE;
      IF lucrez THEN m := "◆ memoria Eulei intră: "; Strings.AppendInt(pas, 0, m); Strings.Append("% · ", m); Strings.AppendInt(nnoi, 0, m); Strings.Append(" de fraze", m); iesire(cGold, m)
      ELSIF (f = "memoria") OR (f = "memorie") THEN
        IF gata THEN m := "◆ memoria Eulei: "; Strings.AppendInt(nfr, 0, m); Strings.Append(" de fraze în cub · memoria eulei = o pune din nou", m); iesire(cText, m)
        ELSE iesire(cDim, "◆ memoria Eulei nu e încă în cub · memoria eulei")
        END
      ELSIF Ecran.Descarcari(d) THEN
        Strings.Copy(d, c); Strings.Append("/eula-memorie.txt", c);
        IF Files.Exists(c) THEN stergSrc := FALSE; Din(c, "eula-memorie.txt")
        ELSE
          astept := TRUE; stergSrc := TRUE; Ecran.AlegeFisier;
          iesire(cCyan, "⇩ alege fișierul cu memoria Eulei (eula-memorie.txt) · în Eula cea în Java îl faci cu „exportă memoria”")
        END
      END
    END;
    RETURN r
  END Cmd;

  (* ---------- cautarea ---------- *)

  PROCEDURE Lista(h, max: INTEGER): INTEGER;   (* frazele cheii h (cel mult max) in lst *)
    VAR i, n, k, r: INTEGER;
  BEGIN
    n := nc[h]; IF n > max THEN n := max END; IF n > MAXL THEN n := MAXL END;
    IF n > 0 THEN
      k := Files.Seek(fi, baza + st[h] * 4); r := 0; Files.ReadBytes(fi, wb, r);
      IF r < n * 4 THEN n := r DIV 4 END;
      FOR i := 0 TO n - 1 DO lst[i] := IntDin(wb, i * 4) END
    END;
    RETURN n
  END Lista;

  PROCEDURE Citeste*(off: INTEGER; VAR s: ARRAY OF CHAR);   (* fraza de la locul off din eula.fr *)
    VAR n, i, j, cc, r, x, k: INTEGER;
  BEGIN
    s := ""; j := 0;
    IF gata THEN
      k := Files.Seek(ff, off); n := 0; Files.ReadBytes(ff, ob, n); i := 0; r := 0; x := 0;
      WHILE (i < n) & (j < LEN(s) - 1) & ~((r = 0) & (ob[i] MOD 256 = 10)) DO
        cc := ob[i] MOD 256; INC(i);
        IF r > 0 THEN x := x * 64 + cc MOD 64; DEC(r); IF r = 0 THEN s[j] := CHR(x); INC(j) END
        ELSIF cc < 80H THEN s[j] := CHR(cc); INC(j)
        ELSIF cc DIV 32 = 6 THEN x := cc MOD 32; r := 1
        ELSE x := cc MOD 16; r := 2
        END
      END;
      s[j] := 0X
    END
  END Citeste;

  PROCEDURE Subiect*(w: ARRAY OF CHAR);   (* frazele care incep cu cuvantul w (primele 4 litere, fara diacritice): sub[0..nsub) *)
    VAR u: ARRAY 40 OF CHAR; i: INTEGER;
  BEGIN
    nsub := 0;
    IF gata THEN
      Tx.Copy(w, u); Tx.MicS(u); Tx.FoldS(u);
      i := 0; WHILE (u[i] # 0X) & (u[i] # " ") DO INC(i) END; u[i] := 0X;
      IF i >= 3 THEN nsub := Lista(CheieSubiect(u), LEN(sub)); FOR i := 0 TO nsub - 1 DO sub[i] := lst[i] END END
    END
  END Subiect;

  PROCEDURE Cauta*(VAR kw: ARRAY OF ARRAY OF CHAR; nk: INTEGER; VAR best: ARRAY OF CHAR): INTEGER;
    (* fraza care are cele mai multe cuvinte ale intrebarii; intoarce cate are (0 = nimic) *)
    VAR i, j, n, h, t, k, bh, bs, sc, lung: INTEGER; s, u: ARRAY 600 OF CHAR; p: ARRAY 8 OF CHAR;
  BEGIN
    best := ""; bs := 0;
    IF gata & (nk > 0) THEN
      FOR i := 0 TO LEN(tab) - 1 DO tab[i] := 0 END; ncand := 0;
      FOR i := 0 TO nk - 1 DO
        IF Strings.Length(kw[i]) >= 4 THEN
          n := Lista(CheieCuv(kw[i]), MAXL);
          FOR j := 0 TO n - 1 DO
            h := lst[j] MOD LEN(tab); t := 0;
            WHILE (tab[h] # 0) & (cOff[tab[h] - 1] # lst[j]) & (t < LEN(tab)) DO h := (h + 1) MOD LEN(tab); INC(t) END;
            IF tab[h] # 0 THEN INC(cHit[tab[h] - 1])
            ELSIF ncand < NC THEN cOff[ncand] := lst[j]; cHit[ncand] := 1; INC(ncand); tab[h] := ncand
            END
          END
        END
      END;
      bh := 0; FOR i := 0 TO ncand - 1 DO IF cHit[i] > bh THEN bh := cHit[i] END END;
      k := 0; i := 0; lung := 999;
      WHILE (i < ncand) & (k < 40) DO   (* cele cu cele mai multe chei: le citesc si le numar cuvintele *)
        IF (bh > 0) & (cHit[i] >= bh) THEN
          Citeste(cOff[i], s); Tx.Copy(s, u); Tx.MicS(u); Tx.FoldS(u); sc := 0;
          FOR j := 0 TO nk - 1 DO
            Tx.Copy(kw[j], p); IF Strings.Length(kw[j]) > 5 THEN p[5] := 0X END;
            IF Tx.Contine(u, p) THEN INC(sc) END
          END;
          IF (sc > bs) OR (sc = bs) & (sc > 0) & (Strings.Length(s) < lung) THEN bs := sc; lung := Strings.Length(s); Tx.Copy(s, best) END;
          INC(k)
        END;
        INC(i)
      END
    END;
    RETURN bs
  END Cauta;

  PROCEDURE Porneste*(ies: IesireP);   (* dupa ce s-a montat Cubicum FS; nu scrie nimic pe ecran *)
    VAR ok: BOOLEAN;
  BEGIN iesire := ies; lucrez := FALSE; astept := FALSE; ok := Deschide()
  END Porneste;

BEGIN gata := FALSE; lucrez := FALSE; astept := FALSE; nfr := 0; fi := NIL; ff := NIL; faza := 0; nab := 0
END Cub7Memoria.

MODULE Cub7Eule;  (* Cubicum 7 v11 (29 oct 2026): solzii - artele au plecat fiecare in oul ei (ArtaGramatica ... ArtaAstronomia),
     cu cate 7 subdomenii si hrana pe disc (Cub7Solz); aici ramane Oul mare, care le asculta si cristalizeaza.
      Cubicum 7 v4 (28 oct 2026): + Oul face (Fapta), obiceiurile, rondul. v3: cei sapte experti si Oul, intr-un modul al lor (modulul principal trecuse de marimea
     pe care o primeste compilatorul: „file too big”). Iesirea, cantecul, zodia si taro vin de la Cubicum 7 (Porneste). *)
  IMPORT Strings, Files, Os, Ecran, Sunet, CFS := CubicumFS, Sal := Salamandra, Tx := E7Txt, V := Cub7Ver,
    S := Cub7Solz, Cp := Cub7Copie, AG := ArtaGramatica, AD := ArtaDialectica, AR := ArtaRetorica, AA := ArtaAritmetica, AGe := ArtaGeometria,
    AM := ArtaMuzica, AS := ArtaAstronomia, Mm := Cub7Memoria;

  CONST LC = CFS.LC;
    cText = 0; cCyan = 1; cGold = 2; cPurple = 3; cRed = 4; cDim = 5; cGreen = 6; cYel = 7;   (* culorile; +10 = text pe mai multe randuri *)

  TYPE IesireP* = PROCEDURE (col: INTEGER; s: ARRAY OF CHAR);
    TextP* = PROCEDURE (s: ARRAY OF CHAR);

  VAR
    iesire: IesireP; canta: PROCEDURE; zodie, taro: TextP;
    qQ: ARRAY 128 OF CHAR;
    qRaw: ARRAY 7 OF ARRAY 500 OF CHAR; qSursa: ARRAY 7 OF ARRAY 80 OF CHAR; qHr: ARRAY 7 OF BOOLEAN;
    qTip: INTEGER; qCine: BOOLEAN; qX, qXf, qL: ARRAY 64 OF CHAR;   (* qL = forma de baza a subiectului (7·B v17) *) qTipNume: ARRAY 8 OF ARRAY 16 OF CHAR;   (* 7·B v15: felul intrebarii si subiectul ei *)
    defAst, wkIntro: BOOLEAN; wkPrima: ARRAY 300 OF CHAR;   (* 7·B v15: o definitie ceruta Wikipediei *)
    vestea: ARRAY 200 OF CHAR; qSub: ARRAY 7 OF INTEGER; hrSub, hrTintaSub, wkSub, hrNoi: INTEGER; cubTxt: ARRAY 600 OF CHAR;   (* v10: astronomia a dat un joc (zodie, taro); ce stie Oul despre cub *)
    qConf, qExp: ARRAY 7 OF INTEGER; qIncr: ARRAY 3 OF ARRAY 7 OF INTEGER;
    qNume: ARRAY 7 OF ARRAY 24 OF CHAR; qSimb: ARRAY 7 OF ARRAY 8 OF CHAR; qProg: ARRAY 7 OF ARRAY 16 OF CHAR;
    qFelNume: ARRAY 3 OF ARRAY 16 OF CHAR;
    qKw: ARRAY 8 OF ARRAY 32 OF CHAR;
    qNr, qDe, qCastig, qFel, qVenit, qAstept, qNk: INTEGER; qOcupat: BOOLEAN;
    qImpr: ARRAY 7 OF BOOLEAN; pornesc: BOOLEAN; impDe: INTEGER;
    lgW: ARRAY 64 OF ARRAY 24 OF CHAR; lgK, lgS: ARRAY 64 OF INTEGER; nlg: INTEGER; qIncerc: ARRAY 7 OF BOOLEAN;   (* 7·B v12: legaturile Oului *)   (* 7·B v9: expertul si-a imprumutat tura unei aplicatii *)
    hrTinta*: INTEGER;   (* expertul care asteapta fisierul ales; -1 = nimeni (adu) *)
    executa: TextP;   (* v4: Oul da comenzi Shell-ului *)
    obN: ARRAY 48 OF ARRAY 16 OF CHAR; obL: ARRAY 48 OF ARRAY 64 OF CHAR; obC: ARRAY 48 OF INTEGER; obT: ARRAY 48 OF ARRAY 48 OF INTEGER;   (* v4: obiceiurile *)
    nob, obPrev, obNoi: INTEGER; obSug: ARRAY 64 OF CHAR;
    rDe, rFis, rAsh, rHr: INTEGER;   (* v4: rondul Oului *)
    wkStare, wkK, wkRamase, wkDe, wkGoale, wkMancat, wkFraze, wkIncercari, nwk: INTEGER; wkAuto: BOOLEAN;   (* v7: pasunea *)
    totActiv: BOOLEAN; totI, totN, totNr: INTEGER;
    ultimRasp*: ARRAY 2000 OF CHAR;   (* 7·B v5: ultimul raspuns al Oului (copiaza) *)   (* 7·B v4: pasune tot - solzul la care a ajuns, cati au pascut, cati pot *)
    wkLimba: ARRAY 4 OF CHAR; wkCaut: ARRAY 120 OF CHAR; wkSamanta: ARRAY 7 OF ARRAY 40 OF CHAR;
    wkM: ARRAY 400 OF ARRAY 80 OF CHAR; wkMK: ARRAY 400 OF INTEGER;   (* ce articole au fost mancate ("ro:Titlu") si de cine *)

  PROCEDURE Rand(col: INTEGER; s: ARRAY OF CHAR);
  BEGIN iesire(col, s)
  END Rand;

  PROCEDURE Scr(col: INTEGER; s: ARRAY OF CHAR);   (* text pe mai multe randuri *)
  BEGIN iesire(col + 10, s)
  END Scr;

  PROCEDURE Nimic*;   (* hrTinta := -1 (adu ia fisierul pentru cub, nu pentru un expert) *)
  BEGIN hrTinta := -1
  END Nimic;

  PROCEDURE Cheie(q: ARRAY OF CHAR; VAR kw: ARRAY OF ARRAY OF CHAR): INTEGER;   (* cuvintele de cautat: litere mici, fara diacritice *)
    VAR i, j, n: INTEGER; w: ARRAY 32 OF CHAR; t: ARRAY 128 OF CHAR;
  BEGIN
    Strings.Copy(q, t); Tx.MicS(t); Tx.FoldS(t); n := 0; i := 0;
    WHILE (i < LEN(t)) & (t[i] # 0X) DO
      j := 0;
      WHILE (i < LEN(t)) & (t[i] # 0X) & Tx.Litera(t[i]) DO IF j < LEN(w) - 1 THEN w[j] := t[i]; INC(j) END; INC(i) END;
      w[j] := 0X;
      IF (j >= 3) & (n < LEN(kw)) & ~Tx.InLista(w, "ce|este|care|cum|cine|unde|despre|sunt|esti|spune|pentru|face|fac|din|sau|cel|cea|mai|imi|iti|lui|are|sti|stii") THEN
        Strings.Copy(w, kw[n]); INC(n)
      END;
      WHILE (i < LEN(t)) & (t[i] # 0X) & ~Tx.Litera(t[i]) DO INC(i) END
    END;
    RETURN n
  END Cheie;

  PROCEDURE AreCuv(VAR t: ARRAY OF CHAR; w: ARRAY OF CHAR): BOOLEAN;   (* v4: w e in t ca inceput de cuvant (3 litere: cuvant intreg) *)
    VAR p, m: INTEGER; ok: BOOLEAN;
  BEGIN
    m := Tx.Len(w); ok := FALSE; p := Tx.Pos(w, t, 0);
    WHILE (p >= 0) & ~ok DO
      IF ((p = 0) OR ~Tx.Litera(t[p - 1])) & ((m >= 4) OR (p + m >= LEN(t)) OR ~Tx.Litera(t[p + m])) THEN ok := TRUE
      ELSE p := Tx.Pos(w, t, p + 1)
      END
    END;
    RETURN ok
  END AreCuv;

  PROCEDURE Potrivire(linie: ARRAY OF CHAR; VAR kw: ARRAY OF ARRAY OF CHAR; n: INTEGER): INTEGER;   (* cate cuvinte cheie are randul *)
    VAR t: ARRAY 256 OF CHAR; k, s: INTEGER;
  BEGIN
    Tx.Copy(linie, t); Tx.MicS(t); Tx.FoldS(t); s := 0;
    FOR k := 0 TO n - 1 DO IF AreCuv(t, kw[k]) THEN INC(s) END END;
    RETURN s
  END Potrivire;

  PROCEDURE Sigur(c: INTEGER; VAR s: ARRAY OF CHAR);
  BEGIN IF c = 2 THEN Strings.Append("știu", s) ELSIF c = 1 THEN Strings.Append("bănuiesc", s) ELSE Strings.Append("nu știu", s) END
  END Sigur;

  (* ---------- Cubicum 7: sapte experti pe cele 7 ture, Oul (nucleul, in afara spiralei) cristalizeaza ---------- *)

  PROCEDURE Pune7(k: INTEGER; VAR s: ARRAY OF CHAR; VAR n: INTEGER);   (* v11: fraza s[0..n) intra in solzul ei: hrSub, sau unde se potriveste *)
    VAR sb: INTEGER;
  BEGIN
    s[n] := 0X; Tx.Trim(s);
    IF Tx.Len(s) >= 12 THEN
      IF (hrSub >= 0) & (hrSub < S.NS) THEN sb := hrSub ELSE sb := S.Clasifica(k, s) END;
      IF S.Pune(k, sb, s) THEN INC(hrNoi) END
    END;
    n := 0
  END Pune7;

  PROCEDURE SubNume(k: INTEGER; VAR s: ARRAY OF CHAR);   (* v11: " · santier" *)
  BEGIN
    IF (k >= 0) & (k <= 6) & (qSub[k] >= 0) & (qSub[k] < S.NS) THEN Strings.Append(" · ", s); Strings.Append(S.snume[k][qSub[k]], s) END
  END SubNume;

  PROCEDURE SolziArta(k: INTEGER);   (* v11: un rand: subdomeniile artei k si cata hrana are fiecare *)
    VAR i: INTEGER; s: ARRAY 500 OF CHAR;
  BEGIN
    s := "  "; Strings.Append(qNume[k], s); Strings.Append(":", s);
    FOR i := 0 TO S.NS - 1 DO
      Strings.Append(" ", s); Strings.Append(S.sid[k][i], s); Strings.Append(" ", s); Strings.AppendInt(S.nr[k][i], 0, s);
      IF i < S.NS - 1 THEN Strings.Append(" ·", s) END
    END;
    Scr(cText, s)
  END SolziArta;

  PROCEDURE CaleHrana(VAR c: ARRAY OF CHAR);
  BEGIN CFS.Dosar(c); Strings.Append("/hrana7.mem", c)
  END CaleHrana;

  PROCEDURE ArtaNoua(k: INTEGER): INTEGER;   (* v10: expertul vechi -> arta: teoria -> muzica, memoria -> retorica, calcul -> aritmetica,
      oracol -> astronomia, cubul -> retorica, ceasul -> astronomia, reteaua -> retorica; 7 = cristal *)
    VAR r: INTEGER;
  BEGIN
    IF k = 0 THEN r := 5 ELSIF k = 1 THEN r := 2 ELSIF k = 2 THEN r := 3 ELSIF k = 3 THEN r := 6
    ELSIF k = 4 THEN r := 2 ELSIF k = 5 THEN r := 6 ELSIF k = 6 THEN r := 2 ELSE r := k
    END;
    RETURN r
  END ArtaNoua;

  PROCEDURE SalveazaHrana;   (* v11: frazele noi ajung pe disc, in solzii lor *)
  BEGIN S.Scrie; IF S.eroare THEN Rand(cRed, "nu pot scrie solzii de hrană") END
  END SalveazaHrana;

  PROCEDURE Migreaza;   (* v11: hrana7.mem (platosa veche) se imparte in solzi, o data; ramane hrana7.vechi *)
    VAR f: Files.File; i, k, n, semn, r: INTEGER; c, v: ARRAY 200 OF CHAR; s: ARRAY 256 OF CHAR;
  BEGIN
    CaleHrana(c); f := Files.Open(c);
    IF f # NIL THEN
      semn := Files.ReadInt(f); hrSub := -1; hrNoi := 0;
      IF (semn = 7350) OR (semn = 7360) THEN
        n := Files.ReadInt(f); IF (n < 0) OR (n > 1500) THEN n := 0 END;
        FOR i := 0 TO n - 1 DO
          k := Files.ReadInt(f); r := Files.ReadStr(f, s);
          IF semn = 7350 THEN k := ArtaNoua(k) END;
          IF (k >= 0) & (k <= 7) THEN r := Tx.Len(s); Pune7(k, s, r) END
        END
      END;
      Files.Close(f); SalveazaHrana;
      Strings.Copy(c, v); i := Strings.Pos(".mem", v, 0); IF i > 0 THEN v[i] := 0X END; Strings.Append(".vechi", v);
      IF Files.Exists(v) THEN r := Files.Delete(v) END;
      r := Files.Rename(c, v);
      s := "◆ hrana veche s-a împărțit în solzi: "; Strings.AppendInt(hrNoi, 0, s); Strings.Append(" fraze · solzi = harta lor", s); Strings.Copy(s, vestea)   (* o spune la primul cadru: la pornire ecranul inca n-are latime *)
    END
  END Migreaza;


  PROCEDURE Seamana7;   (* prima pornire: cateva fraze despre Cubicum 7, in hrana Memoriei *)
    VAR s: ARRAY 200 OF CHAR; n: INTEGER;
  BEGIN
    hrSub := -1;
    s := "Cubicum 7 are pe cele șapte ture ale spiralei cele șapte arte liberale: gramatica, dialectica, retorica, aritmetica, geometria, muzica și astronomia."; n := Tx.Len(s); Pune7(2, s, n);
    s := "Oul este nucleul Salamandrei, în afara spiralei: el adună ce spun cei șapte experți și cristalizează răspunsul, a opta dimensiune."; n := Tx.Len(s); Pune7(2, s, n);
    s := "Un cristal este un răspuns pe care l-ai aprobat cu bun: intră în memorie și data viitoare îl găsește Memoria."; n := Tx.Len(s); Pune7(2, s, n);
    s := "Fiecare artă poate fi hrănită cu texte: hraneste muzica, hraneste gramatica, pasune astronomia 5 și celelalte."; n := Tx.Len(s); Pune7(2, s, n);
    s := "Fiecare artă este un ou cu șapte subdomenii, iar fiecare subdomeniu are solzul lui de hrană pe disc: solzi arată harta."; n := Tx.Len(s); Pune7(2, s, n);
    SalveazaHrana
  END Seamana7;

  PROCEDURE ExpertDin(w: ARRAY OF CHAR): INTEGER;   (* numele unei arte (sau al expertului vechi) -> 0..6; -1 = nu e *)
    VAR t: ARRAY 32 OF CHAR; k: INTEGER;
  BEGIN
    Tx.Copy(w, t); Tx.MicS(t); Tx.FoldS(t); k := -1;
    IF Tx.Incepe(t, "gram") OR Tx.Incepe(t, "cuv") THEN k := 0
    ELSIF Tx.Incepe(t, "dial") OR Tx.Incepe(t, "logic") THEN k := 1
    ELSIF Tx.Incepe(t, "ret") OR Tx.Incepe(t, "mem") OR Tx.Incepe(t, "styx") THEN k := 2
    ELSIF Tx.Incepe(t, "arit") OR Tx.Incepe(t, "calc") OR Tx.Incepe(t, "soco") THEN k := 3
    ELSIF Tx.Incepe(t, "geom") OR Tx.Incepe(t, "cub") THEN k := 4
    ELSIF Tx.Incepe(t, "muz") OR Tx.Incepe(t, "teor") THEN k := 5
    ELSIF Tx.Incepe(t, "astr") OR Tx.Incepe(t, "orac") OR Tx.Incepe(t, "zod") OR Tx.Incepe(t, "taro") OR Tx.Incepe(t, "cea") OR Tx.Incepe(t, "timp") THEN k := 6
    END;
    RETURN k
  END ExpertDin;

  PROCEDURE ArtaSub(w: ARRAY OF CHAR; VAR sb: INTEGER): INTEGER;   (* v11: "geometria.santier" -> 4 si sb = 4; "geometria" -> 4, sb = -1 *)
    VAR i, k: INTEGER; a, b: ARRAY 32 OF CHAR;
  BEGIN
    sb := -1; i := Strings.Pos(".", w, 0);
    IF i > 0 THEN Strings.Extract(w, 0, i, a); Strings.Extract(w, i + 1, Strings.Length(w) - i - 1, b) ELSE Strings.Copy(w, a); b := "" END;
    k := ExpertDin(a);
    IF (k >= 0) & (b # "") THEN sb := S.SubDin(k, b) END;
    RETURN k
  END ArtaSub;

  PROCEDURE Hraneste7*(k: INTEGER; cale, nume: ARRAY OF CHAR);   (* un fisier text de pe telefon, taiat in fraze, pentru expertul k;
      fara .txt / .md in nume = text de Wikipedia (action=raw): {{...}}, <...>, [[a|b]] si '' se curata *)
    VAR f: Files.File; b: ARRAY 4096 OF BYTE; n, i, c, x, r, j, inainte, acol, lin, lst: INTEGER; ung, wiki: BOOLEAN;
      s: ARRAY 200 OF CHAR; t: ARRAY 300 OF CHAR;
  BEGIN
    f := Files.Open(cale);
    IF f = NIL THEN Rand(cRed, "nu pot citi fișierul")
    ELSE
      wiki := ~(Tx.Contine(nume, ".txt") OR Tx.Contine(nume, ".md") OR Tx.Contine(nume, ".TXT"));
      inainte := S.Total(); hrSub := hrTintaSub; j := 0; r := 0; x := 0; acol := 0; lin := 0; lst := 0; ung := FALSE;
      REPEAT
        n := 0; Files.ReadBytes(f, b, n);
        FOR i := 0 TO n - 1 DO
          c := b[i] MOD 256;
          IF r > 0 THEN x := x * 64 + c MOD 64; DEC(r)
          ELSIF c < 80H THEN x := c
          ELSIF c DIV 32 = 6 THEN x := c MOD 32; r := 1
          ELSIF c DIV 16 = 14 THEN x := c MOD 16; r := 2
          ELSE x := c MOD 8; r := 3
          END;
          IF r = 0 THEN
            IF (x = 10) OR (x = 13) THEN IF acol = 0 THEN Pune7(k, s, j) END; lst := 0
            ELSIF wiki & (x = ORD("{")) THEN INC(acol)
            ELSIF wiki & (x = ORD("}")) THEN IF acol > 0 THEN DEC(acol) END
            ELSIF wiki & (acol > 0) THEN   (* un sablon de Wikipedia: sare *)
            ELSIF wiki & (x = ORD("<")) THEN ung := TRUE
            ELSIF wiki & ung THEN IF x = ORD(">") THEN ung := FALSE END
            ELSIF wiki & (x = ORD("[")) THEN IF lin = 0 THEN lst := j END; INC(lin)
            ELSIF wiki & (x = ORD("]")) THEN IF lin > 0 THEN DEC(lin) END
            ELSIF wiki & (x = ORD("|")) & (lin > 0) THEN IF lst <= j THEN j := lst END
            ELSIF wiki & ((x = ORD("'")) OR (x = ORD("="))) THEN
            ELSIF (x < 10000H) & (x # 0FEFFH) THEN
              IF x = 9 THEN x := 32 END;
              IF x >= 32 THEN s[j] := CHR(x); INC(j) END;
              IF ((x = ORD(".")) OR (x = ORD("!")) OR (x = ORD("?"))) & (j > 40) OR (j >= LEN(s) - 2) THEN Pune7(k, s, j); lst := 0 END
            END
          END
        END
      UNTIL n <= 0;
      Pune7(k, s, j); Files.Close(f);
      t := "  "; Strings.Append(qNume[k], t); Strings.Append(" a mâncat ", t); Strings.Append(nume, t); Strings.Append(": ", t);
      SalveazaHrana; Strings.AppendInt(S.Total() - inainte, 0, t); Strings.Append(" fraze noi, în solzii ei:", t);
      Rand(cGreen, t); SolziArta(k)
    END
  END Hraneste7;

  PROCEDURE Urla(VAR u: ARRAY OF CHAR);   (* github.com/o/r/blob/b/f -> raw.githubusercontent.com/o/r/b/f; https:// in fata *)
    VAR t, r: ARRAY 200 OF CHAR; p: INTEGER;
  BEGIN
    IF ~Tx.Incepe(u, "http") THEN t := "https://"; Strings.Append(u, t); Strings.Copy(t, u) END;
    p := Tx.Pos("://github.com/", u, 0);
    IF p >= 0 THEN
      Strings.Extract(u, p + 14, Strings.Length(u) - p - 14, r);   (* o/r/blob/b/f *)
      t := "https://raw.githubusercontent.com/";
      p := Tx.Pos("/blob/", r, 0);
      IF p >= 0 THEN
        Strings.Extract(r, 0, p, u); Strings.Append(u, t);
        Strings.Extract(r, p + 5, Strings.Length(r) - p - 5, u); Strings.Append(u, t)
      ELSE Strings.Append(r, t)
      END;
      Strings.Copy(t, u)
    END
  END Urla;

  (* ---------- v7: pasunea pe Wikipedia (ca Eula Java: cauta, mananca textul curat, apoi vecinii) prin Ecran.Aduce ---------- *)

  PROCEDURE CaleWiki(nume: ARRAY OF CHAR; VAR c: ARRAY OF CHAR);
  BEGIN CFS.Dosar(c); Strings.Append("/", c); Strings.Append(nume, c)
  END CaleWiki;

  PROCEDURE SalveazaWiki;   (* ce articole au fost mancate, si de cine *)
    VAR f: Files.File; i, r: INTEGER; c, t: ARRAY 200 OF CHAR;
  BEGIN
    CaleWiki("wiki7.mem", c); Strings.Copy(c, t); Strings.Append(".tmp", t);
    f := Files.Create(t);
    IF f # NIL THEN
      Files.WriteInt(f, 7363); Files.WriteInt(f, nwk);
      FOR i := 0 TO nwk - 1 DO Files.WriteInt(f, wkMK[i]); Files.WriteStr(f, wkM[i]) END;
      Files.Close(f);
      IF Files.Exists(c) THEN r := Files.Delete(c) END;
      r := Files.Rename(t, c)
    END
  END SalveazaWiki;

  PROCEDURE IncarcaWiki;
    VAR f: Files.File; i, k, n, semn: INTEGER; c: ARRAY 200 OF CHAR;
  BEGIN
    nwk := 0; CaleWiki("wiki7.mem", c); f := Files.Open(c);
    IF f # NIL THEN
      semn := Files.ReadInt(f);
      IF (semn = 7353) OR (semn = 7363) THEN
        n := Files.ReadInt(f); IF (n < 0) OR (n > LEN(wkM)) THEN n := 0 END;
        FOR i := 0 TO n - 1 DO wkMK[i] := Files.ReadInt(f); k := Files.ReadStr(f, wkM[i]) END;
        nwk := n;
        IF semn = 7353 THEN FOR i := 0 TO nwk - 1 DO wkMK[i] := ArtaNoua(wkMK[i]) END END   (* v10 *)
      END;
      Files.Close(f)
    END
  END IncarcaWiki;

  PROCEDURE Mancat(cheie: ARRAY OF CHAR): BOOLEAN;   (* "ro:Titlu" a mai fost mancat? *)
    VAR i: INTEGER; da: BOOLEAN;
  BEGIN
    da := FALSE; FOR i := 0 TO nwk - 1 DO IF wkM[i] = cheie THEN da := TRUE END END;
    RETURN da
  END Mancat;

  PROCEDURE Codeaza(s: ARRAY OF CHAR; VAR d: ARRAY OF CHAR);   (* & + # ? = din titlu -> %XX (restul il face Android) *)
    VAR i: INTEGER; c: CHAR;
  BEGIN
    i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) DO
      c := s[i];
      IF c = "&" THEN Strings.Append("%26", d) ELSIF c = "+" THEN Strings.Append("%2B", d)
      ELSIF c = "#" THEN Strings.Append("%23", d) ELSIF c = "?" THEN Strings.Append("%3F", d)
      ELSIF c = "=" THEN Strings.Append("%3D", d) ELSE Strings.AppendChar(c, d)
      END;
      INC(i)
    END
  END Codeaza;

  PROCEDURE WikiPleaca(cauta: ARRAY OF CHAR; deplasare: INTEGER): BOOLEAN;   (* o cerere la Wikipedia: primul articol gasit, cu textul lui *)
    VAR u: ARRAY 400 OF CHAR; c: ARRAY 200 OF CHAR; ok: BOOLEAN;
  BEGIN
    u := "https://"; Strings.Append(wkLimba, u);
    Strings.Append(".wikipedia.org/w/api.php?action=query&format=json&formatversion=2&redirects=1", u);
    IF wkIntro THEN Strings.Append("&exintro=1&exsentences=3", u) END;   (* 7·B v15: o definitie: doar inceputul *)
    Strings.Append("&prop=extracts&explaintext=1&generator=search&gsrnamespace=0&gsrlimit=1&gsroffset=", u);
    Strings.AppendInt(deplasare, 0, u); Strings.Append("&gsrsearch=", u); Codeaza(cauta, u);
    CaleWiki("wiki7.json", c);
    ok := Ecran.Aduce(u, c);
    IF ok THEN wkStare := 1; wkDe := Sunet.Ms() END;
    RETURN ok
  END WikiPleaca;

  PROCEDURE WPune(VAR s: ARRAY OF CHAR; VAR n: INTEGER; VAR luate: INTEGER; VAR gata: BOOLEAN);   (* o fraza din articol *)
    VAR t: ARRAY 64 OF CHAR;
  BEGIN
    s[n] := 0X; Tx.Trim(s);
    IF s[0] = "=" THEN   (* un titlu de sectiune: dupa Note / Bibliografie / Vezi si nu mai e de mancat *)
      Tx.Copy(s, t); Tx.MicS(t); Tx.FoldS(t);
      IF Tx.Contine(t, "note") OR Tx.Contine(t, "bibliograf") OR Tx.Contine(t, "vezi si") OR Tx.Contine(t, "legaturi")
        OR Tx.Contine(t, "referin") OR Tx.Contine(t, "references") OR Tx.Contine(t, "see also") OR Tx.Contine(t, "external") THEN gata := TRUE
      END;
      n := 0
    ELSIF (Tx.Len(s) >= 25) & (S.Loc(wkK) > 0) & (luate < 25) THEN
      IF (luate = 0) & (wkPrima = "") THEN Tx.Copy(s, wkPrima) END;   (* 7·B v15 *)
      hrSub := wkSub; Pune7(wkK, s, n); INC(luate)
    ELSE n := 0
    END;
    IF (luate >= 25) OR (S.Loc(wkK) <= 0) THEN gata := TRUE END
  END WPune;

  PROCEDURE Tipar(nume: ARRAY OF CHAR; VAR p: ARRAY OF CHAR);   (* "nume":" *)
  BEGIN p := ""; Strings.AppendChar(CHR(34), p); Strings.Append(nume, p); Strings.AppendChar(CHR(34), p); Strings.Append(":", p); Strings.AppendChar(CHR(34), p)
  END Tipar;

  PROCEDURE WikiMananca(VAR titlu: ARRAY OF CHAR): INTEGER;   (* citeste wiki7.json: titlul si textul (cate fraze a luat; -1 = nimic) *)
    CONST PT = 34; PB = 92;
    VAR f: Files.File; b: ARRAY 4096 OF BYTE; c: ARRAY 200 OF CHAR; s: ARRAY 200 OF CHAR;
      n, i, x, r, cc, faza, pm, esc, u, nu, j, luate, k: INTEGER; gata: BOOLEAN; pat: ARRAY 16 OF CHAR;
  BEGIN
    titlu := ""; luate := -1; CaleWiki("wiki7.json", c); f := Files.Open(c);
    IF f # NIL THEN
      faza := 0; pm := 0; Tipar("title", pat); esc := 0; u := 0; nu := 0; j := 0; k := 0; gata := FALSE; r := 0; x := 0;
      REPEAT
        n := 0; Files.ReadBytes(f, b, n); i := 0;
        WHILE (i < n) & ~gata DO
          cc := b[i] MOD 256; INC(i);
          IF r > 0 THEN x := x * 64 + cc MOD 64; DEC(r)
          ELSIF cc < 80H THEN x := cc
          ELSIF cc DIV 32 = 6 THEN x := cc MOD 32; r := 1
          ELSIF cc DIV 16 = 14 THEN x := cc MOD 16; r := 2
          ELSE x := cc MOD 8; r := 3
          END;
          IF r = 0 THEN
            IF (faza = 0) OR (faza = 2) THEN   (* caut "title":" sau "extract":" *)
              IF x = ORD(pat[pm]) THEN INC(pm) ELSIF x = ORD(pat[0]) THEN pm := 1 ELSE pm := 0 END;
              IF pat[pm] = 0X THEN INC(faza); pm := 0; esc := 0 END
            ELSE   (* in sirul JSON: titlul (faza 1) sau textul (faza 3) *)
              IF esc = 1 THEN
                esc := 0;
                IF x = ORD("n") THEN x := 10 ELSIF x = ORD("t") THEN x := 32 ELSIF x = ORD("r") THEN x := -1
                ELSIF x = ORD("u") THEN esc := 2; nu := 0; u := 0; x := -1
                ELSIF (x = ORD("b")) OR (x = ORD("f")) THEN x := -1
                END
              ELSIF esc = 2 THEN   (* \uXXXX *)
                IF (x >= ORD("0")) & (x <= ORD("9")) THEN u := u * 16 + x - ORD("0")
                ELSIF (x >= ORD("a")) & (x <= ORD("f")) THEN u := u * 16 + x - ORD("a") + 10
                ELSIF (x >= ORD("A")) & (x <= ORD("F")) THEN u := u * 16 + x - ORD("A") + 10
                END;
                INC(nu); x := -1;
                IF nu = 4 THEN esc := 0; IF (u < 0D800H) OR (u > 0DFFFH) THEN x := u END END
              ELSIF x = PB THEN esc := 1; x := -1
              ELSIF x = PT THEN   (* sfarsitul sirului *)
                x := -1;
                IF faza = 1 THEN titlu[k] := 0X; faza := 2; Tipar("extract", pat); luate := 0
                ELSE IF j > 0 THEN WPune(s, j, luate, gata) END; gata := TRUE
                END
              END;
              IF x >= 0 THEN
                IF faza = 1 THEN IF (x >= 32) & (k < LEN(titlu) - 1) THEN titlu[k] := CHR(x); INC(k) END
                ELSIF x = 10 THEN IF j > 0 THEN WPune(s, j, luate, gata) END
                ELSIF x >= 32 THEN
                  IF j < LEN(s) - 2 THEN s[j] := CHR(x); INC(j) END;
                  IF ((x = ORD(".")) OR (x = ORD("!")) OR (x = ORD("?"))) & (j > 60) OR (j >= LEN(s) - 2) THEN WPune(s, j, luate, gata) END
                END
              END
            END
          END
        END
      UNTIL (n <= 0) OR gata;
      Files.Close(f);
      IF faza = 1 THEN titlu[k] := 0X END
    END;
    RETURN luate
  END WikiMananca;

  PROCEDURE WikiUrmatorul;   (* pasunea: urmatorul articol, langa unul deja mancat de acelasi expert *)
    VAR i, n, a: INTEGER; alese: ARRAY 400 OF INTEGER; t: ARRAY 120 OF CHAR; w: ARRAY 120 OF CHAR; ok: BOOLEAN;
  BEGIN
    IF (wkRamase <= 0) OR (wkGoale >= 8) OR (S.Loc(wkK) <= 0) THEN
      t := "  ◆ pășunea s-a terminat · "; Strings.AppendInt(wkMancat, 0, t); Strings.Append(" articole, ", t);
      Strings.AppendInt(wkFraze, 0, t); Strings.Append(" fraze", t);
      IF wkGoale >= 8 THEN Strings.Append(" · nu mai găsesc iarbă nouă pe aici", t) END;
      IF S.Loc(wkK) <= 0 THEN Strings.Append(" · solzii artei sunt plini", t) END;
      Rand(cPurple, t); wkStare := 0; SalveazaHrana; SalveazaWiki
    ELSE
      n := 0; FOR i := 0 TO nwk - 1 DO IF (wkMK[i] = wkK) & (Strings.Pos(wkLimba, wkM[i], 0) = 0) THEN alese[n] := i; INC(n) END END;
      IF (wkSub >= 0) & (wkSub < S.NS) & (S.samanta[wkK][wkSub] # "") THEN   (* v11: pasunea unui solz: samanta lui si vecinii ei *)
        IF wkMancat + wkGoale = 0 THEN ok := WikiPleaca(S.samanta[wkK][wkSub], 0)
        ELSE t := "morelike:"; Strings.Append(S.samanta[wkK][wkSub], t); ok := WikiPleaca(t, wkMancat + wkGoale - 1)
        END
      ELSIF n = 0 THEN ok := WikiPleaca(wkSamanta[wkK], 0)   (* primul: samanta expertului *)
      ELSE
        a := alese[(Sunet.Ms() DIV 7 + wkGoale * 3) MOD n];
        t := "morelike:"; Strings.Extract(wkM[a], 3, Strings.Length(wkM[a]) - 3, w); Strings.Append(w, t);
        ok := WikiPleaca(t, (Sunet.Ms() + wkGoale) MOD 5)
      END;
      IF ~ok THEN wkStare := 2; wkDe := Sunet.Ms() + 2000 END
    END
  END WikiUrmatorul;

  PROCEDURE Fraza(raw: ARRAY OF CHAR; VAR o: ARRAY OF CHAR);   (* 7·B v17: raspunsul ca propozitie: litera mare, punct, cel mult doua fraze *)
    VAR i, n, p, fr: INTEGER; w, pv, lm: ARRAY 80 OF CHAR; t: ARRAY 600 OF CHAR;
  BEGIN
    Tx.Copy(raw, t); n := Strings.Length(t); p := Strings.Pos(" = ", t, 0);
    IF (p > 0) & (p < 40) THEN   (* lexicon: „pianul = substantiv, forma de baza „pian”; …” *)
      Tx.Sub(t, 0, p, w); i := p + 3; pv := ""; lm := "";
      WHILE (i < n) & (t[i] # ",") & (t[i] # ";") DO Strings.AppendChar(t[i], pv); INC(i) END;
      p := Strings.Pos("„", t, i); IF (p > 0) & ((Strings.Pos(";", t, i) < 0) OR (p < Strings.Pos(";", t, i))) THEN
        INC(p); WHILE (p < n) & (t[p] # "”") DO Strings.AppendChar(t[p], lm); INC(p) END
      END;
      o := "Cuvântul „"; Strings.Append(w, o); Strings.Append("” e ", o);
      IF Tx.Sfarsit(pv, "ie") OR Tx.Sfarsit(pv, "ă") THEN Strings.Append("o ", o) ELSE Strings.Append("un ", o) END;
      Strings.Append(pv, o);
      IF lm # "" THEN Strings.Append(", cu forma de bază „", o); Strings.Append(lm, o); Strings.Append("”", o) END;
      Strings.Append(".", o)
    ELSE
      i := 0; fr := 0; o := "";
      WHILE (i < n) & (fr < 2) & (Strings.Length(o) < LEN(o) - 2) DO   (* cel mult doua fraze *)
        Strings.AppendChar(t[i], o);
        IF ((t[i] = ".") OR (t[i] = "!") OR (t[i] = "?")) & ((i + 1 >= n) OR (t[i + 1] = " ")) & (i > 20) THEN INC(fr) END;
        INC(i)
      END;
      Tx.Trim(o); n := Strings.Length(o);
      IF (n > 0) & ~Tx.Cifra(o[0]) THEN o[0] := Tx.Mare(o[0]) END;
      IF (n > 0) & (o[n - 1] # ".") & (o[n - 1] # "!") & (o[n - 1] # "?") & (o[n - 1] # ")") THEN Strings.Append(".", o) END
    END
  END Fraza;

  PROCEDURE WikiTic;   (* in fiecare cadru: a venit raspunsul? e timpul urmatoarei cereri? *)
    VAR r, luate: INTEGER; titlu: ARRAY 120 OF CHAR; cheie: ARRAY 120 OF CHAR; s: ARRAY 300 OF CHAR;
  BEGIN
    IF wkStare = 1 THEN
      r := Ecran.Adus();
      IF (r = 200) & defAst THEN   (* 7·B v15: definitia ceruta de Oul *)
        wkPrima := ""; luate := WikiMananca(titlu); defAst := FALSE; wkIntro := FALSE; wkStare := 0; SalveazaHrana;
        IF wkPrima # "" THEN
          Tx.Copy(wkPrima, qRaw[0]); qSursa[0] := "Wikipedia: "; Strings.Append(titlu, qSursa[0]); qConf[0] := 2; qHr[0] := TRUE; qSub[0] := 3;
          qCastig := 0; qIncerc[0] := TRUE; Tx.Copy(wkPrima, ultimRasp);
          IF qCine THEN s := "◆ Oul a întrebat Wikipedia cine e „" ELSE s := "◆ Oul a întrebat Wikipedia ce e „" END; Strings.Append(qX, s); Strings.Append("”:", s); Rand(cPurple, s);
          Fraza(wkPrima, ultimRasp); s := "  "; Strings.Append(ultimRasp, s); Rand(cText, s); s := "    ↳ Wikipedia: "; Strings.Append(titlu, s); Rand(cDim, s);
          Rand(cDim, "  am pus-o în ✎ Gramatica · dicționar: data viitoare știu fără internet · bun / gresit")
        ELSE s := "◆ Oul: nici Wikipedia n-are ceva despre „"; Strings.Append(qX, s); Strings.Append("”", s); Rand(cRed, s)
        END
      ELSIF r = 200 THEN
        luate := WikiMananca(titlu);
        cheie := ""; Strings.Append(wkLimba, cheie); Strings.Append(":", cheie); Strings.Append(titlu, cheie);
        IF titlu = "" THEN
          INC(wkGoale); s := "  n-am găsit nimic pentru „"; Strings.Append(wkCaut, s); Strings.Append("”", s); IF wkRamase = 0 THEN Rand(cRed, s) END
        ELSIF Mancat(cheie) THEN INC(wkGoale); IF wkRamase = 0 THEN s := "  "; Strings.Append(titlu, s); Strings.Append(" · l-am mâncat deja", s); Rand(cDim, s) END
        ELSE
          IF nwk < LEN(wkM) THEN Strings.Copy(cheie, wkM[nwk]); wkMK[nwk] := wkK; INC(nwk) END;
          wkGoale := 0; INC(wkMancat); wkFraze := wkFraze + luate; DEC(wkRamase);
          s := "  "; Strings.Append(qSimb[wkK], s); Strings.Append(" Wikipedia ", s); Strings.Append(wkLimba, s); Strings.Append(": ", s);
          Strings.Append(titlu, s); Strings.Append(" · ", s); Strings.AppendInt(luate, 0, s); Strings.Append(" fraze", s); Rand(cGreen, s)
        END;
        IF wkRamase > 0 THEN wkStare := 2; wkDe := Sunet.Ms() + 1500
        ELSE wkStare := 0; SalveazaHrana; SalveazaWiki;
          IF wkMancat > 0 THEN SolziArta(wkK) END
        END
      ELSIF r = -1 THEN Rand(cRed, "  ◆ nu ajung la Wikipedia (fără internet?)"); wkStare := 0; defAst := FALSE; wkIntro := FALSE; SalveazaHrana; SalveazaWiki;
        IF totActiv THEN totActiv := FALSE; Rand(cRed, "  ◆ opresc pășunea mare · pasune tot o reia de la început") END
      ELSIF r # 0 THEN
        INC(wkIncercari);
        IF ((r = 429) OR (r >= 500)) & (wkIncercari < 3) THEN wkStare := 3; wkDe := Sunet.Ms() + 5000   (* prea des: astept si reiau *)
        ELSE s := "  ◆ Wikipedia a răspuns "; Strings.AppendInt(r, 0, s); Rand(cRed, s); wkStare := 0; defAst := FALSE; wkIntro := FALSE; SalveazaHrana; SalveazaWiki
        END
      END
    ELSIF (wkStare = 2) & (Sunet.Ms() >= wkDe) THEN wkIncercari := 0; WikiUrmatorul
    ELSIF (wkStare = 3) & (Sunet.Ms() >= wkDe) THEN
      IF wkRamase > 0 THEN WikiUrmatorul ELSIF ~WikiPleaca(wkCaut, 0) THEN wkStare := 0 END
    ELSIF wkStare = 4 THEN   (* o adresa oarecare (url): cand vine, o mananca Hraneste7 *)
      r := Ecran.Adus();
      IF r = 200 THEN wkStare := 0; CaleWiki("adus7.md", s); Hraneste7(wkK, s, "adus7.md")
      ELSIF r # 0 THEN wkStare := 0; s := "  ◆ adresa nu s-a putut aduce: "; Strings.AppendInt(r, 0, s); Rand(cRed, s)
      END
    END
  END WikiTic;

  PROCEDURE WikiCere(k: INTEGER; titlu: ARRAY OF CHAR);   (* hraneste expert wiki Titlu: un articol, direct *)
    VAR s: ARRAY 200 OF CHAR;
  BEGIN
    IF wkStare # 0 THEN Rand(cDim, "  ◆ încă pasc · pasune stop o oprește")
    ELSE
      wkK := k; wkRamase := 0; wkGoale := 0; wkMancat := 0; wkFraze := 0; wkIncercari := 0; wkLimba := "ro";
      IF Tx.Incepe(titlu, "en:") THEN wkLimba := "en"; Strings.Extract(titlu, 3, Strings.Length(titlu) - 3, wkCaut) ELSE Strings.Copy(titlu, wkCaut) END;
      IF WikiPleaca(wkCaut, 0) THEN
        s := "  ◆ caut pe Wikipedia „"; Strings.Append(wkCaut, s); Strings.Append("” pentru ", s); Strings.Append(qNume[k], s); Rand(cCyan, s)
      ELSE Rand(cRed, "  ◆ nu pot pleca: altă aducere e în curs")
      END
    END
  END WikiCere;

  PROCEDURE WikiPasune(k, n: INTEGER; limba: ARRAY OF CHAR);   (* pasune expert N: N articole din vecinatatea celor mancate *)
    VAR s: ARRAY 200 OF CHAR;
  BEGIN
    IF wkStare # 0 THEN Rand(cDim, "  ◆ încă pasc · pasune stop o oprește")
    ELSE
      wkK := k; wkRamase := n; wkGoale := 0; wkMancat := 0; wkFraze := 0; wkIncercari := 0; Strings.Copy(limba, wkLimba);
      s := "  ◆ "; Strings.Append(qNume[k], s);
      IF (wkSub >= 0) & (wkSub < S.NS) THEN Strings.Append(" · ", s); Strings.Append(S.snume[k][wkSub], s) END;
      Strings.Append(" pleacă la păscut pe Wikipedia ", s); Strings.Append(wkLimba, s);
      Strings.Append(" · ", s); Strings.AppendInt(n, 0, s); Strings.Append(" articole", s); Rand(cCyan, s);
      wkCaut := ""; WikiUrmatorul
    END
  END WikiPasune;

  PROCEDURE TotUrm;   (* 7·B v4: pasune tot - urmatorul solz care are samanta pe Wikipedia paste 5 articole *)
    VAR a, sb: INTEGER; s: ARRAY 200 OF CHAR;
  BEGIN
    WHILE (totI < 49) & (S.samanta[totI DIV 7][totI MOD 7] = "") DO INC(totI) END;
    IF totI >= 49 THEN
      totActiv := FALSE; s := "◆ pășunea mare s-a terminat: "; Strings.AppendInt(totN, 0, s);
      Strings.Append(" solzi au păscut · hrană în cub: ", s); Strings.AppendInt(S.Total(), 0, s); Strings.Append(" fraze · solzi = harta", s); Rand(cPurple, s)
    ELSE
      a := totI DIV 7; sb := totI MOD 7; INC(totI); INC(totN);
      s := "◆ pășunea mare · solzul "; Strings.AppendInt(totN, 0, s); Strings.Append(" din ", s); Strings.AppendInt(totNr, 0, s); Rand(cGold, s);
      wkSub := sb; WikiPasune(a, 5, "ro")
    END
  END TotUrm;

  PROCEDURE PasuneCmd*(l: ARRAY OF CHAR);   (* pasune expert [N] [en] · pasune stop · pasune auto / oprit · pasune *)
    VAR i, k, n, j: INTEGER; w, w2, w3: ARRAY 32 OF CHAR; s: ARRAY 200 OF CHAR; c: ARRAY 8 OF INTEGER;
  BEGIN
    i := 0; WHILE l[i] = " " DO INC(i) END; WHILE (l[i] # 0X) & (l[i] # " ") DO INC(i) END;
    WHILE l[i] = " " DO INC(i) END; j := 0; WHILE (l[i] # 0X) & (l[i] # " ") DO IF j < 31 THEN w[j] := l[i]; INC(j) END; INC(i) END; w[j] := 0X;
    WHILE l[i] = " " DO INC(i) END; j := 0; WHILE (l[i] # 0X) & (l[i] # " ") DO IF j < 31 THEN w2[j] := l[i]; INC(j) END; INC(i) END; w2[j] := 0X;
    WHILE l[i] = " " DO INC(i) END; j := 0; WHILE (l[i] # 0X) & (l[i] # " ") DO IF j < 31 THEN w3[j] := l[i]; INC(j) END; INC(i) END; w3[j] := 0X;
    Tx.MicS(w);
    IF w = "stop" THEN wkRamase := 0; IF totActiv THEN totActiv := FALSE; Rand(cPurple, "◆ pășunea mare se oprește") END; IF wkStare # 0 THEN Rand(cPurple, "◆ mă opresc după articolul ăsta") ELSE Rand(cDim, "◆ nu pășteam") END
    ELSIF w = "tot" THEN   (* 7·B v4 *)
      IF totActiv OR (wkStare # 0) THEN Rand(cDim, "◆ încă pasc · pasune stop oprește")
      ELSE
        totNr := 0; FOR i := 0 TO 48 DO IF S.samanta[i DIV 7][i MOD 7] # "" THEN INC(totNr) END END;
        s := "◆ pășunea mare: "; Strings.AppendInt(totNr, 0, s); Strings.Append(" solzi, câte 5 articole · ține aplicația deschisă · pasune stop o oprește", s);
        Rand(cPurple, s); totI := 0; totN := 0; totActiv := TRUE; TotUrm
      END
    ELSIF w = "auto" THEN wkAuto := TRUE; Rand(cPurple, "◆ la fiecare rond, Oul trimite pe cel mai flămând expert la păscut (3 articole)")
    ELSIF (w = "oprit") OR (w = "manual") THEN wkAuto := FALSE; Rand(cPurple, "◆ Oul nu mai trimite singur la păscut · pasune auto îl pornește")
    ELSE
      k := ArtaSub(w, j); wkSub := j;
      IF k < 0 THEN
        FOR i := 0 TO 7 DO c[i] := 0 END;
        FOR i := 0 TO nwk - 1 DO IF (wkMK[i] >= 0) & (wkMK[i] <= 6) THEN INC(c[wkMK[i]]) END END;
        s := "◆ articole mâncate: "; FOR i := 0 TO 6 DO Strings.Append(qSimb[i], s); Strings.Append(" ", s); Strings.AppendInt(c[i], 0, s); Strings.Append("  ", s) END;
        Rand(cPurple, s);
        IF totActiv THEN s := "  pășunea mare: solzul "; Strings.AppendInt(totN, 0, s); Strings.Append(" din ", s); Strings.AppendInt(totNr, 0, s); Rand(cGold, s) END;
        Rand(cText, "  pasune tot = toți solzii pe rând, câte 5 articole (10–15 minute)");
        IF wkAuto THEN Rand(cDim, "  pășunea singură e pornită (la rond) · pasune oprit") ELSE Rand(cDim, "  pășunea singură e oprită · pasune auto") END;
        Rand(cText, "  pasune muzica 10 = Muzica paște 10 articole · pasune geometria.santier 5 = doar pentru șantier · pasune muzica 5 en · pasune stop");
        Rand(cText, "  hraneste muzica wiki Acord muzical = un articol anume · hraneste aritmetica url github.com/... = o pagină")
      ELSE
        n := 0; i := 0; WHILE (w2[i] >= "0") & (w2[i] <= "9") DO n := n * 10 + ORD(w2[i]) - ORD("0"); INC(i) END;
        IF n = 0 THEN n := 5 END; IF n > 50 THEN n := 50 END;
        IF (w2 = "en") OR (w3 = "en") THEN WikiPasune(k, n, "en") ELSE WikiPasune(k, n, "ro") END
      END
    END
  END PasuneCmd;

  PROCEDURE UrlCere(k: INTEGER; u: ARRAY OF CHAR);   (* hraneste expert url adresa: pagina vine direct, apoi o mananca *)
    VAR c: ARRAY 200 OF CHAR; s: ARRAY 300 OF CHAR;
  BEGIN
    IF wkStare # 0 THEN Rand(cDim, "  ◆ încă aduc ceva · pasune stop")
    ELSE
      CaleWiki("adus7.md", c);
      IF Ecran.Aduce(u, c) THEN
        wkK := k; wkStare := 4; s := "  ◆ aduc "; Strings.Append(u, s); Strings.Append(" pentru ", s); Strings.Append(qNume[k], s); Rand(cCyan, s)
      ELSE Rand(cRed, "  ◆ nu pot pleca: altă aducere e în curs")
      END
    END
  END UrlCere;

  PROCEDURE HranesteLipit(k: INTEGER);   (* 7·B v5: hraneste arta clipboard - textul copiat (dintr-un browser, un mesaj) *)
    VAR t: ARRAY 8000 OF CHAR; s: ARRAY 200 OF CHAR; i, j, inainte: INTEGER; u: ARRAY 300 OF CHAR;
  BEGIN
    IF ~Ecran.Lipeste(t) THEN Rand(cRed, "clipboard-ul e gol · copiază întâi un text (ține apăsat pe el, apoi Copiază)")
    ELSE
      inainte := S.Total(); hrSub := hrTintaSub; j := 0; i := 0;
      WHILE (i < LEN(t)) & (t[i] # 0X) DO
        IF (t[i] = 0AX) OR (t[i] = 0DX) THEN Pune7(k, s, j)
        ELSE
          IF t[i] = 09X THEN s[j] := " " ELSE s[j] := t[i] END; INC(j);
          IF ((t[i] = ".") OR (t[i] = "!") OR (t[i] = "?")) & (j > 40) OR (j >= LEN(s) - 2) THEN Pune7(k, s, j) END
        END;
        INC(i)
      END;
      Pune7(k, s, j); SalveazaHrana;
      u := "  "; Strings.Append(qNume[k], u); Strings.Append(" a mâncat textul copiat: ", u); Strings.AppendInt(S.Total() - inainte, 0, u);
      Strings.Append(" fraze noi", u); Rand(cGreen, u); SolziArta(k)
    END
  END HranesteLipit;

  PROCEDURE HranaCmd*(l: ARRAY OF CHAR);   (* hraneste [expert] [wiki Titlu | url adresa] *)
    VAR i, k: INTEGER; w, w2: ARRAY 32 OF CHAR; rest: ARRAY 160 OF CHAR; u: ARRAY 200 OF CHAR; s: ARRAY 300 OF CHAR;
  BEGIN
    i := 0; WHILE l[i] = " " DO INC(i) END; WHILE (l[i] # 0X) & (l[i] # " ") DO INC(i) END;   (* hraneste *)
    WHILE l[i] = " " DO INC(i) END; k := 0; WHILE (l[i] # 0X) & (l[i] # " ") DO IF k < 31 THEN w[k] := l[i]; INC(k) END; INC(i) END; w[k] := 0X;
    WHILE l[i] = " " DO INC(i) END; k := 0; WHILE (l[i] # 0X) & (l[i] # " ") DO IF k < 31 THEN w2[k] := l[i]; INC(k) END; INC(i) END; w2[k] := 0X;
    WHILE l[i] = " " DO INC(i) END; k := 0; WHILE (l[i] # 0X) & (k < LEN(rest) - 1) DO rest[k] := l[i]; INC(k); INC(i) END; rest[k] := 0X;
    k := ArtaSub(w, i); hrTintaSub := i; wkSub := i;
    IF (w = "") OR (k < 0) THEN
      Rand(cPurple, "☾ hrana artelor · fiecare mănâncă doar ce îi dai ei · fraza merge în solzul (subdomeniul) potrivit");
      Rand(cText, "  hraneste muzica = alegi un fișier text de pe telefon (.txt, .md sau o pagină de Wikipedia salvată)");
      Rand(cText, "  hraneste geometria.santier = tot fișierul merge într-un singur solz · solzi geometria = care sunt");
      Rand(cText, "  hraneste muzica wiki Acord muzical = îl aduc direct de pe Wikipedia (en:Chord = în engleză)");
      Rand(cText, "  hraneste geometria.santier clipboard = textul pe care l-ai copiat (dintr-un browser, un mesaj)");
      Rand(cText, "  hraneste aritmetica url github.com/… = aduc pagina direct (GitHub: merge și cu /blob/) · pasune = pasc singur");
      Rand(cText, "  invata gramatica o frază = o frază scrisă de mână · hrana = cât a mâncat fiecare");
      Rand(cDim, "  artele: gramatica dialectica retorica aritmetica geometria muzica astronomia")
    ELSIF (w2 = "clipboard") OR (w2 = "lipit") OR (w2 = "lipeste") THEN HranesteLipit(k)   (* 7·B v5 *)
    ELSIF (w2 = "wiki") OR (w2 = "url") THEN
      IF rest = "" THEN Rand(cRed, "ce pagină? de pildă: hraneste teoria wiki Acord muzical")
      ELSE
        IF w2 = "wiki" THEN WikiCere(k, rest)   (* v7: direct, fara browser *)
        ELSE Strings.Copy(rest, u); Urla(u); UrlCere(k, u)
        END
      END
    ELSE
      hrTinta := k; Ecran.AlegeFisier;
      s := "⇩ alege fișierele pentru "; Strings.Append(qNume[k], s);
      IF hrTintaSub >= 0 THEN Strings.Append(" · ", s); Strings.Append(S.snume[k][hrTintaSub], s) END;
      Strings.Append(" · le taie în fraze și le ține minte", s); Rand(cCyan, s)
    END
  END HranaCmd;

  PROCEDURE InvataCmd*(l: ARRAY OF CHAR);   (* invata expert o fraza *)
    VAR i, k, n: INTEGER; w: ARRAY 32 OF CHAR; s: ARRAY 200 OF CHAR; t: ARRAY 120 OF CHAR;
  BEGIN
    i := 0; WHILE l[i] = " " DO INC(i) END; WHILE (l[i] # 0X) & (l[i] # " ") DO INC(i) END;
    WHILE l[i] = " " DO INC(i) END; k := 0; WHILE (l[i] # 0X) & (l[i] # " ") DO IF k < 31 THEN w[k] := l[i]; INC(k) END; INC(i) END; w[k] := 0X;
    WHILE l[i] = " " DO INC(i) END; n := 0; WHILE (l[i] # 0X) & (n < LEN(s) - 2) DO s[n] := l[i]; INC(n); INC(i) END;
    k := ArtaSub(w, i);
    IF (k < 0) OR (n < 12) THEN Rand(cRed, "invata cine ce? de pildă: invata retorica.citate Ce ție nu-ți place, altuia nu-i face (cel puțin 12 semne)")
    ELSE
      hrSub := i; s[n] := 0X; IF hrSub < 0 THEN i := S.Clasifica(k, s) END;
      Pune7(k, s, n); SalveazaHrana;
      t := "  "; Strings.Append(qNume[k], t); Strings.Append(" a învățat, în solzul ", t); Strings.Append(S.snume[k][i], t);
      Strings.Append(" · hrană în cub: ", t); Strings.AppendInt(S.Total(), 0, t); Rand(cGreen, t)
    END
  END InvataCmd;

  PROCEDURE HranaCate*;   (* v11: hrana = cat are fiecare arta in solzii ei *)
    VAR i: INTEGER; s: ARRAY 300 OF CHAR;
  BEGIN
    s := "☾ hrana: "; FOR i := 0 TO 6 DO Strings.Append(qSimb[i], s); Strings.Append(" ", s); Strings.AppendInt(S.TotalArta(i), 0, s); Strings.Append(" · ", s) END;
    Strings.Append("◆ cristale ", s); Strings.AppendInt(S.TotalArta(7), 0, s); Rand(cPurple, s);
    s := "  "; Strings.AppendInt(S.Total(), 0, s); Strings.Append(" fraze în 49 de solzi pe disc · solzi = harta lor · solzi geometria = o artă", s); Rand(cDim, s)
  END HranaCate;

  PROCEDURE SolziCmd*(a: ARRAY OF CHAR);   (* v11: solzi [arta] - cele 7 x 7 subdomenii si cata hrana are fiecare *)
    VAR k, sb, i: INTEGER; s: ARRAY 300 OF CHAR; w: ARRAY 32 OF CHAR;
  BEGIN
    i := 0; WHILE a[i] = " " DO INC(i) END; k := 0; WHILE (a[i] # 0X) & (a[i] # " ") & (k < 31) DO w[k] := a[i]; INC(k); INC(i) END; w[k] := 0X;
    k := ArtaSub(w, sb);
    IF k < 0 THEN
      Rand(cPurple, "◆ solzii: fiecare artă e un ou cu 7 subdomenii; fiecare subdomeniu are hrana lui, pe disc");
      FOR i := 0 TO 6 DO SolziArta(i) END;
      s := "  ◆ cristalele Oului: "; Strings.AppendInt(S.TotalArta(7), 0, s); Rand(cGold, s);
      Rand(cDim, "  solzi geometria · hraneste geometria.santier · invata muzica.instrumente frază · pasune astronomia.planete 5")
    ELSE
      s := "◆ "; Strings.Append(qNume[k], s); Strings.Append(" · oul artei, cu 7 subdomenii", s); Rand(cPurple, s);
      FOR i := 0 TO S.NS - 1 DO
        s := "  "; Strings.AppendInt(i + 1, 0, s); Strings.Append(" ", s); Strings.Append(S.snume[k][i], s); Strings.Append(" (", s);
        Strings.Append(qProg[k], s); Strings.Append(".", s); Strings.Append(S.sid[k][i], s); Strings.Append("): ", s);
        Strings.AppendInt(S.nr[k][i], 0, s); Strings.Append(" fraze", s);
        IF S.samanta[k][i] # "" THEN Strings.Append(" · pășune: ", s); Strings.Append(S.samanta[k][i], s) END;
        IF i = sb THEN Rand(cCyan, s) ELSE Rand(cText, s) END
      END
    END
  END SolziCmd;

  (* ---------- v4: obiceiurile (ce comenzi dai, si ce urmeaza de obicei dupa fiecare) ---------- *)

  PROCEDURE CaleObicei(VAR c: ARRAY OF CHAR);
  BEGIN CFS.Dosar(c); Strings.Append("/obicei7.mem", c)
  END CaleObicei;

  PROCEDURE SalveazaObicei;
    VAR f: Files.File; i, j, r: INTEGER; c, t: ARRAY 200 OF CHAR;
  BEGIN
    CaleObicei(c); Strings.Copy(c, t); Strings.Append(".tmp", t);
    f := Files.Create(t);
    IF f # NIL THEN
      Files.WriteInt(f, 7351); Files.WriteInt(f, nob);
      FOR i := 0 TO nob - 1 DO Files.WriteStr(f, obN[i]); Files.WriteStr(f, obL[i]); Files.WriteInt(f, obC[i]) END;
      FOR i := 0 TO nob - 1 DO FOR j := 0 TO nob - 1 DO Files.WriteInt(f, obT[i][j]) END END;
      Files.Close(f);
      IF Files.Exists(c) THEN r := Files.Delete(c) END;
      r := Files.Rename(t, c)
    END
  END SalveazaObicei;

  PROCEDURE IncarcaObicei;
    VAR f: Files.File; i, j, k, n: INTEGER; c: ARRAY 200 OF CHAR;
  BEGIN
    nob := 0; obPrev := -1; obNoi := 0; obSug := "";
    FOR i := 0 TO LEN(obC) - 1 DO obC[i] := 0; FOR j := 0 TO LEN(obC) - 1 DO obT[i][j] := 0 END END;
    CaleObicei(c); f := Files.Open(c);
    IF f # NIL THEN
      IF Files.ReadInt(f) = 7351 THEN
        n := Files.ReadInt(f); IF (n < 0) OR (n > LEN(obC)) THEN n := 0 END;
        FOR i := 0 TO n - 1 DO k := Files.ReadStr(f, obN[i]); k := Files.ReadStr(f, obL[i]); obC[i] := Files.ReadInt(f) END;
        FOR i := 0 TO n - 1 DO FOR j := 0 TO n - 1 DO obT[i][j] := Files.ReadInt(f) END END;
        nob := n
      END;
      Files.Close(f)
    END
  END IncarcaObicei;

  PROCEDURE TopComenzi(cate: INTEGER; VAR s: ARRAY OF CHAR);   (* "ls 12, eula 9, ..." *)
    VAR i, j, b, bc: INTEGER; luat: ARRAY 48 OF BOOLEAN;
  BEGIN
    s := ""; FOR i := 0 TO LEN(luat) - 1 DO luat[i] := FALSE END;
    FOR j := 1 TO cate DO
      b := -1; bc := 0;
      FOR i := 0 TO nob - 1 DO IF ~luat[i] & (obC[i] > bc) THEN bc := obC[i]; b := i END END;
      IF b >= 0 THEN
        luat[b] := TRUE; IF s # "" THEN Strings.Append(", ", s) END;
        Strings.Append(obN[b], s); Strings.Append(" ", s); Strings.AppendInt(bc, 0, s)
      END
    END
  END TopComenzi;

  PROCEDURE Obiceiuri*;   (* obiceiuri: comenzile dese si ce urmeaza dupa ele *)
    VAR s: ARRAY 300 OF CHAR; i, j, b, bc, tot: INTEGER;
  BEGIN
    IF nob = 0 THEN Rand(cDim, "◆ Oul încă nu ți-a văzut obiceiurile · dă câteva comenzi")
    ELSE
      TopComenzi(7, s); Rand(cPurple, "◆ ce faci des:"); Rand(cText, s);
      FOR i := 0 TO nob - 1 DO
        b := -1; bc := 0; tot := 0;
        FOR j := 0 TO nob - 1 DO tot := tot + obT[i][j]; IF obT[i][j] > bc THEN bc := obT[i][j]; b := j END END;
        IF bc >= 2 THEN
          s := "  după "; Strings.Append(obN[i], s); Strings.Append(" vine de obicei ", s); Strings.Append(obN[b], s);
          Strings.Append(" (", s); Strings.AppendInt(bc, 0, s); Strings.Append(" din ", s); Strings.AppendInt(tot, 0, s); Strings.Append(")", s);
          Rand(cText, s)
        END
      END
    END
  END Obiceiuri;

  (* ---------- v10: cele sapte arte liberale. Trivium: 0 Gramatica, 1 Dialectica, 2 Retorica; Quadrivium: 3 Aritmetica,
     4 Geometria, 5 Muzica, 6 Astronomia. Oul (al optulea, in afara spiralei) tine cubul, reteaua si cristalele. ---------- *)

  PROCEDURE CubulQ(): INTEGER;   (* Oul: ce e in cub acum (fisiere, spirala, comenzile tale) *)
    VAR i, c, nt, nz, n: INTEGER; t: ARRAY 32 OF CHAR; nm: ARRAY 40 OF CHAR; nm2: ARRAY 300 OF CHAR;
  BEGIN
    c := 0;
    FOR i := 0 TO qNk - 1 DO
      Tx.Copy(qKw[i], t);
      IF Tx.Incepe(t, "fisier") OR Tx.Incepe(t, "proces") OR Tx.Incepe(t, "rulea") OR Tx.Incepe(t, "spiral") OR Tx.Incepe(t, "expert")
        OR Tx.Incepe(t, "obice") OR Tx.Incepe(t, "comenz") OR Tx.Incepe(t, "arte") OR Tx.Incepe(t, "artel") THEN c := 2
      END
    END;
    nt := 0; nz := 0; n := CFS.N();
    FOR i := 0 TO n - 1 DO CFS.Nume(i, nm); IF Strings.Pos(".txt", nm, 0) > 0 THEN INC(nt) ELSIF Strings.Pos(".z7", nm, 0) > 0 THEN INC(nz) END END;
    cubTxt := "Cubul are "; Strings.AppendInt(n, 0, cubTxt); Strings.Append(" fișiere (", cubTxt); Strings.AppendInt(nt, 0, cubTxt);
    Strings.Append(" texte, ", cubTxt); Strings.AppendInt(nz, 0, cubTxt); Strings.Append(" programe) și ", cubTxt);
    Strings.AppendInt(S.Total(), 0, cubTxt); Strings.Append(" fraze de hrană, în 49 de solzi.", cubTxt); Strings.AppendChar(0AX, cubTxt);
    Strings.Append("Pe spirală:", cubTxt);
    FOR i := 0 TO Sal.NP - 1 DO
      Sal.Nume(i, nm); Strings.Append(" ", cubTxt); Strings.AppendInt(i + 1, 0, cubTxt); Strings.Append(" ", cubTxt);
      IF nm = "" THEN Strings.Append("·", cubTxt) ELSE Strings.Append(nm, cubTxt) END
    END;
    Strings.Append(" · Oul în afara spiralei.", cubTxt);
    IF nob > 0 THEN Strings.AppendChar(0AX, cubTxt); Strings.Append("Comenzile tale dese: ", cubTxt); TopComenzi(5, nm2); Strings.Append(nm2, cubTxt) END;
    RETURN c
  END CubulQ;

  PROCEDURE Fel(q: ARRAY OF CHAR): INTEGER;   (* felul intrebarii: 0 muzica, 1 cu cifre, 2 cuvinte *)
    VAR i, f: INTEGER;
  BEGIN
    IF S.EsteMuzica(q) THEN f := 0
    ELSE
      f := 2; i := 0;
      WHILE (i < LEN(q)) & (q[i] # 0X) DO IF (q[i] >= "0") & (q[i] <= "9") THEN f := 1 END; INC(i) END
    END;
    RETURN f
  END Fel;

  PROCEDURE Arata(k: INTEGER);   (* raspunsul artei k *)
    VAR s: ARRAY 600 OF CHAR; f: ARRAY 560 OF CHAR;
  BEGIN
    IF (k = 5) & ~qHr[5] & AM.teorie THEN Scr(cText, AM.lung); canta
    ELSIF (k = 6) & ~qHr[6] & AS.joc THEN
      IF ~(Tx.Incepe(qRaw[6], "zodia") OR Tx.Incepe(qRaw[6], "trei")) THEN s := "  "; Strings.Append(qRaw[6], s); Scr(cText, s) END;
      IF AS.zod >= 0 THEN zodie(AS.zNume[AS.zod]) ELSE taro(qQ) END
    ELSIF qSursa[k] = "" THEN s := "  "; Strings.Append(qRaw[k], s); Scr(cText, s)
    ELSE   (* 7·B v17: propozitia, apoi de unde stie *)
      Fraza(qRaw[k], f); s := "  "; Strings.Append(f, s); Rand(cText, s);
      s := "    ↳ "; Strings.Append(qSursa[k], s); Rand(cDim, s)
    END
  END Arata;

  PROCEDURE Inc(f, w: ARRAY OF CHAR; t: INTEGER; VAR p: INTEGER);   (* 7·B v15: intrebarea incepe cu w: felul t, subiectul dupa w *)
  BEGIN IF (qTip = 0) & Tx.Incepe(f, w) THEN qTip := t; p := Strings.Length(w) END
  END Inc;

  PROCEDURE Tip(q0: ARRAY OF CHAR);   (* 7·B v15: felul intrebarii (qTip) si subiectul ei (qX, qXf = litere mici, fara diacritice) *)
    VAR f, q: ARRAY 160 OF CHAR; i, p, n: INTEGER; gata: BOOLEAN;
  BEGIN
    i := 0; WHILE q0[i] = " " DO INC(i) END; Tx.Sub(q0, i, Strings.Length(q0), q);
    Tx.Copy(q, f); Tx.MicS(f); Tx.FoldS(f); qTip := 0; p := 0; qX := ""; qXf := ""; qCine := Tx.Incepe(f, "cine ");
    Inc(f, "ce este ", 1, p); Inc(f, "ce e ", 1, p); Inc(f, "ce-i ", 1, p); Inc(f, "ce sunt ", 1, p); Inc(f, "ce inseamna ", 1, p); Inc(f, "ce reprezinta ", 1, p);
    Inc(f, "ce a fost ", 1, p); Inc(f, "ce stii despre ", 1, p); Inc(f, "spune-mi despre ", 1, p); Inc(f, "cine este ", 1, p); Inc(f, "cine e ", 1, p);
    Inc(f, "cine a fost ", 1, p); Inc(f, "cine sunt ", 1, p); Inc(f, "cine era ", 1, p); Inc(f, "defineste ", 1, p); Inc(f, "explica-mi ", 1, p); Inc(f, "explica ", 1, p);
    Inc(f, "de ce ", 7, p); Inc(f, "cand ", 3, p); Inc(f, "unde ", 4, p); Inc(f, "cat ", 5, p); Inc(f, "cate ", 5, p); Inc(f, "cati ", 5, p); Inc(f, "cata ", 5, p); Inc(f, "cum ", 6, p);
    IF qTip = 1 THEN   (* subiectul: fara un / o / niste la inceput si fara semnele de la sfarsit *)
      gata := FALSE;
      WHILE ~gata DO
        gata := TRUE;
        IF Tx.IncepeLa(f, p, "un ") THEN p := p + 3; gata := FALSE
        ELSIF Tx.IncepeLa(f, p, "o ") THEN p := p + 2; gata := FALSE
        ELSIF Tx.IncepeLa(f, p, "niste ") THEN p := p + 6; gata := FALSE
        ELSIF Tx.IncepeLa(f, p, "despre ") THEN p := p + 7; gata := FALSE
        END
      END;
      Tx.Sub(q, p, Strings.Length(q), qX); n := Strings.Length(qX);
      WHILE (n > 0) & ((qX[n - 1] = "?") OR (qX[n - 1] = ".") OR (qX[n - 1] = " ") OR (qX[n - 1] = "!")) DO DEC(n); qX[n] := 0X END;
      Tx.Copy(qX, qXf); Tx.MicS(qXf); Tx.FoldS(qXf); qL := "";
      IF (qX # "") & (Strings.Pos(" ", qX, 0) < 0) & ~Tx.Majuscula(qX[0]) & AG.Lema(qX, qL) THEN   (* 7·B v17: un cuvant: forma lui de baza *)
        IF qL = qX THEN qL := "" END
      END;
      IF qX = "" THEN qTip := 0
      ELSE i := 0; WHILE qXf[i] # 0X DO IF (qXf[i] >= "0") & (qXf[i] <= "9") THEN qTip := 5 END; INC(i) END   (* ce este 3 + 4: o socoteala *)
      END
    END
  END Tip;

  PROCEDURE Cuvant(VAR r: ARRAY OF CHAR; VAR i: INTEGER; VAR w: ARRAY OF CHAR);   (* 7·B v16: urmatorul cuvant din r, de la i *)
    VAR k: INTEGER;
  BEGIN
    WHILE (i < LEN(r)) & (r[i] # 0X) & ~Tx.LitCif(r[i]) & (r[i] # "(") DO INC(i) END;
    k := 0;
    IF (i < LEN(r)) & (r[i] = "(") THEN w[0] := "("; k := 1; INC(i)
    ELSE WHILE (i < LEN(r)) & (r[i] # 0X) & (Tx.LitCif(r[i]) OR (r[i] = "-")) DO IF k < LEN(w) - 1 THEN w[k] := r[i]; INC(k) END; INC(i) END
    END;
    w[k] := 0X
  END Cuvant;

  PROCEDURE DefS(raw, sx: ARRAY OF CHAR): BOOLEAN;   (* 7·B v16: fraza spune ce e subiectul: „X (…) este / e / sunt / reprezinta / inseamna / a fost …” *)
    VAR r: ARRAY 300 OF CHAR; xs: ARRAY 64 OF CHAR; w, sw, st: ARRAY 40 OF CHAR; i, j, n, d, adanc: INTEGER; da, bun: BOOLEAN;
  BEGIN
    da := FALSE; Tx.Copy(sx, xs);
    IF sx # "" THEN
      Tx.Copy(raw, r); Tx.MicS(r); Tx.FoldS(r); i := 0; j := 0; bun := TRUE;
      WHILE bun & (sx[j] # 0X) DO   (* fiecare cuvant al subiectului, pe rand, la inceputul frazei *)
        Cuvant(xs, j, sw);
        IF sw # "" THEN
          n := Strings.Length(sw); IF n > 5 THEN n := n - 2 ELSIF n > 3 THEN n := n - 1 END;
          FOR d := 0 TO n - 1 DO st[d] := sw[d] END; st[n] := 0X;
          Cuvant(r, i, w); bun := Tx.Incepe(w, st)
        END
      END;
      IF bun THEN
        Cuvant(r, i, w);
        IF w = "(" THEN   (* o paranteza dupa subiect: „Pianul (din italiana pianoforte) este …” *)
          adanc := 1; WHILE (i < LEN(r)) & (r[i] # 0X) & (adanc > 0) DO IF r[i] = "(" THEN INC(adanc) ELSIF r[i] = ")" THEN DEC(adanc) END; INC(i) END;
          Cuvant(r, i, w)
        END;
        IF (w = "este") OR (w = "e") OR (w = "sunt") OR (w = "reprezinta") OR (w = "inseamna") OR (w = "era") OR (w = "erau") THEN da := TRUE
        ELSIF w = "a" THEN Cuvant(r, i, w); da := (w = "fost")
        END
      END
    END;
    RETURN da
  END DefS;

  PROCEDURE Def(raw: ARRAY OF CHAR): BOOLEAN;   (* 7·B v17: subiectul asa cum a fost scris, sau forma lui de baza *)
    VAR l: ARRAY 64 OF CHAR; da: BOOLEAN;
  BEGIN
    da := DefS(raw, qXf);
    IF ~da & (qL # "") THEN Tx.Copy(qL, l); Tx.MicS(l); Tx.FoldS(l); da := DefS(raw, l) END;
    RETURN da
  END Def;

  PROCEDURE DinDictionar(): BOOLEAN;   (* 7·B v15: dictionarul cubului (✎ Gramatica · dictionar) stie ce e subiectul? *)
    VAR fr: ARRAY 600 OF CHAR; gasit: BOOLEAN; i: INTEGER;
  BEGIN
    gasit := FALSE; S.Deschide(0, 3);
    WHILE ~gasit & S.Urm(fr) DO IF Def(fr) THEN gasit := TRUE; Tx.Copy(fr, qRaw[0]) END END;
    S.Inchide;
    IF gasit THEN qSursa[0] := "dicționarul cubului"; qConf[0] := 2; qHr[0] := TRUE; qSub[0] := 3
    ELSIF Mm.gata THEN   (* 7·B v18: frazele din memoria Eulei care incep cu subiectul (sau cu forma lui de baza) *)
      Mm.Subiect(qXf); i := 0;
      WHILE ~gasit & (i < Mm.nsub) DO Mm.Citeste(Mm.sub[i], fr); IF Def(fr) THEN gasit := TRUE; Tx.Copy(fr, qRaw[0]) END; INC(i) END;
      IF ~gasit & (qL # "") THEN
        Mm.Subiect(qL); i := 0;
        WHILE ~gasit & (i < Mm.nsub) DO Mm.Citeste(Mm.sub[i], fr); IF Def(fr) THEN gasit := TRUE; Tx.Copy(fr, qRaw[0]) END; INC(i) END
      END;
      IF gasit THEN qSursa[0] := "memoria Eulei"; qConf[0] := 2; qHr[0] := TRUE; qSub[0] := 3 END
    END;
    RETURN gasit
  END DinDictionar;

  PROCEDURE DefPleaca(): BOOLEAN;   (* 7·B v15: primele fraze de pe Wikipedia despre subiect *)
    VAR ok: BOOLEAN;
  BEGIN
    ok := FALSE;
    IF wkStare = 0 THEN
      wkK := 0; wkSub := 3; wkRamase := 0; wkGoale := 0; wkMancat := 0; wkFraze := 0; wkIncercari := 0; wkLimba := "ro";
      IF qL # "" THEN Tx.Copy(qL, wkCaut) ELSE Tx.Copy(qX, wkCaut) END; wkPrima := ""; wkIntro := TRUE; defAst := TRUE;   (* 7·B v17: muncă, nu munca *)
      ok := WikiPleaca(wkCaut, 0);
      IF ~ok THEN wkIntro := FALSE; defAst := FALSE END
    END;
    RETURN ok
  END DefPleaca;

  PROCEDURE Leg(w: ARRAY OF CHAR; k: INTEGER): INTEGER;   (* 7·B v12: legatura cuvant → arta; -1 = nu e *)
    VAR i, r: INTEGER;
  BEGIN r := -1; FOR i := 0 TO nlg - 1 DO IF (lgK[i] = k) & (lgW[i] = w) THEN r := i END END; RETURN r
  END Leg;

  PROCEDURE Bonus(k: INTEGER; VAR cuv: ARRAY OF CHAR): INTEGER;   (* cat tin cuvintele intrebarii de arta k; cuv = cel mai tare *)
    VAR i, j, b, m: INTEGER;
  BEGIN
    b := 0; m := 0; cuv := "";
    FOR i := 0 TO qNk - 1 DO
      j := Leg(qKw[i], k);
      IF j >= 0 THEN b := b + lgS[j]; IF ABS(lgS[j]) > m THEN m := ABS(lgS[j]); Tx.Copy(lgW[j], cuv) END END
    END;
    IF b > 20 THEN b := 20 ELSIF b < -20 THEN b := -20 END;
    RETURN b
  END Bonus;

  PROCEDURE SalveazaLeg;
    VAR s: ARRAY LC OF CHAR; i: INTEGER;
  BEGIN
    s := "";
    FOR i := 0 TO nlg - 1 DO
      IF Strings.Length(s) + Strings.Length(lgW[i]) + 8 < LC THEN
        Strings.AppendInt(lgK[i], 0, s); Strings.Append(" ", s); Strings.Append(lgW[i], s); Strings.Append(" ", s);
        Strings.AppendInt(lgS[i], 0, s); Strings.AppendChar(0AX, s)
      END
    END;
    IF s = "" THEN s := "-" END;
    IF CFS.Scrie("legaturi.txt", s) < 0 THEN Rand(cRed, "nu pot scrie legaturi.txt") END
  END SalveazaLeg;

  PROCEDURE IncarcaLeg;
    VAR t: ARRAY LC OF CHAR; i, j, v, sg: INTEGER;
  BEGIN
    nlg := 0; i := CFS.Gaseste("legaturi.txt");
    IF i >= 0 THEN
      CFS.Continut(i, t); i := 0;
      WHILE (nlg < 64) & (i < LEN(t) - 2) & (t[i] >= "0") & (t[i] <= "6") DO
        lgK[nlg] := ORD(t[i]) - ORD("0"); INC(i); IF t[i] = " " THEN INC(i) END;
        j := 0; WHILE (i < LEN(t) - 1) & (t[i] # " ") & (t[i] # 0X) & (t[i] # 0AX) DO IF j < 23 THEN lgW[nlg][j] := t[i]; INC(j) END; INC(i) END;
        lgW[nlg][j] := 0X; IF t[i] = " " THEN INC(i) END;
        sg := 1; IF t[i] = "-" THEN sg := -1; INC(i) END;
        v := 0; WHILE (t[i] >= "0") & (t[i] <= "9") DO v := v * 10 + ORD(t[i]) - ORD("0"); INC(i) END;
        lgS[nlg] := sg * v; IF t[i] = 0AX THEN INC(i) END;
        IF j > 0 THEN INC(nlg) END
      END
    END
  END IncarcaLeg;

  PROCEDURE Invata(k, d: INTEGER);   (* 7·B v12: cuvintele intrebarii se leaga (d > 0) sau se dezleaga (d < 0) de arta k *)
    VAR i, j, m, u: INTEGER;
  BEGIN
    FOR i := 0 TO qNk - 1 DO
      IF Strings.Length(qKw[i]) >= 3 THEN
        j := Leg(qKw[i], k);
        IF j < 0 THEN
          IF nlg < 64 THEN j := nlg; INC(nlg)
          ELSE m := 999; FOR u := 0 TO nlg - 1 DO IF ABS(lgS[u]) < m THEN m := ABS(lgS[u]); j := u END END   (* locul celei mai slabe *)
          END;
          Tx.Copy(qKw[i], lgW[j]); lgK[j] := k; lgS[j] := 0
        END;
        lgS[j] := lgS[j] + d; IF lgS[j] > 9 THEN lgS[j] := 9 ELSIF lgS[j] < -9 THEN lgS[j] := -9 END
      END
    END;
    SalveazaLeg
  END Invata;

  PROCEDURE Scor(k: INTEGER): INTEGER;   (* cat cantareste raspunsul artei k: siguranta × incredere + legaturile *)
    VAR sc: INTEGER; cuv: ARRAY 24 OF CHAR;
  BEGIN
    sc := 0;
    IF qConf[k] > 0 THEN
      sc := qConf[k] * qIncr[qFel][k] * 2; IF qSursa[k] = "" THEN INC(sc) END;   (* la egalitate: arta care a calculat *)
      sc := sc + 2 * Bonus(k, cuv);
      IF qTip = 1 THEN IF Def(qRaw[k]) THEN sc := sc + 60 ELSE sc := sc DIV 4 END   (* 7·B v15: ce este X: castiga cine chiar defineste X *)
      ELSIF (qTip = 5) & (qSursa[k] = "") THEN sc := sc + 10   (* cat: cine a socotit *)
      ELSIF (qTip = 3) & (Tx.Contine(qRaw[k], "1") OR Tx.Contine(qRaw[k], "2")) THEN sc := sc + 6   (* cand: un an, o data *)
      ELSIF (qTip = 7) & (Tx.Contine(qRaw[k], "pentru că") OR Tx.Contine(qRaw[k], "deoarece") OR Tx.Contine(qRaw[k], "din cauza")) THEN sc := sc + 10
      END;
      IF sc < 1 THEN sc := 1 END
    END;
    RETURN sc
  END Scor;

  PROCEDURE DeCe(k: INTEGER);   (* 7·B v12: Oul spune ce a invatat, cand a contat *)
    VAR b: INTEGER; cuv: ARRAY 24 OF CHAR; s: ARRAY 160 OF CHAR;
  BEGIN
    b := Bonus(k, cuv);
    IF b > 0 THEN s := "  (Oul își amintește: „"; Strings.Append(cuv, s); Strings.Append("” ține de ", s); Strings.Append(qSimb[k], s); Strings.Append(")", s); Rand(cDim, s) END
  END DeCe;

  PROCEDURE Oul;   (* a 8-a dimensiune: in afara spiralei, cantareste ce au spus cei sapte si cristalizeaza *)
    VAR k, j, sc, bs: INTEGER; s: ARRAY 200 OF CHAR; pleaca: BOOLEAN; s2: ARRAY 600 OF CHAR;
  BEGIN
    qOcupat := FALSE; qCastig := -1; bs := 0;
    FOR k := 0 TO 6 DO   (* 7·B v12: Scor = siguranta × incredere + ce a invatat Oul din bun / gresit *)
      qIncerc[k] := FALSE; sc := Scor(k);
      IF sc > bs THEN bs := sc; qCastig := k END
    END;
    IF qCastig >= 0 THEN qIncerc[qCastig] := TRUE END;
    pleaca := FALSE;
    IF (qTip = 1) & ((qCastig < 0) OR ~Def(qRaw[qCastig])) THEN   (* 7·B v15: nimeni n-a spus ce e X *)
      IF DinDictionar() THEN qCastig := 0; qIncerc[0] := TRUE ELSE pleaca := TRUE END
    ELSIF (qTip # 1) & Mm.gata & ((qCastig < 0) OR (qConf[qCastig] < 2)) THEN   (* 7·B v18: nimeni nu e sigur: ce zice memoria Eulei *)
      sc := Mm.Cauta(qKw, qNk, s2);
      IF (sc >= 2) OR (sc >= 1) & (qNk = 1) THEN
        Tx.Copy(s2, qRaw[2]); qSursa[2] := "memoria Eulei"; qConf[2] := 2; qHr[2] := TRUE; qSub[2] := 0; qCastig := 2; qIncerc[2] := TRUE
      END
    END;
    s := "  bănuiesc:"; j := 0;   (* v4: cei care doar banuiesc, pe un rand *)
    FOR k := 0 TO 6 DO IF qConf[k] = 1 THEN Strings.Append(" ", s); Strings.Append(qSimb[k], s); INC(j) END END;
    IF j = 0 THEN s := "  " END;
    Strings.Append("  nu știu:", s);
    FOR k := 0 TO 6 DO IF (qConf[k] = 0) & (qExp[k] >= 0) THEN Strings.Append(" ", s); Strings.Append(qSimb[k], s) END END;
    Rand(cDim, s);
    IF pleaca THEN
      IF qCine THEN s := "◆ Oul: nimeni din cub nu știe încă cine e „" ELSE s := "◆ Oul: nimeni din cub nu știe încă ce e „" END; Strings.Append(qX, s); Strings.Append("” · întreb Wikipedia …", s); Rand(cPurple, s);
      IF ~DefPleaca() THEN
        Rand(cDim, "  (Wikipedia e ocupată cu pășunea · întreabă din nou după ce termină)");
        IF qCastig >= 0 THEN s := "  până atunci, "; Strings.Append(qNume[qCastig], s); Strings.Append(" zice:", s); Rand(cDim, s); Arata(qCastig) END
      END;
      qCastig := -1
    ELSIF qCastig < 0 THEN Rand(cRed, "◆ Oul: nimic de cristalizat · nimeni nu știe · hrănește un expert: hraneste")
    ELSE
      s := "◆ Oul (în afara spiralei): cristalul vine de la "; Strings.Append(qNume[qCastig], s); SubNume(qCastig, s); Rand(cPurple, s);
      DeCe(qCastig); Arata(qCastig);
      IF (qCastig = 5) & ~qHr[5] & AM.teorie THEN Tx.Copy(AM.lung, ultimRasp) ELSE Tx.Copy(qRaw[qCastig], ultimRasp) END;   (* 7·B v5 *)
      FOR j := 0 TO 6 DO
        IF (j # qCastig) & (qConf[j] = 2) THEN s := "  + "; Strings.Append(qNume[j], s); SubNume(j, s); Strings.Append(" știe și ea:", s); Rand(cCyan, s); Arata(j) END
      END;
      Rand(cDim, "  bun = cristalul intră în memorie · gresit = scade încrederea · incredere · hrana")
    END
  END Oul;

  PROCEDURE Expert(k, t: INTEGER): INTEGER;   (* arta k, chemata de procesul ei de pe tura t; v11: arta e un ou, cu cele 7 subdomenii ale ei *)
    VAR c: INTEGER; s: ARRAY 200 OF CHAR;
  BEGIN
    c := 0;
    IF qOcupat & (k >= 0) & (k <= 6) THEN
      qHr[k] := FALSE; qSursa[k] := ""; qRaw[k] := ""; qSub[k] := -1; S.Curat;
      IF k = 0 THEN c := AG.Raspunde(qRaw[k], qSursa[k]); qSub[k] := AG.sub
      ELSIF k = 1 THEN c := AD.Raspunde(qRaw[k], qSursa[k]); qSub[k] := AD.sub
      ELSIF k = 2 THEN c := AR.Raspunde(qRaw[k], qSursa[k]); qSub[k] := AR.sub
      ELSIF k = 3 THEN c := AA.Raspunde(qRaw[k], qSursa[k]); qSub[k] := AA.sub
      ELSIF k = 4 THEN c := AGe.Raspunde(qRaw[k], qSursa[k]); qSub[k] := AGe.sub
      ELSIF k = 5 THEN c := AM.Raspunde(qRaw[k], qSursa[k]); qSub[k] := AM.sub
      ELSE c := AS.Raspunde(qRaw[k], qSursa[k]); qSub[k] := AS.sub
      END;
      qHr[k] := S.dinHrana; qConf[k] := c;
      IF c = 2 THEN
        s := "  "; Strings.Append(qNume[k], s); SubNume(k, s); IF t >= 0 THEN Strings.Append(" (tura ", s); Strings.AppendInt(t + 1, 0, s); Strings.Append("): ", s) ELSE Strings.Append(" (din Ou): ", s) END; Sigur(c, s);
        IF (k = 2) & (AR.cuburi > 0) THEN Strings.Append(" · cuburi găsite: ", s); Strings.AppendInt(AR.cuburi, 0, s) END;
        Rand(cCyan, s)
      END;
      INC(qVenit); IF qVenit >= qAstept THEN Oul END
    END;
    RETURN c
  END Expert;

  PROCEDURE ExpertHook(t, cod: INTEGER): INTEGER;   (* ASCULTA(-(1000 + cod)) din programele Z7: 1k = expertul k *)
    VAR r: INTEGER;
  BEGIN
    r := 0; IF cod DIV 100 = 1 THEN r := Expert(cod MOD 100, t) END;
    RETURN r
  END ExpertHook;

  PROCEDURE SalveazaIncr;   (* 3 x 7: muzica, cifre, cuvinte *)
    VAR s: ARRAY 100 OF CHAR; f, k: INTEGER;
  BEGIN
    s := "";
    FOR f := 0 TO 2 DO FOR k := 0 TO 6 DO Strings.AppendInt(qIncr[f][k], 0, s); Strings.Append(" ", s) END END;
    IF CFS.Scrie("incredere10.txt", s) < 0 THEN Rand(cRed, "nu pot scrie incredere10.txt") END
  END SalveazaIncr;

  PROCEDURE IncarcaIncr;
    VAR t: ARRAY LC OF CHAR; i, f, k, v: INTEGER;
  BEGIN
    FOR f := 0 TO 2 DO FOR k := 0 TO 6 DO qIncr[f][k] := 10 END END;
    i := CFS.Gaseste("incredere10.txt");
    IF i >= 0 THEN
      CFS.Continut(i, t); i := 0;
      FOR f := 0 TO 2 DO
        FOR k := 0 TO 6 DO
          WHILE (i < LEN(t) - 1) & ((t[i] = " ") OR (t[i] = 0AX)) DO INC(i) END; v := 0;
          WHILE (i < LEN(t) - 1) & (t[i] >= "0") & (t[i] <= "9") DO v := v * 10 + ORD(t[i]) - ORD("0"); INC(i) END;
          IF (v >= 1) & (v <= 99) THEN qIncr[f][k] := v END
        END
      END
    END
  END IncarcaIncr;

  PROCEDURE Legaturi*;   (* 7·B v12: ce a invatat Oul: cuvant → arta *)
    VAR i, k, n: INTEGER; s: ARRAY 300 OF CHAR;
  BEGIN
    IF nlg = 0 THEN Rand(cDim, "◆ Oul n-a învățat încă nimic · după un răspuns: bun / gresit")
    ELSE
      Rand(cPurple, "◆ ce a învățat Oul din bun / gresit (cuvântul → arta, tăria):");
      FOR k := 0 TO 6 DO
        s := "  "; Strings.Append(qSimb[k], s); Strings.Append(" ", s); n := 0;
        FOR i := 0 TO nlg - 1 DO
          IF (lgK[i] = k) & (lgS[i] # 0) & (Strings.Length(s) < 250) THEN
            Strings.Append(lgW[i], s); Strings.Append(" ", s); IF lgS[i] > 0 THEN Strings.Append("+", s) END; Strings.AppendInt(lgS[i], 0, s); Strings.Append(" · ", s); INC(n)
          END
        END;
        IF n > 0 THEN Rand(cText, s) END
      END
    END
  END Legaturi;

  PROCEDURE ArataIncr*;   (* incredere: tabelul 3 x 7 *)
    VAR s: ARRAY 160 OF CHAR; f, k: INTEGER;
  BEGIN
    Rand(cPurple, "☾ încrederea Oului · pe fel de întrebare");
    FOR f := 0 TO 2 DO
      s := "  "; Strings.Append(qFelNume[f], s); Strings.Append(":", s);
      FOR k := 0 TO 6 DO Strings.Append("  ", s); Strings.Append(qSimb[k], s); Strings.AppendInt(qIncr[f][k], 0, s) END;
      Rand(cText, s)
    END
  END ArataIncr;

  PROCEDURE Cristalizeaza(k: INTEGER);   (* bun: raspunsul intra in hrana, ca cristal *)
    VAR c: ARRAY 200 OF CHAR; fr: ARRAY 256 OF CHAR; i, n: INTEGER; dublu: BOOLEAN;
  BEGIN
    IF (k = 6) & ~qHr[k] THEN Rand(cDim, "  (cerul și ceasul se schimbă de la o zi la alta: nu le cristalizez)")
    ELSIF qHr[k] & (qSursa[k] = "◆ cristal") THEN Rand(cDim, "  (era deja un cristal)")
    ELSE
      Tx.Copy(qQ, c); Strings.Append(" → ", c); n := Strings.Length(c); i := 0;
      WHILE (n < LEN(c) - 1) & (qRaw[k][i] # 0X) DO IF qRaw[k][i] = 0AX THEN c[n] := " " ELSE c[n] := qRaw[k][i] END; INC(n); INC(i) END;
      dublu := FALSE; S.Deschide(7, 0); WHILE ~dublu & S.Urm(fr) DO IF fr = c THEN dublu := TRUE END END; S.Inchide;
      IF dublu THEN Rand(cDim, "  (cristalul e deja în memorie)")
      ELSE hrSub := 0; Pune7(7, c, n); SalveazaHrana; Rand(cGold, "  ◆ cristalizat · data viitoare îl găsește ¶ Retorica")
      END
    END
  END Cristalizeaza;

  PROCEDURE Parere*(bun: BOOLEAN);
    VAR s: ARRAY 200 OF CHAR; k, j, bs: INTEGER;
  BEGIN
    k := qCastig;
    IF k < 0 THEN Rand(cDim, "nu e niciun răspuns de judecat")
    ELSE
      IF bun THEN IF qIncr[qFel][k] < 99 THEN INC(qIncr[qFel][k]) END
      ELSIF qIncr[qFel][k] > 1 THEN DEC(qIncr[qFel][k])
      END;
      s := "  încrederea în "; Strings.Append(qNume[k], s); Strings.Append(" la ", s); Strings.Append(qFelNume[qFel], s);
      Strings.Append(": ", s); Strings.AppendInt(qIncr[qFel][k], 0, s);
      IF bun THEN Rand(cGreen, s); Cristalizeaza(k); Invata(k, 2); qCastig := -1
      ELSE
        Rand(cRed, s); Invata(k, -2);   (* 7·B v12: Oul nu se lasa: incearca urmatorul care stie *)
        qCastig := -1; bs := 0;
        FOR j := 0 TO 6 DO IF ~qIncerc[j] & (Scor(j) > bs) THEN bs := Scor(j); qCastig := j END END;
        IF qCastig >= 0 THEN
          qIncerc[qCastig] := TRUE;
          s := "◆ Oul: atunci poate are dreptate "; Strings.Append(qNume[qCastig], s); SubNume(qCastig, s); Rand(cPurple, s);
          Arata(qCastig); Tx.Copy(qRaw[qCastig], ultimRasp);
          Rand(cDim, "  bun / gresit")
        ELSE Rand(cDim, "  ◆ Oul: nu mai am pe nimeni care să știe · hrănește o artă: hraneste")
        END
      END;
      SalveazaIncr
    END
  END Parere;

  PROCEDURE ESus(t: INTEGER; nume: ARRAY OF CHAR): BOOLEAN;   (* pe tura t ruleaza programul nume? *)
    VAR n: ARRAY 32 OF CHAR;
  BEGIN
    n := ""; IF (t >= 0) & (t < Sal.NP) THEN Sal.Nume(t, n) END;
    RETURN n = nume
  END ESus;

  PROCEDURE PornesteEule(): BOOLEAN;   (* 7·B v14: expertii pe turele libere; cei fara loc raspund din Ou. Nu opreste nimic. *)
    VAR k, t, n, lib: INTEGER; nm: ARRAY 32 OF CHAR; f: ARRAY 40 OF CHAR; s: ARRAY 200 OF CHAR; schimbat: BOOLEAN;
  BEGIN
    schimbat := FALSE;
    FOR t := 0 TO Sal.NP - 1 DO   (* v10: expertii de dinainte *)
      Sal.Nume(t, nm); IF (nm # "") & Tx.InLista(nm, "teoria|memoria|calcul|oracol|cubul|ceasul|reteaua") THEN Sal.Opreste(t) END
    END;
    FOR k := 0 TO 6 DO
      IF ~ESus(qExp[k], qProg[k]) THEN
        qExp[k] := -1;
        FOR t := 0 TO Sal.NP - 1 DO IF (qExp[k] < 0) & ESus(t, qProg[k]) THEN qExp[k] := t END END   (* ruleaza deja (sesiunea veche) *)
      END;
      IF qExp[k] < 0 THEN
        lib := -1; FOR t := 0 TO Sal.NP - 1 DO IF Sal.Stare(t) = Sal.Liber THEN lib := t END END;
        IF lib >= 0 THEN
          pornesc := TRUE; Strings.Copy(qProg[k], f); Strings.Append(".z7l", f); qExp[k] := Sal.Porneste(f); pornesc := FALSE; schimbat := TRUE
        END
      END;
      qImpr[k] := qExp[k] < 0   (* fara tura: revine pe spirala cand se elibereaza una *)
    END;
    IF schimbat THEN
      n := 0; FOR k := 0 TO 6 DO IF qExp[k] >= 0 THEN INC(n) END END;
      IF n = 7 THEN Rand(cPurple, "☾ Cubicum 7: șapte experți pe cele șapte ture · Oul ascultă din afara spiralei · vezi Network")
      ELSE s := "☾ "; Strings.AppendInt(n, 0, s); Strings.Append(" experți pe spirală · ceilalți răspund din Ou, până se eliberează o tură", s); Rand(cPurple, s)
      END
    END;
    qAstept := 7;
    RETURN TRUE
  END PornesteEule;

  (* ---------- v4: Oul face, nu doar raspunde ---------- *)

  PROCEDURE Fa(cmd: ARRAY OF CHAR);   (* Oul da o comanda de Shell, ca si cum ai fi scris-o tu *)
    VAR s: ARRAY 200 OF CHAR;
  BEGIN
    s := "◆ Oul face: "; Strings.Append(cmd, s); Rand(cPurple, s);
    executa(cmd)
  END Fa;

  PROCEDURE PrimulCuv(VAR t: ARRAY OF CHAR; VAR w, rest: ARRAY OF CHAR);   (* primul cuvant si restul (fara spatii in fata) *)
    VAR i, k: INTEGER;
  BEGIN
    i := 0; WHILE t[i] = " " DO INC(i) END;
    k := 0; WHILE (t[i] # 0X) & (t[i] # " ") DO IF k < LEN(w) - 1 THEN w[k] := t[i]; INC(k) END; INC(i) END; w[k] := 0X;
    WHILE t[i] = " " DO INC(i) END;
    k := 0; WHILE (t[i] # 0X) & (k < LEN(rest) - 1) DO rest[k] := t[i]; INC(k); INC(i) END; rest[k] := 0X
  END PrimulCuv;

  PROCEDURE TuraDin(VAR r: ARRAY OF CHAR): INTEGER;   (* "tura 3" sau numele unui program de pe spirala -> tura; -1 = nu stiu *)
    VAR i, t: INTEGER; w, rest: ARRAY 64 OF CHAR; nm: ARRAY 32 OF CHAR;
  BEGIN
    t := -1; i := 0;
    WHILE (r[i] # 0X) & (t < 0) DO IF (r[i] >= "1") & (r[i] <= "7") & ((i = 0) OR (r[i - 1] = " ")) THEN t := ORD(r[i]) - ORD("1") END; INC(i) END;   (* 7·B: tura 1..7 *)
    IF t < 0 THEN
      PrimulCuv(r, w, rest); IF (w = "programul") OR (w = "procesul") THEN PrimulCuv(rest, w, rest) END;
      FOR i := 0 TO Sal.NP - 1 DO Sal.Nume(i, nm); IF (nm # "") & (nm = w) THEN t := i END END
    END;
    RETURN t
  END TuraDin;

  (* ---------- v4: rondul Oului (o data pe ora, singur, cat timp aplicatia e deschisa) ---------- *)

  PROCEDURE Rond*(cerut: BOOLEAN);
    VAR n, a, k, t, jos, fl, sb: INTEGER; s: ARRAY 300 OF CHAR; x: ARRAY 200 OF CHAR; nou, ok: BOOLEAN;
  BEGIN
    n := CFS.N(); a := CFS.NrAsh(); nou := FALSE;
    t := CFS.Local(Os.CurrentTime()) MOD 86400;
    s := "◆ rondul Oului · "; Strings.AppendInt(t DIV 3600, 0, s); Strings.Append(":", s);
    IF t MOD 3600 DIV 60 < 10 THEN Strings.Append("0", s) END; Strings.AppendInt(t MOD 3600 DIV 60, 0, s);
    Rand(cPurple, s);
    IF n # rFis THEN
      nou := TRUE; s := "  fișiere în cub: "; Strings.AppendInt(rFis, 0, s); Strings.Append(" → ", s); Strings.AppendInt(n, 0, s); Rand(cText, s)
    END;
    IF a > rAsh THEN
      nou := TRUE; CFS.Ash(a - 1, x); s := "  a ars ceva (Ash): "; Strings.Append(x, s); Rand(cRed, s)
    END;
    IF S.Total() # rHr THEN
      nou := TRUE; s := "  hrana: "; Strings.AppendInt(rHr, 0, s); Strings.Append(" → ", s); Strings.AppendInt(S.Total(), 0, s); Strings.Append(" fraze în solzi", s); Rand(cText, s)
    END;
    jos := 0; FOR k := 0 TO 6 DO IF (qExp[k] >= 0) & ~ESus(qExp[k], qProg[k]) THEN INC(jos) END END;
    IF jos > 0 THEN
      nou := TRUE; s := "  "; Strings.AppendInt(jos, 0, s); Strings.Append(" experți nu mai erau pe spirală · îi repornesc", s); Rand(cYel, s);
      FOR k := 0 TO 6 DO qExp[k] := -1 END; ok := PornesteEule();
      IF ~ok THEN Rand(cRed, "  n-am putut") END
    END;
    IF V.Noi() > 0 THEN nou := TRUE END;   (* v6: .Mod-uri noi in Download *)
    IF Cp.Auto() THEN nou := TRUE; Rand(cText, "  copia de siguranță a zilei: Download/Cubicum7B-copie-auto.z7c") END;   (* 7·B v5 *)
    IF wkAuto & (wkStare = 0) & ~totActiv THEN   (* v11: solzul cel mai gol (din toate artele) paste 3 articole *)
      S.Flamand(fl, sb); wkSub := sb; nou := TRUE; WikiPasune(fl, 3, "ro")
    END;
    IF obSug # "" THEN nou := TRUE; s := "  de obicei urmează: "; Strings.Append(obSug, s); Strings.Append(" · da", s); Rand(cText, s) END;
    IF ~nou THEN Rand(cDim, "  nimic nou · totul e la locul lui") END;
    IF cerut THEN Rand(cDim, "  (rondul vine singur o dată pe oră, cât timp Cubicum 7 e deschis)") END;
    rFis := n; rAsh := a; rHr := S.Total(); rDe := Sunet.Ms()
  END Rond;

  PROCEDURE Imprumuta(t, cod: INTEGER): INTEGER;   (* 7·B v9: toate turele ocupate - un expert lasa tura lui aplicatiei *)
    VAR k, u, r: INTEGER; nm: ARRAY 32 OF CHAR; s: ARRAY 200 OF CHAR;
  BEGIN
    r := -1;
    IF ~pornesc THEN
      k := 6;
      WHILE (r < 0) & (k >= 0) DO
        FOR u := 0 TO Sal.NP - 1 DO
          IF r < 0 THEN Sal.Nume(u, nm); IF nm = qProg[k] THEN r := u END END
        END;
        IF r < 0 THEN DEC(k) END
      END;
      IF r >= 0 THEN
        Sal.Opreste(r); qImpr[k] := TRUE; IF qExp[k] = r THEN qExp[k] := -1 END; impDe := Sunet.Ms();
        s := ""; Strings.Append(qNume[k], s); Strings.Append(" lasă tura ", s); Strings.AppendInt(r + 1, 0, s);
        Strings.Append(" aplicației · răspunde mai departe din Ou", s); Rand(cDim, s)
      END
    END;
    RETURN r
  END Imprumuta;

  PROCEDURE Intoarce;   (* 7·B v9: expertii care si-au dat tura revin cand e una libera *)
    VAR k, u, lib: INTEGER; f: ARRAY 40 OF CHAR; s: ARRAY 120 OF CHAR;
  BEGIN
    impDe := Sunet.Ms();
    FOR k := 0 TO 6 DO
      IF qImpr[k] THEN
        lib := -1; FOR u := 0 TO Sal.NP - 1 DO IF Sal.Stare(u) = Sal.Liber THEN lib := u END END;
        IF lib >= 0 THEN
          pornesc := TRUE; Strings.Copy(qProg[k], f); Strings.Append(".z7l", f); qExp[k] := Sal.Porneste(f); pornesc := FALSE;
          IF qExp[k] >= 0 THEN qImpr[k] := FALSE; s := ""; Strings.Append(qNume[k], s); Strings.Append(" s-a întors pe spirală", s); Rand(cPurple, s) END
        END
      END
    END
  END Intoarce;

  PROCEDURE Tic*;   (* in fiecare cadru: e ora rondului? *)
    VAR k: INTEGER; any: BOOLEAN;
  BEGIN
    any := FALSE; FOR k := 0 TO 6 DO IF qImpr[k] THEN any := TRUE END END;
    IF any & (Sunet.Ms() - impDe >= 3000) THEN Intoarce END;
    IF vestea # "" THEN Rand(cPurple, vestea); vestea := "" END;   (* v11 *)
    WikiTic; IF totActiv & (wkStare = 0) THEN TotUrm END;   (* 7·B v4: pasune tot, solzul urmator *)
    IF Sunet.Ms() - rDe >= 3600000 THEN Rond(FALSE) END
  END Tic;

  PROCEDURE EuSunt;   (* v9: eula ce esti tu? - Oul raspunde despre el insusi, din ce are acum in cub *)
    VAR s: ARRAY 300 OF CHAR; i, cr, tot: INTEGER; t: ARRAY 200 OF CHAR;
  BEGIN
    cr := S.TotalArta(7);
    tot := 0; FOR i := 0 TO nob - 1 DO tot := tot + obC[i] END;
    Rand(cPurple, "◆ Oul: sunt Cubicum 7, un sistem de operare mic, într-un cub Z₇ din telefonul tău.");
    Rand(cText, "  Pe spirală stau cele șapte arte: ✎ Gramatica, ∴ Dialectica, ¶ Retorica, ∑ Aritmetica, △ Geometria, ♪ Muzica, ☾ Astronomia.");
    Rand(cText, "  Eu, Oul, stau în afara spiralei: îi ascult pe toți, aleg cui să cred și cristalizez răspunsul.");
    Rand(cText, "  Fiecare artă e un ou cu șapte subdomenii, iar hrana fiecăruia stă în solzul lui, pe disc: 49 de solzi (solzi = harta).");
    s := "  Acum știu "; Strings.AppendInt(S.Total(), 0, s); Strings.Append(" fraze (", s); Strings.AppendInt(cr, 0, s);
    Strings.Append(" cristale) și am păscut ", s); Strings.AppendInt(nwk, 0, s); Strings.Append(" articole pe Wikipedia.", s); Rand(cText, s);
    IF tot > 0 THEN
      TopComenzi(3, t); s := "  Ți-am văzut "; Strings.AppendInt(tot, 0, s); Strings.Append(" comenzi; cele mai dese: ", s); Strings.Append(t, s); Rand(cText, s)
    END;
    Rand(cDim, "  Nu sunt un om și nici o minte mare: sunt câteva mii de rânduri de Oberon care învață din ce le dai.")
  END EuSunt;

  PROCEDURE Fapta(q: ARRAY OF CHAR): BOOLEAN;   (* o porunca (porneste, opreste, arata, curata)? Oul o face *)
    VAR t, w, r, ro, w2: ARRAY 64 OF CHAR; cmd: ARRAY 80 OF CHAR; n, k: INTEGER; gata, expertul: BOOLEAN; s: ARRAY 200 OF CHAR;
  BEGIN
    Tx.Copy(q, t); Tx.MicS(t); Tx.FoldS(t); PrimulCuv(t, w, r);
    Tx.Copy(q, ro); PrimulCuv(ro, w2, ro);   (* restul, scris cum l-ai scris (pentru numele programelor) *)
    cmd := ""; gata := FALSE;
    Tx.Copy(q, qQ); qNk := Cheie(qQ, qKw);   (* v10: ca Oul sa stie si el cuvintele *)
    IF AreCuv(t, "tu") OR AreCuv(t, "esti") OR AreCuv(t, "cheama") OR AreCuv(t, "who") OR AreCuv(t, "cubicum") OR AreCuv(t, "oul")
      OR Tx.Contine(t, "prezinta") OR Tx.Contine(t, "despre tine") THEN gata := TRUE; EuSunt END;   (* v9, v10 *)
    IF gata THEN
    ELSIF (w = "porneste") OR (w = "deschide") OR (w = "lanseaza") OR (w = "ruleaza") OR (w = "joaca") THEN
      gata := TRUE;
      IF Tx.Contine(r, "joc") OR Tx.Contine(r, "roller") THEN cmd := "joc"
      ELSIF Tx.Contine(r, "343") OR Tx.Contine(r, "mesh") THEN cmd := "mesh"
      ELSIF Tx.Contine(r, "taro") THEN cmd := "taro"
      ELSIF r = "" THEN Rand(cRed, "◆ Oul: pornesc ce? de pildă: eula pornește jocul · eula pornește familie")
      ELSE
        PrimulCuv(ro, w2, s); IF (w2 = "programul") OR (w2 = "procesul") THEN PrimulCuv(s, w2, s) END;
        Strings.Copy(w2, s); Strings.Append(".z7l", s); n := CFS.Gaseste(s);
        IF n < 0 THEN Strings.Copy(w2, s); Strings.Append(".z7", s); n := CFS.Gaseste(s) END;
        IF n >= 0 THEN cmd := "run "; Strings.Append(w2, cmd)
        ELSE s := "◆ Oul: nu găsesc în cub programul "; Strings.Append(w2, s); Strings.Append(" (.z7l sau .z7)", s); Rand(cRed, s)
        END
      END
    ELSIF (w = "opreste") OR (w = "inchide") OR (w = "omoara") THEN
      gata := TRUE; n := TuraDin(r);
      IF n < 0 THEN Rand(cRed, "◆ Oul: opresc ce? de pildă: eula oprește tura 3 · eula oprește eule2")
      ELSE
        expertul := FALSE; FOR k := 0 TO 6 DO IF qExp[k] = n THEN expertul := TRUE END END;
        IF expertul THEN
          s := "◆ Oul: pe tura "; Strings.AppendInt(n + 1, 0, s);
          Strings.Append(" stă un expert; fără el n-aș mai auzi tot · dacă vrei totuși: kill ", s); Strings.AppendInt(n + 1, 0, s); Rand(cYel, s)
        ELSE cmd := "kill "; Strings.AppendInt(n + 1, 0, cmd)
        END
      END
    ELSIF (w = "arata") OR (w = "listeaza") OR (w = "afiseaza") THEN
      IF Tx.Contine(r, "fisier") THEN gata := TRUE; cmd := "ls"
      ELSIF Tx.Contine(r, "proces") OR Tx.Contine(r, "tur") OR Tx.Contine(r, "spiral") THEN gata := TRUE; cmd := "ps"
      ELSIF Tx.Contine(r, "obice") OR Tx.Contine(r, "comenz") THEN gata := TRUE; Obiceiuri
      ELSIF Tx.Contine(r, "hran") THEN gata := TRUE; HranaCate
      ELSIF Tx.Contine(r, "incred") THEN gata := TRUE; ArataIncr
      END
    ELSIF (w = "instaleaza") OR (w = "instalez") THEN gata := TRUE; V.Instaleaza(r)   (* v6 *)
    ELSIF (w = "paste") OR (w = "pasti") OR (w = "pasc") OR (w = "pasune") THEN   (* v7: eula paste teoria 10 *)
      gata := TRUE; s := "pasune "; Strings.Append(r, s); PasuneCmd(s)
    ELSIF Tx.Contine(t, "versiun") OR Tx.Contine(t, "rollback") OR Tx.Contine(t, "intorc") THEN gata := TRUE; V.Versiuni("")
    ELSIF (w = "curata") & ((r = "") OR Tx.Contine(r, "ecran")) THEN gata := TRUE; cmd := "clear"
    ELSIF w = "rond" THEN gata := TRUE; Rond(TRUE)
    ELSIF CubulQ() = 2 THEN gata := TRUE; Rand(cPurple, "◆ Oul:"); Scr(cText, cubTxt)   (* v10: spirala, fisierele, comenzile *)
    END;
    IF cmd # "" THEN Fa(cmd) END;
    RETURN gata
  END Fapta;

  PROCEDURE Vazut*(l: ARRAY OF CHAR);   (* fiecare comanda din Shell: Oul tine minte ce urmeaza dupa ce *)
    VAR t, r: ARRAY 64 OF CHAR; w: ARRAY 16 OF CHAR; i, j, b, bc, tot: INTEGER; s: ARRAY 200 OF CHAR;
  BEGIN
    Tx.Copy(l, t); Tx.MicS(t); PrimulCuv(t, w, r);
    IF (w # "") & (w # "da") & (w # ".") THEN
      i := 0; WHILE (i < nob) & (obN[i] # w) DO INC(i) END;
      IF (i = nob) & (nob < LEN(obC)) THEN Strings.Copy(w, obN[nob]); obC[nob] := 0; FOR j := 0 TO LEN(obC) - 1 DO obT[nob][j] := 0; obT[j][nob] := 0 END; INC(nob) END;
      IF i < nob THEN
        INC(obC[i]); IF obPrev >= 0 THEN INC(obT[obPrev][i]) END; obPrev := i; Tx.Copy(l, obL[i]); Tx.Trim(obL[i]);
        INC(obNoi); IF obNoi >= 5 THEN obNoi := 0; SalveazaObicei END;
        b := -1; bc := 0; tot := 0;   (* ce urmeaza de obicei dupa w? *)
        FOR j := 0 TO nob - 1 DO tot := tot + obT[i][j]; IF obT[i][j] > bc THEN bc := obT[i][j]; b := j END END;
        IF (bc >= 3) & (bc * 10 >= tot * 6) & (b # i) & (obN[b] # "bun") & (obN[b] # "gresit") THEN
          Strings.Copy(obL[b], obSug);
          s := "  ⚙ de obicei urmează: "; Strings.Append(obSug, s); Strings.Append(" (", s); Strings.AppendInt(bc, 0, s);
          Strings.Append(" din ", s); Strings.AppendInt(tot, 0, s); Strings.Append(") · da = îl fac eu", s); Rand(cDim, s)
        ELSE obSug := ""
        END
      END
    END
  END Vazut;

  PROCEDURE Da*;   (* da: Oul face ce urmeaza de obicei *)
    VAR c: ARRAY 64 OF CHAR;
  BEGIN
    IF obSug = "" THEN Rand(cDim, "◆ Oul nu are nimic de propus deocamdată")
    ELSE Strings.Copy(obSug, c); obSug := ""; Fa(c); Vazut(c)
    END
  END Da;


  PROCEDURE Ghid*;   (* v5: ghid = cum se foloseste *)
  BEGIN
    Rand(cPurple, "◆ ghidul lui Cubicum 7 · trage cu degetul în jos ca să vezi ce a fost mai sus");
    Rand(cText, "  eula întrebare · ce oră e · 343 în baza 7 · zodie leu · acordul de Re minor · ce e Salamandra");
    Rand(cText, "  eula poruncă · pornește jocul · oprește tura 3 · arată fișierele / procesele / obiceiurile · curăță");
    Rand(cText, "  bun / gresit · după un răspuns: bun îl face cristal, gresit scade încrederea · incredere = tabelul");
    Rand(cText, "  hraneste arta[.subdomeniu] · un fișier doar pentru ea · hrana = cât a mâncat fiecare · solzi = harta");
    Rand(cText, "  invata arta frază · artele: gramatica dialectica retorica aritmetica geometria muzica astronomia");
    Rand(cText, "  obiceiuri · da = face ce urmează de obicei · rond = Oul se uită prin cub (singur, o dată pe oră)");
    Rand(cText, "  versiuni = ce .Mod ai în Download, ce merge, cu ce te întorci · merge X / cade X · instaleaza X");
    Rand(cText, "  pasune muzica 10 = paște singură 10 articole · pasune geometria.santier 5 · pasune tot = toți solzii");
    Rand(cText, "  solzi = cele 7 arte × 7 subdomenii · solzi aritmetica = subdomeniile ei și cât știe fiecare");
    Rand(cText, "  copiaza = ultimul răspuns în clipboard · lipeste · salveaza tot · restaureaza · treaz da · ↑ = comanda de dinainte");
    Rand(cText, "  ce nu e comandă ajunge la Oul: poți scrie direct, fără eula · ce ești tu? · ce rulează pe spirală?")
  END Ghid;

  PROCEDURE EulaCmd*(a: ARRAY OF CHAR);   (* eula intrebarea ta *)
    VAR s: ARRAY 200 OF CHAR; k, c: INTEGER;
  BEGIN
    IF a = "" THEN Rand(cRed, "eula ce? de pildă: acordul de Re minor · aria cercului cu raza 3 · faza lunii · ce parte de vorbire e casa · adevărat și nu fals")
    ELSIF Fapta(a) THEN   (* v4: o porunca: Oul o face, nu ii mai intreaba pe experti *)
    ELSIF qOcupat & (Sunet.Ms() - qDe < 15000) THEN Rand(cDim, "experții încă se gândesc la întrebarea de dinainte")
    ELSIF PornesteEule() THEN
      Tx.Copy(a, qQ); qNk := Cheie(qQ, qKw); qFel := Fel(qQ); S.Intreaba(a);
      FOR k := 0 TO 6 DO qConf[k] := 0; qHr[k] := FALSE; qSub[k] := -1 END;
      qVenit := 0; qCastig := -1; qOcupat := TRUE; qDe := Sunet.Ms(); qNr := qNr MOD 8999 + 1;
      Tip(a);   (* 7·B v15 *)
      s := "? "; Strings.Append(a, s); Strings.Append(" · ", s);
      IF qTip = 1 THEN IF qCine THEN Strings.Append("cine: ", s) ELSE Strings.Append("definiție: ", s) END; Strings.Append(qX, s);
        IF qL # "" THEN Strings.Append(" (", s); Strings.Append(qL, s); Strings.Append(")", s) END
      ELSIF qTip > 1 THEN Strings.Append(qTipNume[qTip], s)
      ELSE Strings.Append(qFelNume[qFel], s)
      END;
      Rand(cGold, s);
      FOR k := 0 TO 6 DO IF qExp[k] >= 0 THEN Sal.Posta(qExp[k], qNr) END END;
      FOR k := 0 TO 6 DO IF qExp[k] < 0 THEN c := Expert(k, -1) END END   (* 7·B v14: cei fara tura raspund din Ou *)
    END
  END EulaCmd;

  PROCEDURE Ln(VAR c: ARRAY OF CHAR; s: ARRAY OF CHAR);
  BEGIN Strings.Append(s, c); Strings.AppendChar(0AX, c)
  END Ln;

  PROCEDURE Programe7;   (* programele Z7 ale celor sapte experti intra in cub (o data) *)
    VAR c: ARRAY 400 OF CHAR; f: ARRAY 40 OF CHAR; k: INTEGER;
  BEGIN
    FOR k := 0 TO 6 DO
      Strings.Copy(qProg[k], f); Strings.Append(".z7l", f);
      IF CFS.Gaseste(f) < 0 THEN
        c := "(* expertul "; Strings.AppendInt(k, 0, c); Strings.Append(": ", c); Strings.Append(qProg[k], c);
        Ln(c, " - Oul il intreaba, el raspunde cu ASCULTA *)");
        Strings.Append("WHILE 1 = 1 DO v := PRIMESTE c := ASCULTA(0 - ", c); Strings.AppendInt(1100 + k, 0, c); Ln(c, ") END");
        IF CFS.Scrie(f, c) < 0 THEN Rand(cRed, "nu pot scrie un program al experților") END
      END
    END
  END Programe7;

  PROCEDURE PeDisc*;   (* 7·B v5: tot ce tine Oul in memorie ajunge pe disc (inainte de copia de siguranta) *)
  BEGIN SalveazaHrana; SalveazaWiki; SalveazaObicei
  END PeDisc;

  PROCEDURE Lucreaza*(): BOOLEAN;   (* 7·B v5: e ceva de facut in spate (pasunea)? *)
  BEGIN RETURN totActiv OR (wkStare # 0)
  END Lucreaza;

  PROCEDURE Porneste*(ies: IesireP; cant: PROCEDURE; zod, tar, exe: TextP);   (* o cheama Cubicum 7 la pornire *)
    VAR k: INTEGER;
  BEGIN
    iesire := ies; canta := cant; zodie := zod; taro := tar; executa := exe;
    IncarcaObicei; rDe := Sunet.Ms(); rFis := CFS.N(); rAsh := CFS.NrAsh();
    IncarcaWiki; wkStare := 0; wkAuto := TRUE; totActiv := FALSE; totI := 0; totN := 0; totNr := 0; wkLimba := "ro"; wkCaut := "";
    wkSamanta[0] := "gramatică"; wkSamanta[1] := "logică"; wkSamanta[2] := "retorică"; wkSamanta[3] := "aritmetică";
    wkSamanta[4] := "geometrie"; wkSamanta[5] := "teoria muzicii"; wkSamanta[6] := "astronomie";
    qNume[0] := "✎ Gramatica"; qNume[1] := "∴ Dialectica"; qNume[2] := "¶ Retorica"; qNume[3] := "∑ Aritmetica";
    qNume[4] := "△ Geometria"; qNume[5] := "♪ Muzica"; qNume[6] := "☾ Astronomia";
    qSimb[0] := "✎"; qSimb[1] := "∴"; qSimb[2] := "¶"; qSimb[3] := "∑"; qSimb[4] := "△"; qSimb[5] := "♪"; qSimb[6] := "☾";
    qProg[0] := "gramatica"; qProg[1] := "dialectica"; qProg[2] := "retorica"; qProg[3] := "aritmetica";
    qProg[4] := "geometria"; qProg[5] := "muzica"; qProg[6] := "astronomia";
    qFelNume[0] := "muzică"; qFelNume[1] := "cifre"; qFelNume[2] := "cuvinte";
    qTipNume[0] := "altceva"; qTipNume[1] := "definiție"; qTipNume[2] := "cine"; qTipNume[3] := "când"; qTipNume[4] := "unde";
    qTipNume[5] := "cât"; qTipNume[6] := "cum"; qTipNume[7] := "de ce"; qTip := 0; qCine := FALSE; qX := ""; qXf := ""; defAst := FALSE; wkIntro := FALSE; wkPrima := "";
    FOR k := 0 TO 6 DO qExp[k] := -1; qConf[k] := 0; qHr[k] := FALSE; qSursa[k] := ""; qRaw[k] := ""; qSub[k] := -1; qImpr[k] := FALSE END;
    pornesc := FALSE; impDe := 0;
    qNr := 0; qDe := 0; qCastig := -1; qFel := 2; qVenit := 0; qAstept := 0; qNk := 0;
    qOcupat := FALSE; hrTinta := -1; qQ := ""; cubTxt := ""; hrSub := -1; hrTintaSub := -1; wkSub := -1; hrNoi := 0;
    Programe7; IncarcaIncr; IncarcaLeg;   (* 7·B v12 *)
    AG.Porneste; AD.Porneste; AR.Porneste; AA.Porneste; AGe.Porneste; AM.Porneste; AS.Porneste;   (* v11: cele 7 oua isi spun subdomeniile *)
    vestea := ""; S.Porneste; Migreaza; IF S.Total() = 0 THEN Seamana7 END;   (* v11: solzii *)
    Sal.PuneExpert(ExpertHook); Sal.PuneLoc(Imprumuta)
  END Porneste;


BEGIN
  hrTinta := -1; nob := 0; obPrev := -1; obNoi := 0; obSug := ""; rHr := 0
END Cub7Eule.

MODULE Cub7Programe;  (* Cubicum 7·B v8: programele si textele pe care Cubicum le scrie in cub la pornire (Programe13..27,
     comenzi.txt, aplicatiile Z7 bile / ceas / desen). Stau aici ca modulul principal sa nu treaca de marimea
     pe care o primeste compilatorul de pe telefon. *)
  IMPORT Strings, CFS := CubicumFS;

  CONST LC = CFS.LC;

  PROCEDURE L(VAR c: ARRAY OF CHAR; s: ARRAY OF CHAR);   (* un rand de program; ` inseamna ghilimele *)
    VAR i: INTEGER;
  BEGIN
    i := 0;
    WHILE (i < LEN(s)) & (s[i] # 0X) DO IF s[i] = "`" THEN Strings.AppendChar(22X, c) ELSE Strings.AppendChar(s[i], c) END; INC(i) END;
    Strings.AppendChar(0AX, c)
  END L;

  PROCEDURE Programe*;   (* programele Z7 intra in cub (o data) *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "# spirala: merge pe tura ei a spiralei"); L(c, "# si scrie 1..6 in tor, cate o celula");
    L(c, "BAZA R0"); L(c, "SET R2, 2401"); L(c, "ADD R0, R2"); L(c, "SET R4, 7"); L(c, "SET R5, 250");
    L(c, "bucla: INC R1"); L(c, "MOD R1, R4"); L(c, "ST R1, R0"); L(c, "INC R0"); L(c, "NOTA R1, R3"); L(c, "DORMI R5");
    L(c, "JMP bucla"); k := CFS.Scrie("spirala.z7", c);
    c := ""; L(c, "# ecou: tahionul. Doarme pana se schimba"); L(c, "# ceva oriunde in tor, apoi canta campul");
    L(c, "# (suma intregului tor MOD 7)"); L(c, "SET R1, 2");
    L(c, "bucla: ASTEAPTA"); L(c, "CAMP R0"); L(c, "NOTA R0, R1"); L(c, "JMP bucla"); k := CFS.Scrie("ecou.z7", c);
    c := ""; L(c, "# numara pana la 49 = 7 x 7, apoi se opreste"); L(c, "SET R1, 49"); L(c, "SET R2, 100");
    L(c, "bucla: INC R0"); L(c, "SCRIE R0"); L(c, "MOV R3, R0"); L(c, "EQ R3, R1"); L(c, "JNZ R3, gata"); L(c, "DORMI R2");
    L(c, "JMP bucla"); L(c, "gata: STOP"); k := CFS.Scrie("numara.z7", c);
    c := ""; L(c, "# inel: trimite un numar vecinului din inel"); L(c, "# si canta ce primeste. Porneste-l de 2-3 ori");
    L(c, "# si vezi mesajele in Network."); L(c, "SET R1, 1"); L(c, "SET R0, 1"); L(c, "SET R2, 400");
    L(c, "bucla: VECIN R3"); L(c, "TRIMITE R1, R3"); L(c, "PRIMESTE R4, R5"); L(c, "NOTA R4, R0"); L(c, "MOV R1, R4");
    L(c, "INC R1"); L(c, "DORMI R2"); L(c, "JMP bucla"); k := CFS.Scrie("inel.z7", c);
    k := CFS.Scrie("sistem.txt", "Cubicum OS v1.1 · nucleul Salamandra · procesorul și memoria: torul Z₇ în 7 dimensiuni (7⁷ = 823543 celule) · programele .z7 stau aici, în cub")
  END Programe;

  PROCEDURE Programe13*;   (* v1.3: programe scrise in limbajul Z7 (.z7l), printre ele shell-ul de pe spirala *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "(* sh: shell-ul scris în limbajul Z7, pe o tură a spiralei.");
    L(c, "   Rândurile scrise în Shell vin la el literă cu literă. *)");
    L(c, "VAR b[64]"); L(c, "SCRIET(`∿ sh pe spirală · scrie help`)"); L(c, "REPEAT");
    L(c, "  n := 0; c := PRIMESTE");
    L(c, "  WHILE c # 10 DO IF n < 63 THEN b[n] := c; n := n + 1 END; c := PRIMESTE END;");
    L(c, "  b[n] := 0; gata := 0;");
    L(c, "  IF (b[0] = 'h') & (b[1] = 'e') THEN SCRIET(`ps · run X · kill N · echo T · camp · exit`)");
    L(c, "  ELSIF (b[0] = 'p') & (b[1] = 's') THEN");
    L(c, "    t := 0;"); L(c, "    WHILE t < 7 DO");
    L(c, "      s := STARE(t);");
    L(c, "      IF s # 0 THEN SCRIEN(t); SCRIEC(' '); SCRIEN(PID(t)); SCRIEC(' ');");
    L(c, "        IF s = 1 THEN SCRIET(`rulează`) ELSIF s = 2 THEN SCRIET(`simte câmpul`)");
    L(c, "        ELSIF s = 3 THEN SCRIET(`primește`) ELSE SCRIET(`doarme`) END");
    L(c, "      END;"); L(c, "      t := t + 1"); L(c, "    END");
    L(c, "  ELSIF (b[0] = 'r') & (b[1] = 'u') & (b[2] = 'n') & (b[3] = ' ') THEN");
    L(c, "    t := PORNESTE(b[4]); IF t < 0 THEN SCRIET(`n-a pornit`) END");
    L(c, "  ELSIF (b[0] = 'k') & (b[1] = 'i') THEN OPRESTE(b[5] - '0')");
    L(c, "  ELSIF (b[0] = 'e') & (b[1] = 'c') THEN");
    L(c, "    i := 5; WHILE b[i] # 0 DO SCRIEC(b[i]); i := i + 1 END; SCRIEC(10)");
    L(c, "  ELSIF (b[0] = 'c') & (b[1] = 'a') THEN SCRIEC('T'); SCRIEC('='); SCRIEN(CAMP); SCRIEC(10)");
    L(c, "  ELSIF (b[0] = 'e') & (b[1] = 'x') THEN SCRIET(`sh: la revedere`); gata := 1");
    L(c, "  ELSIF n > 0 THEN SCRIET(`sh: nu știu comanda`)");
    L(c, "  END"); L(c, "UNTIL gata = 1");
    k := CFS.Scrie("sh.z7l", c);
    c := ""; L(c, "(* fact: factorialele 1..10, în limbajul Z7 *)");
    L(c, "f := 1; i := 1"); L(c, "WHILE i <= 10 DO f := f * i; SCRIE(f); i := i + 1 END");
    k := CFS.Scrie("fact.z7l", c);
    c := ""; L(c, "(* prime: primele 15 numere prime *)");
    L(c, "n := 2; gasite := 0");
    L(c, "WHILE gasite < 15 DO");
    L(c, "  d := 2; prim := 1");
    L(c, "  WHILE (d * d <= n) & (prim = 1) DO IF n MOD d = 0 THEN prim := 0 END; d := d + 1 END;");
    L(c, "  IF prim = 1 THEN SCRIE(n); gasite := gasite + 1 END;");
    L(c, "  n := n + 1"); L(c, "END");
    k := CFS.Scrie("prime.z7l", c);
    c := ""; L(c, "(* tahion: un program Z7 care pornește ecou și spirala,");
    L(c, "   apoi le oprește după 7 secunde *)");
    L(c, "e := PORNESTE(`ecou.z7`); s := PORNESTE(`spirala.z7`)");
    L(c, "SCRIET(`tahion: ecou ascultă tot torul`)"); L(c, "DORMI(7000)");
    L(c, "OPRESTE(e); OPRESTE(s)"); L(c, "SCRIET(`tahion: gata`)");
    k := CFS.Scrie("tahion.z7l", c);
    c := ""; L(c, "LIMBAJUL Z7 (.z7l) · cat limbaj-z7.txt");
    L(c, "x := 3 * (y + 1)   a[i] := x   VAR a[7], b");
    L(c, "IF c THEN .. ELSIF c THEN .. ELSE .. END");
    L(c, "WHILE c DO .. END   REPEAT .. UNTIL c");
    L(c, "+ - * DIV MOD  = # < <= > >=  & OR ~  'a'  (* notă *)");
    L(c, "SCRIE(x) rând nou cu numărul · SCRIEC(cod) o literă · SCRIEN(x) numărul în rând · SCRIET(`text`)");
    L(c, "NOTA(n, octava) DORMI(ms) ASTEAPTA TRIMITE(v, tura) PUNE(adresa, cifra)");
    L(c, "STOP OPRESTE(tura) CEDEAZA PORNESTE(`prog`)");
    L(c, "funcții: CAMP CITESTE(adr) PRIMESTE DELA VECIN BAZA TURA STARE(t) PID(t) TIMP PORNESTE(`prog`)");
    L(c, "Variabilele stau în tor, pe tura ta: câte un cuvânt de 12 celule.");
    L(c, "Scrii cu: edit nume.z7l, apoi rândurile, apoi un rând cu . · pornești cu: run nume");
    k := CFS.Scrie("limbaj-z7.txt", c);
    k := CFS.Scrie("sistem.txt", "Cubicum OS v1.3 · nucleul Salamandra · procesorul și memoria: torul Z₇ în 7 dimensiuni (7⁷ = 823543 celule) · programe .z7 (asamblare) și .z7l (limbajul Z7), shell-ul sh.z7l pe spirală, aplicații .app · sesiunea se păstrează până la Burn")
  END Programe13;

  PROCEDURE Programe14*;   (* v1.4: Opal, notele celulelor, Nephilim in celula *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "(* trandafir: cântă felia d0 × d1 de pe tura ta. Nota vine din locul celulei");
    L(c, "   (pași de la colțul Do) și din cifra ei. Acul 7 al lui Opal scrie în felie ce citește.");
    L(c, "   La fiecare oră a lui Opal (1155 de bătăi) torul alunecă un pas și cântecul se mută. *)");
    L(c, "b := BAZA + 50421; k := 0");
    L(c, "WHILE 0 = 0 DO");
    L(c, "  CANTA(b + k);");
    L(c, "  IF OPAL(7) >= 0 THEN PUNE(b + k, OPAL(7)) END;");
    L(c, "  k := (k + 1) MOD 49;");
    L(c, "  IF k = 0 THEN SCRIET(`trandafir: o tură a feliei`); SCRIEC('w'); SCRIEC('='); SCRIEN(CEAS(0)); SCRIEC(10) END");
    L(c, "END");
    k := CFS.Scrie("trandafir.z7l", c);
    c := ""; L(c, "(* nefilim: aprinde și stinge celule cu stările lui Nephilim, prin XOR.");
    L(c, "   0 Inactiv · 1 Corpuscul · 2 Undă · 3 Corpuscul-Undă. Cine scrie într-o celulă Inactiv o aprinde. *)");
    L(c, "a := BAZA + 50421");
    L(c, "SCRIE(NEF(a)); PUNENEF(2, a); SCRIE(NEF(a)); PUNENEF(3, a); SCRIE(NEF(a))");
    L(c, "PUNE(a, 5); SCRIE(CITESTE(a)); PUNENEF(1, a); PUNE(a, 5); SCRIE(CITESTE(a))");
    L(c, "SCRIE(NOTAC(a))");
    k := CFS.Scrie("nefilim.z7l", c);
    c := ""; L(c, "LIMBAJUL Z7 (.z7l) · cat limbaj-z7.txt");
    L(c, "x := 3 * (y + 1)   a[i] := x   VAR a[7], b");
    L(c, "IF c THEN .. ELSIF c THEN .. ELSE .. END");
    L(c, "WHILE c DO .. END   REPEAT .. UNTIL c");
    L(c, "+ - * DIV MOD  = # < <= > >=  & OR ~  'a'  (* notă *)");
    L(c, "SCRIE(x) rând nou cu numărul · SCRIEC(cod) o literă · SCRIEN(x) numărul în rând · SCRIET(`text`)");
    L(c, "NOTA(n, octava) DORMI(ms) ASTEAPTA TRIMITE(v, tura) PUNE(adresa, cifra)");
    L(c, "STOP OPRESTE(tura) CEDEAZA PORNESTE(`prog`)");
    L(c, "funcții: CAMP CITESTE(adr) PRIMESTE DELA VECIN BAZA TURA STARE(t) PID(t) TIMP PORNESTE(`prog`)");
    L(c, "v1.4 Opal: OPAL(p) = ce a citit acul p (1 3 5 7 11) · CEAS(0) ciclul, CEAS(1) bătaia în oră, CEAS(2) bătăi");
    L(c, "v1.4 note: NOTAC(adr) = treapta celulei · CANTA(adr) o cântă · NEF(adr) starea · PUNENEF(s, adr) XOR");
    L(c, "Variabilele stau în tor, pe tura ta: câte un cuvânt de 12 celule.");
    L(c, "Scrii cu: edit nume.z7l, apoi rândurile, apoi un rând cu . · pornești cu: run nume");
    k := CFS.Scrie("limbaj-z7.txt", c);
    c := "Cubicum OS v1.4 · nucleul Salamandra · torul Z₇ în 7 dimensiuni (7⁷ celule) · Opal: acele 1 3 5 7 11, ora = 1155 bătăi, torul alunecă un pas pe oră";
    Strings.Append(" · fiecare celulă: cifra, starea Nephilim, nota din colțul Do · sesiunea se păstrează până la Burn", c);
    k := CFS.Scrie("sistem.txt", c)
  END Programe14;

  PROCEDURE Programe15*;   (* v1.5: Roler *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "(* roler: Roler stă în colțul 127 și trimite o undă prin tor, treaptă cu treaptă.");
    L(c, "   Pentru fiecare treaptă t: celulele care rezonează se sting (EMITE dă câte au fost),");
    L(c, "   cântă nota, apoi le aprinde la loc. La urmă ascultă colțul: o singură celulă. *)");
    L(c, "COLT(127); t := 0");
    L(c, "WHILE t <= 6 DO");
    L(c, "  n := EMITE(t, 1); SCRIE(n); NOTA(t, 1);");
    L(c, "  m := EMITE(t, 1); t := t + 1");
    L(c, "END;");
    L(c, "SCRIE(ASCULTA(0)); COLT(0)");
    k := CFS.Scrie("roler.z7l", c);
    c := ""; L(c, "LIMBAJUL Z7 (.z7l) · cat limbaj-z7.txt");
    L(c, "x := 3 * (y + 1)   a[i] := x   VAR a[7], b");
    L(c, "IF c THEN .. ELSIF c THEN .. ELSE .. END   WHILE c DO .. END   REPEAT .. UNTIL c");
    L(c, "+ - * DIV MOD  = # < <= > >=  & OR ~  'a'  (* notă *)");
    L(c, "SCRIE(x) · SCRIEC(cod) · SCRIEN(x) · SCRIET(`text`) · NOTA(n, octava) DORMI(ms) ASTEAPTA");
    L(c, "TRIMITE(v, tura) PUNE(adresa, cifra) STOP OPRESTE(tura) CEDEAZA PORNESTE(`prog`)");
    L(c, "funcții: CAMP CITESTE(adr) PRIMESTE DELA VECIN BAZA TURA STARE(t) PID(t) TIMP PORNESTE(`prog`)");
    L(c, "Opal: OPAL(p) ce a citit acul p (1 3 5 7 11) · CEAS(0) ciclul, CEAS(1) bătaia, CEAS(2) bătăi");
    L(c, "note: NOTAC(adr) treapta celulei · CANTA(adr) · NEF(adr) starea · PUNENEF(s, adr) XOR");
    L(c, "Roler: COLT(c) colțul 0..127 · EMITE(t, s) celulele cu treapta t primesc starea XOR s (și dă câte)");
    L(c, "       ASCULTA(t) câte celule active rezonează cu treapta t");
    L(c, "Variabilele stau în tor, pe tura ta: câte un cuvânt de 12 celule.");
    L(c, "Scrii cu: edit nume.z7l, apoi rândurile, apoi un rând cu . · pornești cu: run nume");
    k := CFS.Scrie("limbaj-z7.txt", c);
    c := "Cubicum OS v1.5 · nucleul Salamandra · torul Z₇ în 7 dimensiuni (7⁷ celule) · Opal: acele 1 3 5 7 11, torul alunecă un pas pe oră";
    Strings.Append(" · Roler în colțul Do: emite o treaptă, celulele care rezonează își schimbă starea · sesiunea rămâne până la Burn", c);
    k := CFS.Scrie("sistem.txt", c)
  END Programe15;

  PROCEDURE Programe16*;   (* v1.6: Eula ♪ in Cubicum *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "ro.jahbalon.oberon.eulamusic|Eula ♪|Eula Music|Eula 7♪|♪");
    Strings.Append("Eula ♪ (Eula Music scrisă în Oberon): teoria muzicii care răspunde și cântă, compune pe torul spiral, ", c);
    Strings.Append("sonifică codul. Se face în Eula Oberon cu apk EulaMusic.Mod, eticheta Eula ♪. Dacă nu e, pornesc Eula Music cea în Java. ", c);
    Strings.Append("Motorul ei e și în Cubicum: în Shell, muzica, compune, sonifica, stop.", c);
    k := CFS.Scrie("eula-music.app", c);
    c := "Cubicum OS v1.6 · nucleul Salamandra · torul Z₇ în 7 dimensiuni (7⁷ celule) · Opal: acele 1 3 5 7 11, torul alunecă un pas pe oră";
    Strings.Append(" · Roler în colțul Do · Eula ♪ în Shell: muzica <întrebare>, compune, sonifica <program> sau tura N, stop · sesiunea rămâne până la Burn", c);
    k := CFS.Scrie("sistem.txt", c)
  END Programe16;

  PROCEDURE Programe17*;   (* v1.7: fisierele telefonului *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := "Cubicum OS v1.7 · nucleul Salamandra · torul Z₇ în 7 dimensiuni (7⁷ celule) · Opal · Roler · Eula ♪ în Shell";
    Strings.Append(" · fișierele telefonului intră în cub: adu (alegi), download (lista), adu N · un fișier mare stă pe mai multe celule,", c);
    Strings.Append(" câte 1600 de octeți pe celulă, de la celula lui mai departe pe tor · sesiunea rămâne până la Burn", c);
    k := CFS.Scrie("sistem.txt", c)
  END Programe17;

  PROCEDURE Programe18*;   (* v1.8: Cubicum FS pe torul 7^7, harta telefonului *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := "Cubicum OS v1.8 · nucleul Salamandra · torul Z₇ în 7 dimensiuni (7⁷ celule) · Opal · Roler · Eula ♪ în Shell";
    Strings.Append(" · Cubicum FS pe 7⁷: adresa = nume · tip · zi · dosar · mărime · lună · oră (MOD 7)", c);
    Strings.Append(" · harta: tot telefonul, fiecare fișier pe celula lui, conținutul rămâne pe telefon · caut, vezi, celula", c);
    Strings.Append(" · adu copiază în cub · sesiunea rămâne până la Burn", c);
    k := CFS.Scrie("sistem.txt", c)
  END Programe18;

  PROCEDURE Programe19*;   (* v1.9: ceasul nu arde, AMINTESTE *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "(* amintire: memoria raspunde la nota. Pun cifra 3 departe in tura mea, apoi cer treapta ei:");
    L(c, "   AMINTESTE da prima celula activa care suna la fel (poate fi si alta, cu aceeasi treapta). *)");
    L(c, "a := BAZA + 117000; PUNE(a, 3);");
    L(c, "t := NOTAC(a); SCRIE(t); NOTA(t, 1);");
    L(c, "b := AMINTESTE(t); SCRIE(b); SCRIE(CITESTE(b)); NOTA(NOTAC(b), 1);");
    L(c, "SCRIE(CEAS(3)); SCRIE(CEAS(0))");
    k := CFS.Scrie("amintire.z7l", c);
    c := ""; L(c, "LIMBAJUL Z7 (.z7l) · cat limbaj-z7.txt");
    L(c, "x := 3 * (y + 1)   a[i] := x   VAR a[7], b");
    L(c, "IF c THEN .. ELSIF c THEN .. ELSE .. END   WHILE c DO .. END   REPEAT .. UNTIL c");
    L(c, "+ - * DIV MOD  = # < <= > >=  & OR ~  'a'  (* notă *)");
    L(c, "SCRIE(x) · SCRIEC(cod) · SCRIEN(x) · SCRIET(`text`) · NOTA(n, octava) DORMI(ms) ASTEAPTA");
    L(c, "TRIMITE(v, tura) PUNE(adresa, cifra) STOP OPRESTE(tura) CEDEAZA PORNESTE(`prog`)");
    L(c, "funcții: CAMP CITESTE(adr) PRIMESTE DELA VECIN BAZA TURA STARE(t) PID(t) TIMP PORNESTE(`prog`)");
    L(c, "Opal: OPAL(p) ce a citit acul p (1 3 5 7 11) · CEAS(0) ciclul, CEAS(1) bătaia, CEAS(2) bătăi,");
    L(c, "      CEAS(3) câte Burn-uri, CEAS(4) prima pornire (secunde de la 2010) · ceasul nu arde");
    L(c, "note: NOTAC(adr) treapta celulei · CANTA(adr) · NEF(adr) starea · PUNENEF(s, adr) XOR");
    L(c, "Roler: COLT(c) colțul 0..127 · EMITE(t, s) celulele cu treapta t primesc starea XOR s (și dă câte)");
    L(c, "       ASCULTA(t) câte celule active rezonează cu treapta t");
    L(c, "       AMINTESTE(t) adresa primei celule active care rezonează (-1 = niciuna): memoria răspunde la notă");
    L(c, "Variabilele stau în tor, pe tura ta: câte un cuvânt de 12 celule.");
    L(c, "Scrii cu: edit nume.z7l, apoi rândurile, apoi un rând cu . · pornești cu: run nume");
    k := CFS.Scrie("limbaj-z7.txt", c);
    c := "Cubicum OS v1.9 · nucleul Salamandra · torul Z₇ în 7 dimensiuni (7⁷ celule) · Opal · Roler · Eula ♪ în Shell";
    Strings.Append(" · Cubicum FS pe 7⁷ (nume · tip · zi · dosar · mărime · lună · oră), harta telefonului", c);
    Strings.Append(" · Burn arde celulele, nu ceasul: torul ține minte prima pornire · AMINTESTE: memoria răspunde la notă", c);
    k := CFS.Scrie("sistem.txt", c)
  END Programe19;

  PROCEDURE Comenzi*;   (* v1.9b / v2.1: lista comenzilor, in cub (cat comenzi.txt) *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "COMENZILE SHELL-ULUI · cat comenzi.txt");
    L(c, "butoane: help ver who ls ps ash cube z7 cfs clear");
    L(c, "ceas · Opal: ciclul, acele, prima pornire, Burn-uri");
    L(c, "burn · arde celulele și procesele (ceasul rămâne)");
    L(c, "PROGRAME");
    L(c, "run nume · pornește (run amintire, run roler, run sh)");
    L(c, "kill N · oprește tura N · ps · ce rulează");
    L(c, "edit nume.z7l · scrii, termini cu un rând .");
    L(c, "cat nume · arată · rm nume · arde fișierul");
    L(c, "app nume · deschide o aplicație (app eula-music)");
    L(c, "ROLER");
    L(c, "do N · colțul Do (0..127) · roler T · ascultă treapta T");
    L(c, "emite T S · celulele cu treapta T primesc starea XOR S");
    L(c, "MUZICA (Eula ♪)");
    L(c, "muzica acordul de La minor · gama Re major");
    L(c, "compune · compune în Re minor din pion");
    L(c, "sonifica sh · sonifica tura 1 · stop");
    L(c, "TELEFONUL");
    L(c, "harta · tot telefonul pe torul 7⁷");
    L(c, "caut img · lista · apoi vezi 3 · adu 3");
    L(c, "celula 3.6.2.0.4.1.5 · ce stă acolo");
    L(c, "download · lista din Download · download text");
    L(c, "adu · alegi fișiere de pe telefon (sau ⇩ ADU în CFS)");
    L(c, "PROLOG (în programe și în Shell)");
    L(c, "run familie · apoi ?- bunic(ion, N). · ?- tata(ion, X).");
    L(c, "cat familie.z7l · run liste · run bunici (răspunsuri în variabile)");
    L(c, "STYX (cubul ca fișiere) · styx asculta = serverul");
    L(c, "styx ls / · styx cat /opal · styx cat /harta · styx ls /cub");
    L(c, "styx scrie /prolog bunic(ion, N) · styx cat /prolog");
    L(c, "ÎNTRE CUBURI (v2.6): styx asculta retea · pe celălalt: styx leaga IP · styx dezleaga");
    L(c, "ÎN PROGRAME (limbajul Z7, nu în Shell)");
    L(c, "CEAS(0..4) OPAL(p) ASCULTA(t) AMINTESTE(t) EMITE(t, s)");
    L(c, "NOTAC(a) CANTA(a) CITESTE(a) PUNE(a, c) · cat limbaj-z7.txt");
    L(c, "PROCESORUL (v2.5) · cat procesor.txt · run invata · run dublu · run pasi");
    k := CFS.Scrie("comenzi.txt", c)
  END Comenzi;

  PROCEDURE Programe20*;   (* v2.0: Prolog in limbajul Z7 *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "(* familie: clauze Prolog intr-un program Z7. Raman in tor dupa ce programul s-a oprit:");
    L(c, "   din Shell intrebi  ?- bunic(ion, N).   sau   ?- parinte(maria, X). *)");
    L(c, "tata(ion, maria). tata(ion, andrei). tata(andrei, elena).");
    L(c, "mama(maria, ana). mama(maria, dan).");
    L(c, "parinte(X, Y) :- tata(X, Y).");
    L(c, "parinte(X, Y) :- mama(X, Y).");
    L(c, "bunic(X, Z) :- parinte(X, Y), parinte(Y, Z).");
    L(c, "frati(X, Y) :- parinte(P, X), parinte(P, Y), X \= Y.");
    L(c, "?- bunic(ion, N).");
    L(c, "SCRIET(`familia e in tor: intreaba din Shell cu ?-`)");
    k := CFS.Scrie("familie.z7l", c);
    c := ""; L(c, "(* liste si numere in Prolog *)");
    L(c, "append([], L, L).");
    L(c, "append([H|T], L, [H|R]) :- append(T, L, R).");
    L(c, "member(X, [X|_]).");
    L(c, "member(X, [_|T]) :- member(X, T).");
    L(c, "rev([], []).");
    L(c, "rev([H|T], R) :- rev(T, RT), append(RT, [H], R).");
    L(c, "fact(0, 1).");
    L(c, "fact(N, F) :- N > 0, M is N - 1, fact(M, G), F is N * G.");
    L(c, "max(X, Y, X) :- X >= Y, !.");
    L(c, "max(_, Y, Y).");
    L(c, "?- append(X, Y, [1, 2]).");
    L(c, "?- rev([1, 2, 3], R).");
    L(c, "?- fact(10, F).");
    L(c, "?- max(3, 5, M).");
    k := CFS.Scrie("liste.z7l", c);
    c := ""; L(c, "LIMBAJUL Z7 (.z7l) · cat limbaj-z7.txt");
    L(c, "x := 3 * (y + 1)   a[i] := x   VAR a[7], b");
    L(c, "IF c THEN .. ELSIF c THEN .. ELSE .. END   WHILE c DO .. END   REPEAT .. UNTIL c");
    L(c, "+ - * DIV MOD  = # < <= > >=  & OR ~  'a'  (* notă *)");
    L(c, "SCRIE(x) · SCRIEC(cod) · SCRIEN(x) · SCRIET(`text`) · NOTA(n, octava) DORMI(ms) ASTEAPTA");
    L(c, "TRIMITE(v, tura) PUNE(adresa, cifra) STOP OPRESTE(tura) CEDEAZA PORNESTE(`prog`)");
    L(c, "funcții: CAMP CITESTE(adr) PRIMESTE DELA VECIN BAZA TURA STARE(t) PID(t) TIMP PORNESTE(`prog`)");
    L(c, "Opal: OPAL(p) · CEAS(0) ciclul, (1) bătaia, (2) bătăi, (3) Burn-uri, (4) prima pornire");
    L(c, "note: NOTAC(adr) treapta · CANTA(adr) · NEF(adr) starea · PUNENEF(s, adr) XOR");
    L(c, "Roler: COLT(c) · EMITE(t, s) · ASCULTA(t) câte rezonează · AMINTESTE(t) prima care rezonează");
    L(c, "PROLOG: clauze printre instrucțiuni:  tata(ion, maria).   bunic(X, Z) :- parinte(X, Y), parinte(Y, Z).");
    L(c, "  întrebări:  ?- bunic(ion, N).   (programul scrie: N = ana …; da / nu)");
    L(c, "  știe: liste [a, b | T], ! \+ = \= is (+ - * // mod) < > =< >= =:= =\= true fail");
    L(c, "  clauzele rămân în tor, pe tura programului: din Shell întrebi cu ?- (până la Burn)");
    L(c, "  ?- bunic(ion, N) DO SCRIEA(N) END · N e variabila Z7: o dată pentru fiecare răspuns");
    L(c, "  cele care au deja valoare intră în întrebare (K := 6; ?- fact(K, F) DO ..) · ATOM(`ana`)");
    L(c, "Variabilele stau în tor, pe tura ta: câte un cuvânt de 12 celule.");
    L(c, "Scrii cu: edit nume.z7l, apoi rândurile, apoi un rând cu . · pornești cu: run nume");
    k := CFS.Scrie("limbaj-z7.txt", c);
    Comenzi;
    c := "Cubicum OS v2.0 · nucleul Salamandra · torul Z₇ în 7 dimensiuni (7⁷ celule) · Opal (ceasul nu arde) · Roler · AMINTESTE";
    Strings.Append(" · Prolog în limbajul Z7: clauze și ?- în programe și în Shell · Eula ♪ · Cubicum FS pe 7⁷ cu harta telefonului", c);
    k := CFS.Scrie("sistem.txt", c)
  END Programe20;

  PROCEDURE Programe21*;   (* v2.1: variabilele Prolog in programul Z7 *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "(* bunici: raspunsurile Prolog intra in variabilele programului Z7 *)");
    L(c, "tata(ion, maria). tata(ion, andrei). tata(andrei, elena).");
    L(c, "mama(maria, ana). mama(maria, dan).");
    L(c, "parinte(X, Y) :- tata(X, Y).");
    L(c, "parinte(X, Y) :- mama(X, Y).");
    L(c, "bunic(X, Z) :- parinte(X, Y), parinte(Y, Z).");
    L(c, "n := 0;");
    L(c, "?- bunic(ion, N) DO");
    L(c, "  SCRIEA(N); NOTA(n, 1); n := n + 1");
    L(c, "END;");
    L(c, "SCRIET(`nepotii lui ion:`); SCRIE(n);");
    L(c, "P := ATOM(`maria`);");
    L(c, "?- mama(P, C) DO SCRIEA(C) END");
    k := CFS.Scrie("bunici.z7l", c);
    Programe20;   (* limbaj-z7.txt si comenzi.txt, la zi *)
    c := "Cubicum OS v2.1 · nucleul Salamandra · torul Z₇ în 7 dimensiuni (7⁷ celule) · Opal (ceasul nu arde) · Roler · AMINTESTE";
    Strings.Append(" · Prolog în limbajul Z7: clauze, ?- și ?- … DO … END cu variabilele programului · Eula ♪ · Cubicum FS pe 7⁷", c);
    k := CFS.Scrie("sistem.txt", c)
  END Programe21;

