  PROCEDURE Tic;
    VAR i, k, n, f, t: INTEGER; s: ARRAY 32 OF CHAR; m: ARRAY 80 OF CHAR;
  BEGIN
    Sal.Ruleaza(1500);
    FOR i := 0 TO Sal.NrIesiri() - 1 DO Sal.Iesire(i, m); Rand(cGreen, m) END;
    Sal.Goleste;
    IF Tor7.Scrieri() # scrVazute THEN scrVazute := Tor7.Scrieri(); undaDe := acum END;
    IF Sal.Trimise() - vazTrimise > Sal.NK THEN vazTrimise := Sal.Trimise() - Sal.NK END;
    WHILE vazTrimise < Sal.Trimise() DO
      Sal.Pachet(vazTrimise, f, t);
      IF (cur = 1) & (npk < NP) THEN
        pkF[npk] := f; pkT[npk] := t; pkU[npk] := 0.0;
        IF Sal.Stare(t) # Sal.Liber THEN pkC[npk] := cGreen ELSE pkC[npk] := cRed END;
        INC(npk)
      END;
      INC(vazTrimise)
    END;
    IF (instEu >= 0) & (acum - instDe >= 1200) THEN
      NumePkg(instEu, s); k := CFS.Scrie(s, adesc[instEu]); Sunet.Nota(370, 200, 40); instEu := -1
    END;
    IF arp & (acum - ultimArp >= 180) THEN
      ultimArp := acum; n := Aprinse();
      IF n = 0 THEN arp := FALSE
      ELSE
        arpI := arpI MOD n; k := -1; i := -1;
        REPEAT INC(i); IF on[i] THEN INC(k) END UNTIL k = arpI;
        Sunet.Nota(Hz(i), 250, 35); INC(arpI)
      END
    END
  END Tic;

