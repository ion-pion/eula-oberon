    Ecran.Culoare(Ecran.RGB(0, 0, 0)); TC(wx + ww - D(48), cy + D(4), D(11), "─");
    Ecran.Culoare(Ecran.RGB(255, 255, 255)); TC(wx + ww - D(20), cy + D(4), D(11), "✕");
