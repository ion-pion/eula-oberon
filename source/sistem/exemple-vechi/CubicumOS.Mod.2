  PROCEDURE Programe;   (* programele Z7 intra in cub (o data) *)
    VAR c: ARRAY LC OF CHAR; k: INTEGER;
  BEGIN
    c := ""; L(c, "# spirala: merge pe tura ei a spiralei"); L(c, "# si scrie 1..6 in tor, cate o celula");
    L(c, "BAZA R0"); L(c, "SET R2, 2401"); L(c, "ADD R0, R2"); L(c, "SET R4, 7"); L(c, "SET R5, 250");
    L(c, "bucla: INC R1"); L(c, "MOD R1, R4"); L(c, "ST R1, R0"); L(c, "INC R0"); L(c, "NOTA R1, R3"); L(c, "DORMI R5");
    L(c, "JMP bucla"); k := CFS.Scrie("spirala.z7", c);
    c := ""; L(c, "# ecou: tahionul. Doarme pana se schimba"); L(c, "# ceva oriunde in tor, apoi canta campul");
    L(c, "# (suma intregului tor MOD 7)"); L(c, "SET R1, 2");
    L(c, "bucla: ASTEAPTA"); L(c, "CAMP R0"); L(c, "NOTA R0, R1"); L(c, "JMP bucla"); k := CFS.Scrie("ecou.z7", c);
    c := ""; L(c, "# numara pana la 49 = 7 x 7, apoi se opreste"); L(c, "SET R1, 49"); L(c, "SET R2, 100");
    L(c, "bucla: INC R0"); L(c, "SCRIE R0"); L(c, "MOV R3, R0"); L(c, "EQ R3, R1"); L(c, "JNZ R3, gata"); L(c, "DORMI R2");
    L(c, "JMP bucla"); L(c, "gata: STOP"); k := CFS.Scrie("numara.z7", c);
    c := ""; L(c, "# inel: trimite un numar vecinului din inel"); L(c, "# si canta ce primeste. Porneste-l de 2-3 ori");
    L(c, "# si vezi mesajele in Network."); L(c, "SET R1, 1"); L(c, "SET R0, 1"); L(c, "SET R2, 400");
    L(c, "bucla: VECIN R3"); L(c, "TRIMITE R1, R3"); L(c, "PRIMESTE R4, R5"); L(c, "NOTA R4, R0"); L(c, "MOV R1, R4");
    L(c, "INC R1"); L(c, "DORMI R2"); L(c, "JMP bucla"); k := CFS.Scrie("inel.z7", c);
    k := CFS.Scrie("sistem.txt", "Cubicum OS v1.1 · nucleul Salamandra · procesorul și memoria: torul Z₇ în 7 dimensiuni (7⁷ = 823543 celule) · programele .z7 stau aici, în cub")
  END Programe;

