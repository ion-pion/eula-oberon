  PROCEDURE ApasaCfs(x, y: INTEGER);
    VAR i, n, px, py, ax, ay, az, bxx, byy, w, h, best, bd, dd: INTEGER; c: ARRAY LC OF CHAR; s: ARRAY 32 OF CHAR;
  BEGIN
    n := CFS.N();
    IF vede >= 0 THEN
      CFS.Nume(vede, s); CfsB(1, bxx, byy, w, h);
      IF (CFS.Tip(s) = 4) & In(x, y, bxx, byy, w, h) THEN
        i := Sal.Porneste(s); IF i >= 0 THEN procSel := i; vmSel := i; cur := 0; vede := -1 END
      ELSE CfsB(0, bxx, byy, w, h); IF In(x, y, bx, byy, bw, h) THEN vede := -1 END
      END
    ELSE
      CfsB(0, bxx, byy, w, h);
      IF In(x, y, bxx, byy, w, h) THEN
        IF sel >= 0 THEN
          CFS.Nume(sel, s);
          IF CFS.Tip(s) = 2 THEN CFS.Continut(sel, c); IncarcaAcord(c); cur := 5; Acord
          ELSE vede := sel
          END
        END
      ELSE
        CfsB(1, bxx, byy, w, h);
        IF In(x, y, bxx, byy, w, h) THEN
          IF sel >= 0 THEN
            IF acum - ardeDe < 3000 THEN CFS.Arde(sel); sel := -1; ardeDe := -10000; Sunet.Nota(110, 500, 30)
            ELSE ardeDe := acum
            END
          END
        ELSIF (y >= lY0) & (y < lY1) THEN
          i := (y - lY0 + scroll[7]) DIV rowH;
          IF (i >= 0) & (i < n) THEN sel := i; ardeDe := -10000; Sunet.Nota(Hz(i MOD 343), 120, 20) END
        ELSIF y < lY0 - D(36) THEN   (* in cub: fisierul cel mai apropiat *)
          best := -1; bd := D(18) * D(18);
          FOR i := 0 TO n - 1 DO
            CFS.Adresa(i, ax, ay, az); Proiect(ax, ay, az, cCx, cCy, cSt, px, py);
            dd := (px - x) * (px - x) + (py - y) * (py - y);
            IF dd <= bd THEN bd := dd; best := i END
          END;
          IF best >= 0 THEN sel := best; ardeDe := -10000; scroll[7] := best * rowH - (lY1 - lY0) DIV 2 END
        END
      END
    END
  END ApasaCfs;

  PROCEDURE ApasaOrga(x, y: INTEGER);
    VAR i, k, px, py, bxx, byy, w, h, best, bd, dd: INTEGER;
  BEGIN
    k := -1;
    FOR i := 0 TO 4 DO OrgaB(i, bxx, byy, w, h); IF In(x, y, bxx, byy, w, h) THEN k := i END END;
    IF k = 0 THEN Acord
    ELSIF k = 1 THEN IF arp THEN arp := FALSE ELSIF Aprinse() > 0 THEN arp := TRUE; arpI := 0; ultimArp := acum - 180 END
    ELSIF k = 2 THEN
      arp := FALSE;
      FOR i := 0 TO 342 DO on[i] := FALSE END;
      FOR i := 0 TO 6 DO on[i * 49 + Rnd(49)] := TRUE END;
      Acord
    ELSIF k = 3 THEN arp := FALSE; FOR i := 0 TO 342 DO on[i] := FALSE END
    ELSIF k = 4 THEN SalveazaAcord
    ELSIF y < oBtnY - D(4) THEN   (* nodul cel mai apropiat; la egalitate castiga stratul de sus, desenat ultimul *)
      best := -1; bd := D(15) * D(15);
      FOR i := 0 TO 342 DO NodP(i, px, py); dd := (px - x) * (px - x) + (py - y) * (py - y); IF dd <= bd THEN bd := dd; best := i END END;
      IF best >= 0 THEN
        IF on[best] THEN on[best] := FALSE ELSE on[best] := TRUE; Sunet.Nota(Hz(best), 500, 40) END
      END
    END
  END ApasaOrga;

  PROCEDURE Burn;   (* doua atingeri in 3 secunde *)
  BEGIN
    IF acum - salDe < 3000 THEN Sal.Arde; salDe := -10000; procSel := -1; Sunet.Nota(98, 900, 40)
    ELSE salDe := acum
    END
  END Burn;

  PROCEDURE ApasaProc(x, y: INTEGER);
    VAR i, k, n, bxx, byy, w, h: INTEGER; idx: ARRAY 8 OF INTEGER; s: ARRAY 32 OF CHAR;
  BEGIN
    FOR i := 0 TO Sal.NP - 1 DO IF In(x, y, bx, ProcRand(i), bw, D(30)) THEN procSel := i; vmSel := i END END;
    ProcB(0, bxx, byy, w, h);
    IF In(x, y, bxx, byy, w, h) & (procSel >= 0) THEN Sal.Opreste(procSel) END;
    ProcB(1, bxx, byy, w, h);
    IF In(x, y, bxx, byy, w, h) THEN Burn END;
    n := Progs(idx);
    FOR i := 0 TO n - 1 DO
      ProgB(i, bxx, byy, w, h);
      IF In(x, y, bxx, byy, w, h) THEN CFS.Nume(idx[i], s); k := Sal.Porneste(s); IF k >= 0 THEN procSel := k; vmSel := k END END
    END
  END ApasaProc;

  PROCEDURE Apasa(x, y: INTEGER);
    VAR i, k, bxx, byy, w, h: INTEGER;
  BEGIN
    IF y >= tbY THEN
      FOR i := 0 TO NF - 1 DO
        TbBtn(i, bxx, byy, w, h);
        IF In(x, y, bxx, byy, w, h) THEN
          IF cur = i THEN cur := -1 ELSE cur := i; IF i = 7 THEN vede := -1 END END
        END
      END
    ELSIF y < barH THEN
      IF (x > W DIV 2 - D(50)) & (x < W DIV 2 + D(90)) THEN Burn END
    ELSIF (cur >= 0) & In(x, y, wx, wy, ww, titH) THEN
      IF x > wx + ww - D(64) THEN cur := -1 END
    ELSIF cur = 0 THEN ApasaProc(x, y)
    ELSIF cur = 4 THEN
      IF (y >= by + D(24)) & (y < by + D(72)) THEN
        k := 1; WHILE (k < 7) & (Sal.Stare((vmSel + k) MOD 7) = Sal.Liber) DO INC(k) END;
        vmSel := (vmSel + k) MOD 7
      END
    ELSIF cur = 2 THEN
      FOR i := 0 TO 7 DO
        IF In(x, y, bx, by + D(36) + i * D(50), bw, D(44)) & (StareAlch(i) = 0) & (instEu < 0) THEN
          instEu := i; instDe := acum; Sunet.Nota(294, 300, 25)
        END
      END
    ELSIF cur = 3 THEN
      FOR k := 0 TO 9 DO ShellB(k, bxx, byy, w, h); IF In(x, y, bxx, byy, w, h) THEN Exec(k) END END
    ELSIF cur = 5 THEN ApasaOrga(x, y)
    ELSIF cur = 7 THEN ApasaCfs(x, y)
    END
  END Apasa;

  PROCEDURE Atinge*;   (* o atingere scurta = apasare; o tragere = derulare (Shell, Trilogia, lista din Cubicum FS) *)
    VAR ap: BOOLEAN; x, y: INTEGER;
  BEGIN
    ap := Ecran.Apasat(); x := Ecran.AtinsX(); y := Ecran.AtinsY();
    IF booted THEN
      Asaza;
      IF ap & ~era THEN jx := x; jy := y; ultimY := y; mutat := 0
      ELSIF ap & era THEN
        IF ABS(y - jy) > D(10) THEN mutat := 1 END;
        IF (mutat = 1) & (cur >= 0) THEN
          IF cur = 3 THEN scroll[3] := scroll[3] + (y - ultimY) ELSE scroll[cur] := scroll[cur] + (ultimY - y) END
        END;
        ultimY := y
      ELSIF ~ap & era & (mutat = 0) THEN Apasa(jx, jy)
      END
    END;
    era := ap
  END Atinge;

  PROCEDURE Deseneaza*;   (* la fiecare cadru *)
    VAR e: INTEGER;
  BEGIN
    Asaza; acum := Sunet.Ms();
    IF t0 < 0 THEN t0 := acum; ultimCadru := acum END;
    dt := acum - ultimCadru; IF dt > 100 THEN dt := 100 ELSIF dt < 0 THEN dt := 0 END;
    ultimCadru := acum;
    e := acum - t0;
    IF ~booted & (e >= 5800) THEN booted := TRUE; PornesteDesktop END;
    IF ~booted THEN Boot(e)
    ELSE
      Fundal(e); Tic;
      IF cur >= 0 THEN
        CorpFereastra; clip0 := by; clip1 := by + bh;
        IF cur = 0 THEN Procese ELSIF cur = 1 THEN Retea ELSIF cur = 2 THEN Alchimist ELSIF cur = 3 THEN Shell
        ELSIF cur = 4 THEN VM ELSIF cur = 5 THEN Orga ELSIF cur = 6 THEN Trilogie ELSE Cfs
        END;
        clip0 := 0; clip1 := H;
        TitluFereastra
      ELSE Gol
      END;
      BaraSus; BaraJos
    END
  END Deseneaza;

