  PROCEDURE Exec(k: INTEGER);
    VAR i, j, x, y, z: INTEGER; s: ARRAY LL OF CHAR; t: ARRAY LL OF CHAR; cnt: ARRAY 8 OF INTEGER;
  BEGIN
    Strings.Copy(cmd[k], ultimaCmd); scroll[3] := 0;
