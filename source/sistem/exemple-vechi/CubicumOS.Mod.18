    f2[36] := 13; f2[37] := 14; f2[38] := 14; f2[39] := 15; f2[40] := 16; f2[41] := 17; 
    f2[42] := 18; f2[43] := 19; f2[44] := 20; f2[45] := 21; f2[46] := 23; f2[47] := 24; 
    f2[48] := 26; f2[49] := 27; f2[50] := 29; f2[51] := 30; f2[52] := 32; f2[53] := 34; 
    f2[54] := 36; f2[55] := 38; f2[56] := 41; f2[57] := 43; f2[58] := 46; f2[59] := 48; 
    f2[60] := 51; f2[61] := 54; f2[62] := 57; f2[63] := 61; f2[64] := 64; f2[65] := 68; 
