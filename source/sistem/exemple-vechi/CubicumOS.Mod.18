    f1[0] := 2616; f1[1] := 2772; f1[2] := 2937; f1[3] := 3111; f1[4] := 3296; f1[5] := 3492; f1[6] := 3700; f1[7] := 3920; f1[8] := 4153; f1[9] := 4400; f1[10] := 4662; f1[11] := 4939;
  END Init;

BEGIN
  Init
END E7Teorie.

MODULE E7Comp; (* Eula Music in Oberon: compune pe torul spirala (kilometrajul Z7), ca Compozitor.java.
  Celula i din 343 = cifrele ei in baza 7 (x, y, z). Inelul are 7^3 - 1 = 342 de locuri: ultima celula (6,6,6)
  cade peste prima — torul care nu se inchide. x (unitatile) = melodia, treapta fata de acord; y (zecile) = acordul:
  la fiecare transport din x in y acordul merge pe cercul cvintelor al gamei (I IV vii° iii vi ii V si inapoi la I);
  z (sutele) = textura acompaniamentului. Pasii vin din literele cuvantului, trecute prin regula Eulei:
  w = B7(w + litera + 2). Plus comanda „compune …” din Eula Music (tonalitatea, gama, samanta, lung).
  Pion & Claude, 21.10.2026 *)

  IMPORT T := E7Txt, Te := E7Teorie;

  CONST R = 342; LQ = 1024; Bt = Te.Bt;

  VAR ALFA: ARRAY 40 OF CHAR;
    padM, padT, padV: ARRAY 8 OF INTEGER; npad: INTEGER;
    (* ce a inteles comanda „compune” *)
    cLit*, cAlt*, cGama*: INTEGER; cLung*: BOOLEAN; cSam*: ARRAY 256 OF CHAR;

  PROCEDURE B7(n: INTEGER): INTEGER;
  BEGIN RETURN (n - 1) MOD 7 + 1
  END B7;

  PROCEDURE Val*(c: CHAR): INTEGER;   (* litera -> 1..7; altceva -> -1 *)
    VAR p, i: INTEGER; r: INTEGER;
  BEGIN
    c := T.Mic(c); p := -1; i := 0;
    WHILE (p < 0) & (ALFA[i] # 0X) DO IF ALFA[i] = c THEN p := i END; INC(i) END;
    IF p < 0 THEN r := -1 ELSE r := B7(p + 1) END;
    RETURN r
  END Val;

  (* semitonurile treptei d (poate fi negativa sau peste 6) in gama g; in minor, peste V si vii° sensibila urca *)
  PROCEDURE Semi(g, d: INTEGER; rid: BOOLEAN): INTEGER;
    VAR o, k, s: INTEGER;
  BEGIN
    o := d DIV 7; k := d MOD 7;   (* in Oberon DIV si MOD rotunjesc in jos, ca fdiv / fmod din Java *)
    s := Te.gSemi[g][k] + 12 * o;
    IF rid & (k = 6) THEN INC(s) END;
    RETURN s
  END Semi;

  PROCEDURE NumeAcord(g: INTEGER; VAR nl, na: ARRAY OF INTEGER; c: INTEGER; minor: BOOLEAN; VAR s: ARRAY OF CHAR);
    VAR rid: BOOLEAN; a, b, e, t3, t5, rl, ra: INTEGER; tip, nr: ARRAY 16 OF CHAR;
  BEGIN
    rid := minor & ((c = 4) OR (c = 6));
    a := Semi(g, c, rid); b := Semi(g, c + 2, rid); e := Semi(g, c + 4, rid);
    t3 := b - a; t5 := e - a;
    IF (t3 = 4) & (t5 = 7) THEN tip := "major" ELSIF (t3 = 3) & (t5 = 7) THEN tip := "minor" ELSIF (t3 = 3) & (t5 = 6) THEN tip := "diminuat"
    ELSIF (t3 = 4) & (t5 = 8) THEN tip := "mărit" ELSE tip := "" END;
    Te.Rom(c, T.Eq(tip, "major") OR T.Eq(tip, "mărit"), nr);
    IF T.Eq(tip, "diminuat") THEN T.Add(nr, "°") END;
    rl := nl[c]; ra := na[c];
    IF rid & (c = 6) THEN INC(ra) END;
    s := ""; T.Add(s, nr); T.Add(s, " "); Te.AddNume(s, rl, ra);
    IF tip[0] # 0X THEN T.Add(s, " "); T.Add(s, tip) END
  END NumeAcord;

  PROCEDURE Inchide(t: INTEGER);
    VAR i, d: INTEGER;
  BEGIN
    FOR i := 0 TO npad - 1 DO d := t - padT[i]; IF d < 2500 THEN d := 2500 END; Te.Ev(padM[i], padT[i], d, padV[i]) END;
    npad := 0
  END Inchide;

  PROCEDURE Pad(m, t, v: INTEGER);
  BEGIN padM[npad] := m; padT[npad] := t; padV[npad] := v; INC(npad)
  END Pad;

  PROCEDURE AcordulCelMaiApropiat(r: INTEGER): INTEGER;
    VAR d, x: INTEGER;
  BEGIN
    x := r; d := 0;
    WHILE d < 4 DO
      IF ((r - d) MOD 7) MOD 2 = 0 THEN IF (r - d) MOD 7 <= 4 THEN x := r - d; d := 9 END END;
      IF d < 4 THEN IF ((r + d) MOD 7) MOD 2 = 0 THEN IF (r + d) MOD 7 <= 4 THEN x := r + d; d := 9 END END END;
      INC(d)
    END;
    RETURN x
  END AcordulCelMaiApropiat;

  (* compune: textul in Te.txt, notele in evenimentele lui Te *)
  PROCEDURE Compune*(tl, ta, g: INTEGER; samanta: ARRAY OF CHAR; lung: BOOLEAN);
    VAR minor, tare, rid, final: BOOLEAN; v: ARRAY 256 OF INTEGER; nv, i, k, w, li, baza, t, y0, prevM, prevY, parcurs, limita, nrNote,
      s, x, y, z, c, bas, m, r, urm, d, j, mel: INTEGER;
      nl, na: ARRAY 7 OF INTEGER; acorduri: ARRAY 2048 OF CHAR; pasi: ARRAY 64 OF CHAR; ultimul, nume, v5: ARRAY 64 OF CHAR;
      cad, lun: ARRAY 2 OF INTEGER; o: ARRAY 8192 OF CHAR;
  BEGIN
    Te.Goleste(); npad := 0;
    minor := T.Eq(Te.gCheie[g], "minor");
    nv := 0; i := 0;
    WHILE (i < LEN(samanta)) & (samanta[i] # 0X) DO k := Val(samanta[i]); IF (k > 0) & (nv < LEN(v)) THEN v[nv] := k; INC(nv) END; INC(i) END;
    IF nv = 0 THEN v[0] := 5; nv := 1 END;
    i := 0; FOR k := 0 TO nv - 1 DO i := (i * 7 + v[k]) MOD R END;
    w := 5; li := 0;
    baza := Te.MidiRad(tl, ta);
    Te.Scrie(tl, ta, Te.gSemi[g], Te.gLit[g], 7, FALSE, nl, na);
    t := 0; y0 := (i DIV 7) MOD 7; prevM := -1; prevY := -1; parcurs := 0; nrNote := 0;
    IF lung THEN limita := R ELSE limita := 98 END;
    acorduri := ""; pasi := ""; ultimul := ""; c := 0;
    WHILE parcurs < limita DO
      w := B7(w + v[li MOD nv] + 2); INC(li);
      s := (w - 1) MOD 3 + 1;
      IF T.Len(pasi) < 40 THEN T.AddInt(pasi, s) END;
      x := i MOD 7; y := (i DIV 7) MOD 7; z := (i DIV 49) MOD 7;
      c := (3 * ((y - y0) MOD 7)) MOD 7;   (* I IV vii° iii vi ii V, pornind de la tonica *)
      tare := y # prevY;
      IF tare THEN
        Inchide(t);
        NumeAcord(g, nl, na, c, minor, nume);
        IF ~T.Eq(nume, ultimul) THEN IF acorduri[0] # 0X THEN T.Add(acorduri, " · ") END; T.Add(acorduri, nume); T.Copy(nume, ultimul) END;
        rid := minor & ((c = 4) OR (c = 6));
        bas := baza - 12 + Semi(g, c, rid);
        WHILE bas > baza - 7 DO bas := bas - 12 END;
        Pad(bas, t, 2);
        FOR k := 0 TO 2 DO
          m := baza + Semi(g, c + 2 * k, rid);
          WHILE m > baza + 7 DO m := m - 12 END;
          IF z MOD 2 = 1 THEN Pad(m, t + 2500 * k, 1) ELSE Pad(m, t, 1) END
        END;
        prevY := y
      END;
      IF (y - y0) MOD 2 = 0 THEN r := x ELSE r := 4 - x END;   (* la acordurile pare melodia urca, la cele impare coboara *)
      IF tare THEN r := AcordulCelMaiApropiat(r) END;
      rid := minor & ((c = 4) OR (c = 6));
      m := baza + Semi(g, c + r, rid);
      IF prevM < 0 THEN WHILE m < baza + 5 DO m := m + 12 END
      ELSE   (* octava cea mai apropiata de nota dinainte *)
        WHILE m - prevM > 6 DO m := m - 12 END;
        WHILE prevM - m > 6 DO m := m + 12 END
      END;
      WHILE m > baza + 19 DO m := m - 12 END;
      WHILE m < baza + 2 DO m := m + 12 END;
      prevM := m;
      urm := (i + s) MOD R;
      final := (urm DIV 7) MOD 7 # y;   (* urmeaza transport: ultima nota pe acordul asta *)
      IF s = 1 THEN d := 5000 ELSIF s = 2 THEN d := 7500 ELSE d := Bt END;
      IF final THEN d := d * 2; IF d < Bt THEN d := Bt END END;
      Te.Ev(m, t, d * 95 DIV 100, 0);
      INC(nrNote);
      t := t + d; i := urm; parcurs := parcurs + s
    END;
    (* cadenta: V -> I *)
    Inchide(t);
    cad[0] := 4; cad[1] := 0; lun[0] := 2 * Bt; lun[1] := 4 * Bt;
    FOR k := 0 TO 1 DO
      c := cad[k];
      rid := minor & (c = 4);
      bas := baza - 12 + Semi(g, c, rid);
      WHILE bas > baza - 7 DO bas := bas - 12 END;
      Te.Ev(bas, t, lun[k], 2);
      FOR j := 0 TO 2 DO
        m := baza + Semi(g, c + 2 * j, rid);
        WHILE m > baza + 7 DO m := m - 12 END;
        Te.Ev(m, t, lun[k], 1)
      END;
      IF k = 0 THEN mel := baza + 12 + Semi(g, 1, rid) ELSE mel := baza + 12 + Semi(g, 0, rid) END;
      WHILE (prevM >= 0) & (mel - prevM > 7) DO mel := mel - 12 END;
      prevM := mel;
      Te.Ev(mel, t, lun[k] * 95 DIV 100, 0);
      t := t + lun[k]
    END;
    NumeAcord(g, nl, na, 4, minor, v5);
    IF ~T.Eq(ultimul, v5) THEN T.Add(acorduri, " · "); T.Add(acorduri, v5) END;
    NumeAcord(g, nl, na, 0, minor, nume); T.Add(acorduri, " · "); T.Add(acorduri, nume);
    o := "Compun în "; Te.AddNume(o, tl, ta); T.Add(o, " "); T.Add(o, Te.gNume[g]); T.Add(o, " din „");
    T.Add(o, samanta); T.Add(o, "”: "); T.AddInt(o, nrNote); T.Add(o, " de note, ");
    IF lung THEN T.Add(o, "tot inelul (342 de celule)") ELSE T.Add(o, "două ture ale cercului") END;
    T.Add(o, "."); T.AddCh(o, 0AX); T.Add(o, "Pașii pe spirală (literele trecute prin regula Eulei): "); T.Add(o, pasi);
    IF T.Len(pasi) >= 40 THEN T.Add(o, "…") END;
    T.AddCh(o, 0AX); T.Add(o, "Acordurile (transportul din unități în zeci): "); T.Add(o, acorduri); T.Add(o, ".");
    Te.PuneTxt(o)
  END Compune;

  (* replaceAll("\\b(lung|in|pe)\\b", "") *)
  PROCEDURE Scoate(VAR s: ARRAY OF CHAR);
    VAR r: ARRAY 256 OF CHAR; i, n, k, e: INTEGER; w: ARRAY 8 OF CHAR; gata: BOOLEAN;
  BEGIN
    n := T.Len(s); i := 0; r[0] := 0X;
    WHILE i < n DO
      gata := FALSE; k := 0;
      IF (i = 0) OR ~T.Cuv(s[i - 1]) THEN
        WHILE ~gata & (k < 3) DO
          IF k = 0 THEN w := "lung" ELSIF k = 1 THEN w := "in" ELSE w := "pe" END;
          e := Te.Lit(s, i, w);
          IF (e >= 0) & ((e >= n) OR ~T.Cuv(s[e])) THEN gata := TRUE; i := e END;
          INC(k)
        END
      END;
      IF ~gata THEN T.AddCh(r, s[i]); INC(i) END
    END;
    T.Copy(r, s)
  END Scoate;

  (* comanda „compune …” din Eula Music: intelege tonalitatea, gama, samanta si „lung”, apoi compune *)
  PROCEDURE Comanda*(q: ARRAY OF CHAR);
    VAR t, rest, inn, dupa, tot: ARRAY LQ OF CHAR; s, n, e, ga, k, x, sum, i: INTEGER; gasit: BOOLEAN; w: ARRAY 16 OF CHAR;
  BEGIN
    Te.Fold(q, t); n := T.Len(t);
    cLung := T.Contine(t, " lung"); cLit := -1; cAlt := 0; cGama := 0; gasit := FALSE;
    T.Copy(t, rest);
    s := 0;
    WHILE ~gasit & (s < n) DO
      e := -1;
      IF s = 0 THEN e := Te.Nota(t, 0, 0) END;
      IF (e < 0) & T.Spatiu(t[s]) THEN e := Te.Nota(t, s + 1, 0) END;
      IF e < 0 THEN INC(s)
      ELSE
        T.Sub(t, e, n, dupa); ga := Te.Urmeaza(dupa, TRUE);
        T.Sub(t, 0, s, inn); T.Trim(inn);
        IF (ga >= 0) OR T.Eq(inn, "in") OR T.Eq(inn, "pe") OR T.Sfarsit(inn, " in") OR T.Sfarsit(inn, " pe") THEN
          cLit := Te.nLit; cAlt := Te.nAlt;
          IF ga < 0 THEN cGama := 0 ELSE cGama := Te.Gama(Te.cgV[ga]) END;
          IF ~Te.gL7[cGama] THEN
            IF T.Eq(Te.gCheie[cGama], "pentamin") OR T.Eq(Te.gCheie[cGama], "blues") THEN cGama := 1 ELSE cGama := 0 END
          END;
          T.Sub(t, s, e, tot);
          IF ga >= 0 THEN T.Add(tot, " "); T.Add(tot, Te.cgK[ga]) END;
          T.Trim(tot); Te.Inloc(rest, tot, " ");
          gasit := TRUE
        ELSE s := e
        END
      END
    END;
    (* samanta: (?:din|cu|despre|pentru)\s+(.+)$ pe rest *)
    cSam := "eula"; n := T.Len(rest); s := 0; gasit := FALSE;
    WHILE ~gasit & (s < n) DO
      k := 0;
      WHILE ~gasit & (k < 4) DO
        CASE k OF 0: w := "din" | 1: w := "cu" | 2: w := "despre" | 3: w := "pentru" END;
        e := Te.Lit(rest, s, w);
        IF e >= 0 THEN
          x := e; WHILE (x < n) & T.Spatiu(rest[x]) DO INC(x) END;
          IF x > e THEN
            IF x < n THEN gasit := TRUE; T.Sub(rest, x, n, cSam)
            ELSIF x - e >= 2 THEN gasit := TRUE; T.Sub(rest, n - 1, n, cSam)   (* \s+ da inapoi un spatiu, ca .+ sa prinda ceva *)
            END
          END
        END;
        INC(k)
      END;
      INC(s)
    END;
    IF gasit THEN Scoate(cSam); T.Trim(cSam) END;
    IF cSam[0] = 0X THEN cSam := "eula" END;
    IF cLit < 0 THEN   (* tonalitatea iese din cuvant *)
      sum := 0; i := 0;
      WHILE cSam[i] # 0X DO x := Val(cSam[i]); IF x > 0 THEN sum := sum + x END; INC(i) END;
      cLit := sum MOD 7; cAlt := 0;
      IF sum MOD 2 = 0 THEN cGama := 0 ELSE cGama := 1 END
    END;
    Compune(cLit, cAlt, cGama, cSam, cLung)
  END Comanda;

BEGIN
  ALFA := "aăâbcdefghiîjklmnopqrsștțuvwxyz"
END E7Comp.

MODULE E7Sonor; (* Eula Music in Oberon: sonificarea codului, ca CodSonor.java. Fiecare rand devine o nota,
  structura devine armonie (in Do major):
   - adancimea (cat de imbricat e randul) = registrul: fiecare nivel urca o terta pe acordul blocului;
   - felul randului = acordul: definitie I, bucla vi, conditie V, else IV, import ii, eroare/try vii°;
     randurile obisnuite raman pe acordul blocului in care stau; return = cadenta V->I;
   - inchiderea unui bloc coboara la acordul blocului parinte; sfarsitul unei functii (adancime 0) = cadenta;
   - comentariile = note soptite, sus; randul gol = respiratie;
   - acoladele care nu se inchid raman la final ca acord diminuat nerezolvat; o inchidere in plus = disonanta.
  Acolade/paranteze pentru C, Java, Limbo, JS, Go, Rust; BEGIN/END pentru Oberon/Pascal; indentare pentru Python.
  Textul vine intr-un tablou mare (VAR), randurile se iau pe rand. Pion & Claude, 21.10.2026 *)

  IMPORT T := E7Txt, Te := E7Teorie;

  CONST DEF = 0; BUCLA = 1; COND = 2; ALTFEL = 3; RET = 4; EROARE = 5; IMPRT = 6; COMENT = 7; INCHIDE = 8; ALTUL = 9; GOL = 10;
    ACOLADE = 0; OBERON = 1; INDENTARE = 2;
    MAXR = 400; ML = 65536; MW = 256; NR = 200000;

  VAR NUME, UNU: ARRAY 11 OF ARRAY 24 OF CHAR; ACORD: ARRAY 11 OF INTEGER; MAJ: ARRAY 7 OF INTEGER;
    linie, tr, cod, fara, w0: ARRAY ML OF CHAR;
    ra, rb: ARRAY NR OF INTEGER;    (* randurile pastrate: [ra, rb) din text, sau ra < 0: -(cate randuri de date) *)
    nr0: INTEGER;
    cuv: ARRAY MW OF ARRAY 64 OF CHAR; ncuv: INTEGER;
    EXEMPLU*, GRESIT*: ARRAY 1024 OF CHAR;

  PROCEDURE Alb(c: CHAR): BOOLEAN;   (* Character.isWhitespace *)
    VAR o: INTEGER;
  BEGIN o := ORD(c);
    RETURN (o = 20H) OR (o >= 9) & (o <= 0DH) OR (o >= 1CH) & (o <= 1FH) OR (o = 1680H) OR (o >= 2000H) & (o <= 2006H)
      OR (o >= 2008H) & (o <= 200AH) OR (o = 2028H) OR (o = 2029H) OR (o = 205FH) OR (o = 3000H)
  END Alb;

  PROCEDURE Sp(c: CHAR): BOOLEAN;   (* \s din expresii: spatiu, \t \n \x0B \f \r *)
  BEGIN RETURN (c = " ") OR (c >= 9X) & (c <= 0DX)
  END Sp;

  PROCEDURE Wa(c: CHAR): BOOLEAN;   (* \w: [a-zA-Z_0-9] *)
  BEGIN RETURN (c >= "a") & (c <= "z") OR (c >= "A") & (c <= "Z") OR (c >= "0") & (c <= "9") OR (c = "_")
  END Wa;

  PROCEDURE Nr(VAR d: ARRAY OF CHAR; n: INTEGER; unu, multe: ARRAY OF CHAR);   (* 1 rând, 7 rânduri, 23 de rânduri *)
    VAR r: INTEGER;
  BEGIN
    IF n = 1 THEN T.Add(d, "1 "); T.Add(d, unu)
    ELSE r := n MOD 100; T.AddInt(d, n); IF (r = 0) OR (r >= 20) THEN T.Add(d, " de ") ELSE T.Add(d, " ") END; T.Add(d, multe)
    END
  END Nr;

  PROCEDURE Semi(grad: INTEGER): INTEGER;
  BEGIN RETURN 12 * (grad DIV 7) + MAJ[grad MOD 7]
  END Semi;

  (* bucata [a, b) din text, fara spatiile (<= " ") de la capete, in d *)
  PROCEDURE Taie(VAR s: ARRAY OF CHAR; a, b: INTEGER; VAR d: ARRAY OF CHAR);
    VAR i: INTEGER;
  BEGIN
    WHILE (a < b) & (s[a] <= " ") DO INC(a) END;
    WHILE (b > a) & (s[b - 1] <= " ") DO DEC(b) END;
    i := 0; WHILE (a < b) & (i < LEN(d) - 1) DO d[i] := s[a]; INC(i); INC(a) END; d[i] := 0X
  END Taie;

  PROCEDURE Lung(VAR s: ARRAY OF CHAR): INTEGER;
  BEGIN RETURN T.Len(s)
  END Lung;

  PROCEDURE Ext(nume: ARRAY OF CHAR): BOOLEAN;
    VAR n: ARRAY 256 OF CHAR; i: INTEGER; r: BOOLEAN; e: ARRAY 10 OF CHAR;
  BEGIN
    T.Copy(nume, n); T.MicS(n); r := FALSE;
    FOR i := 0 TO 27 DO
      CASE i OF 0: e := ".java" | 1: e := ".c" | 2: e := ".h" | 3: e := ".cpp" | 4: e := ".cc" | 5: e := ".hpp" | 6: e := ".js" | 7: e := ".ts"
      | 8: e := ".py" | 9: e := ".b" | 10: e := ".m" | 11: e := ".mod" | 12: e := ".ob" | 13: e := ".obn" | 14: e := ".ob07"
      | 15: e := ".go" | 16: e := ".rs" | 17: e := ".kt" | 18: e := ".swift" | 19: e := ".cs" | 20: e := ".php" | 21: e := ".rb"
      | 22: e := ".lua" | 23: e := ".sh" | 24: e := ".pas" | 25: e := ".dart" | 26: e := ".scala" | 27: e := ".zig" END;
      IF T.Sfarsit(n, e) THEN r := TRUE END
    END;
    RETURN r
  END Ext;

  PROCEDURE ECod*(nume: ARRAY OF CHAR; areNume: BOOLEAN; VAR text: ARRAY OF CHAR): BOOLEAN;   (* e cod? *)
    VAR r: BOOLEAN; n, a, b, k, cd, tot: INTEGER;
  BEGIN
    r := areNume & Ext(nume);
    IF ~r THEN
      n := T.Len(text); a := 0; k := 0; cd := 0; tot := 0;
      WHILE a <= n DO
        INC(k);
        IF k < 300 THEN b := a; WHILE (b < n) & (text[b] # 0AX) DO INC(b) END ELSE b := n END;   (* split("\n", 300) *)
        Taie(text, a, b, tr);
        IF tr[0] # 0X THEN
          INC(tot);
          IF T.Sfarsit(tr, ";") OR T.Sfarsit(tr, "{") OR T.Eq(tr, "}") OR T.Incepe(tr, "def ") OR T.Incepe(tr, "import ") OR T.Incepe(tr, "#include")
            OR T.Incepe(tr, "PROCEDURE") OR T.Incepe(tr, "END") OR T.Incepe(tr, "//") OR T.Sfarsit(tr, "):") THEN INC(cd) END
        END;
        a := b + 1
      END;
      r := (tot >= 3) & (cd * 3 >= tot)
    END;
    RETURN r
  END ECod;

  PROCEDURE Stil(VAR text: ARRAY OF CHAR; nume: ARRAY OF CHAR; areNume: BOOLEAN): INTEGER;
    VAR n, a, b, doua, acf, acolade, be, i, j, s: INTEGER; nm: ARRAY 256 OF CHAR;
  BEGIN
    T.Copy(nume, nm); T.MicS(nm);
    IF areNume & T.Sfarsit(nm, ".py") THEN s := INDENTARE
    ELSE
      n := T.Len(text); a := 0; doua := 0; acf := 0;
      WHILE a < n DO
        b := a; WHILE (b < n) & (text[b] # 0AX) DO INC(b) END;
        Taie(text, a, b, tr);
        IF T.Sfarsit(tr, ":") THEN INC(doua) END;
        IF T.Sfarsit(tr, "{") OR T.Sfarsit(tr, ";") THEN INC(acf) END;
        a := b + 1
      END;
      IF (doua > 2) & (doua > acf) THEN s := INDENTARE
      ELSE
        acolade := 0; be := 0; i := 0;
        WHILE i < n DO
          IF (text[i] = "{") OR (text[i] = "}") THEN INC(acolade) END;
          IF ((i = 0) OR ~T.Cuv(text[i - 1])) & (T.IncepeLa(text, i, "BEGIN") OR T.IncepeLa(text, i, "END")) THEN
            IF T.IncepeLa(text, i, "BEGIN") THEN j := i + 5 ELSE j := i + 3 END;
            IF (j >= n) OR ~T.Cuv(text[j]) THEN INC(be); i := j - 1 END
          END;
          INC(i)
        END;
        IF be > acolade THEN s := OBERON ELSIF acolade > 0 THEN s := ACOLADE ELSE s := INDENTARE END
      END
    END;
    RETURN s
  END Stil;

  PROCEDURE Cuvinte(VAR t: ARRAY OF CHAR);   (* t.split("[^A-Za-z0-9_#]+"), fara cele goale *)
    VAR i, k: INTEGER; c: CHAR;
  BEGIN
    ncuv := 0; i := 0;
    WHILE t[i] # 0X DO
      c := t[i];
      IF Wa(c) OR (c = "#") THEN
        k := 0;
        WHILE Wa(t[i]) OR (t[i] = "#") DO IF k < 63 THEN cuv[ncuv][k] := t[i]; INC(k) END; INC(i) END;
        cuv[ncuv][k] := 0X; IF ncuv < MW - 1 THEN INC(ncuv) END
      ELSE INC(i)
      END
    END
  END Cuvinte;

  PROCEDURE In(VAR w: ARRAY OF CHAR; lista: ARRAY OF CHAR): BOOLEAN;   (* w e unul din cuvintele listei (despartite prin spatiu) *)
    VAR x: ARRAY 80 OF CHAR;
  BEGIN x := " "; T.Add(x, w); T.Add(x, " "); RETURN T.Contine(lista, x)
  END In;

  PROCEDURE Fel(VAR t: ARRAY OF CHAR; stil: INTEGER; deschide: BOOLEAN): INTEGER;
    VAR r, i, p, q: INTEGER; numai, ok: BOOLEAN; k, kl: ARRAY 64 OF CHAR;
  BEGIN
    r := -1;
    IF t[0] = 0X THEN r := GOL
    ELSIF T.Incepe(t, "//") OR T.Incepe(t, "/*") OR T.Incepe(t, "*") OR T.Incepe(t, "(*") OR T.Incepe(t, "--")
      OR T.Incepe(t, "#") & ~T.Incepe(t, "#include") OR T.Incepe(t, ";") THEN r := COMENT
    END;
    IF r < 0 THEN
      (* fara = t fara \s ; , *)
      p := 0; i := 0; WHILE t[i] # 0X DO IF ~Sp(t[i]) & (t[i] # ";") & (t[i] # ",") THEN fara[p] := t[i]; INC(p) END; INC(i) END; fara[p] := 0X;
      numai := p > 0; i := 0; WHILE i < p DO IF (fara[i] # "}") & (fara[i] # ")") & (fara[i] # "]") THEN numai := FALSE END; INC(i) END;
      ok := FALSE;
      IF (stil = OBERON) & T.Incepe(t, "END") THEN   (* END(\s+\w+)?\s*[;.]? *)
        q := 3; WHILE Sp(t[q]) DO INC(q) END;
        IF (q > 3) & Wa(t[q]) THEN
          WHILE Wa(t[q]) DO INC(q) END; WHILE Sp(t[q]) DO INC(q) END; IF (t[q] = ";") OR (t[q] = ".") THEN INC(q) END;
          ok := t[q] = 0X
        END;
        IF ~ok THEN q := 3; WHILE Sp(t[q]) DO INC(q) END; IF (t[q] = ";") OR (t[q] = ".") THEN INC(q) END; ok := t[q] = 0X END
      END;
      IF ~ok THEN   (* (end|fi|done|esac)\b.* *)
        q := -1;
        IF T.Incepe(t, "end") THEN q := 3 ELSIF T.Incepe(t, "fi") THEN q := 2 ELSIF T.Incepe(t, "done") THEN q := 4 ELSIF T.Incepe(t, "esac") THEN q := 4 END;
        IF q > 0 THEN ok := (t[q] = 0X) OR ~T.Cuv(t[q]) END
      END;
      IF numai OR ok THEN r := INCHIDE END
    END;
    IF r < 0 THEN
      Cuvinte(t);
      i := 0;
      WHILE i < ncuv DO T.Copy(cuv[i], kl); T.MicS(kl); IF In(kl, " public private protected static final abstract synchronized export async override virtual const inline pub extern ") THEN INC(i) ELSE p := i; i := ncuv + 1 END END;
      IF i = ncuv THEN r := ALTUL
      ELSE
        T.Copy(cuv[p], k); T.Copy(k, kl); T.MicS(kl);
        IF T.Incepe(t, "}") & (ncuv > 0) THEN T.Copy(cuv[0], k); T.Copy(k, kl); T.MicS(kl) END;
        IF stil = OBERON THEN
          IF T.Eq(k, "PROCEDURE") OR T.Eq(k, "MODULE") OR T.Eq(k, "TYPE") OR T.Eq(k, "RECORD") THEN r := DEF
          ELSIF T.Eq(k, "WHILE") OR T.Eq(k, "FOR") OR T.Eq(k, "REPEAT") OR T.Eq(k, "LOOP") OR T.Eq(k, "UNTIL") THEN r := BUCLA
          ELSIF T.Eq(k, "IF") OR T.Eq(k, "ELSIF") OR T.Eq(k, "CASE") THEN r := COND
          ELSIF T.Eq(k, "ELSE") THEN r := ALTFEL
          ELSIF T.Eq(k, "RETURN") OR T.Eq(k, "EXIT") OR T.Eq(k, "HALT") THEN r := RET
          ELSIF T.Eq(k, "IMPORT") THEN r := IMPRT
          ELSIF T.Eq(k, "ASSERT") THEN r := EROARE
          ELSE r := ALTUL
          END
        ELSIF In(kl, " class def function func fn procedure module struct interface enum impl trait object record fun sub type ") THEN r := DEF
        ELSIF In(kl, " for while do repeat loop foreach until ") THEN r := BUCLA
        ELSIF In(kl, " if switch case when match elif elsif unless select ") THEN r := COND
        ELSIF In(kl, " else default otherwise ") THEN
          r := ALTFEL; i := 0;   (* .*\bif\b.* *)
          WHILE t[i] # 0X DO
            IF T.IncepeLa(t, i, "if") & ((i = 0) OR ~T.Cuv(t[i - 1])) & ((t[i + 2] = 0X) OR ~T.Cuv(t[i + 2])) THEN r := COND END;
            INC(i)
          END
        ELSIF In(kl, " return break continue exit yield goto halt ") THEN r := RET
        ELSIF In(kl, " try catch except finally throw throws raise panic assert rescue ") THEN r := EROARE
        ELSIF In(kl, " import include #include using package from require use implement ") THEN r := IMPRT
        ELSIF deschide & T.Contine(t, "(") & ~T.Contine(t, "=") & (ncuv >= 2) THEN r := DEF
        ELSIF (stil = INDENTARE) & T.Sfarsit(t, ":") & T.Contine(t, "(") THEN r := DEF
        ELSE r := ALTUL
        END
      END
    END;
    RETURN r
  END Fel;

  PROCEDURE DateRand(VAR s: ARRAY OF CHAR; a, b: INTEGER): BOOLEAN;   (* randul (fara \r) are >= 40 de semne, toate litere, cifre, + / = *)
    VAR c: CHAR; r: BOOLEAN; n: INTEGER;
  BEGIN
    WHILE (a < b) & ((s[a] <= " ") OR (s[a] = 0DX)) DO INC(a) END;
    WHILE (b > a) & ((s[b - 1] <= " ") OR (s[b - 1] = 0DX)) DO DEC(b) END;
    r := TRUE; n := 0;
    WHILE r & (a < b) DO
      c := s[a];
      IF c # 0DX THEN r := Wa(c) & (c # "_") OR (c = "+") OR (c = "/") OR (c = "="); INC(n) END;
      INC(a)
    END;
    RETURN r & (n >= 40)
  END DateRand;

  (* randul i (pastrat) in linie, fara \r; intoarce FALSE daca e rand-semn de date *)
  PROCEDURE Rand(VAR text: ARRAY OF CHAR; i: INTEGER; VAR l: ARRAY OF CHAR): BOOLEAN;
    VAR a, k: INTEGER;
  BEGIN
    k := 0;
    IF ra[i] >= 0 THEN
      a := ra[i];
      WHILE (a < rb[i]) & (k < LEN(l) - 1) DO IF text[a] # 0DX THEN l[k] := text[a]; INC(k) END; INC(a) END
    END;
    l[k] := 0X;
    RETURN ra[i] >= 0
  END Rand;

  PROCEDURE Sonifica*(VAR text: ARRAY OF CHAR; nume: ARRAY OF CHAR; areNume: BOOLEAN);
    VAR stil, n, date, i, k, a, b, s, adanc, maxAdanc, erori, primaEroare, acordCurent, idxInBloc, indentUnit, t, baza,
      inainte, deschise, inchise, inchiseLaInceput, fel, dLinie, acord, dur, m, bas, nivel, grad, nota, parinte, j, len, niv: INTEGER;
      cate: ARRAY 11 OF INTEGER; acordBloc: ARRAY 64 OF INTEGER; inComentariu, inceput, ePrimul: BOOLEAN; sir, c, d: CHAR;
      o: ARRAY Te.LT OF CHAR; st: ARRAY 1024 OF CHAR; ant, dup: ARRAY 256 OF CHAR;
  BEGIN
    Te.Goleste();
    stil := Stil(text, nume, areNume);
    (* randurile; datele (base64, hex) le strang intr-un singur rand-semn *)
    len := T.Len(text); a := 0; nr0 := 0; date := 0;
    WHILE (a <= len) & (nr0 < NR) DO
      b := a; WHILE (b < len) & (text[b] # 0AX) DO INC(b) END;
      IF DateRand(text, a, b) THEN
        INC(date);
        IF (nr0 > 0) & (ra[nr0 - 1] < 0) THEN DEC(ra[nr0 - 1]) ELSE ra[nr0] := -1; rb[nr0] := 0; INC(nr0) END
      ELSE ra[nr0] := a; rb[nr0] := b; INC(nr0)
      END;
      a := b + 1
    END;
    IF nr0 < MAXR THEN n := nr0 ELSE n := MAXR END;
    FOR i := 0 TO 10 DO cate[i] := 0 END;
    adanc := 0; maxAdanc := 0; erori := 0; primaEroare := -1;
    acordBloc[0] := 0; acordCurent := -1; idxInBloc := 0; inComentariu := FALSE; indentUnit := 0;
    IF stil = INDENTARE THEN
      FOR i := 0 TO n - 1 DO
        IF Rand(text, i, linie) THEN
          s := 0; WHILE linie[s] = " " DO INC(s) END;
          IF (s > 0) & (s < T.Len(linie)) & ((indentUnit = 0) OR (s < indentUnit)) THEN indentUnit := s END
        END
      END;
      IF indentUnit = 0 THEN indentUnit := 4 END
    END;
    t := 0; baza := 60;
    i := 0;
    WHILE i < n DO
      IF ~Rand(text, i, linie) THEN   (* date: un bas lung si o cvinta goala, atat *)
        Te.Ev(baza - 24, t, 20000, 2); Te.Ev(baza - 17, t, 20000, 1); t := t + 20000; acordCurent := -1
      ELSE
        T.Copy(linie, tr); T.Trim(tr);
        inainte := adanc; deschise := 0; inchise := 0; inchiseLaInceput := 0; inceput := TRUE;
        IF stil = INDENTARE THEN
          IF (tr[0] # 0X) & (tr[0] # "#") THEN
            s := 0; WHILE (linie[s] = " ") OR (linie[s] = 9X) DO INC(s) END;
            niv := s DIV indentUnit;
            IF niv < inainte THEN inchiseLaInceput := inainte - niv; inchise := inchiseLaInceput END;
            adanc := niv; inainte := niv + inchiseLaInceput;
            IF T.Sfarsit(tr, ":") THEN deschise := 1 END
          END
        ELSE
          (* numara deschiderile / inchiderile, sarind peste siruri si comentarii *)
          sir := 0X; m := 0; k := 0; len := T.Len(linie);
          WHILE k < len DO
            c := linie[k]; IF k + 1 < len THEN d := linie[k + 1] ELSE d := 0X END;
            IF inComentariu THEN
              IF (c = "*") & (d = "/") & (stil # OBERON) OR (c = "*") & (d = ")") & (stil = OBERON) THEN inComentariu := FALSE; INC(k) END
            ELSIF sir # 0X THEN IF c = "\" THEN INC(k) ELSIF c = sir THEN sir := 0X END
            ELSIF (c = 22X) OR (c = "'") OR (c = "`") THEN sir := c; inceput := FALSE
            ELSIF (c = "/") & (d = "/") THEN k := len
            ELSIF (c = "#") & (stil = ACOLADE) & ((k = 0) OR Alb(linie[k - 1]) OR (linie[k - 1] = ";")) THEN k := len
            ELSIF (c = "/") & (d = "*") & (stil # OBERON) OR (c = "(") & (d = "*") & (stil = OBERON) THEN inComentariu := TRUE; INC(k)
            ELSE
              IF stil = ACOLADE THEN
                IF c = "{" THEN INC(deschise); inceput := FALSE
                ELSIF c = "}" THEN INC(inchise); IF inceput THEN INC(inchiseLaInceput) END
                ELSIF ~Alb(c) THEN inceput := FALSE
                END
              END;
              cod[m] := c; INC(m)
            END;
            INC(k)
          END;
          cod[m] := 0X;
          IF stil = OBERON THEN
            (* \b([A-Z]+)\b: cuvintele scrise numai cu majuscule *)
            ePrimul := TRUE; k := 0;
            WHILE k < m DO
              IF T.Cuv(cod[k]) & ((k = 0) OR ~T.Cuv(cod[k - 1])) THEN
                j := k; WHILE (j < m) & T.Cuv(cod[j]) DO INC(j) END;
                s := k; WHILE (s < j) & (cod[s] >= "A") & (cod[s] <= "Z") DO INC(s) END;
                IF s = j THEN
                  T.Sub(cod, k, j, w0);
                  IF In(w0, " IF WHILE FOR CASE RECORD PROCEDURE MODULE WITH LOOP ") THEN
                    IF T.Eq(w0, "PROCEDURE") THEN
                      T.Sub(cod, 0, k, ant); T.Trim(ant); T.Sub(cod, j, m, dup); T.Trim(dup);
                      IF T.Sfarsit(ant, "=") OR T.Sfarsit(ant, ":") OR T.Sfarsit(ant, ",") OR T.Sfarsit(ant, "TO") OR T.Sfarsit(ant, "(") OR T.Incepe(dup, "^") THEN
                        ePrimul := FALSE; w0[0] := 0X   (* tip procedura si declaratie inainte: n-au END *)
                      END
                    END;
                    IF w0[0] # 0X THEN INC(deschise) END
                  ELSIF T.Eq(w0, "REPEAT") THEN INC(deschise)
                  ELSIF T.Eq(w0, "END") OR T.Eq(w0, "UNTIL") THEN INC(inchise); IF ePrimul THEN INC(inchiseLaInceput) END
                  END;
                  ePrimul := FALSE
                END;
                k := j
              ELSE INC(k)
              END
            END
          END;
          adanc := inainte + deschise - inchise
        END;

        IF inComentariu & (tr[0] = 0X) THEN fel := GOL ELSE fel := Fel(tr, stil, deschise > inchise) END;
        IF (fel = ALTUL) & (stil = ACOLADE) & T.Contine(tr, "(") & T.Contine(tr, ")") & ~T.Sfarsit(tr, ";") THEN   (* Limbo/C: nume(...) apoi { *)
          j := i + 1; ePrimul := TRUE;
          WHILE ePrimul & (j < n) DO
            IF Rand(text, j, w0) THEN T.Trim(w0); IF w0[0] = 0X THEN INC(j) ELSE ePrimul := FALSE END
            ELSE ePrimul := FALSE; w0[0] := 0X   (* randul de date: Java il vede ca „\u00001…”, nu e gol *)
            END
          END;
          IF ~ePrimul & (j < n) & T.Eq(w0, "{") THEN fel := DEF END
        END;
        IF inComentariu & (fel # GOL) & ~T.Incepe(tr, "/*") & ~T.Incepe(tr, "(*") THEN fel := COMENT END;
        INC(cate[fel]);
        dLinie := inainte - inchiseLaInceput; IF dLinie < 0 THEN dLinie := 0 END;

        IF adanc < 0 THEN   (* s-a inchis ceva ce nu era deschis *)
          INC(erori); IF primaEroare < 0 THEN primaEroare := i + 1 END;
          Te.Ev(baza + 11, t, 10000, 1); Te.Ev(baza + 12, t, 10000, 1); Te.Ev(baza - 13, t, 10000, 2);
          t := t + 10000; adanc := 0
        ELSE
          IF adanc > maxAdanc THEN maxAdanc := adanc END; IF dLinie > maxAdanc THEN maxAdanc := dLinie END;
          IF fel = GOL THEN t := t + 2500
          ELSE
            IF ACORD[fel] >= 0 THEN acord := ACORD[fel] ELSIF dLinie < 63 THEN acord := acordBloc[dLinie] ELSE acord := acordBloc[63] END;
            IF T.Len(tr) > 50 THEN dur := 10000 ELSE dur := 5000 END;
            IF fel = COMENT THEN
              m := baza + 24 + Semi(acord + 2 * (i MOD 3));
              Te.Ev(m, t, 5000, 1); t := t + 5000
            ELSE
              IF acord # acordCurent THEN   (* acord nou: basul si acompaniamentul *)
                bas := baza - 24 + Semi(acord);
                IF dur > 10000 THEN Te.Ev(bas, t, dur, 2) ELSE Te.Ev(bas, t, 10000, 2) END;
                FOR k := 0 TO 2 DO IF dur > 10000 THEN Te.Ev(baza - 12 + Semi(acord + 2 * k), t, dur, 1) ELSE Te.Ev(baza - 12 + Semi(acord + 2 * k), t, 10000, 1) END END;
                acordCurent := acord; idxInBloc := 0
              END;
              IF dLinie < 5 THEN nivel := dLinie ELSE nivel := 5 END;
              grad := acord + 2 * nivel; IF fel = ALTUL THEN grad := grad + 2 * (idxInBloc MOD 3) END;
              nota := baza + Semi(grad);
              WHILE nota > baza + 26 DO nota := nota - 12 END;
              IF fel = RET THEN   (* cadenta: dominanta scurta, apoi tonica *)
                Te.Ev(baza - 24 + Semi(4), t, 5000, 2); Te.Ev(baza + Semi(4 + 2 * nivel), t, 5000, 0); t := t + 5000;
                Te.Ev(baza - 24, t, 10000, 2); Te.Ev(baza + Semi(2 * nivel), t, 10000, 0); t := t + 10000;
                acordCurent := 0
              ELSIF fel = INCHIDE THEN
                k := adanc; IF k < 0 THEN k := 0 END; IF k > 63 THEN parinte := acordBloc[63] ELSE parinte := acordBloc[k] END;
                IF k > 5 THEN k := 5 END;
                nota := baza + Semi(parinte + 2 * k);
                WHILE nota > baza + 26 DO nota := nota - 12 END;
                IF adanc = 0 THEN   (* sfarsit de functie / clasa: V -> I *)
                  Te.Ev(baza - 24 + Semi(4), t, 5000, 2); Te.Ev(baza + Semi(1), t, 5000, 0); t := t + 5000;
                  Te.Ev(baza - 24, t, 15000, 2);
                  FOR k := 0 TO 2 DO Te.Ev(baza - 12 + Semi(2 * k), t, 15000, 1) END;
                  Te.Ev(baza, t, 15000, 0); t := t + 15000;
                  acordCurent := 0
                ELSE Te.Ev(nota, t, 5000, 0); t := t + 5000; acordCurent := -1
                END
              ELSE
                Te.Ev(nota, t, dur * 95 DIV 100, 0); t := t + dur; INC(idxInBloc);
                IF adanc > dLinie THEN   (* blocul deschis de randul asta isi tine acordul *)
                  k := dLinie + 1; WHILE (k <= adanc) & (k <= 63) DO acordBloc[k] := acord; INC(k) END
                END
              END
            END
          END
        END
      END;
      INC(i)
    END;

    o := "Am cântat „"; IF areNume THEN T.Add(o, nume) ELSE T.Add(o, "codul") END; T.Add(o, "”: "); Nr(o, n, "rând", "rânduri");
    IF nr0 > n THEN T.Add(o, " (din "); T.AddInt(o, nr0); T.Add(o, "; restul le-am sărit)") END;
    IF date > 0 THEN T.Add(o, ", plus "); Nr(o, date, "rând", "rânduri"); T.Add(o, " de date (base64) pe care nu le-am cântat — se aud ca un singur bas lung") END;
    T.Add(o, ", ");
    IF stil = ACOLADE THEN T.Add(o, "cu acolade") ELSIF stil = OBERON THEN T.Add(o, "Oberon/Pascal (BEGIN…END)") ELSE T.Add(o, "pe indentare") END;
    T.Add(o, ", adâncimea maximă "); T.AddInt(o, maxAdanc); T.Add(o, "."); T.AddCh(o, 0AX);
    st := "";
    FOR k := 0 TO 9 DO
      IF (cate[k] > 0) & (k # INCHIDE) THEN IF st[0] # 0X THEN T.Add(st, ", ") END; Nr(st, cate[k], UNU[k], NUME[k]) END
    END;
    T.Add(o, st); T.Add(o, "."); T.AddCh(o, 0AX);
    IF erori > 0 THEN
      T.Add(o, "⚠ La rândul "); T.AddInt(o, primaEroare); T.Add(o, " se închide ceva ce nu era deschis — se aude ca o secundă mică (");
      Nr(o, erori, "dată", "dăți"); T.Add(o, ")."); T.AddCh(o, 0AX)
    END;
    IF nr0 > n THEN
      T.Add(o, "M-am oprit la rândul "); T.AddInt(o, n); T.Add(o, ", în mijlocul codului, așa că nu judec dacă blocurile se închid.")
    ELSIF (adanc > 0) & (stil # INDENTARE) THEN
      T.Add(o, "⚠ La final au rămas ");
      IF stil = OBERON THEN Nr(o, adanc, "bloc fără END", "blocuri fără END") ELSE Nr(o, adanc, "acoladă deschisă", "acolade deschise") END;
      T.Add(o, " — de-asta se termină pe un acord diminuat care nu se rezolvă.");
      Te.Ev(baza - 24 + Semi(6), t, 40000, 2);
      FOR k := 0 TO 2 DO Te.Ev(baza - 12 + Semi(6 + 2 * k), t, 40000, 1) END;
      Te.Ev(baza + Semi(6 + 7), t, 40000, 0)
    ELSE
      IF erori = 0 THEN T.Add(o, "Toate blocurile se închid — se termină pe tonică.") ELSE T.Add(o, "La final se termină totuși pe tonică.") END;
      Te.Ev(baza - 24, t, 30000, 2);
      FOR k := 0 TO 2 DO Te.Ev(baza - 12 + Semi(2 * k), t, 30000, 1) END;
      Te.Ev(baza + 12, t, 30000, 0)
    END;
    T.AddCh(o, 0AX);
    T.Add(o, "(Cum se aude: adâncimea = cât de sus; definiție I, buclă vi, condiție V, else IV, import ii, try/erori vii°; return = cadență V→I; comentariile = note șoptite, sus.)");
    Te.PuneTxt(o)
  END Sonifica;

  PROCEDURE L(VAR s: ARRAY OF CHAR; r: ARRAY OF CHAR);
  BEGIN T.Add(s, r); T.AddCh(s, 0AX)
  END L;

  PROCEDURE Init;
    VAR i: INTEGER;
  BEGIN
    NUME[0] := "definiții"; NUME[1] := "bucle"; NUME[2] := "condiții"; NUME[3] := "else"; NUME[4] := "return"; NUME[5] := "erori/try";
    NUME[6] := "importuri"; NUME[7] := "comentarii"; NUME[8] := "închideri"; NUME[9] := "instrucțiuni"; NUME[10] := "goale";
    UNU[0] := "definiție"; UNU[1] := "buclă"; UNU[2] := "condiție"; UNU[3] := "else"; UNU[4] := "return"; UNU[5] := "eroare/try";
    UNU[6] := "import"; UNU[7] := "comentariu"; UNU[8] := "închidere"; UNU[9] := "instrucțiune"; UNU[10] := "goală";
    ACORD[0] := 0; ACORD[1] := 5; ACORD[2] := 4; ACORD[3] := 3; ACORD[4] := 0; ACORD[5] := 6; ACORD[6] := 1;
    FOR i := 7 TO 10 DO ACORD[i] := -1 END;
    MAJ[0] := 0; MAJ[1] := 2; MAJ[2] := 4; MAJ[3] := 5; MAJ[4] := 7; MAJ[5] := 9; MAJ[6] := 11;
    EXEMPLU := "";
    L(EXEMPLU, "import java.util.*;"); L(EXEMPLU, ""); L(EXEMPLU, "class Cub {"); L(EXEMPLU, "    // un cub 7x7x7");
    L(EXEMPLU, "    int[][][] v = new int[7][7][7];"); L(EXEMPLU, ""); L(EXEMPLU, "    int suma() {"); L(EXEMPLU, "        int s = 0;");
    L(EXEMPLU, "        for (int x = 0; x < 7; x++) {"); L(EXEMPLU, "            for (int y = 0; y < 7; y++) {");
    L(EXEMPLU, "                for (int z = 0; z < 7; z++) {"); L(EXEMPLU, "                    if (v[x][y][z] > 0) {");
    L(EXEMPLU, "                        s += v[x][y][z];"); L(EXEMPLU, "                    } else {"); L(EXEMPLU, "                        s += 1;");
    L(EXEMPLU, "                    }"); L(EXEMPLU, "                }"); L(EXEMPLU, "            }"); L(EXEMPLU, "        }");
    L(EXEMPLU, "        return s;"); L(EXEMPLU, "    }"); L(EXEMPLU, "}");
    GRESIT := "";
    L(GRESIT, "class Cub {"); L(GRESIT, "    int suma() {"); L(GRESIT, "        int s = 0;"); L(GRESIT, "        for (int x = 0; x < 7; x++) {");
    L(GRESIT, "            if (x > 3) {"); L(GRESIT, "                s += x;"); L(GRESIT, "        }"); L(GRESIT, "        return s;"); L(GRESIT, "    }")
  END Init;

BEGIN
  Init
END E7Sonor.

MODULE E7Synth; (* Eula Music in Oberon: sintetizatorul, ca Sunet.java. Randeaza evenimentele lui E7Teorie in PCM mono
  (22050 pe secunda), cu trei instrumente (Pian, FM, Coarda) si un reverb Schroeder mic; apoi il dubleaza la 44100
  pentru Sunet.Reda. REAL e pe 32 de biti, asa ca faza fiecarei sinusoide se tine ca intreg (fractiunea unei ture
  pe 32 de biti, i * pas, exact), iar pasul pentru fiecare nota midi vine dintr-un tabel facut din Java.
  Coarda (Karplus-Strong) foloseste acelasi zgomot ca java.util.Random(7). Pion & Claude, 21.10.2026 *)

  IMPORT Math, Sunet, Te := E7Teorie;

  CONST SR* = 22050; MAXS* = 4000000; MAXK = 1400000; DOI = 6.2831855; F32 = 2.3283064E-10;

  TYPE Buf = POINTER TO BufDesc; BufDesc = RECORD a: ARRAY MAXS OF REAL END;
    Mare = POINTER TO MareDesc; MareDesc = RECORD a: ARRAY 2 * MAXS OF REAL END;
    Kb = POINTER TO KbDesc; KbDesc = RECORD a: ARRAY MAXK OF REAL END;

  VAR o: Buf; n*: INTEGER; dublu: Mare; nd*: INTEGER; kb: Kb;
    inc, kp: ARRAY 240 OF INTEGER;
    s0, s1, s2, s3: INTEGER;   (* samanta lui java.util.Random, 4 bucati de 12 biti *)
    INSTR*: ARRAY 3 OF ARRAY 8 OF CHAR;
    cb0, cb1, cb2, cb3, ab0, ab1: ARRAY 700 OF REAL;
    taiat*: BOOLEAN;   (* piesa a fost mai lunga decat incape *)

  (* ---------- java.util.Random ---------- *)

  PROCEDURE Seed7;   (* new Random(7) *)
  BEGIN s0 := 1642; s1 := 3790; s2 := 1502; s3 := 0
  END Seed7;

  PROCEDURE Next(bits: INTEGER): INTEGER;
    VAR r0, r1, r2, r3, c: INTEGER;
  BEGIN
    r0 := s0 * 1645 + 11; c := r0 DIV 4096; r0 := r0 MOD 4096;
    r1 := s0 * 3790 + s1 * 1645 + c; c := r1 DIV 4096; r1 := r1 MOD 4096;
    r2 := s0 * 1502 + s1 * 3790 + s2 * 1645 + c; c := r2 DIV 4096; r2 := r2 MOD 4096;
    r3 := (s1 * 1502 + s2 * 3790 + s3 * 1645 + c) MOD 4096;
    s0 := r0; s1 := r1; s2 := r2; s3 := r3;
    IF bits = 26 THEN r0 := s3 * 16384 + s2 * 4 + s1 DIV 1024 ELSE r0 := s3 * 32768 + s2 * 8 + s1 DIV 512 END;
    RETURN r0
  END Next;

  PROCEDURE Zgomot(): REAL;   (* (float) (rnd.nextDouble() * 2 - 1) *)
    VAR a, b: INTEGER;
  BEGIN
    a := Next(26); b := Next(27);
    RETURN (FLT(a - 33554432) * 134217728.0 + FLT(b)) * 2.220446E-16
  END Zgomot;

  (* ---------- vocile ---------- *)

  PROCEDURE Frac(ph: INTEGER): REAL;   (* faza pe 32 de biti -> [0, 1) *)
    VAR x: REAL;
  BEGIN x := FLT(ph) * F32; IF x < 0.0 THEN x := x + 1.0 END; RETURN x
  END Frac;

  PROCEDURE Sin(ph: INTEGER): REAL;
  BEGIN RETURN Math.sin(DOI * Frac(ph))
  END Sin;

  PROCEDURE Min1(x: REAL): REAL;
  BEGIN IF x > 1.0 THEN x := 1.0 END; RETURN x
  END Min1;

  PROCEDURE Voce(a, len, rel, m, instr: INTEGER; amp: REAL);
    VAR i, h, p, k, k2, pas, j: INTEGER; t, att, rl, x, f, idx, env: REAL; st: ARRAY 7 OF INTEGER; dec: ARRAY 7 OF REAL;
  BEGIN
    pas := inc[m + 108];
    IF instr = 2 THEN   (* coarda: Karplus-Strong *)
      p := kp[m + 108];
      IF p > MAXK THEN p := MAXK END;
      IF kb = NIL THEN NEW(kb) END;
      FOR i := 0 TO p - 1 DO kb.a[i] := Zgomot() END;
      k := 0; i := 0;
      WHILE (i < len) & (a + i < n) DO
        x := kb.a[k];
        k2 := (k + 1) MOD p;
        kb.a[k] := 0.4985 * (kb.a[k] + kb.a[k2]);
        k := k2;
        IF i < rel THEN env := 1.0 ELSE env := Math.exp(-FLT(i - rel) / (0.08 * FLT(SR))) END;
        o.a[a + i] := o.a[a + i] + amp * x * env;
        INC(i)
      END
    ELSE
      f := FLT(pas) * F32; IF f < 0.0 THEN f := f + 1.0 END;   (* ture pe esantion *)
      FOR h := 1 TO 6 DO   (* pianul: armonica h, intinsa cu 0.0004 h^2 *)
        st[h] := pas * h + FLOOR(f * 0.0004 * FLT(h * h * h) * 4294967296.0 + 0.5);
        dec[h] := 1.2 + 1.6 * FLT(h)
      END;
      i := 0;
      WHILE (i < len) & (a + i < n) DO
        t := FLT(i) / FLT(SR);
        att := Min1(t / 0.006);
        IF i < rel THEN rl := 1.0 ELSE rl := Math.exp(-FLT(i - rel) / (0.09 * FLT(SR))) END;
        IF instr = 0 THEN   (* pian: armonice care se sting repede *)
          x := 0.0;
          FOR h := 1 TO 6 DO j := i * st[h]; x := x + Sin(j) * Math.exp(-t * dec[h]) / FLT(h) END
        ELSE   (* FM: purtator + modulator 2:1, indicele scade *)
          idx := 2.6 * Math.exp(-t * 3.5) + 0.3;
          x := Math.sin(DOI * Frac(i * pas) + idx * Sin(i * pas * 2)) * Math.exp(-t * 1.4)
        END;
        o.a[a + i] := o.a[a + i] + amp * att * rl * x;
        INC(i)
      END
    END
  END Voce;

  PROCEDURE Pad(a, len, rel, m: INTEGER; amp: REAL);
    VAR i, pas: INTEGER; t, env, x: REAL;
  BEGIN
    pas := inc[m + 108]; i := 0;
    WHILE (i < len) & (a + i < n) DO
      t := FLT(i) / FLT(SR);
      env := Min1(t / 0.12);
      IF i >= rel THEN env := env * Math.exp(-FLT(i - rel) / (0.12 * FLT(SR))) END;
      x := Sin(i * pas) + 0.3 * Sin(i * pas * 2) + 0.12 * Sin(i * pas * 3);
      o.a[a + i] := o.a[a + i] + amp * env * x;
      INC(i)
    END
  END Pad;

  PROCEDURE Bas(a, len, rel, m: INTEGER; amp: REAL);
    VAR i, pas: INTEGER; t, env, x: REAL;
  BEGIN
    pas := inc[m + 108]; i := 0;
    WHILE (i < len) & (a + i < n) DO
      t := FLT(i) / FLT(SR);
      env := Min1(t / 0.01) * Math.exp(-t * 0.8);
      IF i >= rel THEN env := env * Math.exp(-FLT(i - rel) / (0.06 * FLT(SR))) END;
      x := Sin(i * pas) + 0.5 * Sin(i * pas * 2) + 0.2 * Sin(i * pas * 3);
      o.a[a + i] := o.a[a + i] + amp * env * x;
      INC(i)
    END
  END Bas;

  PROCEDURE Reverb;
    VAR i, k: INTEGER; in, s, y, b: REAL; ci, cl: ARRAY 4 OF INTEGER; cf: ARRAY 4 OF REAL; ai, al: ARRAY 2 OF INTEGER;
  BEGIN
    cl[0] := 1116 DIV 2; cl[1] := 1188 DIV 2; cl[2] := 1277 DIV 2; cl[3] := 1356 DIV 2; al[0] := 556 DIV 2; al[1] := 441 DIV 2;
    FOR k := 0 TO 3 DO ci[k] := 0; cf[k] := 0.0 END; ai[0] := 0; ai[1] := 0;
    FOR i := 0 TO 699 DO cb0[i] := 0.0; cb1[i] := 0.0; cb2[i] := 0.0; cb3[i] := 0.0; ab0[i] := 0.0; ab1[i] := 0.0 END;
    FOR i := 0 TO n - 1 DO
      in := o.a[i]; s := 0.0;
      y := cb0[ci[0]]; cf[0] := y * 0.75 + cf[0] * 0.25; cb0[ci[0]] := in + cf[0] * 0.80; ci[0] := (ci[0] + 1) MOD cl[0]; s := s + y;
      y := cb1[ci[1]]; cf[1] := y * 0.75 + cf[1] * 0.25; cb1[ci[1]] := in + cf[1] * 0.80; ci[1] := (ci[1] + 1) MOD cl[1]; s := s + y;
      y := cb2[ci[2]]; cf[2] := y * 0.75 + cf[2] * 0.25; cb2[ci[2]] := in + cf[2] * 0.80; ci[2] := (ci[2] + 1) MOD cl[2]; s := s + y;
      y := cb3[ci[3]]; cf[3] := y * 0.75 + cf[3] * 0.25; cb3[ci[3]] := in + cf[3] * 0.80; ci[3] := (ci[3] + 1) MOD cl[3]; s := s + y;
      s := s * 0.25;
      b := ab0[ai[0]]; y := -s + b; ab0[ai[0]] := s + b * 0.5; ai[0] := (ai[0] + 1) MOD al[0]; s := y;
      b := ab1[ai[1]]; y := -s + b; ab1[ai[1]] := s + b * 0.5; ai[1] := (ai[1] + 1) MOD al[1]; s := y;
      o.a[i] := in * 0.78 + s * 0.32
    END
  END Reverb;

  (* esantionul de la x batai (zece-miimi) la bpm: floor(x * 60 / bpm * 22050 / 10000), exact *)
  PROCEDURE Es(x, bpm: INTEGER): INTEGER;
    VAR q, r: INTEGER;
  BEGIN q := x DIV (10 * bpm); r := x MOD (10 * bpm); RETURN q * 1323 + r * 1323 DIV (10 * bpm)
  END Es;

  (* randeaza evenimentele lui E7Teorie: o.a[0..n) la 22050, scara +-1 *)
  PROCEDURE Randeaza*(bpm, instr: INTEGER);
    VAR i, fin, a, rel, len, m: INTEGER; p, x: REAL;
  BEGIN
    IF o = NIL THEN NEW(o) END;
    fin := 0; FOR i := 0 TO Te.nev - 1 DO IF Te.et[i] + Te.ed[i] > fin THEN fin := Te.et[i] + Te.ed[i] END END;
    n := Es(fin, bpm) + 55125; taiat := FALSE;
    IF n > MAXS THEN n := MAXS; taiat := TRUE END;
    FOR i := 0 TO n - 1 DO o.a[i] := 0.0 END;
    Seed7;
    FOR i := 0 TO Te.nev - 1 DO
      a := Es(Te.et[i], bpm); rel := Es(Te.ed[i], bpm); m := Te.em[i];
      IF (m >= -108) & (m <= 131) & (a < n) THEN
        IF Te.ev[i] = 0 THEN
          IF instr = 0 THEN len := rel + 19845 ELSE len := rel + 13230 END;
          Voce(a, len, rel, m, instr, 0.42)
        ELSIF Te.ev[i] = 1 THEN Pad(a, rel + 8820, rel, m, 0.11)
        ELSE Bas(a, rel + 6615, rel, m, 0.30)
        END
      END
    END;
    Reverb;
    p := 0.0; FOR i := 0 TO n - 1 DO x := ABS(o.a[i]); IF x > p THEN p := x END END;
    IF p > 0.0 THEN p := 0.9 / p; FOR i := 0 TO n - 1 DO o.a[i] := o.a[i] * p END END
  END Randeaza;

  PROCEDURE Esantion*(i: INTEGER): REAL;
  BEGIN RETURN o.a[i]
  END Esantion;

  (* pentru Sunet.Reda: 44100 pe secunda, pe scara de 16 biti (interpolare liniara intre esantioane) *)
  PROCEDURE Dubleaza*;
    VAR i: INTEGER;
  BEGIN
    IF dublu = NIL THEN NEW(dublu) END;
    FOR i := 0 TO n - 2 DO dublu.a[2 * i] := o.a[i] * 32767.0; dublu.a[2 * i + 1] := (o.a[i] + o.a[i + 1]) * 16383.5 END;
    IF n > 0 THEN dublu.a[2 * n - 2] := o.a[n - 1] * 32767.0; dublu.a[2 * n - 1] := 0.0 END;
    nd := 2 * n
  END Dubleaza;

  PROCEDURE Canta*;   (* opreste ce suna si da piesa randata la Sunet (44100, 16 biti) *)
  BEGIN
    Dubleaza; Sunet.Liniste;
    IF nd > 0 THEN Sunet.Reda(dublu.a, nd, 30) END   (* 30: Sunet din Eula taie varfurile (x / (1 + |x|)); asa ramane curat *)
  END Canta;

