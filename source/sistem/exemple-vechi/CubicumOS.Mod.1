      ELSE Buton(x, y, w, h, obt[i], Am(200, 169, 110, 0.1), cGold, Am(200, 169, 110, 0.3))
      END
    END;
    IF acum < mesajPana THEN Ecran.Culoare(cGreen); TC(bx + bw DIV 2, oBtnY + D(56), D(11), mesaj)
    ELSE
      s := "CRDA v11 · Z₇ · 343 noduri · aprinse: "; Strings.AppendInt(Aprinse(), 0, s);
