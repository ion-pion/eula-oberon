  END ShellB;

  PROCEDURE Shell;
    VAR i, lh, k, x, y, w, h, prY, jos, viz, sc, start: INTEGER;
  BEGIN
    lh := D(17);
    ShellB(0, x, y, w, h); prY := y - D(14);
    Ecran.Culoare(Ecran.RGB(58, 58, 92)); Ecran.Grosime(G1); Ecran.Linie(bx, prY - D(22), bx + bw, prY - D(22));
    Ecran.Culoare(cGold); T(bx, prY, D(13), "Z₇ >");
    Ecran.Culoare(cGreen); T(bx + D(42), prY, D(12), ultimaCmd);
    IF acum DIV 500 MOD 2 = 0 THEN T(bx + D(42) + Lat(ultimaCmd, D(12)) + D(3), prY, D(12), "▌") END;
    jos := prY - D(30);
    viz := (jos - by) DIV lh;
    sc := scroll[3] DIV lh;
    IF sc > nsl - viz THEN sc := nsl - viz END; IF sc < 0 THEN sc := 0 END;
    scroll[3] := sc * lh;
    start := nsl - viz - sc; IF start < 0 THEN start := 0 END;
    i := start;
    WHILE (i < nsl) & (i < start + viz) DO
      Ecran.Culoare(slc[i]); T(bx, by + (i - start + 1) * lh, D(12), sl[i]); INC(i)
    END;
    IF sc > 0 THEN Ecran.Culoare(cDim); TD(bx + bw, by + D(12), D(10), "↓ trage în jos / sus") END;
    FOR k := 0 TO 9 DO
      ShellB(k, x, y, w, h); Buton(x, y, w, h, cmd[k], Am(200, 169, 110, 0.1), cGold, Am(200, 169, 110, 0.3))
    END
  END Shell;

  PROCEDURE VM;
    VAR i, g, w, h, x, y, top, cs, gr: INTEGER; s: ARRAY 8 OF CHAR;
  BEGIN
    IF acum - ultimVm >= 600 THEN
      ultimVm := acum;
      FOR i := 0 TO 6 DO IF i MOD 3 = 0 THEN reg[i] := (reg[i] + 1) MOD 7 END END;
      IF Rnd(10) < 4 THEN vmAct := Rnd(49); mem[vmAct] := Rnd(7) ELSE vmAct := -1 END
    END;
    g := D(6); w := (bw - 6 * g) DIV 7; h := D(48);
    FOR i := 0 TO 6 DO
      x := bx + i * (w + g);
      Ecran.Culoare(Am(139, 92, 246, 0.1)); Ecran.Dreptunghi(x, by, w, h);
      Ecran.Culoare(Am(139, 92, 246, 0.3)); Ecran.Grosime(G1); Contur(x, by, w, h);
      s := "R"; Strings.AppendInt(i, 0, s); Ecran.Culoare(cPurple); TC(x + w DIV 2, by + D(16), D(10), s);
      s := ""; Strings.AppendInt(reg[i], 0, s); Ecran.Culoare(cCyan); TC(x + w DIV 2, by + D(39), D(17), s)
    END;
    top := by + h + D(34);
    Ecran.Culoare(cGold); T(bx, top - D(10), D(13), "MEM[7×7] · 49 celule");
    gr := D(4); cs := (bw - 6 * gr) DIV 7;
    IF (by + bh - top - 6 * gr) DIV 7 < cs THEN cs := (by + bh - top - 6 * gr) DIV 7 END;
    FOR i := 0 TO 48 DO
      x := bx + (i MOD 7) * (cs + gr); y := top + (i DIV 7) * (cs + gr);
      s := ""; Strings.AppendInt(mem[i], 0, s);
      IF i = vmAct THEN
        Ecran.Culoare(Am(57, 255, 20, 0.15)); Ecran.Dreptunghi(x, y, cs, cs);
        Ecran.Culoare(cGreen); Contur(x, y, cs, cs); TC(x + cs DIV 2, y + cs DIV 2 + D(5), D(13), s)
      ELSE
        Ecran.Culoare(Am(200, 169, 110, 0.15)); Contur(x, y, cs, cs);
        Ecran.Culoare(cText); TC(x + cs DIV 2, y + cs DIV 2 + D(5), D(13), s)
      END
    END
  END VM;

