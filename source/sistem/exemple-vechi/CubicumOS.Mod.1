  PROCEDURE Procese;
    VAR i, y, x1, x2, x3, lb, f, rh: INTEGER; s: ARRAY 16 OF CHAR; v: REAL;
  BEGIN
    IF acum - ultimProc >= 1200 THEN
      ultimProc := acum;
      FOR i := 0 TO NPR - 1 DO
        v := FLT(pcpu0[i]) + (RndR() - 0.5) * 4.0;
        IF v < 1.0 THEN v := 1.0 ELSIF v > 99.0 THEN v := 99.0 END;
        pcpu[i] := v
      END
    END;
    MemCfs(pmem[2]);
    x1 := bx + bw * 52 DIV 100; x2 := bx + bw * 64 DIV 100; x3 := bx + bw;
    y := by + D(16);
    Ecran.Culoare(cGold); T(bx, y, D(11), "PROCES"); T(x1, y, D(11), "PID"); T(x2, y, D(11), "CPU%"); TD(x3, y, D(11), "MEM(MB)");
    Ecran.Culoare(Ecran.RGB(58, 58, 92)); Ecran.Grosime(G1); Ecran.Linie(bx, y + D(8), x3, y + D(8));
    rh := D(32); y := y + D(8);
    FOR i := 0 TO NPR - 1 DO
      y := y + rh;
      Ecran.Culoare(cCyan); T(bx, y, D(12), pnume[i]);
      Ecran.Culoare(Am(200, 200, 232, 0.6)); s := ""; Strings.AppendInt(ppid[i], 0, s); T(x1, y, D(12), s);
      lb := bw * 22 DIV 100;
      Ecran.Culoare(cBg2); Ecran.Dreptunghi(x2, y - D(9), lb, D(8));
      f := FLOOR(pcpu[i] * FLT(lb) / 100.0); IF f < 2 THEN f := 2 END;
      Ecran.Culoare(cGreen); Ecran.Dreptunghi(x2, y - D(9), f DIV 2 + 1, D(8));
      Ecran.Culoare(cCyan); Ecran.Dreptunghi(x2 + f DIV 2, y - D(9), f - f DIV 2, D(8));
      Ecran.Culoare(cPurple); TD(x3, y, D(11), pmem[i])
    END;
    Ecran.Culoare(Ecran.RGB(58, 58, 92)); T(bx, y + D(34), D(10), "cubicum.fs: 8 rădăcini, de aceea pid 8")
  END Procese;

  PROCEDURE Retea;
    VAR i, j, k, cx, cy, r, x, y, c: INTEGER; nx, ny: ARRAY 7 OF INTEGER; ang: REAL; activ: BOOLEAN; s: ARRAY 40 OF CHAR;
  BEGIN
    cx := bx + bw DIV 2; cy := by + bh DIV 2 - D(10); r := Min(bw, bh) * 65 DIV 200;
    FOR i := 0 TO 6 DO
      ang := FLT(i) / 7.0 * Math.pi * 2.0 - Math.pi / 2.0;
      nx[i] := cx + FLOOR(Math.cos(ang) * FLT(r)); ny[i] := cy + FLOOR(Math.sin(ang) * FLT(r))
    END;
    Ecran.Culoare(Am(200, 169, 110, 0.15)); Ecran.Grosime(G1);
    FOR i := 0 TO 5 DO FOR j := i + 1 TO 6 DO Ecran.Linie(nx[i], ny[i], nx[j], ny[j]) END END;
    (* un pachet nou din cand in cand (3% pe cadru, ca in HTML) *)
    IF (npk < NP) & (Rnd(10000) < FLOOR(300.0 * FLT(dt) / 16.7)) THEN
      pkF[npk] := Rnd(7); pkT[npk] := (pkF[npk] + 1 + Rnd(6)) MOD 7; pkU[npk] := 0.0;
      IF Rnd(10) < 3 THEN pkC[npk] := cGreen ELSE pkC[npk] := cCyan END;
      INC(npk)
    END;
    k := 0;
    FOR i := 0 TO npk - 1 DO
      pkU[i] := pkU[i] + 0.018 * FLT(dt) / 16.7;
      IF pkU[i] <= 1.0 THEN pkF[k] := pkF[i]; pkT[k] := pkT[i]; pkU[k] := pkU[i]; pkC[k] := pkC[i]; INC(k) END
    END;
    npk := k;
    FOR i := 0 TO npk - 1 DO
      x := nx[pkF[i]] + FLOOR(FLT(nx[pkT[i]] - nx[pkF[i]]) * pkU[i]);
      y := ny[pkF[i]] + FLOOR(FLT(ny[pkT[i]] - ny[pkF[i]]) * pkU[i]);
      Ecran.Culoare(pkC[i]); Ecran.Disc(x, y, D(3));
      IF pkC[i] = cGreen THEN c := Am(57, 255, 20, 0.3) ELSE c := Am(0, 212, 255, 0.3) END;
      Ecran.Culoare(c); Ecran.Cerc(x, y, D(6))
    END;
    FOR i := 0 TO 6 DO
      activ := FALSE;
      FOR k := 0 TO npk - 1 DO IF (pkF[k] = i) OR (pkT[k] = i) & (pkU[k] > 0.9) THEN activ := TRUE END END;
      IF activ THEN Ecran.Culoare(Am(57, 255, 20, 0.3)) ELSE Ecran.Culoare(Am(200, 169, 110, 0.1)) END;
      Ecran.Disc(nx[i], ny[i], D(13));
      Ecran.Grosime(G1);
      IF activ THEN Ecran.Culoare(cGreen) ELSE Ecran.Culoare(Am(200, 169, 110, 0.5)) END;
      Ecran.Cerc(nx[i], ny[i], D(13));
      IF activ THEN Ecran.Culoare(cGreen) ELSE Ecran.Culoare(cGold) END;
      TC(nx[i], ny[i] + D(4), D(11), netEt[i])
    END;
    s := "7 noduri · Z₇ · pachete în zbor: "; Strings.AppendInt(npk, 0, s);
    Ecran.Culoare(Ecran.RGB(58, 58, 92)); TC(cx, by + bh - D(6), D(11), s)
  END Retea;

