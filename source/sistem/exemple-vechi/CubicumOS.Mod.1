  PROCEDURE Trilogie;
    VAR i, y: INTEGER;
  BEGIN
    IF scroll[6] > inalt[6] - bh THEN scroll[6] := inalt[6] - bh END;
    IF scroll[6] < 0 THEN scroll[6] := 0 END;
    y := by - scroll[6];
    FOR i := 0 TO 3 DO
      y := y + D(26); Ecran.Culoare(cGold); T(bx, y, D(22), trN[i]);
      Ecran.Culoare(cCyan); y := Paragraf(bx, y + D(2), D(17), bw, trT[i]);
      Ecran.Culoare(Am(200, 200, 232, 0.8)); y := Paragraf(bx, y + D(4), D(14), bw, trB[i]);
      Ecran.Culoare(cGreen); y := Paragraf(bx, y + D(2), D(12), bw, trZ[i]);
      y := y + D(16)
    END;
    inalt[6] := y + scroll[6] - by
  END Trilogie;

  PROCEDURE CfsB(k: INTEGER; VAR x, y, w, h: INTEGER);
  BEGIN
    w := (bw - D(8)) DIV 2; h := D(38);
    x := bx + k * (w + D(8)); y := by + bh - h
  END CfsB;

  PROCEDURE Cfs;
    VAR i, j, x, y, z, px, py, qx, qy, w, h, n, r: INTEGER; s, t: ARRAY 64 OF CHAR; c: ARRAY LC OF CHAR;
  BEGIN
    n := CFS.N();
    IF sel >= n THEN sel := -1 END;
    IF vede >= n THEN vede := -1 END;
    IF vede >= 0 THEN   (* vizualizatorul unui fisier *)
      CFS.Nume(vede, s); Ecran.Culoare(cGold2); T(bx, by + D(20), D(17), s);
      CFS.AdresaText(vede, t); s := "cfs://"; Strings.Append(t, s); Strings.Append(" · ", s);
      CFS.Nume(vede, t); CFS.NumeTip(CFS.Tip(t), t); Strings.Append(t, s);
      Strings.Append(" · rădăcina ◢ ", s); CFS.NumeRadacina(CFS.Radacina(vede), t); Strings.Append(t, s);
      Ecran.Culoare(cCyan); T(bx, by + D(42), D(11), s);
      Ecran.Culoare(Ecran.RGB(58, 58, 92)); Ecran.Linie(bx, by + D(52), bx + bw, by + D(52));
      CFS.Continut(vede, c); Ecran.Culoare(cText); y := Paragraf(bx, by + D(56), D(14), bw, c);
      CfsB(0, x, y, w, h); Buton(x, y, bw, h, "← ÎNAPOI LA CUB", Am(200, 169, 110, 0.1), cGold, Am(200, 169, 110, 0.3))
    ELSE
      (* cubul 7x7x7: celulele stinse, muchiile, cele 8 radacini, fisierele *)
      Ecran.Culoare(Am(100, 100, 160, 0.22));
      FOR i := 0 TO 342 DO Proiect(i MOD 7, i DIV 7 MOD 7, i DIV 49, cCx, cCy, cSt, px, py); Ecran.Disc(px, py, G1) END;
      Ecran.Culoare(Am(200, 169, 110, 0.35)); Ecran.Grosime(G1);
      FOR i := 0 TO 7 DO
        FOR j := 0 TO 2 DO
          r := 1; IF j = 1 THEN r := 2 ELSIF j = 2 THEN r := 4 END;
          IF i DIV r MOD 2 = 0 THEN
            Proiect(i MOD 2 * 6, i DIV 2 MOD 2 * 6, i DIV 4 * 6, cCx, cCy, cSt, px, py);
            Proiect((i + r) MOD 2 * 6, (i + r) DIV 2 MOD 2 * 6, (i + r) DIV 4 * 6, cCx, cCy, cSt, qx, qy);
            Ecran.Linie(px, py, qx, qy)
          END
        END
      END;
      FOR i := 0 TO 7 DO
        Proiect(i MOD 2 * 6, i DIV 2 MOD 2 * 6, i DIV 4 * 6, cCx, cCy, cSt, px, py);
        Ecran.Culoare(cGold); Ecran.Disc(px, py, D(3));
        CFS.NumeRadacina(i, s); Ecran.Culoare(Am(200, 169, 110, 0.55));
        IF px < cCx - D(4) THEN TD(px - D(6), py + D(4), D(9), s) ELSIF px > cCx + D(4) THEN T(px + D(6), py + D(4), D(9), s)
        ELSIF py < cCy THEN TC(px, py - D(6), D(9), s) ELSE TC(px, py + D(14), D(9), s)
        END
      END;
      FOR i := 0 TO n - 1 DO
        CFS.Adresa(i, x, y, z); Proiect(x, y, z, cCx, cCy, cSt, px, py);
        IF i = sel THEN
          Ecran.Culoare(cCyan); Ecran.Grosime(G1); Ecran.Cerc(px, py, D(9) + FLOOR(2.0 * Math.sin(FLT(acum) / 200.0) * dp));
          Ecran.Disc(px, py, D(5))
        ELSE Ecran.Culoare(cGold2); Ecran.Disc(px, py, D(4))
        END
      END;
      (* informatii *)
      s := ""; Strings.AppendInt(n, 0, s); Strings.Append(" fișiere · 7³ = 343 celule · Ash: ", s); Strings.AppendInt(CFS.NrAsh(), 0, s);
      Ecran.Culoare(cGold); TC(bx + bw DIV 2, lY0 - D(26), D(12), s);
      IF CFS.Scris() THEN Ecran.Culoare(Ecran.RGB(58, 58, 92)); TC(bx + bw DIV 2, lY0 - D(10), D(10), "adresa: x = numele · y = tipul · z = ziua (toate MOD 7)")
      ELSE Ecran.Culoare(cRed); TC(bx + bw DIV 2, lY0 - D(10), D(11), "nu pot scrie cubul pe disc!")
      END;
      (* lista *)
      IF scroll[7] > n * rowH - (lY1 - lY0) THEN scroll[7] := n * rowH - (lY1 - lY0) END;
      IF scroll[7] < 0 THEN scroll[7] := 0 END;
      FOR i := 0 TO n - 1 DO
        y := lY0 + i * rowH - scroll[7];
        IF (y >= lY0) & (y + rowH <= lY1 + D(2)) THEN
          IF i = sel THEN Ecran.Culoare(Am(0, 212, 255, 0.12)); Ecran.Dreptunghi(bx, y, bw, rowH - D(4)) END;
          Ecran.Culoare(Am(200, 169, 110, 0.15)); Ecran.Linie(bx, y + rowH - D(3), bx + bw, y + rowH - D(3));
          CFS.Nume(i, s);
          IF i = sel THEN Ecran.Culoare(cCyan) ELSE Ecran.Culoare(cGold2) END;
          T(bx + D(6), y + D(15), D(13), s);
          CFS.NumeTip(CFS.Tip(s), t); Strings.Append(" · ◢ ", t); CFS.NumeRadacina(CFS.Radacina(i), s); Strings.Append(s, t);
          Ecran.Culoare(Am(200, 200, 232, 0.5)); T(bx + D(6), y + D(29), D(10), t);
          CFS.AdresaText(i, t); s := "cfs://"; Strings.Append(t, s);
          Ecran.Culoare(cCyan); TD(bx + bw - D(6), y + D(21), D(13), s)
        END
      END;
      IF n = 0 THEN Ecran.Culoare(cDim); TC(bx + bw DIV 2, lY0 + D(30), D(12), "cubul e gol") END;
      IF n * rowH > lY1 - lY0 THEN Ecran.Culoare(cDim); TD(bx + bw, lY1 + D(2), D(9), "trage lista ↕") END;
      (* butoanele *)
      CfsB(0, x, y, w, h);
      IF sel >= 0 THEN Buton(x, y, w, h, "◉ DESCHIDE", Am(0, 212, 255, 0.12), cCyan, cCyan)
      ELSE Buton(x, y, w, h, "◉ DESCHIDE", cWin, cDim, cDim)
      END;
      CfsB(1, x, y, w, h);
      IF sel < 0 THEN Buton(x, y, w, h, "✕ ARDE", cWin, cDim, cDim)
      ELSIF acum - ardeDe < 3000 THEN Buton(x, y, w, h, "✕ SIGUR? ATINGE IAR", Am(255, 51, 102, 0.3), cRed, cRed)
      ELSE Buton(x, y, w, h, "✕ ARDE", Am(255, 51, 102, 0.1), cRed, Am(255, 51, 102, 0.5))
      END
    END
  END Cfs;

